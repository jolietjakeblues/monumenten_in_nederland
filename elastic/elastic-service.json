                "nl_zoeken": {
                  "type": "custom",
                  "char_filter": [
                    "punt_tussen_letters",
                    "dubbele_punt",
                    "geen_dakkapel",
                    "geen_kapelaan",
                    "geen_kapelle",
                    "geen_kuile",
                    "geen_kuilenburg",
                    "geen_haardijk"
