                    "lowercase",
                    "asciifolding",
                    "nl_meervoud",
                    "erfgoed_synoniemen",
                    "nl_stop",
                    "nl_stam"
                  ]
                },
                "nl_exact": {
                  "type": "custom",
                  "char_filter": [
                    "punt_tussen_letters",
                    "dubbele_punt"
                  ],
                  "tokenizer": "standard",
                  "filter": [
                    "lowercase",
                    "asciifolding"
                  ]
                }
              },
              "char_filter": {
                "punt_tussen_letters": {
                  "type": "pattern_replace",
                  "pattern": "(?<=\\p{L})\\.(?=\\p{L})",
                  "replacement": " "
                },
                "dubbele_punt": {
                  "type": "pattern_replace",
                  "pattern": ":",
                  "replacement": " "
                },
                "geen_dakkapel": {
                  "type": "pattern_replace",
                  "pattern": "dakkapel",
                  "replacement": "dakcapel",
                  "flags": "CASE_INSENSITIVE"
                },
                "geen_kapelaan": {
                  "type": "pattern_replace",
                  "pattern": "kapela",
                  "replacement": "capela",
                  "flags": "CASE_INSENSITIVE"
                },
                "geen_kapelle": {
                  "type": "pattern_replace",
                  "pattern": "kapelle(?![nt])",
                  "replacement": "capelle",
                  "flags": "CASE_INSENSITIVE"
                },
                "soort_uit_uri": {
                  "type": "pattern_replace",
                  "pattern": "^.*/id/([a-z]+)/.*$",
                  "replacement": "$1"
                },
                "geen_functiecode": {
                  "type": "pattern_replace",
                  "pattern": "\\s*\\((?:[A-Z]{1,2}[0-9]{0,2}|T[A-Z]{2}[0-9]?)\\)\\s*$",
                  "replacement": ""
                },
                "geen_kuile": {
                  "type": "pattern_replace",
                  "pattern": "kuile(?!n)",
                  "replacement": "cuile",
                  "flags": "CASE_INSENSITIVE"
                },
                "geen_kuilenburg": {
                  "type": "pattern_replace",
                  "pattern": "kuil(?=enburg)|(?<=ker)kuil",
                  "replacement": "cuil",
                  "flags": "CASE_INSENSITIVE"
                },
                "geen_haardijk": {
                  "type": "pattern_replace",
                  "pattern": "haard(?=ijk)|(?<=sc)haard",
                  "replacement": "haerd",
                  "flags": "CASE_INSENSITIVE"
                },
                "min_soort_uit_uri": {
                  "type": "pattern_replace",
                  "pattern": "^.*/id/[^/]+/([a-z]+)/[^/]*$",
                  "replacement": "$1"
                },
                "min_soort_deel": {
                  "type": "pattern_replace",
                  "pattern": "^.*/id/sten[^/]*$",
                  "replacement": "deel"
                },
                "min_soort_serie": {
                  "type": "pattern_replace",
                  "pattern": "^.*/id/serie$",
                  "replacement": "serie"
                }
              },
              "normalizer": {
                "soort": {
                  "type": "custom",
                  "char_filter": [
                    "soort_uit_uri"
                  ],
                  "filter": [
                    "lowercase"
                  ]
                },
                "zonder_functiecode": {
                  "type": "custom",
                  "char_filter": [
                    "geen_functiecode"
                  ],
                  "filter": []
                },
                "min_soort": {
                  "type": "custom",
                  "char_filter": [
                    "min_soort_uit_uri",
                    "min_soort_deel",
                    "min_soort_serie"
                  ],
                  "filter": [
                    "lowercase"
                  ]
                }
              }
            }
