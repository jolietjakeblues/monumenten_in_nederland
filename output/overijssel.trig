        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Momenteel is het een belangrijk watersportcentrum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01104> a min:Passage,
