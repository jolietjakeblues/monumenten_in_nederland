        schema:name "Colmschate (gemeente Deventer)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Achterhoek (Colmschaterstraatweg 9) is een omstreeks 1850 gebouwd neoclassicistisch landhuis met empire-vensters en een roevendak met aankappingen en een dakruiter met luidklok."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00299> a min:Passage,
