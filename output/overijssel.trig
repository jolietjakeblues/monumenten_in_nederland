        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 314 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Het postkantoor (Bloemendalstraat 16), gebouwd in 1908-'09 naar plannen van rijksbouwmeester C.H. Peters, is een goed voorbeeld van een tweelaags dorpspostkantoor met directeurswoning in simpele, op de neogotiek geënte, vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00315> a min:Passage,
