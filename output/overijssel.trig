        schema:pageEnd "181" ;
        schema:pageStart "181" ;
        schema:pagination "181" ;
        schema:text "Klein dorp, ontstaan in de late middeleeuwen aan de oostzijde van de Groote Es. Het kreeg in de 20ste eeuw een kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00642> a min:Passage,
