        min:soort "inleiding" ;
        min:volgnummer 208 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill65> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0009> ;
        schema:name "Balkbrug (gemeente Avereest)"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text "De voorm. (Herv.) Boskerk (Balkerweg 85, Ommerschans) is een brede neoclassicistische zaalkerk met afgeplat zadeldak en houten daktorentje, gebouwd in opdracht van de Maatschappij van Weldadigheid. De eerste steen van deze gestichtskerk werd in 1845 gelegd door ds. A. Campagne. In het begin werd de kerk beurtelings gebruikt door protestanten en katholieken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00209> a min:Passage,
