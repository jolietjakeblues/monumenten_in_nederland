        schema:name "Mariënberg (gemeente Hardenberg)"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "De Geref. kerk (Vrijgemaakt) (Stationsweg 3) is een zaalkerk met steil zadeldak en een ingangspartij die uitloopt in een geveltoren met spits tentdak. De kerk kwam omstreeks 1930 tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00762> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mariënberg (gemeente Hardenberg)"@nl ;
        min:adres "Stationsweg 8-10" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
