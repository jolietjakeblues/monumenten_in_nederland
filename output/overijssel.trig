        min:hoofdstuk "Steden, dorpen, monumenten › Wierden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wierden" ;
        min:lemma "Ebina" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43832> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "512262" ;
        min:soort "lemma" ;
        min:volgnummer 1046 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0107> ;
        schema:name "Ebina"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Ebina (Oude Tolweg 3), gelegen ten westen van Wierden, is een landhuis in expressionistische trant met overkragend rietdak. Het landhuis, dat ook de naam ‘Vrijthof’ droeg, werd in 1925 voor fabrikant W.A. van Wulfften Palthe gebouwd. De hal heeft nog de oorspronkelijke lambrisering. Bij het huis staat een, eveneens met riet gedekte, garage."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01047> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wierden – Boerderijen"@nl ;
        min:adres "Kloosterhoeksweg 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Wierden" ;
        min:gemeenteInBoek "Wierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wierden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wierden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wierden" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22969> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38903" ;
        min:soort "lemma" ;
        min:volgnummer 1047 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0107> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "274" ;
        schema:pagination "274-275" ;
        schema:text "Boerderijen. Enkele buurtschappen ten zuiden en zuidwesten van Wierden bezitten interessante boerderijen. In de buurtschap Zuna staat de oorspronkelijk 18de-eeuwse langhuisboerderij Zunaweg 10, met afgewolfd rieten zadeldak. De boerderij is in het derde kwart van de 19de eeuw verbouwd en voorzien van een vrij korte bovenkamer. Zunaweg 16-16C is een krukhuisboerderij met rieten schilddak uit het midden van de 19de eeuw. De uit 1855 daterende langhuisboerderij Bussinkweg 1 in het buurtschap Notter heeft een rieten wolfdak en een aangebouwd zandhok. Op het erf bevinden zich verder nog een stookhok, een schuur en een mestvaalt. In het buurtschap Rectum ligt de forse langhuisboerderij 't Woolderink (Kloosterhoeksweg 6) uit de tweede helft van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01048> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijhe"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Wijhe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijhe" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wijhe" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1048 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0108> ;
        schema:name "Wijhe"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "Esdorp ontstaan op een stroomrug langs de IJssel en voor het eerst genoemd in 960. Lange tijd was er een halteplaats voor Twentse en Duitse kooplieden, die hier bij een doorwaadbare plek de IJssel overstaken. Tevens was het een pleisterplaats op de route van Zwolle naar Deventer, die vanaf hier over de kruin van de in 1308 aangelegde IJsseldijk liep. De eerste niet-agrarische bebouwing ontwikkelde zich rond de kerk en langs de Langstraat, wat tot een langgerekt dorp leidde. In de 15de eeuw ontstond aan de oostzijde de havezate De Gelder, die in 1868 van het dorp werd gescheiden door de spoorlijn van Deventer naar Zwolle. Het station zelf werd in 1866 gebouwd en in 1972 gesloopt. Nabij het station ontstond de katholieke kerk en langs de Stationsstraat verdichtte de bebouwing zich enigszins. Voor de fruitteelt werd in 1911 een fruitafslag ingericht. Ook vond er mandenmakerij plaats. Door de veeteelt langs de IJssel kwam vleesverwerkende industrie tot ontwikkeling, waaronder de inmiddels verdwenen fabriek van Anton Hunink en het in 1847 opgerichte en nog bestaande Meester Wijhe B.V. aan de noordzijde van het dorp. Aan het einde van de 19de eeuw ontstond ook de Asphaltpapierfabriek Meyer en Bosch, die in 1935 fuseerde met de N.V. Asphaltfabriek Olst. De in 1912 opgerichte N.V. Sallandse Vloerzeil- en Linoleumfabriek werd de kern van het industrieterrein De Enk aan de zuidzijde. Na de oorlog raakte het dorp ingeklemd tussen de beide industriegebieden, de IJsseldijk en de spoorlijn. In de jaren tachtig ontstond aan de zuidoostzijde aan de overzijde van de spoorlijn een nieuwbouwwijk. De dorpsstructuur zelf is echter niet wezenlijk aangetast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0108.php> .

