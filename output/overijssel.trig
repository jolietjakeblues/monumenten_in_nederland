        min:adres "Nijhuisbinnenweg 1",
            "Vockersweg 24" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hengelo" ;
        min:gemeenteInBoek "Hengelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hengelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hengelo" ;
        min:lemma "Oele" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 628 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill249>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill250> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0051> ;
        schema:name "Oele"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Oele. Ten zuidwesten van Hengelo ligt het essenzwermdorp Oele, ontstaan in de middeleeuwen in de nabijheid van de in 1798 afgeboken havezate Oldemeule. De openbare lagere school (Vockersweg 24) is een goed gedetailleerde dorpsschool uit omstreeks 1925. De Oldemeule (Olde Meuleweg ong.) is een onderslag-watermolen op de Oelerbeek die voor het eerst in 1334 als bezit van de voorm. havezate Oldemeule werd vermeld. In 1690 werd de molen herbouwd in vakwerk op een onderbouw van zandsteen. Opschrift: ‘Ao 1690, is dese molen uit de gront vernieuwd door Joost Christ. van Bevervoorde & Judit Margareta van Coverden’. Tot 1880, toen hij in bezit van Twickel kwam, was het een dubbele watermolen. De oliemolen werd omstreeks 1900 afgebroken; het fundament in Bentheimersteen is nog aanwezig. In de omgeving staan interessante hallenhuisboerderijen: Veldhuis (Nijhuisbinnenweg 1) uit 1845, Albersdijk 20 op L-vormige plattegrond uit 1846, Oelersteeg 35 uit 1854 en Oelerschoolpad 14 uit 1882."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00629> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengelo – Beckum"@nl ;
        min:adres "Beckumerschoolweg 38",
            "Haaksbergerstraat 185",
            "Haaksbergerstraat 187",
            "Haaksbergerstraat 44" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hengelo" ;
        min:gemeenteInBoek "Hengelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hengelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hengelo" ;
        min:lemma "Beckum" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 629 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0051> ;
        schema:name "Beckum"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "179" ;
        schema:pagination "179-180" ;
        schema:text "Beckum. Ten zuidwesten van Hengelo ligt het esdorp Beckum, dat voor het eerst in 1266 werd genoemd. Pas na de oorlog was er van enige kernvorming sprake. De R.K. St.-Blasiuskerk (Haaksbergerstraat 185) is een driebeukige pseudobasiliek onder geknikte zadeldaken met een laag dwarsschip en een gedrongen toren met ingesnoerde vierkantige spits. De kerk werd in 1936-'38 in traditionalistische vormen gebouwd naar plannen van Joh.H. Sluijmer op de plaats van een voorganger uit 1823-'24. De pastorie (Haaksbergerstraat 187) stamt uit dezelfde tijd. De openbare lagere school (Beckumerschoolweg 38) is een eenvoudige dorpsschool uit omstreeks 1915. Het vakantiehuis Kluenven (Haaksbergerstraat 44) werd in 1939 met kalkzandsteen in cottagestijl gebouwd voor de familie Boom. Het logeerhuis werd in 1941 toegevoegd en het studeerhuis in 1947."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00630> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengevelde (gemeente Ambt Delden)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
