        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Olst" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Olst" ;
        min:lemma "Horeca" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0078> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Horeca. Het voorm. café De Dom (A. Geertstraat 2) werd omstreeks 1875 gebouwd in neoclassicistische vormen, als woonhuis met een café-gedeelte dat de ingang op de hoek had. Het woongedeelte heeft een hoog opgaande ingangsrisaliet en aan de zijkant een veranda. De huidige winkelpui is in 1904 aangebracht. Het voorm. café Het Rode Hart (Kerkplein 3) is een langgerekt gebouw uit omstreeks 1890."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0078.php> .

