        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 655 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "IJsselmuiden"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (Burg. Van Engelenweg 137) is een neoromaanse zaalkerk met drie kapellen aan beide lange zijden, een ingangsportiek en een terzijde staande, ongelede toren met zadeldak. De in 1919 naar plannen van J. Stuyt gebouwde kerk verving een voorganger uit 1849. De grote neoclassicistische pastorie stamt uit 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00656> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJsselmuiden"@nl ;
        min:adres "Burg. Van Engelenweg 177" ;
