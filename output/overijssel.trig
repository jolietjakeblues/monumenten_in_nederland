        min:soort "lemma" ;
        min:volgnummer 294 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0020> ;
        schema:name "Grensstenen"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Grensstenen. De grenssteen met het nummer 834 (en nr. 1) aan de Niekerkerweg draagt de wapens van Overijssel, Gelderland en Munster. Aan de Gelderse zijde staat nog het jaartal ‘1766’, aan de Overijsselse zijde het jaartal ‘1773’. De grenspaal met het nummer 834E aan de Zuidgrensweg (bij nr.15) toont de letters O(verijssel) en M(unster) en het jaartal ‘1773’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00295> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Colmschate (gemeente Deventer)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Deventer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Colmschate (gemeente Deventer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Colmschate" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 295 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0021> ;
        schema:name "Colmschate (gemeente Deventer)"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Hoevenzwermdorp ontstaan in de buurt van het in 1257 gestichte cisterciënzerinnenklooster Ter Hunnepe, dat in 1578 werd verwoest waarna in 1913 het resterende poortgebouw werd gesloopt. Het laat-middeleeuwse schoutambt Kolmschate behoorde sinds 1576 tot Deventer, maar vormde in 1811 de zelfstandige gemeente Diepenveen. Nabij de weg ontstond omstreeks 1830 enige kernvorming waar in 1843 een kerk verrees en in 1906 aan het spoor een zuivelfabriek. Op de kruising van het Overijssels Kanaal en de weg naar Deventer, de Snippeling, verrezen omstreeks 1860 drie kalkovens, die kort na 1974 zijn gesloopt. Het dorp zelf had van 1888 tot 1933 een station en heeft er sinds 1989 opnieuw een. Na een annexatiepoging door Deventer van de hele gemeente Diepenveen in 1972, kwam in 1974 het zuidoostelijke deel met het dorp Colmschate bij Deventer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00296> a min:Passage,
