        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 334 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill104>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill105> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Dedemsvaart (gemeente Avereest)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "81" ;
        schema:pagination "81-82" ;
        schema:text "De R.K. St.-Vituskerk (Langewijk 170A) is een driebeukige neogotische hallenkerk met hoog opgetrokken viering en een toren van vier geledingen met ingesnoerde spits. De kerk werd in 1874-'75 gebouwd naar plannen van A. Tepe, op de plek van een voorganger uit 1833 die plaats bood aan de voornamelijk uit Duitsland afkomstige katholieke veenarbeiders. In 1929-'30 kwam de huidige viering met dakruiter en koor tot stand, naar plannen van H.C.M. van Beers of Joh. H. Sluijmer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00335> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dedemsvaart (gemeente Avereest)"@nl ;
        min:adres "Hoofdvaart 27-29",
            "Molstraat 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Avereest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dedemsvaart (gemeente Avereest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 335 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Dedemsvaart (gemeente Avereest)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Het voorm. raadhuis van de gemeente Avereest (Molstraat 1) is een neoclassicistisch pand op vrijwel vierkante grondslag, gebouwd in 1863 en in 1885 van een verdieping voorzien. Gelijktijdig ontstond daarnaast de burgemeesterswoning (Hoofdvaart 27-29) in neoclassicistische hoofdvormen met ingangsrisaliet, afgesloten door een bescheiden in de daklijst opgenomen fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00336> a min:Passage,
