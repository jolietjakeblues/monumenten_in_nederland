        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De voorm. synagoge (Stationsstraat 21) is een zaalgebouw uit 1889, met neorenaissancistische details. Het gebouw doet momenteel dienst als Vrij Katholieke kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

