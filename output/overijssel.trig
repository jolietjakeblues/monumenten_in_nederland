        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Paaslo (gemeente IJsselham)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Paaslo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 876 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0084> ;
        schema:name "Paaslo (gemeente IJsselham)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Hoevenzwermdorp, dat voor het eerst wordt genoemd in 1251. De kapel behoorde tot de St.-Clemenskerk van Steenwijk en werd gesticht omdat die kerk ver weg lag en bij hoog water van de Steenwijkse Aa zelfs onbereikbaar was. In 1336 werd de kapel tot kerk verheven, maar vanaf 1489 was ze ondergeschikt aan die van Oldemarkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0084.php> .

