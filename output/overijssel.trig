        min:kern "Lemele" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 721 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0062> ;
        schema:name "Lemele (gemeente Ommen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "De Herv. kerk (Lemelerweg 72-74) is een zaalkerk met aan de voorzijde een asymmetrisch geplaatste ongelede toren met vlak zadeldak en een zeer ranke spits. De kerk werd in 1939 gebouwd naar plannen van H. Boxman uit Nijverdal, op de plaats van een kerk uit 1865."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00722> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemele (gemeente Ommen)"@nl ;
        min:adres "Lemelerweg 12" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
