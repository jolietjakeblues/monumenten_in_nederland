        min:kern "Oud-Avereest" ;
        min:lemma "Boerderij" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34349>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62160> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "8446",
            "8449" ;
        min:soort "lemma" ;
        min:volgnummer 870 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0082> ;
        schema:name "Boerderij"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Boerderij. In de omgeving langs het Reestdal staat een aantal forse 19de-eeuwse hallenhuisboerderijen met middendeel. Enkel Groot Oever 12 heeft een 18de-eeuwse oorsprong en een dwarsdeel. De voorgevel is doorgaans voorzien van een ingezwenkte lijstgevel, het woongedeelte van een wolfdak met pannen. Het bedrijfsgedeelte is met riet bedekt en de houten bijgebouwen hebben veelal zwart geteerde, gepotdekselde delen. Voorbeelden zijn Den Kaat (Den Kaat 2) met in de achtergevel het jaartal ‘1805’ en in de voorgevel ‘1812’, Lutten Oever 6 (1806), Groot Oever 10 (1835), Ten Cate (Den Huizen 4) uit omstreeks 1880, Groot Oever 6, Den Huizen 5 en Oud Avereest 20."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00871> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overdinkel (gemeente Losser)"@nl ;
