        min:kern "Ootmarsum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40455>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56196> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "31758",
            "31759" ;
        min:soort "inleiding" ;
        min:volgnummer 852 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0080> ;
        schema:name "Ootmarsum"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het raadhuis (Markt 1) [4] is kort na 1778 gebouwd naar ontwerp van Egbert Schrader en verving een 16de-eeuws raadhuis. Het gebouw heeft een zandstenen voorgevel, versierd met grove rococoornamenten en voorzien van het stadswapen. In 1840 werd op het schilddak een dakruiter geplaatst. Op de verdieping bevindt zich een eenvoudige rococoschouw uit de bouwtijd. Omstreeks 1966 kreeg het raadhuis een uitbreiding met vleugels in quasi-18de-eeuwse stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

