        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enter (gemeente Wierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Enter" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18750> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38909" ;
        min:soort "inleiding" ;
        min:volgnummer 490 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill194> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0037> ;
        schema:name "Enter (gemeente Wierden)"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text "De Herv. kerk (Dorpsstraat 55) verrees in 1709 als rechthoekige zaalkerk met rondboogvensters tussen steunberen. Na achtereenvolgens in 1824, 1855 en 1863 te zijn gewijzigd en vergroot ontstond de huidige kerk met dwarspand. De gevels werden bepleisterd en voorzien van een klimmend boogfries. In de dakruiter boven de ingang hangt een klok uit 1315, oorspronkelijk afkomstig uit Friesland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0037.php> .

