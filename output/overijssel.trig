    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00009> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwoord"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
