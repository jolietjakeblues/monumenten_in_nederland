        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38566> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "21401" ;
        min:soort "lemma" ;
        min:volgnummer 608 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0050> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Windmolens. De Molen van Fakkert (Ommerweg 15) is een achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet, gebouwd in 1821. In afwachting van een restauratie staan kap en bovenstuk momenteel naast de romp. De Hoop (Ninaberlaan 78) is een achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet, gebouwd in 1854 en in 1869 voorzien van een nieuwe bovenas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00609> a min:Passage,
