        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diepenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Diepenveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34915> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508973" ;
        min:soort "inleiding" ;
        min:volgnummer 451 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0034> ;
        schema:name "Diepenveen"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "De voorm. gemeentelijke naaien breischool (Dorpsstraat 43-45) is een neoclassicistisch schoolgebouw annex onderwijzerswoning uit 1872, mogelijk naar ontwerp van H. van Harte. Het gebouw is voorzien van een gepleisterd middenrisaliet met puntgevel en gekoppelde vensters met wenkbrauwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0034.php> .

