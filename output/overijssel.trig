        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Lutte (gemeente Losser)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "De Lutte" ;
        min:lemma "Grensstenen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 331 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0025> ;
        schema:name "Grensstenen"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "Grensstenen. Ten oosten van het dorp staan op de Nederlands-Duitse grens enkele oude grensstenen. De zandstenen grenssteen nr. 20 (nabij Zur Grenze) dateert uit omstreeks 1480 en draagt aan weerszijden de wapens van het graafschap Bentheim. Het is de oudste grenssteen langs de Nederlandse Rijksgrens. Nabij de Bentheimerstraat staan de grensstenen 16 en 18, beide voorzien van de wapens van Utrecht en Bentheim en het jaartal 1659."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00332> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dedemsvaart (gemeente Avereest)"@nl ;
        min:adres "Sluis 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Avereest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dedemsvaart (gemeente Avereest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 332 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Dedemsvaart (gemeente Avereest)"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "Hoogveenkolonie met achtervaart, ontstaan in 1811, toen het Avereestse hoogveengebied doorsneden werd door een kanaal naar Hasselt. Het werd gesticht door mr. W.J. Baron van Dedem, tevens naamgever van de kolonie. Het dorp ontwikkelde zich langs twee vaarten, de noordelijk gelegen Langewijk en de Hoofdvaart, die bij Rollepaal (Sluis 6) samenkomen en als Rheezereind verder gaan. Eerst groef men de Langewijk en pas in 1817 de Hoofdvaart of Dedemsvaart. In 1837 werd het gebied toegevoegd aan de gemeente Avereest. Door de beschikbaarheid van turf werden langs de Kalkwijk (nu Zuidwolderstraat) vanaf 1820 kalkovens gebouwd, waarin de uit de Waddenzee afkomstige schelpen gebrand werden tot kalk, bestemd voor Noord-Hollandse bouwplaatsen. De in 1890 opgerichte scheepswerf H.H. Mittendorf werd omdat de Langewijk gedempt werd, in 1966 naar Kampen verplaatst. De grond aan de oostzijde van het dorp bleek uitstekend geschikt voor tuinbouw. In 1869 stichtte de vervener H. Scholten in Rheezerend een bloemen- en plantenkwekerij, die uitgroeide tot de snijgroenkwekerij ‘Tottenham’. In 1888 volgde de kwekerij Moerheim van B. Ruys waarnaast zich nu de tuinen van Mien Ruys bevinden. Vanaf het begin van de 20ste eeuw volgde een eerste opvulling tussen de beide lintbebouwingen in de vorm van de Julianastraat en Van Haeringenstraat. Door verdere uitbreidingen is een rechthoekige structuur ontstaan met aan de oostzijde het industriegebied De Rollepaal met de kunststofverwerkende industrie Wavin en het grondboorbedrijf Haitjema."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00333> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dedemsvaart (gemeente Avereest)"@nl ;
        min:adres "Hoofdvaart 5" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Avereest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dedemsvaart (gemeente Avereest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54805> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "8454" ;
        min:soort "inleiding" ;
        min:volgnummer 333 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Dedemsvaart (gemeente Avereest)"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "De Herv. kerk (Hoofdvaart 5) is een forse neoclassicistische kruiskerk met houten klokkentorentje van twee geledingen en een kleine spits op de kruising. De kerk werd in 1833-'34 gebouwd in opdracht van mr. W.J. Baron van Dedem, op een terrein geschonken door J. Mulder en de familie De Vos van Steenwijk. De plannen waren afkomstig van de Zutphense architect D. Lijsen met E. Nuis als opzichter. In de kruisarm aan de zijde van het kanaal staat de neoclassicistische pastorie; deze heeft hoeklisenen en een middenrisaliet met fronton. Het uurwerk in de vieringstoren stamt uit 1852. Inwendig heeft de kerk een houten zoldering met vlakken en gietijzeren rozetten. Het neobarokke orgel, geschonken door B. Berends en L.A. Kreuzen, werd in 1868-'70 gebouwd door J. van Loo. De verdere inrichting is in 1858-'59 gemoderniseerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00334> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dedemsvaart (gemeente Avereest)"@nl ;
        min:adres "Langewijk 170A" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
