        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0034> ;
        schema:name "Diepenveen"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "De woning annex postkantoor Kerkplein 2 is een dwars dorpshuis uit omstreeks 1880, met een middenrisaliet die overgaat in een bakstenen dakerker. Een zijkamer is lange tijd als postkantoor in gebruik geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00453> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diepenveen – Oud Rande"@nl ;
        min:adres "Sallandsweg 10" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diepenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Diepenveen" ;
        min:lemma "Oud Rande" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18146> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "12889" ;
        min:soort "lemma" ;
        min:volgnummer 453 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill172> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0034> ;
        schema:name "Oud Rande"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "130" ;
        schema:pagination "130-131" ;
        schema:text "Oud Rande (Sallandsweg 10) is een havezate waarvan de oorsprong ligt in de 15de eeuw. Tussen 1570 en 1580 werd een nieuw huis gebouwd in opdracht van Willem van Doetinchem, schout van Deventer. Toen men dit huis in 1838 gedeeltelijk sloopte, bleef de toren bewaard. Het in opdracht van mr. Cost Budde nieuw gebouwde huis, uitgevoerd in Willem II-gotiek, werd in 1964 afgebroken. Wat resteert is een toren van twee geledingen met tentdak, die volgens een steen in de oostmuur, in 1574 gereed is gekomen. De tweede geleding dateert waarschijnlijk uit het begin van de 17de eeuw. Vanaf omstreeks 1625 is de begane grond als katholieke kapel in gebruik geweest. De ronde sluitsteen met het IHS-monogram in het ribloze kruisgewelf wijst hierop. De aanzetten van het gewelf rusten op kraagstenen met de symbolen van de vier evangelisten: engel, leeuw, rund en arend. De toenmalige, katholiek gebleven eigenaar Cornelis van Doetinchem zal opdracht hebben gegeven tot de inrichting van de kapel. Vanaf 1638 werd de kapel bediend door paters jezuïeten uit Zwolle. De toren is in 1990 uitwendig gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00454> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diepenveen – Nieuw Rande"@nl ;
        min:adres "Schapenzandweg 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diepenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Diepenveen" ;
        min:lemma "Nieuw Rande" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34965> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508975" ;
        min:soort "lemma" ;
        min:volgnummer 454 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0034> ;
        schema:name "Nieuw Rande"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text """Nieuw Rande (Schapenzandweg 3) is een buitenplaats die omstreeks 1620 is aangelegd in opdracht van de katholiek gebleven Seino Swaefken, heer van Rande. In juni 1672 vestigde Berend van Galen, bisschop van Munster, hier tijdelijk zijn hoofdkwartier. Van het 17de-eeuwse huis zijn in 1951 de laatste resten verdwenen. Rond 1850 werd de buitenplaats gekocht door de uit Deventer afkomstige oud-gouverneur-generaal van Nederlands-Indië, A.J. Duymaer van Twist, en zijn vrouw M.J. Beck. Meer ten westen van het oude huis liet deze in 1856-'57 een groot nieuw landhuis bouwen, naar plannen van J.D. Zocher, van wiens hand ook het ontwerp van de huidige parkaanleg is. Dit eclectische landhuis bestaat uit een middendeel waarvoor een veranda en balkon, geflankeerd door twee zijvleugels, elk met een flauw hellend zadeldak. In 1895 werd het landgoed gekocht door G.J.Th. baron Stratenus, die enige verbouwingen liet uitvoeren.

Het interieur heeft veel van zijn 19de-eeuwse aanzien bewaard, waaronder de hal met gestucte pilasters, rijk geornamenteerde kapitelen en een glazen koof, en de grote woonkamer met een plafond in neorenaissance-stijl. In de aangrenzende kamer bevindt zich boven een hoge lambrisering papierbehang dat goudleer imiteert (circa 1895). Verder is er een schouw met neorococo-snijwerk en voorzien van consoles voor porselein. De biljartkamer heeft eveneens een papieren goudleer-imitatie (circa 1895) boven een lambrisering. Dit behang vertoont een repeterend motief van de berg Foedji-san. In het pand zijn diverse marmeren schouwen bewaard gebleven. Op de zolder is een Philibertspant zichtbaar en bevinden zich nog enkele afgetimmerde bediendenkamertjes."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0034.php> .

