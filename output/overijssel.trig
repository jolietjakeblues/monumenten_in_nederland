        schema:name "Zalk (gemeente IJsselmuiden)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De met riet gedekte pastorie (Kerkplein 20) stamt uit de eerste helft van de 19de eeuw en de kosterswoning (Kerkplein 18) uit de tweede helft van die eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0112.php> .

