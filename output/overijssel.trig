        min:kern "Balkbrug" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47629> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "8453" ;
        min:soort "lemma" ;
        min:volgnummer 211 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0009> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text """Windmolen ‘De Star’ (De Omloop 16) is een achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet, die in 1848 een grondzeiler verving en in 1882 na brand werd herbouwd. De molen is in 1974 op de huidige plaats opgebouwd.

De begraafplaats Veldzicht (Balkerweg t.o. 75, Ommerschans) is een verscholen in het bos gelegen begraafplaats op een restant van de wallen van de Ommerschans, waar tussen 1820 en 1890 de bewoners van de kolonie werden begraven. De grafkruisen zijn van graven van personeelsleden."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00212> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 212 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Bathmen"@nl ;
        schema:pageEnd "59" ;
        schema:pageStart "58" ;
        schema:pagination "58-59" ;
        schema:text "Esdorp, ontstaan in de 13de eeuw op korte afstand van de meer naar het westen gelegen Bathmener Enk. Op enige afstand ten oosten van het dorp, aan de bevaarbare Schipbeek, verrees in de 14de eeuw de bisschoppelijke sterkte Arkelstein. Na verwoesting door de Geldersen in 1510 en 1521 werd deze in 1539 gedeeltelijk gesloopt. In 1716 volgde verkoop, waarna de resten in het begin van de 19de eeuw geheel zijn verdwenen. De in de Gelderse gemeente Gorssel gelegen havezate Huize Dorth heeft een belangrijke rol gespeeld in de ontwikkeling van het dorp. In de kerk bevindt zich nog de grafkelder van de heren van Dorth. Rondom de centraal gelegen Brink en langs de Dorpsstraat vond in de 19de eeuw een bescheiden ontwikkeling plaats. Het in 1886 gebouwde en in 1917 weer gesloten station langs de lijn Deventer-Almelo heeft hier weinig verandering in gebracht. Pas na de oorlog en vooral na 1969 heeft het dorp zich op een compacte wijze uitgebreid tussen Schipbeek en spoorlijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00213> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:adres "Kerkplein 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47263> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "8726" ;
        min:soort "inleiding" ;
        min:volgnummer 213 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Bathmen"@nl ;
        schema:pageEnd "59" ;
        schema:pageStart "59" ;
        schema:pagination "59" ;
        schema:text "De Herv. kerk (Kerkplein 3) is een neoclassicistische zaalkerk met driezijdig gesloten laatgotisch koor en een eveneens laatgotische toren van vier geledingen met zadeldak. De oorspronkelijk aan de O.L. Vrouwe gewijde kerk is ontstaan omstreeks 1240 als geschenk van de bisschop van Utrecht aan het kapittel van de St. Lebuïnus te Deventer. Tegen het mogelijk 14de-eeuwse schip werd kort na 1459 een rijzig koor gebouwd. Ook de toren zal in die tijd tot stand gekomen zijn. De vrij bijzondere afdekking in de vorm van een zadeldak tussen puntgevels is mogelijk in het begin van de 16de eeuw aangebracht. Het uurwerk stamt uit 1881. Na een eerder plan uit 1865, werd in 1870 het oorspronkelijke schip gesloopt en vervangen door het huidige driebeukige schip op een bijna vierkante plattegrond. Dit schip, met een in hoofdvorm neoclassicistische opzet en voorzien van neogotische details, verrees naar ontwerp van J.A. Gerretsen uit Zutphen. Gelijktijdig werd rond de gehele kerk een gepleisterde plint opgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00214> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 214 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Bathmen"@nl ;
        schema:pageEnd "59" ;
        schema:pageStart "59" ;
        schema:pagination "59" ;
        schema:text "Nadat de neogotische pinakels in 1906 waren verwijderd, volgde in 1939 een verdere versobering en inwendige herinrichting naar plannen van J.A.G. Heineman. Bij de restauratie in 1975-'76 onder leiding van H. Roebbers werden de uit 1870 daterende consistorie- en catechisatiekamer ter weerszijden van de toren vervangen door nieuwe aanbouwsels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00215> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:adres "Dorpsstraat 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 215 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Bathmen"@nl ;
        schema:pageEnd "59" ;
        schema:pageStart "59" ;
        schema:pagination "59" ;
        schema:text "Het koor is voorzien van gemetselde kruisribgewelven, met ribben waarop eenvoudig decoratieve schilderingen zijn aangebracht. Het schip wordt overdekt door sterk gewelfde kruisribgewelven van stuc op latten, met in de hoeken kraagstenen met bladornament. De midden-15de-eeuwse muurschilderingen tonen onder andere St. Catharina en St. Gertrudis en de tienduizend martelaren van Achatius op de berg Ararat. Tussen de vensters in de koorsluiting bevinden zich schilderingen van profeten en apostelfiguren met spreukbanden waarop gedeelten van de Tien Geboden zijn geschreven. Op het koorgewelf is vervaagd een Deësis-voorstelling te zien: een oordelende Christus tussen Maria en Johannes de Doper. De schilderingen werden in 1870 ontdekt en gerestaureerd door L.L. Kleijn; in 1939 zijn die in het koor opnieuw geconserveerd door E. en J. Bokhorst en werden op het koorgewelf de ornamentele schilderingen blootgelegd. Het koor bevat een grafzerk uit 1532, vermoedelijk van Dirck van Dorth, en de toegang tot de in 1620 gebouwde grafkelder van de heren van Dorth, waarin zich diverse loden lijkkisten bevinden. Deze ingang heeft een maniëristisch tekstcartouche. De preekstoel is vroeg-18de-eeuws, de lezenaar mogelijk nog 17de-eeuws. Het neogotische orgel werd in 1876 geleverd door H.G. Holtgräve. In 1940 is een gebrandschilderd raam aangebracht naar ontwerp van J. Dijkstra. De voorm. pastorie (Dorpsstraat 6) werd in 1840 gebouwd en in 1981 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00216> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 216 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Bathmen"@nl ;
        schema:pageEnd "59" ;
        schema:pageStart "59" ;
        schema:pagination "59" ;
        schema:text "Het raadhuis (Kerkplein 1) is een fors neoclassicisistisch woonhuis, gebouwd in 1880. In 1888 werd het door de gemeente Bathmen gekocht en als raadhuis ingericht. Uit die tijd stammen mogelijk ook de aanbouw aan de rechterzijde en het dorische ingangsportaal. Voor het raadhuis staat een lantaarnpaal uit 1939, opgericht ter gelegenheid van het 25-jarig ambtsjubileum van burgemeester P.J. Hemminga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00217> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
