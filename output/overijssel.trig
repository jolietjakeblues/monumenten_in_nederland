        schema:pageEnd "228" ;
        schema:pageStart "227" ;
        schema:pagination "227-228" ;
        schema:text "Het voorm. post- en inklaringskantoor (Stationsstraat 14) [9], een langgerekt tweebeukig eenlaagspand, werd in 1915 gebouwd voor de Spoorwegmaatschappij Almelo-Salzbergen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00820> a min:Passage,
