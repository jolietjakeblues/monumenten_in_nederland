        min:kern "Raalte" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27845>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29759> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "32268",
            "32269" ;
        min:soort "inleiding" ;
        min:volgnummer 881 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill342> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0085> ;
        schema:name "Raalte"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "241" ;
        schema:pagination "241-242" ;
        schema:text "De (Herv.) Plaskerk (De Plas 7), oorspronkelijk gewijd aan de H. Kruisverheffing, is een eenbeukige laatgotische kerk met een smaller koor en gedrongen toren van twee geledingen met tentdak. Archeologisch onderzoek uit 1969 heeft uitgewezen dat in de 12de eeuw een eerste kerk in oersteen werd gebouwd; deze bestond uit een schip met een smaller rondgesloten koor. Kort na 1425 werd het huidige driezijdig gesloten koor gebouwd met inwendig kruisribgewelven. Aan het eind van de 15de eeuw werd het romaanse schip vervangen door het huidige brede schip. Na oorlogsschade werd de kerk in 1592 hersteld. Omstreeks 1694 stortte de oude toren in en werd in 1697 vervangen door de huidige. Toen zijn ook de beschadigde gewelven in het schip verwijderd. Omstreeks 1835 kreeg de kerk aan de buitenzijde een blokbepleistering. Omstreeks 1970 werd de kerk ingrijpend gerestaureerd onder leiding van D. Wijma, waarbij de buitenbepleistering werd verwijderd, de toren werd verhoogd en een aanbouw aan de zuidzijde verdween. Aan de noordzijde is toen een nieuwe consistoriekamer toegevoegd. Inwendig bevinden zich aan de noordzijde van het koor resten van een laatgotisch sacramentskastje. De preekstoel en drie herenbanken stammen uit omstreeks 1700. Het orgel met galerij op houten toskaanse zuilen ontstond in 1836, naar plannen van C.F.A. Naber."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00882> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Raalte"@nl ;
        min:adres "Kerkstraat 6",
            "Kerkstraat 8" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Raalte" ;
        min:gemeenteInBoek "Raalte" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Raalte_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Raalte" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Raalte" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76949>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76950>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76951>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76952> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "32265",
            "513665",
            "513666",
            "513667" ;
        min:soort "inleiding" ;
        min:volgnummer 882 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0085> ;
        schema:name "Raalte"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De R.K. kerk van de H. Kruisverheffing (Kerkstraat 6) is een forse, driebeukige neogotische hallenkerk. De toren heeft drie geledingen en een ingesnoerde naaldspits, welke aan de basis een balustrade met flankerende pinakels heeft gekregen. De kerk werd in 1891-'92 gebouwd naar plannen van A. Tepe, met als uitvoerder G. Ebbers, ter vervanging van een uit 1936 stammende voorganger. De kerk is sterk verwant aan de St.-Nicolaaskerk te IJsselstein. Het interieur is in 1958-'63 en in 1991-'92 voorzien van een nieuwe polychromie. De kerk heeft net- en stergewelven en een neogotische tegelvloer met tableau's. De inrichting dateert grotendeels uit het laatste kwart van de 19de eeuw en de eerste helft van de 20ste eeuw. Diverse stukken komen uit het atelier van F.W. Mengelberg, zoals het hoofdaltaar (1891), het Mariaaltaar (1894), het St.-Antoniusaltaar (1898), diverse beelden en beeldengroepen (1892-1900) en de reliëfs in de communiebank (1899). Verder zijn er twee beelden, voorstellende Johannes de Evangelist en St. Aloysius (1897 en 1899), van atelier Margry, een kaarsenkroon (1899) van de firma Pothof uit Münster (D), twee zevenarmige kandelaars (1893) door W. Polders uit Kevelaer (D) en een marmeren doopvont (1892) met koperen deksel door J.H. Brom. Ook de neogotische banken zijn bewaard gebleven. De gebrandschilderde ramen in de koorabsis zijn vervaardigd door H.J.J. Geuer; die in de doopkapel (nu gedachteniskapel) komen uit atelier P. Cuypers. In 1991 heeft de kerk ramen overgenomen uit de gesloopte St.-Martinuskerk te Groningen, voorstellende de Tien Geboden (1890-1920), vervaardigd door atelier Nicolas. De kruiswegstaties zijn gemaakt door A. en P. Windhausen. Op het kerkhof staat een uit 1928 stammende kleine kapel. De grote pastorie (Kerkstraat 8) werd in 1929 door M. Roebbers ontworpen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

