        min:volgnummer 270 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill83> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Borne"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De voorm. synagoge (Ennekerdijk 17) is een eenvoudig diep pand uit 1842-'43 met een lijstgevel voorzien van spitsboogvensters. De naastgelegen mikwe is in 1935 gebouwd naar ontwerp van G.J. Leussink, bouwkundige van de textielfabriek Spanjaard. Verder zijn er nog de voorm. Joodse school (Ennekerdijk 15), gebouwd in 1895 in eclectische stijl in opdracht van textielfabrikant Spanjaard, en het in 1897 door de Joodse gemeente als chazzen gebouwde pand Ennekerdijk 13."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00271> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne"@nl ;
        min:adres "Ennekerdijk 31" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59277> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "9921" ;
        min:soort "inleiding" ;
        min:volgnummer 271 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Borne"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De Doopsgez. kerk (Ennekerdijk 31) is een eenvoudige zaalkerk met lijstgevel uit 1838. Inwendig bevat het een orgel van C. Haupt uit 1884."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00272> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne"@nl ;
        min:adres "Grotestraat 207" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66017> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "9920" ;
        min:soort "inleiding" ;
        min:volgnummer 272 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Borne"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De R.K. St.-Stephanuskerk (Grotestraat 207) is een neogotische driebeukige hallenkerk met transept en vijfzijdig gesloten koor. Verder heeft de kerk een vierkante toren van twee geledingen met achtzijdige naaldspits, een ronde traptoren met achtzijdige, ingesnoerde spits en een dwarsgeplaatste doopkapel. Het ontwerp van de 1887-'88 gebouwde kerk is van N. Molenaar en sterk geënt op de Westfaalse gotiek. Het interieur wordt overdekt door kruisribgewelven. De inventaris bevat een eikenhouten kruisbeeld uit omstreeks 1500, maar is verder overwegend laat-19de-eeuws. Hieronder bevinden zich beelden van Jozef en Maria uit het atelier van F.W. Mengelberg. Uit het atelier Te Poel en Stoltefus afkomstig zijn het hoofdaltaar (1891), het zijaltaar (1892), het triomfkruis (omstreeks 1890), een Mariabeeld met kind (1892) en de houten preekstoel (1894). De overige beelden zijn vervaardigd door J.P. Maas. De gebrandschilderde ramen werden tussen omstreeks 1894 en 1900 geleverd door de firma Nicolas & Zn.; die van de zijbeuken (omstreeks 1895) tonen de namen van de schenkers (omstreeks 1895). De kruiswegstaties (1899) in olieverf op koper komen uit het atelier Van de Weijenberg uit Kevelaar (D.). Het marmeren doopvont met bronzen deksel werd gemaakt door J. Brom."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

