        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overdinkel (gemeente Losser)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Overdinkel" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 873 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill339> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0083> ;
        schema:name "Overdinkel (gemeente Losser)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De R.K. St.-Gerardus Majellakerk (Hoofdstraat 76) is een eenbeukige kerk met versmald, driezijdig gesloten koor en een ongelede toren met vierzijdige spits, gebouwd in 1909-'10 naar ontwerp van H. Kroes. Het interieur heeft een open dakstoel. Tot de inventaris behoort een misbel uit 1771. De pastorie (Hoofdstraat 78) dateert uit de bouwtijd van de kerk. Het bijbehorende St. - Gerardus Majellapark (Pastoor van Laakstraat ong.) is in 1910 gesticht als processiepark en telt enkele kapellen en een calvarieberg met bakstenen baldakijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00874> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overdinkel (gemeente Losser) – Boerderijen"@nl ;
        min:adres "Beerninksweg 1",
            "Glanestraat 7",
            "Hoofdstraat 1" ;
