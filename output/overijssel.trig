            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39811> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38422",
            "38426" ;
        min:soort "lemma" ;
        min:volgnummer 906 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill352> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0088> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "Boerderijen. De Boschwöner (Boschweg 7) is een 18de-eeuws driebeukig vakwerkboerderijtje. In de omgeving van Rossum liggen nog meer interessante boerderijen, zoals Scholtelinde (Scholten Lindeweg 2), een forse langhuisboerderij met aangebouwde bovenkamer uit 1871 en een houtskelet uit 1678, Loosteresweg 1, een 19de-eeuwse langhuisboerderij, en de monumentale tweekapsboerderij Ensman (Ensmanweg 2) uit omstreeks 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00907> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rossum (gemeente Weerselo) – De Hunenborg"@nl ;
        min:adres "Broekmatenweg 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Weerselo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rossum (gemeente Weerselo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Rossum" ;
        min:lemma "De Hunenborg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61208> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38414" ;
        min:soort "lemma" ;
        min:volgnummer 907 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0088> ;
        schema:name "De Hunenborg"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "De Hunenborg (bij Broekmatenweg 4), gelegen ten noorden van Rossum in het vroegere Voltherbroek, is een ovale walburcht bestaande uit een hoge aarden wal omgeven door een natte gracht. Bij een opgraving in 1916 vond men, behalve de resten van veel houten gebouwen, aan de zuidoostzijde de fundamenten van een fors zaalgebouw, deels in zandsteen en deels in tufsteen opgetrokken. Het gebouw is waarschijnlijk jonger dan de wal, waartegen dit gebouw werd geplaatst. Het gebouw kan in verband worden gebracht met een recentelijk aangetroffen houten dam uit de jaren 1150-'60. De dam wijst erop dat een oudere, mogelijk 10de-eeuwse walburcht in die tijd, wellicht in opdracht van de Utrechtse bisschop, opnieuw in gebruik werd genomen. Tegen de eigenlijke burcht sloot een terrein, de in de 12de eeuw gebruikte ‘Lage Hunenborg’, aan met een lage omwalling en gracht die nu grotendeels is vergraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00908> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rossum (gemeente Weerselo) – Everlo"@nl ;
        min:adres "Havezatheweg 10" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Weerselo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rossum (gemeente Weerselo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Rossum" ;
        min:lemma "Everlo" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 908 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0088> ;
        schema:name "Everlo"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "246" ;
        schema:pagination "246-247" ;
        schema:text "Everlo (Havezatheweg 10). Van deze ten oosten van Rossum gelegen voorm. havezate, gesticht in het derde kwart van de 16de eeuw, resteren het omgrachte terrein van het in 1812 gesloopte hoofdhuis, de vroeg-18de-eeuwse hekpijlers van Bentheimersteen en een tweebeukig bouwhuis. Het in vakwerk uitgevoerde deel van het bouwhuis was het bedrijfsgedeelte en dateert getuige het jaartal op de houten inrijpoort uit 1704. Het andere deel is in 1812 verbouwd tot herenhuis en gepleisterd. Boven de empire-ingang bevindt zich een 18de-eeuwse steen met het alliantiewapen Sloet-Van Dongen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0088.php> .

