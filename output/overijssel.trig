        schema:name "Zwartsluis"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "De voorm. Ned. Geref. kerk De Bazuin (Buitenkwartier 14), is een achter de dijkbebouwing gelegen, geheel onderkelderde zaalkerk uit omstreeks 1890, met aan de voorzijde een consistoriekamer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01107> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwartsluis"@nl ;
        min:adres "Het Singel 18" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Zwartsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwartsluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1107 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill412> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Zwartsluis"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "281" ;
        schema:pagination "281-282" ;
        schema:text "De (Geref.) Cingelse kerk (Het Singel 18) is een grote zaalkerk uit 1893, gebouwd naar ontwerp van W.C. de Groot uit Leeuwarden. De kerk is ontstaan als ‘doleantiekerk’, na de vereniging van enkele tot dan toe afgescheiden kerkelijke gemeenten. Ze verving de in 1887 gebouwde houten noodkerk. De in rijke neorenaissance-stijl uitgevoerde voorgevel heeft een middenrisaliet met groot rondboogvenster, aan beide zijden geflankeerd door een ingang. De geveltoren wordt bekroond door een steil tentdak met dakkapellen, afgesloten door een uivorm die uitloopt in een steile spits. Het interieur bevat een orgel uit 1896 in neobarokke kast, gemaakt door J. Proper."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01108> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwartsluis"@nl ;
        min:adres "Kerkstraat 26" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Zwartsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwartsluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1108 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Zwartsluis"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 26) verrees in 1894 in eenvoudige neorenaissance-vormen, naar plannen van de architecten Fransen en Witzand. Boven de ingang staat het opschrift ‘Gemeentehuis’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01109> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwartsluis – Woonhuizen"@nl ;
        min:adres "Mastenmakersstraat 37",
            "Zomerdijk 80" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Zwartsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwartsluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24041> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "41511" ;
        min:soort "lemma" ;
        min:volgnummer 1109 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text """Woonhuizen. In de Fortresse is van de oudere woonbebouwing weinig bewaard gebleven. De eenvoudige gepleisterde trapgevel Kerkstraat 24, met gevelsteen uit 1628, vormt een uitzondering. Nabij de Nieuwe Sluis staat het in oorsprong 17de-eeuwse pand De Weijsberg (Mastenmakersstraat 37), bestaande uit tweebeukig, dwars eenlaags pand met een gedeeltelijk omlopend schilddak. De voorgevel met stoephek en paaltjes dateren uit het midden van de 19de eeuw. De getoogde kelders stammen uit de 17de eeuw. Verder bevat het interieur onder meer schouwen met stucwerk in Lodewijk XV- en XVI-stijl en een neoclassicistisch stucwerkplafond. Het hoekpand De Nieuwesluis 2 heeft een laat-18de-eeuwse lijstgevel met een deur in geblokte omlijsting en een bovenlicht in Lodewijk XVI-vormen. In het Buitenkwartier staat het oorspronkelijk 17de-eeuwse pand Westeinde 6, met schoudergevel en de later aangebrachte jaartalankers ‘1789’. Aan het Groot Laagland, langs de Arembergergracht, staan grote en deftige herenhuizen in neoclassicistische trant: de voorm. Herv. pastorie Groot Lageland 9 uit 1827, Groot Lageland 21 uit 1860 en Groot Lageland 39 uit omstreeks 1880. De bebouwing langs het Buitenkwartier zelf is overwegend 19de-eeuws; het rijke eenlaags herenhuis Buitenkwartier 2, verrees omstreeks 1890 in opdracht van Mozes Jacobs, directeur van de borstelfabriek. Het huis is voor zien van dakkapellen en een dakerker met sierspant en ajourwerk in chalet-vormen. Het omstreeks 1895 gebouwde huis Buitenkwartier 39 vertoont meer neorenaissance-invloeden; het uit omstreeks 1905 daterende pand Buitenkwartier 27 meer eclectische invloeden. De rijke laat-neoclassicistische burgemeesterswoning Zomerdijk 2 stamt uit 1903. Voor de arbeiders van de scheepswerven werden omstreeks 1910 de arbeiderswoningen Zomerdijk 53-63 gebouwd. De directeurswoning van een van de scheepswerven, Zomerdijk 62-64, stamt uit omstreeks 1925 en vertoont expressionistische details.

De kalkoven (bij Zomerdijk 80), een kegelvormig bakstenen gebouw met aan de onderzijden stookopeningen, werd omstreeks 1860 gebouwd en is het laatste restant van een voor Zwartsluis eens belangrijke nijverheid. In het naastgelegen leshuis werd de ongebluste kalk met water geblust."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01110> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwartsluis – Sluizen"@nl ;
        min:adres "Baanstraat 35" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Zwartsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwartsluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:lemma "Sluizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1110 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill413> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Sluizen"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text """Sluizen. De in 1620 ontstane Arembergersluis (Groot Lageland ong.) dateert in haar huidige vorm uit 1826 en werd in 1931 vergroot. Het toen gebouwde sluiswachtershuisje is in 1977-'78 gerenoveerd. De Nieuwe of Staphorster schutsluis (De Nieuwe Sluis ong.) stamt in eerste aanleg uit 1649 en werd in 1779 in steen uitgevoerd. Omdat het Meppelerdiep het overtollige water uit Drenthe afvoerde, stond de sluis gewoonlijk open en werd er pas geschut als er schepen moesten worden doorgelaten. Daartoe ontwierp Derk Swens, stadsarchitect van Zwolle, sluisdeuren die in stromend water konden worden gesloten. Die deuren zijn inmiddels vervangen. De huidige sluis heeft één stel vloeddeuren en twee stel ebdeuren, respectievelijk uit 1884, 1887 en 1941. De Grote Kolksluis (Kolksluis ong.), met moderne ophaalbrug, werd in 1878-'79 aangelegd op de plaats van de Oude Sluis.

De Isr. begraafplaats (bij Baanstraat 35) werd gesticht in 1851 en telt interessante grafstenen, waaronder één uit 1767, afkomstig van een oudere begraafplaats."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01111> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwartsluis – Zwartewatersklooster"@nl ;
        min:adres "Zwartewatersklooster 12" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Zwartsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwartsluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:lemma "Zwartewatersklooster" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1111 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Zwartewatersklooster"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Zwartewatersklooster. Dit esdorp ten zuidoosten van Zwartsluis ligt op een oude oeverwal van het Zwarte Water. Een benedictinessenklooster - dat in 1233 bij Mariënberg werd gesticht als boetedoening voor de dood van de in de slag bij Ane omgekomen bisschop Otto II van der Lippe, werd in 1244 verplaatst naar deze oeverwal. Dit klooster diende als uitgangspunt voor de ontginningen bij Staphorst en Rouveen. Het werd omstreeks 1588 gesloopt en op de plaats van het klooster ligt nog een kleine particuliere begraafplaats (bij Zwartewatersklooster 12). De kleine hallenboerderij Zwartewatersklooster 9, met een rieten wolfdak, werd in 1860 gebouwd. Op het erf staan twee hooibergen en enkele schuren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01112> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1112 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill414> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "282" ;
        schema:pagination "282-283" ;
        schema:text "Hoofdstad van de provincie, ontstaan op dekzand dat is afgezet op een uitloper van de Noord-Veluwse stuwwal. In de 8ste en 9de eeuw moeten er bewoningskernen zijn geweest bij de huidige Grote kerk (Middelwijk) en buiten de huidige Sassenpoort (Assendorp). Uit het in 1040 voor het eerst vermelde Middelwijk ontwikkelde zich een hoofdnederzetting van het markegebied Suolla. Zwolle kreeg in 1230 stadsrechten en kwam tot ontwikkeling langs de Grote Aa (tracé Melkmarkt, Oude Vismarkt, Gasthuisplein). Een grote stadsbrand in 1324 legde waarschijnlijk vrijwel de gehele stad in de as. Bij het herstel werd ook een stenen ommuring opgetrokken. Belangrijk voor de structuur van de stad waren de uitvalswegen naar Assendorp (Sassenstraat), Kampen (Voorstraat) en Dieze (Diezerstraat). Parallel aan die straten en de Grote Aa (Melkmarkt) werden in de 14de eeuw in het noorden de Nieuwstraat en in het zuiden de Kamperstraat aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01113> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1113 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "In de stad werden vanaf het begin van de 14de eeuw verschillende kerken, kloosters en conventen gesticht, zoals het Bethlehemklooster (1309), het convent of fraterhuis van de broeders des Gemenen Levens (1384), het Geertruidsconvent van de zusters des Gemenen Levens (1390) en de O.L. Vrouwekerk (1394). Nabij de stad lagen in de late middeleeuwen nog twee kloosters van de Moderne Devotie, dat op de Agnietenberg (gesloopt) en dat te Windesheim (grotendeels gesloopt)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01114> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1114 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Het open terrein ten zuiden van de Grote Kerk was in de 15de eeuw op zijn minst gedeeltelijk in gebruik als markt. Aan de oostzijde lag het stadhuis met het Wijnhuis en de Raadhuistoren (1448) en de stadsschool (vernieuwd in 1445). Waarschijnlijk midden 15de eeuw richtte men op een overkluizing van de Grote Aa een nieuwe markt in, de Grote Markt. Dit vormde de aanleiding voor de bouw van een groot noordportaal bij de kerk (circa 1464)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01115> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1115 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Bij de laatste middeleeuwse stadsuitleg trok men een smalle strook ten noorden van de Kleine Aa bij de stad. Door deze uitleg, waarvan de ommuring tussen 1473 en 1496 werd opgetrokken, kwam het in 1465 buiten de muren gestichte dominicaner- of Broederklooster binnen de stad te liggen. Omstreeks 1500 had de stad enkele waterpoorten en vijf landpoorten, waarvan alleen de Sassenpoort nog goed behouden is. Na het beleg van de stad in 1524 door hertog Karel van Gelre koppelde men de Luttekepoort in 1531 aan een nieuwe zware ronde Kruittoren, ook wel de Gelderse toren geheten. Langs de zuidzijde had de stad een dubbele stadsmuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01116> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1116 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "In de stad was er veel handel in agrarische producten. Veeteelt en de handel in vee boden ook werk aan leerbewerkers en schoenmakers. Verder was de linnenweverij belangrijk. In het begin van de 14de eeuw werden er al vijf jaarmarkten gehouden. Zwolle ontwikkelde zich in de middeleeuwen tot een centrum in de doorvoerhandel en onderhield goede contacten met de Duitse Hanze, waarin het vanaf 1407 formeel was opgenomen. De Hessenweg was ook belangrijk voor de handelscontacten met de steden in Noord-Duitsland. In 1438 wist Zwolle zijn positie als stapelplaats voor de handel over de Vecht veilig te stellen. Door dat stapelrecht had Zwolle tot in de 17de eeuw een belangrijke plaats in de handel in Bentheimer zandsteen. Vanuit de stad bereikte men de Vecht via het Zwarte Water. Bij de uitmonding van de Grote Aa in het Zwarte Water lag sinds 1437 een handelsterrein met stadskraan (nu Rodetorenplein). De brede kaden langs de Grote Aa (Melkmarkt) waren eveneens als haven in gebruik. Een poging in 1480 om de stad door een vaarwater met de IJssel te verbinden mislukte, vooral omdat Kampen tegenwerkte. Omstreeks 1495 verkortte de route naar de Vecht door het graven van de Nieuwe Vecht. Begin 17de eeuw moderniseerde men de vestingwerken door aarden wallen en zes bastions aan te leggen. Grote delen van de stadsmuur in het zuidelijke deel van de stad werden geslecht; langs het oude tracé verrezen huizen aan de Koestraat. Voor de Sassenpoort legde men een hoornwerk aan, hetgeen nog herkenbaar is in het beloop van de Karnebeekstraat, de Zuiderkerkstraat en de Zeven Alleetjes. In 1606-'19 werd een gebied ten noorden van de oude stad omgracht en voorzien van vijf bastions. Dit Noordereiland was vooral belangrijk voor scheepvaart en nijverheid. De sloop van diverse gebouwen van het Bethlehemklooster deed in 1645 de Botermarkt (nu Nieuwe Markt) ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01117> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1117 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "In de tweede helft van de 17de eeuw werd de positie van Zwolle als streekcentrum versterkt, mede doordat Deventer terugviel. In de handel tussen Amsterdam en Duitsland bleef de stad een rol spelen. De nijverheid bloeide in de 18de eeuw dankzij de zout- en zeepziederijen en de verwerking van suiker, tabak en koffie. Langs de Voorstraat, de Kamperstraat en de Koestraat kwamen imposante stadshuizen tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01118> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1118 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill415> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "283" ;
        schema:pagination "283-284" ;
        schema:text "Na in de Bataafse Republiek en het Koninkrijk Holland eerst als hoofdstad van het Departement van de Oude IJssel te hebben gediend, werd Zwolle bij de bestuurlijke herindeling van 1811 formeel hoofdstad van Overijssel. Dit leidde onder meer tot de bouw van het Paleis van Justitie (1841) aan de Blijmarkt en de Provinciale Griffie (1874) aan de Diezerstraat. De stedelijke elite, waaronder nu ook veel hoge ambtenaren waren, liet ruime behuizingen bouwen. Het vroege opheffen van de vesting - in 1790 - maakte een geleidelijke transformatie van de vestinggordel mogelijk. De sloop begon in 1810 met de Luttekepoort en de Nieuwe Kruittoren. Vanaf 1828 pakte men de sloop en herinrichting systematischer aan en men voltooide deze omstreeks 1840. Op de voormalige wallen en bolwerken werden plantsoenen en wandelpaden aangelegd en later ook woningen en herenhuizen (Eekwalbolwerk, Potgieterssingel, Van Nahuysplein, Ter Pelkwijkpark)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01119> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1119 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "In 1819 kwam de Willemsvaart tot stand, de reeds lang gewenste verbinding met de IJssel. Hierdoor ontwikkelden de Eekwal en de Jufferenwal zich als havengebied. Met de bouw van de Nieuwe Havenbrug in 1875 en de Schuttevaerbrug (Dijkstraat) in 1876 werden respectievelijk het westelijke en het noordelijke stadsgedeelte beter ontsloten. Na een hevige cholera-epidemie overkluisde men tussen 1857 en 1861 de Grote en de Kleine Aa. De Melkmarkt kreeg toen zijn huidige vorm; de oude haven aan het begin van het Zwarte Water werd in 1888 gedempt en veranderd in het Rodetorenplein. De belangrijkste ingreep in oude binnenstad was de sloop in 1867 van het Wijnhuis, de Raadhuistoren en de Latijnse school voor de bouw van de Brouwersschool (gesloopt in 1936)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01120> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1120 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "Door het ruimen van het Grote Kerkhof ontstond ten zuiden van de kerk het Grote Kerksplein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01121> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1121 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "In 1865 kreeg Zwolle spoorverbindingen met Utrecht en Kampen en vervolgens met Meppel (1866), Deventer (1867), Almelo (1880), Apeldoorn (1888; inmiddels opgeheven) en Ommen (1903), waardoor de stad een belangrijk spoorwegknooppunt werd. Daarnaast waren er tramverbindingen naar het Katerveer (1885), Hardenberg (1895), Nunspeet (Zuiderzeetram, 1908) en Blokzijl (1914); deze lijnen werden in de jaren dertig opgeheven. Het in 1868 voltooide spoorwegstation lag op enige afstand van de oude binnenstad. In het gebied tussen station en stadsgracht (de Weezenlanden) verrezen monumentale herenhuizen en villa's met grote tuinen (Burgemeester Van Roijensingel, Stationsweg). De, inmiddels door verbouwingen totaal gewijzigde, Buitensociëteit was belangrijk voor het uitgaansleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01122> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1122 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "Zwolle was vanouds een drukkersstad en de grafische industrie kwam hier dan ook tot volle ontwikkeling met de drukkerijen Tijl (1777), Waanders (1836), Tjeenk Willink (1838) en Tulp (1869). Vanaf het midden van de 19de eeuw kwamen daar ijzergieterijen bij, zoals De Nijverheid (1851) van G.J. Wispelwey en Sallandia (1854). Op het Noordereiland en bij het Rodetorenplein vestigden zich verschillende fabrieken. Zeer belangrijk was de komst in 1870 van de Centrale Werkplaats van de Staatsspoor (gesloten in 1938), hetgeen leidde tot een forse uitbreiding van Assendorp. Het toenemend belang van de Zwolse veemarkt leidde in 1880 tot de verhuizing van de Ossenmarkt naar de Harm Smeengekade en vervolgens in 1931 naar de Veemarkt (tegenwoordig de IJsselhallen)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01123> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwolle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwolle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1123 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "In het eerste kwart van de 20ste eeuw kwamen de wijken Veerallee, Zeeheldenbuurt, Pierik en Wipstrik tot stand. In 1949 maakten W.M. Dudok en A. Kraayenhagen een plan voor uitbreiding van de stad naar het noorden en ten zuiden van de spoorlijn. Uiteindelijk zou een plan van S.J. van Embden uit 1956 de basis vormen voor de wijken Holtenbroek en de Aa-landen (1965). Langs het Zwarte Water kwamen industrieterreinen, ontsloten door het in 1964 voltooide Zwolle-IJsselkanaal. De hierdoor in belang verminderde Willemsvaart werd kort daarop deels gedempt. Door de bouw van de brug over het Zwarte Water kon een rondweg rond de binnenstad worden voltooid. Ten zuiden van het spoor kwam na de aanwijzing tot groeistad in 1976 Zwolle-Zuid tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

