        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 541 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill212> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "154" ;
        schema:pagination "154-155" ;
        schema:text "Esdorp, oorspronkelijk gelegen aan de (verlegde) Buurserbeek tussen de Honesch en Zienesch. Het dorp kwam tot ontwikkeling bij de in 1188 voor het eerst genoemde parochiekerk en bij het reeds in de 16de eeuw verdwenen kasteel Blankenborg. Door de toenemende huisweverij verdichtte het dorp zich in de loop van de 17de en 18de eeuw. De aanleg van de spoorlijn Winterswijk-Enschede in 1884-'85 had ten gevolge dat aan de noordwestzijde van het dorp fabrieken werden gebouwd. In de 20ste eeuw breidde het dorp zich sterk uit in westelijke en noordelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00542> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:adres "Markt 9" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14912>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37161> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "18873",
            "18874" ;
        min:soort "inleiding" ;
        min:volgnummer 542 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De R.K. St.-Pancratiuskerk (Markt 9) is een driebeukige hallenkerk met driezijdig gesloten koor en een forse toren van vier geledingen met ingesnoerde, achtzijdige spits. De voornamelijk in Bentheimer zandsteen opgetrokken middeleeuwse kerk werd in 1888-'89 grotendeels vernieuwd en vergroot. Oorspronkelijk bestond de kerk uit een 12de-eeuws schip met koorabsis. Van deze oudste bouwfase bleef slechts het in ijzeroer uitgevoerde muurwerk van de zwikken van de drie westelijke traveeën van het middenschip bewaard. In een tweede fase werd aan het schip een smaller koor met absis toegevoegd. Vervolgens kreeg het koor een rechte koorsluiting. In de tweede helft van de 15de eeuw kwam uiteindelijk een driezijdige sluiting tot stand; hiervan bleef in 1888 een klein restant gespaard. In het begin van de 16de eeuw verrees het nog bestaande zuidkoor met driezijdige sluiting. Getuige het jaartal 1520 boven de huidige zuidingang is de rest van de zuidbeuk iets jonger. In het derde kwart van de 16de eeuw kwam de toren met uitgebouwde traptoren tot stand; naast de met het bovengelegen venster in een spitsboognis gevatte ingang is het jaartal ‘1565’ te zien. De derde geleding heeft blinde spitsboognissen met flamboyante traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00543> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 543 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Bij de restauratie onder leiding van A. Tepe in 1888-'89 werd de kerk vergroot, waarbij de nieuwe delen in stijl en materiaal werden aangepast aan de behouden laatgotische delen. Nieuw opgetrokken werden het hoofdkoor, de noordelijke zijbeuk en een westelijke travee van de zuidelijke zijbeuk. Door de uitbreiding werd de toren tussen de zijbeuken ingebouwd. Het interieur kreeg nieuwe, gepleisterde kruisribgewelven. Aan de noordwestzijde voegde men een met stergewelven overkluisde doopkapel toe en aan de zuidoostzijde een sacristie. In 1974-'76 is de kerk voor een tweede keer gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00544> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 544 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De oudste delen van de kerkinventaris zijn het triomfkruis (eerste kwart 19de eeuw) en vier eikenhouten beelden afkomstig van een preekstoel in de Martinuskerk te Utrecht (derde kwart 19de eeuw). Verder dateert de inventaris uit het laatste decennium van de 19de eeuw en uit de 20ste eeuw. Het marmeren doopvont werd in 1888 geschonken door de weduwe Ter Pelle. Drie reliëfs met voorstellingen van de evangelisten (1891) en vier eikenhouten beelden, waaronder de H. Pancratius en een Mariabeeld (omstreeks 1891), komen uit het atelier van F.W. Mengelberg. Twee overige reliëfs zijn gemaakt door het atelier van J. Cuypers (omstreeks 1920) en zijn afkomstig van de communiebanken van de Martinuskerk te Utrecht. De muurschildering tegen de torenmuur, voorstellende de H. Pancratius die de gemeenschap onder zijn hoede neemt, is van H.G. Walstra (1941). H.J.J. Geuer maakte de gebrandschilderde ramen van onder andere de beide zijkapellen (1892) en de absis (omstreeks 1895); J. Mengelberg die naast het zangkoor (1952). Het tabernakel van hout, koper en gekleurde stenen is van de hand van J. Noyons (1976)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00545> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:adres "Markt 20",
            "Ruischenborg 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24757> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507751" ;
        min:soort "inleiding" ;
        min:volgnummer 545 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De pastorie (Markt 20), met aangebouwd catechisatielokaal, werd in 1887 gebouwd naar ontwerp van G. te Riele met neogotische en neorenaissance-elementen. De synagoge (Ruischenborg 1) is een eenvoudig gepleisterd zaalgebouw met zadeldak en spitsboogvensters, opgetrokken in 1828. Het gebouw is na jarenlange leegstand sinds 1980 weer als synagoge in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00546> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:adres "Markt 12",
            "Von Heydenstraat 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35300> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507752" ;
        min:soort "inleiding" ;
        min:volgnummer 546 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De Herv. kerk (Von Heydenstraat 4) is een achthoekig gebouw met een tentdak voorzien van een achtzijdige houten dakruiter met omloop en spits. De kerk werd gebouwd in 1854 in classicistischeclectische vormen naar ontwerp van G. Doorwaart Niermans ter vervanging van een afgebrande koepelkerk uit 1810. Het interieur wordt gedekt door gestucadoord hout met steekkappen. Het orgel uit 1864 werd gemaakt door H. Honhof. De vrijstaande pastorie (Markt 12) is een blokvormig, eclectisch gebouw uit 1875, eveneens naar ontwerp van G. Doorwaart Niermans."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00547> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaksbergen"@nl ;
        min:adres "Sonderenstraat 15",
            "Veldmaterstraat 61",
