        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "De Geref. kerk (Dorpsweg 104) is een bakstenen zaalkerk met ongelede toren, gebouwd in 1955 in sobere traditionalistische vormen. De nabijgelegen bijbehorende predikantenwoning (Dorpsweg 39) stamt uit 1932."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0110.php> .

