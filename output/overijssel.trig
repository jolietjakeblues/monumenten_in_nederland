        min:soort "inleiding" ;
        min:volgnummer 750 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0067> ;
        schema:name "Lutten (gemeente Hardenberg)"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "De Herv. kerk (Anerweg Noord 42) is een forse zaalkerk met rechtgesloten koor en ingangsrisaliet met omlijste ingangspartij. De risaliet gaat over in een geveltoren met vierzijdige houten lantaarn en korte ingesnoerde spits. De kerk, in eenvoudige neoclassicistische vormen, dateert van 1853 en heeft aan de achterzijde een lagere aangebouwde consistoriekamer met daarnaast de kosterswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0067.php> .

