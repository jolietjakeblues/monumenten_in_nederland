        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 656 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "IJsselmuiden"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De Ned. Geref. kerk (Burg. Van Engelenweg 177) is een zaalkerk uit 1933, gebouwd naar plannen van B.T. Boeyinga. Het hoog opgaande dak heeft karakteristieke dakkapellen en een overhoeks geplaatste dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00657> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJsselmuiden"@nl ;
        min:adres "Trekvaart 1-9" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "IJsselmuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 657 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "IJsselmuiden"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De rijkspolitiekazerne met dienstwoningen (Trekvaart 1-9) kwam in 1938 tot stand. De gebouwen met hun bakstenen begane grond en gepleisterde verdieping vertonen een combinatie van traditionalistische en functionalistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00658> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJsselmuiden – Woonhuizen"@nl ;
        min:adres "Burg. Van Engelenweg 4",
            "Burg. Van Engelenweg 92A",
            "Dorpsweg 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "IJsselmuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 658 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill257> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "183" ;
        schema:pagination "183-184" ;
        schema:text "Woonhuizen. Het laatste voorbeeld van een buitenplaats in dit gebied is Hu is Meerburg (Dorpsweg 6). Het grote eclecticistische pand met schilddak verrees op de plaats van een ouder, in 1820 verbouwd buitenhuis. De Kamper sigarenfabrikant J.H. van Hulst kocht het in 1884 en liet een verbouwing uitvoeren naar plannen van W. en F.C. Koch. De voorgevel stamt van die verbouwing, evenals het in chaletstijl uitgevoerde tuinhuis (Burg. Van Engelenweg 92A). Na een brand in zijn fabriek vertrok Van Hulst naar Amsterdam en werd de buitenplaats in delen verkocht. Van 1912 tot 1942 was in het huis de wasserij en blekerij van Hofschutze gevestigd. Het is nu in gebruik als dagverblijf voor gehandicapten. De dubbele woning Burg. Van Engelenweg 51-53 werd in 1897 in neorenaissance-vormen gebouwd. De villa Stadewijk (Burg. Van Engelenweg 4), met een torenvormig bekroonde, doorlopende erker en jugendstil-details, verrees in 1907 naar plannen van G.B. Broekema. Van 1941 tot 1974 heeft het gediend als raadhuis van IJsselmuiden. Een zelfde, sober jugendstil-karakter heeft het uit 1916 stammende woonhuis Burg. Van Engelenweg 117, eveneens opgetrokken naar plannen van G.B. Broekema, voor de hooi- en riethandelaar H.J. Bruins. Hij ontwierp ook de volkswoningbouw Plasweg 4-8 en Burg. Meijerweg 1-17 uit 1921 voor de Woningstichting Beter Wonen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00659> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJsselmuiden – Begraafplaatsen"@nl ;
        min:adres "Rondeweg 5",
            "Rondeweg 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "IJsselmuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 659 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill258> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Begraafplaatsen. Op de Zandberg ligt een complex van in totaal vier begraafplaatsen, waarvan er drie onder het beheer van de gemeente Kampen vallen. De Alg. begraafplaats van Kampen (Rondeweg 7) werd in 1829 gesticht en in 1871 vergroot. De kapel en beheerderswoning dateren uit 1931. Op de begraafplaats, met een fraaie ‘Terebinth’- of terpentijnboom, ligt een aantal belangrijke graven, waaronder die van de Kamper burgemeesters H.A. Wttewaal van Stoetwegen (†1866), met gebroken zuil, S.H. de la Sablonière (†1888) en L.W. Ebbinge (†1896), beide met obelisk. Andere bijzondere graven zijn die van dokter D. Mestingh (†1900), R.P.R. van Riemsdijk (†1896) en W.W. van Riemsdijk (†1899). Aan de overzijde van de Rondeweg ligt de omstreeks 1829 gestichte, ommuurde Isr. begraafplaats van Kampen (Rondeweg ong.). Het bevat een reinigings- of metaarhuisje uit omstreeks 1890 en vele grafstenen, waarvan één paar door middel van siersmeedwerk met elkaar verbonden is. Aan de noordzijde tegenover de Isr. begraafplaats ligt de R.K. begraafplaats van Kampen (Rondeweg ong.), gesticht in 1888. Centraal staat de rijk uitgevoerde neogotische kapel uit 1889, opgetrokken naar plannen van A.C. Boerma uit Amsterdam die ook het hek ontwierp. De luidklok werd door Petit & Fritsen gegoten. Ten zuiden van de Alg. begraafplaats ligt nog de in 1871 gestichte Alg. begraafplaats van IJsselmuiden (Rondeweg 5)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00660> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJsselmuiden – Grafhorst"@nl ;
        min:adres "Kamperzeedijk 7-9" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "IJsselmuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselmuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJsselmuiden" ;
        min:lemma "Grafhorst" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 660 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0057> ;
        schema:name "Grafhorst"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Grafhorst. Dit dijkdorp ten noorden van IJsselmuiden ontstond op een rivierduin langs de IJssel. In 1333 kreeg het weliswaar stadsrechten, maar het is nooit tot een stad uitgegroeid. De compacte bebouwing van dit voormalige vissersdorp bestaat uit een voor- en achterstraat met haaks daarop de Kamperzeedijk. Kerkelijk gezien behoorde het eeuwenlang tot IJsselmuiden. Het ten oosten van Grafhorst gelegen gemaal De Rambonnet (Kamperzeedijk 7-9) werd gebouwd in 1907-'09, ter bemaling van de in 1911 drooggelegde polders De Koekoek en Zwijnsleger. In 1958 brak men de woningen boven het voorste deel van het gemaal af. Na het samengaan van de waterschappen Mastenbroek en De Koekoek in 1978 is het gemaal buiten werking gesteld en vervangen door het nieuwe, oostelijker gelegen, elektrische vijzelgemaal Nieuw Lutterzijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00661> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kampen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "Kampen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kampen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Kampen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 661 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0058> ;
        schema:name "Kampen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Stad, ontstaan op een opgehoogde wal in het veengebied op de linkeroever van de IJssel, nabij de riviermonding. Vanaf omstreeks 1100 zal ter plaatse van het zuidelijke deel van de Oudestraat een lintbebouwing zijn ontstaan. Vanwege de wateroverlast bouwde men op terpen of ‘werven’. Een algehele bedijking van de rivier om die overlast te beperken kwam pas in het begin van de 14de eeuw tot stand. Toen werden ook de St.-Nicolaasdijk en de Zwartendijk aangelegd als bescherming tegen de Zuiderzee. In het begin van de 13de eeuw werd Kampen een zelfstandige parochie. Aan de zuidzijde van de Oudestraat bouwde men een kerk gewijd aan St. Nicolaas - schutspatroon van de kooplieden. Door scheepvaart en handel kwam de nederzetting snel tot ontwikkeling. Vóór het midden van de 13de eeuw verwierf Kampen stedelijke zelfstandigheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00662> a min:Passage,
            schema:CreativeWork ;
