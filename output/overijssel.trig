        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengevelde (gemeente Ambt Delden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hengevelde" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 630 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0052> ;
        schema:name "Hengevelde (gemeente Ambt Delden)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "Dorp, ook wel Wegdam genoemd, ontstaan bij de kruising van de wegen Delden-Neede en Goor-Haaksbergen, waar in 1806 een katholieke kerk werd gesticht. Na de Tweede Wereldoorlog is het dorp in zuidelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00631> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengevelde (gemeente Ambt Delden)"@nl ;
        min:adres "Goorsestraat 17" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Ambt Delden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengevelde (gemeente Ambt Delden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hengevelde" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 631 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0052> ;
        schema:name "Hengevelde (gemeente Ambt Delden)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De R.K. kerk H.H. Petrus en Paulus (bij Goorsestraat 17) is een basilicale kerk met rechthoekige toren voorzien van dwars zadeldak, een achtzijdige doopkapel en een koor met driezijdig gesloten absis. De kerk verrees in 1952-'54 naar ontwerp van R.Th. van Remmen ter vervanging van een voorganger uit 1844. Aan de westzijde vormt een galerij de verbinding met de gelijktijdig gebouwde pastorie (Goorsestraat 17). Daarnaast staat nog een waarschijnlijk vroeg-19de-eeuws koetshuisje. De tegenover de kerk gelegen R.K. begraafplaats is in 1844 aangelegd en heeft midden-18de-eeuwse zandstenen rococo-hekpijlers. Het lijkenhuisje dateert van omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0052.php> .

