        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Dorp, ontstaan als kransesdorp. In de 20ste eeuw ontwikkelde zich een dorpskern rond de op de es gelegen kerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00290> a min:Passage,
