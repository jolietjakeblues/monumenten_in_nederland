        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Albergen (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Albergen" ;
        min:lemma "Boerderij" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0007-01> ;
        schema:name "Boerderij"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "Boerderij ‘De Boerrichter’ (Zuidesweg 1), gelegen ten zuidwesten van Albergen, is een dwarshuisboerderij uit 1923, ontworpen door J. Wiegers voor de landbouwer G. Kleissen. Het monumentale eenlaags voorhuis heeft een hoger opgetrokken middenrisaliet en vertoont expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00184> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 184 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "Stad, ontwikkeld als langgerekte nederzetting bij de plaats waar een landweg (nu Grotestraat) het stroomdal van de Aa kruiste. De overgang werd beheerst door Huis Almelo, dat in 1236 voor het eerst wordt genoemd, toen Hendrik van Almelo toestemming kreeg om bij zijn kasteel een kapel te stichten, de huidige Herv. kerk. Leden van de familie Van Almelo worden al eerder genoemd. Mogelijk heeft Huis Almelo de positie overgenomen van de meer westelijk gelegen Schulenborg, een waarschijnlijk 11de-eeuwse landsheerlijke burcht die in 1227 werd afgebroken. In 1420 blijkt de nederzetting stadsrechten te bezitten. Van militair belang is de stad nooit geweest, want ze was wel omgracht maar niet ommuurd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00185> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 185 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "In de 17de en 18de eeuw nam de huisweverij sterk in belang toe. Een groot aantal kleine wevershuisjes stond op de achterterreinen van de vaak monumentale huizen aan de Grotestraat van doopsgezinde fabrikeurs als Coster, Hofkes en Bavink. De stoommachine, die in 1830 in Almelo zijn intrede maakte bij de weverij van H.E. Hofkes & Co., leidde tot de overschakeling van de huisweverij naar een fabrieksmatige productiewijze. De aanleg van het Overijssels Kanaal in 1855 en de spoorlijn Almelo-Salzbergen in 1865 bevorderden de bouw van weverijen en spinnerijen. De meeste fabrieken werden in de buurt van het kanaal en spoorlijn gevestigd. Niet succesvol was het graven van het kanaal Almelo-Nordhorn in 1888-'89."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00186> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 186 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill55> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "Omstreeks 1900 woonde de rijke bovenlaag van Almelo in villa's langs de uitvalswegen, zoals de Ootmarsumse-, de Bornse- en de Wierdensestraat. De samenvoeging van de gemeenten Staden Ambt-Almelo in 1914 had ten gevolge dat de stad naar het zuiden, noorden en westen uitbreidde. Er ontstonden arbeiderswijken, zoals het tuindorp De Riet. Na de Tweede Wereldoorlog groeide de stad nog sterk door. Recentelijk hebben de sloop van de textielfabrieken en de sanering van grote delen van de binnenstad Almelo ingrijpend veranderd. Het gebied nabij het huidige Centraal Station (1962) is geherstructureerd. Op de plaats van de fabriek Nijverdal-Ten Cate verrees het nieuwe gerechtsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00187> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:adres "Kerkplein 15" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34623> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "7486" ;
        min:soort "inleiding" ;
        min:volgnummer 187 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "De Herv. kerk (bij Kerkplein 15), in oorsprong de slotkapel bij Huis Almelo, heeft een driezijdig gesloten, zandstenen koor uit 1493. De rest van de eenbeukige kruiskerk is tot stand gekomen bij herbouw in 1738. De toren van twee geledingen heeft hoeklisenen en een ingangspartij met uitgebreid Latijns opschrift uit 1738. De in 1777 toegevoegde, opmerkelijke houten koepelspits is waarschijnlijk geïnspireerd op torenbekroningen uit de geboortestreek van de toenmalige vrouwe van Almelo (Van Rechteren-Von-Castell), het gebied rond Rüdenhausen (D.). In 1835 heeft men de kerk gemoderniseerd, waarbij ook de venstertraceringen zijn veranderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00188> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 188 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill56> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "53" ;
        schema:pageStart "52" ;
        schema:pagination "52-53" ;
        schema:text "Het interieur wordt overdekt door vlakke houten plafonds uit het tweede kwart van de 18de eeuw. Er zijn diverse, meest zandstenen, grafstenen, waaronder het priestergraf van meester Johan ter Bruegge (†1562) en een rijk bewerkte grafsteen van Carel August Emanuel van Rechteren tot Vellenaer (†1789). In het koor staat een marmeren epitaaf voor Adolf Hendrik van Rechteren (†1731) en zijn echtgenote Sophia Juliana von Castell (†1758) uit 1772 met diverse vergankelijkheidssymbolen, pilasterschachten met 16 kwartieren en een grijze piramide met de wapens Van Rechteren en Castell Rüdenhausen en het wapen van Almelo. De kerk bevat verder onder meer een eiken gravenbank (tweede kwart 18de eeuw) met op de overhuiving het wapen Van Rechteren-Limpurg, enkele rouwborden van de familie Van Rechteren en 20ste-eeuwse luchters van Venetiaans glas. De door A.A. Hinsz gebouwde orgelkast dateert uit 1754; het binnenwerk werd in 1890 en in 1962-'63 vervangen, de laatste keer door W. van Leeuwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00189> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo"@nl ;
        min:adres "Grote Straat 57" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 189 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Almelo"@nl ;
        schema:pageEnd "53" ;
        schema:pageStart "53" ;
        schema:pagination "53" ;
        schema:text "De Doopsgez. kerk (Grote Straat 57) is een uit 1684 daterende zaalkerk, die in 1791 een nieuwe halsgevel in Lodewijk XVI-stijl kreeg. De ingang en het daarboven gesitueerde venster zijn gevat in een classicistische omlijsting. In het middenrisaliet zit een ingangsomlijsting met ionische pilasters en festoenen. In 1978 is de kerk gerestaureerd. Het interieur wordt overdekt door een midden-18de-eeuws tongewelf. Veel interieuronderdelen dateren uit omstreeks 1791, zoals de kansel in Lodewijk XVI-stijl, de twee kerkenraadsbanken, het orgel door Friedrich Heilmann uit Herbern (D.) - in de 19de eeuw ingrijpend gewijzigd door J. Armbrost en G. Elberink - en het tochtportaal. Het uurwerk van dat portaal is in 1736 gemaakt en geschonken door de Almelose arts en klokkenmaker Hendrik van Heilbron. De zeven gebrandschilderde ramen met art deco-patronen in de bogen dateren uit 1927."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

