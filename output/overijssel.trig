        min:soort "inleiding" ;
        min:volgnummer 296 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0021> ;
        schema:name "Colmschate (gemeente Deventer)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Rondom de al in 1972 voor Deventer gebouwde wijk het Oostrik verrezen in snel tempo enige uitbreidingswijken: Groot Douwel (1976), Blauwenoord (1982), Colmschaterenk (1985), 't Roesink (1986), 't Bramelt (1988), Essenerveld (1990) en 't Swormink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0021.php> .

