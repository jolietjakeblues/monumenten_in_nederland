        min:kern "Deventer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21242> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "510759" ;
        min:soort "inleiding" ;
        min:volgnummer 411 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0032> ;
        schema:name "Deventer"@nl ;
        schema:pageEnd "105" ;
        schema:pageStart "105" ;
        schema:pagination "105" ;
        schema:text "De voorm. synagoge (Golstraat 23) [6] werd in 1892 (5652) gebouwd naar plannen van stadsarchitect J.A. Mulock Houwer en is een fraai voorbeeld van een gebouw in oriëntaalse of Moorse bouwtrant. In de geveltop staan in het Hebreeuws de tien geboden. Inwendig resteert slechts een galerij; het interieur werd in 1941 vernield. Sinds 1952 is het in gebruik bij de Chr. Geref. Gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00412> a min:Passage,
            schema:CreativeWork ;
