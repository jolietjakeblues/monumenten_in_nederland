        schema:pageEnd "156" ;
        schema:pageStart "156" ;
        schema:pagination "156" ;
        schema:text "Het raadhuis (Markt 1) werd gebouwd in 1940-'41 naar ontwerp van J.Th.J. Cuypers en P. Cuypers jr. in de trant van de Delftse School. Een tweevleugelige bordestrap geeft toegang tot de bel-etage."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

