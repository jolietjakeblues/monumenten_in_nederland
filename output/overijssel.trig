        min:hoofdstuk "Steden, dorpen, monumenten › Lattrop (gemeente Denekamp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lattrop" ;
        min:lemma "Windmolen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 718 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0061> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "Windmolen de ‘Ortmanmolen’ (Dorpsstraat 23) is een achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet. De in 1900 te Tjamsweer (Groningen) gebouwde molen werd in 1910 naar Lattrop overgebracht. Bij de restauratie in 1983 is de molen iets noordelijker dan voorheen herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00719> a min:Passage,
