        schema:pagination "146" ;
        schema:text "Dorp, ontstaan aan de Geesterense Es. Bij de in 1800 gestichte kerk kwam in de 20ste eeuw een dorpskern tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0039.php> .

