        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0037> ;
        schema:name "Enter (gemeente Wierden)"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text "De voorm. Geref. kerk (Dorpsstraat 67) is een eenvoudige midden-19de-eeuwse zaalkerk met dakruiter en hoeklisenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00492> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enter (gemeente Wierden)"@nl ;
        min:adres "Dorpsstraat 125" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Wierden" ;
        min:gemeenteInBoek "Wierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wierden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enter (gemeente Wierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Enter" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 492 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0037> ;
        schema:name "Enter (gemeente Wierden)"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text "De R.K. kerk St.-Antonius Abt (Dorpsstraat 125) is een neogotische basilicale kruiskerk met smaller, driezijdig gesloten koor en een toren van drie geledingen met hoeksteunberen en een ingesnoerde spits. De kerk werd gebouwd in 1927-'28 naar ontwerp van C.A. Hardeman ter vervanging van een kerk uit 1818. Naast de kerk staan een pastorie (Dorpsstraat 123 en een zusterklooster uit de bouwtijd van de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00493> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enter (gemeente Wierden) – 't Cattelaar"@nl ;
        min:adres "Kartelaarsdijk 11",
            "Kartelaarsdijk 7-9" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Wierden" ;
        min:gemeenteInBoek "Wierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wierden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enter (gemeente Wierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Enter" ;
        min:lemma "'t Cattelaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44178> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38902" ;
        min:soort "lemma" ;
        min:volgnummer 493 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0037> ;
        schema:name "'t Cattelaar"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text """'t Cattelaar (Kartelaarsdijk 7-9). Van deze in de 17de eeuw ten zuidoosten van Enter gestichte buitenplaats is het omgrachte landhuis omstreeks 1830 gesloopt. Een omstreeks 1700 door de Deventer patriciërsfamilie Borgerink opgetrokken bouwhuis is bewaard gebleven; het bakstenen gebouw is voorzien van een inrijpoort en deur- en vensteromlijstingen in zandsteen.

De schippersherberg ‘Binnengait’ (Kartelaarsdijk 11), ten zuidoosten van Enter, is een mogelijk laat-18de-eeuwse krukhuisboerderij met een van twee doorritten voorziene schuur uit 1813. Oorspronkelijk was het een bij 't Cattelaar behorende schippersherberg bij een overslagplaats aan de Regge."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enter (gemeente Wierden) – Boerderijen"@nl ;
        min:adres "Kartelaarsdijk 8",
            "Rijssenseweg 40" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Wierden" ;
        min:gemeenteInBoek "Wierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wierden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enter (gemeente Wierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Enter" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38822> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38906" ;
        min:soort "lemma" ;
        min:volgnummer 494 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0037> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "146" ;
        schema:pageStart "145" ;
        schema:pagination "145-146" ;
        schema:text """Boerderijen. Rond het dorp en in de buurtschap Enterbroek liggen interessante boerderijen. De waarschijnlijk 18de-eeuwse langhuisboerderij Witmoesdijk 20 is deels met riet en deels met pannen gedekt. De niendeuren liggen meer inwaarts in een onderschoer. Het woon-gedeelte bezit een uitkragend wolfeinde. De Rohaan (Rijssenseweg 40), gelegen aan de westzijde van de Enterse Es, is een in 1832 gebouwde forse langhuisboerderij; de oorspronkelijke houten voorschotten zijn omstreeks 1900 in baksteen vervangen. Het woongedeelte bezit aan de rechterzijde een bovenkamer en een aangebouwde schuur met wolfdak uit 1846. De tot het landgoed Twickel behorende langhuisboerderij Beumersweg 3 uit 1843 heeft een overstek aan de voorzijde en een onderschoer aan de achterzijde. Andere 19de-eeuwse langhuisboerderijen zijn Koerdam (Kartelaarsdijk 8) uit 1856 met uitgebouwde bovenkamer, Beumersweg 1 (tweede helft 19de eeuw), Beumersweg 5 en Bullenhaarsweg 16-16A met afgewolfd rieten dak en op het erf een bakhuisje.

De voorm. brugwachterswoning Enterweg 29 bij de ten noorden van Enter gelegen brug over de Regge is een eclectisch, met riet gedekt eenlaagspand uit 1897. Omstreeks 1930 is de ophaalbrug vervangen door een vaste brug."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0037.php> .

