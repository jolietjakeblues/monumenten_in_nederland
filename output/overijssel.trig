        schema:name "Boskamp (gemeente Olst)"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Het klooster St. Willibrordus (Boskamp 21) is een pand met mansardeschilddak en een slanke dakruiter; het verrees omstreeks 1929 naar plannen van C.A. Hardeman, in expressionistische vormen. Het is nu in gebruik als bejaardentehuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0019.php> .

