        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hardenberg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hardenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57671> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "454878" ;
        min:soort "inleiding" ;
        min:volgnummer 558 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill217> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0046> ;
        schema:name "Hardenberg"@nl ;
        schema:pageEnd "159" ;
        schema:pageStart "158" ;
        schema:pagination "158-159" ;
        schema:text "De (Geref.) Höftekerk (Synodaal) (Lage Doelen 3) is een neorenaissancistische achthoekige centraalbouw. De vier puntgevels zijn voorzien van ramen en het tentdak wordt bekroond door een achtkante dakruiter met ingesnoerde spits. De kerk werd in 1889-'90 gebouwd en lijkt sterk op die van Haaksbergen uit 1854. Aan de voorzijde werd ze in 1922-'23 in zakelijk expressionistische vormen uitgebreid naar plannen van T.E. Kuipers. De kerk bezit een orgel dat J.F. van Gelder en G.H. Jansen in 1826 bouwden voor de hervormde kerk te Baarn; het werd in 1889 naar Hardenberg overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00559> a min:Passage,
