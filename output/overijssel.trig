        min:kern "Losser" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 745 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill299> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0066> ;
        schema:name "Losser"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "214" ;
        schema:pagination "214-215" ;
        schema:text "De voorm. dorpsbleek (Scholtinkstraat bij 5) is waarschijnlijk in 1774 in opdracht van de dorpsgemeenschap aangelegd en heeft een aantal evenwijdige sloten en spoelbruggen. Het uit 1774 daterende eenlaags bleekwachtershuisje met vakwerkwanden is in 1963-'64 gerestaureerd door D. Hulshoff. De bleek is sinds 1948 eigendom van de gemeente Losser."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00746> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Losser – Industriegebouwen"@nl ;
        min:adres "Gronausestraat 309",
            "Oldenzaalsestraat 104" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Losser" ;
        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Losser" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Losser" ;
        min:lemma "Industriegebouwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43433>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71214>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74683>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74684>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74685>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74686>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74687>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74688>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74689>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74690>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74691> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "512144",
            "513489",
            "513490",
            "513491",
            "513492",
            "513493",
            "513494",
            "513495",
            "513496",
            "513497",
            "513506" ;
        min:soort "lemma" ;
        min:volgnummer 746 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0066> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "Industriegebouwen. In 1924 lieten de gebroeders Osse de steenfabriek ‘De Werklust’ (Oldenzaalsestraat 104) bouwen ter vervanging van een omstreeks 1895 gebouwde veldoven. Het is een van de laatste voorbeelden in Europa van een nog functionerende ringoven. Het complex bestaat uit een ovale ringoven van achttien ovens, zes bokschuren voor het drogen van de vormelingen en een bakstenen watertorentje met aangebouwde smederij. Een smalspoor voert naar een aan de Smuddeweg gelegen kleiput. De textielfabriek L. van Heek & Zn. (Gronausestraat 309) is in 1926-'28 naar plannen van A. Beltman gebouwd in opdracht van L. van Heek en zijn zoon H.J.P. van Heek. De fabriek produceerde weefgarens, tricotagegaren en verbandgaas en is nu een van de weinige nog functionerende Twentse textielfabrieken (nu Van Heek-Medical). De fabriek bestaat uit een drielaags spinnerij met plat dak, een hoge vierkante hoektoren die als watertoren dient, en een eenlaags weverij met shed-daken. Op de noordoosthoek staat een ketelhuis met schoorsteenpijp en aangebouwde kolenbunker in betonskeletbouw (1929), vergelijkbaar met die van de Bamshoeve in Enschede."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0066.php> .

