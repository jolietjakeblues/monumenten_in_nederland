    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00921> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Jansklooster (gemeente Brederwiede) – Windmolens"@nl ;
        min:adres "Barsbeek 6",
            "Molenstraat 1" ;
