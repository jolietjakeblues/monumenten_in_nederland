        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "39917" ;
        min:soort "inleiding" ;
        min:volgnummer 1091 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0112> ;
        schema:name "Zalk (gemeente IJsselmuiden)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De kleine dijkboerderij (Zalkerdijk 39), gelegen onder aan de IJsseldijk, is met riet gedekt. In het interieur bevinden zich een bedstede en een inpandig bakhuis. Op een van de gebinten staat het jaartal 1767."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01092> a min:Passage,
