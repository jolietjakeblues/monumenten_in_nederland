            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66016> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507923",
            "9933" ;
        min:soort "inleiding" ;
        min:volgnummer 273 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Borne"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De pastorie (Stationsstraat 1) werd gebouwd in 1887 naar ontwerp van N. Molenaar in neorenaissance-stijl. Het naastgelegen St.-Johannesklooster (Stationsstraat 5) is een tweelaags neogotisch klooster op U-vormige plattegrond. Op de verdieping van de zuidwestelijke vleugel bevindt zich de kapel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00274> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne"@nl ;
        min:adres "Grotestraat 23" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 274 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill84> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Borne"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "68" ;
        schema:pagination "68-69" ;
        schema:text "De R.K. kerk St.-Theresia van het Kindje Jezus (Grotestraat 23) is een neogotische driebeukige kerk met vijfzijdig gesloten koor, opgetrokken in 1933-'35 naar ontwerp van W. te Riele. In de kerk bevinden zich kruiswegstaties uit 1848, gemaakt door O. de Boer en afkomstig uit de St.-Plechelmuskerk te Oldenzaal. De gebrandschilderde ramen zijn van de hand van W. Mengelberg jr."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Overige kerken"@nl ;
        min:adres "Deldensestraat 78-80",
            "Grotestraat 142",
            "Schaepmanstraat 24",
            "Spoorstraat 9" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Overige kerken" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text """Overige kerken: De (Herv.) Nieuwe Kerk (Deldensestraat 78-80) is een kruiskerk met dakruiter en rechtgesloten koor, gebouwd in 1930 naar ontwerp van E. Jansen uit Borne. De Geref. kerk (Schaepmanstraat 24), een eenvoudige zaalkerk uit hetzelfde jaar, werd eveneens door hem ontworpen.

Het voorm. postkantoor (Grotestraat 142), in opdracht van de gemeente Borne gebouwd in 1884 in neorenaissance-stijl, is nu in gebruik als makelaarskantoor.

Het voorm. openbaar badhuis (Spoorstraat 9), een langwerpig eenlaags pand met dwarsgeplaatste voorbouw, werd gebouwd in 1919 in neoclassicistische trant naar plannen van A.G. Beltman. Opdrachtgever was de firma Spanjaard N.V. Het badhuis stond evenwel niet alleen voor fabrieksarbeiders open, maar voor alle inwoners van Borne."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Woonhuizen"@nl ;
        min:adres "Ennekerdijk 11" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48644> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "9918" ;
        min:soort "lemma" ;
        min:volgnummer 276 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill85> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Woonhuizen. In het dorp staat een aantal 18de- en 19de-eeuwse dorpswoonhuizen, die veelal later ingrijpend zijn verbouwd en vervolgens gerestaureerd. Het Bussemakershuis (Ennekerdijk 11) is een breed en diep eenlaags pand uit circa 1655 met een halsgevel die is voorzien van gebeeldhouwde zandstenen voluten. Getuige de gevelsteen is het in 1779 verbouwd voor de fabrikeursfamilie Bussemaker. Op de zolders bevinden zich vakken voor de opslag van linnen. Het pand is nu ingericht als museum. Marktstraat 27 is een omstreeks 1800 gebouwd eenlaags dwars pand met wolfdak en niendeur. Het eenvoudige, diepe eenlaags pand Marktstraat 3 dateert uit de eerste helft van de 19de eeuw en heeft een ingezwenkte lijstgevel en een aanbouw. Het dubbele herenhuis Grotestraat 138-140 kwam in 1889 tot stand in eclectische stijl naar ontwerp van A.G. Beltman en in opdracht van L.S. Spanjaard en B. Wijk. Stationsstraat 52-54 is een dubbel woonhuis in neorenaissance-stijl, gebouwd in 1893 ten behoeve van het hogere personeel van de firma Spanjaard. Het laat-19de-eeuwse herenhuis Deldensestraat 7 is gebouwd op een Lvormige plattegrond; in 1914 is het verbouwd door A.G. Beltman. Het vrijstaande eenlaags huis Grotestraat 246-248 heeft een verhoogde middenpartij met erker en overkragend dak. Het werd in 1908 gebouwd voor P. van Vledder sr. naar ontwerp van J. Vixseboxe en in 1913 uitgebreid naar plannen van architect Stuhldreher. De arts W. Stomps liet in 1936 het pand Prins Bernardlaan 23 bouwen, een dokterswoning met aangebouwde praktijkruimte op kruisvormige plattegrond en met een bijzondere horizontale opbouw. Het ontwerp is van K. van de Berg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Fabrikantenvilla's"@nl ;
        min:adres "Grotestraat 120-122",
            "Grotestraat 167",
            "Grotestraat 260",
            "Grotestraat 262",
            "Stationsstraat 74" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Fabrikantenvilla's" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12163>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30042>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30861> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507926",
            "9922",
            "9934" ;
        min:soort "lemma" ;
        min:volgnummer 277 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Fabrikantenvilla's"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Fabrikantenvilla's. In Borne staan diverse grote herenhuizen en villa's van fabrikanten, met name van de familie Spanjaard. Het Spanjaardhuis (Grotestraat 120-122), een monumentaal blokvormig herenhuis met schilddak, verrees in 1865 in eclectische stijl voor L.S.S. Spanjaard. Door verbouw van een dubbel herenhuis uit 1868 kwam in 1914 de gepleisterde villa 't Witte Huis (Grotestraat 262) in ‘Um 1800’-stijl tot stand voor J. Spanjaard naar ontwerp van A. Beltman. Het pand is nu als vormingscentrum in gebruik. Het naastgelegen koetshuis (Grotestraat 260) in chaletstijl werd in 1899 gebouwd voor S.J. Spanjaard, eveneens naar plannen van A. Beltman. Villa Meyling (Stationsstraat 74) is een rijk gedecoreerde vrijstaande villa in chaletstijl, gebouwd in 1894 voor bierbrouwer H. Meyling naar plannen van J. van der Goot en C.J. Kruisweg. Het trappenhuis dateert uit de bouwtijd en de vertrekken op de parterre bezitten rijke neorenaissance-plafonds van de Almelose decoratieschilder Breider uit 1915. Naast het pand staat een eenlaags voorm. koetshuis in dezelfde stijl. Villa Elisabeth (Grotestraat 167) verrees in 1895 voor A. Spanjaard, naar ontwerp van G. Beltman in chaletstijl met neorenaissance-elementen. De villa heeft twee zijrisalieten, waarvan de rechter tot een toren is uitgebouwd. Oude Deldensestraat 21 is een eenlaags koetshuis met dienstwoning op samengestelde plattegrond, in 1903 gebouwd naar ontwerp van G. Beltman voor S.J. Spanjaard Lzn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00278> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Arbeiderswoningen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Arbeiderswoningen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 278 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Arbeiderswoningen"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "69" ;
        schema:pagination "69-70" ;
        schema:text "Arbeiderswoningen. De firma Spanjaard liet in 1876 de arbeiderswoningen Deldenseweg 154-184 bouwen, voorzien van diepe tuinen. De woningen zijn later ingrijpend verbouwd. Verder kwamen in opdracht van Spanjaard aan de westzijde van de spoorlijn in de jaren twintig en dertig van de 20ste eeuw complexen arbeiderswoningen tot stand, veelal ontworpen door de bedrijfsarchitect. Het complex Spanjaardplein, Spinnerstraat, Nijverheidstraat e.o. bestaat uit vrijstaande, afwisselend eenlaags diepe en brede dubbele woningen, deels rond een plantsoen. Een aantal woningen is recentelijk gerenoveerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00279> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Boerderijen"@nl ;
        min:adres "Meyershof 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 279 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Boerderijen. In het dorp en aan de rand staat een aantal interessante boerderijen. De voorm. driebeukige dorpsboerderij Koppelsbrink 32-34 is omstreeks 1800 met uitzondering van de deel in de lengte doormidden gedeeld. De boerderij heeft een uitgebouwd klopjeshuis en een weefkamer, waarvan het linker de datering ‘1785’ draagt. Loodijk 2 is een deels 18de-, deels 19de-eeuwse langhuisboerderij met bovenkamer. De dwarshuisboerderij Meyershof (Meyershof 4) heeft een breed neoclassicistisch voorhuis uit 1877 met plint, gepleisterde hoekpilasters en kroonlijst. Op het erf staat een eenvoudig huisje, deels nog met vakwerk. De Meyershof ligt ter plaatse van het ‘Hof te Borne’, een van de zeven middeleeuwse landsheerlijke hoven in Twente. Dwarshuisboerderij Zenderensestraat 2 heeft een tweelaags, herenhuisachtig voorhuis en een tweedaks achterhuis. Aan de zijde van het dorp bevindt zich een galerij. Het achterhuis is laat-19de-eeuws en het voorhuis werd in 1923-'24 gebouwd voor A. Wooldrik naar ontwerp van W. Nierkens. Tot het monumentale complex behoren verder een dubbele tweedakschuur en een varkensstal uit het begin van de 20ste eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00280> a min:Passage,
