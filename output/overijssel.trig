        min:kern "Vollenhove" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21646>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27170>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33576> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "10552",
            "10553",
            "10554" ;
        min:soort "inleiding" ;
        min:volgnummer 992 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill384> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0099> ;
        schema:name "Vollenhove (gemeente Brederwiede)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "264" ;
        schema:pagination "264-265" ;
        schema:text "Het voorm. stadhuis (Kerkplein 1) [6] is in 1621 in maniëristische stijl opgetrokken aan de noordzijde van de vrijstaande toren van de Grote kerk. Het is een dwars pand met een open zuilengalerij rustend op zes toskaanse zuilen en twee halfzuilen; boven de bogen loopt een band met mascarons. In het midden van de voorgevel is een balkon op consoles aangebracht en daarboven een jaartalsteen in cartouche. Het balkon is versierd met twee gespiegelde stadswapens. Oorspronkelijk zou de middentravee zijn bekroond met een dakerker met topgeveltje. De huidige kroonlijst zal bij een herstelling in 1791 zijn aangebracht. De vensters hebben hun oude zandstenen kruiskozijnen bewaard, met daarboven schelpvullingen in de boogtrommels. Tot 1806 bevond het cachot zich in de benedenste geleding van de genoemde toren. Het in opzet waarschijnlijk eveneens 17de-eeuwse, onderkelderde huis van de stadsbode, gebouwd tegen de korte noordzijde van het stadhuis, werd na afschaffing van dit ambt in 1848 verhuurd aan C.F. Seidel. Deze bouwde het pand in 1849 om tot een herberg, later hotel Seidel (Kerkplein 3) genoemd. Nadat in 1948 het stadhuis buiten gebruik raakte, werd het in 1951 geheel als hotel ingericht. Het interieur is ingrijpend gerestaureerd; voornamelijk een enkelvoudige balklaag met geprofileerde consoles en enkele deuren hebben een 17de-eeuws aanzien behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00993> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vollenhove (gemeente Brederwiede)"@nl ;
        min:adres "Kerkplein 15" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Brederwiede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vollenhove (gemeente Brederwiede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vollenhove" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52095> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "10557" ;
        min:soort "inleiding" ;
        min:volgnummer 993 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill385> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0099> ;
        schema:name "Vollenhove (gemeente Brederwiede)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "De voorm. Latijnse School (Kerkplein 15) [7] is een diep pand met een trapgevel in maniëristische vormen. Het werd in 1627 gebouwd als woonhuis voor de advocaat-fiscaal Johan Lemker. De rijke gevel is voorzien van zandstenen speklagen en boogtrommels met schelpvullingen boven de vensters op de begane grond. De band boven die vensters heeft aan weerszijden mascarons en in het midden een jaartalsteen in cartouche. In 1654 werd het aan de achterzijde uitgebreid. Na 1791 kwam het pand als Franse school in gebruik. Kort daarna zijn waarschijnlijk ook het wapen van Lemker en het huismerk op de beide andere zandstenen blokken vlakgekapt. In 1821 werd het een kostschool. Bij een restauratie in 1919 is de toen grotendeels verdwenen geveltop herbouwd. Verder zijn toen de kruiskozijnen en het stadswapen dragend hert in de top aangebracht. In de aanbouw met lessenaarsdak aan de rechterzijde bevindt zich een dubbele ingang. Voor de linker van de beide zandstenen ingangpoortjes, met kopjes als sluitsteen, staan twee rijk bewerkte maniëristische stoepstenen uit 1628."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0099.php> .

