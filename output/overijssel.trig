        min:volgnummer 915 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0090> ;
        schema:name "Schalkhaar (gemeente Diepenveen)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Het voorm. raadhuis van Diepenveen (Pastoorsdijk 1a) is een in 1900 op vierkante grondslag gebouwd pand in neorenaissance-stijl. De ingangsrisaliet aan de voorzijde eindigt in een dakerker. Het gebouw heeft tot 1924 als raadhuis dienst gedaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00916> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schalkhaar (gemeente Diepenveen)"@nl ;
        min:adres "Spanjaardsdijk 45" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schalkhaar (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Schalkhaar" ;
        min:provincie "Overijssel" ;
