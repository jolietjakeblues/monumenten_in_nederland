        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41760> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "510606" ;
        min:soort "lemma" ;
        min:volgnummer 522 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill203> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0042> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Overige kerken. Eben Haëzer (Schipholtstraat 62) is een eenvoudige zaalkerk uit 1903 van de Vrije Zendingsgemeente, ook wel klompenkerkje genoemd. De Geref. kerk (Schipholtstraat 41) is een brede zaalkerk met kleine houten geveltoren, gebouwd in 1907-'08 naar plannen van J.B. Radstake. Het klooster Dolphia (Gronausestraat 710) verrees in 1935-'37 voor de paters kapucijnen en was kerk van de St.-Bernadetteparochie. Het klooster, met een drielaags vleugel aan de straatzijde en lagere vleugels haaks daarop, werd door M. van Beek ontworpen in een aan het werk van Kropholler verwante traditionalistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0042.php> .

