        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bentelo (gemeente Ambt Delden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bentelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 224 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0012> ;
        schema:name "Bentelo (gemeente Ambt Delden)"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Buurtschap ontstaan in de middeleeuwen met verspreid liggende boerderijen. Na de Tweede Wereldoorlog kwam bij de katholieke kerk een dorpskern tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00225> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bentelo (gemeente Ambt Delden)"@nl ;
        min:adres "Onze Lieve Vrouwestraat 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
