        min:kern "Ootmarsum" ;
        min:lemma "Straatmeubilair" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46526> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "513203" ;
        min:soort "lemma" ;
        min:volgnummer 858 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0080> ;
        schema:name "Straatmeubilair"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Straatmeubilair. Op de Markt staat voor het stadhuis een uit omstreeks 1780 daterende, zandstenen stadspomp [9] metrococo-motief en stadswapen. Aan de Walstraat en op het Bergplein staan 18de-eeuwse ronde zandstenen stadsputten [10] met eikenhouten haalbomen. De oriëntatietafel (bij Almelosestraat 63) op de Kuiperberg is een hardstenen gebeeldhouwde tafel, geplaatst in 1922 door de A.N.W.B. en de Koninklijke Nederlandse Toeristenbond. Vanaf het plateau heeft men een bijzonder uitzicht over Noord-Twente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00859> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ootmarsum – Engels' tuin"@nl ;
