        schema:name "Saasveld (gemeente Weerselo)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Dorp, ontstaan in de 20ste eeuw bij de katholieke kerk. Die kerk is voortgekomen uit een schuilkerk, gevestigd in een deel van het inmiddels verdwenen kasteel Saasveld, waarvan de buitengracht en enkele lanen nog aanwezig zijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0089.php> .

