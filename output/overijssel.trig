        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 182 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0007-01> ;
        schema:name "Dienstwoningen"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "Dienstwoningen. Bij de Albergbrug over het kanaal Almelo-Nordhorn, ten zuiden van het dorp, staat de voorm. brugwachterswoning (Zenderenseweg 53), een eenlaags pand met middenrisaliet. Het werd gebouwd in 1888 in opdracht van de provincie Overijssel en heeft nu een horecafunctie. De bij de verdwenen Bennesluis gelegen sluiswachterswoning (Kanaal Zuidzijde 22) is een eenvoudig eenlaags pand uit 1933-'34."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00183> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Albergen (gemeente Tubbergen) – Boerderij"@nl ;
        min:adres "Zuidesweg 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
