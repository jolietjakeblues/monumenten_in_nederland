        min:volgnummer 904 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0088> ;
        schema:name "Rossum (gemeente Weerselo)"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "De R.K. St.-Plechelmuskerk (Thijplein 3) is een kruiskerk met versmald vijfzijdig gesloten koor en een ongelede toren met ingesnoerde spits, gebouwd in 1939-'41 naar ontwerp van C.A. Hardeman ter vervanging van een kerk uit 1832-'34. De pastorie (Thijplein 1) dateert uit 1940. Op het kerkhof staan een baarhuisje en een zandstenen calvarieberg uit 1911."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0088.php> .

