        schema:name "Oldenzaal"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "De voorm. marechausseekazerne (Molenstraat 27-29) [8], een neoclassicistisch gebouw met omgaand schilddak en aangebouwd koetshuis, verrees in 1894 naar plannen van W. Elzinga. Het in baksteen met speklagen uitgevoerde pand is later gepleisterd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0077.php> .

