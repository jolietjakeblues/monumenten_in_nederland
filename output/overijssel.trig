        schema:name "Windmolen"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Windmolen. De ‘molen van Oude Hengel’ (Oldenzaalsestraat 24) [7] is een ronde stenen stellingkorenmolen, gebouwd in 1867 en na een brand in 1872 herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00857> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ootmarsum – Industriegebouwen"@nl ;
        min:adres "Almelosestraat 65",
            "Oldenzaalsestraat 21",
            "Weerselosestraat 1-3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Ootmarsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ootmarsum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Ootmarsum" ;
        min:lemma "Industriegebouwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28754>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52361>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59443> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "31770",
            "513202",
            "513204" ;
        min:soort "lemma" ;
        min:volgnummer 857 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0080> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "238" ;
        schema:pagination "238-239" ;
        schema:text """Industriegebouwen. Van de voorm. fosforietfabriek (Oldenzaalsestraat 21) [8] is een uit omstreeks 1917 daterende, forse houten opslagloods met mansardedak bewaard gebleven. De fabriek werd opgericht voor de vrij kortstondige winning van de in kleilagen aangetroffen fosforietknollen, benodigd om de in de Eerste Wereldoorlog afgebroken import van fosfaat te compenseren. De voorm. zuivelfabriek ‘Nooitgedacht’ (Weerselosestraat 1-3) is een eenlaags fabriekspand met directeurswoning, gebouwd in 1927 naar ontwerp van G.A. en E. Mulder.

De watertoren (bij Almelosestraat 65) kwam in 1934 tot stand in opdracht van de Waterleiding Maatschappij Overijssel. Omdat het gebouw op de Kuiperberg staat, kon men volstaan met een geringe hoogte. De toren heeft een rond, met baksteen bekleed, betonnen vlakbodemreservoir en een vierkante traptoren."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00858> a min:Passage,
