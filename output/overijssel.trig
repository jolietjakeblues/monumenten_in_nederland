        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "De voorm. Herv. kerk (Kanaalweg Oost 58) is een zaalkerk met siermetselwerk en een ingangspartij in een boven het dak doorstekende risaliet. De kerk, gebouwd in 1913, dient nu voor avondmaalsvieringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0013.php> .

