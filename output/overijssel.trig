            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37511> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34403",
            "34405",
            "47070" ;
        min:soort "inleiding" ;
        min:volgnummer 928 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0093> ;
        schema:name "Staphorst en Rouveen"@nl ;
        schema:pageEnd "249" ;
        schema:pageStart "249" ;
        schema:pagination "249" ;
        schema:text "De Herv. kerk (Oude Rijksweg 443, Rouveen) is een rechthoekige zaalkerk met een rijzige toren, gebouwd in 1641 ter vervanging van een meer westelijk gelegen kerk uit omstreeks 1400. De toren heeft twee geledingen en een aangekapt tentdak. De steunberen en spitsboogvensters van de kerk duiden op de late toepassing van gotische vormen. In 1893 werd de kap verlaagd. De kerk is in 1931 inwendig gemoderniseerd en in 1974-'75 gerestaureerd naar plannen van H.J. Meijerink. Tot de inventaris behoort een 17de-eeuwse geelkoperen lezenaar aan de moderne kansel. Rondom de kerk ligt het in 1829 door de gemeente overgenomen kerkhof. De predikantswoning (Oude Rijksweg 435), een fors pand met ingezwenkte lijstgevel, is nieuw gebouwd kort na de watersnood van 1825."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00929> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Staphorst en Rouveen"@nl ;
        min:adres "Gemeenteweg 52",
            "Gemeenteweg 53" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Staphorst" ;
        min:gemeenteInBoek "Staphorst en Rouveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Staphorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Staphorst en Rouveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Staphorst en Rouveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26135>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45382> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34246",
            "508246" ;
        min:soort "inleiding" ;
        min:volgnummer 929 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill357> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0093> ;
        schema:name "Staphorst en Rouveen"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "249" ;
        schema:pagination "249-250" ;
        schema:text "De Herv. kerk (Gemeenteweg 52, Staphorst) werd in 1752 gebouwd door timmerman Pieter Brouwer; ze verving een westelijker gelegen kerk uit 1436. De toren van twee geledingen kwam in 1763 tot stand. Op de toren na heeft men de kerk in 1952-'54 geheel gesloopt en vervangen door een kruiskerk. Bij een ingrijpende verbouwing in 1991-'92 verrees aan de westzijde een heel grote, geschakelde zaalkerk. Gelijktijdig kreeg de toren een derde geleding in traditionele vormen en een ingesnoerde spits. In de kerk hangt een in 1908 hersteld rouwbord uit 1678. Naast de kerk staat een klok uit 1541, gegoten door Geert van Wou en Gherardus van Schonenborch. Achter de kerk strekt zich de Alg. begraafplaats uit. De pastorie (Gemeenteweg 53) is een fors pand uit 1909, voorzien van jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0093.php> .

