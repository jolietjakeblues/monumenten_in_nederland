        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 369 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Den Ham"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Het raadhuis annex onderwijzerswoning (Brink 19) is een neoclassicistisch pand met een ingangsrisaliet die overgaat in een dakerker. Het is gebouwd in 1865 naar plannen van G.H. Lemmers, nadat de oude onderwijzerswoning het jaar daarvoor was afgebrand. In 1920 werd het verbouwd naar plannen van H. Kremer en Joh. Stegeman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00370> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham"@nl ;
        min:adres "Grotestraat 26" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Den Ham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 370 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Den Ham"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De voorm. gemeenteschool A.B. (Grotestraat 26) is een in rijke neorenaissance-stijl gebouwde gangschool annex onderwijzerswoning met lagere ingangspartij geflankeerd door in- en uitgezwenkte gevels. De school werd in 1881 gebouwd naar ontwerp van J. Wesstra jr. uit Den Haag en in 1988 verbouwd tot winkel en bejaardenwoningen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00371> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham"@nl ;
        min:adres "Brink 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Den Ham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 371 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Den Ham"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Het woonhuis annex postkantoor (Brink 2) is een woonhuis met een in een dakerker overgaand ingangsrisaliet en aan de rechterzijde een aanbouw voor het postkantoor. Het werd in 1920 gebouwd in late jugendstil-vormen naar ontwerp van Weideman voor A. Lindenhovius en is nu als drukkerij in gebruik."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00372> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham – Woonhuizen"@nl ;
        min:adres "Grotestraat 4",
            "Grotestraat 52" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Den Ham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45809> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "20000" ;
        min:soort "lemma" ;
        min:volgnummer 372 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill118> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Woonhuizen. Het Middendorpshuis (Grotestraat 4) kwam als een van de eerste na de dorpsbrand in 1842 tot stand, in opdracht van herbergier annex blauwverver A. Middendorp. Het pand, met deuromlijsting met gecanneleerde Ionische pilasters in late empire-stijl, werd in 1975 gerestaureerd. Het dorp kent nog een belangrijk aantal typische 19de-eeuwse dorpswoningen, in de vorm van een dwars woonhuis met in het midden een licht risalerende ingangspartij overgaand in een dubbelbrede, platgedekte bakstenen dakerker. Het uit 1856 stammende neoclassicistische woonhuis Grotestraat 47, gebouwd voor notaris Jonkers en later doktershuis voor M.C. Metelerkap Cappenberg is hier een voorbeeld van. Andere voorbeelden zijn het dubbele woonhuis Dorpsstraat 4-6 uit omstreeks 1875 naar plannen van J.H. Elzink uit Almelo, Brinkstraat 10 uit 1895 naar plannen van J. Schuurman voor J. Beltman en het notariskantoor villa Vertrouwen (Grotestraat 52) uit 1900 naar plannen van Van Dorth voor J. Buddingh. In chaletstijl uitgevoerd is de dokterswoning met praktijk Dorpsstraat 2, uit 1912 naar plannen van B. Vixseboxse uit Almelo voor Dr. Van Brakel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00373> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham – Boerderijen"@nl ;
        min:adres "Dorpsstraat 58" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Den Ham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 373 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text """Boerderijen. In de omgeving van Den Ham liggen enkele noemenswaardige boerderijen, waaronder de forse boerderij met schilddak Janmansweg 17 met de jaartalankers ‘1887’, maar waarvan de gebinten mogelijk teruggaan tot het midden van de 17de eeuw, en de in 1938 gebouwde ontginningsboerderij Hallerhoek 7.

De coöperatieve zuivelfabriek De Eensgezindheid (Dorpsstraat 58) is een fors bedrijfsgebouw met schoorsteen ontstaan in 1914. De huidige voorgevel, uitgevoerd in baksteen, maar in sobere functionalistische vormen, kwam in 1933 tot stand naar plannen van J.A.C. Tillema."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00374> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham – Begraafplaatsen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Den Ham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Den Ham" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 374 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0029> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Begraafplaatsen. De Alg. Begraafplaats (Molenstraat ong.) werd in 1840 gesticht en telt nog enkele houten ‘grafstenen’. De nabij gelegen Isr. begraafplaats (Vroomshoopseweg ong.) werd eveneens in 1840 gesticht, langs de uitvalsweg naar het oosten en ontleent haar charme aan haar besloten ligging."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00375> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Denekamp"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Denekamp" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Denekamp" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 375 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0030> ;
        schema:name "Denekamp"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Dorp, ontstaan te midden van een hoevenzwerm bij de omstreeks 1275 gestichte kerk nabij de Scholtenhof van de abdij Metelen (D.). De boerderijen en woonhuizen waren gegroepeerd rond de Brink. Sinds de 15de eeuw hebben de heren van de nabijgelegen kastelen Singraven en Borgbeuningen veel invloed gehad. De aanleg van de verharde weg Deventer - Hamburg in 1827 maakte een einde aan de geïsoleerde ligging. De bevolking vond na 1900 ook werk in de textielfabrieken van Nordhorn (D.). Denekamp was een halteplaats aan de in 1903 door de Nederlandsch-Westfaalsche Stoomtrammaatschappij aangelegde tramlijn Oldenzaal - Nordhorn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00376> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Denekamp"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Denekamp" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Denekamp" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 376 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0030> ;
        schema:name "Denekamp"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Ondanks de ontsluiting heeft Denekamp zijn agrarisch-ambachtelijke karakter tot aan de Tweede Wereldoorlog behouden. Vanwege het toenemend verkeer is het kronkelig deel van de straatweg door het dorp na de oorlog recht getrokken. In recente tijd is het dorp naar het oosten en noorden uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00377> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Denekamp"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Denekamp" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Denekamp" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 377 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill119> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0030> ;
        schema:name "Denekamp"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "91" ;
        schema:pagination "91-92" ;
        schema:text "Van de R.K. St.-Nicolaaskerk (Kerkplein 1) stamt het oostelijk gedeelte van het in zandsteen opgetrokken schip, met romano-gotische detailering en een gedichte zuidingang, uit het midden van de 13de eeuw. De westelijke travee van het schip dateert uit de eerste helft van de 15de eeuw. Het gehele schip kreeg toen kruisribgewelven rustend op oudere schalkkapitelen. Bovendien zal omstreeks die tijd de zandstenen toren van drie geledingen met ingesnoerde achtkantige spits en uitgebouwde traptoren zijn toegevoegd. Het torenportaal wordt overkluisd door een kruisribgewelf. De quasiromaanse toreningang werd aangebracht in 1911-'12. In en buiten de toren bevinden zich drie klokken. De oudste werd in 1436 gegoten door een meester Willem. De brandklok dateert uit 1518 en de Salvatorklok uit 1530 werd gegoten door Wolter Westerhues. In het begin van de 19de eeuw werd het oude driezijdig gesloten koor vervangen door een zandstenen transept en een recht gesloten koor, die op hun beurt in 1911-'12 werden vervangen door een groter transept met ronde vieringkoepel en een vijfzijdig gesloten koor met twee smallere, driezijdig gesloten zijkoren. Voor die centraliserende uitbreiding maakte W. te Riele het ontwerp in een combinatie van neogotische en neoromaanse vormen. Het interieur heeft muur- en koepelschilderingen uit omstreeks 1915, die onder leiding van P.J.H. Cuypers zijn aangebracht. Tot de inventaris behoren een laat-middeleeuws zandstenen doopvont, twee 18de-eeuwse kaarsenkronen, vroeg-18de-eeuwse beelden (Drievuldigheidsaltaar) en een midden-19de-eeuwse beeldengroep met een centrale voorstelling van St. Nicolaas te paard. Uit het atelier Cuypers komen het oude hoogaltaar met een tabernakel van de firma Brom (1912), het Maria-altaar (1915) en enkele zandstenen beelden. De gebrandschilderde ramen zijn van F. Nicolas & Zn. (1912), J. Nicolas (1953) en J. Schoenaker (1977)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00378> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Denekamp"@nl ;
