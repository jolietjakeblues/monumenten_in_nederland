        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47662> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "513513" ;
        min:soort "lemma" ;
        min:volgnummer 238 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0014> ;
        schema:name "De Borg"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "De Borg (Borgbosweg 6) is een nabij Borgbeuningen gelegen villa, gebouwd in 1903 als zomerverblijf voor J. van Wulfften Palthe. Architect K. Muller maakte het ontwerp in Engelse cottagestijl, met gepleisterde wanden, vakwerkgeveltoppen en rieten kap. Het huis is in 1912 naar ontwerp van dezelfde architect uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00239> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beuningen (gemeente Losser) – Austi"@nl ;
