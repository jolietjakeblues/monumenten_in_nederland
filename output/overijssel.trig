        min:kern "Hengelo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33885> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "511473" ;
        min:soort "inleiding" ;
        min:volgnummer 615 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0051> ;
        schema:name "Hengelo"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "De R.K. kerk O.L. Vrouwe van Altijddurende Bijstand (Onze Lieve Vrouwestraat 8) is een expressief vormgegeven driebeukige basiliek. Ze heeft aan de oostzijde boven het absidiaal gesloten koor een massieve, gedrongen toren van drie geledingen en een zadeldak met steekkap waarop een dakruiter staat. Per zijde verlichten drie dakerkers de hoofdbeuk. De kerk verrees in 1926-'27 naar plannen van W. te Riele. De pastorie (Onze Lieve Vrouwestraat 6) stamt eveneens uit 1926-'27."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00616> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengelo – Overige kerken"@nl ;
        min:adres "Breemarsweg 442",
            "Burg. Jansenplein 1",
            "Deldenerstraat 59",
            "Dennenbosweg 94",
            "Leusveenweg 1",
            "Oelerweg 95" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hengelo" ;
        min:gemeenteInBoek "Hengelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hengelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hengelo" ;
        min:lemma "Overige kerken" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 616 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill241>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill242> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0051> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "174" ;
        schema:pagination "174-175" ;
        schema:text """Overige kerken. De voorm. kerk van de Hersteld Apostolische gemeenschap (Leusveenweg 1) is een zaalkerk met ingangsportiek in expressionistische vormen uit 1914. Ze is nu in gebruik als woonhuis en fotowinkel. De kerk van de Apostolische gemeenschap (Dennenbosweg 94) is een zaalkerk met slanke, terzijde staande toren, gebouwd in 1933 met elementen uit de Nieuwe Zakelijkheid. De (Herv.) Bethlehemkerk (Oelerweg 95) is een zaalkerk met lagere voorbouw, beide onder forse zadeldaken, en terzijde staande slanke toren met zadeldak. De kerk werd in 1934-'35 gebouwd naar plannen van A.K. Beudt en P. van Broekhuizen. Een van de belangrijkste naoorlogse kerken in Overijssel is de R.K. kerk St.-Pius X (Breemarsweg 442), een zaalkerk met lagere kooraanbouw en een terzijde staande, opengewerkte toren. De kerk werd in 1957-'58 gebouwd naar plannen van B.J. en H.M. Koldewey. De pastorie (Breemarsweg 442) stamt uit dezelfde tijd.

Het stadhuis (Burg. Jansenplein 1) is een groot, om een overdekte hal gebouwd, complex. Aan de westzijde heeft het een slanke toren met opengewerkte lantaarn en uitgebouwde balustrade. Naar plannen uit 1953 werd het in 1958-'63 gebouwd in de traditionalistische vormen van de Delftse School naar ontwerp van J.F. Berghoef met medewerking van J.F. Hondius. Groepering rondom een centrale hal moest de eenheid en samenhang van het representatieve en het werkgedeelte zichtbaar maken. Rondom de hal zijn de secretarie, administratie en representatieve vertrekken gegroepeerd; dit idee is geïnspireerd op het stadhuis van Stockholm (1911-'23) van R. Östberg. Monumentale elementen als trappen, bordessen, balkon en zuilen symboliseerden de traditionele gezagsstructuren. Een belangrijke rol speelt daarbij de sterk op die van het Palazzo Vecchio te Florence (1299-1314) gelijkende toren. Beneden in de toren bevinden zich muurschilderingen van P. Verbene en het carillon werd in 1961 gegoten door Petit & Fritsen. De baksteenfriezen in het exterieur zijn een ontwerp van R. Holtrop. In de hoofdgalerij langs de hal hangt een keramisch fries van F. Jacobs, uitgevoerd door de Porceleyne Fles te Delft. De mozaïeken in de raadzaal zijn van de hand van J. en C. Goeting. Het voorm. bureau gemeentewerken (Deldenerstraat 59) werd omstreeks 1925 met expressionistische details gebouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0051.php> .

