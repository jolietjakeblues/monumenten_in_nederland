        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De School met den Bijbel (Gemeenteweg 317) is een sober vormgegeven school uit omstreeks 1920, voorzien van expressionistische details en het opschrift ‘IIe School met den Bybel’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0093.php> .

