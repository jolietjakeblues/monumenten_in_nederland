        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijverdal (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nijverdal" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 785 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0073> ;
        schema:name "Nijverdal (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Vrije Evangelische Gemeente (Grotestraat 68) is een forse driebeukige kruiskerk met aanbouwen in de hoeken en aan de voorzijde en in een geveltoren overgaande middenrisaliet, gebouwd in 1923 in expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00786> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijverdal (gemeente Hellendoorn)"@nl ;
        min:adres "Grotestraat 148",
            "Grotestraat 150",
            "Salomonsonstraat 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijverdal (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nijverdal" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 786 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0073> ;
        schema:name "Nijverdal (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De R.K. kerk St.-Anthonius van Padua (Grotestraat 148) is een driebeukige laat-neogotische kruisbasiliek met doopkapel. De slanke toren van drie geledingen heeft een met korte bakstenen lantaarn, flankerende hoektorentjes en een achtzijdige spits. Al in 1903 was een eigen parochie ontstaan met een noodkerk, maar pas in 1921 kon de nieuwe kerk ingewijd worden. In 1986 is de kerk gerestaureerd. De pastorie (Grotestraat 150) dateert eveneens van 1921. Het verenigingsgebouw Eendracht Maakt Macht (Salomonsonstraat 1) is een fors diep pand op bakstenen plint en heeft een puntgevel met trapvormig klimmend fries. Het werd in 1907 gesticht door de Christelijke textielarbeidersvereniging Unitas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00787> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijverdal (gemeente Hellendoorn) – De Eversberg"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijverdal (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nijverdal" ;
        min:lemma "De Eversberg" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 787 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0073> ;
        schema:name "De Eversberg"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Eversberg (Eversbergweg ong.) is een restant van de in 1612 door Adam van Heerdt gebouwde havezate die later door Thomas Ainsworth werd bewoond. Rond 1860 werd het verbouwd, maar in 1887 volgde afbraak. Op de fundamenten ontstond een boerderij waarbij een gedeelte van de benedenverdieping werd gespaard. In 1943 ging het geheel door brand verloren en werd nooit herbouwd. Delen van de oorspronkelijk 18de-eeuwse lanenstructuur zijn bewaard gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00788> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijverdal (gemeente Hellendoorn) – Woonhuizen"@nl ;
        min:adres "Campbellweg 30-34",
            "Hoge Dijkje 2-4",
            "Hoge Dijkje 4a",
            "P.C. Stamstraat 19-19A" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijverdal (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nijverdal" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70580> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "512239" ;
        min:soort "lemma" ;
        min:volgnummer 788 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill308> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0073> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "220" ;
        schema:pagination "220-221" ;
        schema:text """Woonhuizen. Van de oorspronkelijke woonbebouwing in het dorp is weinig bewaard gebleven. Het pand in simpele chaletstijl met sierspant Spijkerweg 19 stamt uit omstreeks 1910. In dezelfde tijd werd ook de rij dubbele arbeiderswoningen Weverstraat 110 gebouwd. Het overwegend rationalistische dubbele woonhuis met jugendstil-details Grotestraat 48-50 ontstond omstreeks 1915.

De Koninklijke Stoomweverij te Nijverdal (K.S.W.) (Hoge Dijkje 2-4) is een katoenweverij ontstaan toen in 1852 de gebroeders G. en H. Salomonson de in 1836 gestichte fabriek van Thomas Ainsworth overnamen. Zij vervingen deze door een nieuwe fabriek naar plannen van meestertimmerman B. Witzand uit Almelo met daarin vijftig machinale weefgetouwen. In 1853 verkregen ze het predikaat Koninklijk en in 1857 volgde een uitbreiding. Onder leiding van de vaste bouwkundige T.A. Trijssenaar volgden tussen 1883 en 1898 een aantal uitbreidingen. Naar ontwerp van H.A. Witzand ontstond in 1899 een nieuw kantoorgebouw, dat in 1911 van een nieuwe gevel in jugendstil-vormen werd voorzien naar plannen van M.H. Krabshuis. Deze was ook verantwoordelijk voor de bijzonder vormgegeven machinekamer annex de elektriciteitscentrale (Hoge Dijkje 4a); een hoog gebouw in jugendstil-vormen, met decoraties in heldere baksteen en een in tegels uitgevoerde wijzerplaat en opschrift. Gelijktijdig ontstonden de shedconstructies aan de Salomonsonstraat. In 1926 werd een eigen spinnerij gebouwd. Kort na de oorlog is het pakhuis aan het Hoge Dijkje, vermoedelijk uit 1899, verbouwd tot kantoor. Sinds 1957 maakt de fabriek deel uit van de Koninklijke Nijverdal-Ten Cate NV en momenteel huisvest het de sectie Ten Cate Nicolon. Voor het machinehuis staat een herdenkingszuil voor G. Salomonson Hzn. (1838-1911) ter gelegenheid van zijn vijftigjarig jubileum in 1909. Op de hoek met de Grotestraat staat een monument voor Thomas Ainsworth voorzien van bronzen reliëfs. Aan de zijgevel langs de Grotestraat zit een bronzen buste van koning Willem I uit 1893, geplaatst ter gelegenheid van het 40-jarig jubileum van het predikaat koninklijk, met daaronder een gedenkplaat uit 1836 ter ere van het honderdjarig bestaan van Nijverdal.

De Nederlandse Stoomblekerij (N.S.B.) (P.C. Stamstraat 19-19A) werd in 1861 gesticht op toenmalig Rijssens grondgebied door G.W. van Heel en de Gebr. Salomonson. Als gevolg van de textielcrisis in de jaren zestig (door de Amerikaanse Burgeroorlog) en het daaruit voortvloeiende tekort aan katoen, traden de Gebr. Salomonson uit en ontstond in 1868 de firma Van Heel & Co. Deze werd in 1871 omgezet in de N.V. Nederlandse Stoomblekerij. In 1887 werd P.C. Stam directeur, waarna in 1888 een uitbreiding van de fabriek volgde en de bouw van ketelhuis en machinekamer. In 1898 vond opnieuw een vergroting plaats, nu naar plannen van C. Eckhardt uit Almelo. Het huidige hoofdgebouw in neorenaissance-vormen met tegeltableau ‘NSB’ stamt van deze verbouwing. De shedconstructies van de blekerij werden in 1905 uitgebreid. In 1903 ontstond op het terrein de stijfselfabriek Atlas, maar deze werd in 1908 door brand verwoest en niet meer in Nijverdal herbouwd. Rond 1915 verrees in de nabijheid van de fabriek een watertoren (P.C. Stamstraat ong.), bestaande uit een open betonconstructie waarop een vlakbodemreservoir. Sinds 1957 maakt de fabriek deel uit van de Koninklijke Nijverdal-Ten Cate NV en momenteel huisvest het de sectie Ten Cate Technical Fabrics.

De Koninklijke Stoomblekerij (K.S.B.) (Campbellweg 30-34) werd in 1889 gesticht door de Gebr. Salomonson ten noorden van de weg Zwolle-Almelo. Daartoe werden de uit 1836 en 1850 stammende pakhuizen van de N.H.M. aangekocht, die in 1882 leeg waren komen te staan. In 1894 volgde een vergroting naar plannen van T.A. Trijssenaar, gevolgd door uitbreidingen in 1897 en 1898-'99 naar ontwerp van H.A. Witzand. In 1901 brandde de fabriek geheel af, waarna hetzelfde jaar een nieuwe fabriek ontstond tussen de Campbellweg en de Regge, eveneens naar plannen van H.A. Witzand. In 1918 werd de schoorsteen aldaar vernieuwd. M.H. Krabshuis tekende in 1910 voor een uitbreiding aan de westzijde van de Campbellweg. Hij is ook verantwoordelijk voor de watertoren die daar omstreeks 1920 ontstond. Deze bestond uit een betonnen vlakbodemreservoir met bakstenen omkleding in licht expressionistische vormen. Sinds 1957 maakt de fabriek deel uit van de Koninklijke Nijverdal-Ten Cate NV en momenteel huisvest het de sectie Ten Cate Protect. Bij de ingang van de fabriek staat een gedenksteen voor H. Salomonson Gzn. (1868-1918)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00789> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijverdal (gemeente Hellendoorn) – De Sprengenberg"@nl ;
        min:adres "Sprengenbergerweg 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijverdal (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nijverdal" ;
        min:lemma "De Sprengenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71862>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71864> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "21407",
            "512242" ;
        min:soort "lemma" ;
        min:volgnummer 789 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill309>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill310> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0073> ;
        schema:name "De Sprengenberg"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "221" ;
        schema:pagination "221-222" ;
        schema:text """De Sprengenberg (Sprengenbergerweg 1) is een ten zuidwesten van Hellendoorn op de westflank van de Haarlerberg gebouwd zomerhuis met uitkijktoren, gebouwd in drie etappes tussen 1898 en 1910 naar ontwerp van K. Muller voor A.A.W. van Wulfften Palthe, eigenaar van de textielwasserij Palthe. De hoge gecementeerde jachtannex uitkijktoren doet Zuidduits aan en wordt bekroond door een open houten uitkijkpost met tentdak en op de zuidwesthoek een arkeltorentje met ingesnoerd kegeldak. De jachtkamer op de begane grond sluit aan op nevenruimten en een vleugel op L-vormige plattegrond. De tuinaanleg is naar ontwerp van L.A. Springer en in 1910 door P.H. Wattez aangepast.

Inwendig bevindt zich de indrukwekkende hoge torenkamer, aan vier zijden voorzien van grote ronde bogen waarboven een galerij. Deze ruimte heeft een forse schouw en een gebrandschilderd raam. De vestibule is voorzien van een strakke marmeren schouw en een hoge lambrisering met eenvoudige ingekerfde decoratie. De achtzijdige uitbouw heeft een houten plafond gesteund door korbelen. Op de eerste verdieping bevinden zich de biljartkamer en de werkkamer, beide nog volledig ingericht en voorzien van gestucte plafonds en parketvloeren. Vermeldenswaard zijn verder onder meer de oorspronkelijke badkamer uit circa 1908 en het papierbehang uit circa 1910 in een van de logeerkamers."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00790> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noord Deurningen (gemeente Denekamp)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noord Deurningen (gemeente Denekamp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Noord Deurningen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 790 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0074> ;
        schema:name "Noord Deurningen (gemeente Denekamp)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Buurtschap, ontstaan als hoevenzwerm. Nadat in 1934 bij de kruising Johanninksweg-Nordhornsestraat een noodkerk was opgericht - in 1948 vervangen door de huidige St.-Nicolaaskerk - kwam hier een dorpskern tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00791> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noord Deurningen (gemeente Denekamp)"@nl ;
        min:adres "Gravenallee 30" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noord Deurningen (gemeente Denekamp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Noord Deurningen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 791 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0074> ;
        schema:name "Noord Deurningen (gemeente Denekamp)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Het St.-Nicolaasgesticht (Gravenallee 30), gelegen ten westen van Noord Deurningen, is een kloostercomplex, ontstaan uit de in de 17de eeuw gestichte havezate Noorddeurningen. Van het door Lubbert Hagen ontworpen edelmanshuis uit 1708 bleven twee zandstenen hekpijlers met siervazen met afgehakte wapens bewaard en een in de recent aangebouwde vleugel geplaatste steen met wapens Van Rechteren-Castell. J.M. Theunis Udink liet het bestaande huis in 1863-'64 vervangen door het huidige neoclassicistische herenhuis met mansardedak. Inwendig zijn uit deze periode onder meer gestucte plafonds met neorococo-ornamentiek en enkele schouwen aanwezig. Het huis biedt sinds 1875 onderdak aan de zusters franciscanessen van de St.-Georgiusstichting te Thuïne (D.), die met hun weeshuis naar Nederland uit waren geweken. Aan het voorplein verrezen een jongenshuis in neorenaissance-trant (1880) en een kloosterkerk (1896-'97). De door G. te Riele ontworpen kerk is een pseudobasilicale kruiskerk met lager transept, vierzijdig gesloten koor en rechthoekige sacristie. Op de hoek tussen kerk en herenhuis staat een ongelede toren met ingesnoerde vierzijdige spits. Het complex werd verder uitgebreid met een rectoraat (1916), een internaat (1922), een jongensschool (1925), een noviciaat (1934) en een kapel (1935). Het geheel is gelegen in een 18de-eeuwse lanenstructuur. Terzijde van het complex bevindt zich de kloosterbegraafplaats met gietijzeren kruizen en een bidkapelletje (omstreeks 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00792> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noord Deurningen (gemeente Denekamp) – Boerderijen"@nl ;
        min:adres "Nordhornsestraat 236" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeenteInBoek "Denekamp" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noord Deurningen (gemeente Denekamp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Noord Deurningen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 792 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0074> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text """Boerderijen. Waardevolle boerderijen in het buurtschap zijn Rammelbeekweg 16, een 18de-eeuws langhuisboerderijtje met vakwerkwanden, en Lubberdinksweg 15, een uit omstreeks 1800 daterende langhuisboerderij met bovenkamer en een bedrijfsgedeelte met onderschoer en vakwerkgevels. Het voorm. klopjeshuisje bij Johanninksweg 65 is een vrijstaand eenlaags vakwerkhuisje uit 1836. Tot 1954 stond het op het erve Grashof.

Het voorm. douanekantoor (Nordhornsestraat 236) bij de grensovergang Rammelbeek is een eenlaags blokvormig pand met schilddak uit omstreeks 1870. Nabij het kantoor staat een zware hardstenen grenspaal uit omstreeks 1900. Langs de Nederlands-Duitse grens staan nog verschillende grensstenen uit 1778 (nummers 34-36) met de opschriften OVERIJSEL en BENTHEIM, en verder enkele palen met de letters H(annover) en N(ederland) uit 1824."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00793> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Okkenbroek (gemeente Diepenveen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Okkenbroek (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Okkenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 793 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill311> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0075> ;
        schema:name "Okkenbroek (gemeente Diepenveen)"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "222" ;
        schema:pagination "222-223" ;
        schema:text "Kerkdorp ontstaan na de ontbinding van de Gooier marke in 1847. Het heeft zijn ontwikkeling te danken aan de grootgrondbezitter A. IJssel de Schepper. Deze luitenant van de Deventer Huzaren bezat hier, maar ook in Averlo en Lettele, veel grond en liet in 1852 een, nu verdwenen, molen bouwen. Daarnaast schonk hij in 1863 geld en grond voor de bouw van een protestantse kerk. De kerk zelf kwam pas in 1904 tot stand. In 1923 volgde de bouw van een Protestants Christelijke School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00794> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Okkenbroek (gemeente Diepenveen)"@nl ;
        min:adres "Oerdijk 228" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Okkenbroek (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Okkenbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16912> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508974" ;
        min:soort "inleiding" ;
        min:volgnummer 794 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill312> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0075> ;
        schema:name "Okkenbroek (gemeente Diepenveen)"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "223" ;
        schema:pagination "223" ;
        schema:text "De Herv. kerk (Oerdijk 228) is een forse zaalkerk met aan beide lange zijden een door een topgevel afgesloten dwarskap, waardoor inwendig de indruk van een kruiskerk is ontstaan. De voorgevel van de in 1904 in neorenaissancestijl gebouwde kerk, naar plannen uit 1885 van H. van Harte, heeft een smalle, sterk geprononceerde ingangsrisaliet, die ter hoogte van de kap overgaat in een forse achtzijdige bakstenen geveltoren; deze heeft een koepelvormige bekroning met een kleine houten lantaarn en spits. De kerk bezit een orgel met 18de-eeuwse onderdelen dat in 1815 door J. Proper werd verbouwd en omstreeks 1934 in Okkenbroek is geplaatst. Ook de preekstoel met aangebouwde kerkbanken zijn in 1934 geplaatst. De in empire-vormen uitgevoerde preekstoel zelf, met op een van de zijden in reliëf het hoofd van Christus, werd in 1810 gemaakt door H.H. Freitag uit Bentheim en is afkomstig uit de St.-Plechelmusbasiliek te Oldenzaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Okkenbroek (gemeente Diepenveen)"@nl ;
        min:adres "Oerdijk 157",
            "Oerdijk 192" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Okkenbroek (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Okkenbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17558> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "7448" ;
        min:soort "inleiding" ;
        min:volgnummer 795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0075> ;
        schema:name "Okkenbroek (gemeente Diepenveen)"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "223" ;
        schema:pagination "223" ;
        schema:text "De voorm. zuivelfabriek (Oerdijk 157) is een omstreeks 1920 in kalkzandsteen opgetrokken bedrijfspand met laadbordes waarboven een luifel hangt. Boerderij. Even ten zuidwesten van Okkenbroek ligt de De Grote Brender (Oerdijk 192) een in oorsprong 18de-eeuwse hallenhuisboerderij met asymmetrisch, dwarsgeplaatst woonhuis onder een rieten dak. Aan de zijkant, achter het woongedeelte, staat een ronde aanbouw die oorspronkelijk als karnhuis diende."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0075.php> .

