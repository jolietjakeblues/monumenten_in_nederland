        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0100> ;
        schema:name "Vriezenveen"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "267" ;
        schema:pagination "267-268" ;
        schema:text "De voorm. synagoge (Almeloseweg 5) is een uit 1923 daterend diep pand met overstekend dak en siermetselwerk van zwart geteerde baksteen. Het pand is nu in gebruik als winkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01001> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vriezenveen"@nl ;
