        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "454879" ;
        min:soort "lemma" ;
        min:volgnummer 1006 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0100> ;
        schema:name "De Pollen"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "De Pollen. Dit dorp ten noordoosten van Vriezenveen is ontstaan in de 20ste-eeuw. De (Herv.) Pollenkerk (Oude Hoevenweg 40) is een uit 1932 daterende eenvoudige kerk op T-vormige plattegrond met een overkragende dakruiter op de frontgevel. Het interieur bevat een kabinetorgel van J.H.H. Bätz uit 1766, gemaakt voor J.J. Faber van Riemsdijk te Utrecht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

