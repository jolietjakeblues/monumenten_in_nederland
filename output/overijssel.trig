        min:gemeenteInBoek "Denekamp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lattrop (gemeente Denekamp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lattrop" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41846> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508960" ;
        min:soort "inleiding" ;
        min:volgnummer 716 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill291> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0061> ;
        schema:name "Lattrop (gemeente Denekamp)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "209" ;
        schema:pagination "209-210" ;
        schema:text "Dorp, ontstaan in de middeleeuwen als hoevenzwerm-nederzetting. Na de Tweede Wereldoorlog ontstond bij de rooms-katholieke kerk een dorpskern. De R.K. kerk H.H. Simon en Judas (Dorpsstraat 66) is een driebeukige kruiskerk met versmald, vijfzijdig gesloten koor en een westpartij met ongelede middentoren bekroond door een achtzijdige ingesnoerde spits. De kerk verrees in 1925-'26 naar een ontwerp in expressionistische trant van J.Th.J. Cuypers, ter vervanging van een kerk uit 1818. Het interieur wordt overdekt door stenen kruisgewelven. Tot de inventaris behoren verschillende laatgotische beelden, waaronder een Piëta en een Maria met Kind. De pastorie (Dorpsstraat 64) dateert uit 1925 en is eveneens door Cuypers ontworpen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0061.php> .

