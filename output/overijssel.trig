        min:soort "lemma" ;
        min:volgnummer 281 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Begraafplaatsen. De R.K. begraafplaats (Oude Almeloseweg ong.), aangelegd in 1827, heeft een neogotisch poortgebouw uit het eind van de 19de eeuw. De ommuurde Isr. begraafplaats (bij Twijnerstraat 21) werd in het midden van de 19de eeuw aangelegd. De ingang bestaat uit een reinigingshuis uit 1923, gebouwd in opdracht van de joodse textielfabrikant Spanjaard naar ontwerp van de bedrijfsarchitect G.J. Leussink. Op de begraafplaats bevinden zich de graven van de familie Spanjaard."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00282> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borne – Bornerbroek"@nl ;
        min:adres "Pastoor Ossestraat 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Borne" ;
        min:lemma "Bornerbroek" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 282 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0018> ;
        schema:name "Bornerbroek"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Bornerbroek. Kerkdorp ten westen van Borne. De R.K. St.-Stephanuskerk (Pastoor Ossestraat 2) heeft een toren met ingesnoerde spits, een fraai schip, bestaande uit een eenbeukig westelijk en een basilicaal oostelijk deel, en een smal, driezijdig gesloten koor. De uit 1857 daterende kerk kreeg bij een verbouwing in 1919-'20 de huidige laatneogotische vorm naar ontwerp van A.J. Kropholler."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00283> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boskamp (gemeente Olst)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Olst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boskamp (gemeente Olst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Boskamp" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 283 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0019> ;
        schema:name "Boskamp (gemeente Olst)"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Hoevenzwermdorp voor het eerst genoemd in 1455. Omstreeks 1500 ontstond hier de havezate Boskamp, die omstreeks 1610 werd vernieuwd. In 1758 werd daarvan het bouwhuis in gebruik genomen voor katholieke kerkdiensten. De katholieke statie kon in 1803 de havezate aankopen om haar tot kerk in te richten. In 1830 werd het daartoe verbouwd en in 1859 afgebroken voor de bouw van een nieuwe kerk. Nabij de kerk ontstond in het begin van de 20ste eeuw de handel in mengvoeders van B.J.V. ten Have. In 1960 werd de kleine kern naar het westen toe uitgebreid met de Bloemenwijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00284> a min:Passage,
