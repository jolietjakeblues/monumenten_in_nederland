        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0086> ;
        schema:name "Reutum (gemeente Tubbergen)"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "Dorp, ontstaan als flankesnederzetting aan de Reutumse Es. Bij de in 1811 gestichte katholieke kerk op de grens tussen Reutum en Haarle ontwikkelde zich na de oorlog een dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00891> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reutum (gemeente Tubbergen)"@nl ;
