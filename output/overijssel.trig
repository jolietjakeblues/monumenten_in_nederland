        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Hoonhorst"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Hoonhorst. Dit dorp ten zuidwesten van Dalfsen ontstond na 1770 als kerkelijk middelpunt voor katholieken. Deze kregen echter vrij snel een eigen kerk in Dalfsen. De in 1960 onttakelde windmolen ‘Fakkert’ (Kerkstraat 3A), een hoge achtkante molenromp met bakstenen onderbouw en met leien gedekte bovenbouw, werd gebouwd in 1863 als stellingkorenmolen. Aan het begin van de 20ste eeuw ontstond rondom de molen een meelfabriek. De molenaarswoning (Kerkstraat 5) stamt ook uit omstreeks 1863. In het buurtschap Moezenbelt ten zuiden van Hoonhorst staat een voorm. Openbare Lagere School (Heinoseweg naast 32), gebouwd omstreeks 1850 als eenklassige school met ernaast een onderwijzerswoning. De school is verbouwd omstreeks 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00323> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Krim (gemeente Gramsbergen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Gramsbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Krim (gemeente Gramsbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "De Krim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 323 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0024> ;
        schema:name "De Krim (gemeente Gramsbergen)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Hoogveenkolonie ontstaan langs de Lutterhoofdwijk, een zijkanaal van de Dedemsvaart, dat in 1832 werd gegraven. In 1855 werd deze hoofdwijk verbreed en naar Coevorden doorgetrokken. De kolonie heeft haar naam te danken aan de onrust onder de veenarbeiders in 1857, die door de marechaussee hardhandig werd onderdrukt en wel werd vergeleken met excessen in de Krim-oorlog van 1853-'56. In 1869 werd het een afzonderlijke buurtschap waar zich omstreeks 1890 nog veel plaggenhutten van veenarbeiders bevonden. Vanaf 1890 werden de uitgeveende dalgronden geschikt gemaakt voor aardappelteelt en verschenen langs de hoofdwijk grote boerderijen en in 1906 een aardappelmeelfabriek. Op de kruising met de weg naar Gramsbergen verscheen in 1939 een kleine, naar het zuidoosten gerichte, kazemat. Door de naoorlogse woonwijk ten zuiden van de hoofdwijk heeft de kolonie een meer rechthoekige structuur gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0024.php> .

