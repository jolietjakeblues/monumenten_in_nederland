        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delden (stad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Delden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 347 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0027> ;
        schema:name "Delden (stad)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "De (Geref.) Paaskerk (Noorderhagen 54) [3] is een eenvoudige, kleine zaalkerk met open dakstoel en getoogde vensters voorzien van gietijzeren tracering. In de voorgevel zit een rond siervenster met penanten. De kerk werd in 1911 gebouwd naar ontwerp van J.B. Radstake."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00348> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delden (stad)"@nl ;
        min:adres "Markt 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Delden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delden (stad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Delden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17651>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41994> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34158",
            "507496" ;
        min:soort "inleiding" ;
        min:volgnummer 348 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0027> ;
        schema:name "Delden (stad)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Het Posthuis (Markt 1) [4], ook wel het huis ‘In de Kroon’ genoemd, is een waarschijnlijk 17de-eeuws, diep huis met houtskelet en zijgevels in vakwerk. De bakstenen klokgevel met kroon en jaartal dateert uit 1764. De naastgelegen zandstenen inrijpoort diende voor de stalling van paarden, zowel die van herberggasten als die van het postveer Amsterdam-Hamburg, dat hier in de 18de eeuw was gevestigd. Daaraan herinnert ook de gevelsteen met posthoorn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00349> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delden (stad) – Raadhuizen"@nl ;
        min:adres "Hengelosestraat 24",
            "Noorderhagen 35",
            "Zuiderhagen 10/Werdmuller von Elggstraat 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Delden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delden (stad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Delden" ;
        min:lemma "Raadhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70982> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507641" ;
        min:soort "lemma" ;
        min:volgnummer 349 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0027> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text """Raadhuizen. Het voorm. raadhuis van Ambt Delden, ook bekend als Het Eysink (Hengelosestraat 24) is een eenlaags pand in neoclassicistische trant. De bouw hangt mogelijk samen met het in werking treden van de gemeentewet van 1851. In 1873 werd de raadhuisfunctie overgenomen door het voorm. raadhuis van Stad en Ambt-Delden, Langestraat 30 [5], gelegen op de hoek van de Markt. Dit gebouw - tevens gerechtsgebouw, politiebureau en veldwachterswoning - verrees in 1873 naar plannen van J. Moll in eclectische stijl. Het verving het voorm. stadhuis van Delden uit 1738. In 1906 kreeg het eenlaags pand een verdieping. Als raadhuis van Ambt-Delden diende het tot 1936. Sinds omstreeks 1980 is het in gebruik als zoutmuseum.

Het postkantoor (Zuiderhagen 10/Werdmuller von Elggstraat 2) [6], een dwars pand met schilddak en lage aanbouw, werd in 1910 in neorenaissancestijl gebouwd door A. Groothengel uit Borne.

De voorm. School met den Bijbel (Noorderhagen 35) [7] werd gebouwd in 1922 als eenlaags schoolgebouw met twee lokalen. Het ontwerp van J.B. Radstake heeft een expressionistische detaillering."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00350> a min:Passage,
