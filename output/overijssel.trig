        min:kern "Hengevelde" ;
        min:lemma "Herberg" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 632 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0052> ;
        schema:name "Herberg"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "Herberg ‘Varenbrink’ (Goorsestraat 15) is een met riet en pannen gedekte langhuisboerderij met aan de voorzijde een aangebouwde en later vergrote bovenkamer. De gevelsteen met het jaartal 1799 en het opschrift: ‘Hier verkoopt men gebrande wateren’ toont dat het pand al twee eeuwen de functie van herberg heeft. Het boerderijgedeelte is onlangs verbouwd tot feestzaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00633> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengevelde (gemeente Ambt Delden) – Boerderij"@nl ;
        min:adres "Slotsweg 23" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
