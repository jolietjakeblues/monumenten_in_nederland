        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "156" ;
        schema:pageStart "155" ;
        schema:pagination "155-156" ;
        schema:text "De openbare lagere school (Blankenburgstraat 40) is een eenlaags gebouw op T-vormige plattegrond, gebouwd omstreeks 1920 in expressionistische trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00549> a min:Passage,
