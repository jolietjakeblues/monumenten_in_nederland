        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26000>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31210> ;
        min:provincie "Overijssel" ;
