        schema:pageEnd "159" ;
        schema:pageStart "159" ;
        schema:pagination "159" ;
        schema:text "De (Geref.) Hessenwegkerk (Hessenweg ong., Heemse) is een bakstenen zaalkerk met ongelede toren uit 1951, met schilddak en gebouwd in sobere traditionalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00560> a min:Passage,
