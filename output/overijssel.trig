        min:kern "Oldenzaal" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20536> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "512030" ;
        min:soort "inleiding" ;
        min:volgnummer 812 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0077> ;
        schema:name "Oldenzaal"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "De R.K. St.-Antoniuskerk (Spoorstraat 2) [2] is een neogotische kruisbasiliek met achtkante traptoren voorzien van ingesnoerde achtzijdige spits, gebouwd in 1911-'12 naar ontwerp van K.L. Croonen. De pastorie (Spoorstraat 4) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00813> a min:Passage,
