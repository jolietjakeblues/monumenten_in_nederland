        min:soort "inleiding" ;
        min:volgnummer 799 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0076> ;
        schema:name "Oldemarkt (gemeente IJsselham)"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "223" ;
        schema:pagination "223" ;
        schema:text "Het voorm. raadhuis annex waag (Hoofdstraat 73) is een groot, sober neoclassicistisch pand dat in 1857 werd gebouwd met de komst van de nieuwe burgemeester Jan Koning, zoon van Klaas Koning. De ruimtelijke scheiding tussen het raadhuis op de verdieping en de waag beneden is door latere verbouwingen niet meer herkenbaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00800> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldemarkt (gemeente IJsselham) – Scholen"@nl ;
        min:adres "Frieseweg 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "IJsselham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldemarkt (gemeente IJsselham)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Oldemarkt" ;
        min:lemma "Scholen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 800 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0076> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "Scholen. Het opvallende gebouw Hoofdstraat 49-51, bestaande uit een hoogopgaand dwars middendeel, aan weerszijden geflankeerd door een lagere vleugel met lessenaarsdak, diende van 1863 tot 1912 als bewaarschool. De hoofdvorm zal uit omstreeks 1863 stammen en de lessenaarsdaken en kap van het hoge deel zullen van omstreeks 1900 dateren. De R.K. St.-Bernardusschool (Frieseweg 6) is een eenvoudige tweeklassige school uit 1921."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00801> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldemarkt (gemeente IJsselham) – Woonhuizen"@nl ;
        min:adres "'t Butent 8",
            "Frieseweg 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "IJsselham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldemarkt (gemeente IJsselham)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Oldemarkt" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59984> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "506462" ;
        min:soort "lemma" ;
        min:volgnummer 801 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0076> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text """Woonhuizen. Het oudste bewaard gebleven huis is Hoofdstraat 96, een tweebeukig diep huis met dubbele trapgevel. Het pand, dat volgens de muurankers uit 1637 dateert, werd gebouwd voor de vermogende katholieke familie Muurlink. Het dwarse huis Hoofdstraat 93 is wellicht nog 18de-eeuws, maar kan ook na 1832 met behulp van oudere onderdelen zijn herbouwd. Dat laatste geldt zeker voor Hoofdstraat 77, een eenvoudig eenlaags pand met puntgevel geflankeerd door 18de-eeuwse klauwstukken. Het vrijstaande eenlaags pand Kon. Julianaweg 1 werd omstreeks 1872 gebouwd voor burgemeester H. Visscher. Een bouwlaag hoger is het neoclassicistische woonhuis Dalwijk (Frieseweg 1) uit omstreeks. 1880. Nabij het Mallegat staat het voor de nijverheid van Oldemarkt kenmerkende woonhuis met (boter)pakhuis Hoofdstraat 144, gebouwd in 1912. Het woongedeelte vertoont jugendstildetails.

Het veerhuis ('t Butent 8) werd gebouwd in 1821 in opdracht van de kuiper en koopman Klaas Koning, die in 1828 burgemeester van Oldemarkt werd. Het rechthoekige gepleisterde pand bestaat uit een kelder met daarboven een bouwlaag voor handel en opslag; de kelder gaat aan de achterzijde over in een souterrainwoning. Bij een verbouwing in 1859 heeft men aan de voorgevel een bordes toegevoegd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00802> a min:Passage,
