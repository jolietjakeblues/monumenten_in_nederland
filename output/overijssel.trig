        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Welsum (gemeente Olst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Welsum" ;
        min:lemma "Dijkhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1028 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0104> ;
        schema:name "Dijkhuizen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Dijkhuizen. Karakteristiek voor de langgerekte bebouwing langs de dijk zijn de dijkhuizen, waarvan het woongedeelte op dijkniveau ligt en het bedrijfs- dan wel slaapgedeelte lager. Den Bijvang (IJsseldijk 37) gebouwd in 1790 is hier een goed vooorbeeld van, evenals IJsseldijk 45 en het omstreeks 1860 gebouwde IJsseldijk 57. Het neoclassicistisch vormgegeven De Brabantse Wagen (IJsseldijk 51-51A) kwam in 1884 tot stand en is een woonhuis annex herberg annex boerderij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0104.php> .

