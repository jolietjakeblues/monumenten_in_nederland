        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74571>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74572> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "26288",
            "513511" ;
        min:soort "lemma" ;
        min:volgnummer 239 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0014> ;
        schema:name "Austi"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Austi (Paandersdijk 12) is een landgoed ten zuidwesten van Beuningen, met als kern een in 1951 door J. Erven Dorens gebouwd eenlaags buitenhuis met steile kap. Op het landgoed staan enkele oude boerderijen. ‘Olde Austi’ (Austibergweg 2) is een kleine 18de-eeuwse driebeukige langhuisboerderij met vakwerkgevels. Op het erf bevindt zich een zandstenen put met haalboom. Uit 1804 dateert ‘Austi’ (Paandersdijk 10), een langhuisboerderij met bovenkamer in vakwerk en een vakwerk-wagenschuur. Bij de boerderij hoort ook een driebeukige schuur uit 1932 naar plannen van Joh. H. Sluijmer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0014.php> .

