        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geesteren (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Geesteren" ;
        min:lemma "Langeveen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0039> ;
        schema:name "Langeveen"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Langeveen. Dit dorp ten noorden van Geesteren ontstond in de 19de eeuw. De huidige kern dateert van na de Tweede Wereldoorlog. De R.K. St.-Pancratiuskerk (Kerklaan 5) is een eenvoudige zaalkerk met driezijdig gesloten koor en een ongelede toren met ingesnoerde naaldspits, gebouwd in 1924-'25 naar ontwerp van Th.J. van Elsberg. Ze verving van een kerk uit 1843. De aangebouwde pastorie (Kerklaan 3) verrees gelijktijdig. Van de windmolen Molenbergstraat 28, gebouwd in 1909 voor J.A. van der Aast, resteert slechts de romp. Deze stellingmolen heeft men in 1925 onttakeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00505> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 505 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Genemuiden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Kleine dijkstad aan het Zwarte Water, die in 1275 stadsrechten kreeg van bisschop Jan van Nassau. Tot een werkelijk stedelijke ontwikkeling is het echter nooit gekomen. In 1347 verkregen de inwoners het visrecht in het gebied dat zich uitstrekte van Waterstein tegenover Zwartsluis tot de Voorst oostelijk onder Vollenhove. In 1460 werden de visrechten uitgebreid met de rest van het Zwarte Water. Met stenen afkomstig van de in 1531-'35 afgebroken burcht van Kuinre werd in de 16de eeuw een blokhuis gebouwd, dat men echter al in 1584 ontmantelde; de laatste resten zijn in de 18de eeuw verdwenen. In 1625, 1698 en 1741 teisterden grote branden de stad en in 1825 had ze te lijden van de watersnood. Na nieuwe wateroverlast in 1862 en 1863 legde men in 1866 een keersluis aan, evenals de daarop aansluitende Sasdijk langs het Zwarte Water."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00506> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 506 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Genemuiden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Nadat al omstreeks 1700 de visserij was teruggelopen, legde de bevolking zich toe op de vervaardiging van biezenmatten. Tussen 1840 en 1927 werden daarom de kustgronden tussen de monding van de IJssel en het Zwarte Water met biezen beplant. Tussen 1870 en 1882 beleefde de mattenvlechterij haar grootste bloei. In de omgeving werd ook veel hooi geoogst voor verkoop op de markt; voor de opslag bouwde men diverse hooibergen in de stad. Deze werden langs de Achterweg geconcentreerd, nadat in 1868 een brand een groot deel van Genemuiden had verwoest. Het noordelijke deel van de stad werd in 1882 in de as gelegd. Tussen 1880 en 1940 kwam een uitbreiding van de bebouwing tussen de Binnenhaven en de Sasdijk tot stand, het ‘Nieuw-Genemuiden’ of ‘De Overkaante’. De oude rivierarm De Heve werd in 1914 gedempt en is sinds 1918 bebouwd met woningbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00507> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 507 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Genemuiden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Na 1916 ging men over op de vervaardiging van matten op grond van kokosgarens, een productie die in 1924 werd gemechaniseerd. Na 1945 groeide deze nijverheid tot een bloeiende industrie. In 1948 kwam de uitbreidingswijk de Buitenlanden tot stand en na 1957 een uitbreiding in de Mastenbroeker polder. De Binnenhaven werd in 1959 gedeeltelijk gedempt; hier bouwde men in 1969 een nieuw stadhuis. In die omgeving verrezen ook enkele grote moderne kerken, waaronder in 1953 een nieuwe gereformeerde kerk en in 1959 een kerk voor de gereformeerde gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00508> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden"@nl ;
        min:adres "Kerkplein 25" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 508 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Genemuiden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "De (Herv.) Grote of St.-Nicolaaskerk (Kerkplein 25) is een driebeukige kruiskerk in neorenaissancevormen, gebouwd in 1883 nadat het jaar daarvoor de uit 1535 stammende voorganger door brand verloren was gegaan. De door W. en F.C. Koch ontworpen kerk combineert de oorspronkelijke driebeukige opzet met de centraliserende werking van een kruiskerk. Het recht gesloten koorgedeelte heeft een hoge ingangspartij. Aan de noordoostzijde staat een toren van vier geledingen bekroond met een ingesnoerde spits. De toren heeft overwegend neorenaissancevormen, maar de tweede geleding is voorzien van een blindtracering in gotische vormen. De uitbouw aan de noordzijde van de kerk dateert uit 1907 en de vrijstaande consistoriekamer uit 1960. De kerk is in 1969 gerestaureerd. In de kerk bevindt zich een orgel uit 1883, gemaakt door Z. van Dijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00509> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden"@nl ;
        min:adres "Langestraat 22" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 509 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Genemuiden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Het voorm. raadhuis (Langestraat 22) is een fors pand met kroonlijst en fronton in neoclassicistische vormen. Het gebouw dateert oorspronkelijk uit 1786, maar is na de stadsbrand van 1868 in het jaar daarop hersteld onder leiding van L. Kroon uit Zwolle. De eclectische vensteromlijstingen op de verdieping stammen uit die tijd. Tot 1969 heeft het als stadhuis dienst gedaan; nu is het een woon- en winkelpand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00510> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden – Woonhuizen"@nl ;
        min:adres "Langestraat 78-82" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 510 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text """Woonhuizen. Door de regelmatig terugkerende stadsbranden zijn weinig oude woonhuizen bewaard gebleven. Wat na deze branden tot stand kwam, kenmerkt zich door ingetogenheid. Voorbeelden daarvan zijn: Westerkaai 28 (1858), het dubbele woonhuis Westerkaai 22-24 (omstreeks 1860) en Gedenkt te Sterven (Langestraat 78-82), een dubbel huis met ingezwenkte lijstgevel uit 1879. Rijker, maar eveneens ingetogen neoclassicistisch van vormgeving, is het grote huis Veerweg 4 uit 1862, ontworpen door W. Swerver voor notaris J.W. Jonker. De ingangsomlijsting heeft corinthische kapitelen en een fraai gesneden bovenlicht. In de plint zitten gevelstenen met de namen van architect en opdrachtgever. Aan de Oosterbrugstraat staan arbeiderswoningen uit omstreeks 1910.

Het café Westerkaai 48 bestaat uit een sober neoclassicistisch vormgegeven gebouw uit omstreeks 1880 en een uitbreiding uit omstreeks 1925 in expressionistische vormen.

De keersluis (Westerkade ong.) tussen de binnen- en de buitenhaven werd in 1866 gebouwd naar plannen van A.L. de Bruin Kops. Alleen bij hoge waterstanden sloot men de keersluis of sas om het achterliggende land tegen overstroming te beschermen. De voetgangersbrug, die over de sluiskom gereden kan worden, dateert uit dezelfde tijd. De schotbalksponningen zijn in 1950-'52 aangebracht in het kader van de IJssellinie. Het geheel is in 1987 gerestaureerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00511> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Genemuiden – Bedrijfsbebouwing"@nl ;
        min:adres "Kamperzeedijk Oost 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Genemuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Genemuiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Genemuiden" ;
        min:lemma "Bedrijfsbebouwing" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 511 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill197>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill198>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill199> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0040> ;
        schema:name "Bedrijfsbebouwing"@nl ;
        schema:pageEnd "148" ;
        schema:pageStart "147" ;
        schema:pagination "147-148" ;
        schema:text """Bedrijfsbebouwing. Karakteristiek voor Genemuiden is de concentratie van hooibergen aan de Achterweg die daar na de stadsbrand van 1868 is ontstaan. Vanwege het brandgevaar geldt hier nog steeds een rookverbod op de openbare weg. Enkele van de vele, in opzet laat-19de-eeuwse hooibergen en wagenschuren zijn bewaard gebleven.

Het Volkspark (Blokhuisweg ong.) kwam omstreeks 1857 tot stand, toen een deel van de gracht aan de noordwestzijde werd gedempt. Het gebied ten noorden van de toen ontstane Nijstad werd veranderd in een park in Engelse landschapsstijl.

De Oude Alg. begraafplaats Rust Plaats (Blokhuisweg ong.), grenzend aan het Volkspark, is aangelegd in 1828 en uitgebreid omstreeks 1870. Tot die uitbreiding behoren het in Willem II-gotiek uitgevoerde baarhuisje (1871), met schedel, zandloper en ‘Memento Mori’ boven de ingang, en het smeedijzeren hek (1873) met zijn forse hekpalen en de naam van de begraafplaats.

Het voorm. stoomschepradgemaal Mastenbroek (Kamperzeedijk Oost 7), gelegen ten zuidoosten van Genemuiden, werd in 1855-'56 gebouwd als eerste stoomgemaal in Overijssel. De ingenieurs W.J. Backer, J.A. Beyerink en B.P.G. van Diggelen maakten de plannen. Het eenlaags gebouw met aangebouwde wagenberging, schoorsteen en open ijzeren scheprad herbergt een langzaam werkende horizontale stoommachine, gebouwd door de Amsterdamse fabriek ‘De Atlas’. De N.V. Veendammer Machinefabriek v/h J. ten Horn te Veendam maakte in 1925 de stoomketel. Opdrachtgevers en uitvoerenden staan vermeld op een grote gevelsteen aan de straatzijde. Het stoomgemaal, dat het grootste deel van de polder Mastenbroek bemaalde en diverse molengangen verving, werd in 1961 buiten werking gesteld toen het ernaast gelegen elektrische vijzelgemaal Veneriete gereedkwam. Sinds 1984 is het stoomgemaal een museum."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00512> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giethoorn (gemeente Brederwiede)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Brederwiede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giethoorn (gemeente Brederwiede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Giethoorn" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 512 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0041> ;
        schema:name "Giethoorn (gemeente Brederwiede)"@nl ;
        schema:pageEnd "148" ;
        schema:pageStart "148" ;
        schema:pagination "148" ;
        schema:text "Waterstreekdorp, voor het eerst genoemd in 1225. De ontginningsbasis van dit natte verveningsgebied werd gevormd door het ruim vijf kilometer westelijker gelegen Giethoornse meer. De kavels waren onderverdeeld in vier door grachten gescheiden kluften (kleine bestuurlijke eenheden binnen een schoutambt). De Cornelisgracht en de Walengracht kunnen nog als restanten van deze ruimtelijke scheiding gezien worden. De Dwarsgracht is een restant van de ‘achterkade’ van de eerste ontginningsslag. Na enkele nieuwe ontginningsslagen volgde ten slotte in de 17de eeuw de laatste dorpsverplaatsing van de Gieterse dijk (nu Beulakerweg) naar de Dorpsgracht. Alleen de Herv. kerk is blijven staan. Dit heeft uiteindelijk geresulteerd in een zeer langgerekt, tweerijig waterstreekdorp met een drietal, iets ten opzichte van elkaar versprongen, buurten: Noordeinde, Middenbuurt en Zuideinde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00513> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giethoorn (gemeente Brederwiede)"@nl ;
        min:adres "Binnenpad 68" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Brederwiede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giethoorn (gemeente Brederwiede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Giethoorn" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 513 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill200> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0041> ;
        schema:name "Giethoorn (gemeente Brederwiede)"@nl ;
        schema:pageEnd "149" ;
        schema:pageStart "148" ;
        schema:pagination "148-149" ;
        schema:text "Omstreeks 1750 kwam een einde aan de natte vervening, waarna men overging op extensieve veehouderij. Mogelijk door de geïsoleerde ligging van het dorp, ontstond hier in 1551 een van de eerste doopsgezinde gemeenten van ons land. Bij de watersnood van 1825 ontstond het Molengat en veranderde de ligging van de Molenweg. Vanwege de dreiging van het water werd er in het gebied vanaf 1825 ingepolderd. In 1910 kwam de Giethoornse polder gereed en in 1935 de polder Halfweg. Het bijzondere dorpskarakter van Giethoorn wordt in belangrijke mate bepaald door de Dorpsgracht met zijn vele hoge bruggen en de op afzonderlijke, zogeheten huuspollen staande huizen en boerderijen, die van elkaar worden gescheiden door kavelsloten en met elkaar worden verbonden door vonders (plankbruggen) waarover een voetpad langs de Dorpsgracht ligt. Vanaf het begin van de 20ste eeuw ontwikkelde Giethoorn zich tot plaats voor recreatie en toerisme. Dit werd versterkt door de uit 1958 stammende film Fanfare, waarin het bondshotel ‘Hollandsch Venetië’, nu café ‘Fanfare’ (Binnenpad 68), een belangrijke rol speelde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00514> a min:Passage,
            schema:CreativeWork ;
