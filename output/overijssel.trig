        min:soort "inleiding" ;
        min:volgnummer 762 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0069> ;
        schema:name "Mariënberg (gemeente Hardenberg)"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "De dubbele dienstwoningen (Stationsweg 8-10), gelegen aan het spoor, werden omstreeks 1904 gebouwd voor de Noordooster Locaalspoorweg-Maatschappij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00763> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mariënberg (gemeente Hardenberg)"@nl ;
        min:adres "Stationsweg 3-4",
            "Stationsweg 5" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Hardenberg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mariënberg (gemeente Hardenberg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Mariënberg" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 763 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill302> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0069> ;
        schema:name "Mariënberg (gemeente Hardenberg)"@nl ;
        schema:pageEnd "217" ;
        schema:pageStart "216" ;
        schema:pagination "216-217" ;
        schema:text "Het voorm. station (Stationsweg 3-4) is een rijzig gebouw met boven een woning en beneden dienstvertrekken en een lagere aanbouw. Het station is een iets simpeler uitvoering van dat in Dalfsen. Het werd in 1903 ontworpen door Ed. Cuypers voor de spoorlijn Zwolle-Emmen van de Noordooster Locaalspoorweg-Maatschappij. Aan de spoorzijde hangt een sectiel-tegeltableau met de stationsnaam; het is vervaardigd door J. Thooft en Labouchère uit Delft. De VTC Mariënberg (Stationsweg 5) is een handel in veevoeder, bestaand uit een dwars deel met hoog pannendak en een gedeeltelijk met hout beklede silotoren met traptoren en dakhuisje. Het nog vrij gave complex uit omstreeks 1930 is uitgevoerd in laatexpressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00764> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Markelo"@nl ;
        min:adres "Goorseweg 5",
            "Grotestraat 1/Kerkplein 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Markelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Markelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Markelo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21690>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50914>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59711> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "12874",
            "12875",
            "28128" ;
        min:soort "inleiding" ;
        min:volgnummer 764 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill303> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0070> ;
        schema:name "Markelo"@nl ;
        schema:pageEnd "217" ;
        schema:pageStart "217" ;
        schema:pagination "217" ;
        schema:text "Dorp, ontstaan aan de oostflank van de Markelerberg, in de middeleeuwen de plaats waar de bisschop van Utrecht met zijn Twentse onderdanen samenkwam. De westzijde van dorp heeft haar oude agrarische karakter nog grotendeels behouden. Na 1960 ontstonden ten oosten van het dorp nieuwbouwwijken. De Herv. kerk (Grotestraat 1/Kerkplein 6) bestaat uit een 15de-eeuwse toren van twee geledingen met laag tentdak en een fors neoclassicistisch zaalgebouw uit 1840, gebouwd ter vervanging van de middeleeuwse, aan St. Martinus gewijde kerk. Na een torenbrand in 1730 is de derde geleding afgebroken en zijn in de tweede geleding galmgaten aangebracht. De restauratie in 1932, onder leiding van F.B. Jantzen, veranderde het kerkinterieur ingrijpend. Tot de inventaris behoren een 15de-eeuws zandstenen doopvont en een orgel van C. Haupt uit 1863. De gebrandschilderde ramen uit 1932 zijn uitgevoerd door de firma G. Schooneveld naar ontwerp van Jantzen. De voorm. pastorie (Goorseweg 5) is een neoclassicistisch herenhuis uit 1853. Het dient nu als kantoor van het waterschap De Schipbeek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00765> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Markelo"@nl ;
        min:adres "Burg. De Beaufortplein 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Markelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Markelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Markelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 765 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0070> ;
        schema:name "Markelo"@nl ;
        schema:pageEnd "217" ;
        schema:pageStart "217" ;
        schema:pagination "217" ;
        schema:text "Het raadhuis (Burg. De Beaufortplein 1) dateert uit 1872 en is een gepleisterd pand met souterrain, schilddak en kleine dakruiter, mogelijk naar ontwerp van J. Moll. Het eclectische front is voorzien van neoclassicistische elementen als pilasters, lisenen en frontons boven ingang en vensters. De beletage is toegankelijk via een vernieuwde halfronde bordestrap. In 1938 is de zolder uitgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00766> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Markelo – Woonhuizen"@nl ;
        min:adres "Goorsesweg 16",
            "Goorseweg 24",
            "Goorseweg 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Markelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Markelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Markelo" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 766 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0070> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "217" ;
        schema:pageStart "217" ;
        schema:pagination "217" ;
        schema:text """Woonhuizen. Op de plaats van het verdwenen 17de-eeuwse adellijke huis Hulsbeke is in 1841 het dwarse eenlaags pand De Hulsbeeke (Goorseweg 24) gebouwd. Het huis heeft een haakse achterbouw. Het gepleisterde neoclassicistische herenhuis De Wiekslag (Goorseweg 7), voorzien van middenrisaliet met fronton, dateert uit omstreeks 1875.

Tandem (Goorsesweg 16) is een omstreeks 1910 als notarishuis gebouwd eclectisch herenhuis met driezijdige erker en portiek. De Hulpe 1 is een burgemeesterswoning uit 1936, met een overkragende houten verdieping."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00767> a min:Passage,
