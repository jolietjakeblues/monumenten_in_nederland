        min:hoofdstuk "Steden, dorpen, monumenten › Willemsoord (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Willemsoord" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36443> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "413728" ;
        min:soort "inleiding" ;
        min:volgnummer 1063 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0109> ;
        schema:name "Willemsoord (gemeente Steenwijk)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "De Herv. kerk (Steenwijkerweg 159) is een neoclassicistische zaalkerk met risalerende ingangspartij en houten geveltoren met ingesnoerde spits. De Maatschappij van Weldadigheid liet haar in 1851 bouwen. De eerste steen werd gelegd door dominee G. Ruitenschild. De lagere uitbouw met consistoriekamer aan de achterzijde werd in 1898 toegevoegd. Het orgel stamt uit de bouwtijd, maar bevat pijpwerk uit de 17de eeuw. De pastorie (Steenwijkerweg 157) is uitgevoerd in neoclassicistische vormen en dateert ook uit de bouwtijd van de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01064> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Willemsoord (gemeente Steenwijk) – Boerderijen"@nl ;
        min:adres "Amsterdamselaan 6",
            "De Rond Blesse 7",
            "Kon. Wilhelminalaan 42",
            "Steenwijkerweg 175" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Willemsoord (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Willemsoord" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1064 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0109> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text """Boerderijen. Na een pioniersperiode van de kolonie Willemsoord werden in 1864 drie grote langsboerderijen gesticht, de Hoeve Generaal Van den Bosch (Steenwijkerweg 175), de Hoeve Amsterdam (Amsterdamselaan 6) en de Hoeve Utrecht (Kon. Wilhelminalaan 42). Ze vormden de kern van de kolonie. In 1900 werd de Helenahoeve (De Rond Blesse 7) toegevoegd. Bij een verbouwing in 1913 kregen de hoeven hun huidige aanzien en in 1923 kwamen ze in privé-bezit.

De begraafplaats Vredehof (Kerkhoflaan ong.) werd omstreeks 1850 gesticht. Het graf van G.W. Stroink (†1941), voorzitter van de Overijsselse Landbouwmaatschappij en burgemeester van Steenwijkerwold, is voorzien van beeldhouwwerk van Hildo Krop. Dichtbij ligt het graf van zijn broer, de dijkgraaf A.F. Stroink (†1956)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0109.php> .

