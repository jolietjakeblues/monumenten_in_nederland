        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "Het voorm. St.-Gerardus Majellaziekenhuis (Wilhelminastraat 12) verrees omstreeks 1900 in ‘Um 1800’-trant en wordt nu gebruikt als verpleeghuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00381> a min:Passage,
