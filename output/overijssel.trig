        min:kern "Delden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26661>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30882> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "28129",
            "28130" ;
        min:soort "inleiding" ;
        min:volgnummer 345 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill110> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0027> ;
        schema:name "Delden (stad)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "84" ;
        schema:pagination "84-85" ;
        schema:text "Om de kerk ligt het ommuurde voorm. kerkhof, met aan de zijde van de Markt een van de vier in ons land bewaard gebleven exemplaren van een zogenoemde ‘varkens- of duivelsrooster’. Een dergelijk rooster belette loslopende varkens de toegang tot het kerkhof. De pastorie (Kerkplein 2), is een blokvormig, neoclassicistisch pand uit het midden van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00346> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delden (stad)"@nl ;
        min:adres "Langestraat 76",
            "Langestraat 78" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hof van Twente" ;
        min:gemeenteInBoek "Delden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hof_van_Twente> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delden (stad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Delden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15867>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17865> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34156",
            "34157" ;
        min:soort "inleiding" ;
        min:volgnummer 346 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0027> ;
        schema:name "Delden (stad)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "De R.K. St.-Blasiuskerk [2] (Langestraat 76) is een niet-georiënteerde neogotische pseudo-basiliek met driezijdige gesloten midden- en zijkoren, gebouwd in 1871-'73 naar ontwerp van H.J. Wennekers. Aan de zuidzijde staat een grote westtoren met aangebouwde achtzijdige traptoren. Van de toren waren in 1873 de twee onderste geledingen voltooid, de bovenste geleding en de achtkante, ingesnoerde spits zijn in 1893 aangebracht naar plannen van H.J. Wennekers en A.C. Boerma. Kerk en toren zijn sterk op Nederrijnse voorbeelden geïnspireerd. Het interieur wordt overdekt door stenen kruisribgewelven, met scheibogen die rusten op ronde zuilen met achtkante lijstkapitelen. Halverwege de westelijke zijbeuk diende een dwarse uitbouw als zangkoor; later is het als Lourdeskapel ingericht. Een achtkante sacristie verbindt de kerk met de pastorie (Langestraat 78) uit 1872, eveneens naar ontwerp van H.J. Wennekers. Dit neogotische gebouw op L-vormige plattegrond is voorzien van een achthoekige traptoren. Om de pastorie ligt een grote landschappelijke tuin."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00347> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delden (stad)"@nl ;
        min:adres "Noorderhagen 54" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
