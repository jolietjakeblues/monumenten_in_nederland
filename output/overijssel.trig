        min:gemeenteInBoek "Avereest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dedemsvaart (gemeente Avereest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24242> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "515822" ;
        min:soort "inleiding" ;
        min:volgnummer 336 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Dedemsvaart (gemeente Avereest)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Het voorm. postkantoor annex directeurswoning (Markt 1A) is een fors tweelaags pand in eclectische stijl, gebouwd in 1877-'78 naar plannen van J. Moll uit Hengelo. Het heeft op de hoek een afgeschuinde ingangspartij en aan de voorzijde een middenrisaliet met gepleisterde vensteromlijstingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00337> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dedemsvaart (gemeente Avereest) – Woonhuizen"@nl ;
        min:adres "Moerheimstraat 144",
            "Moerheimstraat 86-88",
            "Moerheimstraat 90",
            "Moerheimstraat 98" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Avereest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dedemsvaart (gemeente Avereest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dedemsvaart" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21618> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "515820" ;
        min:soort "lemma" ;
        min:volgnummer 337 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0026> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Woonhuizen. In het dorp staan nog grote woonhuizen en villa's; veelal gaat het om notabelen- of ververvenershuizen. Villa Dina (Moerheimstraat 144) is een fraai voorbeeld. Dit huis werd in opdracht van de vervener B. Berends in 1877 in eclectische vormen gebouwd. Sinds 1918 dient het als raadhuis van de gemeente Avereest. Ook Langewijk 190 uit omstreeks 1875 is een vergelijkbare eclectische villa. Herenhuizen in eclectische vormen zijn de notariswoning Julianastraat 40 uit omstreeks 1885 en Moerheimstraat 30 uit omstreeks 1890. Eveneens eclectisch is de onderwijzerswoning Moerheimstraat 104, uit dezelfde tijd. De andere onderwijzerswoning uit die tijd, Julianastraat 52, is meer neoclassicistisch in hoofdvorm. Andere grote, meer neoclassicistische villa's zijn Hoofdvaart 53-55 uit omstreeks 1890 en Moerheimstraat 180-182 uit omstreeks 1900. Awierend (Moerheimstraat 86-88) is een curieus en rijk eclectisch pand. Dat geldt eveneens voor de uit 1906 stammende dokterswoning Agatha Adriana (Moerheimstraat 90) voor dokter Van Barneveld, die in zijn vormgeving nogal Duits aandoet. jugendstil-elementen vertonen de Villa Marquette (Moerheimstraat 98) en Moerheimstraat 62, beide uit omstreeks 1910, en de woning met praktijk Hoofdvaart 9 uit 1910, naar plannen van K. Hakkert."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0026.php> .

