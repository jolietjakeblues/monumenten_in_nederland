        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54366> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "15306" ;
        min:soort "lemma" ;
        min:volgnummer 735 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0065> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "Boerderijen. Ten oosten van Lonneker liggen twee vermeldenswaardige boerderijen. De Roosker (Lossersestraat 170) is een hallenhuisboerderij uit 1774 onder zadeldak met houten topschilden; ze heeft een haaks geplaatste bovenkamer en vrijstaande vakwerkschuur. Lossersestraat 235 is een uit 1880 stammende boerderij met dwars woongedeelte en een in 1931 vernieuwd bedrijfsdeel onder mansardekap."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00736> a min:Passage,
