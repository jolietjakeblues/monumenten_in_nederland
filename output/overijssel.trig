        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26882> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "7492" ;
        min:soort "lemma" ;
        min:volgnummer 202 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill63> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "56" ;
        schema:pagination "56-57" ;
        schema:text """Windmolen ‘De Hoop’ (Nieuwstraat 71) is een achtkante stellingkorenmolen op houten onderstuk en bakstenen voet, gebouwd in 1870 en herbouwd na brand in 1910. De sluitsteen met het wapen van Almelo boven de toegang is mogelijk afkomstig van de stadsmolen uit 1747. De molen is in 1994-'95 gerestaureerd en met asfalt-shingles gedekt.

De draaibrug over het kanaal Almelo-Nordhorn (bij Sluiskade Zuidzijde 159) is een smalle houten brug met tuiwerk uit omstreeks 1890."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00203> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo – Industriegebouwen"@nl ;
        min:adres "Gorterstraat 3",
            "Sluiskade N.Z. 14",
            "Twentheplein 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:lemma "Industriegebouwen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 203 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text "Industriegebouwen. In de afgelopen decennia is een groot deel van de textielfabrieken gesloopt. De voorm. Stoomspinnerij Twenthe (Twentheplein 3) bestaat uit een drielaags betonskeletbouw en een vierkante watertoren met slanke schacht en ver overkragend reservoir. De fabriek werd in 1914 gebouwd naar ontwerp van A.G. Beltman en verving de dat jaar afgebrande fabriek van de katoenmaatschappij voorheen Gebr. Scholten & Co. De fabriek werd in 1920 uitgebreid en kreeg in 1993 een nieuwe bestemming als bedrijfsverzamelgebouw. Van de verdwenen voorm. textielfabriek Holland (Gorterstraat 3) van de firma H. ten Cate Hzn. & Co. bestaat nog wel het kantoorgebouw. Het oorspronkelijke kantoorgebouw in strakke baksteenarchitectuur werd na de fusie met de Koninklijke Stoomweverij te Nijverdal in 1953 aan de noordzijde uitgebreid met een eenlaags kantoorgebouw in glas en staal, naar ontwerp van J. Kromhout van het architectenbureau Van de Broek en Bakema in samenwerking met G. Beltman jr. Van de weverij bleef na de sloop in 1993 slechts het naar ontwerp van H.A. Witzand in 1911 gebouwde hoektorentje in jugendstilvormen behouden. Het op een straathoek gelegen torentje, met tentdak en opbouw voorzien van wijzerplaten, was een geschenk van het personeel ter gelegenheid van een halve eeuw mechanisch weven. Van het grotendeels verdwenen fabriekscomplex van de Stoomspinnerij Ten Cate (Sluiskade N.Z. 14) resteert de fabriekswatertoren met stelling uit 1924, gebouwd naar plannen van A.G. Beltman. De toren diende als reservoir voor de sprinklerinstallatie van de fabriek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00204> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo – Pakhuizen"@nl ;
        min:adres "Reggestraat 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Almelo" ;
        min:lemma "Pakhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 204 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Pakhuizen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text """Pakhuizen. Het voorm. pakhuis aan de Marktstraat (ong.), gebouwd voor de firma J.J. Engberts & Co., is een onderkelderd drielaags gebouw uit 1862. Het drielaags pakhuis Poulinkstraat 3, voorzien van een hoektoren met ingesnoerde lage spits, stamt uit omstreeks 1910.

De watertoren (bij Reggestraat 7) is in 1926 gebouwd in opdracht van de Algemene Waterleiding Maatschappij Almelo naar ontwerp van G. Halbertsma en J. Buining. De in functionalistische vormen uitgevoerde toren van gewapend beton heeft een taps toelopende schacht en een vierkant reservoir met tentdak."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00205> a min:Passage,
