        min:lemma "Boerhaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73036>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73037> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "521739",
            "521740" ;
        min:soort "lemma" ;
        min:volgnummer 1061 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0108> ;
        schema:name "Boerhaar"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Boerhaar. Ten zuidoosten van Wijhe ligt het langgerekte dorp Boerhaar. Dit is in het begin van de 19de eeuw ontstaan aan de Soestwetering in de buurtschap Wengelo, toen daar in 1819 een eerste katholieke kerk werd gebouwd. De R.K. St.-Willibrorduskerk (Boerhaar 41) is een driebeukige neogotische kruiskerk met toren van twee geledingen en een ingesnoerde spits met flankerende torentjes. De kerk, met aan de noordzijde naast de toren een doopkapel, werd in 1912-'13 gebouwd naar plannen van H. Kroes op de plaats van een voorganger uit 1818. Het orgel stamt uit 1923. De pastorie (Boerhaar 43) kwam in 1913 tot stand naar plannen van H. Kroes. Interessante woonhuizen zijn het neoclassicistische woonhuis Boerhaar 51 uit 1862 en Boerhaar 13, gebouwd in 1889 en omstreeks 1910 opgehoogd in jugendstil-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01062> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Willemsoord (gemeente Steenwijk)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Willemsoord (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Willemsoord" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1062 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0109> ;
        schema:name "Willemsoord (gemeente Steenwijk)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Streek-ontginningsdorp genoemd naar koning Willem I en gesticht in 1820 door generaal J. van den Bosch als een van de ‘koloniën’ van de Maatschappij van Weldadigheid. Evenals de Drentse vestigingen Wilhelminaoord en Frederiksoord (hoofdvestiging) werd het opgericht om arme en behoeftige gezinnen en weeskinderen uit het westen van het land onderdak te verlenen en werkgelegenheid te bieden. Nabij de drie grote ontginningsboerderijen van de maatschappij kwam een dorp tot ontwikkeling dat in 1894 een spoorwegstation kreeg. In 1923 werden alle bezittingen van de Maatschappij verkocht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01063> a min:Passage,
            schema:CreativeWork ;
