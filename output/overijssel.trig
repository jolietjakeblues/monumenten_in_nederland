        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "512259",
            "512260",
            "512261" ;
        min:soort "lemma" ;
        min:volgnummer 642 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill254> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0055> ;
        schema:name "Het Hexel"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "181" ;
        schema:pagination "181-182" ;
        schema:text "Het Hexel (Haarboersweg 3) is een buitenplaats ten oosten van dorp, gelegen op de oostflank van een stuifzandrug en met uitzicht op Vriezenveen. In 1915 liet de Vriezenveense fabrikant C.B. Tilanus een theehuis bouwen en een bloementuin aanleggen naar ontwerp van D.F. Tersteeg. Deze ontwierp ook de parkaanleg uit 1917-'23, in architectonische tuinstijl. In 1922-'23 verrees het eenlaags landhuis naar ontwerp van J.W. Hanrath in Engelse landhuisstijl. De T-vormige chauffeurswoning (Haarboersweg 5) dateert uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0055.php> .

