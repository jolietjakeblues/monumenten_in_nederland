        min:hoofdstuk "Steden, dorpen, monumenten › Boekelo (gemeente Enschede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Boekelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 260 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0017> ;
        schema:name "Boekelo (gemeente Enschede)"@nl ;
        schema:pageEnd "66" ;
        schema:pageStart "66" ;
        schema:pagination "66" ;
        schema:text "Het voorm. station (Windmolenweg 24-26) werd in 1883 als eenlaags pand gebouwd voor de Geldersch-Overijsselsche Lokaalspoorweg Maatschappij aan de in 1884 geopende lijn Winterswijk-Hengelo. In 1916 kreeg het sober neoclassicistische gebouw een verdieping. Het is nu in gebruik als woning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0017.php> .

