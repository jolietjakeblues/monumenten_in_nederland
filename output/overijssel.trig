        min:hoofdstuk "Steden, dorpen, monumenten › Albergen (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Albergen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 181 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0007-01> ;
        schema:name "Albergen (gemeente Tubbergen)"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "De R.K. St.-Pancratiuskerk (bij Ootmarsumsestraat 176) is een basilicale kerk met driezijdig gesloten koor, narthex en een vierkante toren met betonnen open bovenbouw. De in 1953-'55 naar ontwerp van Th.J. van Elsberg in traditionalistische stijl gebouwde kerk verving een kerk uit 1841. De pastorie (Ootmarsumsestraat 176) dateert uit 1918-'19."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00182> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Albergen (gemeente Tubbergen) – Dienstwoningen"@nl ;
