        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "28134",
            "507968",
            "507969",
            "507970",
            "507971" ;
        min:soort "lemma" ;
        min:volgnummer 770 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill304> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0070> ;
        schema:name "Elsen"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Elsen. Buurtschap gelegen ten noorden van Markelo met voornamelijk 19de-eeuwse, typisch West-Twentse boerderijen met rieten wolfdak. De langhuisboerderij Bovenbergweg 6 heeft een onderschoer en op het erf een schuur met uitgebouwde inrijpoort. Eveneens 19de-eeuws is Enterbroekweg 10, een langhuisboerderij met rieten wolfdak en uitgebouwde bovenkamer. Het bedrijfsgedeelte werd in 1914 vernieuwd. Op het erf staat een 19de-eeuwse zeszijdige schaapskooi met rieten schilddak. Bij boerderij Rijssenseweg 64 staat een schaapskooi op bootvormige plattegrond met gemetselde buitenwanden onder steil rieten zadeldak. Overige vermeldenswaardige langhuisboerderijen zijn Odink (Seinenweg 2) uit 1840, en Assink (Rijssenseweg 60) uit 1850. De met riet gedekte krukhuisboerderij Bovenbergweg 5 uit 1848 heeft een bedrijfsgedeelte met inwaarts gelegen niendeur uit 1897. Bij boerderij Bovenbergweg 2 staat een houten schuur uit omstreeks 1820."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00771> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mastenbroek (gemeente Hasselt)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Hasselt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mastenbroek (gemeente Hasselt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Mastenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 771 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0071> ;
        schema:name "Mastenbroek (gemeente Hasselt)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Dorp, ontstaan in de Mastenbroekerpolder bij de kruising van de Kerkwetering en de Oude Wetering. De polder zelf werd in 1364 ingedijkt, waarna omstreeks 1369 een eerste kerk werd gesticht. Hier ontstond een kruiswegdorp met rond de kerk uiteindelijk een kleine verdichting; een echte dorpskom heeft zich echter niet gevormd. De boerderijen in de polder zijn op terpen of pollen gebouwd en liggen voornamelijk langs de noord-zuid lopende weteringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00772> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mastenbroek (gemeente Hasselt)"@nl ;
        min:adres "Kerkwetering 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Hasselt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mastenbroek (gemeente Hasselt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Mastenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 772 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0071> ;
        schema:name "Mastenbroek (gemeente Hasselt)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "De Herv. kerk (Kerkwetering 1), oorspronkelijk gewijd aan O.L. Vrouwe ter Zon, is een eenbeukige laat-gotische kerk met smaller driezijdig gesloten koor en een toren uit 1845. De kerk werd kort vóór 1369 door bisschop Jan van Arkel gesticht. Het huidige koor zou nog uit de 15de eeuw stammen. De bouw is mogelijk in verband te brengen met het niet volkomen duidelijke opschrift dat later rechts naast de ingang is aangebracht. Dat kan gelezen worden als zou de kerk in 1408 zijn afgebrand en in 1428 herbouwd. Na een brand in 1531 is het eenbeukige schip tot stand gekomen. Bij een ingrijpende wijziging in 1646-'48 heeft het waarschijnlijk zijn huidige breedte gekregen. De vorm van de ingang stemt goed overeen met de datering ‘1647’ op de sluitsteen. Ook het opschrift links naast de ingang herinnert aan deze verbouwing en spreekt over een verandering aan de fundering. Naar plannen van architect Ten Holte werd de kerk in 1776 opnieuw verbouwd en daarna in 1818 hersteld. De mogelijk nog 14de-eeuwse kerktoren werd in 1845 vervangen door een neoclassicistische toren. Dit bouwwerk van twee geledingen, met blokvormige lisenen bij de eerste geleding en dorische pilasters bij de tweede, wordt bekroond door een smallere achtzijdige spits. Omstreeks 1890 heeft men aan de noordzijde van de kerk een consistoriekamer toegevoegd. De kerk is in 1980-'81 gerestaureerd, de toren in 1987. De twee door Henrick Wegewaert in 1596 gegoten klokken zijn in 1982 vervangen door nieuwe klokken van Eijsbouts te Asten; de oude hangen nu beneden in de toren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00773> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mastenbroek (gemeente Hasselt)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
