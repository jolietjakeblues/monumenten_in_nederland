        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0030> ;
        schema:name "Denekamp"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De Herv. kerk (Grotestraat 9), een eenbeukig zaalkerkje met driezijdige koorsluiting, heeft een gepleisterd front met geblokte, zandstenen pilasters. Het kerkje werd gebouwd in 1810, maar is in 1840 enigszins verbouwd. De dakruiter dateert uit 1911. De kerk bezit een koperen kaarsenkroon uit de tweede helft van de 17de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

