        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mastenbroek (gemeente Hasselt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Mastenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 773 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0071> ;
        schema:name "Mastenbroek (gemeente Hasselt)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "In het interieur zal het plafond van het schip, met langs de zijmuren smalle banen vlakke zoldering waartussen een gedrukt houten gewelf, dateren van de verbouwing in 1776."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00774> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mastenbroek (gemeente Hasselt)"@nl ;
        min:adres "Kerkwetering 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwartewaterland" ;
        min:gemeenteInBoek "Hasselt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwartewaterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mastenbroek (gemeente Hasselt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Mastenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 774 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill305> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0071> ;
        schema:name "Mastenbroek (gemeente Hasselt)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "218" ;
        schema:pagination "218-219" ;
        schema:text "Het koor, dat oorspronkelijk mogelijk gemetselde gewelven heeft gehad, wordt nu gedekt door een gepleisterd plafond met decoraties die verwijzen naar de verbouwing van 1818. De eikenhouten kansel is midden-17de-eeuws. De kast van het orgel is afkomstig uit de in 1855 afgebrande Herv. kerk van Genemuiden en is rond 1887 in de kerk geplaatst door J. Proper. In de torenruimte worden sinds de restauratie in 1980-'81 fragmenten van een 17de-eeuws eikenhouten koorhek bewaard. De grote vrijstaande pastorie (Kerkwetering 7) in eenvoudige ‘Um 1800’-vormen stamt uit 1912."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00775> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwleusen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Nieuwleusen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwleusen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nieuwleusen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 775 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0072> ;
        schema:name "Nieuwleusen"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Veenranddorp, ontstaan in 1635 onder de naam Oostveen op de woeste gronden van de marke Leusen. Het dorp bestaat uit twee bebouwingskernen. De zuidelijke kern (Kerkenhoek) ontstond rondom de in 1662 gebouwde kerk, de noordelijke (Den Hulst) langs de in 1809-'11 gegraven Dedemsvaart, waar ook de in 1904 opgerichte Union-fietsenfabriek werd gebouwd. Na een eerste ruilverkaveling in 1925-'26, om de ongunstige langgerekte kavels op te heffen, groeiden de kernen vanaf 1960 steeds meer aan elkaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00776> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwleusen"@nl ;
        min:adres "Dommelerdijk 102" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Nieuwleusen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwleusen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nieuwleusen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 776 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill306>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill307> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0072> ;
        schema:name "Nieuwleusen"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "De Herv. kerk (Dommelerdijk 102) is een neoclassicistische zaalkerk met dakruiter, gebouwd in 1829 ter plaatse van een kerk uit 1662. De kerk, waarvan de eerste steen gelegd werd door ds. R.S. van der Gronden, kwam tot stand naar plannen van W. van Emst uit Zwolle. Het op een bakstenen plint geplaatste gebouw heeft een neoclassicistische ingangspartij, dorische hoekpilasters en aan beide zijden twee opvallende ingezwenkte halsgevels. De dakruiter, met daarin een klok uit 1670, zal bij de restauratie van 1950 zijn vervangen door de huidige. De kerk bevat een midden-17de-eeuwse preekstoel met het alliantiewapen van Herman Roelinck en Elisabeth Mechteld Ripperda, bewoners van het omstreeks 1849 gesloopte huis Vechterweerd bij Dalfsen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00777> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwleusen – Overige kerken"@nl ;
        min:adres "Burg. Backxlaan 269",
            "Meeleweg 37",
            "Westeinde 11",
            "Westeinde 36" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Nieuwleusen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwleusen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Nieuwleusen" ;
        min:lemma "Overige kerken" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 777 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0072> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Overige kerken. De voorm. Geref. kerk (synodaal) (Westeinde 11) is een uit 1869 stammende zaalkerk, nu in gebruik als garage. De Geref. Scholtenkerk (Oud Geref. Gemeente) (Westeinde 36) is een kort na de afscheiding in 1869 ontstane sobere zaalkerk gebouwd op een gepleisterde plint. In het buurtschap De Meele staat het uit 1921 daterende Herv. kerkgebouw Rehoboth (Meeleweg 37), een lange zaalkerk met dakruiter en driezijdig gesloten ingangspartij. De Geref. kerk (Burg. Backxlaan 269) is een kruiskerk uit 1939. Ze werd mogelijk ontworpen door B.T. Boeyinga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00778> a min:Passage,
