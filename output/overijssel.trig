        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0067> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "Woonhuizen. Het grote herenhuis Eikenoord (Dedemsvaartseweg Noord 46) bestaat uit een drielaags risalerend middendeel met een flauw hellend zadeldak, geflankeerd door lagere zijdelen onder een lessenaarsdak. Dit huis met veranda onder balkon voor dokter Pieck werd omstreeks 1870 in neoclassicistische vormen gebouwd en mogelijk omstreeks 1910 verbouwd. De directeurswoning van de aardappelmeelfabriek De Baanbreker Dedemsvaartseweg Noord 50 kwam omstreeks 1905 tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00754> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lutten (gemeente Hardenberg) – Boerderijen"@nl ;
