        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Haaksbergen" ;
        min:gemeenteInBoek "Haaksbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaksbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaksbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Haaksbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75396>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75397> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507736",
            "507737" ;
        min:soort "inleiding" ;
        min:volgnummer 547 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0045> ;
        schema:name "Haaksbergen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De R.K. St.-Bonifacius en Gezellenkerk (Veldmaterstraat bij 61) is een uit 1933-'34 daterende pseudo-basilicale kruiskerk met smaller, recht gesloten koor en een rechthoekige toren met dwars geplaatst zadeldak. Het in de trant van de Delftse School uitgevoerde gebouw is ontworpen door Joh.H. Sluijmer, die zich liet inspireren door de Friese romano-gotische dorpskerken. Het geheel in schoon metselwerk uitgevoerde interieur wordt overdekt door kruisgewelven op ronde zuilen. De aangebouwde pastorie (Veldmaterstraat 61) is ook door Sluijmer ontworpen. De R.K. kerk O.L. Vrouwe van Lourdes (Sonderenstraat 15) is een basilicale kerk uit 1956-'58 in de trant van de Delftse School naar ontwerp van F. van Beers. De kerk is door een gang verbonden met de gelijktijdig gebouwde pastorie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0045.php> .

