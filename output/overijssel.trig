        schema:name "Almelo"@nl ;
        schema:pageEnd "53" ;
        schema:pageStart "53" ;
        schema:pagination "53" ;
        schema:text "De R.K. St.-Jozefkerk (St.-Josephstraat 111) is een basilicale kerk met driezijdig gesloten koor en een narthex aan de voorzijde. Ze verrees in 1952-'53 naar ontwerp van A. Vosman. Het voorm. R.K. ziekenhuis St. Elisabeth (Hofkampstraat 52-78) is een fors gebouwencomplex, bestaande uit een ziekenhuis met kapel en het rusthuis ‘Canisius’. De drie in 1926 naar ontwerp van Th.J. van Elsberg en J. Stuyt vrijstaand opgetrokken gebouwen zijn in de jaren vijftig onderling verbonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00194> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo – Raadhuizen"@nl ;
        min:adres "De Waag 1",
            "De Waag 5",
            "Grotestraat 100",
            "Marktstraat 3-7",
            "Wierdensestraat 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Almelo" ;
        min:gemeenteInBoek "Almelo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Almelo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almelo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
