        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ommen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Ommen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 837 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0079> ;
        schema:name "Ommen"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De R.K. St.-Birgittakerk (Nering Bögelstraat 1A) is een driebeukige pseudobasiliek met gereduceerd dwarsschip en forse gedrongen toren geflankeerd door kapellen. De kerk werd in 1938-'39 gebouwd naar plannen van Joh. H. Sluijmer uit Enschede op de plaats van een kerk uit 1861. Binnen bevinden zich een 15de-eeuws zandstenen doopvont, in 1722 uit de Zuiderzee bij Schokland gevist; ook enkele kaarsenkronen en kandelaars afkomstig uit de in 1859 ontruimde kerk van Schokland zijn in de kerk aanwezig. De pastorie (Nering Bögelstraat 1) stamt eveneens uit 1938-'39."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00838> a min:Passage,
            schema:CreativeWork ;
