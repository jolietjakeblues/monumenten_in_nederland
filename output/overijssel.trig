        schema:name "Vriezenveen"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Het voorm. raadhuis (Westeinde 54) is een tweebeukig dwars pand uit 1905, gebouwd ter vervanging van de door brand verwoeste voorganger. Het raadhuis was oorspronkelijk gecombineerd met de Openbare Lagere School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01002> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vriezenveen – Villa's"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Vriezenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vriezenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vriezenveen" ;
        min:lemma "Villa's" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1002 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0100> ;
        schema:name "Villa's"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Villa's. In Vriezenveen staan enkele monumentale villa's van kooplieden die handel dreven met Rusland, met name Sint-Petersburg; deze ‘Ruslui’ vestigden zich naderhand weer in hun geboortedorp. D.G. Harmsen liet in 1880 de eclectische villa Westeinde 384 bouwen. Het interieur bevat onder meer twee uit Rusland afkomstige betegelde kachels met terracotta hoofdgestel, reliëf en schoorsteenmantel. Naast de villa staat een koetshuis uit de bouwtijd. De blokvormige villa Westeinde 547 dateert uit omstreeks 1905. Ze heeft een grote houten serre en een rijk gedecoreerde voorgevel in late neorenaissancestijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01003> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vriezenveen – Boerderijen"@nl ;
        min:adres "Westeinde 342" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Vriezenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vriezenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vriezenveen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41158> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38154" ;
        min:soort "lemma" ;
        min:volgnummer 1003 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0100> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Boerderijen. Karakteristiek bij de boerderijen in Vriezenveen is het fenomeen dat de boerderijen vaak achter elkaar zijn geplaatst, omdat erfdeling de kavels steeds smaller had gemaakt. Oosteinde 327 is een vrij brede langhuisboerderij met houten voorschot uit omstreeks 1800. De vensters hebben nog hun oorspronkelijke roedenverdeling en middenkalf. Vergelijkbaar zijn de uit de eerste helft van de 19de eeuw daterende langhuisboerderijen: Oosteinde 272, Oosteinde 296 (omstreeks 1850), Oosteinde 323 en De Peddemorsboerderij (Westeinde 342). Uit de tweede helft van die eeuw dateren Oosteinde 260 (1877), Oosteinde 327, Oosteinde 400 (1886), Westeinde 202 en het achter gelegen Westeinde 212. Oosteinde 3-5 is een langhuisboerderij met monumentaal voorhuis, waarschijnlijk gebouwd na de brand van 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

