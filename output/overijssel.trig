        min:kern "Mariënberg" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 760 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0069> ;
        schema:name "Mariënberg (gemeente Hardenberg)"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "Verkeersdorp genoemd naar het hier in 1233 gestichte benedictinesser nonnenklooster Mariënberg dat in 1244 verhuisde naar Zwartewatersklooster bij Zwartsluis. Het klooster Sibculo had vanaf de 15de eeuw een uithof in dit gebied. Kernvorming ontstond pas in 1903-'06 met de aanleg van de spoorlijn Zwolle-Emmen, die bij Mariënberg aansluit op de spoorlijn naar Almelo. Pas na de oorlog is er aan de noordzijde een kleine woonwijk ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00761> a min:Passage,
            schema:CreativeWork ;
