        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zalk (gemeente IJsselmuiden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zalk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57494> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "387540" ;
        min:soort "inleiding" ;
        min:volgnummer 1090 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0112> ;
        schema:name "Zalk (gemeente IJsselmuiden)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Het voorm. Schultehuis (Kerkplein 7) is een dwars huis met hoge begane grond en aan de achterzijde een uitbouw met lessenaarsdak. Het huis stamt mogelijk uit het begin van de 16de eeuw. De kelder is voorzien van een laat-16de-eeuws gewelf en een plavuizen vloer. Het huidige 17de-eeuwse uiterlijk is het resultaat van een restauratie in 1974-'75, toen de 19de-eeuwse bepleistering werd vervangen door gesausde gevels. De voorgevel bevat twee forse, gereconstrueerde, natuurstenen kruiskozijnen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0112.php> .

