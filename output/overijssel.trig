        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0007-01> ;
        schema:name "Albergen (gemeente Tubbergen)"@nl ;
        schema:pageEnd "52" ;
        schema:pageStart "52" ;
        schema:pagination "52" ;
        schema:text "Dorp, ontstaan in de eerste helft van de 20ste eeuw bij de katholieke kerk ter plaatse van het voormalige, omstreeks 1400 gestichte klooster St. Antonius. Het klooster lag iets noordelijker dan de huidige kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00181> a min:Passage,
