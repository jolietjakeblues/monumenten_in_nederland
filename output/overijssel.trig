        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ommen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Ommen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 838 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0079> ;
        schema:name "Ommen"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Het voorm. raadhuis (Brugstraat 1) is een breed tweelaags pand met dakruiter, gebouwd in 1828 naar plannen van J.F. Creutzberg. Het verving de uit 1531-'32 stammende en in 1758 verbouwde voorganger. Het pand heeft een omlijste ingangspartij met ionische pilasters en deur in empire-stijl. Het bood oorspronkelijk ook plaats aan het kantongerecht en de woning van de brugmeester. In 1925 vond een ingrijpende verbouwing plaats en in 1954-'55 kreeg het een moderne uitbreiding. Sinds 1982 doet het niet meer dienst als raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00839> a min:Passage,
