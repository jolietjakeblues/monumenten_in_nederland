        schema:pageStart "132" ;
        schema:pagination "132-133" ;
        schema:text "Eese is afgeleid van Ehze - wat ‘een gebied met bosschages, struiken en bomen’ betekent. De Eese vormt samen met De Woldberg en De Bult een hoger gelegen bosrijk gebied ten noorden van Steenwijk. Tussen 1141 en 1263 lag hier een nederzetting en in 1340 is er sprake van een heer van Eese. In de 15de eeuw werd het tot heerlijkheid verheven en kreeg het een eigen schoutambt. In 1622 volgde de officiële opheffing, maar tot 1795 ging men door met het rechtspreken. Tussen 1923 en 1942 was het landgoed in het bezit van Jhr. Mr. Dr. H.A. van Karnebeek. Het wegdorp Eesveen, ten westen van De Eese, is ontstaan op de woeste gronden van de heer van Eese, waar in 1340 voor het eerst van turfwinning sprake was. Na de vervening werd het vanaf 1830 een gebied met gemengde landbouwbedrijven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00460> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eese en Eesveen (gemeente Steenwijk)"@nl ;
        min:adres "Van Karnebeeklaan 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eese en Eesveen (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Eese en Eesveen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 460 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0035> ;
        schema:name "Eese en Eesveen (gemeente Steenwijk)"@nl ;
        schema:pageEnd "133" ;
        schema:pageStart "133" ;
        schema:pagination "133" ;
        schema:text "Het Huis De Eese (Van Karnebeeklaan 2) is een in oorsprong adellijk huis op een omgracht terrein. Het huidige eenlaags huis met schilddak en kleine dakruiter werd gebouwd na het afbranden van het oude slot. Volgens de datering boven de eenvoudige zandstenen deuromlijsting stamt het uit 1619, maar het is ingrijpend veranderd door latere verbouwingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00461> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eese en Eesveen (gemeente Steenwijk) – Landhuis De Hermanshoeve"@nl ;
        min:adres "Eese 7" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eese en Eesveen (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Eese en Eesveen" ;
        min:lemma "Landhuis De Hermanshoeve" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 461 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill176> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0035> ;
        schema:name "Landhuis De Hermanshoeve"@nl ;
        schema:pageEnd "133" ;
        schema:pageStart "133" ;
        schema:pagination "133" ;
        schema:text "Landhuis De Hermanshoeve (Eese 7), ten noordwesten van het Huis De Eese, werd in 1917 gebouwd in opdracht van M. Onnes van Nijenrode. Op een fundament van veldkeien verrees een houten huis in blokhuisbouw, opgebouwd uit op de hoeken overstekende en door zwaluwstaarten verbonden balken. Het geheel werd als bouwpakket in Scandinavië vervaardigd. Ook de rentmeesterswoning Van Karnebeeklaan 5, en het koetshuis annex paardenstal Van Karnebeeklaan 7, zijn op een zelfde wijze gebouwd. De achter het laatstgenoemde gebouw gelegen, grote dubbele landbouwschuur stamt uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00462> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eese en Eesveen (gemeente Steenwijk) – Provinciegrenspalen"@nl ;
