        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Denekamp" ;
        min:lemma "Windmolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23614> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "12338" ;
        min:soort "lemma" ;
        min:volgnummer 385 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0030> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "Windmolens. De Borgelinkmolen (Lattropperstraat 25), een oorspronkelijk in 1818 door Lambert Brandehof gebouwde stellingkorenmolen, werd na een brand in 1846 herbouwd als korenen pelmolen en in 1909 voorzien van een benzinemotor. Na de onttakeling in 1927 resteert de molenromp. De St.-Nicolaasmolen (Ootmarsumsestraat 28) is een achtkante grondzeiler uit 1859, gelegen op een lage belt. In 1866 kreeg de molen een nieuwe bovenas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0030.php> .

