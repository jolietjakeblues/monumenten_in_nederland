        min:volgnummer 1066 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill406> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0110> ;
        schema:name "Wilsum (gemeente IJsselmuiden)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "277" ;
        schema:pagination "277-278" ;
        schema:text "Via de naast de kerk gelegen Veerweg leidde een voetveer naar de gedeeltelijk tot Wilsum behorende Onderdijkse polder. In de 19de eeuw kwam een beperkte dorpsuitbreiding en bebouwingsverdichting tot stand, met name langs de Dorpsweg. Ten noorden hiervan werd na de Tweede Wereldoorlog enige nieuwbouw gepleegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01067> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wilsum (gemeente IJsselmuiden)"@nl ;
        min:adres "Dorpsweg 13" ;
