        min:adres "Gronausestraat 1200" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Enschede" ;
        min:gemeenteInBoek "Enschede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enschede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Glanerbrug (gemeente Enschede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Glanerbrug" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 521 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0042> ;
        schema:name "Glanerbrug (gemeente Enschede)"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "De Herv. kerk (Gronausestraat 1200) is een rechtgesloten hallenkerk met slanke toren van twee geledingen met zadeldak en wijzerplaten. De kerk werd in 1905-'06 gebouwd naar plannen van H. Reijgers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00522> a min:Passage,
