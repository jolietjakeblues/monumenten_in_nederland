        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0083> ;
        schema:name "Overdinkel (gemeente Losser)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Dorp, ontstaan omstreeks 1900 als lintbebouwing langs de weg van Losser naar Gronau (nu Hoofdstraat). Hier verrezen woningen voor de arbeiders die in de Gronause textielfabrieken werkten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00872> a min:Passage,
