        min:gemeenteInBoek "Oldenzaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldenzaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldenzaal" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Oldenzaal" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 814 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0077> ;
        schema:name "Oldenzaal"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "De Herv. kerk (Ganzenmarkt 9) [3] is een forse zaalkerk met lagere dwarsvleugel (consistoriekamer) en in de binnenhoek een ongelede toren met vierzijdige spits. De kerk verrees in 1934 in expressionistische stijl naar ontwerp van A.J.A. Winters ter vervanging van een kerk uit 1810. Bij de kerk staan vernieuwde hekpijlers met zandstenen dekplaten en empire-siervazen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00815> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldenzaal"@nl ;
        min:adres "Molenstraat 25",
            "Prins Bernhardstraat 17" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
