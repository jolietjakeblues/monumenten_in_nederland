        min:soort "inleiding" ;
        min:volgnummer 1034 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0105> ;
        schema:name "Wesepe (gemeente Olst)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De voorm. openbare lagere school (E. Kreikenlaan 2) is een L-vormige school met eclectische details, gebouwd in 1855. In 1953 werd ze als brandweergarage in gebruik genomen en nu is er een fietsenzaak in gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01035> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wesepe (gemeente Olst) – Woonhuizen"@nl ;
        min:adres "Boxbergerweg 2",
            "Raalterweg 41",
            "Roozenvoorderdijk 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Olst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wesepe (gemeente Olst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wesepe" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67346>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67347>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67348>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67349> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "523357",
            "523358",
            "523422",
            "523423" ;
        min:soort "lemma" ;
        min:volgnummer 1035 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill397> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0105> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text """Woonhuizen. Het woonhuis annex maalderij Raalterweg 65, kwam omstreeks 1880 tot stand. In de bosrijke omgeving ten westen van Wesepe liggen enkele grotere villa's, waaronder de uit circa 1890 stammende neoclassicistische burgemeesterswoning Huize Zorgvlied (Boxbergerweg 2). Naar plannen van E.A. Mensink zijn de beide uit omstreeks 1925 stammende villa's De Lankhorsterkamp (Roozenvoorderdijk 1) voor M. van Doorninck en M. van Doornincksweg 23. Beide zijn uitgevoerd in een plastisch, maar sober vormgegeven expresionisme.

Het voorm. station Wesepe (Raalterweg 41) is een langgerekt gebouw met aan beide zijden een lagere aanbouw, gebouwd in 1909 voor de Overijsselsche Lokaalspoorweg-Maatschappij Deventer-Ommen. Aan de voormalige spoorzijde hangt nog een tegeltableau met stationsnaam. Na 1934 is het als woonhuis in gebruik genomen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01036> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wesepe (gemeente Olst) – Zoenkruis"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
