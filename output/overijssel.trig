        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0068> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "Boerderijen. Achterlandseweg 9 is een 19de-eeuws langhuisboerderijtje. De dwarshuisboerderij Lowkeboer (Almeloseweg 181) uit 1923 werd gebouwd voor H.J. Lenferink naar ontwerp van J. Wiegers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00760> a min:Passage,
