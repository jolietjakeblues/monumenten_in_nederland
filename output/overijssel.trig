        schema:name "Windmolen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Windmolen ‘Houdt Braef Stant’ (IJsseldijk 65) is een achtkante, met riet gedekte stellingkorenmolen op bakstenen onderstuk en bakstenen voet, gebouwd in 1856 en in 1866 voorzien van een nieuwe bovenas. Hij is gerestaureerd in 1963."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01031> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wesepe (gemeente Olst)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
