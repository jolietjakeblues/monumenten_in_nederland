        min:gemeente "Losser" ;
        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overdinkel (gemeente Losser)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Overdinkel" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38623>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54864> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "26282",
            "26289" ;
        min:soort "lemma" ;
        min:volgnummer 874 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0083> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Boerderijen. Rond het dorp liggen enkele waardevolle boerderijen. Erve Beernink (Beerninksweg 1) is een driebeukige boerderij, waarvan het bedrijfsgedeelte in vakwerk en met onderschoer is uitgevoerd; op de gesneden consoles van het houten voorschot staat het jaartal ‘1644’. Het woongedeelte is omstreeks 1925 vernieuwd. Op het Erve Ter Denge (Glanestraat 7) staat een in vakwerk opgetrokken tweebeukige schaapskooi uit 1778 en een driebeukige schuur uit 1780. De voorm. boerderij Ellermanswöner (Hoofdstraat 1) is een tweebeukige boerderij annex herberg. In de 19de eeuw diende het pand als tolhuis bij de brug over de Dinkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00875> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overdinkel (gemeente Losser) – Grensstenen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Losser" ;
        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overdinkel (gemeente Losser)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Overdinkel" ;
        min:lemma "Grensstenen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 875 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0083> ;
        schema:name "Grensstenen"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Grensstenen. De Drielandsteen (Drielandweg ong.) staat op het punt waar Nederland, Niedersachsen en Nordrhein-Westfalen samenkomen. Het is een in Bentheimer zandsteen uitgevoerde driehoekige paal (nr. 1) uit 1659 met de wapens van het graafschap Bentheim, de provincie Overijssel en bisschop Bernard van Galen, vorst-bisschop van Munster. De ingehakte hoofdletter H van Hannover werd in 1824 ingehakt. Ook uit 1659 stamt de zwaar beschadigde zandstenen grenspaal (nr. 3) aan de Beerninksweg met het wapen van Overijssel. Nabij Tiekenveenweg 4 staat een zandstenen grenspaal met het nummer 80 (855) uit 1773."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00876> a min:Passage,
