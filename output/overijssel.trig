        schema:name "Diepenheim"@nl ;
        schema:pageEnd "126" ;
        schema:pageStart "126" ;
        schema:pagination "126" ;
        schema:text "De pastorie (Grotestraat 3) is een dwars pand in neoclassicistische stijl uit 1871. Op het voorm. kerkhof liggen de graven van de familie Schimmelpenninck van 't Nijenhuis, waaronder dat van G. Schimmelpenninck (†1860) en R. Schimmelpenninck (†1871)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00439> a min:Passage,
