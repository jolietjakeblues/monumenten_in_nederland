        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0080> ;
        schema:name "Ootmarsum"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het klooster Maria ad Fontes (Oostwal 24) [3] is een omvangrijk, uit drie haaks geplaatste vleugels bestaand, kloostercomplex in expressionistische trant, gebouwd in 1935-'38 voor de congregatie van O.L.V. van Amersfoort. Een van de vleugels bevat op de verdieping de kapel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00852> a min:Passage,
