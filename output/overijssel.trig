        schema:text "Het voorm. postkantoor (Westwal 1) [5] is een blokvormig pand in eclectische vormen, gebouwd in 1880 naar plannen van J.H. Vos uit Almelo."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00854> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ootmarsum – Woonhuizen"@nl ;
        min:adres "Kloosterstraat 1",
            "Marktstraat 3",
            "Walstraat 1" ;
