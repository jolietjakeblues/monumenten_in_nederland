        min:volgnummer 265 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0017> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Boerderijen. Ten westen van Enschede, in het westen van de vroegere marke Usselo en de marke Twekkelo staan interessante, vaak nog 18de-eeuwse, Twentse hallenhuisboerderijen met middenlangsdeel onder zadeldak en houten geveltoppen. Op het erve de Haimer (Haimersweg 225) staat een mogelijk 17de-eeuwse vakwerkschuur die gebruikt is als doopsgezinde schuurkerk. De Horste (Burg. Stroinkstraat 341) is een boerderij met bovenkamer uit 1778. Zwerinkhoek (Zweringhoekweg 45) uit 1792 heeft een bovenkamer, een aangebouwde grote schuur en een vrijstaande schuur. Wullenweg 101 is een in aanleg uit 1793 stammende vakwerkboerderij, volgens opschrift verbouwd in 1820. Uit dezelfde tijd zal de vakwerkboerderij Menzo (Belderhoeksweg 250) stammen. De Kwinkeler (Kwinkelerweg 18-20) is een van 1795 daterende en in 1855 verbouwde boerderij die in 1924 van een nieuw toegangshek is voorzien. Het Eulderink (Eulderinkweg 22) is een boerderij met een gave bovenkamer, gedateerd 1801. Het Tijberend (Rosinkweg 40) stamt uit 1858. De Heller (Hellerweg 5) is een boerderij uit 1886 met een vermoedelijk nog 18de-eeuwse bakspieker in vakwerkbouw. De boerderij Burg. Stroinkstraat 320 werd in 1908 gebouwd voor J.K. Schukkert en de forse boerderij het Helmer (Helmerstraat 201) verrees in 1930 naar plannen van J. Jans voor E. Menko."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00266> a min:Passage,
            schema:CreativeWork ;
