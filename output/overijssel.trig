        schema:name "Windmolen"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "Windmolen de ‘Lonnekermolen’ (Lonneker Molenweg bij 81), ook ‘Demmersmolen’ genoemd, is een ronde bakstenen beltkorenmolen, gebouwd in 1851 in opdracht van B.W. Blijdenstein. De molen is in 1964 en 1995 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0065.php> .

