        min:soort "lemma" ;
        min:volgnummer 446 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0033> ;
        schema:name "Peckedam"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "129" ;
        schema:pagination "129-130" ;
        schema:text "Peckedam (Goorseweg 30), gelegen ten noordoosten van Diepenheim, is een buitenplaats met een villa in cottage-stijl, gebouwd in 1898 voor mevrouw H.F.W.E. van Hogendorp-Schimmelpenninck naar ontwerp van J. van de Goot en C.J. Kruisweg. Rond het L-vormige huis met aangebouwd koetshuis ligt een landschappelijke aanleg met exoten, waarschijnlijk aangelegd door de tuinarchitect H. Poortman, die hier van 1916 tot 1953 ook woonde. Ten noordoosten van het huis bevinden zich restanten van de grachten van een in 1826 gesloopte, gelijknamige havezate."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00447> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diepenveen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
