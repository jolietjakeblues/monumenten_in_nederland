        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schalkhaar (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Schalkhaar" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 914 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0090> ;
        schema:name "Schalkhaar (gemeente Diepenveen)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "De R.K. St.-Nicolaaskerk (Lindeboomsweg 34) is een forse driebeukige pseudobasiliek met kleine doopkapel, hoger opgaande viering en lager dwarsschip, driezijdig gesloten koor en een toren van drie geledingen met slanke ingesnoerde spits. Deze neogotische kerk werd grotendeels in 1894-'95 gebouwd naar plannen van G. te Riele en is in opbouw vrijwel identiek aan diens iets oudere kerk te Lettele. In 1933 kwamen het huidige dwarsschip en koor tot stand naar plannen van Jac. Haket uit Deventer. In 1990 werd een vredeskapel toegevoegd. De kerk heeft gebrandschilderde ramen van H. Levigne waarop de acht zaligheden staan afgebeeld. De kerk bevat een beeldje uit omstreeks 1400 van de O.L. Vrouwe van Frieswijk (herontdekt in 1922). Aan de oostzijde van de kerk bevindt zich een uit omstreeks 1933 daterend H. Hartbeeld, waarachter het kerkhof ligt, met een baarhuis en een calvariegroep in een eveneens uit omstreeks 1933 stammende overhuiving. Voor de calvariegroep ligt een aantal priestergraven. De pastorie (Lindeboomsweg 32) dateert van 1933."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00915> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schalkhaar (gemeente Diepenveen)"@nl ;
        min:adres "Pastoorsdijk 1a" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
