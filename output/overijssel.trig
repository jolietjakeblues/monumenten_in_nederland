        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 588 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0047> ;
        schema:name "Zeewering"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Zeewering (Stenendijk). Een historische stenen zeewering ter lengte van ruim 1100 meter sluit aan op de zuidwestzijde van de stad. De wering wordt in 1558 voor het eerst genoemd. De in 1982 gerenoveerde muur bestaat uit vele stukken divers metselwerk, omdat het onderhoud over diverse ingelanden was verdeeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00589> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeten (gemeente Raalte)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Raalte" ;
        min:gemeenteInBoek "Raalte" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Raalte_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heeten (gemeente Raalte)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Heeten" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 589 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0048> ;
        schema:name "Heeten (gemeente Raalte)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Esdorp, voor het eerst genoemd in 1300. De naam is afgeleid van het woord heide. Op het aan de noordrand van het dorp gelegen erve Nijenhof stond tot 1749 een katholieke schuilkapel. Met medeweten van baron Berend Hendrik Bentinck, heer van Schoonheten, werd in 1791 een eerste kerk gebouwd. In 1812 werd het een katholieke statie en in 1835 volgde een verbouwing van de kerk. Aan het begin van de 20ste eeuw kwam er aan de zuidrand van het dorp een zuivelfabriek. Na de oorlog heeft het dorp zich vooral aan de oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00590> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeten (gemeente Raalte)"@nl ;
        min:adres "Dorpsstraat 16",
            "Koopmansstraat 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Raalte" ;
        min:gemeenteInBoek "Raalte" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Raalte_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heeten (gemeente Raalte)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Heeten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60976> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "32277" ;
        min:soort "inleiding" ;
        min:volgnummer 590 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0048> ;
        schema:name "Heeten (gemeente Raalte)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (Koopmansstraat 6) is een grote, driebeukige neogotische hallenkerk met dwarsschip en driezijdig gesloten koor. De toren telt vier geledingen en heeft een ingesnoerde naaldspits. De kerk werd in 1892 gebouwd naar plannen van A. Tepe, die zich liet inspireren door de Westfaalse gotiek met inwendig wijde intercolumniën tussen de zuilen. In de klokkenverdieping heeft de toren in ieder gevelvlak een brede spitsboogopening geflankeerd door twee smalle nissen. De kerk werd in 1986 gerestaureerd. De preekstoel, die omstreeks 1850 werd vervaardigd, kreeg in 1907 een nieuw klankbord. Het kalkstenen hoogaltaar werd in 1892 gebouwd door F.W. Mengelberg. De huidige tegelvloer werd in 1914 aangebracht. Daarop werden in 1915 een Maria- en een Jozefaltaar geplaatst naar ontwerp van G. van Kalcken, die ook de kruiswegstaties maakte. Na herstel van oorlogsschade werden in 1948 nieuwe gebrandschilderde ramen aangebracht naar ontwerp van Kocken. De grote pastorie (Dorpsstraat 16) stamt uit de bouwtijd van de kerk. Op het in 1892 gestichte kerkhof staat een kapel met ruitdak uit 1913."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0048.php> .

