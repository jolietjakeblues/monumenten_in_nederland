        min:soort "inleiding" ;
        min:volgnummer 1094 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0113> ;
        schema:name "Zenderen (gemeente Borne)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Esnederzetting, ontstaan rond de Zenderense es. Bij de in 1798 gestichte en in 1950 verdwenen R.K. kerk van het buurtschap ontstond in de 20ste eeuw een dorpskern. In de loop van de tijd verrezen aan de oostzijde van het dorp diverse kloostergebouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01095> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zenderen (gemeente Borne)"@nl ;
        min:adres "Hertmerweg 42-42a",
            "Hertmerweg 44",
            "Hertmerweg 46" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zenderen (gemeente Borne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zenderen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1095 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0113> ;
        schema:name "Zenderen (gemeente Borne)"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "280" ;
        schema:pagination "280-281" ;
        schema:text "Het karmelietenklooster (Hertmerweg 44) is in 1855 gesticht op het terrein van de buitenplaats Hulscher. Het huidige neogotische klooster, bestaande uit vier vleugels rondom een binnenplaats, werd in 1881 gebouwd door de Zenderse aannemer A. Peters. De oostvleugel wordt ingenomen door de neogotische pseudo-basilicale R.K. St.-Stephanuskerk (Hertmerweg 46) met driezijdig gesloten koor. Deze kerk is de opvolger van de 19de-eeuwse kloosterkerk. Ten oosten van de kerk verrees in 1889 in opdracht van de karmelieten het voorm. gymnasium St. Alberti (Hertmerweg 42-42a), dat na ingrijpende verbouwingen aan het eind van de jaren dertig en in de jaren vijftig zijn huidige vorm kreeg. Het is een drielaags gebouw op U-vormige plattegrond en heeft op de zuidhoek de ingangspartij met halfrond glazen trappenhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01096> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zenderen (gemeente Borne)"@nl ;
        min:adres "Carmelitessenweg 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
