            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76678> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "31501",
            "31505" ;
        min:soort "lemma" ;
        min:volgnummer 980 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0098> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "262" ;
        schema:pageStart "262" ;
        schema:pagination "262" ;
        schema:text "Boerderijen. Op het landgoed staat een aantal hallenhuisboerderijen, met middenlangsdeel en aan de achterzijde veelal een onderschoer. Groothof (Vilsterseweg 15) heeft aan de achterzijde de jaartalankers ‘1786’ en werd in 1888 verbouwd. Kampman (Vilsterseweg 33) is in jaartalankers op 1779 gedateerd. 't Butink (Vilsterseweg 24) werd in 1855 vernieuwd en Borrink (Vilsterse Allee 1) is gedateerd op 1867."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00981> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vilsteren (gemeente Ommen) – Windmolen"@nl ;
