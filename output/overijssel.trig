        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tubbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Tubbergen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 964 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill373> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0096> ;
        schema:name "Tubbergen"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Dorp, ontstaan als kernesdorp aan de oostzijde van de Tubberger Es. De nederzetting kwam waarschijnlijk tot ontwikkeling bij het in het begin van de 14de eeuw genoemde Hof te Tubbergen, waaruit de havezate Eschede of Eeshof ontstond. Een in 1336 reeds bestaande kapel werd in 1576 tot zelfstandige parochiekerk verheven. Het dorp had een centrumfunctie voor de omgeving. Na de Tweede Wereldoorlog is het op beperkte schaal uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0096.php> .

