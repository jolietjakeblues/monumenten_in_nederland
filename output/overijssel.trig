        rdfs:label "Lemelerveld (gemeente Dalfsen) – Woonhuizen"@nl ;
        min:adres "Blikman Kikkertweg 3",
            "Blikman Kikkertweg 6-6A" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemelerveld (gemeente Dalfsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lemelerveld" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 728 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0063> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "211" ;
        schema:pagination "211-212" ;
        schema:text """Woonhuizen. Het huis Blikman Kikkertweg 7 werd in 1854 gebouwd in opdracht van M. Kingma. De villa Klein Statum (Blikman Kikkertweg 3) verrees omstreeks 1900. Ze was de woning van J.R. Kampff, directeur van de suikerfabriek.

Van de beetwortelsuikerfabriek (Blikman Kikkertweg 6-6A), opgericht in 1865 en gesloten in 1919, is de grote fabriekshal bewaard gebleven. In die hal vestigde de heer Koetsier in 1920 een ijzerconstructiewerkplaats."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00729> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lettele (gemeente Diepenveen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lettele (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lettele" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 729 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0064> ;
        schema:name "Lettele (gemeente Diepenveen)"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "Esdorp ontstaan in 1819 toen er bij de boerderij Groot Koerkamp een katholieke kapel werd gebouwd. In 1855 werd Lettele een zelfstandige parochie en in 1893-'94 volgde de bouw van een nieuwe kerk. Pas na de oorlog is er sprake van enige dorpsvorming."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00730> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lettele (gemeente Diepenveen)"@nl ;
        min:adres "Bathmenseweg 35",
            "Bathmenseweg 37",
            "Oerdijk 186",
            "Oerdijk 188" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lettele (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lettele" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 730 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0064> ;
        schema:name "Lettele (gemeente Diepenveen)"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "De R.K. St.-Nicolaaskerk (Bathmenseweg 37) is een driebeukige neogotische pseudobasiliek met driezijdig gesloten koor, een toren van drie geledingen met slanke ingesnoerde spits en aan de zuidzijde een doopkapel. De kerk werd in 1893-'94 gebouwd naar plannen van G. te Riele. De kerk bezit een huisaltaar uit 1784, gemaakt door Antonius Hekkert. De gebrandschilderde ramen uit 1894 werden vervaardigd door J. Nicolas. De pastorie (Bathmenseweg 35) kwam in 1938 tot stand. De voorm. openbare lagere school (Oerdijk 188) is een drieklassige school uit 1882, met aangebouwde onderwijzerswoning (Oerdijk 186) in neoclassicistische vormen. De huidige naam ‘Schepers’ slaat op de nu erin gevestigde graanhandel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0064.php> .

