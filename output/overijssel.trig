        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30134> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "518249" ;
        min:soort "inleiding" ;
        min:volgnummer 312 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Het voorm. klooster van de zusters van het H. Hart (Oosterstraat 8) is een robuust pand uit 1927, mogelijk naar ontwerp van C.A. Hardeman. Het gebouw heeft rechts op de verdieping een huiskapel. Sinds 1964 dient het als onderkomen voor ouderen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

