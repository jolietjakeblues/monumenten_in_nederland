        min:volgnummer 1203 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0117> ;
        schema:name "Verklaring van enige termen"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "De bouwkundige termen worden in de tekst zoveel mogelijk gebruikt overeenkomstig de gangbare terminologie in de provincie of de regio. In Twente spreekt men bijvoorbeeld over ‘niendeur’, waar dit in Salland en het Land van Vollenhove een ‘baander’ heet."@nl ;
