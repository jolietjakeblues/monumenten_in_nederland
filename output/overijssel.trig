        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Esdorp ontstaan aan de voet van de Lemelerberg en voor het eerst genoemd in 1381. In het gebied vond gemengd bedrijf plaats, met akkerbouw op de esgronden tegen de flank van de Lemelerberg en veeteelt op de groengronden langs de Regge. Het nogal geïsoleerd liggende dorp kreeg in de 18de eeuw een eigen school en vormde in 1863 korte tijd met de noordelijk gelegen buurtschap Archem een eigen gemeente. Door de ontwikkeling van het na 1858 aan het Overijssels Kanaal ontstane, en deels in de gemeente Dalfsen gelegen, Lemelerveld, maakte het dorp Lemele zelf een bescheiden ontwikkeling door."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00721> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemele (gemeente Ommen)"@nl ;
        min:adres "Lemelerweg 72-74" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
