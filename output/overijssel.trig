        min:kern "Blokzijl" ;
        min:lemma "Sluizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 257 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0016> ;
        schema:name "Sluizen"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Sluizen. De als haven in gebruik genomen, oorspronkelijk buitendijks gelegen kolk heeft aan de stadskant een schutsluis met ophaalbrug (Wortelmarkt ong.), die in 1912-'13 zijn huidige vorm kreeg. De aan de noordoostzijde gelegen ophaalbrug uit 1912 is gefundeerd op de oudere sluiskom van de ‘Vollenhoofse Zijl’ uit 1709. Aan de havenmond, richting de voorm. Zuiderzee, ligt een keersluis (bij Noorderkade 28). Van deze keersluis of sas, die enkel bij (extreem) hoge waterstanden werd gesloten, dateren de sluisdeuren uit 1900 en het sluismechaniek uit 1904. De sluiswachterswoning (Noorderkade 28) stamt ook uit die tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00258> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boekelo (gemeente Enschede)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Enschede" ;
        min:gemeenteInBoek "Enschede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enschede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boekelo (gemeente Enschede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Boekelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 258 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0017> ;
        schema:name "Boekelo (gemeente Enschede)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Dorp ontstaan langs de in 1884 geopende spoorlijn Winterswijk-Hengelo en de in 1885 gereedgekomen zijtak naar Enschede. In de directe nabijheid, waar drie beken samen kwamen, stichtte de firma Van Heek & Co. in 1888 een stoomblekerij die in 1895 de N.V. Boekelose Stoombleekerij ging heten. In 1918 werd eveneens aan het spoor de eerste zoutfabriek van de Koninklijke Nederlandse Zoutindustrie opgericht. Deze verhuisde in 1935 naar Twentekanaal bij Hengelo. Ter compensatie legde men ten zuiden van het dorp in 1934 het recreatieoord ‘De Zee op de Heide’ aan, beter bekend als het golfslagbad Bad Boekelo, nu in gebruik als hotel en conferentieoord."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00259> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boekelo (gemeente Enschede)"@nl ;
        min:adres "Boekelosestraat 400" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Enschede" ;
        min:gemeenteInBoek "Enschede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enschede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boekelo (gemeente Enschede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Boekelo" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 259 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill79> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0017> ;
        schema:name "Boekelo (gemeente Enschede)"@nl ;
        schema:pageEnd "66" ;
        schema:pageStart "65" ;
        schema:pagination "65-66" ;
        schema:text "De Boekelose Stoomblekerij (Boekelosestraat 400) werd in 1888 gesticht door de firma Van Heek & Co. als chloorbleek volgens het Malterkiersysteem, waardoor een intensief bleekproces bereikt kon worden. In 1955 ging men over op een continu-bleek. Tevens werden katoenen stoffen bedrukt en veredeld. Dat is de belangrijkste activiteit van de huidige tot Texoprint omgevormde fabriek. Na de bouw in 1888 werd de fabriek in 1890 van een droogkamer voorzien en in 1893 vergroot met onder meer een nieuw ketelhuis. In 1896 werd aan de straatzijde het nog bestaande magazijn van vier verdiepingen in neorenaissance-vormen toegevoegd. In 1897 kwam nabij het spoor het eveneens nog bestaande pakhuis van zeven bouwlagen en een hoektoren met afgeknot tentdak tot stand. Al deze gebouwen ontstonden naar plannen van G. Beltman. In 1904 werd het hoofdgebouw verbouwd naar ontwerp van R. van der Woerd. In de jaren twintig en dertig volgden verdere uitbreidingen, waaronder een laboratorium, een portiershuis en een zorgvuldig vormgegeven brandweergarage in traditionalistische architectuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00260> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boekelo (gemeente Enschede)"@nl ;
        min:adres "Windmolenweg 24-26" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
