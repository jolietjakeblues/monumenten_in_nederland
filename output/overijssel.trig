        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zwartsluis" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55158> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "506346" ;
        min:soort "inleiding" ;
        min:volgnummer 1105 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0114> ;
        schema:name "Zwartsluis"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "De Doopsgez. kerk (Buitenkwartier 34) is een zaalkerk uit 1842. Ze verving een vluchtkerkje uit 1692, dat achter het Klein Lageland stond. Boven de ingang, met neoclassicistische omlijsting, zit een gevelsteen met opschrift. Vanwege de situering tegen de dijk naar Vollenhove is het gebouw onderkelderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01106> a min:Passage,
            schema:CreativeWork ;
