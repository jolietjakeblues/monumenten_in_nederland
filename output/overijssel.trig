        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hellendoorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hellendoorn" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 609 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill239> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0050> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Begraafplaatsen. De Alg. begraafplaats (Hofmanstraat ong.) werd in 1830 gesticht en in 1897 gesloten. Behalve enkele zerken liggen er de grafkelders van de familie Van Marle van de havezate Egede en van de familie Van Heerdt van de havezate Eversberg. De Nieuwe Alg. begraafplaats (Ninaberlaan tussen 34 en 34A) stamt uit 1897, heeft een fraaie aanleg. Hier ligt het graf van de dichteres J.F. van Buren. De Isr. begraafplaats (Ommerweg tegenover 67) is een kleine, omsloten begraafplaats, gesticht in 1868 aan de weg naar Ommen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00610> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hellendoorn – De Eelerberg"@nl ;
        min:adres "Eelerbergweg 1",
            "Eelerbergweg 2",
            "Eelerbergweg 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hellendoorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hellendoorn" ;
        min:lemma "De Eelerberg" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 610 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0050> ;
        schema:name "De Eelerberg"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "172" ;
        schema:pagination "172-173" ;
        schema:text """De Eelerberg (Eelerbergweg 1) is een ten noordwesten van Hellendoorn aan de noordzijde van de Hellendoornse berg gebouwd neoclassicistisch landhuis dat daar in 1865 tot stand kwam in opdracht van de Amsterdamse burgemeester Mr. S.A. Veningh Meinesz. Hij was eigenaar van een ontginningsproject op en rond de Eelerberg en bezat vanaf 1883 de gronden van de voorm. havezate Schuilenburg. Deze 14de-eeuwse havezate aan de Regge, hersteld omstreeks 1675, was in het begin van de 19de eeuw gesloopt. De Eelerberg werd in 1920 verbouwd naar plannen van J.H.W. Leliman en kreeg toen een nieuw ingangsportaal. Inwendig is het pand met name interessant vanwege de vele bewaard gebleven nagelvaste onderdelen met een duidelijke gebruiksfunctie, zoals de diverse kasten, schouw, aanrecht, pomp en houtbak in de keuken, de kasten met schuifdeuren in de opslagkeuken, het doorgeefluik naar de eetkamer dat daar uitmondt in de buffetkast, de oorspronkelijke plee, de drukvatpomp op zolder en een opmerkelijke ruimte die vermoedelijk dienst deed als wasruimte met onder andere wastafels, kleedspiegels en kastjes. De studeerkamer, eetkamer en de zitkamer hebben alle hoge lambriseringen, waarin, in het geval van de eetkamer, de buffetkast is opgenomen. In de zitkamer is in de ronding van de erker een houten bank verwerkt; aan de buitenzijde is hetzelfde gebeurd.

De tuinmanswoning (Eelerbergweg 3) stamt uit 1898, de rentmeesterwoning (Eelerbergweg 2) werd omstreeks 1921 gebouwd in ‘Zwitserse chalet’-vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00611> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hellendoorn – Sanatorium Krönnenzommer"@nl ;
        min:adres "Sanatoriumlaan 10-22" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hellendoorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Hellendoorn" ;
        min:lemma "Sanatorium Krönnenzommer" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 611 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0050> ;
        schema:name "Sanatorium Krönnenzommer"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Sanatorium Krönnenzommer (Sanatoriumlaan 10-22) ligt ten noordwesten van Hellendoorn op een van de hoogste punten van de Hellendoornse berg. Het sanatorium voor tuberculosepatiënten werd in 1902 gebouwd in opdracht van de al in 1897 opgerichte ‘Vereeniging tot Oprichting en Exploitatie van Volkssanatoria voor borstlijders in Nederland’. Het complex werd naar Zwitsers voorbeeld ontworpen door R. Kuijpers en bestaat uit een aantal in chaletstijl uitgevoerde gebouwen, waaronder een hoofdgebouw, dienstwoningen, school annex mortuarium en koshere keuken en slagerij uit de bouwtijd. Het zusterhuis werd in 1917 toegevoegd evenals een dienstwoning en in 1922 een werkplaats. Het complex is momenteel een psychogeriatrische inrichting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0050.php> .

