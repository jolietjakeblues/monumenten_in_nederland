        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0016> ;
        schema:name "Blokzijl (gemeente Brederwiede)"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "64" ;
        schema:pagination "64" ;
        schema:text "De voorm. Doopsgez. vermaning De Zon (Noorderkade 10) is een eenvoudige zaalkerk met puntgevel, gebouwd in 1772 voor de Waterlanders op de plaats van een oudere kerk. Het ontwerp is mogelijk van Gerrit en Jacob J. Mastenbroek. Het gebouw was lange tijd in gebruik bij het in 1835 opgerichte departement van ‘De Maatschappij Tot Nut van 't Algemeen’ en werd daartoe omstreeks 1850 verbouwd. Momenteel is het in gebruik als woonhuis. De pastorie in eclectische vormen (Noorderkade 16) stamt uit 1867."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00250> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blokzijl (gemeente Brederwiede)"@nl ;
        min:adres "Breestraat 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
