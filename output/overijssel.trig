        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79486>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79487> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508566",
            "508567" ;
        min:soort "inleiding" ;
        min:volgnummer 284 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0019> ;
        schema:name "Boskamp (gemeente Olst)"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "De R.K. St.-Willibrorduskerk (Boskamp 23) is een driebeukige neogotische kruiskerk met een lager, driezijdig gesloten koor. De smalle toren heeft twee geledingen die overgaan in een achtkante lantaarn met slanke spits. De kerk werd in 1858-'59 gebouwd naar plannen van H.J. Wennekers op de plaats van de voormalige havezate Boskamp. De kerk is in 1955 gerestaureerd. De kerk bezit een orgel uit omstreeks 1860, gebouwd door C.F.A. Naber. De pastorie (Boskamp 25) stamt uit 1860 en werd omstreeks 1930 verbouwd naar plannen van C.A. Hardeman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00285> a min:Passage,
