        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "Windmolen ‘De Vier Winden’ (Oude Bornsedijk 30) is een uit 1862 daterende achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0086.php> .

