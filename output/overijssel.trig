        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill367>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill368> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Winkels en winkelpuien"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "256" ;
        schema:pagination "256-257" ;
        schema:text "Winkels en winkelpuien. Voorbeelden van woon- en winkelpanden in jugendstil-vormen zijn Kerkstraat 3 (1905-'06) en Kerkstraat 5 (1911), respectievelijk gebouwd naar ontwerp van B. Rouwkema voor de Gebr. Monsieur en H.L. van der Hoef voor apotheker J. Hooysma. Andere interessante winkelpuien zijn te vinden bij Woldpromenade 12 (1909), door de Gebr. Aberson voor kapper H.W. Jonker, Markt 16 (1911), door Voerman en Mol en Onnastraat 27 (1923), door G. Mol."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00954> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijk – Pakhuizen"@nl ;
        min:adres "Gasthuisstraat 28",
            "Steenwijkerdiep 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijk" ;
        min:lemma "Pakhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28744> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "508621" ;
        min:soort "lemma" ;
        min:volgnummer 954 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill369> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Pakhuizen"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text """Pakhuizen. Rondom de markt staan interessante pakhuizen. Woldpromenade 10, nu in gebruik bij het Leger des Heils, werd tussen 1890 en 1900 gebouwd. Belangrijker is Neerwoldstraat 3, een hoog pakhuis van vijf bouwlagen afgesloten door een ‘mansardetuitgevel’. Het werd in 1894 gebouwd naar ontwerp van B. Rouwkema voor de Gebr. Monsieur, die in 1840 in Steenwijk een meubelwerkplaats begonnen. Voor dezelfde opdrachtgever ontwierp Rouwkema in 1895 in eenvoudige neorenaissance-vormen de meubelwerkplaats Weemstraat 5-9. Voor L. Spijkervet ontwierpen H. Aberson & Zn. het in 1904-'05 gebouwde pakhuis annex koetshuis Kalverstraat 11. Het lag achter het grote pand van de opdrachtgever aan de Markt (nr. 24) en had om de hoek eveneens een uitgang (Gasthuisstraat 28).

Van de 17de-eeuwse vestingwerken zijn aan de zuidzijde (Hogewal) drie bastions met omgrachting redelijk goed bewaard gebleven. Aan het eind van de 19de eeuw veranderde men de vestingwerken in een wandelpark. Van het noordelijke deel zijn slechts restanten bewaard gebleven. Daar staat de Jubileumbank (Goeman Borgesiusstraat ong.) [16], in 1940 geplaatst vanwege het 25-jarig ambtsjubileum van burgemeester Goeman Borgesius. Schuin ertegenover staat een straatklok op granito paal uit omstreeks 1950, gemaakt door Bronwasser te Breukelen.

Het Veerhuis (Steenwijkerdiep 2) [17] werd kort na 1632 gebouwd aan de haven van het Steenwijkerdiep net buiten de Woldpoort. In 1860 is het pand ingrijpend verbouwd, gepleisterd en voorzien van een schilddak. De portico met houten zuilen is kort na 1988 aangebracht."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00955> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijk – Industriegebouwen"@nl ;
        min:adres "Neerwoldstraat 11",
            "Parallelweg 2",
            "Steenwijkerdiep 75",
            "Tukseweg 77",
            "Tukseweg naast 77" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijk" ;
        min:lemma "Industriegebouwen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 955 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text """Industriegebouwen. Van de bewaard gebleven industriegebouwen is de houtzagerij van de Vereniging tot bestrijding der bedelarij door werkverschaffing (Steenwijkerdiep 75) [18] het meest interessant. Het uit 1895 daterende, rechthoekige gebouw met bakstenen voet en houten opbouw was - getuige de gevelsteen boven de ingang - een geschenk van S. Tromp Meesters aan de te Willemsoord gevestigde Maatschappij van Weldadigheid. Het verrees naast de inmiddels verdwenen houtzaagmolen van de familie Tromp Meesters en zal gezien zijn langwerpige vorm vanaf het begin door een gas- of elektromotor - of allebei - zijn aangedreven. Sigarenfabriek ‘De Tabaksplant’ (Neerwoldstraat 11) [19] is een langwerpig drielaags gebouw met geknikte gevel, ontworpen in 1898 door B. Rouwkema voor tabakshandelaar en sigarenfabrikant J.S. Rijkmans. Van de in 1934 gebouwde kunstharsfabriek, nu Kornelis Kunststoffen, is het kantoorgebouw (Parallelweg 2) bewaard gebleven. De fabriek is voorgekomen uit de Enlef (Eerste Nederlandse Looiextract Fabriek), die in 1917 werd opgericht als dochteronderneming van de Stoomzagerij J. Wicherson, met directie door L.M.H.C. Schrijver en J. Kornelis. In 1930 stapte men over op het nieuwe product kunsthars. Het kantoorgedeelte van de machinefabriek ‘De Dolder’ (Tukseweg 77) uit 1919-'20 is vormgegeven in eenvoudige late jugendstil-vormen; het is een voorbeeld van het late werk van architect B. Rouwkema.

De Dolderbrug (Tukseweg naast 77) over het Dolderkanaal is een betonnen brug uit 1930; de twee betonnen hijstorens zijn voorzien van stalen katrolhuizen aan hameipoorten."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00956> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijk – Begraafplaatsen"@nl ;
        min:adres "Eestveenseweg bij 15",
            "Meppelerweg 109",
            "Meppelerweg 146" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijk" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 956 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill370> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "257" ;
        schema:pagination "257-258" ;
        schema:text """Begraafplaatsen. De Alg. begraafplaats (Meppelerweg ong.) is aangelegd omstreeks 1830 en later diverse malen uitgebreid. Op de door een ijzeren hek omringde begraafplaats bevinden zich onder andere een rechtopstaande gietijzeren grafsteen van F.C.L. Verster (†1834), het graf van L. Spijkervet (†1925) en de graven van de familie Tromp Meesters, waaronder het graf van beeldhouwer J.F. Tromp Meesters (†1936) met een grafsculptuur van eigen hand. Op het nieuwere gedeelte ligt het graf van J.L. Krop-Cordes (†1922) en wethouder Hendrik Krop (†1938) met beeldhouwwerk van hun zoon Hildo Krop. De Isr. begraafplaats (Eestveenseweg bij 15), al genoemd in 1806, onderging in 1860 een uitbreiding en kreeg in 1875 een metaarhuisje met opschrift naar plannen van G.J. Aberson. Het is gerestaureerd in 1945. De R.K. begraafplaats (Meppelerweg 146) werd aan het eind van de 19de eeuw op de Steenwijkerkamp aangelegd en heeft een baarhuisje uit omstreeks 1890.

De Johan van den Korputkazerne (Meppelerweg 109), gelegen ten westen van Steenwijk, werd in 1938-'40 gebouwd als grensbataljon-kazerne naar plannen van genie-kapitein A. Boost. Het hoofdgebouw heeft een onderdoorgang die leidt naar de binnenplaats waar zich legeringsgebouwen, een keuken annex badhuis en stallen bevinden. In 1985-'88 vond een renovatie plaats."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00957> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijk – Zuidveen"@nl ;
        min:adres "Zuidveenseweg 24" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijk" ;
        min:lemma "Zuidveen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 957 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Zuidveen"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Zuidveen. Dit langgerekte dorp ten zuiden van Steenwijk heeft diverse grote 19de-eeuwse boerderijen, met als belangrijkste de Hoeve Lama (Zuidveenseweg 24) uit 1896. De boerderij heeft een bedrijfsgedeelte met dubbele dwarsdeel en een dwarsgeplaatst woongedeelte met schilddak. De voorgevel bevat metselwerkversieringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00958> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijk – Kallenkote"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijk" ;
        min:lemma "Kallenkote" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 958 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0094> ;
        schema:name "Kallenkote"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Kallenkote. Dit wegdorp ten oosten van Steenwijk wordt voor het eerst genoemd in 1392. Het is een eenrijig wegdorp met over de weg doorgaande kavels. De boerderij met dwarsdeel Kallenkote 25 stamt uit de tweede helft van de 19de eeuw. Aan de zuidoostzijde van het dorp ligt de Alg. begraafplaats (Kallenkote ong.), aangelegd omstreeks 1870 met een fraai neoclassicistisch, T-vormig baarhuisje voorzien van een kleine dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00959> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijkerwold (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijkerwold" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 959 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0095> ;
        schema:name "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Dorp ontstaan door het samengroeien van de kern-esdorpen Kerkbuurt, Gendringen en Thij. In 1401 werd een kerk gesticht op de zandhoogte die pas in de tweede helft van de negentiende eeuw de naam Kerkbuurt kreeg. In 1523 voltrok zich de bestuurlijke afscheiding van Steenwijk. De nederzetting Gelderingen had het slot Croeve als centrum, dat na de Hervorming als schuilplaats diende voor katholieken. Tussen 1685 en 1695 werd de slothof verbouwd tot schuurkerk. In 1830 ontstond op de plaats van het afgebroken slot een eerste katholieke kerk. Vlakbij richtte pastoor Muiteman in 1893 het liefdesgesticht ‘De Voorzienigheid’ op, dat werd gebouwd naar plannen van G. te Riele. Bij het gesticht hoorde sinds 1904 een R.K. kweekschool die in 1984 naar Zwolle werd verplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00960> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        min:adres "Oldemarktseweg 94" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijkerwold (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijkerwold" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17321>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28852> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34606",
            "508645" ;
        min:soort "inleiding" ;
        min:volgnummer 960 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill371>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill372> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0095> ;
        schema:name "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De Herv. kerk (Oldemarktseweg 94), oorspronkelijk gewijd aan St. Andreas, is een eenbeukige, laat-gotische kerk waarvan het koor smaller is dan het schip, een houten geveltorentje en ingesnoerde spits. De kerk is in twee fasen gebouwd: in het begin van de 15de eeuw het koor en vervolgens in het eerste kwart van de 15de eeuw het schip. De consistoriekamer aan de noordzijde stamt uit de 19de eeuw. Inwendig heeft het koor stenen kruisribgewelven. Bij de restauratie in 1958 werden de 19de-eeuwse houten ramen vervangen door gemetselde vensters, met eenvoudige vorktraceringen. De grotendeels nog aanwezige triomfboog is toen in zijn oude spitsboogvorm hersteld en het schip kreeg een nieuwe houten zoldering. De bijzonder rijk gesneden preekstoel dateert uit omstreeks 1700 en bestaat uit een door aartsengel Michaël gedragen kuip met ionische kariatiden en bazuinblazende engelen aan de achterwand tussen kuip en klankbord. Het orgel werd omstreeks 1800 gebouwd door J. Proper. Rondom de kerk staan op het kerkhof een baarhuisje uit omstreeks 1875 en een graf met gebroken zuil van K.A.M.H. Veurman (†1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00961> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        min:adres "Gelderingen 77" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijkerwold (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijkerwold" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 961 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0095> ;
        schema:name "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De R.K. St.-Andreaskerk (Gelderingen 77) is een driebeukige basilicale kerk met een overhoeks geplaatste dakruiter. De lage dwarsschepen gaan aan de oostzijde over in lage dwarsbeuken. De kerk verrees in 1912-'13 op de plaats van een voorganger uit 1830. W. te Riele maakte het ontwerp met neogotische details. Ten westen ligt de omstreeks 1870 gestichte R.K. begraafplaats met losse klokkenstoel. Aan de voet van het door T. Groenestege en A.B. Spitzen in 1880 geschonken kruisbeeld ligt een aantal pastoorsgraven, met daarachter een baarhuisje uit 1904. Verder zijn er diverse fraaie graven van de families Groenestege en Spitzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00962> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        min:adres "Gelderingen 75" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijkerwold (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijkerwold" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 962 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0095> ;
        schema:name "Steenwijkerwold (gemeente Steenwijk)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De voorm. lagere school (Gelderingen 75), sinds de jaren zeventig 't Slothof geheten, werd in 1908 gebouwd als een tweeklassige school met onderwijzerswoning. Ze maakte oorspronkelijk deel uit van het R.K. complex ‘De Voorzienigheid’ en heeft lange tijd dienst gedaan als patronaatsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00963> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenwijkerwold (gemeente Steenwijk) – Tuk"@nl ;
        min:adres "Oldemarktweg 51",
            "Tukseweg 158" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Steenwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenwijkerwold (gemeente Steenwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Steenwijkerwold" ;
        min:lemma "Tuk" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 963 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0095> ;
        schema:name "Tuk"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "258" ;
        schema:pagination "258-259" ;
        schema:text "Tuk. Dit dorp ten oosten van Steenwijkerwold is genoemd naar Tuchem, de Friese naam voor jongvee. Al in de 15de eeuw was er sprake van een kapel. De huidige kern ontwikkelde zich ten noorden van de recent gesloopte zuivelfabriek uit 1911. De neoclassicistische Villa Oostwoud (Tukseweg 158) is in 1873 gebouwd voor de Amsterdamse theater-directeur George André. Van 1890 tot 1972 heeft ze dienst gedaan als gemeentehuis van Steenwijkerwold; sindsdien is de afdeling gemeentewerken van de gemeente Steenwijk er gehuisvest. De architect J. van Ommen heeft in 1922-'23 voor zichzelf het woonhuis Tukseweg 152, met expressionistische details, laten bouwen. Ten westen van het dorp staat de uit 1931 stammende watertoren (Oldemarktweg 51), gebouwd in opdracht van de Waterleidingmaatschappij Noord-Overijssel. De toren heeft een betonnen vlakbodemreservoir en een bakstenen omkleding met licht expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00964> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tubbergen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
