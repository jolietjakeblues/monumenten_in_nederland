        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24371>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51837>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68118>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68119>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68120>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68121>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68122> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "507675",
            "507676",
            "507677",
            "507678",
            "507679",
            "7476",
            "7484" ;
        min:soort "lemma" ;
        min:volgnummer 205 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0008> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text "Begraafplaatsen. Mogelijk nog uit de 18de eeuw dateert de voorm. Oude Isr. begraafplaats (Kerkhofsweg 1), die in 1842 werd gesloten toen bij de voorm. synagoge aan de Boddenstraat de Nieuwe Isr. begraafplaats (Boddenstraat 22) in gebruik werd genomen. Deze is voorzien van een hoge gepleisterde muur met schijnvoegen en sierornamenten. In het Gravenbos ligt de particuliere begraafplaats van de familie van Rechteren Limpurg uit 1875. De 19de-eeuwse R.K. begraafplaats (Kloosterweg 2) bezit een ingang met twee hekpijlers in Bentheimer zandsteen uit de eerste helft van de 18de eeuw. De omgrachte Alg. begraafplaats (Wierdensestraat 140), aangelegd in 1871, kreeg omstreeks 1930 een nieuwe ingangspartij in expressionistische vormen. Het toegangsensemble bestaat uit een hek geflankeerd door een dienstwoning en een werkplaats. Direct achter de ingang staat een achthoekige aula met overstekend rieten tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00206> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Almelo – Boerderijen"@nl ;
        min:adres "Bolkshoeksweg 30",
