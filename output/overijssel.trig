        min:volgnummer 723 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill293> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0062> ;
        schema:name "Lemele (gemeente Ommen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Het landgoed Archem (Jhr. Van der Wijcklaan 2) bestaat uit een landhuis in ‘Um 1800’-stijl, gebouwd in 1925 naar plannen van A. de Maaker, ter vervanging van een 18de-eeuwse spieker. Het huis ligt in een aan de noordzijde door de Regge omsloten park met landschappelijk aanleg ontworpen door L.A. Springer uit 1924. Het koetshuis en de dienstwoning (Draadweg 1) stammen uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00724> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemele (gemeente Ommen)"@nl ;
        min:adres "Kerkweg 32" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemele (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lemele" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 724 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0062> ;
        schema:name "Lemele (gemeente Ommen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Het monument op de Lemelerberg (achter Kerkweg 32) werd in 1913 opgericht door ‘Den Oranjebond van Orde’ in het oostelijker gelegen park 1813, ter herinnering aan het honderdjarig bestaan van het Koninkrijk der Nederlanden. In 1923 werd het park eigendom van de Nederlandse Heidemaatschappij en verhuisde het beeld naar het hoogste punt van de Lemelerberg. Daar plaatste men naar plannen van P.H. Wattez in 1934 een zittende leeuw op bakstenen voet met sokkel. Het monument werd geschonken door jhr. J.H. Siccama van Harkstede."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00725> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemelerveld (gemeente Dalfsen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemelerveld (gemeente Dalfsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lemelerveld" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 725 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill294> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0063> ;
        schema:name "Lemelerveld (gemeente Dalfsen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Veenontginningsdorp, ontstaan in 1854 onder de naam Dalmsholte bij het kanaal van Zwolle naar Almelo, waar dit samenkomt met de zijtak naar Raalte en Deventer (1858). Op dit ‘Deventer Punt’ werd in 1865 door de familie Blikman Kikkert een beetwortelsuikerfabriek opgericht. In 1874 ontstond de zelfstandige R.K. parochie Dalmsholte met kerk en klooster. Het klooster is in 1986 afgebroken. In 1909 werd het station Lemelerveld - nu gesloopt - gebouwd aan de van 1910 tot 1934 functionerende Overijsselse Lokaalspoorweg Deventer-Ommen. Dit spoortracé werd later gebruikt voor de provinciale weg Raalte-Ommen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00726> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemelerveld (gemeente Dalfsen)"@nl ;
        min:adres "Posthoornweg 5",
            "Posthoornweg 6" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemelerveld (gemeente Dalfsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lemelerveld" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 726 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0063> ;
        schema:name "Lemelerveld (gemeente Dalfsen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "De R.K. kerk H. Hart van Jezus (Posthoornweg 5) is een driebeukige neogotische kruiskerk. De toren heeft drie geledingen en een ingesnoerde spits. De kerk werd in 1884 gebouwd naar plannen van A. Tepe en in 1910 door W. te Riele uitgebreid met een hoger dwarsschip. De oostpartij voegde men in 1929 toe naar plannen van C.A. Hardeman. Het atelier van F. Nicolas & Zn maakte de gebrandschilderde ramen. De kruiswegstaties in het interieur zijn afkomstig uit de Nicolaaskerk te Utrecht. De pastorie (Posthoornweg 6) stamt uit omstreeks 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00727> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lemelerveld (gemeente Dalfsen)"@nl ;
        min:adres "Kerkstraat 22" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemelerveld (gemeente Dalfsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Lemelerveld" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 727 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0063> ;
        schema:name "Lemelerveld (gemeente Dalfsen)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "De kerk van de Verenigde Protestantse Gemeente (Kerkstraat 22) dateert uit 1906. De eenvoudige kruiskerk heeft een voorgevel geleed door een vlakke spitsboog en een dakruiter met frontonvormige bekroning en tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00728> a min:Passage,
