        min:hoofdstuk "Steden, dorpen, monumenten › Reutum (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Reutum" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 891 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0086> ;
        schema:name "Reutum (gemeente Tubbergen)"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "De Reutumsebrug (Kanaaldijk ong.) over het kanaal Almelo-Nordhorn, gebouwd in 1887 door D.A. Schretlen & Co., bestaat uit halen met vakwerk op een geschoord hameiportaal. Naast de brug ligt een gekoppelde schutsluis met gemetselde sluiswanden en houten sluisdeuren uit 1887-'88."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0086.php> .

