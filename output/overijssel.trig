        min:volgnummer 302 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0022> ;
        schema:name "Daarle (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Geref. kerk (Dalvoorderweg 12) is een sobere zaalkerk met zadeldak en dakruiter, waarvoor een vlak gedekt ingangsportaal staat, gebouwd in 1933. De pastorie (Dalvoorderweg 10) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00303> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Daarle (gemeente Hellendoorn)"@nl ;
        min:adres "Dalvoorderweg 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Daarle (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Daarle" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 303 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill90> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0022> ;
        schema:name "Daarle (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Herv. kerk (Dalvoorderweg 2) is een pseudobasilikale kerk met ongelede toren en tentdak uit 1955. De kerk werd in sobere traditionalistische vormen gebouwd naar ontwerp van J. Jans."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00304> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Daarle (gemeente Hellendoorn)"@nl ;
        min:adres "Watertorenweg bij 15" ;
