        schema:pageStart "95" ;
        schema:pagination "95" ;
        schema:text "Dorp, ontstaan als hoevenzwermnederzetting. Bij een uit 1830 gestichte kerk is in de 20ste eeuw een dorpskern tot ontwikkeling gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0031.php> .

