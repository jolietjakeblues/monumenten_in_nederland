        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill410> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0112> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Windmolen ‘De Valk’ (Brinkweg 11) is een achtkante, met riet gedekte stellingkorenmolen op houten onderstuk en bakstenen voet, gebouwd in 1860. In 1982 is de molen weer bedrijfsklaar gemaakt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01093> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zalk (gemeente IJsselmuiden) – 's-Heerenbroek"@nl ;
        min:adres "Bisschopswetering 53",
            "Bisschopwetering 55" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Kampen" ;
        min:gemeenteInBoek "IJsselmuiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kampen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zalk (gemeente IJsselmuiden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zalk" ;
        min:lemma "'s-Heerenbroek" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1093 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0112> ;
        schema:name "'s-Heerenbroek"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "'s-Heerenbroek. Dit streekdorp ten noorden van Zalk, aan de overzijde van de IJssel, ligt langs de Bisschopswetering. Het wordt voor het eerst omstreeks 1365 genoemd. Het behoorde tot de in 1967 opgeheven gemeente Zwollerkerspel. Nadien is het aan het dorp Veecaten vastgegroeid. De voorm. coöperatieve zuivelfabriek 's-Heerenbroek (Bisschopwetering 55) verrees in 1914 naar plannen van G.B. Broekema. Het in jugendstil-vormen uitgevoerde fabrieksgebouw met schoorsteen werd in 1916 vergroot. Het laad- en losperron dateert uit omstreeks 1930. Na de sluiting in 1979 dient het nu nog deels voor de fabricage van poederproducten. De directeurswoning (Bisschopswetering 53) dateert eveneens van 1914."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01094> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zenderen (gemeente Borne)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Borne" ;
        min:gemeenteInBoek "Borne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borne_(gemeente)> ;
