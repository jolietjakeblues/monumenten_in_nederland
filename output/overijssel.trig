        min:hoofdstuk "Steden, dorpen, monumenten › Deventer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Deventer" ;
        min:lemma "Buitenhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 424 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0032> ;
        schema:name "Buitenhuizen"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "Buitenhuizen. Op de Klinkenberg werd in 1867 de villa De Heuvel (Boxbergerweg 145) gebouwd, naar plannen van M. van Harte voor bierbrouwer B. Cost Budde. Achter de neoclassicistische villa verrees de Davo-bierbrouwerij, die in 1909 werd gekocht door de in 1884 opgerichte Vleeswarenfabriek van Anton Hunink. Na sluiting in 1982 volgde afbraak, waarna men de villa op weinig gevoelige wijze heeft ingebouwd. Op de plaats van een villa uit 1886 verrees in 1917 voor houthandelaar P. Stoffel een nieuwe directeurswoning, Lagestraat 45-45A, onder een hoogopgaand met leien gedekt dak en naar plannen van M. van Harte. Op het voor 1960 tot Diepenveen behorende gebied kwamen er enkele vrijstaande villa's. De villa Molenenk (Laan van Borgele 7) was in 1912 gebouwd voor sigarenfabrikant D. Muller, maar dankt haar huidige vorm aan de verbouwing uit 1932 van M. van Harte voor de wed. Ankersmit-Bessem. De Borgelerhof (Havezatelaan 2) werd in 1913 gebouwd, maar in 1920 door J.D. Postma en B. Hoogstraten verbouwd voor E.A. Muller. De Uiterwaard (Platvoetsdijk 1) stamt uit omstreeks 1935. In cottage-stijl zijn uitgevoerd: De Wigwam (Borgelerhofweg 1) uit 1930, De Crodde (Lokersdijk 7) uit omstreeks 1930 en Lokersdijk 2 (omstreeks 1930)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00425> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deventer – Winkels"@nl ;
        min:adres "Brink 100",
            "Brink 84",
            "Kleine Overstraat 26" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Deventer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
