        schema:name "Daarle (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Esdorp ontstaan in de middeleeuwen op de hogere delen langs de Daarlerbeek, die als Linderbeek in de Regge uitkomt. Door de ontwikkeling van het na 1850 aan het Overijssels Kanaal ontstane Daarlerveen, maakte het dorp Daarle zelf een bescheiden ontwikkeling door."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0022.php> .

