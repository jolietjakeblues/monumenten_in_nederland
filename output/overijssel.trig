        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0022> ;
        schema:name "Daarle (gemeente Hellendoorn)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Watertoren (Watertorenweg bij 15) is een in 1934 gebouwde toren naar ontwerp van Dücker & Co. uit Duisburg. Het betonnen vlakbodemreservoir heeft een bakstenen omkleding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00305> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Daarle (gemeente Hellendoorn) – Daarlerveen"@nl ;
        min:adres "Kerkstraat 1",
            "Kerkstraat 19" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hellendoorn" ;
        min:gemeenteInBoek "Hellendoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellendoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Daarle (gemeente Hellendoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Daarle" ;
        min:lemma "Daarlerveen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 305 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0022> ;
        schema:name "Daarlerveen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Daarlerveen. Ten oosten van Daarle ligt Daarlerveen, een hoogveenkolonie langs het Overijssels Kanaal ontstaan na 1850. De Herv. kerk (Kerkstraat 19) is een laat-expressionistische houten zaalkerk uit 1937 met een uitgebouwde ingangspartij die overgaat in een bescheiden geveltoren. Voordien vormde het gebied één kerkelijke gemeente met het aan de noordzijde aangrenzende Vroomshoop. De Geref. kerk (Vrijgemaakt) (Kerkstraat 1) is een sobere kruiskerk met dakruiter gebouwd in 1936. Voor de kerk staat een straatklok op betonnen voet uit omstreeks 1950."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00306> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 306 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill91> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "73" ;
        schema:pagination "73-74" ;
        schema:text "Kernesdorp, ontstaan op de Sallandse zandgronden bij een doorwaadbare plek in de Vecht. De nederzetting wordt voor het eerst genoemd in 1231, maar stamt mogelijk al uit de 12de eeuw. Door de gunstige ligging ontwikkelde het zich tot een welvarend dorp dat in 1670 door brand werd verwoest. Op de hogere esgronden in de omgeving vond veel roggebouw plaats. De voor de verwerking daarvan benodigde molens stonden te Dalfsen; aan het eind van de 19de eeuw waren dat er elf. Het oudste industriële bedrijf, Frijling's Banket, waar sinds 1784 ‘Dalfser Moppen’ worden vervaardigd, had ook met de roggebouw van doen. Aan het eind van de vorige eeuw schakelde men over van akkerbouw op veeteelt. Dit leidde in 1897 tot de bouw van een zuivelfabriek (sinds 1981 kaasfabriek Salland BV). In 1836 werd de veerpont vervangen door een vaste brug over de Vecht. Ten zuiden daarvan verrees in 1902 een station aan de lijn Zwolle-Emmen. In de 19de eeuw ontwikkelde Dalfsen zich tot een bloeiend dorp, bestaande uit een noord-zuid lopende hoofdstraat (Prinsenstraat/Wilhelminastraat) en de in westelijke richting lopende weg naar Zwolle (Bloemendalstraat/Ruitenborghstraat). In de Tweede Wereldoorlog werd de Vechtbrug opgeblazen. Na de oorlog is Dalfsen flink uitgebreid in noordelijke en westelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00307> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 307 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De Herv. kerk (Kerkplein 1), oorspronkelijk gewijd aan St. Cyriacus, is een laat-gotische pseudobasiliek met rijzig, driezijdig gesloten koor en een forse, niet geheel voltooide toren met vier geledingen en een aangekapt tentdak. Archeologisch onderzoek heeft aangetoond dat in de 12de eeuw op deze plek een eerste kerkje werd gebouwd, bestaande uit een eenbeukig schip met een iets smaller koor en een inspringende halfronde absis. In het begin van de 14de eeuw voorzag men deze kerk van zijbeuken en een toren. Deze uitbreiding kwam waarschijnlijk tot stand dankzij Herman van Voorst, heer van Rechteren, die tussen 1315 en 1326 aan de zuidoostzijde van de kerk een familiekapel liet bouwen. Kort na 1455 werd het romaanse koor vervangen door het huidige gotische koor en kwam de sacristie tot stand. Ook werd, getuige de gedenksteen uit 1449, de tweebeukige kapel van Rechteren verbouwd in haar huidige vorm. In de tweede helft van de 15de eeuw werd het schip verhoogd en vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00308> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 308 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Na een vernietigende brand in 1517 bracht men schip en koor onder één kap. Ook kwamen toen de huidige zijbeuken tot stand, waarin de kapel van Rechteren werd geïntegreerd als de twee oostelijke traveeën van de zuidbeuk. Bovendien verrees één travee westwaarts van de oude plek een nieuwe toren, die met uitzondering van de bovenste geleding met tufsteen is bekleed en waaraan tot ver in de 16de eeuw is gebouwd. In het begin van de 19de eeuw kregen de zijbeuken een buitenbepleistering. Bij de algehele restauratie van kerk en toren in 1954-'57, onder leiding van W.P.C. Knuttel, heeft men onder meer deze blokbepleistering verwijderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00309> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 309 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De aanblik van het interieur van de kerk wordt bepaald door de korte zuilen met lijstkapitelen tussen middenschip en zijbeuken. De kruisrib- en netgewelven van de zijbeuken dateren van na de brand van 1517. Dit geldt ook voor de kruisribgewelven van het middenschip, die toen lager zijn aangebracht. De kerk bevat grafzerken en altaarstenen uit de 15de tot en met 17de eeuw. In de Van Rechterenkapel herinnert een gedenksteen uit 1449 aan ridder Frederik van Rechteren, die in dat jaar de kapel liet bouwen. In deze kapel liggen onder meer de grafzerken van Zeger van Rechteren (†1458) en Frederik van Rechteren (†1458). Verder zijn er twee epitafen, de ene voor Johan Zeijger van Rechteren (†1701) en zijn echtgenote Agnes Sophia van Raesfelt (†1705), de andere voor hun zoon Joachim Hendrik Adolf (†1719) en zijn echtgenote Amalia Alexandrina Frederica gravin von Limpurg Speckfeld (†1754). Laatstgenoemde heeft het monument laten oprichten, kort na de dood van haar echtgenoot; het werd vervaardigd door Johan Hendrik Hagen. Een vergelijkbaar grafmonument bevindt zich in de kerk van Rijssen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00310> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:adres "Bloemendalstraat 20" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 310 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De familie Van Rechteren schonk in de eerste helft van de 18de eeuw de geelkoperen lezenaar aan de kansel van eikenhout uit dezelfde periode en ruim een eeuw later het doopbekken (1863) van de firma J.M. van Kempen & Zn.. Voor de kansel staat een deels 18de-eeuwse herenbank. De drie geelkoperen kroonluchters zijn in 1758 gemaakt in opdracht van de kerkeraad. Het orgel heeft een orgelfront, gemaakt in 1808 door J.C. Scheuer. Het instrument werd in 1844 gebouwd voor de Herv. kerk te Hengelo, en stamt mogelijk van de hand van J.H. Holtgräve of van C.F.A. Naber. De beschildering met draperieën op de achtergrond dateert vermoedelijk uit 1808. De pastorie (Bloemendalstraat 20) is een sober neoclassicistisch pand uit 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00311> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:adres "Julianastraat 18" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dalfsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalfsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Dalfsen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 311 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Dalfsen"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De voorm. synagoge (Julianastraat 18), een eenvoudig zaalgebouw met ingezwenkte lijstgevel en middenrisaliet, is in 1866 gebouwd naar plannen van J.H. ter Hogt. De laatste dienst vond in 1927 plaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00312> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:adres "Oosterstraat 8" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dalfsen" ;
        min:gemeenteInBoek "Dalfsen" ;
