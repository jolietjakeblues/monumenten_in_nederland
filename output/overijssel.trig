        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Woonhuizen. Het woonhuis De IJhorst (Kerkweg 26-28) is een rijk eclectisch pand uit omstreeks 1875. Het neoclassicistische huis Kerkweg 14 stamt uit omstreeks 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0056.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00649> a min:Passage,
            schema:CreativeWork ;
