        min:hoofdstuk "Steden, dorpen, monumenten › Tubbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Tubbergen" ;
        min:lemma "Schultenwolde" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 970 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0096> ;
        schema:name "Schultenwolde"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Schultenwolde (Almeloseweg ong.) is een landgoed ten westen van Tubbergen. In 1920 liet A. Ledeboer naar ontwerp van J. Vixseboxse een fraai gelegen vakantiehuis (Almeloseweg 74) bouwen. Het driezijdig gesloten eenlaags pand met geknikt schilddak heeft een omgaande veranda met ronde Egyptische zuilen voorzien van bladkapitelen met papyrusmotieven. Twee jaar later verrees naar ontwerp van dezelfde architect een karakteristiek langhuisboerderijtje (Almeloseweg 72) met overstekend rieten wolfdak en een haakse lage aanbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00971> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vasse (gemeente Tubbergen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
