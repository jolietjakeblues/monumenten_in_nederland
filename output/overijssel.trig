        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "39650" ;
        min:soort "lemma" ;
        min:volgnummer 1055 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill404> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0108> ;
        schema:name "Wijhe Zicht"@nl ;
        schema:pageEnd "276" ;
        schema:pageStart "276" ;
        schema:pagination "276" ;
        schema:text "Wijhe Zicht (Oranjelaan 5) is een fors rechthoekig onderkelderd pand met schilddak, gebouwd aan het eind van de 18de eeuw. Tot 1817 heeft het als kweekschool dienst gedaan en daarna werd het eigendom van baronesse J.P.H. von Knobelsdorff tot Gelder. Na de oorlog was het enige tijd raadhuis en nu biedt het onderdak aan het politiebureau. Het koetshuis annex dienstwoning (Oranjelaan 1-3) stamt uit circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01056> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijhe – Woonhuizen"@nl ;
        min:adres "Langstraat 48-50",
            "Spoorstraat 1",
            "Stationsweg 11",
            "Stationsweg 23-25" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Wijhe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijhe" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wijhe" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10182>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23413> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "39646",
            "521746" ;
        min:soort "lemma" ;
        min:volgnummer 1056 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill405> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0108> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "276" ;
        schema:pagination "276-277" ;
        schema:text """Woonhuizen. In de nog gave dorpsstructuur staat een aantal interessante woonhuizen. Het gepleisterde dwarse woonhuis Langstraat 77, met hoogopgaand middenrisaliet, heeft in de zijgevel de ankers van het jaartal 1768. Het statige pand De Waag (Langstraat 48-50) draagt in de sluitsteen boven de wagendeur het jaartal 1860. Het vrijstaande neoclassicistische pand Villa Nova (Stationsweg 11) werd omstreeks 1860 gebouwd voor burgemeester Rambonnet. Waterloo (Stationsweg 23-25) is een eclectische villa annex tekenkamer, gebouwd omstreeks 1865 voor de spoorwegingenieur belast met de aanleg van de lijn Deventer-Zwolle. Het middendeel heeft een erker met daarop een veranda. De eclectisch vormgegeven notariswoning Dijk 4, gebouwd omstreeks 1870, heeft een tot balkon uitgebouwde dakerker in de ingangsrisaliet. Kerkstraat 32 is neoclassicistisch van vorm en werd omstreeks 1880 gebouwd als woonhuis annex vleeswarenfabriek. Het neorenaissance-herenhuis Langstraat 47 uit circa 1905 heeft boven de vensters en in de portiek jugendstil-tegels. Eenvoudige chaletwoningen uit omstreeks 1910 zijn Oranjelaan 2-6 en Nieuwendijk 1. Stationsweg 48 uit 1920 is een later en rijker voorbeeld van chaletbouw.

Het café-restaurant Wijlant (Spoorstraat 1) werd omstreeks 1900 gebouwd voor de heer Bergman. Het karakteristieke dorpscafe heeft aan de spoorzijde een houten veranda."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01057> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijhe – Dijkhuizen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
