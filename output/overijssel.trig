        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Losser" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Losser" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40407> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "26296" ;
        min:soort "inleiding" ;
        min:volgnummer 742 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0066> ;
        schema:name "Losser"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "De Herv. kerk (Raadhuisplein 2) is een eenvoudige kleine zaalkerk met driezijdig gesloten koor, gebouwd in 1810. De dakruiter uit 1900 verving een ouder exemplaar uit 1814. De ingang met zandstenen omlijsting in de rechterzijgevel toont het bouwjaar. De kerk werd in 1954 gerestaureerd door J. Jans. De kerk bevat een barokorgel uit 1724-'25, gebouwd door Diedrich Martens uit Vreden (D.) en gerestaureerd in 1865 en 1923."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00743> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Losser"@nl ;
        min:adres "Kostergaarden 44-52" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Losser" ;
        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Losser" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Losser" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 743 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0066> ;
        schema:name "Losser"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "De voorm. R.K. pastorie (Kostergaarden 44-52) werd in 1876 gebouwd voor de St.-Martinuskerk naar ontwerp van J. Moll. Na de bouw van de nieuwe pastorie bij de R.K. kerk O.L. Vrouwe Geboorte richtte men het gebouw in 1902 in als klooster voor de zusters van Maria van Altijddurende Bijstand. Het pand werd uitgebreid met een eenbeukige, driezijdig gesloten kapel naar plannen van G. te Riele. Tegenwoordig zijn pastorie en kapel opgenomen in een complex voor ouderenhuisvesting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00744> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Losser"@nl ;
        min:adres "Gronausestraat 2",
            "Gronausestraat 4",
            "Martinusplein 4",
            "Martinusplein 8",
            "Raadhuisplein 4",
            "Raadhuisplein 6",
            "Teylersstraat 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Losser" ;
        min:gemeenteInBoek "Losser" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Losser_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Losser" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Losser" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27747>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45674>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62401> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "26293",
            "26294",
            "26295" ;
        min:soort "inleiding" ;
        min:volgnummer 744 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill298> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0066> ;
        schema:name "Losser"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "De R.K. kerk O.L. Vrouwe Geboorte, (Gronausestraat 2) is een neogotische, driebeukige hallenkerk met driezijdig gesloten koor, gebouwd in 1900-'02 naar ontwerp van A. Tepe ter vervanging van de in 1903 gesloopte St.-Martinuskerk. De geplande westtoren werd niet uitgevoerd. Het interieur wordt gedekt door kruisribgewelven, rustend op ronde pilaren. Tot de inventaris behoort een serie van dertien laatgotische apostelbeelden en een kruisbeeld uit omstreeks 1500, afkomstig uit het in 1811 opgeheven klooster Maria Flucht aan de Duits-Nederlandse grens (D.). De aangebouwde, neogotische pastorie (Gronausestraat 4) stamt uit 1903. Woonhuizen. In het dorp staat een aantal boerderijachtige dorpshuizen of akkerburgerwoningen, veelal gebouwd na de dorpsbrand van 1665 en in latere tijd verbouwd. Het Teylershuis (Teylersstraat 4) is een langgerekt eenlaags dorpshuis met hoog zadeldak en aan de achterzijde een onderkelderde zaal. Het is in 1672 in opdracht van Derk Froen gebouwd en in 1778 door de familie Teylers aan de straatzijde uitgebreid. Het pand heeft een houten voorschot en een getoogde inrijpoort met sluitsteen voorzien van chronogram (1672). Het Froonshuis (Raadhuisplein 6) is waarschijnlijk aan het eind van de 17de eeuw gebouwd en omstreeks 1800 in de huidige vorm verbouwd. Het driebeukige hallenhuis is in de lengte door midden gedeeld in twee apart bewoonde delen, maar er is ook een gemeenschappelijke deel. Ook het Aleida Leurinkhuis (Raadhuisplein 4) uit omstreeks 1800 heeft een dergelijke indeling. Het naar de Roberinkstraat gewende bedrijfsgedeelte is in 1955 door J. Jans verbouwd tot consistorie. Vergelijkbare dorpshuizen zijn het Heininkshuis (Martinusplein 4), dat omstreeks 1830 werd vergroot, en het Bonkenhuis (Martinusplein 8) uit de eerste helft van de 19de eeuw, met als draagconstructie een combinatie van een dekbalk- en een ankerbalkgebint. Torenstraat 2 is een breed eenlaags pand met mansardedak in eclectische stijl, met aangebouwd bedrijfsgedeelte uit 1892-'93, gebouwd in opdracht van de familie Osse. Uit omstreeks 1900 dateren Gronausestraat 249, een klein dorpshuis met zadeldak, en Teylersstraat 15-17, een eenlaags woon- en winkelpand met mansardedak. De arts L. de Bruyn liet in 1934-'35 de eenlaags villa Gronausestraat 72 bouwen naar ontwerp van Joh.H. Sluijmer met steil rieten dak en expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0066.php> .

