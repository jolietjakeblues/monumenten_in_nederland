        min:adres "C.T. Storkstraat 16",
            "C.T. Storkstraat 18",
            "C.T. Storkstraat 27-35",
            "C.T. Storkstraat 43-47" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hengelo" ;
