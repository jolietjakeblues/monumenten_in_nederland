        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Schaapskooien. Aangezien Hooge-Hexel omgeven was door heidevelden, waren er vroeger veel schaapskooien. Waardevolle 19de-eeuwse exemplaren staan nog tegenover boerderij Hexelseweg 74 en bij boerderij de Haar (Haarboersweg 1)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0055.php> .

