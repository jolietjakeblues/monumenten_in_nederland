        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Boerderijen. Rond het dorp liggen verschillende hallenhuisboerderijen, behorende tot het landgoed Twickel, zoals Beernink (Katiersweg 4) uit 1866, met bovenkamer, Beerninkswöner (Kieftenweg 23) uit 1870, Smeenk (Bentelosestraat 36) uit 1870 en Hilderink (Kieftenweg 4) uit 1874."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00228> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergentheim (gemeente Hardenberg)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Hardenberg" ;
        min:gemeenteInBoek "Hardenberg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardenberg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergentheim (gemeente Hardenberg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bergentheim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 228 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0013> ;
        schema:name "Bergentheim (gemeente Hardenberg)"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Hoogveenkolonie ontstaan omstreeks 1835, toen I.A. van Royen eigendommen in het gebied verwierf om een veenderij te stichten. Vanuit het nabije esdorp Oud-Bergentheim, op de hogere gronden langs de Vecht, trok men naar dit gebied. In 1856 begon men met het graven van het Overijssels Kanaal Almelo-De Haandrik en het vervenen. Op de kruising met de in 1951 gedempte Van Royenswijk ontstond een kleine kern met school, kerk en winkel annex café. Door de aanleg van de spoorlijn Zwolle-Emmen in 1903 ontstond bebouwing in westelijke richting. Door de aanwezigheid van een turfstrooiselfabriek - waardoor ook de bovenste veenlaag, of bonkaarde, werd verwerkt - duurde het tot na 1920 voor de dalgronden in cultuur konden worden gebracht. Na de oorlog ontwikkelde zich tussen kanaal en spoorlijn een vierkant dorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0013.php> .

