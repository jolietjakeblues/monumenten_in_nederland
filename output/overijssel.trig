        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Windmolen. De ‘Soaseler Möl’ (Windmolenweg 8) is een ronde beltkorenmolen, gebouwd in 1870 op de plaats van een laat-middeleeuwse standerdmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00913> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schalkhaar (gemeente Diepenveen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Diepenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schalkhaar (gemeente Diepenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Schalkhaar" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 913 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill353> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0090> ;
        schema:name "Schalkhaar (gemeente Diepenveen)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Dorp, ontstaan in het begin van de 19de eeuw op een hoogte bij de splitsing van de Oerdijk naar Lettele en de Spanjaardsdijk naar Heeten. Het toen ook Riele genoemde dorp bestond uit enkele verspreid gelegen boerderijen met in het noorden het Wechelerveld en in het zuiden de Rieler Enk. Op deze plek kwam in 1810 een eerste katholieke kerk tot stand, die in 1894-'95 werd vervangen door de huidige. In 1900 verrees in Schalkhaar het raadhuis van de gemeente Diepenveen. Om de beter gesitueerden van het vlakbij gelegen Deventer te trekken begon men in 1889 met de aanleg van het villapark Braband. In 1898 kwam hier de eerste villa gereed. Ten noordoosten van het dorp werd in 1939 een kazerne gebouwd. Na de Tweede Wereldoorlog is Schalkhaar uitgegroeid tot een forenzendorp met betere eengezinswoningen, villa's en bungalows."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0090.php> .

