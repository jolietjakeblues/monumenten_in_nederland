        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vasse (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vasse" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 971 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0097> ;
        schema:name "Vasse (gemeente Tubbergen)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Kerkdorp, ontstaan als esnederzetting aan de Vasser Es. Na de Tweede Wereldoorlog kwam bij de in 1861 halverwege Vasse en Mander gebouwde katholieke kerk een dorpskern tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00972> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vasse (gemeente Tubbergen)"@nl ;
        min:adres "Denekamperstraat 205",
            "Denekamperweg 205" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Tubbergen" ;
        min:gemeenteInBoek "Tubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vasse (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vasse" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 972 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill375> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0097> ;
        schema:name "Vasse (gemeente Tubbergen)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "De R.K. kerk H.H. Joseph en Pancratius (bij Denekamperweg 205) is een neogotische driebeukige kerk met hoger transept en een smaller, driezijdig gesloten koor, gebouwd in 1861-'65 naar ontwerp van J.G.J. van Roosmalen. De neogotische westtoren van twee geledingen en een achtzijdige lantaarn met spits werd pas in 1870-'71 onder leiding van H.J. Wennekers naar het oorspronkelijke ontwerp voltooid. In 1907 kreeg het interieur nieuwe gewelven, waarbij de zuilen werden verzwaard of vernieuwd. De pastorie (Denekamperstraat 205) dateert uit 1913. Op het omstreeks 1870 aangelegde kerkhof staat een calvarieberg in de vorm van een zandstenen altaar met kruisbeeld uit omstreeks 1870. Verder liggen er nog 19de-eeuwse priestergraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00973> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vasse (gemeente Tubbergen) – Boerderijen"@nl ;
        min:adres "Beekzijdeweg 33",
            "Denekamperweg 246",
            "Hooidijk 49" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Tubbergen" ;
        min:gemeenteInBoek "Tubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vasse (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vasse" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29192>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36111>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43551>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79466>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79467> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "35755",
            "35763",
            "35764",
            "507950",
            "507951" ;
        min:soort "lemma" ;
        min:volgnummer 973 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0097> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Boerderijen. Rond het dorp zijn verschillende waardevolle boerderijen te vinden. De deels uit 1842 daterende langhuisboerderij Erve de Mast (Denekamperweg 246) heeft een vakwerkschuur met houten voorschotten en een bakhuis, beide uit de 18de eeuw. Erve Geerdink Johannink (Beekzijdeweg 33) is een monumentale dwarshuisboerderij uit 1873 met verdubbeld bedrijfsgedeelte. In 1905 zijn in de beide tuitgevels van de achtergevel gevelstenen aangebracht met verwijzingen naar de bezoeken die pastoor E. Geerdink, geboortig van deze boerderij, aan Nazareth, Jeruzalem en Bethlehem bracht. Op het erf staan een hooischuur (1850) en een vakwerkschuur (1860). Denekamperweg 124 is een laat-19de-eeuwse langhuisboerderij met verdubbeld bedrijfsgedeelte. Op het ‘Erve Scholte’ (Hooidijk 49), gelegen in de buurtschap Hezingen ten oosten van Vasse, staat een 18de-eeuwse schaapskooi in vakwerk, deels met baksteen- en deels met leemvulling. De topgevel is uitgevoerd in strovlechtwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00974> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vasse (gemeente Tubbergen) – Watermolens"@nl ;
        min:adres "Bergweg 9",
            "Denekamperweg 246",
            "Oosteriksweg 26" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Tubbergen" ;
        min:gemeenteInBoek "Tubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tubbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vasse (gemeente Tubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vasse" ;
        min:lemma "Watermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29192>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43551>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48546>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48799> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "35757",
            "35758",
            "35763",
            "35764" ;
        min:soort "lemma" ;
        min:volgnummer 974 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill376> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0097> ;
        schema:name "Watermolens"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "260" ;
        schema:pagination "260-261" ;
        schema:text "Watermolens. Ten zuidwesten van Vasse ligt De Mast (Denekamperweg 246) een bovenslag-watermolen op de Onderbeek, gebouwd omstreeks 1800 in vakwerk op een onderbouw van zandsteen. Tot omstreeks 1900 was het ook een oliemolen. De molen werd in 1942 gerestaureerd naar plannen van J. Jans. In het buurtschap Mander ten noorden van Vasse liggen op de Mosbeek twee watermolens. De Molen van Bels (Bergweg 9) is een dubbele bovenslagwatermolen, waarvan beide delen zijn gebouwd in vakwerk op een onderbouw van zandsteen. Aan de ene kant van de beek staat de in 1725 gestichte papiermolen, die een geheel vormt met een omstreeks 1880 verbouwde en nu als restaurant ingerichte hallenhuisboerderij. Aan de andere zijde staat een voorm. cichoreimolen uit 1845, die in 1914 is verbouwd tot korenmolen. Beide molens zijn in 1960-'62 gerestaureerd. Stroomopwaarts ligt de in 1969 gerestaureerde bovenslag-watermolen Frans (Oosteriksweg 26), oorspronkelijk gebouwd in 1725 als papiermolen, maar in 1872 afgebroken en herbouwd als korenmolen. In 1911 werd een bakkerij toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00975> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vilsteren (gemeente Ommen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vilsteren (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vilsteren" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 975 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0098> ;
        schema:name "Vilsteren (gemeente Ommen)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Esdorp, voor het eerst genoemd in 1244. Al in 1381 is er sprake van een hof en in 1690 blijkt het bestaan van een spieker. De marke Vilsteren bestond in 1457 uit zes en in 1664 uit elf erven, waar gemengd bedrijf plaatsvond met akkerbouw op de enkgronden en veeteelt op de groengronden langs de Vecht. Eén daarvan, erve Gerner, bood vanaf 1675 onderdak aan een katholieke schuilkerk. In de 18de eeuw geraakte gaandeweg de hele marke Vilsteren in één hand en ontstond het landgoed Vilsteren. Rond 1830 werd de weg van Zwolle naar Ommen over Vilsteren aangelegd en na 1850 volgde de vernieuwing van een aantal boerderijen en de bouw van een molen. In 1902 ontstond een, inmiddels verdwenen, haltegebouw aan de spoorlijn Zwolle-Ommen. Na 1945 vond een herverkaveling plaats van de essen en sinds 1973 zijn de meeste boerderijen aan de pachters verkocht. Het resultaat is een katholieke enclave met een gaaf gebleven dorpsstructuur, waarin landhuis, kerk en pastorie liggen aan een driezijdig veld met een brinkachtig karakter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00976> a min:Passage,
