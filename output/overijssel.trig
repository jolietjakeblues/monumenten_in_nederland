        min:hoofdstuk "Steden, dorpen, monumenten › Wijhe" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Wijhe" ;
        min:lemma "Dijkhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1057 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0108> ;
        schema:name "Dijkhuizen"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Dijkhuizen. Aan de zuidzijde van het dorp staan twee karakteristieke dijkhuisjes. Het Mottenhuisje (Rijksstraatweg A2) stamt uit de 19de eeuw, is een dwars huis met rieten schilddak, waaronder zich aan de dijk het woongedeelte en daarachter een lagere stal bevinden. Rijksstraatweg A1 is een uit 1917 stammende dijkwoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01058> a min:Passage,
            schema:CreativeWork ;
