        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39673>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73502> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "41566",
            "509805" ;
        min:soort "inleiding" ;
        min:volgnummer 1152 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0115> ;
        schema:name "Zwolle"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De Luth. kerk (Koestraat 2) [8] werd in 1649 als schuilkerk gebouwd tegen de oude stadsmuur en is in 1850 en 1889 verbouwd. Het huidige uiterlijk kwam tot stand bij een verbouwing in 1967. Het interieur van deze zaalkerk heeft een galerij. De eiken preekstoel dateert uit het derde kwart van de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01153> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwolle"@nl ;
        min:adres "Nieuwstraat 41" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
