        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Veennederzetting gesticht in het midden van de 14de eeuw. De langgerekte structuur van het dorp, met een Oost- en een Westeinde, komt overeen met die van Rouveen. Oorspronkelijk lag de nederzetting veel zuidelijker, aan de Aadijk, maar in de loop van de 15de en 16de eeuw werd het dorp in drie slagen naar het noorden verplaatst. Sinds het eind van de 17de eeuw bevindt het zich op de huidige plaats. Langs het in 1859 gegraven Overijssels Kanaal werd de textielfabriek van Jansen & Tilanus gevestigd. Het dorp werd in 1905 grotendeels door brand verwoest. In recente tijd ontstonden voornamelijk ten zuiden van het Westeinde nieuwbouwwijken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00999> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vriezenveen"@nl ;
        min:adres "Westeinde 17" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Twenterand" ;
        min:gemeenteInBoek "Vriezenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Twenterand> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vriezenveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Vriezenveen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 999 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0100> ;
        schema:name "Vriezenveen"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "De R.K. kerk St.-Antonius Abt (Westeinde 17) is een eenbeukige neogotische kerk met versmald, driezijdig gesloten koor en een ongelede toren met ingesnoerde vierzijdige spits. De kerk verrees in 1905-'06 naar ontwerp van H. Kroes. Ze verving de in 1905 door brand verwoeste kerk uit 1858. De aangebouwde pastorie is eveneens uit 1905 en van de hand van dezelfde architect. Links naast de kerk bevindt zich een Lourdesgrot met buitenaltaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0100.php> .

