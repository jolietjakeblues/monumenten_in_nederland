        min:soort "inleiding" ;
        min:volgnummer 392 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0031> ;
        schema:name "Deurningen (gemeente Weerselo)"@nl ;
        schema:pageEnd "95" ;
        schema:pageStart "95" ;
        schema:pagination "95" ;
        schema:text "De R.K. St.-Plechelmuskerk (St.-Plechelmusplein 5) is een neogotische eenbeukige kruiskerk met een driezijdig gesloten koor, een dakruiter en een hoge ongelede toren met achtkante ingesnoerde spits. De kerk werd gebouwd in 1910-'12 naar ontwerp van W. te Riele en verving een voorganger uit 1830. De naastgelegen begraafplaats is voorzien van een 19de-eeuws smeedijzeren hekwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00393> a min:Passage,
