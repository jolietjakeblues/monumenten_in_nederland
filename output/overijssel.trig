        schema:name "Hondeborg"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Hondeborg (Esweg 1). Ten zuiden van Zenderen en aan de Aselerbeek ligt de omgrachte ronde heuvel waarop in de 14de eeuw het adellijke huis Hondeborg stond. Op die heuvel liet de vrouwe van Twickel, M.C. van Heeckeren-Van Wassenaer Obdam, in 1841 de langhuisboerderij Hondeborg bouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01099> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zenderen (gemeente Borne) – Weleveld"@nl ;
        min:adres "Bekkingvelderweg 2" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
