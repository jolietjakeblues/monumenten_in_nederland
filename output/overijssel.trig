        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ossenzijl (gemeente IJsselham)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Ossenzijl" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 864 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0081> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Boerderijen. Eveneens karakteristiek zijn de keuterboerderijen Hoogeweg 4 en Hoogeweg 5. Deze boerderijen uit de eerste helft van de 18de eeuw hebben een met riet gedekt bakstenen woongedeelte en een houten, nagenoeg vierkant bedrijfsgedeelte met grondtas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00865> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ossenzijl (gemeente IJsselham) – Molens"@nl ;
        min:adres "Hoogeweg 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "IJsselham" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ossenzijl (gemeente IJsselham)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Ossenzijl" ;
