    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00646> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJhorst (gemeente Staphorst)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Staphorst" ;
        min:gemeenteInBoek "Staphorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Staphorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJhorst (gemeente Staphorst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJhorst" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 646 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill255> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0056> ;
        schema:name "IJhorst (gemeente Staphorst)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Hoevenzwermdorp, ontstaan aan de Reest en voor het eerst genoemd in 1292. Het dorp is van ouds sterk verbonden geweest met het iets noordelijker bij De Wijk in Drenthe gelegen klooster Dickninge. Dit klooster werd in 1325 gesticht, toen het uit 1141 stammende benedictijnerklooster uit Ruinen hierheen werd verplaatst. In 1603 werd het klooster opgeheven en in 1810 gesloopt. Het dorp vormt kerkelijk gezien nog steeds één gemeente met De Wijk. Aan de rand van het boscomplex ‘De Witte Bergen’, dat omstreeks 1900 is aangelegd en dat in de jaren dertig een grote toeristische attractie in de regio vormde, is na de Tweede Wereldoorlog een uitbreidingswijk tot stand gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0056.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00647> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJhorst (gemeente Staphorst)"@nl ;
        min:adres "Kerkweg 10",
            "Kerkweg 8" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Staphorst" ;
        min:gemeenteInBoek "Staphorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Staphorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJhorst (gemeente Staphorst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "IJhorst" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26337>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28536>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55365> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "34493",
            "34494",
            "34495" ;
        min:soort "inleiding" ;
        min:volgnummer 647 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0056> ;
        schema:name "IJhorst (gemeente Staphorst)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "De Herv. kerk (Kerkweg 10) is een forse zaalkerk met schilddak, in 1823 in eenvoudige neoclassicistische vormen gebouwd ter vervanging van een oudere, aan St. Nicolaas gewijde kerk. Jan Arend Godard de Vos van Steenwijk legde de eerste steen van het op zwerfkeien gefundeerde gebouw. De kerk herbergt een in 1656 gemaakte preekstoel met kuip, voorzien van toogpanelen met gesneden festoenen. Verder zijn er enkele grafzerken, waaronder de zerk van Johannes Schepelar, abt van Dickninge, uit omstreeks 1543. Op het kerkhof staat een afzonderlijke, op zwerfkeien gefundeerde, houten klokkenstoel met ingezwenkt tentdak. In de klokkenstoel hangt een in 1780 door Peter Seest gegoten klok. Tussen kerk en kerkhof liggen de grafzerken en grafkelder van de familie De Vos van Steenwijk, bezitters van de in De Wijk gelegen havezate Havixhorst. De pastorie (Kerkweg 8) stamt uit omstreeks 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0056.php> .

