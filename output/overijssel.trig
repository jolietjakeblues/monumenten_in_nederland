        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1082 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "Langs de Windesheimerweg staan diverse 19de-eeuwse eenlaags dienstwoningen voorzien van rieten dak en luiken in de kleuren van het huis (nrs. 15-19 en 25-35). Van omstreeks 1900 is Windesheimerweg 4, met vlakbij een laat-19de-eeuwse schuur en een brug met hek die toegang geven tot het landgoed. De dubbele dienstwoning Windesheimerweg 21-23 kwam omstreeks 1910 tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01083> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Windesheim (gemeente Zwolle) – Boerderij"@nl ;
        min:adres "Dorpsstraat 19-27" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Windesheim (gemeente Zwolle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:lemma "Boerderij" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20653> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "41906" ;
        min:soort "lemma" ;
        min:volgnummer 1083 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Boerderij"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text """Boerderij Veldweg 1 behoorde mogelijk tot het klooster Windesheim en heeft ondanks latere verbouwingen diverse oude onderdelen behouden. De kelder onder de opkamer is laat-middeleeuws en wordt gedekt door troggewelven op gordelbogen. De opkamer is voorzien van ankerbalkgebinten en een sporenkap. De houtconstructie van de stal wordt gedateerd op kort na 1500. In de omstreeks 1800 verbouwde oostgevel bevindt zich nog een gebint van de oude situatie, toen de gevel een houten voorschot zal hebben gehad.

De diaconiewoningen ‘De Bethlehem’ (Dorpsstraat 19-27) vormen een rij eenlaags woningen met schilddak, schuifvensters en deuren met bovenlicht voorzien van gietijzeren levensboom. Ze dateren uit het midden van de 19de eeuw en zijn in 1997 gerenoveerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

