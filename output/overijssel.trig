            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66721> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "32267",
            "513669",
            "513670" ;
        min:soort "lemma" ;
        min:volgnummer 887 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill345>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill346> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0085> ;
        schema:name "Mariënheem"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text """Mariënheem. Ten oosten van Raalte ligt het dorp Mariënheem, dat is ontstaan rond de toen gebouwde kerk. De R.K. kerk O.L. Vrouwe Hemelvaart (Nijverdalseweg 32) is een driebeukige pseudobasiliek met een ingangsportaal onder een zadeldak. De hoogopgaande vieringstoren en kleine traptoren worden beide gedekt door een tentdak waarop een bolvormige bekroning. De kerk werd in 1937-'38 gebouwd naar plannen van G. Leeuwenberg in een aan het werk van Kropholler verwante traditionalistische stijl. Het priesterkoor aan de oostzijde is in de jaren zestig gesloopt. De kruiswegstaties in de kerk zijn van de hand van L. Sengers. De pastorie (Nijverdalseweg 34) stamt uit 1937.

Nabij de kerk staan een openluchtkapel uit circa 1937 en een laat-19de-eeuws beeld van Maria met Kind. De Bagatelle (Nijverdalseweg 10) is een met riet gedekt pand, dat mogelijk na 1747 is ontstaan als posthuis en toen tot het landgoed Schoonheten behoorde. In 1819 werd het tot theehuis ingericht; na oorlogsschade is het in 1947 hersteld."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00888> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Raalte – Luttenberg"@nl ;
        min:adres "Butzelaarstraat 22" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Raalte" ;
        min:gemeenteInBoek "Raalte" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Raalte_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Raalte" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Raalte" ;
        min:lemma "Luttenberg" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 888 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0085> ;
        schema:name "Luttenberg"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "Luttenberg. Ten noordoosten van Raalte ligt het dorp Luttenberg, oorspronkelijk ontstaan als hoevenzwermdorp nabij de 15de-eeuwse - en in het eind van de 19de eeuw verdwenen - havezate Luttenberg. Al in 1620 stichtte men hier een katholieke kapel die in 1769 werd afgebroken. De R.K. St. - Corneliuskerk (Butzelaarstraat 22) is een driebeukige neogotische hallenkerk met toren van twee geledingen, waarvan de bovenste overgaat in een bakstenen achtkant met wijzerplaten en een slanke spits. De kerk werd in 1904-'05 gebouwd naar plannen van W. te Riele. In 1920 volgde een uitbreiding en in 1939 werd de kerk gerestaureerd en vergroot. Aan de oostzijde bevinden zich in de buitenmuur stenen met daarin gebakken de namen van gulle gevers. De iets noordelijker gelegen Lourdesgrot (Harmelinkstraat hoek Butzelaarstraat ong.), ontstaan in 1914-'15, is een blijk van katholieke devotie die in Overijssel zeldzaam is. De gepleisterde structuur heeft een door een hek afgesloten grotgedeelte en schuin daarboven een beeld van Maria."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00889> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Raalte – Broekland"@nl ;
        min:adres "Neppelenbroekerdijk 1",
            "Van Dongenstraat 10",
            "Van Dongenstraat 12" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Raalte" ;
        min:gemeenteInBoek "Raalte" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Raalte_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Raalte" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Raalte" ;
        min:lemma "Broekland" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 889 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0085> ;
        schema:name "Broekland"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "Broekland. Ten zuidwesten van Raalte ligt het dorp Broekland, oorspronkelijk ontstaan als hoevenzwermdorp, dat kerkelijk in 1911 van de parochie Boerhaar werd afgesplitst. De R.K. St.-Marcellinuskerk (Van Dongenstraat 10) is een driebeukige neogotische kruisbasiliek; de toren telt drie geledingen en heeft een ingesnoerde spits. Op de plaats van een uit 1819 stammende kapel werd in 1911-'12 de huidige kerk gebouwd naar plannen van H. Kroes en met als opzichter C.A. Hardeman. De laatste verzorgde in 1931 de uitbreiding van de kerk met zijbeuken. De gebrandschilderde ramen zijn van de hand van J. Colette en stammen, net als de pastorie (Van Dongenstraat 12), uit 1912. Op het voorm. landgoed Neppelenbroek staat een fraaie hallenboerderij met dwarshuis (Neppelenbroekerdijk 1) uit omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00890> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reutum (gemeente Tubbergen)"@nl ;
