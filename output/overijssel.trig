        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 218 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill68> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "59" ;
        schema:pagination "59-60" ;
        schema:text "Woonhuizen. Het dorp kent nog een aantal typisch 19de-eeuwse dorpswoningen, in de vorm van een dwars woonhuis met in het midden een licht risalerende ingangspartij overgaand in een bakstenen dakerker en met terugliggend portiek. Dorpsstraat 11 uit omstreeks 1880 is hier een goed voorbeeld van. Rijker zijn de neoclassicistische Villa Willy (Looweg 1) uit omstreeks 1875 en dokterswoning met jugendstil-details Koekendijk 2 uit 1912."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00219> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bathmen – Boerderijen"@nl ;
        min:adres "Zandvoortdijk 1" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Deventer" ;
        min:gemeenteInBoek "Bathmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deventer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bathmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Bathmen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 219 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0010> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Boerderijen. De meeste boerderijen zijn hallenhuisboerderijen met langsdeel, gebouwd in de tweede helft van de 19de eeuw, met een vaak parallel aan de boerderij staande schuur van dezelfde grootte. De uit 1894 stammende boerderij Menopsweg 2 is hier een voorbeeld van. Erve Zandvoort (Zandvoortdijk 1) uit omstreeks 1900 heeft daarbij nog een halfronde aanbouw die als karnhuis diende."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00220> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beerze (gemeente Ommen)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beerze (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Beerze" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 220 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0011> ;
        schema:name "Beerze (gemeente Ommen)"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Esdorp ontstaan op de hogere delen langs de Vecht en voor het eerst genoemd in 1328. De in 1465 gebouwde havezate Beerse was in de 16de eeuw bezit van het geslacht Van Voorst. Rond 1740 werd het gesloopt en in 1748 resteerde nog één bouwhuis dat in 1928 werd vervangen door de nieuwbouw van de boerderij de Höfte. Vanuit de fraai gelegen en in een losse structuur geplaatste boerderijen beoefende men van oudsher gemengd bedrijf, met akkerbouw op de hogere enkgronden en veeteelt op de groengronden langs de Vecht. In 1848 werd de marke opgeheven en de woeste gronden verdeeld. Na het graven van het Overijssels Kanaal in 1858 ontstond aan de zuidoostzijde van het Beerzerzand de veenkolonie Beerzerveld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00221> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beerze (gemeente Ommen) – Huize Beerze"@nl ;
        min:adres "Beerzerpoort 3",
            "Beerzerpoort 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beerze (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Beerze" ;
        min:lemma "Huize Beerze" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 221 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0011> ;
        schema:name "Huize Beerze"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Huize Beerze (Beerzerpoort 4) is een villa uit 1925, gelegen in het Beerzerzand op het landgoed Beerze. Het huis met brede dakerker en rechtgesloten erker met balkon is een eigen ontwerp van de toenmalige eigenaar baron Bentinck. De chauffeurswoning (Beerzerpoort 3) stamt eveneens uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00222> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beerze (gemeente Ommen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beerze (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Beerze" ;
        min:lemma "Boerderijen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 222 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill69> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0011> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Boerderijen. De boerderijen in het dorp zijn met riet gedekte hallenhuisboerderijen met middenlangsdeel, die in het algemeen niet ouder zijn dan de eerste helft 19de eeuw. Het woongedeelte heeft een wolfdak en het naar de weg gerichte bedrijfsgedeelte heeft een terugliggende toegang met inspringend dak, een zogeheten onderschoer. Rondom de boerderijen ligt een huiskamp met spaarzame erfbeplanting. Beerzerweg 21 is de meest compleet bewaard gebleven boerderij, met onderschoer, schuur, mik en bakhuis. Beerzerpoort 2 met bakhuisje stamt uit 1876. Andere voorbeelden zijn Beerzerweg 25 (1851), Beerzerweg 27 (1855), Beerzerweg 24 (1872), Beerzerweg 15, Beerzerweg 16, Beerzerweg 23 en Beerzerweg 28."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00223> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beerze (gemeente Ommen) – Beerzerveld"@nl ;
        min:adres "Stenendijk 5",
            "Westerweg 39",
            "Westerweg 40" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Ommen" ;
        min:gemeenteInBoek "Ommen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ommen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beerze (gemeente Ommen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Beerze" ;
        min:lemma "Beerzerveld" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 223 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0011> ;
        schema:name "Beerzerveld"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Beerzerveld. Ten zuidoosten van Beerze ligt de hoogveenkolonie Beerzerveld, ontstaan na graven van het Overijssels Kanaal in 1858. De Herv. kerk (Westerweg 39) is een neoclassicistische zaalkerk met ingangspartij en gepleisterde geveltoren met ingesnoerde spits uit 1901. De pastorie (Westerweg 40) stamt uit 1905. De boerderij Oldambt (Stenendijk 5) is een moderne kop-rompontginningsboerderij uit omstreeks 1930. De brug (Westerdijk ong.) over het Overijssels Kanaal is een ophaalbrug uit omstreeks 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00224> a min:Passage,
            schema:CreativeWork ;
