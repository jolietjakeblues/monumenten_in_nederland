        min:hoofdstuk "Steden, dorpen, monumenten › Weerselo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Weerselo" ;
        min:lemma "Scholen" ;
        min:provincie "Overijssel" ;
        min:soort "lemma" ;
        min:volgnummer 1024 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0103> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Scholen. De Openbare Lagere School (Het Stift 7) is in 1891 naar plannen van H.E. Zeggelink gebouwd als een drieklassige eenlaags dorpssschool. Het voorm. kleuterschooltje (Het Stift 5) dateert waarschijnlijk uit de dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01025> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weerselo – Woonhuizen"@nl ;
        min:adres "Het Stift 3",
            "Het Stift 6-6A",
            "Hilbertweg 1",
            "Vicarieweg 2A-B",
            "Vicarieweg 3" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Dinkelland" ;
        min:gemeenteInBoek "Weerselo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dinkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weerselo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Weerselo" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14255>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21561>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56525> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "38412",
            "38417",
            "38419" ;
        min:soort "lemma" ;
        min:volgnummer 1025 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0103> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text """Woonhuizen. Van de 17de- en 18de-eeuwse zogenoemde Stifthuizen is alleen het uit 1731 daterende herenhuis Het Stift 15 echt bewaard gebleven. Het is een breed diep pand met classicistische ingangspartij, versierd met de wapens Bentinck-Van Welvelde. Bij de restauratie in 1975 heeft men aan de rechterzijde enkele in de 19de eeuw gesloopte stifthuizen naar een 18de-eeuwse tekening herbouwd. Het Storkshuis (Het Stift 6-6A) is een eenlaags gebouw met schilddak, in 1839 gebouwd in opdracht van J.E. Stork; de aangebouwde schuur stamt uit omstreeks 1900. Het gebouw diende van 1903-'68 als postkantoor. Het Brouwershuis (Het Stift 3) is een tweebeukig eenlaags huis met schilddaken uit omstreeks 1910. Boerderijen. De Vicarie (Vicarieweg 3) is een eenbeukige vakwerkschuur uit omstreeks 1568 met houten voorschotten. De oorspronkelijke functie is onduidelijk. Stiftstraat 6 is een dwarshuisboerderij in vakwerk met op het erf een gesneden decoratieve duiventil. Potstol (Vicarieweg 2A-B) is een dwarshuisboerderij met driedaks bedrijfsgedeelte uit 1877.

Ook rond het dorp staan verschillende interessante boerderijen. Van de uit 1804 daterende langhuisboerderij Bellinkhofweg 4 zijn de achter- en zijgevels in 1931 vernieuwd. Bornestraat 30 is een langhuisboerderij met bovenkamer uit 1808, verbouwd in 1848. Op het erf staat een 19de-eeuwse vakwerkschuur. Andere langhuisboerderijen zijn Hilbertweg 4 met schuur uit 1873 en Darkman (Hilbertweg 1) uit 1895 met 19de-eeuwse schuren. De driekapsboerderij Akkerhuisweg 1 dateert uit 1915 en de tweekapsboerderij Detertweg 3 uit 1924."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01026> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Welsum (gemeente Olst)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Olst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Welsum (gemeente Olst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Welsum" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1026 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/afbeelding/sten009monu03ill396> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0104> ;
        schema:name "Welsum (gemeente Olst)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "271" ;
        schema:pagination "271-272" ;
        schema:text "Hoevenzwermdorp, voor het eerst genoemd in 1295 en gelegen aan de Veluwe-zijde van de IJssel. Oorspronkelijk zou het één geheel met Olst hebben gevormd, maar doordat de IJssel zijn loop veranderde, kwam daar in de late middeleeuwen een einde aan. In de kern lag de laat-15de-eeuwse havezate Hogenhof, die in het begin van de 19de eeuw werd gesloopt. Van 1807 tot 1814 hoorde deze Overijsselse enclave in Gelders gebied voor korte tijd bij Gelderland. Na de oorlog heeft zich rond de kerk een zeer bescheiden kom gevormd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01027> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Welsum (gemeente Olst)"@nl ;
        min:adres "Kerklaan 5" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Olst-Wijhe" ;
        min:gemeenteInBoek "Olst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Olst-Wijhe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Welsum (gemeente Olst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Welsum" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1027 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0104> ;
        schema:name "Welsum (gemeente Olst)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De Herv. kerk (Kerklaan 5), een zaalkerk, heeft een ingebouwde oudere toren van drie geledingen met een zadeldak. De oorspronkelijk aan drie zijden vrijstaande toren werd omstreeks 1475 gebouwd. In de toren hangt een klok uit 1560. Het schip moet in de 17de eeuw in verval zijn geraakt. In 1730 blijkt de hiervoor in de plaats gekomen houten kapel te zijn afgebrand. Nadat Welsum in 1820 een zelfstandige Hervormde gemeente werd, volgde in 1828 de bouw van een eenvoudige zaalkerk met aangebouwde consistoriekamer. Toen zijn ook de beide geveltoppen van de toren tot stand gekomen. In 1967 volgde een vrij ingrijpende restauratie. De 19de-eeuwse preekstoel is afkomstig uit Veenhuizen; het orgel werd in 1866 door Maarschalkerweert vervaardigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01028> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Welsum (gemeente Olst) – Dijkhuizen"@nl ;
        min:adres "IJsseldijk 37",
            "IJsseldijk 51-51A" ;
