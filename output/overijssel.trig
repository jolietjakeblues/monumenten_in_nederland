        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giethoorn (gemeente Brederwiede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Giethoorn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58239> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "10493" ;
        min:soort "inleiding" ;
        min:volgnummer 514 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0041> ;
        schema:name "Giethoorn (gemeente Brederwiede)"@nl ;
        schema:pageEnd "149" ;
        schema:pageStart "149" ;
        schema:pagination "149" ;
        schema:text "De Herv. kerk (Beulakerweg 80) is een eenbeukige zaalkerk met driezijdig gesloten koor. Ze verving in 1645 een oudere, mogelijk westelijker gelegen, kerk gewijd aan St. Martinus. De kerk werd in 1815 en opnieuw in 1818 hersteld. Bij een restauratie in 1931 is het gebouw ontpleisterd. Het interieur wordt gedekt door een houten tongewelf en bevat een preekstoel uit 1646 en een doophek uit dezelfde tijd. Het orgel uit 1872 werd vervaardigd door H. Knipscheer. Op het kerkhof staat een uit 1633 stammende vrijstaande open eikenhouten klokkenstoel met gesloten zadeldak. De klok dateert eveneens uit 1633. De pastorie annex boerderij (Beulakerweg 78) werd gebouwd in 1863."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00515> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giethoorn (gemeente Brederwiede)"@nl ;
        min:adres "Binnenpad 48",
            "Binnenpad 50" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Steenwijkerland" ;
        min:gemeenteInBoek "Brederwiede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenwijkerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giethoorn (gemeente Brederwiede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Giethoorn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71906>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71907> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "10502",
            "507456" ;
        min:soort "inleiding" ;
        min:volgnummer 515 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0041> ;
        schema:name "Giethoorn (gemeente Brederwiede)"@nl ;
        schema:pageEnd "149" ;
        schema:pageStart "149" ;
        schema:pagination "149" ;
        schema:text "De Doopsgez. vermaning (Binnenpad 48) dateert uit 1871 en is een neoclassicistische zaalkerk met een geveltorentje voorzien van een gesloten houten lantaarn en een ingesnoerde naaldspits. De kerk heeft een gietijzeren goot op klossen. Boven de, in een risaliet gevatte, ingangspartij zit een gevelsteen met het opschrift: ‘Een is uw meester, namelijk Christus en gij zijt allen broeders. Mat(heus) 23.8’. De kerk heeft een preekstoel en een orgel uit 1911. Sinds 1890 wordt de kerk gebruikt door de beide, in de 16de eeuw afgesplitste, doopsgezinde gemeenten; de kerk van Middenbuurt is in 1893 afgebroken. De pastorie (Binnenpad 50) stamt uit 1911 en heeft een interieur met jugendstilelementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00516> a min:Passage,
