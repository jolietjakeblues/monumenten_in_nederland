        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De R.K. St.-Cyriacuskerk (Wilhelminastraat bij 21) is een driebeukige basiliek met gereduceerd dwarsschip en forse gedrongen toren, gebouwd in 1938-'39 naar ontwerp van A. Vosman. Naast de toren, waarin zich de toegang tot de kerk bevindt, staat een doopkapel. Een gebrandschilderd raam is afkomstig uit de vorige, in 1866 gestichte kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00314> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalfsen"@nl ;
        min:adres "Bloemendalstraat 16" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
