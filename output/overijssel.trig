        schema:name "Ommen"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "232" ;
        schema:pagination "232-233" ;
        schema:text "De Geref. kerk (Bouwstraat 17) is een forse kruiskerk. In de zuidwestelijke binnenhoek staat terzijde een toren van twee geledingen met wijzerplaten en spits tentdak. De kerk werd in 1932 gebouwd in licht expressionistische vormen, naar plannen van B.W. Plooy, om een voorganger uit 1890 te vervangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00837> a min:Passage,
            schema:CreativeWork ;
