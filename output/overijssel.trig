        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "Esdorp ontstaan in de late middeleeuwen aan de weg van Zwolle naar Deventer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01077> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Windesheim (gemeente Zwolle)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Windesheim (gemeente Zwolle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1077 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "Hier werd in 1387 door volgelingen van Geert Grote een klooster van de Broeders des Gemenen Levens gesticht. Dit zou het moederklooster worden voor de Windesheimer kloostercongregatie, die tot de reformatie veel aanhang bezat in Noordwest-Europa. Ten westen van het klooster verrees het Huis Windesheim. Langs de IJssel lagen steenbakkerijen, waarvan nu alleen nog de tichelgaten getuigen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01078> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Windesheim (gemeente Zwolle)"@nl ;
        min:adres "Dorpsstraat 4" ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Windesheim (gemeente Zwolle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35139> ;
        min:provincie "Overijssel" ;
        min:rijksmonumentnummer "41907" ;
        min:soort "inleiding" ;
        min:volgnummer 1078 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "De Herv. kerk (Dorpsstraat 4), een rechthoekig gebouw uit circa 1565, diende oorspronkelijk als brouwerij van het klooster Windesheim. Het is als enige van de kloostergebouwen geheel bewaard gebleven, omdat het vanaf 1633 als kerk diende. Ten behoeve van de kerkzaal heeft men de eerste verdiepingsvloer verwijderd. Bij de restauratie van het gebouw omstreeks 1987 zijn de vensters gereconstrueerd. De tuitgevels tonen dichtgezette vensters en laadopeningen. Van de bouwtijd dateren een stortkanaal in de oostgevel, de eiken kapconstructie met gestapelde jukken en de samengestelde balklaag met korbeelstellen van de tweede verdiepingsvloer, die het interieur van de kerkzaal dekt. De zaal bevat onder meer een preekstoel uit 1647 met klankbord uit 1649, een koperen lezenaar uit het tweede kwart van de 18de eeuw. De aangebouwde consistoriekamer heeft een neogotische trapgevel met uitgebouwd ingangsportaal uit 1915, naar ontwerp van L.H.J. Westerop. Tegen de westgevel staat een boerderij met een rieten schilddak en een gepleisterde kopgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01079> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Windesheim (gemeente Zwolle)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Windesheim (gemeente Zwolle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1079 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "In enkele nabijgelegen panden zijn van het bij de reformatie opgeheven klooster nog enkele kleine gebouwresten over. Pastorieweg 2, een boerderij met laat-19de-eeuwse aanbouw, heeft een smalle kelder met ribloze kruisgewelven, en daarboven resten van laat-middel-eeuws muurwerk en enkele moerbalken met korbeelstellen. De huis Pastorieweg 4, de pastorie van de kerk, heeft een vrijwel vierkante laat-middeleeuwse kelder met ribloze kruisgewelven op een middenzuil."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01080> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Windesheim (gemeente Zwolle)"@nl ;
        min:deel "Monumenten in Nederland. Overijssel" ;
        min:gemeente "Zwolle" ;
        min:gemeenteInBoek "Zwolle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zwolle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Windesheim (gemeente Zwolle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Windesheim" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1080 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0111> ;
        schema:name "Windesheim (gemeente Zwolle)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "De Herv. begraafplaats (Pastorieweg ong.) is aangelegd in 1834. Hier ligt het familiegraf van de heren van Windesheim, bestaande uit vier grafzerken en een monument met natuurstenen sokkel en gietijzeren bovenbouw voorzien van ornamenten als fakkels en een bekronende urn. Het gietijzerwerk is uitgevoerd door Nering Bögel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

