        schema:name "Wilsum (gemeente IJsselmuiden)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Dijkdorp langs de IJssel waarvan de kerk in 1170 tot parochiekerk werd verheven. Op de dijk, een belangrijke verbinding tussen Kampen en Zwolle, liet Karel van Gelre in 1527 een verschansing aanleggen, die echter al in 1528 werd verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0110.php> .

