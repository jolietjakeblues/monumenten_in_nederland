        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Woonhuizen. In Glanerbrug staan nog slechts enkele vermeldenswaardige woningen, waaronder het brede woonen winkelpand Gronausestraat 1251-1253 uit omstreeks 1900 in chaletstijl en het woonhuis met vakwerkelementen Schipholtstraat 13 uit omstreeks 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0042.php> .

