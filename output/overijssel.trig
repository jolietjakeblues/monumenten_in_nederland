        schema:name "Vollenhove (gemeente Brederwiede)"@nl ;
        schema:pageEnd "264" ;
        schema:pageStart "264" ;
        schema:pagination "264" ;
        schema:text "De Geref. kerk (Vrijgemaakt) (Kerkstraat 25) [4] is een uit 1912 daterende sobere zaalkerk met spitsboogvensters voorzien van gietijzeren traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0099.php> .

