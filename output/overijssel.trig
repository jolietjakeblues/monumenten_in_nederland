        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0020> ;
        schema:name "Buurse (gemeente Haaksbergen)"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "De Harrevelder Schans ten westen van Buurse, tussen de Buurserbeek en de Buurserstraat, is een vervallen vierhoekige, gebastionneerde schans, waarschijnlijk daterend uit omstreeks 1590."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/00293> a min:Passage,
