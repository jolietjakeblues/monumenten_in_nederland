        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Overijssel> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zenderen (gemeente Borne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01> ;
        min:kern "Zenderen" ;
        min:provincie "Overijssel" ;
        min:soort "inleiding" ;
        min:volgnummer 1097 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0113> ;
        schema:name "Zenderen (gemeente Borne)"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "De Zwanenhof (Zwanenhofweg 1) is een fors drielaags gebouw op U-vormige plattegrond, in 1926 gebouwd als retraitehuis in opdracht van de paters redemptoristen, op verzoek van de rooms-katholieke boeren- en vakbonden. Nu is het een religieus bezinningsoord. Rond het gebouw ligt een geometrische tuinaanleg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0113.php> .

