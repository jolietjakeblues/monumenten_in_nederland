        min:volgnummer 317 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/hoofdstuk/0023> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "Begraafplaatsen. De Alg. begraafplaats (Mulertlaan ong.) werd in 1805 gesticht. De grafkelder van de familie Van Dedem heeft een verzonken ingang; een granieten fronton draagt het familiewapen. De ten noorden van het dorp gelegen Isr. begraafplaats (Gerner Es ong.) werd in 1855 aangelegd en in 1927 gesloten. Er liggen zestien grafstenen, waaronder die van de families Van Essen en Steren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0023.php> .

