        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "Windmolen ‘De Windesheimer molen’ (Hollewandsweg 33) is een achtkante rietgedekte stellingkorenmolen op hoten onderbouw en lage stenen voet, gebouwd in 1748."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu03_01/sten009monu03_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu03_01/passage/01085> a min:Passage,
