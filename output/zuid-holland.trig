        min:volgnummer 239 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0008-01> ;
        schema:name "Aarlanderveen (gemeente Alphen aan den Rijn)"@nl ;
        schema:pageEnd "71" ;
        schema:pageStart "71" ;
        schema:pagination "71" ;
        schema:text "Ontginningsdorp, ontstaan in de middeleeuwen en ontgonnen vanaf de Oude Rijn. De bebouwing ontwikkelde zich langs de as Zuideinde-Dorpsstraat-Noordeinde met aan weerszijden lagere polders."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0008.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00240> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aarlanderveen (gemeente Alphen aan den Rijn)"@nl ;
        min:adres "Noordeinde 24",
            "Noordeinde 26" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aarlanderveen (gemeente Alphen aan den Rijn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Aarlanderveen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 240 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0008-01> ;
        schema:name "Aarlanderveen (gemeente Alphen aan den Rijn)"@nl ;
        schema:pageEnd "71" ;
        schema:pageStart "71" ;
        schema:pagination "71" ;
        schema:text "De R.K. kerk St.-Petrus en St.-Paulus (Noordeinde 24) is een driebeukige basilicale kruiskerk met driezijdig gesloten koor en een toren van vier geledingen met naaldspits. Deze door J.Th.J. Cuypers met neogotische elementen ontworpen kerk kwam in 1893-'94 tot stand ter vervanging van een voorganger uit 1778. Tot de inventaris behoren een 18de-eeuws doopvont, enkele door atelier Cuypers vervaardigde heiligenbeelden (1867), een Maarschalkerweerd-orgel (1882) en neogotische altaren en een preekstoel van J.P. Maas (alle circa 1895). De L-vormige pastorie (Noordeinde 26) uit 1891 is eveneens ontworpen door Cuypers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0008.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00241> a min:Passage,
