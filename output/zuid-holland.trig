        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29872",
            "29873" ;
        min:soort "inleiding" ;
        min:volgnummer 1783 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0164> ;
        schema:name "Stad aan 't Haringvliet (gemeente Middelharnis)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Het voorm. raadhuis (Voorstraat 28-30) heeft een gepleisterde voorgevel en neoclassicistische wenkbrauwen boven de vensters. Het werd in 1845 gebouwd als onderwijzerswoning, met de achterliggende tweeklassige school en op de verdieping een raadzaal en de secretarie. Van 1880 tot 1966 diende het gebouw in zijn geheel als raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01784> a min:Passage,
