        min:volgnummer 2032 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0193> ;
        schema:name "Zwartewaal (gemeente Brielle)"@nl ;
        schema:pageEnd "550" ;
        schema:pageStart "550" ;
        schema:pagination "550" ;
        schema:text "De Herv. kerk (Schoolstraat 5), oorspronkelijk gewijd aan St. Martinus, is een eenbeukige kerk met vijfzijdig gesloten koor. Het begin 15de eeuw gebouwde schip kreeg rond 1540 een hoger laat-gotisch koor. De in 1597 opgerichte geveltoren bevat een door Pieter Bakker gegoten klok (1770). Tot de inventaris van deze in 1939-'46 en 1992-'93 gerestaureerde kerk behoren een preekstoel (tweede helft 17de eeuw) en een door Bakker & Timmenga gebouwd orgel (1902)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0193.php> .

