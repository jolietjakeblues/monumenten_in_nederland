        schema:name "Zuid-Beijerland (gemeente Korendijk)"@nl ;
        schema:pageEnd "547" ;
        schema:pageStart "547" ;
        schema:pagination "547" ;
        schema:text "Dijkdorp met langgerekte bebouwing, ontstaan na de bedijking van de Polder Groot-Zuid-Beijerland (1631) en oorspronkelijk ook Den Hitzert genoemd. Het dorp werd in 1671 een zelfstandige kerkgemeente. Na de Watersnoodramp van 1953 is het dorp aan de noordzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02006> a min:Passage,
            schema:CreativeWork ;
