        min:kern "Oud-Beijerland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51464>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55215> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "31920",
            "31921" ;
        min:soort "inleiding" ;
        min:volgnummer 1413 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill569>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill570> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0128> ;
        schema:name "Oud-Beijerland"@nl ;
        schema:pageEnd "391" ;
        schema:pageStart "390" ;
        schema:pagination "390-391" ;
        schema:text "De Herv. kerk (bij Waterstal 3) is een kruiskerk met aanbouwen en een toren van vijf geledingen met ingesnoerde naaldspits. De eerste steen van het schip werd in 1567 gelegd. De gotiserende toren met overhoekse steunberen verrees in 1604 en bevat een door Henricus Meurs gegoten klok (1604). Het noorder- en zuidertransept volgden respectievelijk in 1621 en 1650. Het huidige koorgedeelte met aanbouwen kwam in 1924 tot stand, waarbij de grafkapel van Sabina van Egmond († 1614) verdween. Het interieur van de in 1892 gerestaureerde kerk wordt gedekt door houten tongewelven en heeft in het dwarsschip 19de-eeuwse galerijen. Tot de inventaris behoren een doophek (1625) en preekstoel (midden 17de eeuw), een rouwbord in Lodewijk XVI-stijl (1794) en een door C. van Oeckelen gebouwde orgelkast (1827; verbouwd 1967). Vijf gebrandschilderde ramen (1945-'54) naar ontwerp van M.A.C. Meischke zijn door E. Warffemius uitgevoerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01414> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Beijerland"@nl ;
        min:adres "Karel Doormanstraat 9-11" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
