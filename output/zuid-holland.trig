        min:adres "Burg. Van Akenwijk 6",
            "Dorpsstraat 152",
            "Kerkstraat 10" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hendrik-Ido-Ambacht" ;
        min:gemeenteInBoek "Hendrik-Ido-Ambacht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hendrik-Ido-Ambacht_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hendrik-Ido-Ambacht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Hendrik-Ido-Ambacht" ;
        min:lemma "Overige kerken" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 827 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0060> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text """Overige kerken. Uit circa 1940 dateert de voorm. R.K. kerk (Burg. Van Akenwijk 6), een robuuste eenbeukige kerk in traditionalistische vormen. De Petrakerk van de Geref.

Gemeente (Kerkstraat 10) is een opvallend grote moderne kerk, die rond 1990 een kerkgebouw uit 1898 verving.

Het voorm. raadhuis (Dorpsstraat 152) is een eenlaagspand uit 1897 met een hoger opgetrokken ingangsrisaliet, voorzien van balkon en gemeentewapen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00828> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hendrik-Ido-Ambacht – Boerderijen"@nl ;
        min:adres "Achterambachtseweg 37",
