        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0084> ;
        schema:name "Leiden"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Het koorfragment van de O.L.-Vrouwekerk (tegenover Vrouwenkerkhof 11) [4] is een laatgotisch restant van een in 1406 voltooide bouwfase van de O.L.-Vrouwekerk aan de Haarlemmerstraat, die rond 1635 als hoofdkerk van de Waalse gemeente ging dienen. De kerk werd in 1818 gedeeltelijk gesloopt en de toren volgde in 1840."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01017> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leiden"@nl ;
        min:adres "Steenschuur 19" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
