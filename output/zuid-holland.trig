        schema:pageEnd "376" ;
        schema:pageStart "375" ;
        schema:pagination "375-376" ;
        schema:text "De voorm. R.K. jongensschool, nu Herv. centrum ‘Sartorius’ (Voorstraat 55a) (naar stichter van de Latijnse school), werd in 1885 in neorenaissancestijl gebouwd in opdracht van R.K. parochie, in 1882 eigenaar geworden van het perceel, en het pand Voorstraat 55 (voorm. Franse meisjesschool)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0119.php> .

