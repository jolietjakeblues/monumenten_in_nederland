        min:kern "Nieuwkoop" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44462>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49960> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30525",
            "30526" ;
        min:soort "inleiding" ;
        min:volgnummer 1267 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0112> ;
        schema:name "Nieuwkoop"@nl ;
        schema:pageEnd "366" ;
        schema:pageStart "366" ;
        schema:pagination "366" ;
        schema:text "De Herv. kerk (Reghthuysplein 18) is een driezijdig gesloten zaalkerk met houten klokkentoren, die in 1821-'22 een eerdere kerk ter plaatse verving. Het portaal aan de noordzijde dateert uit 1951. Bij de restauratie in 1984-'85 is een nieuwe consistorie toegevoegd. De kerk bevat enkele 17de-eeuwse grafzerken en een in 1874 aangekocht 18de-eeuwse orgel (kast 1907)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0112.php> .

