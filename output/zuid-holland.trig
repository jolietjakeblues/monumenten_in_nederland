        min:lemma "Horeca" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11621>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56016> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29779",
            "29862" ;
        min:soort "lemma" ;
        min:volgnummer 485 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0032> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Horeca. Het hotelpand Kaai 2 verrees rond 1875 in eclectische vormen. Tegen de zijgevel werd rond 1910 een kleine winkel aangebouwd. Het voorm. hotel Brooshooft (Voorstraat 39) is een fors drielaags pand uit circa 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00486> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dirksland – Windmolens"@nl ;
        min:adres "Voorstraat 1",
            "Vroonweg 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Dirksland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dirksland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Dirksland" ;
        min:lemma "Windmolens" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 486 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0032> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text """Windmolens. Van de voorm. poldermolen Burg. C. Zaaijerlaan 54, een ronde grondzeiler uit 1731, resteert de romp. Bij de ombouw tot gemaal in 1915 heeft men de romp afgeknot, gepleisterd en voorzien van een ingang met fronton. Binnen bevindt zich een dieselmoter (firma Smulders) uit die tijd. Windmolen De Eendracht (bij Vroonweg 9) is een wit geschilderde ronde stellingmolen met een met schaliën gedekte kap. Deze in 1846 gebouwde korenmolen is in 1980-'81 gerestaureerd.

De voorm. smederij Voorstraat 37 is een diep pand met ingezwenkte lijstgevel (circa 1860), met daarvoor een houten travalje en een wielsteen in de bestrating.

De watertoren (Voorstraat 1) verrees in 1939-'41 naar ontwerp van J. Gerber. Deze met baksteen beklede ronde toren heeft een koperen bekroning met slanke spits in traditionalistische vormen en een betonnen vlakbodemreservoir."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00487> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dirksland – Begraafplaatsen"@nl ;
        min:adres "Kapoenstraat 5" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
