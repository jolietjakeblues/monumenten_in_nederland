        min:gemeenteInBoek "Liemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nieuwkoop_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwveen (gemeente Liemeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwveen" ;
        min:lemma "Verkeersbruggen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1292 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0115> ;
        schema:name "Verkeersbruggen"@nl ;
        schema:pageEnd "370" ;
        schema:pageStart "370" ;
        schema:pagination "370" ;
        schema:text "Verkeersbruggen. De ophaalbrug over het Drechtkanaal (bij Nieuwveens Jaagpad 2) is een ijzeren vakwerkbrug uit 1940. De hameistijlen zijn aan de onderzijde verbreed en voorzien van vakwerkkwadranten. Over het Aarkanaal ligt de Kattenbrug (Oude Nieuwveenseweg 139), in haar huidige vorm een bredere kopie uit 1995 van de oorspronkelijke ijzeren ophaalbrug uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01293> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwveen (gemeente Liemeer) – Boerderijen"@nl ;
        min:adres "Bloklandseweg 18",
            "Bloklandseweg 28",
            "Geerweg 97",
            "Hogendijk 1",
            "Noordeinde 26",
            "Noordeinde 28",
            "Oude Nieuwveenseweg 70",
            "Uiterbuurtweg 5" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Nieuwkoop" ;
        min:gemeenteInBoek "Liemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nieuwkoop_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwveen (gemeente Liemeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwveen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60806> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30607" ;
        min:soort "lemma" ;
        min:volgnummer 1293 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0115> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "370" ;
        schema:pagination "370-371" ;
        schema:text """Boerderijen. Na het droogvallen van de Polder Nieuwkoop (1809) en de Polder Zevenhoven (1812) werden nieuwe boerderijen gebouwd, zoals de St.-Nicolaashoeve (Hogendijk 1; circa 1850) met zomerhuis en St.-Nicolaasbeeld. Voorbeelden van langhuisboerderijen zijn de vroeg-19de-eeuwse boerderij Livonia (Uiterbuurtweg 5) en de rond 1870 met ingangsomlijsting en zomerhuis gebouwde boerderijen Westerpolder (Oude Nieuwveenseweg 70) en Rijndervreugd (Geerweg 97). Een villa-achtig voorhuis heeft de boerderij Blokland 25 (circa 1925). Ten noordoosten van Nieuwveen staan enkele langhuisboerderijen met Russische namen, zoals de deels onderkelderde boerderij Kazan (Bloklandseweg 28; circa 1870) en de met zomerhuis uitgevoerde boerderij Smolensk (Bloklandseweg 18; 1887).

De R.K. St.-Joannes de Doperkerk te Noordeinde (Noordeinde 26), gelegen ten oosten van Nieuwveen, is een driebeukige zaalkerk met smaller, recht gesloten koor, doopkapel en een ongelede toren met vierzijdige spits. Deze door J.P. Dessing ontworpen traditionalistische kerk kwam in 1936 tot stand ter vervanging van een voorganger uit 1834. De naastgelegen pastorie (Noordeinde 28) dateert uit 1842. Het kerkhof heeft een Lourdesgrot (circa 1940)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01294> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwveen (gemeente Liemeer) – Zevenhoven"@nl ;
        min:adres "Dorpsstraat 11",
            "Dorpsstraat 12",
            "Kade 15",
            "Stationsweg 15" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Nieuwkoop" ;
        min:gemeenteInBoek "Liemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nieuwkoop_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwveen (gemeente Liemeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwveen" ;
        min:lemma "Zevenhoven" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1294 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0115> ;
        schema:name "Zevenhoven"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "Zevenhoven. Dit ontginningsdorp ten zuidoosten van Nieuwveen is ontstaan in de middeleeuwen. In 1835-'37 gebouwd ter vervanging van een oudere voorganger is de Herv. kerk (Dorpsstraat 12), een brede zaalkerk. De voorgevel en de ongelede toren met opengewerkte lantaarn en ingesnoerde spits dateren uit 1937. Tot de inventaris behoren een preekstoel (1787) en een door de firma A. Standaart gebouwd orgel (1926). De in 1915 opgetrokken pastorie (Dorpsstraat 11) heeft in de gevel een tegelfries. De Geref. kerk (Stationsweg 15), een wit geschilderde zaalkerk met tuitgevel, dateert uit 1909. Het woonhuis Dorpsstraat 14-16 is een middenganghuis uit circa 1870. De in 1915 ten oosten van Zevenhoven gebouwde boerderij ‘De Eensgezindheid’ (Kade 15) heeft een fraai ajourgezaagde topgeveldecoratie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01295> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordeloos (gemeente Giessenlanden)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
