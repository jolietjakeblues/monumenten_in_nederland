            "Heereweg 465",
            "Vuursteeglaan 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Lisse" ;
        min:gemeenteInBoek "Lisse" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lisse_(gemeente)> ;
