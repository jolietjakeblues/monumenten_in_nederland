        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14033>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44793>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51459> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "17026",
            "17027",
            "19944" ;
        min:soort "inleiding" ;
        min:volgnummer 660 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0044> ;
        schema:name "Gouderak (gemeente Ouderkerk)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "De Herv. kerk (Kerkstraat 3) is een eenbeukige kerk met driezijdig gesloten koor en een geveltoren met ingesnoerde spits, gebouwd in 1658 in gotiserende stijl. In de westgevel zijn het bouwjaar en het wapen van Gouderak (twee zespuntige sterren) in rode baksteen aangebracht. In de met leien beklede geveltoren (vermoedelijk vernieuwd 1718) hangt een door François Hemony gegoten klok (1661). Bij de restauratie in 1949-'52 heeft men het buitenpleisterwerk verwijderd en een klein historiserend portaal toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00661> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouderak (gemeente Ouderkerk)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Ouderkerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouderak (gemeente Ouderkerk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouderak" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 661 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0044> ;
        schema:name "Gouderak (gemeente Ouderkerk)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf met trekbalken op korbeelstellen, aangebracht bij een inwendige verbouwing in 1851. Tot de inventaris behoren een preekstoel met lezenaar (circa 1830), afkomstig uit de voorm. Remonstr. kerk te Utrecht, en een door P. Flaes gebouwd orgel (1887-'88). Verder bevat de kerk oude grafzerken, waaronder die van de stichter van de kerk, schout Jan Brouc († 1659), en die van ds. J.G. Staringh († 1804)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00662> a min:Passage,
