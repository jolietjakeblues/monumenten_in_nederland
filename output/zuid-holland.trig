        min:gemeenteInBoek "Waddinxveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waddinxveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waddinxveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Waddinxveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22131> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "38203" ;
        min:soort "inleiding" ;
        min:volgnummer 1915 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0180> ;
        schema:name "Waddinxveen"@nl ;
        schema:pageEnd "525" ;
        schema:pageStart "525" ;
        schema:pagination "525" ;
        schema:text "De Remonstr. kerk (Zuidkade 59) is een eenvoudige neoclassicistische zaalkerk met rondboogvensters, gebouwd in 1835-'36 en gerestaureerd in 1986. Het interieur met stucgewelf op pilasters bevat een preekstoel en doophek in empire-stijl en een door B.J. Gabry en J.F. Indermauer gebouwd orgel (1825)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0180.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01916> a min:Passage,
