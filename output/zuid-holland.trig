        min:soort "lemma" ;
        min:volgnummer 959 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0078> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Begraafplaatsen. De in 1828 gestichte Oude Alg. begraafplaats (bij IJsseldijk 359) was in gebruik tot 1915. Interessant is de grafsteen voor L.J. Lans Jongebreur († 1866). De Nieuwe Alg. begraafplaats (IJsseldijk 146) heeft een wit gepleisterd poortgebouw (1914-'15)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00960> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Nederlek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Krimpen aan de Lek (gemeente Nederlek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Krimpen aan de Lek" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 960 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0079> ;
        schema:name "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Dijkdorp langs de Lek, ontstaan op een oeverwal en voor het eerst vermeld in 1064. Na de bedijking van de rivier in de 12de eeuw ontwikkelde zich een langgerekte nederzetting, die in de 15de eeuw een eigen kerk kreeg. Daarna ontstond een dorpskern bij de kerk en het veer op Kinderdijk. In de 19de eeuw werd de dijkbebouwing dichter en legde men insteekhavens aan voor de scheepsbouw. Krimpen is na 1950 aan de noordzijde uitgebreid in de polder en vergroeid met het oostelijker gelegen dijkgehucht Schuwacht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00961> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        min:adres "Dorpsstraat 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Nederlek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Krimpen aan de Lek (gemeente Nederlek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Krimpen aan de Lek" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 961 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0079> ;
        schema:name "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De Herv. kerk (Dorpsstraat 1), een zaalkerk met ranke toren en een achtzijdige kapel, kwam in 1939 tot stand naar een historiserend ontwerp van M.C.A. Meischke en W. Vermeer ter vervanging van de 15de-eeuwse dorpskerk. Daarvan zijn de preekstoel (1615) en een rijk gesneden doophek (circa 1730) met koperen doopboog (1773) bewaard gebleven. In 2003 is de kerk gerestaureerd en aan de oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0079.php> .

