            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53985>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59447> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "19949",
            "19950",
