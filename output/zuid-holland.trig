        min:volgnummer 1844 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0173> ;
        schema:name "Vianen"@nl ;
        schema:pageEnd "505" ;
        schema:pageStart "505" ;
        schema:pagination "505" ;
        schema:text "De R.K. kerk O.L. Vrouwe Hemelvaart (Brederodestraat 2) [4] is een driebeukige hallenkerk met driezijdig gesloten koor, een zijkoor, een sacristie en een westfront met drie forse tuitgevels. Deze neogotische kerk verrees in 1877-'78 naar plannen van A. Tepe ter plaatse van een voorganger uit 1808."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0173.php> .

