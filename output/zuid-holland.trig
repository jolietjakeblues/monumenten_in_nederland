        min:gemeenteInBoek "Westvoorne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westvoorne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostvoorne (gemeente Westvoorne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Oostvoorne" ;
        min:lemma "Huis Overburch" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14562> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "38886" ;
        min:soort "lemma" ;
        min:volgnummer 1397 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0125> ;
        schema:name "Huis Overburch"@nl ;
        schema:pageEnd "388" ;
        schema:pageStart "388" ;
        schema:pagination "388" ;
        schema:text "Huis Overburch (Hoflaan 17) is een langgerekt pand met aanbouwen, waarvan de kern van kort na een brand in 1456 dateert. Binnen bevindt zich een laat-gotische schouw. Het diende als onderkomen voor het Oostvoorns kapittel. Na 1571 volgde de verbouwing tot boerderij, door toevoeging van een lagere tweede beuk. Na stormschade in 1911 werd het gebouw in 1921 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01398> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostvoorne (gemeente Westvoorne) – Boerderijen"@nl ;
        min:adres "Heveringseweg 25",
            "Kranenhoutlaan 1",
            "Molendijk 23" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Westvoorne" ;
        min:gemeenteInBoek "Westvoorne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westvoorne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostvoorne (gemeente Westvoorne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Oostvoorne" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45732>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46969> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "38885",
            "38892" ;
        min:soort "lemma" ;
        min:volgnummer 1398 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill566> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0125> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "389" ;
        schema:pageStart "388" ;
        schema:pagination "388-389" ;
        schema:text """Boerderijen. De herenboerderij Kooysigt (Heveringseweg 25) heeft een gepleisterd breed eenlaags woonhuis met omlijste ingang, mogelijk daterend uit 1702. Het diende als zomerhuis voor rijke Brielenaren en werd in 1949-'50 ingrijpend verbouwd. Voorbeelden van kleine duinboerderijen met een dwarsdeelschuur en een iets smaller woongedeelte zijn Duinoordseweg 2 (circa 1850), Heveringseweg 66 (circa 1880) en F.H.G. van Itersonlaan 58 (schuur 1866, woonhuis 1888).

De windmolen (Molendijk 23) is een ronde grondzeiler met een met dakleer beklede kap, gebouwd in 1821 als korenmolen.

Het voorm. TB-huisje (Kranenhoutlaan 1) is een draaibaar lighuisje in chaletstijl bestemd voor een tuberculosepatiënt. Het werd kort na 1911 gebouwd, toen notaris L.P. van den Brink het landgoed Kranenhout kocht.

Het gedenkteken voor burgemeester N.J.G.S.H. Lette (Dorpsplein ong.) is in 1912 opgericht in de vorm van een hardstenen postament.

De voorm. batterij Quack (Heindijk ong.), ten noordoosten van Oostvoorne, werd aangelegd in 1782 en opgeheven in 1918. Bij de restanten van deze kustbatterij staat een in 1957 gereconstrueerde bakstenen kogelgloeioven uit circa 1782. De hier roodgloeiend verhitte kogels werden naar schepen afgevuurd om die in brand te steken."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01399> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostvoorne (gemeente Westvoorne) – Tinte"@nl ;
        min:adres "Kade 1-3",
            "Strijpsedijk 48",
            "Strijpsedijk 50" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Westvoorne" ;
        min:gemeenteInBoek "Westvoorne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westvoorne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostvoorne (gemeente Westvoorne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Oostvoorne" ;
        min:lemma "Tinte" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1399 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0125> ;
        schema:name "Tinte"@nl ;
        schema:pageEnd "389" ;
        schema:pageStart "389" ;
        schema:pagination "389" ;
        schema:text "Tinte. Dit dijkdorp ten zuidoosten van Oostvoorne is ontstaan in de 19de eeuw. Van de L-vormige boerderij Kade 7 is de haaks op de dijk staande schuur met zijlangsdeel nog vroeg-19de-eeuws. Naar plannen van Tj. Kuipers verrees in 1908 de Geref. kerk (Strijpsedijk 50), een zaalkerk met dakruiter en aangebouwde consistorie. De voorm. openbare lagere school (Kade 1-3) werd in 1918 gebouwd als drieklassige school met gymlokaal en aangebouwde onderwijzerswoning. De Chr. lagere school (Strijpsedijk 48) is een vierklassige middengangschool uit 1922. Uit 1924 dateert het woonhuis Colinslandsedijk 16-18, met aangebouwde timmermanswerkplaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01400> a min:Passage,
