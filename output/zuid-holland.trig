        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "527525" ;
        min:soort "lemma" ;
        min:volgnummer 1182 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0099> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "Poldermolens. Langs de Rottedijk ten westen van Moerkapelle staan zes 18de-eeuwse molenrompen (Rottedijk 2, 6, 10, 12, 14 en 16). Vijf daarvan zijn restanten van de achtkante onderbouw van een grondzeiler, die van de molen De Oorsprong (Rottedijk 14) is een met riet gedekt ondertoren van een wipmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01183> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Graafstroom" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Molenaarsgraaf (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Molenaarsgraaf" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0100> ;
        schema:name "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "Langgerekt ontginningsdorp, ontstaan in de tweede helft van de 13de eeuw langs de in die tijd door toedoen van Willem de Molenaar gegraven, kaarsrechte Graafstroom. De ontginning aan de zuidzijde (Polder Molenaarsgraaf) - met (latere) bebouwing tussen de Graafstroom en de parallel daaraan lopende voorwetering (Molenaarsgraaf) - is iets ouder dan de vergelijkbare ontginning aan de noordzijde met het lintdorp Gijbeland. Het noordelijker gelegen Brandwijk ontstond als secundaire ontginning vanuit Gijbeland. Gijbeland en Brandwijk vormden tot 1986 één zelfstandige gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01184> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        min:adres "Dorpsstraat 28",
            "Dorpsstraat 32" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Graafstroom" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Molenaarsgraaf (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Molenaarsgraaf" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57510>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62251> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29952",
            "29953" ;
        min:soort "inleiding" ;
        min:volgnummer 1184 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill512> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0100> ;
        schema:name "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "De Herv. kerk (Dorpsstraat 28) is een eenbeukige kerk met driezijdig gesloten koor. Dit laat-gotische koor kwam rond 1525 tot stand op de onderbouw van een verzakte voorganger, getuige de dichtgezette vensters in het metselwerk onder de huidige koorvensters. Het rond 1550 opgetrokken schip heeft steunberen met bakstenen pinakels. In de achtzijdige dakruiter (begin 17de eeuw) hangt een door Claes Noorden en Jan Albert de Grave gegoten klok (1710). Het classicistische ingangsportaal is 18de-eeuws. De in 1902-'03 aangebrachte gevelbepleistering heeft men verwijderd bij de restauratie in 1960-'62. Het interieur wordt gedekt door een houten tongewelf (schip) en een vijfzijdig houten koorgewelf. Tot de inventaris behoren een preekstoel (tweede kwart 17de eeuw), een herenbank (17de eeuw) en diverse grafzerken (oudste uit 1526). Op het kerkhof met gietijzeren hek (circa 1870) staat een kleine aula (circa 1960). Rond 1850 verrees de forse pastorie (Dorpsstraat 32)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01185> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        min:adres "Gijbelandsedijk 54" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Graafstroom" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Molenaarsgraaf (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Molenaarsgraaf" ;
