        min:kern "Nieuwenhoorn" ;
        min:lemma "Fort Noorddijk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1252 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Fort Noorddijk"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Fort Noorddijk (Noorddijk ong.) werd in 1883-'84 opgeworpen als onderdeel van de ‘Stelling van de Monden der Maas en van het Haringvliet’ ter vervanging van enkele uit 1780 daterende aardwerken. Het omgrachte fort bevat een bomvrij gebouw met wachtlokaal en geschutsremise."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

