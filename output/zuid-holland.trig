        rdfs:label "Bodegraven"@nl ;
        min:adres "Pastorieplein 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Bodegraven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bodegraven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bodegraven" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 360 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0023> ;
        schema:name "Bodegraven"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De voorm. pastorie (Pastorieplein 4; circa 1850) is een neoclassicistisch herenhuis met geblokt gepleisterde hoeklisenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00361> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bodegraven"@nl ;
        min:adres "Overtocht 18" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Bodegraven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bodegraven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bodegraven" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 361 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0023> ;
        schema:name "Bodegraven"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De R.K. St.-Willibrorduskerk (Overtocht 18) is een driebeukige basilicale kruiskerk met driezijdig gesloten koor en een toren van drie geledingen met hoektorentjes en achtzijdige spits. Deze neogotische kerk verrees in 1862-'64 naar plannen van P.J.H. Cuypers en verving een schuilkerk (1643). De toren werd in 1867 voltooid naar een gewijzigd ontwerp met lagere hoektorentjes. Bij een brand in 1982 gingen de bekapping en het monumentale Franssen-orgel (1874) verloren. Na het herstel heeft men uit de afgebroken Dominicuskerk te Alkmaar het middendeel van het Maarschalkerweerd-orgel (1897) overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00362> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bodegraven"@nl ;
