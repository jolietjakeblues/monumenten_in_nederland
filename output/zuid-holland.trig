        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0079> ;
        schema:name "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 7) is een fors pand in neorenaissance-stijl, gebouwd rond 1890 als woonhuis van de familie Boogaerdt en vanaf circa 1920 tot 1995 in gebruik als raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0079.php> .

