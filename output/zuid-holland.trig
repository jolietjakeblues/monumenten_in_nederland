        schema:name "Boerderijen"@nl ;
        schema:pageEnd "421" ;
        schema:pageStart "421" ;
        schema:pagination "421" ;
        schema:text "Boerderijen. Voorbeelden van bij Rockanje gelegen kleine duinboerderijen met een dwarsdeelschuur en een iets smaller woongedeelte zijn Noorddijk 16 (circa 1900) en Schapengorsedijk 3 (1908)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01585> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rockanje (gemeente Westvoorne) – Olaertsduyn"@nl ;
        min:adres "Windgatseweg 1b",
            "Windgatseweg 2" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
