        min:hoofdstuk "Steden, dorpen, monumenten › Boskoop" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Boskoop" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26254> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "511500" ;
        min:soort "inleiding" ;
        min:volgnummer 371 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0024> ;
        schema:name "Boskoop"@nl ;
        schema:pageEnd "95" ;
        schema:pageStart "95" ;
        schema:pagination "95" ;
        schema:text "De Herv. kerk (Kerkplein 1) is een kruiskerk met een toren van vier geledingen voorzien van balustrade en naaldspits. Deze naar ontwerp van H.J. Nederhorst (1895) in neorenaissancestijl gebouwde kerk heeft aan de koorzijde een omlijste hoofdingang met dorische pilasters en bevat een door de firma Bätz & Co. gebouwd orgel (1897)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00372> a min:Passage,
