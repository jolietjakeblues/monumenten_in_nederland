        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0082> ;
        schema:name "Leerbroek (gemeente Zederik)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Langgerekt ontginningsdorp, ontstaan als cope-ontginning in de 12de eeuw met de Leerbroekseweg en het Recht van ter Leede (de verdwenen veenstroom Leede) als ontginningsbasis. Een kleine dorpskern vormde zich na 1900 bij de kerk en na de Tweede Wereldoorlog is het dorp aan de noordzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00981> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerbroek (gemeente Zederik)"@nl ;
        min:adres "Dorpsweg 10" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
