        min:volgnummer 1730 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0158> ;
        schema:name "Schoonhoven"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "Het voorm. oudemannen- en vrouwenhuis (Koestraat 109) [9] is een statig drielaags woonhuis met een pronkrisaliet in Lodewijk XV-stijl (circa 1760). Het heeft van 1898 tot 1968 gediend als oudeliedenhuis. De twee gevelstenen (1646) zijn afkomstig van een verdwenen buurpand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01731> a min:Passage,
