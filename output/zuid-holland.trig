        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijsoord (gemeente Ridderkerk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Rijsoord" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23580> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "32515" ;
        min:soort "inleiding" ;
        min:volgnummer 1550 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill612> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0148> ;
        schema:name "Rijsoord (gemeente Ridderkerk)"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "414" ;
        schema:pagination "414-415" ;
        schema:text "De Herv. kerk (Rijksstraatweg 43) is een dwars geplaatste zaalkerk met voorbouw en opengewerkte dakruiter. Deze kerk, uitgevoerd met neoclassicistische elementen en wenkbrauwen boven de vensters, verrees in 1832 ter plaatse van een voorganger. In 1852 werd de voorbouw toegevoegd. De westgevel heeft een natuurstenen portaal met opzetstuk in Lodewijk XV-stijl (1764). De gevelsteen met wapen (1661) in de zuidmuur is afkomstig van de gesloopte pastorie. Tot de inventaris behoren een laat-17de-eeuwse preekstoel en een door C.G.F. Witte vervaardigd orgel (1864; restauratie J.L. van den Heuvel 1973)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0148.php> .

