        min:volgnummer 509 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill175> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0033> ;
        schema:name "Dordrecht"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De R.K. kerk St.-Antonius van Padua (Burg. De Raadtsingel 45) [10] is een neogotische kruiskerk met vijfzijdig gesloten koor, gebouwd in 1920-'21 naar ontwerp van N. Molenaar (1916). Wegens geldgebrek konden de toren en een groot deel van het schip niet worden verwezenlijkt. Na een brand in 1945 heeft men het dak verlaagd en een nieuwe dakruiter geplaatst. De gebrandschilderde ramen zijn van F.H. Geuer (1921). De gelijktijdig gebouwde pastorie (Burg. De Raadtsingel 45) is een tweebeukig pand met tuitgevels in rationalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0033.php> .

