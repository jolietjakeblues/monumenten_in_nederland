    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00032> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ten geleide"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
