        min:lemma "Poldermolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35789>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42026> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "9344",
            "9349" ;
        min:soort "lemma" ;
        min:volgnummer 337 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0019> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "Poldermolen ‘De Valk’ (Molenweg 109), gelegen ten westen van Rodenrijs, is een achtkante grondzeiler uit 1772 met een met riet gedekte romp en kap en een scheprad. De molen bemaalde de Polder Berkel. Uit circa 1850 dateert de ernaast gelegen molenaarswoning (Molenweg 111)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00338> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berkenwoude (gemeente Bergambacht)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Bergambacht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berkenwoude (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Berkenwoude" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 338 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0020> ;
        schema:name "Berkenwoude (gemeente Bergambacht)"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "Ontginningsdorp, ontstaan in de 12de eeuw langs een als ontginningsas gegraven wetering. Een dorpskern met kerk ontstond in de 14de eeuw aan de haaks hierop staande Dorpsstraat/Kerkweg. Berkenwoude had te lijden van een dorpsbrand in 1708. Na de Tweede Wereldoorlog is het dorp aan de westzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00339> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berkenwoude (gemeente Bergambacht)"@nl ;
        min:adres "Dorpsstraat 18" ;
