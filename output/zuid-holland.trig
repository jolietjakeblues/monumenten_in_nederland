        min:volgnummer 1077 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0087> ;
        schema:name "Leimuiden (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De voorm. openbare lagere school (W. van der Veldenweg 69-71) is in 1874 gebouwd als een tweeklassige middengangschool met aangebouwde onderwijzerswoning voorzien van een ingezwenkte lijstgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01078> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leimuiden (gemeente Jacobswoude) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 41",
            "Vriezekoop Zuid 51-53",
            "W. van der Veldenweg 8" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leimuiden (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leimuiden" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1078 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0087> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text """Boerderijen. In de kern 18de-eeuws is de langhuisboerderij W. van der Veldenweg 43 met kelder en opkamer. Waardevol is ook de langhuisboerderij Weltevreden (W. van der Veldenweg 8) uit circa 1820 met gezwenkte voorgevel en haaks aangebouwd zomerhuis en spoelhok. De rond 1905 opgetrokken boerderij Dr. Stapenseastraat 24 heeft een dwars geplaatst woongedeelte. Woonhuizen. Het dwarse eenlaagspand W. van der Veldenweg 3 heeft mogelijk een oudere kern maar dateert in de huidige vorm uit circa 1820. Rond 1880 gebouwd is de voorm. onderwijzerswoning (Dorpsstraat 41) met neoclassicistische details. Vroeg-20ste-eeuws zijn de eenlaags villa's Dorpsstraat 30 (circa 1910) en Dr. Stapenseastraat 2 (circa 1915), beide met een haaks uitgebouwd tweelaags bouwdeel.

Het voorm. stoomgemaal ‘Van der Breggen’ aan de Drecht (Vriezekoop Zuid 51-53), gelegen ten oosten van Leimuiden, werd in 1879 gebouwd ter bemaling van de Wassenaarsche polder en in 1914 geëlektrificeerd. Het gebouw vertoont neoclassicistische invloeden."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01079> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lekkerkerk (gemeente Nederlek)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
