        min:volgnummer 1164 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0097> ;
        schema:name "Middelharnis"@nl ;
        schema:pageEnd "352" ;
        schema:pageStart "352" ;
        schema:pagination "352" ;
        schema:text "De voorm. Rijks Hogere Burger School (Burg. Mijslaan 5), een L-vormig tweelaags gebouw met hoektoren naast de ingang, werd gebouwd in 1916-'17 naar ontwerp van J.H. Hermelink. Het pand is momenteel in gebruik bij het Da Vinci College."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01165> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middelharnis – Lagere scholen"@nl ;
        min:adres "J. van Stolberglaan 17-19",
            "J. van Stolberglaan 42" ;
