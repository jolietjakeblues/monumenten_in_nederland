        min:gemeenteInBoek "Delft" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delft_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delft" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Delft" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 449 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0030> ;
        schema:name "Delft"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "De R.K. St.-Nicolaas en Gezellenkerk (Raamstraat 74) is een grote driebeukige basilicale kruiskerk met een door sacristie en catechisatiekamer geflankeerd, rond gesloten, koor en een terzijde staande zadeldaktoren. Deze kerk in neoromaans-Byzantijnse stijl werd in 1908-'10 gebouwd naar plannen van Jac. van Gils in de gemeente Hof van Delft. Het korte en brede schip geeft de kerk een centraliserende plattegrond. De kerk is versierd met grèstegels van ‘De Porceleyne Fles’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00450> a min:Passage,
