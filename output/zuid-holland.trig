        rdfs:label "Zoetermeer – Scholen"@nl ;
        min:adres "Dorpsstraat 114",
            "Dorpsstraat 35",
            "Dorpsstraat 99" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Zoetermeer" ;
        min:gemeenteInBoek "Zoetermeer" ;
