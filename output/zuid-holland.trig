        rdfs:label "Rijpwetering (gemeente Alkemade) – Poldermolens"@nl ;
        min:adres "Achterdijk 11",
            "Poeldijk 1",
            "Poeldijk 8" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
