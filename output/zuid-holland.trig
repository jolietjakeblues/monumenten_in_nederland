        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwerbrug (gemeente Bodegraven)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwerbrug" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1253 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0110> ;
        schema:name "Nieuwerbrug (gemeente Bodegraven)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Dijkdorp, ontstaan bij de plaats waar sinds 1510 een brug over de Oude Rijn ligt en waar van 1651 tot op heden tol wordt geheven. De lintbebouwing strekt zich uit op de oeverwal aan weerszijden van de brug."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01254> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwerbrug (gemeente Bodegraven)"@nl ;
        min:adres "Bruggemeesterstraat 11",
            "Bruggemeesterstraat 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Bodegraven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwerbrug (gemeente Bodegraven)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwerbrug" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1254 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0110> ;
        schema:name "Nieuwerbrug (gemeente Bodegraven)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De huidige tolbrug over de Oude Rijn, die in 1990 een gietijzeren voorganger uit 1909 verving, is een stalen ophaalbrug met daarop een ouder smeedijzeren tolbek. Het bijbehorende tolwachtershuis (Bruggemeesterstraat 9) is een eenvoudig dwars pand uit 1788. De ertegenaan gebouwde dorpstoren (Bruggemeesterstraat 11) kwam in 1913-'14 tot stand ter herdenking van de honderdjarige onafhankelijkheid van Nederland en heeft drie geledingen en een spits met frontalen (gerestaureerd 2001)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01255> a min:Passage,
