        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37985> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "513882" ;
        min:soort "inleiding" ;
        min:volgnummer 1610 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0152> ;
        schema:name "Rotterdam"@nl ;
        schema:pageEnd "429" ;
        schema:pageStart "429" ;
        schema:pagination "429" ;
        schema:text "De Remonstr. kerk (Museumpark 3) [7] is een forse kerk in neoromaanse vormen met twee torens van ongelijke hoogte, waarvan één met achtzijdige lantaarn. Deze in 1895-'97 naar plannen van H. Evers en J.P. Stok gebouwde kerk bevat een door de firma Steenkuyl & Recourt gebouwd orgel (1898, gerestaureerd 1978)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01611> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rotterdam"@nl ;
        min:adres "Mathenesserlaan 305-307" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Rotterdam" ;
        min:gemeenteInBoek "Rotterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rotterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rotterdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Rotterdam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11820> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "524366" ;
        min:soort "inleiding" ;
        min:volgnummer 1611 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0152> ;
        schema:name "Rotterdam"@nl ;
        schema:pageEnd "430" ;
        schema:pageStart "429" ;
        schema:pagination "429-430" ;
        schema:text "De R.K. kerk H.H. Laurentius en Elizabeth (Mathenesserlaan 305-307) [8], sinds 1964 kathedraal van het in 1956 opgerichte bisdom Rotterdam, is een in 1906-'08 gebouwde driebeukige kruisbasiliek in neoromaanse en neobyzantijnse vormen naar ontwerp van P.G. Buskens. In 1920-'22 werd de kerk voltooid met de bouw van een voorgevel met ongelijk dubbeltorenfront in neobyzantijnse trant naar ontwerp van J.P.J. Hendriks. In 1941 en 1944 leed de kerk oorlogsschade. De nieuwe gebrandschilderde ramen (1945-'52) zijn ontworpen door Ch. Eyck en H. Asperslagh. Het interieur bevat muurschilderingen en kruiswegstaties (1915-'29) van J. Dunselman en een perspex bisschopszetel (1990) van A.J.H.M. Haak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01612> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rotterdam"@nl ;
        min:adres "Nieuwe Binnenweg 25" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
