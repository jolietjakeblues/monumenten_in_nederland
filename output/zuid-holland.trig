        min:volgnummer 1313 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0118> ;
        schema:name "Noordwijk aan Zee (gemeente Noordwijk)"@nl ;
        schema:pageEnd "373" ;
        schema:pageStart "373" ;
        schema:pagination "373" ;
        schema:text "De R.K. Maria ter Zeekerk (Nieuwe Zeeweg 75) is een driebeukige kerk, gebouwd in 1950-'51 als toeristenkerk naar een ontwerp van J.A. van der Laan in de op de vroeg-christelijke kerkbouw gebaseerde traditionalistische vormen van de Bossche school. Opvallend zijn het omlopend fries met siermetselwerk in meandermotief en de vierkante vensteropeningen met brede latei en deelzuiltje. In 1964-'65 is de kerk aan de achterzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01314> a min:Passage,
