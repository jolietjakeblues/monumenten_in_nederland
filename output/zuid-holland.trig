            "Bosschieterstraat 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Goedereede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stellendam (gemeente Goedereede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Stellendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46089> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16269" ;
        min:soort "inleiding" ;
        min:volgnummer 1789 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0165> ;
        schema:name "Stellendam (gemeente Goedereede)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "De Herv. kerk (Bosschieterstraat 4) is een eenvoudige zaalkerk met dakruiter, gebouwd in 1819 in opdracht van ambachtsheer J.J. Cau. In de dakruiter hangt een door de gebroeders Van Bergen gegoten klok (1912). De haakse kerkuitbreiding dateert uit circa 1912. Tot de inventaris behoren een preekstoel en ouderlingenbank uit de bouwtijd en een orgelkast (1827) gemaakt voor het Evang. Luth. Weeshuis te Amsterdam (aangekocht 1955). De pastorie (Bosschieterstraat 2) is rond 1860 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01790> a min:Passage,
