        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Dijkdorp, ontstaan na de bedijking van de Polder Nieuwenhoorn (1367). De dorpsbebouwing ontwikkelde zich op de dijk. De kerk verrees aan de zuidzijde in de polder aan de haaks op de dijk gelegen Dorpsstraat. Doordat deze straat in 1821 werd verbreed - ten koste van een strook van het kerkhof - kreeg Nieuwenhoorn het karakter van een voorstraatdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01248> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        min:adres "Dorpsstraat 14" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwenhoorn (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwenhoorn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1248 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De Herv. kerk (Dorpsstraat 14) is een eenbeukige kerk voorzien van een sobere toren van vier geledingen met tentdak. Deze met overhoekse steunberen en rondboogfriezen uitgevoerde toren stamt waarschijnlijk uit de 15de eeuw en bevat een klok uit 1524. Gezien een gevelsteen uit 1515 aan de zuidzijde kwam het laat-gotische schip begin 16de eeuw tot stand. Dwarsschip en koor werden in 1851 gesloopt en vervangen door een neoclassicistische consistoriekamer naar plannen van C. Spoon. Het in 1966-'67 gerestaureerde kerkinterieur bevat een preekstoel met doophek (eind 17de eeuw), luifelbanken (1841) en een door G.T. en J. Bätz gebouwd orgel (1821)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01249> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        min:adres "Rijksstraatweg 243" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwenhoorn (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwenhoorn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1249 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Het voorm. raadhuis (Rijksstraatweg 243) is een breed tweelaags pand, gebouwd in 1832-'34 als raad- en polderhuis annex school en onderwijzerswoning. Het ontwerp is waarschijnlijk van C. Spoon. De wapensteen in Lodewijk XV-vormen (circa 1760) is van elders afkomstig. Het schoolgedeelte werd in 1871 uitgebreid. In de oude raadzaal bevinden zich behangselschilderingen van A. Luttenberg met scènes uit de vaderlandse geschiedenis (1838)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01250> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        min:adres "Rijksstraatweg 241" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwenhoorn (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwenhoorn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1250 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Nieuwenhoorn (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Van de voorm. openbare lagere school (Rijksstraatweg 241), gebouwd in 1881 als een vijfklassige school naar ontwerp van F.J. Nieuwenhuis, resteert nog een gedeelte met twee lokalen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01251> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwenhoorn (gemeente Hellevoetsluis) – Woonhuizen"@nl ;
        min:adres "Breeweg 2",
            "Rijksstraatweg 254a",
            "Rijksstraatweg 274",
            "Rijksstraatweg 280" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwenhoorn (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwenhoorn" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1251 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0109> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text """Woonhuizen. De uit circa 1860 daterende notabelenwoning Dorpsstraat 15 heeft een sobere neoclassicistische vorm en is aan beide zijden voorzien van afluivingen. Uit 1864 dateren de eenlaagspanden Slop 4-6. Voorbeelden van middenganghuizen uit circa 1880 zijn Rijksstraatweg 282 en Rijksstraatweg 229 (met wenkbrauwen). Vergelijkbaar, is het huis Rijksstraatweg 223 (circa 1880), maar het heeft een attiekverdieping. Een torenvormig opgetrokken middenpartij heeft het middenganghuis Rijksstraatweg 152 (circa 1910). Rond 1910 opgetrokken met jugendstil- en rationalistische details zijn de herenhuizen Dorpsstraat 10 en Hadewine (Rijksstraatweg 280) en de rentenierswoning Wilhelmina (Rijksstraatweg 274; 1912).

De windmolen ‘Zeezicht’ (Rijksstraatweg 254a) is een deels wit gepleisterde ronde grondzeiler met een met dakleer beklede kap, gebouwd in 1717 als korenmolen.

De boerderij ‘Waterrijk’ (Breeweg 2) ten noordwesten van Nieuwenhoorn is een zijlangsdeelboederij waarvan het met ingezwenkte lijstgevel uitgevoerde woongedeelte is gedateerd op 1816."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01252> a min:Passage,
