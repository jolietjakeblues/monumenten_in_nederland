        min:hoofdstuk "Steden, dorpen, monumenten › Sassenheim" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Sassenheim" ;
        min:lemma "Scholen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1663 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0154> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "457" ;
        schema:pageStart "457" ;
        schema:pagination "457" ;
        schema:text "Scholen. In 1898 verrees naar plannen van K. Huig de voorm. R.K. school (Hoofdstraat 167), een eclectisch tweelaags gebouw met driezijdig uitgebouwde gevelpartij en siermetselwerk in gele steen. De V-vormige Chr. lagere Kompasschool (J. van Beierenlaan 6) kwam in 1930 tot stand naar een zakelijk-expressionistisch ontwerp van C.G.J. Lohmann en C. Ponsen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01664> a min:Passage,
