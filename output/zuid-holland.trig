        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "Kerken. Uit 1956 dateren de zaalgebouwen van de Geref. kerk (Stationsstraat 20; J.M. Groeneveld en G. de Kluiver) en de Geref. kerk Vrijgemaakt (Buitendams 45; A. Penning)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00577> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessendam (gemeente Hardinxveld-Giessendam) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hardinxveld-Giessendam" ;
        min:gemeenteInBoek "Hardinxveld-Giessendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardinxveld-Giessendam_(gemeente)> ;
