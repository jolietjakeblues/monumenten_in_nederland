        schema:name "Oud-Beijerland"@nl ;
        schema:pageEnd "391" ;
        schema:pageStart "391" ;
        schema:pagination "391" ;
        schema:text "Het voorm. kantongerecht (Steenenstraat 20), een tweelaags gebouw met neorenaissance-invloeden en speklagen, kwam in 1880-'82 tot stand naar ontwerp van J.F. Metzelaar, rijksbouwmeester voor het ministerie van Justitie. Het interieur is in 1956 verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0128.php> .

