        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill91> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0016> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Boerderijen. Uit 1842 dateert de langhuisboerderij Heereweg 34. De kop-rompboerderij Heereweg 32 is waarschijnlijk in 1929 gebouwd ter vervanging van een voorganger uit 1847. In het gehucht Hogeveen ten oosten van Benthuizen liggen de boerderij Hoogeveenseweg 27 (circa 1915) met villaachtig voorhuis en de traditionalistische Mariahoeve (Hoogeveenseweg 14, Hazerswoude-Dorp) uit 1933, ontworpen door M. Gerritzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0016.php> .

