        schema:name "Noordwijk aan Zee (gemeente Noordwijk)"@nl ;
        schema:pageEnd "373" ;
        schema:pageStart "373" ;
        schema:pagination "373" ;
        schema:text "De voorm. R.K. St.-Willibrord MULO (Van Panhuijsstraat 17), opgetrokken in 1955 naar een traditionalistisch ontwerp van Dom. H. van der Laan, is een U-vormig eenlaags schoolgebouw met achtzijdig paviljoen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0118.php> .

