        min:gemeenteInBoek "Middelharnis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middelharnis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Middelharnis" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10439> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29748" ;
        min:soort "inleiding" ;
        min:volgnummer 1161 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill508>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill509> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0097> ;
        schema:name "Middelharnis"@nl ;
        schema:pageEnd "352" ;
        schema:pageStart "351" ;
        schema:pagination "351-352" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 1) is een prominent gesitueerd gebouw met een zandstenen souterrain, voorzien van een bordes met dubbele trap en een onderdoorgang naar de erachter gelegen kerkring. Dit classicistische raadhuis werd in 1639-'40 gebouwd onder leiding van Pieter Arentsz Noorwits naar ontwerp van Arent van 's-Gravesande. De bel-etage wordt afgesloten door een fronton met daarop drie beelden (Justitia, Charitas en Prudentia) van de hand van Pieter Adriaansz 't Hooft. In de dakruiter hangt een door Cornelis Ouderogge gegoten klok (1677) en aan de gevel hangen halsstenen met ketting en een kaak. De flankerende zijvleugels dateren van een verbouwing en vergroting in 1834-'39. De vestibule en de raadzaal werden toen van empire-stucwerk voorzien. Het in 1905 onder leiding van J. Verheul gerestaureerde gebouw dient sinds 1992 als Rien Poortvliet Museum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0097.php> .

