            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79743>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79746> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "522536",
            "522576",
            "522577",
            "9403" ;
        min:soort "inleiding" ;
        min:volgnummer 795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0055> ;
        schema:name "Heenvliet (gemeente Bernisse)"@nl ;
        schema:pageEnd "264" ;
        schema:pageStart "264" ;
        schema:pagination "264" ;
        schema:text "De ruïne van kasteel Ravesteyn (bij Markt 11-12) ligt op een omgracht terrein in de tuin van het ambachtsherenhuis. Een rechthoekige donjon met ronde hoektorens verrees midden 13de-eeuw in opdracht van Hugo van Heenviet. Rond 1350 voegde men aan de oostzijde een woonvleugel toe en omstreeks 1500 volgde een verdere uitbreiding (opgegraven 1959). Het kasteel werd in 1572 door de Watergeuzen verwoest en verviel daarna tot ruïne (geconsolideerd 1960-'68)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00796> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heenvliet (gemeente Bernisse) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
