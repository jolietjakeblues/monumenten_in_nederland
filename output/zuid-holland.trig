        min:hoofdstuk "Steden, dorpen, monumenten › Giessendam (gemeente Hardinxveld-Giessendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessendam" ;
