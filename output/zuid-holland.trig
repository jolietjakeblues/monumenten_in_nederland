        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0138> ;
        schema:name "Poeldijk (gemeente Westland)"@nl ;
        schema:pageEnd "404" ;
        schema:pageStart "403" ;
        schema:pagination "403-404" ;
        schema:text "Op het in 1826-'44 aangelegde kerkhof staan enkele interessante grafkruisen, waaronder die voor A.J. Krijger. De uit 1932 daterende forse pastorie (Voorstraat 111) is uitgevoerd in zakelijkexpressionistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01493> a min:Passage,
