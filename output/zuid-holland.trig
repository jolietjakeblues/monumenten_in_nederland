        min:volgnummer 404 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0026> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "Begraafplaatsen. De in 1842 gestichte Oude Alg. begraafplaats (G.J. van den Boogerdweg ong.) heeft een gietijzeren hekwerk met fasces en zandlopers als decoraties. Interessant zijn onder meer een zerk voor mr. H.T. Holier († 1862) en verder een bijbelzerk voor ds. W. van den Berg († 1911). Op de rond 1900 gestichte R.K. begraafplaats (Kloosterweg 33) staat een gietijzeren grafkruis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00405> a min:Passage,
