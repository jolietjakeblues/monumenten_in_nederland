        rdfs:label "Nieuw-Helvoet (gemeente Hellevoetsluis)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Helvoet (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Helvoet" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1227 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0106> ;
        schema:name "Nieuw-Helvoet (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "361" ;
        schema:pageStart "361" ;
        schema:pagination "361" ;
        schema:text "Kerkringdorp, ontstaan na de bedijking van de Polder Nieuw-Helvoet (1395). De bebouwing beperkte zich vooral tot de kerkring (Ring) en de Smitsweg, waar in 1840 een eerste raadhuis verrees. Begin 17de eeuw diende de kerk tevens als parochiekerk van Hellevoetsluis. Door de forse naoorlogse uitbreidingen van Hellevoetsluis is Nieuw-Helvoet aan Hellevoetsluis vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01228> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Helvoet (gemeente Hellevoetsluis)"@nl ;
        min:adres "Ring 1",
            "Smitsweg 49" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Helvoet (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Helvoet" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1228 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill524> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0106> ;
        schema:name "Nieuw-Helvoet (gemeente Hellevoetsluis)"@nl ;
        schema:pageEnd "362" ;
        schema:pageStart "361" ;
        schema:pagination "361-362" ;
        schema:text "De Herv. kerk (Ring 1), oorspronkelijk gewijd aan St. Cornelius, bestaat uit een dwarsschip met vijfzijdig gesloten koor en een vrijstaande toren van drie geledingen met tentdak. De toren verrees in de tweede helft van de 15de eeuw en bevat een door Cornelis Ouderogge gegoten klok (1634). Het laat-gotische dwarsschip en koor kwamen rond 1500 tot stand. Waarschijnlijk is het schip rond 1575 na blikseminslag afgebrand. De toren met de aansluitende muurresten van het schip werden in 1927 en in 1984 gerestaureerd. Bij de kerkrestauratie in 1964-'65 is tevens een portaal in neoclassicistische trant aangebracht. Tot de inventaris behoren een door A. Verhoeff gemaakte preekstoel (1807) en een uit Luik afkomstig orgel van A. Clerinx (1845, geplaatst in 1971). Uit 1850 dateert de voorm. pastorie (Smitsweg 49), een fors pand met neoclassicistische ingangsomlijsting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01229> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Helvoet (gemeente Hellevoetsluis)"@nl ;
        min:adres "Smitsweg 70",
            "Smitsweg 72",
            "Smitsweg 74" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hellevoetsluis" ;
        min:gemeenteInBoek "Hellevoetsluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hellevoetsluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Helvoet (gemeente Hellevoetsluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Helvoet" ;
