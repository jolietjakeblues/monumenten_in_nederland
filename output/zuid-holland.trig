        min:volgnummer 1072 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0087> ;
        schema:name "Leimuiden (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "Ontginningsdorp, ontstaan in de middeleeuwen en in 1063 voor het eerst vermeld. De ontginningsas wordt gevormd door de W. van der Veldenweg en de Dorpsstraat. Rond de Herv. kerk vormde zich in de 19de eeuw een kleine dorpskom. Na de Tweede Wereldoorlog is Leimuiden in westelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01073> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leimuiden (gemeente Jacobswoude)"@nl ;
        min:adres "Dorpsstraat 49" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leimuiden (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leimuiden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32276> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "25731" ;
        min:soort "inleiding" ;
        min:volgnummer 1073 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0087> ;
        schema:name "Leimuiden (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De Herv. kerk (Dorpsstraat 49) is een zaalkerk, waarvan de grotendeels ingebouwde toren een opengewerkte achtkante bovenbouw en naaldspits heeft. Deze kerk werd in 1805 gebouwd ter vervanging van een voorganger uit 1555. Bij een restauratie in 1963-'65 heeft men de consistoriekamer toegevoegd en de achtkante torenopbouw vernieuwd. Tot de inventaris behoren enkele 17de-eeuwse grafzerken, een laat-18de-eeuwse orgelkast, een preekstoel (1806), twee herenbanken (circa 1805) en een door H. Knipscheer gebouwd orgel (1866)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01074> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leimuiden (gemeente Jacobswoude)"@nl ;
        min:adres "W. van der Veldenweg 22" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leimuiden (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leimuiden" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1074 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0087> ;
        schema:name "Leimuiden (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De R.K. St.-Joannes de Doperkerk (W. van der Veldenweg 22) is een driezijdig gesloten zaalkerk met een half-ingebouwde toren van twee geledingen met omloop en naaldspits. Deze kerk kwam in 1851-'54 tot stand naar een ontwerp met vroeg-neogotische elementen van C. Dobbe ter vervanging van een schuurkerk uit 1752. De kapelvormige ruimten aan weerszijden van de toren heeft men in 1928 naar plannen van L. Robbers toegevoegd. Het door gestukadoorde kruisribgewelven gedekte interieur bevat een neogotische inventaris uit de bouwtijd met een door L. Veneman vervaardigd hoofdaltaar, een communiebank en een door C. Dobbe gemaakte preekstoel. Het Ypma-orgel is uit 1856."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

