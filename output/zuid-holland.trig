        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Windmolen ‘De Hoop’ (Gemeenlandsedijk Zuid 25) is een deels wit gepleisterde ronde grondzeiler met een met dakleer beklede kap, gebouwd in 1842 als korenmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00254> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Alblasserdam"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alblasserdam" ;
        min:gemeenteInBoek "Alblasserdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alblasserdam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Alblasserdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Alblasserdam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 254 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0010> ;
        schema:name "Alblasserdam"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Dorp, ontstaan bij de rond 1280 afgedamde monding van de Alblas. De bebouwing breidde zich oostwaarts (Kerkstraat) uit en na aanleg van de Kinderdijk (vanaf 1372) ook westwaarts. Een sterke industriële ontwikkeling volgde in de tweede helft van de 19de eeuw door de vestiging van scheepsbouw en daaraan verwante bedrijven. Aan de Ruigenhil resteren daarvan nog grote hallen, waaronder die voor de kabelfabriek Nedstaal (circa 1930). Alblasserdam werd op 11 mei 1940 door luchtaanvallen verwoest tijdens de opmars van de Duitsers naar Rotterdam. De wederopbouw in 1942-'43 geschiedde naar plannen van S.J. van Embden en onder supervisie van B. van Bilderbeek. Na de Tweede Wereldoorlog zijn aan de noordzijde forse woonwijken verwezenlijkt en aan de zuidzijde van de Alblas een nieuw industrieterrein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0010.php> .

