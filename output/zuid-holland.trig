        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "111" ;
        schema:pageStart "111" ;
        schema:pagination "111" ;
        schema:text "Bedrijfsgebouwen. Het gebouw van Schellings Oliehandel (Voorhaven 51; 1916) vertoont expressionistische details. Vermengd met iets meer classicistische details is de gevel van voorm. Machinefabriek Cupedo (Aelbrechtskolk 45; 1919)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0029.php> .

