        schema:name "Horeca"@nl ;
        schema:pageEnd "476" ;
        schema:pageStart "476" ;
        schema:pagination "476" ;
        schema:text "Horeca. De dorpsherberg Dorpsstraat 27 is een eenlaagspand met kleine topgevel uit 1904 in neorenaissance-stijl. Het in 1926 gebouwde café Dorpsstraat 30 vertoont expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01713> a min:Passage,
