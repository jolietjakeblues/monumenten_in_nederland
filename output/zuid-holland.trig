        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0121> ;
        schema:name "Nootdorp (gemeente Pijnacker-Nootdorp)"@nl ;
        schema:pageEnd "380" ;
        schema:pageStart "380" ;
        schema:pagination "380" ;
        schema:text "Het voorm. St.-Josephgesticht (Veenweg 34), gebouwd in 1906 als zusterklooster en bejaardenhuis, is uitgevoerd met neorenaissance-details. De bijbehorende tweelaagse R.K. lagere St.-Jozefschool (Veenweg 32) uit 1908 was oorspronkelijk een meisjesschool; vanaf 1913 kregen hier ook jongens onderwijs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0121.php> .

