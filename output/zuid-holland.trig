        min:volgnummer 773 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0052> ;
        schema:name "Hagestein (gemeente Vianen)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 12) werd in 1930 gebouwd naar een expressionistisch ontwerp van A.C.G. Vermeulen. Boven de ingang rijst een overhoeks torentje op met hoge spits. Rechts waren gemeenteruimten, links de veldwachterwoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0052.php> .

