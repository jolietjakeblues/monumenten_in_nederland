        min:gemeenteInBoek "Reeuwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driebruggen (gemeente Reeuwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Driebruggen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 536 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0034> ;
        schema:name "Driebruggen (gemeente Reeuwijk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Het voorm. raadhuis van de gemeenten Lange Ruige Weide, Hekendorp en Papekop (Kerkweg 4) is een sober zakelijk-expressionistisch gebouw uit 1927 met op de nok een klokkentorentje. Sinds 1982 dient het pand als bank."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00537> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Driebruggen (gemeente Reeuwijk) – Woonhuizen"@nl ;
        min:adres "Hoogeind 8" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Reeuwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driebruggen (gemeente Reeuwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Driebruggen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 537 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0034> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Woonhuizen. Uit de 17de eeuw stamt het onderkelderde dwarse eenlaagspand Zuidkade 2, met zijpuntgevels voorzien van schouderstukken. Ontlastingsbogen in het metselwerk markeren oude vensteropeningen. Een stoep met gietijzeren balusterleuning geeft toegang tot de omlijste ingang in de gepleisterde voorgevel. Het door M.C. van Wijngaarden ontworpen herenhuis Kerkweg 15 met koetshuis dateert uit 1888. Een eenvoudige neorenaissance-detaillering hebben de laat-19de-eeuwse dwarse eenlaagspanden Hoogeind 10, Kerkweg 6 en 18, en de arbeiderswoningen Kerkweg 31-35 en 36-40. Rond 1920 gebouwd zijn de kleine villa's Zuidkade 47 en Antonia (Hoogeind 8; 1922)"@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00538> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Driebruggen (gemeente Reeuwijk) – Boerderijen"@nl ;
        min:adres "Prinses Beatrixkade 10" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Reeuwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driebruggen (gemeente Reeuwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Driebruggen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 538 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill208> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0034> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text """Boerderijen. Een 18de-eeuwse oorsprong hebben de hallenhuisboerderijen Hoogeind 34 (met kelder en opkamer), Laageind 15 en De Groendijck 2; de laatste heeft een empiredeur en deels vernieuwde gevels. Voorbeelden van laat-19de-eeuwse langhuisboerderijen zijn Laageind 27 en 45. De in 1909 gebouwde boerderij Laageind 55 heeft siermetselwerk in gele baksteen en gesneden windveren.

Het gemaal (Prinses Beatrixkade 10) werd in 1911 gebouwd als stoomgemaal met een centrifugaalpomp van de firma Pannevis (1911)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0034.php> .

