        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Woonhuizen. Een voorbeeld van een eenvoudig dwars dijkhuis is Lekdijk 57 (circa 1860). Het eenvoudige middenganghuis Kerkplein 2 dateert uit circa 1895. In stijl gelijk aan het postkantoor is het in neorenaissance-vormen uitgevoerde dwarse huis Lekdijk 134 (circa 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00301> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arkel (gemeente Giessenlanden)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arkel (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Arkel" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 301 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0014> ;
        schema:name "Arkel (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Dijkdorp, ontstaan in de 10de eeuw op een stroomrug van de Linge bij het (verdwenen) kasteel van de heren van Arkel. Aan de oostzijde sloot men hier het Zederikkanaal (1824-'25) op de Linge aan. Aan de westzijde werd het Merwedekanaal (1885-'93) gegraven. Hierna ontstond tussen beide kanalen een dichtere bebouwing. Na de Tweede Wereldoorlog is het dorp aan de zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00302> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arkel (gemeente Giessenlanden)"@nl ;
        min:adres "Kerkeind 29" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arkel (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Arkel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46834> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "8282" ;
        min:soort "inleiding" ;
        min:volgnummer 302 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill86> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0014> ;
        schema:name "Arkel (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "82" ;
        schema:pagination "82-83" ;
        schema:text "De Herv. kerk (Kerkeind 29), gelegen ten zuiden van de dorpskern, is een achtzijdige centraalbouw met in- en uitgezwenkt koepeldak en houten lantaarn. Deze neoclassicistische kerk, waarvan de ingangspartij is voorzien van vroege neogotische details, kwam in 1855-'56 tot stand ter vervanging van een middeleeuwse kerk. Na een brand in 1922 heeft men de dakconstructie vernieuwd. De kerk is in 1999 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00303> a min:Passage,
