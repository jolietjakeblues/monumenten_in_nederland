        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0032> ;
        schema:name "Dirksland"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Het voorm. weeshuis (Ring 43) is een diep pand uit 1868, voorzien van een tuitgevel met bekronend fronton. Het tot 1922 als weeshuis gebruikte gebouw is gerestaureerd in 1987."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00484> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dirksland – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Dirksland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dirksland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Dirksland" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 484 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0032> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Woonhuizen. Net als meer huizen aan de Voorstraat heeft het diepe huis Voorstraat 58 achter de ingezwenkte lijstgevel (circa 1875; winkelpui circa 1930) een oudere, waarschijnlijk 18de-eeuwse, kern. Een oude kern hebben ook de huizen Heul 4 (gevelsteen 1618) en Voorstraat 35, beide voorzien van een gepleisterde puntgevel. Een 18de-eeuwse klokgevel met sobere aanzetvoluten bezit Voorstraat 11. Begin 19de eeuw verrezen het brede herenhuis Boezemweg 32-34 (1806) en het tweebeukige huis Ring 117 (circa 1830), dat eerst diende als pastorie en later als dokterswoning. Sober van vorm zijn de rond 1850 gebouwde herenhuizen Voorstraat 14, 31 en 44. Het herenhuis Voorstraat 13 (circa 1860) is uitgevoerd met neoclassicistische vensteromlijstingen en een mezzaninoverdieping. Het huis Kaai 6 (circa 1860) heeft een vergelijkbare opbouw. Het buurpand Kaai 8 (circa 1865) is eclectisch vormgegeven. Een ingezwenkte lijstgevel hebben Stationsweg 1 (circa 1880), Geldersedijk 30-32 (circa 1910), met aan weerszijde een afluiving, en Stationsweg 2 (1902) met neorenaissance-details. Neorenaissance-vormen vertonen de huizen Kapoenstraat 2 (1904), Winterstraat 4 (1909), Secretarieweg 9 (1911) en de winkel Heul 6 (circa 1905). De villa Stationsweg 35 en het huis Voorstraat 33 (beide circa 1910) zijn uitgevoerd met jugendstil-elementen. Expressionistisch van vorm zijn de villa Staakweg 1, het huis Paulina van Weellaan 15 (parabooldak), de onder- en bovenwoning Nieuwstraat 11-13 en de winkel Zomerstraat 16 (alle circa 1925). Het smalle huis Voorstraat 28 (circa 1928) is ontworpen in zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00485> a min:Passage,
