        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0039> ;
        schema:name "Giessenburg (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "Ontginningsdorp, ontstaan in de 12de eeuw aan weerszijden van de veenstroom de Giessen. Het dorp werd ook wel Giessen-Nieuwkerk genoemd. Rond kerk en brug ontstond een kleine dorpskom en na de Tweede Wereldoorlog is Giessenburg aan de zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00569> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessenburg (gemeente Giessenlanden)"@nl ;
        min:adres "Kerkweg 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessenburg (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessenburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31624>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38083> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16108",
            "16109" ;
        min:soort "inleiding" ;
        min:volgnummer 569 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill217> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0039> ;
        schema:name "Giessenburg (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "De Herv. kerk (Kerkweg 1) is een eenbeukige kerk met vijfzijdig gesloten koor en een toren van twee geledingen met ingesnoerde spits. De toren verrees in de eerste helft van de 15de eeuw en werd vermoedelijk later in die eeuw verhoogd. Erin hangt een door Jan Albert de Grave gegoten klok (1723). Het laatgotische koor dateert uit het midden van de 15de eeuw. Het schip heeft men in 1877 in neoclassicistische vormen herbouwd naar plannen van T.A. Vermaas. Restauraties zijn uitgevoerd in 1961 (toren) en 1970 (kerk). Tot de inventaris behoren een preekstoel en doophek met doopboog (1684; Jan Brouwers), zeven rouwborden (1720-'89 en 1859) en achter het moderne orgel een marmeren grafmonument voor Cornelis de Boodt († 1718)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0039.php> .

