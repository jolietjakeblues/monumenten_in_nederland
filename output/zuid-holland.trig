        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0161> ;
        schema:name "Slikkerveer (gemeente Ridderkerk)"@nl ;
        schema:pageEnd "488" ;
        schema:pageStart "488" ;
        schema:pagination "488" ;
        schema:text "Dijkdorp aan de Nieuwe Maas, ontstaan in de tweede helft van de 15de eeuw. Eind 19de eeuw vestigden zich hier scheepsbouw- en aanverwante industrie, waaronder de elektrotechnische industrie W. Smit (1882). Het dorp is na de Tweede Wereldoorlog aan Ridderkerk vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0161.php> .

