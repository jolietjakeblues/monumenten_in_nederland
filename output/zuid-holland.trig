        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Numansdorp (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Numansdorp" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1357 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0122> ;
        schema:name "Numansdorp (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "381" ;
        schema:pageStart "380" ;
        schema:pagination "380-381" ;
        schema:text "Voorstraatdorp, ontstaan na bedijking van de Polder Numansdorp (1642) en genoemd naar de secretaris van koning Maximiliaan I, Gerrit Numan, die het (toen nog onbedijkte) gebied in erfpacht kreeg. Aan de oostelijke achterstraat (Torenstraat) verrees de kerk. Aan de westzijde ligt een in 1955 afgesloten binnenhaven. De in 1898 aangelegde tramverbinding naar Rotterdam werd in 1901 zuidwaarts verlengd tot aan de tramhaven (met havenkanaal) voor de veerdiensten op Willemstad, Zijpe en Ooltgensplaat (opgeheven 1956-'57)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01358> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Numansdorp (gemeente Cromstrijen)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Cromstrijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Numansdorp (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Numansdorp" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1358 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0122> ;
        schema:name "Numansdorp (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "381" ;
        schema:pageStart "381" ;
        schema:pagination "381" ;
        schema:text "Numansdorp had te lijden van beschietingen (1944) en de Watersnoodramp van 1953; daarna is het aan de noordzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01359> a min:Passage,
            schema:CreativeWork ;
