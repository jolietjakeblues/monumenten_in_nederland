        min:hoofdstuk "Steden, dorpen, monumenten › Goudriaan (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Goudriaan" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32476>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61703> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "17033",
            "18771" ;
        min:soort "lemma" ;
        min:volgnummer 670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0045> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text """Woonhuizen. De rond 1880 gebouwde rentenierswoning Zuidzijde 134-135 heeft een ingezwenkte lijstgevel en een omlijste ingang. Van de school is de uit circa 1920 daterende onderwijzerswoning Noordzijde 46 bewaard gebleven.

De poldermolen ‘Goudriaanse Molen’ (Molenkade 5) is een achtkante grondzeiler uit 1779 met scheprad, stenen onderbouw en een met riet gedekte romp. Deze molen bemaalt de Polder Oud-Goudriaan."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goudswaard (gemeente Korendijk)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Korendijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goudswaard (gemeente Korendijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Goudswaard" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 671 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0046> ;
        schema:name "Goudswaard (gemeente Korendijk)"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Dijkdorp met voorstraatkarakter, voor het eerst vermeld in 1246 maar als zodanig pas gesticht na de herdijking van de Polder Oud-Korendijk (1439). Daartoe werd de kreek Het Sandee afgedamd met een sluis in de dam en een haven aan de zijde van het Spui. De bebouwing concentreerde zich aan de Molendijk en de Dorpsstraat. Met de aanleg van de Burg. Zahnweg rond 1920 ontstond een driehoekige dorpsplattegrond. Na de Watersnoodramp van 1953 is het dorp aan de oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00672> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goudswaard (gemeente Korendijk)"@nl ;
        min:adres "Dorpsstraat 19" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Korendijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goudswaard (gemeente Korendijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Goudswaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36339>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56857> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "17050",
            "17051" ;
        min:soort "inleiding" ;
        min:volgnummer 672 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0046> ;
        schema:name "Goudswaard (gemeente Korendijk)"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "De Herv. kerk (Dorpsstraat 19) is een zaalkerk voorzien van een geveltoren met ingesnoerde naaldspits. De kerk werd waarschijnlijk in 1721 gebouwd ter plaatse van een voorganger uit 1442. In de geveltoren hangen een 14de-eeuwse klok en een door Peter Waghevens gegoten klok (1503). Het met houten tongewelf gedekte interieur bevat een preekstoel en doophek in Lodewijk XVI-vormen en een door P.J. Geerkens gebouwd orgel (1809; restauratie 1982). Een hek met geblokte hardstenen hekpijlers uit 1818 geeft toegang tot het kerkterrein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0046.php> .

