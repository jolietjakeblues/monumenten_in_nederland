        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Leerdam"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De Evang. Luth. kerk (Nieuwstraat 106) [2], later Nieuw Apostolische kerk, is een zaalgebouw met neoclassicistische in- en uitgezwenkte gevel. Deze kerk werd in 1838 gesticht voor lutherse glasblazers uit Duitsland en Bohemen. Het interieur wordt gedekt door een houten tongewelf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00990> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerdam"@nl ;
        min:adres "Nieuwstraat 13" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leerdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leerdam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 990 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Leerdam"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De voorm. synagoge (achter Nieuwstraat 13) [3], voorzien van spitsboogvensters en een in- en uitgezwenkte topgevel, kwam in 1854 tot stand en was tot 1935 als zodanig in gebruik. De bijbehorende woning Nieuwstraat 13 uit 1907 (5566) bevatte tevens de mikwe."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00991> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerdam"@nl ;
        min:adres "Nieuwstraat 64-66" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leerdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leerdam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 991 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Leerdam"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De voorm. R.K. kerk H. Maria Onbevlekt Ontvangen (Nieuwstraat 64-66) [4], een kleine neogotische zaalkerk met (verminkte) tuitgevel, werd gebouwd in 1885 en kreeg in 1896 een recht gesloten koor en sacristie naar plannen van P.J.H. Cuypers. Het gebouw dient nu als winkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00992> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerdam"@nl ;
        min:adres "Meent 61",
            "Meent 63" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leerdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leerdam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 992 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Leerdam"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De huidige R.K. kerk H. Maria Onbevlekt Ontvangen (Meent 63) [5] is een kruiskerk met pseudotransept, schip met dwarskappen en een slanke toren. Deze opvallende kerk verrees in 1930 naar een sober expressionistisch ontwerp van Dom P. Bellot en H.C. van de Leur. In het interieur is veel decoratief metselwerk toegepast. De pastorie (Meent 61), nu gemeenschapshuis ‘Zonnelied’, is een blokvormige villa uit circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00993> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerdam – Overige kerken"@nl ;
        min:adres "Europaplein 1",
            "Hoogstraat 80",
            "Noordwal 30" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leerdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leerdam" ;
        min:lemma "Overige kerken" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 993 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "Overige kerken. De in 1898 met rondboogvensters gebouwde Geref. kerk (Hoogstraat 80) [6] heeft een L-vormige plattegrond vanwege de sterk uitspringende ingangspartij. Het zaalgebouw van de Chr. Geref. kerk (Noordwal 30) [7] kwam in 1916 tot stand naar plannen van W.H. Vielderman met rondboogvensters en een ingangsportaal met tuitgevel. De naoorlogse (Herv.) Pauluskerk (Europaplein 1; 1960, C.G. Geenen en L.R.T. Oskam) is een moderne zaalkerk met bakstenen klokkentoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00994> a min:Passage,
            schema:CreativeWork ;
