        schema:name "Leiderdorp"@nl ;
        schema:pageEnd "332" ;
        schema:pageStart "332" ;
        schema:pagination "332" ;
        schema:text "De voorm. openbare lagere school (Kerklaan 14) is een drieklassige gangschool uit 1863 met bakstenen pilasters tegen de voorgevel waarvan het middendeel tot tuitgevel is opgetrokken. Het voorm. postkantoor (Hoofdstraat 6), een gepleisterd tweelaags dwars pand met ingangsomlijsting en eclectische elementen, dateert uit 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01060> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leiderdorp"@nl ;
        min:adres "Hoofdstraat 1-3" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
