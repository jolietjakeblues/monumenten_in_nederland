        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill497> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0093> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Begraafplaatsen. De Oude Alg. begraafplaats (Commandeurskade ong.) werd in 1829 gesticht en heeft een gietijzeren toegangshek (circa 1860). Het baarhuisje dateert van de uitbreiding in 1920. In 1933 werd aan de overzijde de Nieuwe Alg. begraafplaats (Hofsingel ong.) gesticht, met daarop een aula met expressionistische details naar ontwerp van A. Warnaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01130> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasland (gemeente Midden-Delfland) – Boerderijen"@nl ;
        min:adres "Commandeurskade 46",
            "Oostgaag 13",
            "Oostgaag 49",
            "Oostgaag 55" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Midden-Delfland" ;
        min:gemeenteInBoek "Midden-Delfland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Delfland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
