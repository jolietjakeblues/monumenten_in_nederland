        schema:name "Delft"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "De kerk is gerestaureerd in 1960-'65 onder leiding van F.B. Jantzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00444> a min:Passage,
            schema:CreativeWork ;
