        schema:name "Goudswaard (gemeente Korendijk)"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Het voorm. raadhuis (Beneden Molendijk 76-80) uit 1898 is een neoclassicistisch gebouw met fronton, geflankeerd door een dokterswoning (links) en een burgemeesterswoning (rechts)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goudswaard (gemeente Korendijk) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Korendijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goudswaard (gemeente Korendijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Goudswaard" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 675 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill268> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0046> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "202" ;
        schema:pageStart "201" ;
        schema:pagination "201-202" ;
        schema:text "Woonhuizen. Een gevelsteen uit 1696 heeft het huis Dorpsstraat 20. Laat-18de-eeuws zijn de huizen Dorpsstraat 16, met klokgevel (1779) en een gesneden deurkalf in Lodewijk XIV-vormen, en Dorpsstraat 34 met cartouche uit 1781. Uit dezelfde tijd stammen de klokgevels van Dorpsstraat 18 (gepleisterd) en Dorpsstraat 32 en de ingezwenkte lijstgevel van Dorpsstraat 10. De klokgevel met bekronend fronton van Dorpsstraat 66 is gedateerd ‘1830’. Uit de eerste helft van de 19de eeuw dateren verder het eenlaagspand Dorpsstraat 68-70 (1801), met links een houten bedrijfsgedeelte, en het eenlaags middenganghuis Havenkade 14 (circa 1840) met ingangsomlijsting. Begin 20ste eeuw gebouwd zijn het middenganghuis Beneden Molendijk 64 (1910), met hoger opgetrokken middenrisaliet, en het woonhuis annex veldwachterswoning Dorpsstraat 21-23 uit 1913. In dat jaar heeft men ook de ernaastgelegen - volgens de gevelsteen in 1635 gestichte - armenhuizen Dorpsstraat 25-39 herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0046.php> .

