        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill698> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0157> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "476" ;
        schema:pageStart "476" ;
        schema:pagination "476" ;
        schema:text "Woonhuizen. Aan de noordzijde van de Gaag staan enkele diepe huizen met een 17de-eeuwse kern, zoals het in de 19de eeuw als smederij in gebruik zijnde huis De Buys (Dorpsstraat 11), met puntgevel en toppilaster. In rode baksteen uitgevoerde vlechtingen heeft de puntgevel van Dorpsstraat 18. Ook de huizen Hofje 1-5 hebben mogelijk een 17de-eeuwse kern. Uit de eerste helft van de 19de eeuw dateert de klokgevel van Dorpsstraat 17. Aardige villa's uit circa 1910 met rationalistische details zijn Dorpsstraat 1 en Keenenburgweg 27."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01712> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schipluiden (gemeente Midden-Delfland) – Horeca"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
