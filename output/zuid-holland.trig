        min:kern "Heinenoord" ;
        min:lemma "Hof van Assendelft" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51789> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "21357" ;
        min:soort "lemma" ;
        min:volgnummer 812 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0058> ;
        schema:name "Hof van Assendelft"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Hof van Assendelft (Hofweg 13). Dit forse tweelaags pand met ingangsomlijsting verrees rond 1767 in opdracht van Sara Louisa du Faget van Assendelft als ambachtsherenhuis. Het aangrenzende koetshuis werd in 1834 uitgebouwd tot een lange schuur door de nieuwe rentmeester A. Louter. Sinds 1968 is het huis ingericht als streekmuseum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00813> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heinenoord (gemeente Binnenmaas) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
