        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0034> ;
        schema:name "Driebruggen (gemeente Reeuwijk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Wegdorp zonder kerk, ontstaan in de 17de eeuw bij de brug over de Dubbele Wiericke. De bebouwing (Kerkweg) ontwikkelde zich vanaf de brug tot aan de parallel gelegen wetering met boerderijenlint (Hoogeind-Laageind)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00536> a min:Passage,
