        schema:name "Kaag (gemeente Alkemade)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De voorm. openbare lagere school (Julianalaan 19) werd in 1916 gebouwd als een drieklassige school met onderwijzerswoning. Het gebouw dient nu als hotel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00887> a min:Passage,
