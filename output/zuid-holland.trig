        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De (Geref.) Openhofkerk (Rijnstraat 18) is een kruisvormige kerk uit 1911, gebouwd ter vervanging van een kerk in de Grotesteeg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00895> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Katwijk aan den Rijn (gemeente Katwijk)"@nl ;
        min:adres "Overrijn 7" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Katwijk" ;
        min:gemeenteInBoek "Katwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Katwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Katwijk aan den Rijn (gemeente Katwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Katwijk aan den Rijn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 895 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0071> ;
        schema:name "Katwijk aan den Rijn (gemeente Katwijk)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Het voorm. Hof van Katwijk (Overrijn 7) werd in 1722 gebouwd in opdracht van Jacobus Johannes van Wassenaer ter plaatse van de ruïne van kasteel 't Zand. Het hier in 1831 gevestigde R.K. jongensgymnasium (‘Heerenschool’) werd vanaf 1839 geleid door paters jezuïeten. In 1851 toegevoegd is het gebouw ‘Mutua Fides’ naar ontwerp van M.G. Tétar van Elven. Van 1928 tot 1942 was het complex een opleidingscentrum voor de missie. Na oorlogsschade heeft men de neogotische kapel (1878) vervangen door de huidige traditionalistische R.K. St.-Willibrorduskapel (1951, C.F.L. van der Lubbe en J.B. Hermans)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0071.php> .

