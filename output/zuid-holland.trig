        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill573> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0129> ;
        schema:name "Ouddorp (gemeente Goedereede)"@nl ;
        schema:pageEnd "393" ;
        schema:pageStart "393" ;
        schema:pagination "393" ;
        schema:text "De Doopsgez. kerk (Weststraat 3) is sinds circa 1635 gevestigd in een vroeg-16de-eeuws diep huis met sierankers. Het gebouw heeft aan de voorzijde een in de 19de eeuw gepleisterde puntgevel. Een poort naast het huis geeft toegang tot het aan de achterzijde gelegen kerkgedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01429> a min:Passage,
            schema:CreativeWork ;
