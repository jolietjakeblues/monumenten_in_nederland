        min:hoofdstuk "Steden, dorpen, monumenten › Klaaswaal (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Klaaswaal" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29808> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "23662" ;
        min:soort "inleiding" ;
        min:volgnummer 932 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0076> ;
        schema:name "Klaaswaal (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text "De Herv. kerk (Kerkstraat 18) is een eenbeukige kerk met driezijdige sluiting en een slanke westtoren. Deze in 1566 gebouwde kerk werd verbouwd in 1655, 1709 en 1840. In de toren hangt een door Willem Wegewaert gegoten klok (1622). De kerk bevat enkele grafzerken (17de-18de eeuw) en een preekstoel uit 1816."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00933> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klaaswaal (gemeente Cromstrijen) – Overige kerken"@nl ;
        min:adres "Havenweg 9",
            "Kerkstraat 14",
            "Molendijk 51",
            "Voorstraat 11" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Cromstrijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klaaswaal (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Klaaswaal" ;
        min:lemma "Overige kerken" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 933 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0076> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text """Overige kerken. De Geref. kerk (Voorstraat 11) is een bescheiden zaalkerk uit circa 1880. De Rehobothkerk van de Geref. Gemeente (Havenweg 9), een zaalkerk met consistoriekamer en dakruiter, is in 1953 gebouwd naar een ontwerp in traditionalistische vormen van W. de Jonge.

Het voorm. raadhuis (Kerkstraat 14), een tweelaags gebouw met ingangsomlijsting, werd rond 1830 gebouwd als schoolhuis en kreeg in 1839 een verdieping.

De voorm. landbouw- en huishoudschool (Molendijk 51) is een tweelaags schoolgebouw in traditionalistische vormen uit circa 1935."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00934> a min:Passage,
