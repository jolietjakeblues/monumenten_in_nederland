        rdfs:label "Leidschendam (gemeente Leidschendam-Voorburg) – Windmolen"@nl ;
        min:adres "De Wiek 19",
            "Delftsekade 30-31",
            "Plaspoelkade 73",
            "Sluisplein 10",
