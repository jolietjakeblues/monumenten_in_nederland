        min:volgnummer 2008 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0190> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "547" ;
        schema:pageStart "547" ;
        schema:pagination "547" ;
        schema:text """Boerderijen. De boerderij Bouwlust (Molendijk 2) heeft een hoog woonhuis met schilddak uit 1746 en een dwarsdeelschuur. Het inrijhek uit 1803 is voorzien van hardstenen hekpalen met wapendragende leeuwen. Bij de boerderij Blokensteyn (Ronduitweg 2) is het inrijhek uit 1804. De met zijlangsdeelschuur uitgevoerde boerderij Dorpszigt (Dorpsstraat 84) dateert in haar huidige vorm van de herbouw na brand in 1863.

De windmolen ‘Landzicht’ (Molendijk 19) is een ronde grondzeiler met een met riet gedekte kap, gebouwd in 1857 als korenmolen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02009> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuid-Beijerland (gemeente Korendijk) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 175",
            "Molendijk 22" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Korendijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuid-Beijerland (gemeente Korendijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zuid-Beijerland" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 2009 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0190> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "547" ;
        schema:pageStart "547" ;
        schema:pagination "547" ;
        schema:text """Woonhuizen. Jugendstil-details vertonen de huizen Dorpsstraat 15 (1900) en Notre Plaisir (Molendijk 22; circa 1910). Vermoedelijk van de hand van dezelfde ontwerper zijn de kleine villa's Dorpsstraat 66 (circa 1910), Dorpsstraat 167 (circa 1915) en Koninginneweg 11 (1923).

De Alg. begraafplaats (bij Dorpsstraat 175) werd rond 1850 gesticht maar bevat enkele oudere zerken (1682, 1690), afkomstig uit de afgebrande dorpskerk."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02010> a min:Passage,
