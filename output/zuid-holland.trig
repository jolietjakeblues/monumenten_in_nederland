        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouderak (gemeente Ouderkerk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouderak" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 659 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0044> ;
        schema:name "Gouderak (gemeente Ouderkerk)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Langgerekt dijkdorp aan de Hollandse IJssel, ontstaan in de 10de eeuw en in eerste instantie zonder dorpskern en kerk. Tot 1658 ging men ter kerke in Moordrecht aan de overzijde van de rivier. Na de bouw van de eigen kerk ontstond langs de Dorpsstraat - bij veer en kerk - door verdichting van de bebouwing een dorpskern die eind 19de eeuw werd uitgebreid. Na de Tweede Wereldoorlog is het dorp aan de zuidoostzijde uitgebreid in de polder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00660> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouderak (gemeente Ouderkerk)"@nl ;
        min:adres "Kerkstraat 3" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
