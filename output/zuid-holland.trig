        min:adres "Aalmarkt 22",
            "Apothekersdijk 33",
            "Breestraat 78",
            "Oude Singel 102",
            "Steenschuur 21",
            "Steenschuur 4-6",
            "Steenstraat 39" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Leiden" ;
        min:gemeenteInBoek "Leiden" ;
