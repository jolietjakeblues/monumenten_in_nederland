        schema:pageEnd "548" ;
        schema:pageStart "548" ;
        schema:pagination "548" ;
        schema:text "De Geref. kerk (Wilhelminastraat 28) is een forse moderne kerk met lage aanbouwen en een robuuste toren, gebouwd in 1963 naar plannen van H. Sutterland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02014> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidland (gemeente Bernisse)"@nl ;
        min:adres "Ring 24" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
