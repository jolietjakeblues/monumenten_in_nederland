        min:soort "inleiding" ;
        min:volgnummer 296 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0013> ;
        schema:name "Ammerstol (gemeente Bergambacht)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Het voorm. raadhuis (Lekdijk 162) is een tweelaags diep pand met dakruiter, gebouwd midden 19de eeuw als woonhuis en in 1885 door Cornelis Zanen aan de gemeente geschonken om als raadhuis te dienen (tot 1985). De traditionalistische voorgevel (circa 1940) heeft boven de ingang een natuurstenen gemeentewapen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00297> a min:Passage,
