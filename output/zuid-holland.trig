        schema:name "Dordrecht"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "Het bijbehorende voorm. klooster (Schrijverstraat 29) is een sober neoclassicistisch gebouw uit 1879 met afgeronde hoek en een licht risalerend middengedeelte met fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00506> a min:Passage,
