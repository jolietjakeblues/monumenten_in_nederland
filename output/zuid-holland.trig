        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijsoord (gemeente Ridderkerk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Rijsoord" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1549 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0148> ;
        schema:name "Rijsoord (gemeente Ridderkerk)"@nl ;
        schema:pageEnd "414" ;
        schema:pageStart "414" ;
        schema:pagination "414" ;
        schema:text "Dijkdorp, ontstaan in de 15de eeuw bij een brug over de afgedamde Waal. Aan weerszijden van de brug vormde zich een langgerekte bebouwing. In de omgeving was veel vlasnijverheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01550> a min:Passage,
