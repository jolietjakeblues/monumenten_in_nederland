        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13522>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38359> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30144",
            "30145" ;
        min:soort "lemma" ;
        min:volgnummer 1176 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0098> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "353" ;
        schema:pageStart "353" ;
        schema:pagination "353" ;
        schema:text "Boerderijen. Anna's hoeve (Westdijk 99) heeft een deels in 1726 opgetrokken schuur met zijlangsdeel en aan de voorzijde een woonhuis in neorenaissance-stijl met chaletstijl-elementen uit 1912. Vredebest (Hoflaan 1) uit 1862 is een fraai voorbeeld van een boerderij met een zijlangsdeelschuur en een woonhuis met ingezwenkte lijstgevel en ingangsomlijsting. De in 1939 in traditionalistische vormen gebouwde boerderij Raadhuislaan 8 bestaat uit een langgerekte schuur en een via een tussenlid aangebouwd villa-achtig woonhuis. Ten noordwesten van Mijnsheerenland ligt de hoeve Even Ver (Brabersweg 4) die in de geveltop is gedateerd 1724. Het houten schuurgedeelte heeft mogelijk een 18de-eeuwse kern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01177> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Moerkapelle (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
