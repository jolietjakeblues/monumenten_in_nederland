        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Katwijk aan den Rijn (gemeente Katwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Katwijk aan den Rijn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 893 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0071> ;
        schema:name "Katwijk aan den Rijn (gemeente Katwijk)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De R.K. St.-Johannes de Doperkerk (Kerkstraat 72) is een driebeukige basilicale kruiskerk, voorzien van een toren van vier geledingen met achtzijdige naaldspits. Deze neogotische kerk verrees in 1911 naar plannen van J.H. van Groenendael. De toren is in 1983 gerestaureerd. In een zijkapel staat een 18de-eeuws barok zijaltaar, afkomstig uit de oude dorpskerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0071.php> .

