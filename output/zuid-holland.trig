        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwland (gemeente Zederik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwland" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0113> ;
        schema:name "Nieuwland (gemeente Zederik)"@nl ;
        schema:pageEnd "367" ;
        schema:pageStart "367" ;
        schema:pagination "367" ;
        schema:text "Langgerekt ontginningsdorp, ontstaan rond 1300 als cope-ontginning aan weerszijden van de Leerbroeksche Vliet. Bij de aansluiting met de Geervliet verrees de kerk en ontstond later een kleine dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwland (gemeente Zederik)"@nl ;
        min:adres "Dorpsplein 2" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Zederik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwland (gemeente Zederik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59394>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61539> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30531",
            "30532" ;
        min:soort "inleiding" ;
        min:volgnummer 1276 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0113> ;
        schema:name "Nieuwland (gemeente Zederik)"@nl ;
        schema:pageEnd "367" ;
        schema:pageStart "367" ;
        schema:pagination "367" ;
        schema:text "De Herv. kerk (Dorpsplein 2) is een eenbeukige kerk met driezijdig gesloten koor en een deels ingebouwde toren van drie geledingen met ingesnoerde spits. De romaanse toren verrees begin 14de eeuw en bevat een door Wilhelmus en Jasper Moer gegoten klok (1507). Het laat-gotische koor kwam in de 15de eeuw tot stand en het - oorspronkelijk driebeukige - schip begin 16de eeuw. De zijbeuken zijn vermoedelijk begin 19de eeuw afgebroken. Bij een ingrijpende restauratie in 1955-'57 (T. van Hoogevest) heeft men een nieuwe consistorie toegevoegd en de bovenste torengeleding vernieuwd. Tot de inventaris behoren een 17de-eeuwse preekstoel en een door J.F. Kruse gebouwd orgel (1905-'06, gerestaureerd 1984)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwland (gemeente Zederik) – Scholen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Zederik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwland (gemeente Zederik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwland" ;
        min:lemma "Scholen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1277 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0113> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "367" ;
        schema:pageStart "367" ;
        schema:pagination "367" ;
        schema:text """Scholen. De openbare lagere school Breezijde 2 werd in 1885 gebouwd als een tweeklassige school met onderwijzerswoning onder één dak. In 1919 ontstond bij Achterdijk 43 een school op L-vormige plattegrond.

De villa Breezijde 4 dateert uit 1906 en heeft rationalistische details en een erkervormige uitbouw."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01278> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwland (gemeente Zederik) – Boerderijen"@nl ;
        min:adres "Smalzijde 23",
