        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonhoven" ;
        min:lemma "Straatmeubilair" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1741 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0158> ;
        schema:name "Straatmeubilair"@nl ;
        schema:pageEnd "485" ;
        schema:pageStart "485" ;
        schema:pagination "485" ;
        schema:text "Straatmeubilair. De in 1898 geplante Wilhelminaboom (Trompertswal) wordt beschermd door ijzeren hekwerk met portretreliëfs. Aan de Lange Weistraat staat een kubusvormig trafohuisje uit circa 1930. D. Visser ontwierp in zakelijk-expressionistische vormen het urinoir met bloembak (Buiten de Veerpoort) uit 1932."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01742> a min:Passage,
