        min:gemeenteInBoek "Ter Aar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nieuwkoop_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ter Aar" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ter Aar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47192> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "6877" ;
        min:soort "inleiding" ;
        min:volgnummer 1821 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0170> ;
        schema:name "Ter Aar"@nl ;
        schema:pageEnd "500" ;
        schema:pageStart "500" ;
        schema:pagination "500" ;
        schema:text "De Herv. kerk (Aardamseweg 3) is een aan beide korte zijden driezijdig gesloten zaalkerk, voorzien van een kleine dakruiter met naaldspits. Deze neoclassicistische kerk verving in 1843 een voorganger uit 1568. De consistorie dateert van de restauratie in 1959-'61 (P. van der Sterre). Tot de inventaris behoren een preekstoel van circa 1843 en een doopvont uit 1859. De pastorie (Aardamseweg 6) verrees circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0170.php> .

