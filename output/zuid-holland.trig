        min:adres "Hoefweg 55",
            "Hoefweg 57" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Lansingerland" ;
        min:gemeenteInBoek "Bleiswijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lansingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bleiswijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bleiswijk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 348 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0021> ;
        schema:name "Bleiswijk"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De R.K. kerk O.L. Vrouwe Visitatie (Hoefweg 57) is een zaalkerk waarvan het ingangsrisaliet wordt bekroond door een houten klokkentoren. Deze neoclassicistische kerk kwam in 1854-'55 tot stand naar plannen van W. Thijssen. Het interieur met houten overwelving bevat een monumentaal Ypmaorgel (1872). De pastorie (Hoefweg 55; circa 1910) is voorzien van decoratief metselwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00349> a min:Passage,
