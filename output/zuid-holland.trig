        min:gemeenteInBoek "Hardinxveld-Giessendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hardinxveld-Giessendam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessendam (gemeente Hardinxveld-Giessendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessendam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 573 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0040> ;
        schema:name "Giessendam (gemeente Hardinxveld-Giessendam)"@nl ;
        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "Dorp, ontstaan bij de rond 1280 afgedamde monding van de Giessen. Op de noordoever van de Giessen vormde zich een langgerekte bebouwing (het deel buitendams aan de westzijde is Karnemelksloot gaan heten). In 1777 brandde de dorpskern af en in 1940 liep de kern bomschade op. Na de opheffing van de gemeente in 1957 is Giessendam samengegroeid met Neder-Hardinxveld en is het industrieterrein aan de zuidzijde tussen Karnemelksloot en de Beneden-Merwede vergroot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0040.php> .

