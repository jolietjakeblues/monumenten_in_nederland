        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0183> ;
        schema:name "Wateringen (gemeente Westland)"@nl ;
        schema:pageEnd "539" ;
        schema:pageStart "539" ;
        schema:pagination "539" ;
        schema:text "Het Wapen van Wateringen (Plein 4), een tweelaags pand met ingangsomlijsting en bordestrap met empire-details, werd gebouwd in 1828 als raadhuis annex logement met een doorrit naar het achtergelegen kleine waaggebouw. Tot 1920 heeft het als raadhuis dienst gedaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0183.php> .

