        schema:name "Numansdorp (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "381" ;
        schema:pageStart "381" ;
        schema:pagination "381" ;
        schema:text "Het waterschapshuis (Schuringsedijk 2), ook ‘Hoge Huys’ genoemd, is een gepleisterd neoclassicistisch tweelaags pand met attiekverdieping en naastgelegen kantoor en koetshuis. Het werd rond 1860 gebouwd voor burgemeester A. Vlielander, tevens rentmeester van de ambachtsheerlijkheid Cromstrijen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0122.php> .

