        min:soort "lemma" ;
        min:volgnummer 380 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0025> ;
        schema:name "Geref. kerken"@nl ;
        schema:pageEnd "97" ;
        schema:pageStart "97" ;
        schema:pagination "97" ;
        schema:text """Geref. kerken. De voorm. Geref. kerk Rivierdijk 338 is een zaalkerk uit 1861 (gevelsteen) met een wit gepleisterde ingezwenkte voorgevel. De huidige Geref. kerk Jan Steenstraat 5 (1962, A. Penning) is een moderne zaalkerk met ranke open dakruiter.

Het voorm. raadhuis (Rivierdijk 315), een neoclassicistisch tweelaags pand met middenrisaliet, kwam tot stand rond 1800. Erachter staat het kleine voorm. Groene Kruisgebouw (circa 1920)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00381> a min:Passage,
            schema:CreativeWork ;
