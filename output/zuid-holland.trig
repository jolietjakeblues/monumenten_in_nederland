        schema:name "Leeuwenhof"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "Leeuwenhof (Delftweg 122). Van deze rond 1645 aangelegde buitenplaats resteren na sloop van het huis (1893) alleen nog het koetshuis en de 18de-eeuwse boerderij met driezijdig gesloten erkerkamer (begin 19de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0133.php> .

