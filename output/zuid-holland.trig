        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Boerderijen. Waardevolle langhuisboerderijen zijn Langeraarseweg 73 (begin 19de eeuw) en Langeraarseweg 120, waarvan de stal van circa 1800, het voorhuis uit 1885 en zomerhuis uit 1920 dateren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0080.php> .

