        min:volgnummer 862 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0065> ;
        schema:name "Honselersdijk (gemeente Westland)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Dijkdorp in het Westland, nabij de plaats waar het middeleeuwse ‘Huis Honsel’ lag, dat in 1612 in het bezit kwam van prins Frederik Hendrik. Honselersdijk ligt in een door de glastuinbouw gedomineerd gebied."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00863> a min:Passage,
            schema:CreativeWork ;
