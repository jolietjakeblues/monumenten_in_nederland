        schema:pageEnd "481" ;
        schema:pageStart "480" ;
        schema:pagination "480-481" ;
        schema:text "De zaalkerk van de Remonstr. Geref. gemeente (Kruispoortstraat 6) [6] dateert uit 1881 en heeft een met lisenen en klimmend boogfries uitgevoerde tuitgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01728> a min:Passage,
