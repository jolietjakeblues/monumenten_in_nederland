        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Voorschoten" ;
        min:gemeenteInBoek "Voorschoten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorschoten_(gemeente)> ;
