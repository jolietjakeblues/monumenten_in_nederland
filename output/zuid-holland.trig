            "Stadhouderslaan 317" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Ridderkerk" ;
        min:gemeenteInBoek "Ridderkerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ridderkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
