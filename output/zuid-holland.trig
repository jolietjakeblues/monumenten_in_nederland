        min:volgnummer 831 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0061> ;
        schema:name "Herkingen (gemeente Dirksland)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De Herv. kerk (Scharloodijk 33) is een parallel aan de dijk geplaatste eenvoudige zaalkerk uit 1788. In de ranke geveltoren hangt een door Gerrit Bakker gegoten klok (1788). De kerk bevat een preekstoel (circa 1788) en tekstborden (1789 en 1790)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0061.php> .

