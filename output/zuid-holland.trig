        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delft_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delft" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Delft" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79098>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79099> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "525273",
            "525274" ;
        min:soort "inleiding" ;
        min:volgnummer 450 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0030> ;
        schema:name "Delft"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "De R.K. kerk Allerheiligst Sacrament (Poortlandplein 1), een driebeukige kerk met sobere ongelede toren en een lager portaal tussen toren en schip, kwam in 1938-'40 tot stand naar een traditionalistisch ontwerp van H. Thunissen. De doopkapel (circa 1960, T.W.C. Hekker) heeft glas-in-betonwerk van P. Wiegersma. De kerk bevat een marmeren beeld van Maria ten Hemelopneming (1818) en reliëfs en kruisgroep (1941) door H.J. Etienne. Ook het parochiehuis en de R.K. lagere school (Nassaulaan 2-2b) zijn door Thunissen ontworpen in traditionalistische vormen (1938-'39)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00451> a min:Passage,
            schema:CreativeWork ;
