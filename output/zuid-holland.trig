        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30538",
            "30539" ;
        min:soort "lemma" ;
        min:volgnummer 1239 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0107> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "Windmolens. Van de vroegere drie molens resteren twee met riet gedekte achtkante grondzeilers, te weten de Hoge Molen (Boezemkade 2) uit circa 1740, waarvan het scheprad in 1961 is vervangen door een vijzel, en de Kleine of Lage Molen (Boezemkade 3) uit 1761. Verder oostwaarts bevindt zich de ronde stenen romp van de vermoedelijk 18de-eeuwse korenmolen Lekdijk 415a."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01240> a min:Passage,
