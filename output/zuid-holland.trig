        min:volgnummer 810 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0058> ;
        schema:name "Heinenoord (gemeente Binnenmaas)"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Dijkdorp, ontstaan na de bedijking van de Polder Oud-Heinenoord (1437, herdijkt 1467). De kerk verrees op een zanderige rug naast een afgedamde kreek. De heerlijkheid was van 1460 tot 1793 bezit van de heer van Assendelft. Na de Watersnoodramp van 1953 werd de haven afgesloten en ontwikkelde zich ten noorden van de dijk een woonwijk. De oostelijker gelegen Heinenoordtunnel kwam in 1972 gereed."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00811> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heinenoord (gemeente Binnenmaas)"@nl ;
        min:adres "Hofweg 1",
            "Hofweg 7",
            "Kerkplein 12" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Binnenmaas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heinenoord (gemeente Binnenmaas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Heinenoord" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28036>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35422> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "21350",
            "21356" ;
        min:soort "inleiding" ;
        min:volgnummer 811 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill366>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill367> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0058> ;
        schema:name "Heinenoord (gemeente Binnenmaas)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "266" ;
        schema:pagination "266-267" ;
        schema:text "De Herv. kerk (Kerkplein 12) is een eenbeukige kerk met een driezijdig gesloten koor; de scheefgezakte toren van drie geledingen heeft een houten lantaarn en een ingesnoerde spits. Deze laat-gotische kerk werd midden 15de eeuw gebouwd. De houten torenlantaarn heeft men in 1772 recht op de scheve onderbouw geplaatst. Bij de kerkrestauratie van 1969-'74 is een consistoriekamer toegevoegd. Het kerkinterieur wordt gedekt door houten tongewelven. Tot de inventaris behoren een vroeg-17de-eeuwse preekstoel met doophek en herenbanken. Afkomstig uit de kerk te Oterdum (Gr.) is het door N.A. Lohman gebouwde orgel (1855, overgebracht 1974). De pastorie (Hofweg 7) is een deftig tweelaags woonhuis uit circa 1836. Het voorm. raadhuis (Hofweg 1), een gepleisterd eenlaagspand, werd gebouwd rond 1880 als eenklassige school met onderwijzerswoning en na 1889 verbouwd tot raadhuis en veldwachterswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00812> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heinenoord (gemeente Binnenmaas) – Hof van Assendelft"@nl ;
        min:adres "Hofweg 13" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Binnenmaas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heinenoord (gemeente Binnenmaas)" ;
