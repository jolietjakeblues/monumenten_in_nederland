        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Alphen aan den Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Alphen aan den Rijn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67416>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67419> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "516114",
            "516117" ;
        min:soort "inleiding" ;
        min:volgnummer 272 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill76> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0011> ;
        schema:name "Alphen aan den Rijn"@nl ;
        schema:pageEnd "76" ;
        schema:pageStart "75" ;
        schema:pagination "75-76" ;
        schema:text "De R.K. St.-Bonifatiuskerk (Paradijslaan 7) is een driebeukige pseudo-basilicale kruiskerk met vijfzijdige gesloten apsis, niet-uitstekend dwarsschip en een doopkapel; de toren telt drie geledingen en een achtkante lantaarn met spits. Aan weerszijden van de toren bevindt zich boven de zijbeuken een zaal. Deze neogotische kerk verrees in 1885-'86 naar ontwerp van E.J. Margry. Het gepolychromeerde neogotische interieur wordt gedekt door een houten spitstongewelf (schip) en stenen kruisribgewelven (zijbeuken). De inventaris uit het atelier Margry en Snickers omvat een zwart-marmeren doopvont (1892), een preekstoel (1889), hoofdaltaar (1892) en zijaltaren (1892). Het orgel (1900) is gebouwd door W. Hilboesen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00273> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Alphen aan den Rijn"@nl ;
        min:adres "Paradijslaan 3",
            "Paradijslaan 6",
            "Paradijslaan 7",
            "Paradijslaan 8" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
