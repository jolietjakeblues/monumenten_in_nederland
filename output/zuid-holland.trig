        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Alphen aan den Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Alphen aan den Rijn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32231> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "515522" ;
        min:soort "inleiding" ;
        min:volgnummer 274 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0011> ;
        schema:name "Alphen aan den Rijn"@nl ;
        schema:pageEnd "76" ;
        schema:pageStart "76" ;
        schema:pagination "76" ;
        schema:text "De (Geref.) Maranathakerk (Raadhuisstraat 82) is een zaalkerk met geveltoren en spits, gebouwd in 1888 naar ontwerp van W.C. Coepijn. De torenspits is uit 1913. De kerk bevat een 18de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Alphen aan den Rijn"@nl ;
        min:adres "Van Mandersloostraat 30" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Alphen aan den Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Alphen aan den Rijn" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0011> ;
        schema:name "Alphen aan den Rijn"@nl ;
        schema:pageEnd "76" ;
        schema:pageStart "76" ;
        schema:pagination "76" ;
        schema:text "De voorm. synagoge (Van Mandersloostraat 30), sinds 1955 in gebruik als Remonstr. kerk, is een recht gesloten zaalgebouw. Dit in 1833 opgerichte en in 1879 uitgebreide gebouw kreeg na een brand de huidige vorm bij een ingrijpende verbouwing in 1896 naar plannen van J. Hengeveld. Het oorspronkelijke interieur met Ark, lambrisering en galerij is nagenoeg geheel bewaard. In 1976 is een portaal aangebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Alphen aan den Rijn"@nl ;
        min:adres "Emmalaan 2",
            "Julianastraat 69" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Alphen aan den Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Alphen aan den Rijn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17417> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "7494" ;
        min:soort "inleiding" ;
        min:volgnummer 276 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0011> ;
        schema:name "Alphen aan den Rijn"@nl ;
        schema:pageEnd "76" ;
        schema:pageStart "76" ;
        schema:pagination "76" ;
        schema:text "De (Herv.) Adventskerk (Julianastraat 69) is een kruiskerk met vieringdakruiter en een terzijde geplaatste toren, gebouwd in 1920-'22 naar een ontwerp met rationalistische invloeden van W.Ch. Kuijper; ze verving een in 1916 door brand verwoest kerkgebouw. De kerk is in 1974-'75 gerenoveerd. Kuijper ontwierp tevens de neobyzantijnse preekstoel. Het orgel (1922) werd gebouwd door de firma G.F. Steinmeyer en Co. Achter de kerk staat de achtkante classicistische grafkapel van Theodorus baron de Smeth uit 1773. Deze kapel met gestukadoord koepelgewelf was aanvankelijk tegen de kerk gebouwd maar kwam na de brand in 1916 vrij te staan. De voorm. pastorie (Emmalaan 2) uit 1928 is ontworpen door Kuijper."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00277> a min:Passage,
