        min:soort "inleiding" ;
        min:volgnummer 1185 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0100> ;
        schema:name "Molenaarsgraaf (gemeente Graafstroom)"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "De (Geref.) Eben Haëzerkerk (Gijbelandsedijk 54) is een zaalkerk met houten dakruiter, gebouwd in 1897 als ‘oefenschool van Geloof, Hoop en Liefde’ blijkens de tekst boven de ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01186> a min:Passage,
