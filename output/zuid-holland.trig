        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill527> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0108> ;
        schema:name "Nieuwe-Tonge (gemeente Middelharnis)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "363" ;
        schema:pagination "363-364" ;
        schema:text "Het voorm. raadhuis (Voorstraat 2) werd in 1927 gebouwd naar een traditionalistisch ontwerp van J. van Vliet en J. van Bokkum. Van de afgebroken voorganger zijn het Justitia-beeld (1776) en de door Johannes Specht gegoten klok (1765) overgenomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01245> a min:Passage,
