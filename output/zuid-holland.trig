        schema:name "Krimpen aan de Lek (gemeente Nederlek)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De voorm. Geref. kerk (Molendijk 92b) is een zaalkerk uit 1926 met dakruiter. Sinds 1968 kerkt de gemeente in een nieuw gebouw (Hoofdstraat 90)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00963> a min:Passage,
