        min:hoofdstuk "Steden, dorpen, monumenten › Rijnsaterwoude (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Rijnsaterwoude" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1530 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0145> ;
        schema:name "Rijnsaterwoude (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "411" ;
        schema:pageStart "411" ;
        schema:pagination "411" ;
        schema:text "Ontginningdorp op de oostoever van het Braassemermeer, ontstaan in de middeleeuwen en voor het eerst vermeld in 1063. De ontginningsas wordt gevormd door de Herenweg. Nabij de Kerkweg bevindt zich een kleine dorpskom."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01531> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijnsaterwoude (gemeente Jacobswoude)"@nl ;
        min:adres "Herenweg 26" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijnsaterwoude (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Rijnsaterwoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48345> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "33006" ;
        min:soort "inleiding" ;
        min:volgnummer 1531 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill607> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0145> ;
        schema:name "Rijnsaterwoude (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "412" ;
        schema:pageStart "411" ;
        schema:pagination "411-412" ;
        schema:text "De Herv. kerk (Herenweg 26) is een eenbeukige kerk met driezijdig gesloten koor en een ingebouwde toren van drie geledingen met achtkante lantaarn. Ter plaatse van een midden-12de-eeuwse voorganger kwam het huidige koor rond 1500 tot stand en werden schip en toren herbouwd na verwoesting door een storm in 1552. In de toren hangt een door Cyprianus Crans gegoten klok (1750). Het schip kreeg waarschijnlijk midden 18de eeuw zijn huidige vorm. De in 1956-'58 gerestaureerde kerk wordt inwendig gedekt door houten tongewelven en bevat enkele grafzerken uit de 16de en 17de eeuw. Tot de inventaris behoren een preekstoel met doophek en doopbogen (circa 1650) en een kabinetorgel uit 1778."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0145.php> .

