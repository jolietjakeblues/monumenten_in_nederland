        min:gemeenteInBoek "Gouda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gouda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19180> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16747" ;
        min:soort "inleiding" ;
        min:volgnummer 638 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill247> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "Deze neogotische kerk verrees in 1902-'04 naar ontwerp van C.P.W. Dessing en verving een 18de-eeuwse schuilkerk. Het interieur is voorzien van stenen kruisribgewelven en ronde pijlers met colonnetten en bladkapitelen. Na de kerksluiting in 1972 heeft de Stichting Johan Maasbach Wereldzending het gebouw in 1979 in gebruik genomen (‘Gouwekerk’). De kerk is recent geheel gerestaureerd. De pastorie (Hoge Gouwe 39) werd circa 1890 in neorenaissance-stijl ontworpen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00639> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
        min:adres "J. van Lennepkade 3",
            "Tollensstraat 102" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Gouda" ;
        min:gemeenteInBoek "Gouda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gouda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 639 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "De R.K. kerk Allerheiligst Sacrament (J. van Lennepkade 3) is een sobere zaalkerk met een getrapt, recht gesloten koor en met zijkapellen en een door een toren met spits bekroonde voorbouw. Deze in traditionalistische vormen uitgevoerde kerk kwam in 1931-'32 tot stand naar ontwerp van J.P. Dessing. Iets jonger is de pastorie annex parochiehuis (Tollensstraat 102; circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

