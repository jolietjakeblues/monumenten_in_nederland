        schema:name "Boerderijen"@nl ;
        schema:pageEnd "400" ;
        schema:pageStart "400" ;
        schema:pagination "400" ;
        schema:text "Boerderijen. Voorbeelden van dijkboerderijen met een dwars woonhuis zijn Westeind 71-73 en Westeind 200 (beide circa 1890), beide met een benedendijks uitgebouwde stal en deeldeuren in het dwarse voorhuis aan de dijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01472> a min:Passage,
