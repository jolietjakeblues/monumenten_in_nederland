        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zoeterwoude_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoeterwoude-Dorp (gemeente Zoeterwoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zoeterwoude-Dorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12033>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54880> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "41034",
            "41035" ;
        min:soort "inleiding" ;
        min:volgnummer 1999 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill806> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0189> ;
        schema:name "Zoeterwoude-Dorp (gemeente Zoeterwoude)"@nl ;
        schema:pageEnd "545" ;
        schema:pageStart "545" ;
        schema:pagination "545" ;
        schema:text "De Herv. kerk (Dorpsstraat 17), oorspronkelijk gewijd aan St. Lebuïnus en St. Johannes, is een driebeukige pseudo-basilicale kruiskerk met vijfzijdig gesloten koor en een ingebouwde toren van drie geledingen met spits. De toren verrees in de tweede helft van de 15de eeuw en het koor kwam rond 1500 tot stand. Schip en dwarsschip zijn 16de-eeuws. De tijdens het beleg van Leiden in 1574 in brand gestoken kerk werd vervolgens in fases hersteld, waarbij rond 1650 het huidige aanzien ontstond. Het koor werd verhoogd (ovale vensters boven de spitsboogvensters) en de bovenste delen van schip en transept vernieuwd. Bij de ingrijpende restauratie in 1949-'57 heeft men de uit 1860 daterende beschieting van het tongewelf in de kerk vernieuwd en de in 1862 op de toren aangebrachte pleisterlaag verwijderd. Tot de kerkinventaris behoren enkele 17de- en 18de-eeuwse grafzerken, een preekstoel (circa 1650) en een door de gebroeders Franssen gebouwd orgel (circa 1870)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0189.php> .

