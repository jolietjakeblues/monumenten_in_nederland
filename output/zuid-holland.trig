        min:rijksmonumentnummer "506351",
            "524302" ;
        min:soort "lemma" ;
        min:volgnummer 1643 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0152> ;
        schema:name "Zwembaden"@nl ;
        schema:pageEnd "449" ;
        schema:pageStart "449" ;
        schema:pagination "449" ;
        schema:text "Zwembaden. Het overdekte Oostelijk Zwembad (Gerdesiaweg 480-482) [138] werd in 1932 gebouwd naar plannen van F. Kuipers met een gebogen betonnen overspanning en art décodetails. De in 1940 verwoeste ingangspartij heeft men in 1952 vernieuwd (M. Lockhorst). Het Sportfondsenbad Rotterdam Noord (Van Maanenstraat 8) [139] kwam in 1936-'37 met binnenen buitenbad tot stand naar een zakelijkexpressionistisch ontwerp van J.H. de Roos en W.F. Overeijnder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0152.php> .

