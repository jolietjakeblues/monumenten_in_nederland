        min:soort "lemma" ;
        min:volgnummer 934 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill405> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0076> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text "Woonhuizen. In 1881 is in neorenaissance-stijl de rentenierswoning Bouwlust (Molendijk 33) opgetrokken. Vergelijkbare details vertoont Havenweg 16 (circa 1890). De rond 1910 gebouwde villa Huize Annie (Molendijk 49) heeft een achtzijdig torentje boven het ingangsrisaliet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00935> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klaaswaal (gemeente Cromstrijen) – Boerderijen"@nl ;
        min:adres "Boomdijk 4",
            "Molendijk 61",
            "Oranjestraat 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Cromstrijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klaaswaal (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Klaaswaal" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11095> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "23664" ;
        min:soort "lemma" ;
        min:volgnummer 935 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0076> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text """Boerderijen. Een gedeeltelijk gepleisterd woongedeelte met 18de-eeuwse kern bezit de boerderij Oud-Cromstrijensedijk Oostzijde 50. Bij de vroeg-19de-eeuwse boerderij Buitenlust (Molendijk 61) is het woongedeelte voorzien van een ingezwenkte lijstgevel, waarin aan de rechterkant ook de inrijdeuren van de zijlangsdeel zijn opgenomen. Traditionalistische details vertoont de in 1912 gebouwde Adolphs hoeve (Boomdijk 4).

De watertoren (Oranjestraat 1) verrees in 1929 naar plannen van J. Smit en constructeur A. Visser. De zeszijdige toren is uitgevoerd in gewapend betonskeletbouw met baksteenvulling en heeft een ronde bovenbouw met betonnen vlakbodemreservoir."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0076.php> .

