        schema:name "Poldermolen"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Poldermolen ‘De Westermolen’ (Nieuwpoortseweg 1) is een uit 1652 stammende wipmolen met scheprad, een met riet gedekte ondertoren en een met hout bekleed bovenhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0081.php> .

