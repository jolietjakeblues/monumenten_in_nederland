        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0138> ;
        schema:name "Poeldijk (gemeente Westland)"@nl ;
        schema:pageEnd "404" ;
        schema:pageStart "404" ;
        schema:pagination "404" ;
        schema:text "Het voorm. liefdesgesticht (Voorstraat 86-88) is een neoclassicistisch tweelaags pand, gebouwd in 1874 naar ontwerp van H.J. van den Brink. Behalve zusterhuis voor de Zusters van Liefde te Oudenbosch was het tot 1957 bewaarschool en lagere meisjesschool. In 1985 werd het gesticht verbouwd en ingekort en verdween de oorspronkelijke kleine geveltoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Poeldijk (gemeente Westland)"@nl ;
        min:adres "Verburghlaan 24",
            "Voorstraat 31" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
