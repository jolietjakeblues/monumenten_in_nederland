        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ridderkerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ridderkerk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1523 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0144> ;
        schema:name "Ridderkerk"@nl ;
        schema:pageEnd "410" ;
        schema:pageStart "410" ;
        schema:pagination "410" ;
        schema:text "Kerkringdorp met kerkgracht, gesticht kort na de bedijking van de polder Oud-Reijerwaard (herdijkt in 1424). Haaks op de ringdijk (Molendijk) ontstond een voorstraat (St.-Jorisstraat) met - niet aan het einde maar ten noorden daarvan - een kerk met kerkgracht. Ridderkerk had in 1708 en 1731 te lijden van dorpsbranden en in 1916 van een watersnood. De buitendijks gelegen haven met havenkanaal naar de Noord werd in 1931 gedempt. De ontwikkeling tot forensengemeente na de Tweede Wereldoorlog heeft geleid tot een dorpssanering en forse uitbreidingen aan de zuid- en de westzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01524> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ridderkerk"@nl ;
        min:adres "Kerksingel 1",
            "Kerksingel 28" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Ridderkerk" ;
        min:gemeenteInBoek "Ridderkerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ridderkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
