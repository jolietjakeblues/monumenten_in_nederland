        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "De pastorie (Noordzijde 60) is een middengangwoonhuis, waarvan de eerste steen in 1875 werd gelegd door J.P.H.L.M. van Dam, heer van Nieuwland en Overslingeland. Rond 1900 is de verdieping toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01299> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordeloos (gemeente Giessenlanden) – Overige kerken"@nl ;
        min:adres "Botersloot 12",
            "Grotewaard 9a",
            "Noordzijde 1-1a" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordeloos (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noordeloos" ;
