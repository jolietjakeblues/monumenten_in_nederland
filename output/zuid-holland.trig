        min:hoofdstuk "Steden, dorpen, monumenten › Noordeloos (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noordeloos" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1295 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0116> ;
        schema:name "Noordeloos (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "Langgerekt ontginningsdorp, ontstaan rond 1300 op stroomruggen aan weerszijden van de veenstroom de Noordeloos. Aan de zuidzijde stond het in 1293 voor het eerst vermelde kasteel van de heren van Noordeloos (verbrand 1573, gesloopt 1880). Bij brug en kerk ontstond eind 19de eeuw een bescheiden verdichting van de bebouwing. Noordeloos is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01296> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordeloos (gemeente Giessenlanden)"@nl ;
        min:adres "Kerkstraat 3c" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
