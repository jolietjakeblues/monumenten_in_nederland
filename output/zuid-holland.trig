        schema:pageEnd "540" ;
        schema:pageStart "540" ;
        schema:pagination "540" ;
        schema:text "De voorm. Chr. lagere school (Smidsweg 6) werd in 1890 gebouwd als een drieklassige gangschool met aangebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0184.php> .

