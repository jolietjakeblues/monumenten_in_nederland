        schema:pageStart "548" ;
        schema:pagination "548" ;
        schema:text "De voorm. synagoge (Breedstraat 10) werd in 1887 gevestigd in een uit circa 1860 daterend woonhuis met een gepleisterde afgeknotte puntgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

