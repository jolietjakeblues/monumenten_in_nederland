        min:hoofdstuk "Steden, dorpen, monumenten › Delft" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Delft" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18753> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "11841" ;
        min:soort "inleiding" ;
        min:volgnummer 446 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0030> ;
        schema:name "Delft"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "De voorm. synagoge (Koornmarkt 12) [9], een zaalgebouw voorzien van een streng neoclassicistisch ionisch tempelfront met fronton, werd in 1862 (5622) gebouwd naar ontwerp van L. Winkel. Bij ingrijpende herstellingen in 1931 heeft men de versiering in het fronton verwijderd. Het interieur van de in 1994 gerestaureerde synagoge bevat een overhuifde Torah-kast met vier corinthische zuilen en een vrouwengalerij met balustrade."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00447> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delft"@nl ;
        min:adres "Burgwal 22" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Delft" ;
        min:gemeenteInBoek "Delft" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delft_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delft" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Delft" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 447 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill137> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0030> ;
        schema:name "Delft"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "118" ;
        schema:pagination "118-119" ;
        schema:text "De R.K. Maria van Jessekerk (Burgwal 22) [10] kwam in 1875-'81 tot stand als St.-Jozefkerk naar een neogotisch ontwerp van E.J. Margry en met J. Tonnaer als uitvoerend architect. Deze forse driebeukige basilicale kruiskerk heeft een vijfzijdig gesloten koor en een front met twee torens van drie geledingen met achtzijdige naaldspitsen. De rechter toren heeft een vierkante klokkenverdieping met wimbergen en hoektorentjes en de linker toren een achthoekige lantaarn; deze elementen zouden op de torens van de Oude en Nieuwe Kerk geïnspireerd zijn. Boven de ingang bevinden zich een St.-Antoniusbeeld en een tronende Christus. Na de afbraak van de St.-Hippolytuskerk aan de Voorstraat (1886-1971) kreeg de kerk de huidige naam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00448> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delft"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Delft" ;
        min:gemeenteInBoek "Delft" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delft_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Delft" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Delft" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 448 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0030> ;
        schema:name "Delft"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "Het interieur van de in 1992-2004 gerestaureerde kerk heeft een schip met houten tongewelven. De schildering van de tronende Christus op de triomfboog is ontworpen door Margry. Tot de rijke inventaris behoort een door A. van IJsendyck in 1837 geschilderd altaarstuk (Aanbidding van de Herders) afkomstig uit de vorige kerk. Het hoofdaltaar, het Mariaen het Jozefaltaren (alle 1886) zijn vervaardigd door atelier Margry, de kruiswegstaties (1885) door atelier Te Poel & Stoltefus. Verder bevat de kerk een Maarschalkerweerd-orgel (1893), een fraai bewerkte neogotische preekstoel (1903; ontwerp J. Tonnaer) en een marmeren doopvont (1907). De gebrandschilderde vensters in de koorsluiting (1962) zijn van J. Nicolas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00449> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Delft"@nl ;
        min:adres "Raamstraat 74" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
