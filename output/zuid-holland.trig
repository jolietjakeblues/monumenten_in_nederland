        min:volgnummer 1210 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0103> ;
        schema:name "Naaldwijk (gemeente Westland)"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "De voorm. pastorie (Wilhelminaplein 8), een diep huis met trapgevel, werd rond 1645 gebouwd en kreeg rond 1770 een ingangsomlijsting. Ervoor staat een hardstenen dorpspomp met leeuwenkop uit 1629 (hersteld in 1774, 1801, 1823 en 1887)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01211> a min:Passage,
