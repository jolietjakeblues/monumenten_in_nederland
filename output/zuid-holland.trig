        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill620> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0151> ;
        schema:name "Roelofarendsveen (gemeente Alkemade)"@nl ;
        schema:pageEnd "421" ;
        schema:pageStart "421" ;
        schema:pagination "421" ;
        schema:text "De R.K. kerk O.L. Vrouwe Presentatie (Pastoor Onelplein 3) is een brede eenbeukige kerk met driezijdig gesloten apsis en een haaks aangebouwde sacristie. De kerk kwam in 1950-'51 tot stand naar een traditionalistisch ontwerp van H.P.J. de Vries, die ook de pastorie (Pastoor Onelplein 1) ontwierp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0151.php> .

