            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58696> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "10255",
            "29771",
            "29851" ;
        min:soort "inleiding" ;
        min:volgnummer 482 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0032> ;
        schema:name "Dirksland"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Het raadhuis (Voorstraat 15) is een rijzig tweelaags pand met dakruiter, gebouwd in 1835 in neoclassicistische stijl, met ingangsomlijsting, pilastergeleding (verdieping) en een kroonlijst met fronton. De (oorspronkelijke) gevelbepleistering is in 1949 verwijderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00483> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dirksland"@nl ;
        min:adres "Ring 43" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Dirksland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dirksland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Dirksland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60014> ;
