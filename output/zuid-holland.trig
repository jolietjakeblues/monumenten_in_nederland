        schema:pageEnd "399" ;
        schema:pageStart "399" ;
        schema:pagination "399" ;
        schema:text "De voorm. (Chr. Geref.) Groene Kerk (tegenover Westeind 47) is een zaalkerk uit 1913, waarvan de voorgevel is voorzien van een klimmend rondboogfries en neorenaissance-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0134.php> .

