        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0132> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "Begraafplaatsen. De Oude Alg. begraafplaats (tegenover IJsseldijk Noord 67) werd in 1828 binnendijks aangelegd. Opmerkelijk is het houten, grijs geschilderde, baarhuisje in neoclassicistische stijl (circa 1850). De topgevel is gedecoreerd met zeisen en een zandloper. Naast de ingang staat een postament met afgebroken zuil, ter nagedachtenis van A.J. Schelling († 1883), overleden te Caïro. De Nieuwe Alg. begraafplaats (IJsseldijk Noord 12) dateert uit 1928 en heeft een achtzijdige aula met aanbouwen en expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01457> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overschie (gemeente Rotterdam)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
