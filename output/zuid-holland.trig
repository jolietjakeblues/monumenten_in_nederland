        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40102>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47591> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16185",
            "16192" ;
        min:soort "lemma" ;
        min:volgnummer 586 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0041> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text """Windmolen ‘De Windvang’ (Goereeseweg 5) is een ronde grondzeiler met een met dakleer beklede kap. Deze in 1791 gebouwde korenmolen is in 1968 gerestaureerd.

De voorm. smederij (bij Markt 6) is een diep pand met tuitgevel uit 1794. Ervoor staat een houten travalje."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0041.php> .

