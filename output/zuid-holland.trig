        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "De Chr. lagere Rehobothschool (Schoolstraat 4), gebouwd rond 1925, bestaat uit bouwvolumes van verschillende hoogten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00575> a min:Passage,
