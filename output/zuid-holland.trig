        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "392" ;
        schema:pageStart "392" ;
        schema:pagination "392" ;
        schema:text "Bedrijfsgebouwen. Rond 1860 gebouwd voor de familie De Koning is het langgerekte tweelaags pand van de voorm. zadelmakerij Oostdijk 2. Winkel en werkplaats zijn nog geheel in de staat zoals deze in 1948 zijn achtergelaten, inclusief de inventaris. Het voorm. kaaspakhuis Oostdijk 21 is een gepleisterd pand uit 1875."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01424> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Beijerland – Bruggen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Oud-Beijerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Beijerland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Oud-Beijerland" ;
        min:lemma "Bruggen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1424 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill572> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0128> ;
        schema:name "Bruggen"@nl ;
        schema:pageEnd "392" ;
        schema:pageStart "392" ;
        schema:pagination "392" ;
        schema:text """Bruggen. Om de Alg. begraafplaats goed te kunnen bereiken heeft men in 1864 de voetgangersbrug aan de Korte Laning gebouwd, geconstrueerd uit smeed- en gietijzeren delen door de firma F.J. Penn & Co. uit Dordrecht. De met gietijzeren leuningen uitgevoerde bakstenen boogbrug over het water van de Voorstraat dateert van circa 1880.

De Alg. begraafplaats (Korte Laning ong.) werd in 1828 aangelegd en in 1860 uitgebreid. Het gietijzeren hek (1829) is van ijzergieterij ‘De Prins van Oranje’. Interessant is het grafteken met obelisk op postament voor architect F. Smit († 1887)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01425> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ouddorp (gemeente Goedereede)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Goedereede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ouddorp (gemeente Goedereede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ouddorp" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1425 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0129> ;
        schema:name "Ouddorp (gemeente Goedereede)"@nl ;
        schema:pageEnd "392" ;
        schema:pageStart "392" ;
        schema:pagination "392" ;
        schema:text "Kerkringdorp, ontstaan in de middeleeuwen aan de zuidrand van de duinen. Het dorp was oorspronkelijk het centrum van het eiland Goeree, maar werd later overvleugeld door de stad Goedereede. Ten zuiden van Ouddorp ligt een vliedberg, overblijfsel van het 13de-eeuwse kasteel Spreeuwenberg. Het omringende land werd in cultuur gebracht door na het tijdelijk verwijderen van de bovenlaag het onderliggende duinzand af te graven. Van het vrijgekomen duinzand maakte men lage walletjes (schurvelingen). Op enige afstand ten zuiden van het dorp werd in 1860 een haven aangelegd. Na de Tweede Wereldoorlog is de ontwikkeling van Ouddorp tot vakantieoord begonnen, waarbij vanaf de jaren zestig vooral ten noorden en westen van het dorp recreatiecomplexen tot stand zijn gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01426> a min:Passage,
            schema:CreativeWork ;
