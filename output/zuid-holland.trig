        min:kern "Langeraar" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 969 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0080> ;
        schema:name "Langeraar (gemeente Ter Aar)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Ontginningdorp, ontstaan in de middeleeuwen. De ontginningsas wordt gevormd door de Langeraarseweg. Het gebied ten zuidoosten van Langeraar werd in de 18de en 19de eeuw uitgeveend, waarna de Langeraarsche Plassen ontstonden. Aan de westzijde kwam in 1865 de Wassenaarse Polder tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00970> a min:Passage,
