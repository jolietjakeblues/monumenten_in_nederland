        min:volgnummer 997 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0083> ;
        schema:name "Arbeiderswoningen"@nl ;
        schema:pageEnd "299" ;
        schema:pageStart "299" ;
        schema:pagination "299" ;
        schema:text "Arbeiderswoningen. Vooral voor de arbeiders van de glasfabrieken verrezen rond 1900 woningrijen aan de Nieuwenhuyzenstraat, Julianastraat, Siemensstraat en Meent. Rond 1910 bouwde men rond het Lingeplein een tuinwijkachtige arbeiderswijk met wit gepleisterde woningen. Zakelijk-expressionistische woningen kwamen rond 1925 tot stand in de omgeving van de Rozenstraat en de Talmastraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0083.php> .

