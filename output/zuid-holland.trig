        min:soort "lemma" ;
        min:volgnummer 1583 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0150> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "421" ;
        schema:pageStart "421" ;
        schema:pagination "421" ;
        schema:text "Begraafplaatsen. De Alg. begraafplaats (Zeeweg ong.) werd gesticht in 1828 en vergroot in 1898. Het grafteken met hogel is opgericht voor J. Trouw († 1913). De Nieuwe Alg. begraafplaats (Ommeloop ong.) is kort vóór 1950 in de duinen aangelegd naar plannen van P. Verhagen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0150.php> .

