        min:rijksmonumentnummer "524460",
            "524461" ;
        min:soort "inleiding" ;
        min:volgnummer 1873 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0176> ;
        schema:name "Voorburg (gemeente Leidschendam-Voorburg)"@nl ;
        schema:pageEnd "515" ;
        schema:pageStart "515" ;
        schema:pagination "515" ;
        schema:text "De R.K. kerk O.L. Vrouwe Hemelvaart (Laan van Nieuw Oosteinde 1-3) is een in 1924-'25 naar ontwerp van P.G. Buskens gebouwde zaalkerk in traditionalistische stijl met bijbehorende pastorie. De kerk heeft een getrapt, recht gesloten, koor en een iets lagere voorbouw met drie ingangsportalen. Naast de voorgevel bevindt zich de aanzet van een onvoltooide toren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01874> a min:Passage,
            schema:CreativeWork ;
