        schema:name "Moerkapelle (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "Het voorm. raadhuis (Raadhuisplein 1) is een wit gesausd tweelaags pand in traditionalistische vormen, gebouwd rond 1950 met een bodewoning ernaast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0099.php> .

