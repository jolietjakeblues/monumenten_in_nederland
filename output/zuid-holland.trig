        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "38202" ;
        min:soort "inleiding" ;
        min:volgnummer 1914 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill772>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill773> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0180> ;
        schema:name "Waddinxveen"@nl ;
        schema:pageEnd "525" ;
        schema:pageStart "524" ;
        schema:pagination "524-525" ;
        schema:text "De Herv. kerk (Kerkweg-Oost 232) is een grotendeels gepleisterde T-vormige kerk met dorisch zuilenportiek en een klokkentoren met ionisch front en twee houten geledingen. Deze neoclassicistische kerk werd in 1837 naar plannen van A. Blaauw gebouwd. Het interieur wordt gedekt door een houten koofplafond. Tot de inventaris behoren een preekstoel (circa 1840) en een door J.P. Schmidt gebouwd orgel (1808)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0180.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01915> a min:Passage,
