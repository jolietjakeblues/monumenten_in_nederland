        min:kern "Delft" ;
        min:lemma "Bruggen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18657>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19886>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23801>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24450>,
