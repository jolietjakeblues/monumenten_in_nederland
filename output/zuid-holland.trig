        min:volgnummer 1409 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0127> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "390" ;
        schema:pageStart "390" ;
        schema:pagination "390" ;
        schema:text "Woonhuizen. Het uit 1846 daterende diepe huis Brugstraat 3-7, vroeger in gebruik als bakkerij, heeft een klokgevel met houten fronton. Het dwarse herenhuis Dorpsstraat 54 (circa 1850) is uitgevoerd met klokgevels aan de korte zijden. Laat-19de-eeuws zijn de eenvoudige dorpswoningen Dorpsstraat 42-44 (circa 1890) en het door dakerkers met frontons opvallende Huize Norder (Westeinde 61-62; circa 1895)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0127.php> .

