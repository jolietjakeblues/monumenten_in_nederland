        min:volgnummer 420 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0029> ;
        schema:name "Delfshaven (gemeente Rotterdam)"@nl ;
        schema:pageEnd "110" ;
        schema:pageStart "110" ;
        schema:pagination "110" ;
        schema:text "De Geref. kerk (Coloniastraat 27) is een traditionalistisch vormgegeven zaalkerk uit 1933 en bevat een door Bakker & Timmenga gebouwd orgel (1902)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00421> a min:Passage,
