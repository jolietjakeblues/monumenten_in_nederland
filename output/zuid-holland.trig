        min:rijksmonumentnummer "20082" ;
        min:soort "lemma" ;
        min:volgnummer 1572 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0149> ;
        schema:name "De Voorde"@nl ;
        schema:pageEnd "418" ;
        schema:pageStart "418" ;
        schema:pagination "418" ;
        schema:text "De Voorde (Van Vredenburchweg 985) is een statig, maar sober, tweelaags buitenhuis met omlijste ingang. Het werd in 1800 voor de verhuur gebouwd in opdracht van Jacob van Vredenburch op een deel van het landgoed Overvoorde, waarvan het in 1889 werd afgescheiden. Het bijbehorende landschappelijke park heeft slingerpaden en zichtassen. De tuinmanswoning dateert uit 1806."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01573> a min:Passage,
