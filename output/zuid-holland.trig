        rdfs:label "Gorinchem – Overige kerken"@nl ;
        min:adres "Achter de Kerk 4",
            "Gasthuisstraat 47",
            "Groenmarkt 8",
            "Haarstraat 39",
            "Molenstraat 15",
            "Molenstraat 40",
            "Nieuwe Hoven 143",
            "Scheywijck 1",
            "Westwagenstraat 12-14" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Gorinchem" ;
        min:gemeenteInBoek "Gorinchem" ;
