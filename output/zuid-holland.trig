            "29879" ;
        min:soort "inleiding" ;
        min:volgnummer 1782 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill724> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0164> ;
        schema:name "Stad aan 't Haringvliet (gemeente Middelharnis)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "493" ;
        schema:pagination "493-494" ;
        schema:text "De Herv. kerk (Nieuwstraat 27) is een eenbeukige kerk met driezijdig gesloten koor en een geveltoren met ingesnoerde spits. Deze laat-gotische kerk werd waarschijnlijk in 1534 gebouwd en in 1586 opgeknapt. Na een brand in 1898 stonden alleen nog de buitenmuren. Het herstel in 1899 werd gevolgd door de toevoeging van de toren in 1923 en een kerkrestauratie in 1925-'26, waarbij de venstertraceringen zijn hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01783> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stad aan 't Haringvliet (gemeente Middelharnis)"@nl ;
