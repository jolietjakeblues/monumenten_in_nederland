        min:hoofdstuk "Steden, dorpen, monumenten › Ammerstol (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ammerstol" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 298 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0013> ;
        schema:name "Ammerstol (gemeente Bergambacht)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Het voorm. postkantoor (Lekdijk 128-130) is een fors dijkpand met dienstwoning, in 1901 gebouwd voor de zalmvissers die hier hun prijsopgaven verzonden. Het middendeel met trapgevel in neorenaissance-vormen wordt geflankeerd door lagere zijvleugels met dakhuizen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00299> a min:Passage,
            schema:CreativeWork ;
