        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ammerstol (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ammerstol" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 294 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill85> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0013> ;
        schema:name "Ammerstol (gemeente Bergambacht)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Dijkdorp langs de Lek, ontstaan op een in de 12de eeuw bedijkte oeverwal. Ammerstol kreeg in 1233 een grafelijke tol en in 1322 tolvrijheid en een jaarmarkt. De beoogde stedelijke concurrentie met Schoonhoven was niet succesvol en in 1401 verhuisde de grafelijke tol naar Schoonhoven. De zalmvisserij zorgde in de 19de eeuw voor een bescheiden bloei. Dit leidde vanaf 1850 tot enige verdichting van de dorpsbebouwing en rond 1900 tot nieuwbouw verder stroomopwaarts (Hogedijk). Na de Tweede Wereldoorlog is het dorp noordwaarts in de polder uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00295> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ammerstol (gemeente Bergambacht)"@nl ;
        min:adres "Kerkplein 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Bergambacht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ammerstol (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ammerstol" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29224>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43976> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "515507",
            "8102" ;
        min:soort "inleiding" ;
        min:volgnummer 295 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0013> ;
        schema:name "Ammerstol (gemeente Bergambacht)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "De Herv. kerk (Kerkplein 4) is een eenbeukige zaalkerk voorzien van een half ingebouwde toren van drie geledingen met wimbergen en een achtzijdige spits. Deze met steunberen, rondboogvensters en eclectische details uitgevoerde kerk verrees in 1880-'81 naar ontwerp van L.J. Redeker en verving een in 1331 gestichte kruiskerk. In de toren hangt een door Antonius de Borch gegoten klok (1564). Tot de inventaris behoren een preekstoel op stenen voet (eerste helft 17de eeuw) en een herenbank (eerste helft 17de eeuw) met een toegevoegd wapen van ambachtsheer Adolf van Renesse (midden 18de eeuw). Verder bevat de kerk twee psalmborden uit 1677, een bord met bijbelteksten uit 1684 (alle Jan van Munnickhoff) en een rouwbord voor ambachtsheer Jacob de Cuypre († 1702). Het orgel werd gebouwd door L. van Dam & Zn. (1885-'86)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00296> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ammerstol (gemeente Bergambacht)"@nl ;
        min:adres "Lekdijk 162" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
