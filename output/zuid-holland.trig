        schema:pageEnd "498" ;
        schema:pageStart "498" ;
        schema:pagination "498" ;
        schema:text "De Geref. kerk (Spui 12) is een zaalkerk uit 1892 met dakruiter. De aangebouwde pastorie dateert uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01815> a min:Passage,
            schema:CreativeWork ;
