        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0084> ;
        schema:name "Leiden"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "309" ;
        schema:pagination "309" ;
        schema:text "De voorm. (Geref.) Oude Vestkerk (Oude Vest 133) werd in 1888 gebouwd naar ontwerp van J. van der Heijden. Na de sloop van een huis aan de straat verrees daar in 1900 een voorportaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0084.php> .

