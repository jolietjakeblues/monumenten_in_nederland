        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordeloos (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noordeloos" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48516> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30642" ;
        min:soort "inleiding" ;
        min:volgnummer 1296 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill537> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0116> ;
        schema:name "Noordeloos (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "De Herv. kerk (Kerkstraat 3c), oorspronkelijk gewijd aan St. Bonifatius, is een eenbeukige kerk met vijfzijdig gesloten koor, noordtransept en een toren van drie geledingen met achtzijdige spits. De mogelijk uit circa 1300 daterende torenonderbouw - verhoogd en voorzien van westelijke steunberen in 1613 - werd in 1877-'78 omklampt toen men de bovenbouw nieuw opmetselde. Het koor en het noordtransept stammen uit de 15de eeuw. Bij een ingrijpende verbouwing in 1846 heeft men het zuidtransept afgebroken en het schip vernieuwd. Restauraties zijn uitgevoerd in 1949 (toren), 1966 (kerk) en 1976 (torenspits)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01297> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordeloos (gemeente Giessenlanden)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordeloos (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noordeloos" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1297 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0116> ;
        schema:name "Noordeloos (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf en bevat een gotisch doopvont van Namense steen (begin 16de eeuw), een preekstoel (1614), een tiengebodenbord (1607), een tekstbord in Lodewijk XV-vormen en twee rouwborden (1748). In het koor staat een grafmonument uit 1781 voor ambachtsheer Martinus van Barnevelt († 1775), waarvan het marmeren middengedeelte in rijke Lodewijk XV-vormen - met zuilen, baldakijn en buste - wordt geflankeerd door zijmuurtjes en toegangen naar de achterliggende grafkelder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0116.php> .

