        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0066> ;
        schema:name "Hoogblokland (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Ontginningsdorp, ontstaan rond het jaar 1000 op enkele donken. De bebouwing bleef vooral beperkt tot de Dorpsweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00867> a min:Passage,
