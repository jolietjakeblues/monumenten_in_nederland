        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0172> ;
        schema:name "Valkenburg"@nl ;
        schema:pageEnd "501" ;
        schema:pageStart "501" ;
        schema:pagination "501" ;
        schema:text "De Herv. kerk (Castellumplein 1) is een zaalkerk met driezijdig gesloten apsis, gebouwd in 1950 naar een ontwerp (1942) van G.M. Verloo ter vervanging van de in 1940 verwoeste middeleeuwse dorpskerk. De toren met achtkantige lantaarn is in 1999 toegevoegd. Aan de zuidzijde (Broekweg ong.) ligt een kleine militaire begraafplaats met monument."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0172.php> .

