        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "Pakhuizen. Aan de vroegere zuivelnijverheid herinneren het pakhuis Kerkstraat 22 (1860) en het kaaspakhuis Sluis 51 (circa 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0050.php> .

