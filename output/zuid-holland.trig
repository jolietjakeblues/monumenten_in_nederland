        min:kern "Zuidland" ;
        min:lemma "Tuinkoepels" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 2016 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill812> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0191> ;
        schema:name "Tuinkoepels"@nl ;
        schema:pageEnd "549" ;
        schema:pageStart "548" ;
        schema:pagination "548-549" ;
        schema:text "Tuinkoepels. In de tuin van Stationsweg 7 staat een achtzijdige theekoepel met overstekend rieten dak, gebouwd rond 1800 in Lodewijk XVI-stijl. Achter het dwarse pand Raadhuisstraat 25, met een gevelsteen uit 1770, staat een 19de-eeuwse zeszijdige tuinkoepel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02017> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidland (gemeente Bernisse) – Winkels"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
