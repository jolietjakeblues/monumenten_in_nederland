        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "De (Geref.) Eben Haëzerkerk (Molendijk 84) is een zaalkerk uit 1928 met kleine dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00674> a min:Passage,
