        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Strijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Strijen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Strijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16716> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "521942" ;
        min:soort "inleiding" ;
        min:volgnummer 1815 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0169> ;
        schema:name "Strijen"@nl ;
        schema:pageEnd "498" ;
        schema:pageStart "498" ;
        schema:pagination "498" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 54) verrees in 1926-'27 in zakelijk-expressionistische vormen, naar ontwerp van D. Visser en met D.H. Lammers als uitvoerend architect. Opvallend zijn de robuuste toren boven de ingang en de raadzaal met langgerekte glas-in-loodramen naar ontwerp van V. Huszar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01816> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Strijen – Woonhuizen"@nl ;
        min:adres "Kerkstraat 47",
            "Kerkstraat 78",
            "Nieuwedijk 87",
            "Schelpweg 46" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Strijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Strijen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Strijen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1816 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill732>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill733> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0169> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "499" ;
        schema:pageStart "498" ;
        schema:pagination "498-499" ;
        schema:text """Woonhuizen. De zijgevel van het uit circa 1910 daterende huis Kerkstraat 65 bevat een renaissance-cartouche met de kop van een moor en het jaartal 1575. Een 18de-eeuwse kern hebben de van puntgevels voorziene huizen Kerkstraat 3 en 11-13. In neoclassicistische stijl gebouwd zijn het middenganghuis Kerkstraat 34 (circa 1850) en het forse huis Molenstraat 31 (circa 1880). Bij het in omvang vergelijkbare herenhuis Kerkstraat 60 (circa 1880) zijn eclectische details toegepast. Voorbeelden van eclectisch vormgegeven middenganghuizen met hoger opgetrokken middenrisaliet zijn Molenstraat 66 (circa 1875) en Schelpweg 8 (1883). Jugendstil- en rationalistische details vertoont het huis Kerkstraat 6 (circa 1919).

Het winkelpand Kerkstraat 24 heeft een gepleisterde ingezwenkte lijstgevel en een winkelpui uit circa 1890 met eclectische details en gietijzeren zuiltjes.

De voorm. smederij (Kerkstraat 47), nu een museum, zou in de kern uit de 15de eeuw dateren, heeft een gevelsteen uit 1764 en kreeg rond 1900 haar huidige gepleisterde uiterlijk. Ervoor staat een ijzeren travalje.

De spuisluis (Boompjesstraat ong.) werd in 1612 gebouwd om bij springvloed zeewater in de Keen te kunnen inlaten en vervolgens de haven te ‘schuren’ tegen verzanding. De stenen boogbrug dateert uit 1841.

De watertoren (Schelpweg 46) verrees in 1914 naar ontwerp van J. Smit en constructeur A. Visser. De bakstenen toren heeft een uitkragende bovenbouw met ijzeren vlakbodemreservoir.

De voorm. vlasroterij (bij Nieuwedijk 87) dateert van circa 1930 en bestaat uit enkele rootkamers en een schoorsteen.

De Alg. begraafplaats (Kerkstraat 78) werd rond 1829 aangelegd. Opvallend is de grafzerk voor Schilleman Herweijer Jilles († 1874)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01817> a min:Passage,
            schema:CreativeWork ;
