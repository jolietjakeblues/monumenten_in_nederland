        schema:name "Langerak (gemeente Liesveld)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Dijkdorp langs de Lek, ontstaan op een omstreeks 1277 bedijkte oeverwal en voor het eerst vermeld in 1285. Binnendijks ontstond enige bebouwing rond de in de laagte achter de dijk gelegen kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0081.php> .

