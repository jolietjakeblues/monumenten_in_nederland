        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15181> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "42003" ;
        min:soort "lemma" ;
        min:volgnummer 837 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0061> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Windmolen ‘De Dankbaarheid’ (Molendijk 69) is een ronde, wit gepleisterde grondzeiler met een met dakleer beklede kap. Deze in 1841 gebouwde korenmolen is in 1997 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00838> a min:Passage,
