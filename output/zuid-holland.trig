        rdfs:label "Warmond – Boerderijen"@nl ;
        min:adres "Dorpsstraat 5",
            "Dorpsstraat 89",
            "Jan Steenlaan 5-7" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
