        schema:name "Geref. kerken"@nl ;
        schema:pageEnd "365" ;
        schema:pageStart "365" ;
        schema:pagination "365" ;
        schema:text "Geref. kerken. De voorm. Geref. kerk Kerklaan 46 is een zaalkerk uit 1912 met boogfries en decoratief pleisterwerk. De huidige Geref. kerk 's Gravenweg 71, een zaalkerk met spitsboogvensters, dateert uit 1925-'27."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0111.php> .

