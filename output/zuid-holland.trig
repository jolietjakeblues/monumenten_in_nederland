        min:gemeenteInBoek "Zederik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leerbroek (gemeente Zederik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Leerbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29769>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54949> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "24031",
            "24032" ;
        min:soort "inleiding" ;
        min:volgnummer 981 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0082> ;
        schema:name "Leerbroek (gemeente Zederik)"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "294" ;
        schema:pagination "294-295" ;
        schema:text "De Herv. kerk (Dorpsweg 10) is een eenbeukige, recht gesloten kerk met consistoriekamer en een forse toren van drie geledingen met overhoekse steunberen, balustrade en tentdak. De begin 15de eeuw opgetrokken laat-gotische toren wordt geflankeerd door lage aanbouwen met lessenaardaken. Het laat-gotische schip met natuurstenen hoekblokken kwam in de eerste helft van de 16de eeuw tot stand. Het oude koor heeft men vermoedelijk in de 18de eeuw afgebroken. Bij een brand in 1935 bleven van de kerk slechts de muren gespaard. Het herstel vond plaats in 1936 onder leiding van A. van Essen, die ook de consistorie ontwierp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00982> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leerbroek (gemeente Zederik)"@nl ;
        min:adres "Dorpsweg 4-6" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
