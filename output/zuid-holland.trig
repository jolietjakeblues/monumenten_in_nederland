        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14789>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65371>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65372>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65373> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "516055",
            "516056",
            "516057",
            "516058" ;
        min:soort "lemma" ;
        min:volgnummer 956 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0078> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Bedrijfsgebouwen. De scheepswerf Van Duijvendijk heeft een in rijke neorenaissance-stijl uitgevoerde directeurswoning (IJsseldijk 332; circa 1895). Ertegenover staat het met hout beklede kantoorgebouw (IJsseldijk 363; circa 1900) met dwars hiertegenaan een lange houten loods (mogelijk eerste helft 19de eeuw). Bij het complex horen verder een tweede schuur en een scheepshelling. Van de in de Stormpolder gebouwde scheepswerf Van der Giessen (Schaardijk 21) werd de directeurswoning in 1924 gebouwd naar een zakelijk-expressionistisch ontwerp van H. van der Kloot Meijburg. De enorme scheepsbouwloods van ‘Van der Giessen de Noord’ kwam in 1982 tot stand met W.G. Quist als esthetisch adviseur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0078.php> .

