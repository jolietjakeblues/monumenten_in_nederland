        min:volgnummer 1255 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0110> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Kerken. De in 1914 opgetrokken Geref. kerk (Bruggemeesterstraat 14) is een eenvoudige zaalkerk met overhoeks houten geveltorentje. Naoorlogs is de (Herv.) Bethlehemkerk (Weijland 63; 1955, J.H. Bodegraven en A.N. van Donkelaar), een traditionalistische zaalkerk met vlakke geveltoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01256> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwerbrug (gemeente Bodegraven) – Boerderijen"@nl ;
        min:adres "Korte Waarder 17",
            "Korte Waarder 68",
            "Weijland 24",
            "Weijland 26a",
            "Weijland 29",
            "Weijpoort 35" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Bodegraven-Reeuwijk" ;
        min:gemeenteInBoek "Bodegraven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bodegraven-Reeuwijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwerbrug (gemeente Bodegraven)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwerbrug" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13046>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20807> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "9767",
            "9768" ;
        min:soort "lemma" ;
        min:volgnummer 1256 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill528> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0110> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "365" ;
        schema:pageStart "364" ;
        schema:pagination "364-365" ;
        schema:text """Boerderijen. Voorbeelden van met riet gedekte 18de-eeuwse hallenhuisboerderijen zijn Graaf Florisweg 4, met een deuromlijsting in empire-stijl, en de Johanneshoeve (Weijland 24; 1785, jaartalankers) met een geblokt gepleisterde voorgevel en terzijde een zomerhuis (circa 1870) met ingezwenkte lijstgevel. Van oorsprong 18de-eeuwse langhuisboerderijen zijn Weijland 31, met vernieuwde voorgevel en een 18de-eeuws zomerhuis, de rond 1920 deels vernieuwde boerderij Welgelegen (Weijland 29) en de boerderij Hoge Rijndijk 8 met twee opvallende houten (droog)schuren (één daarvan is Hoge Rijndijk 6). De 18de-eeuwse herenboerderij Knodsenburg (Weijland 26a) heeft een rond 1850 verbouwd woonhuis met gesneden windveren. Een dubbele hardstenen stoep leidt naar de in Lodewijk XIV-stijl versierde middentravee met ingang. Aan de weg staat een rijk gesmeed ijzeren hek in Lodewijk XIV-vormen.

De rond 1875 gebouwde langhuisboerderijen Oude Vliet (Korte Waarder 17) en Weijland 59 hebben beide een ingezwenkte lijstgevel. De langhuisboerderij Korte Waarder 19 (circa 1880) is voorzien van een omlijste ingang en decoratieve windveren. Een opvallend drielichtsvenster op de verdieping tonen Weijland 3 (circa 1875) en Weijpoort 29 (1890). Jongere langhuisboerderijen zijn Klein Rijntocht (Weijpoort 35; 1905), met serliana en sierspant, Weijpoort 33 (1911) en Rhijnleven (Korte Waarder 68; 1910-'12), alle met eenvoudige neorenaissance-details."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01257> a min:Passage,
