        min:volgnummer 855 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0063> ;
        schema:name "Straatmeubilair"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "Straatmeubilair. Aan de Houttuin staat een hardstenen dorpspomp met gebeeldhouwde wapenschilden en pijnappelbekroning, opgericht in 1741 in opdracht van de ambachtsheer Jan Six (gerestaureerd 1982). Nabij staat de gemetselde gedenkbank met granieten platen, geplaatst (circa 1928) ter ere van burgemeester D. Wentholt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0063.php> .

