        schema:name "Scholen"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text """Scholen. De voorm. openbare lagere school Kerkweg 1 werd gebouwd rond 1885 met omlijste ingang en eclectische details. De tweeklassige voorm. openbare lagere school Kerkweg 27 (circa 1925) is ontworpen in zakelijk-expressionistische stijl.

Het woonhuis Dorpsstraat 37-39 is een tweelaags dwars huis uit 1778 met daarnaast een houten bedrijfsschuur."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00344> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berkenwoude (gemeente Bergambacht) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Bergambacht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berkenwoude (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Berkenwoude" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 344 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0020> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "Boerderijen. In de omgeving van het dorp liggen enkele waardevolle boerderijen. De opvallende hallenhuisboerderij Oosteinde 12 werd in 1667 gebouwd voor Claes Claesse Bijman en Trijntje Jans (bouwjaar en initialen op deurkalf). Het voorhuis bevat een kelder en opkamer, een kaaskamer en een slaapkamer; erachter bevinden zich een brede woonkeuken met bedsteden en een wringvertrek. De tuitgevel van deze in 1941 onder leiding van E.A. Canneman gerestaureerde boerderij is voorzien van kruisvensters met halve luiken en heeft geblokte ontlastingsbogen boven de entree met bovenlicht. Voorbeelden van laat-19de-eeuwse boerderijen zijn Achterbroek 69-71 met zomerhuis, Achterbroek 47 met zomerhuis en een dwars aangebouwde, gepotdekselde tweebeukige schuur, alsmede de langhuisboerderij Oosteinde 27 (circa 1880) en de dwarshuisboerderij Schenkel 5 (circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00345> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bleiswijk"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Lansingerland" ;
        min:gemeenteInBoek "Bleiswijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lansingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bleiswijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bleiswijk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 345 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0021> ;
        schema:name "Bleiswijk"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "Ontginningsdorp, ontstaan rond 1250 met een in 1276 voor het eerst vermelde kerk. Na de droogmaking van de door ontginning ontstane veenplassen (voltooid 1779) kreeg de langgerekte dorpskern een ringgracht om te voorkomen dat het door de verlaging van het waterpeil zou verzakken. Het omringende land werd vanaf 1925 voor (glas)tuinbouw bestemd. Langs de Hoekeindseweg staan van deze tuinderijen nog enkele ketelhuizen met gemetselde schoorsteen uit 1925. Na 1960 is het dorp vooral aan de oostzijde uitgebreid. Tevens is ten noorden van het dorp een enorme veiling voor tuinbouwproducten gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00346> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bleiswijk"@nl ;
        min:adres "Kerkstraat 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Lansingerland" ;
        min:gemeenteInBoek "Bleiswijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lansingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bleiswijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bleiswijk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47580> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "9629" ;
        min:soort "inleiding" ;
        min:volgnummer 346 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0021> ;
        schema:name "Bleiswijk"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De Herv. kerk (Kerkstraat 4), oorspronkelijk gewijd aan St. Johannes, is een eenbeukige kerk met een vijfzijdig gesloten koor en een toren met een ingesnoerde naaldspits, beide in 1532 verwezenlijkt bij herbouw van een oudere kerk. Van de toren is alleen de onderste geleding in baksteen uitgevoerd. In het in 1837 vernieuwde bovendakse gedeelte van de houten torenopbouw hangen klokken gegoten door Steven Butendiic (1448) en Joannes Ouderogge (1687). De rondboogvensters van het schip dateren van een verbouwing in 1865. De toen aangebrachte bepleistering heeft men bij de restauratie in 1972-'74 verwijderd. Uit die tijd dateren ook de venstertraceringen van het koor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00347> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bleiswijk"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Lansingerland" ;
        min:gemeenteInBoek "Bleiswijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lansingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bleiswijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Bleiswijk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 347 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill100> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0021> ;
        schema:name "Bleiswijk"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "90" ;
        schema:pagination "90-91" ;
        schema:text "Het interieur wordt gedekt door een opvallend tongewelf met verhoogd middendeel zonder trekbalken (eerste helft 16de eeuw). Tot de 17de-eeuwse inventaris behoren een preekstoel (1622), een doophek, twee tekstborden en drie herenbanken, waarvan één met overhuiving. Verder bevat de kerk een aantal grafzerken (16de-17de eeuw) en een door L. van den Brink & Zn. gebouwd orgel (1842)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00348> a min:Passage,
