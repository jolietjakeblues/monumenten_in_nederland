        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0155> ;
        schema:name "Scheveningen (gemeente 's-Gravenhage)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "De (Geref.) Eben Haëzerkerk (Nieuwe Laantjes 120) is een T-vormige kerk in neorenaissance-vormen, gebouwd in 1892 naar ontwerp van R. Kuipers. De twee ingangen bevinden zich in flankerende paviljoens met spitse schilddaken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01673> a min:Passage,
