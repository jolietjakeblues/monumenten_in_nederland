        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20661>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43266> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "26548",
            "26549" ;
        min:soort "lemma" ;
        min:volgnummer 1118 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0092> ;
        schema:name "Cillaarshoek"@nl ;
        schema:pageEnd "345" ;
        schema:pageStart "345" ;
        schema:pagination "345" ;
        schema:text "Cillaarshoek. Dit dorp ten zuiden van Maasdam ontstond kort na de bedijking van de polder Het Oudeland van Strijen (1436). De Herv. kerk (Keizersdijk 159), een zaalkerk voorzien van een met leien beklede houten dakruiter met naaldspits, werd gebouwd in 1838 ter vervanging van een kerk uit 1615. In de dakruiter hangt een klok uit 1388. Tot de kerkinventaris behoren enkele grafzerken (16de-17de eeuw) en een preekstoel (circa 1840). De rond 1840 gebouwde pastorie (Keizersdijk 161) is een neoclassicistisch tweelaags pand met ingangsomlijsting. De in oorsprong 17de-eeuwse boerderij ‘Dijkzicht’ (Keizersdijk 163) kreeg haar huidige gepleisterde aanzicht rond 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01119> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasland (gemeente Midden-Delfland)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Midden-Delfland" ;
        min:gemeenteInBoek "Midden-Delfland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Delfland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasland (gemeente Midden-Delfland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Maasland" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1119 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0093> ;
        schema:name "Maasland (gemeente Midden-Delfland)"@nl ;
        schema:pageEnd "345" ;
        schema:pageStart "345" ;
        schema:pagination "345" ;
        schema:text "Kerkringdorp in het Westland, gelegen aan de Gaag - vroeger een vloedgeul van de Maas. Het in 866 voor het eerst vermelde dorp werd in de tweede helft van de 12de eeuw verplaatst naar een Karolingische vluchtburcht, gelegen in een kromming van de Gaag ter plaatse van de huidige kerkring. De kerk werd in 1241 door graaf Willem II aan de Duitse Orde geschonken. Het hier in 1273 gestichte convent werd in 1365 vervangen door een (verdwenen) commanderij ten noordoosten van de kerk. In de 19de eeuw ontwikkelde Maasland zich tot een lineaire nederzetting en na de Tweede Wereldoorlog is het aan beide zijden uitgebreid. Maasland is een beschermd gezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01120> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasland (gemeente Midden-Delfland)"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Midden-Delfland" ;
        min:gemeenteInBoek "Midden-Delfland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Delfland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasland (gemeente Midden-Delfland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Maasland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41748> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "26585" ;
        min:soort "inleiding" ;
        min:volgnummer 1120 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0093> ;
        schema:name "Maasland (gemeente Midden-Delfland)"@nl ;
        schema:pageEnd "345" ;
        schema:pageStart "345" ;
        schema:pagination "345" ;
        schema:text "De Herv. kerk (Kerkplein 1), oorspronkelijk gewijd aan Maria Magdalena, is een forse tweebeukige kerk met vijfzijdig gesloten koor en nevenkoor en een ingebouwde toren van drie geledingen met ingesnoerde naaldspits. De toren verrees in de eerste helft van de 15de eeuw en in het midden van die eeuw volgden het laat-gotische schip en koor. De noordbeuk met nevenkoor, alsmede de doopkapel en sacristie aan de zuidzijde, werden rond 1500 toegevoegd. De in 1945 uitgebrande kerk heeft men in 1948-'54 hersteld. Het nevenkoor bezit nog de oorspronkelijke bakstenen vensterharnassen. Het na de brand in schoon metselwerk uitgevoerde interieur bevat vroeg-17de-eeuws meubilair (preekstoel, banken) uit de afgebroken kerk van Graft (NH) en een door C.J.F. Witte gebouwd orgel (1888) uit de Utrechtse Nicolaïkerk (overgebracht en nieuwe orgelkast 1957). Uit de brand gered zijn de deuren met gotische spijlen in het koorhek en een bord met ordonnantie op het begraven (1671)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01121> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasland (gemeente Midden-Delfland)"@nl ;
        min:adres "Kerkplein 12" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Midden-Delfland" ;
