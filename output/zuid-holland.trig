        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75031>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75032> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "512483",
            "512484" ;
        min:soort "inleiding" ;
        min:volgnummer 761 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0051> ;
        schema:name "Haastrecht (gemeente Vlist)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Het kerkhof, aangelegd in 1825 en vergroot in 1883, heeft een houten baarhuisje uit 1864. De forse en sobere pastorie (Grote Haven 10) verrees in 1877 onder leiding van bouwpastor W. Putman. In de tuin staat een H. Hartbeeld (1927)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00762> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haastrecht (gemeente Vlist)"@nl ;
        min:adres "Provincialeweg Oost 60-62" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Vlist" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haastrecht (gemeente Vlist)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Haastrecht" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 762 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill353> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0051> ;
        schema:name "Haastrecht (gemeente Vlist)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Het passionistenklooster ‘St. Gabriël’ (Provincialeweg Oost 60-62), gelegen aan de oostzijde van Haastrecht, werd in 1920 gesticht door de paters Passionisten uit Mook-Molenhoek. J. Franssen ontwierp de brede kloostervleugel en de sobere traditionalistische kruiskerk (1921-'22) met recht gesloten koorapsis en een ongelede toren met tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00763> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haastrecht (gemeente Vlist) – Overige kerken"@nl ;
        min:adres "Hoogstraat 134",
            "Hoogstraat 79",
            "Liezeweg 31" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Vlist" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haastrecht (gemeente Vlist)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Haastrecht" ;
        min:lemma "Overige kerken" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 763 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0051> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text """Overige kerken. Van na de oorlog dateren de Herv. kerk (Liezeweg 31; 1960, W.F. Mulckhuyse), een eenvoudige zaalkerk met dakruiter, en de Geref. kerk (Hoogstraat 134; 1960, L. van der Linde).

Het stadhuis (Hoogstraat 79) is een onderkelderd diep pand uit 1618, voorzien van een maniëristische trapgevel met sierankers. De bel-etage, waar zich in het verleden de Vierschaar bevond, is toegankelijk via een hoge bordestrap met twee schildhoudende leeuwen op de balustrade. De met kruisgewelven gedekte kelder van het voorhuis diende vermoedelijk als onderkomen van de wacht. In de met tongewelven gedekte achterste kelder bevonden zich de cachotten. Het achterhuis bevat de raadzaal met een schouw (tweede helft 18de eeuw) en op de verdieping de burgemeesterskamer met een maniëristische schouw (circa 1618). Het raadhuis is verbouwd in 1823 en gerestaureerd in 1907 (L. Couvée) en 1956-'57 (G. van Hoogevest). Rond 1957 heeft men een L-vormige aanbouw toegevoegd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0051.php> .

