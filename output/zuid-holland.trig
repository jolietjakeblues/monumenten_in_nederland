        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "Het voorm. franciscanessenklooster (Heerenlaantje 30) [5] is een blokvormig drielaags pand uit 1851 met neoclassicistische deuromlijsting en een kapelvormige uitbouw met dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0042.php> .

