            "520827",
            "530044" ;
        min:soort "lemma" ;
        min:volgnummer 1586 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0150> ;
        schema:name "Strypemonde"@nl ;
        schema:pageEnd "421" ;
        schema:pageStart "421" ;
        schema:pagination "421" ;
        schema:text "Strypemonde (Windgatseweg 18). Deze buitenplaats ten noorden van Rockanje werd rond 1920 gesticht door de Rotterdamse cargadoor J. van Hoey Smith. Een bestaand huis werd in 1937-'38 vervangen door het huidige, langgerekte tweelaags jacht- en buitenverblijf in traditionalistische vormen naar plannen van J.W. Janzen. De forse woonkamer bevat een grote uitgebouwde open haard. Tegen het huis staat een dienstwoning met garage en slachtkamer voor het wild. De landschappelijke parkaanleg rond de buitenplaats maakt sinds 1984 deel uit van het natuurgebied Voornes Duin."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01587> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roelofarendsveen (gemeente Alkemade)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Alkemade" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roelofarendsveen (gemeente Alkemade)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Roelofarendsveen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1587 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0151> ;
        schema:name "Roelofarendsveen (gemeente Alkemade)"@nl ;
        schema:pageEnd "421" ;
        schema:pageStart "421" ;
        schema:pagination "421" ;
        schema:text "Wegdorp, ontstaan in de late middeleeuwen op de westoever van het Braassemermeer. Aan weerszijden van Noordeinde en Zuideinde ontwikkelde zich een langgerekt bebouwingslint. De ontwikkeling tot tuinbouwcentrum werd versterkt na de aanleg van de spoorlijn Hoofddorp-Leiden (1912; opgeheven 1936). Na de Tweede Wereldoorlog is Roelofarendsveen aan Oude Wetering vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0151.php> .

