        schema:name "Poortugaal (gemeente Albrandswaard)"@nl ;
        schema:pageEnd "404" ;
        schema:pageStart "404" ;
        schema:pagination "404" ;
        schema:text "Dijkdorp, ontstaan aan het eind van de 12de eeuw in de Albrandswaard. Buitendijks lag een kleine haven en binnendijks vormde zich een kleine dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0139.php> .

