        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22518>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33879> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "7095",
            "7096" ;
