        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46146> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "32505" ;
        min:soort "lemma" ;
        min:volgnummer 1527 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0144> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "411" ;
        schema:pageStart "411" ;
        schema:pagination "411" ;
        schema:text "Scholen. De voorm. openbare lagere school (Kerksingel 26) is een tweeklassige school uit 1840 met aangebouwde onderwijzerswoning (nr. 27). In 1910 werd een derde lokaal toegevoegd en in 1920 volgden nog drie lokalen. Uit 1921 dateert de voorm. Dr. Kuyperschool (Dr. Kuyperstraat 3), een U-vormig opgezette tienklassige Chr. lagere school met expressionistische ingangspartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01528> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ridderkerk – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Ridderkerk" ;
        min:gemeenteInBoek "Ridderkerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ridderkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ridderkerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ridderkerk" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1528 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0144> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "411" ;
        schema:pageStart "411" ;
        schema:pagination "411" ;
        schema:text "Woonhuizen. Aan de Kerksingel staat een aantal overwegend diepe huizen met tuitgevels. Een gevelsteen met metselaarsattributen en het jaartal ‘1676’ heeft het pand Kerksingel 12, waar de ingang zit in een afluiving. Iets forser is Kerksingel 13 uit 1782 met natuurstenen tuitgeveltop-bekroning. Andere laat-18de-eeuwse diepe huizen zijn Kerksingel 2, 4, 6 en 15 en Kerksingel 18 (1780). Het rond 1850 gebouwde diepe huis Kerksingel 21 heeft een ingezwenkte lijstgevel. Voorbeelden van dwarse middenganghuizen zijn Kerksingel 11 (1868) en Kerksingel 20 (circa 1880). Een hoger opgetrokken middenrisaliet hebben het gepleisterde eclectische woonhuis Westmolendijk 8 (circa 1860) en het huis Kerksingel 9 (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01529> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ridderkerk – Boerderijen"@nl ;
        min:adres "Lagendijk 101-103",
            "Lagendijk 54",
            "Lagendijk 88" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Ridderkerk" ;
        min:gemeenteInBoek "Ridderkerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ridderkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ridderkerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ridderkerk" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10898>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53326> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "32508",
            "32510" ;
        min:soort "lemma" ;
        min:volgnummer 1529 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0144> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "411" ;
        schema:pageStart "411" ;
        schema:pagination "411" ;
        schema:text """Boerderijen. De krukhuisboerderij Benedenrijweg 13 heeft gezien de sierankers in de voorgevel een 17de-eeuwse oorsprong; het huidige uiterlijk is 19de-eeuws. De parallel aan de dijk gebouwde dwarsdeelboerderij Bijdorp (Lagendijk 101-103) stamt uit 1768. Aan de overzijde van de dijk staan drie boerderijen met middenlangsdeel uit de eerste helft van de 18de eeuw: Bouwlust (Lagendijk 88; 1741), Lagendijk 60 en Lagendijk 78, waarvan de stal in 1938 is vernieuwd.

De Alg. begraafplaats (bij Lagendijk 54), gesticht in 1829, heeft een rond 1935 gebouwde aula, met een portiek geflankeerd door beelden van een Pelikaan en de Dood. Interessante graftekens zijn dat met boom en anker voor A. Pot († 1858) en de zerk voor ds. A.H. de Klerck († 1917)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0144.php> .

