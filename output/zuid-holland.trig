        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47014> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "452745" ;
        min:soort "inleiding" ;
        min:volgnummer 1674 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill671> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0155> ;
        schema:name "Scheveningen (gemeente 's-Gravenhage)"@nl ;
        schema:pageEnd "460" ;
        schema:pageStart "459" ;
        schema:pagination "459-460" ;
        schema:text "De (Herv.) Nieuwe Badkapel (Nieuwe Parklaan 90), eveneens gebouwd in de vorm van een Grieks kruis, heeft een kleine vieringkoepel en een front met narthex-achtige arcade en twee flankerende torens met koepelbekroning. Deze kerk kwam in 1915-'16 tot stand naar een ontwerp van W.Ch. Kuijper jr. met neoromaanse en rationalistische vormen. Het door houten tongewelven gedekte interieur bevat grotendeels nog de oorspronkelijke inrichting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Scheveningen (gemeente 's-Gravenhage)"@nl ;
        min:adres "Berkenbosch Blokstraat 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "'s-Gravenhage" ;
        min:gemeenteInBoek "'s-Gravenhage" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/'s-Gravenhage> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Scheveningen (gemeente 's-Gravenhage)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Scheveningen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67720> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "452744" ;
        min:soort "inleiding" ;
        min:volgnummer 1675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0155> ;
        schema:name "Scheveningen (gemeente 's-Gravenhage)"@nl ;
        schema:pageEnd "460" ;
        schema:pageStart "460" ;
        schema:pagination "460" ;
        schema:text "De R.K. kerk O.L. Vrouwe van Lourdes (Berkenbosch Blokstraat 9) bestaat uit een voorbouw met toren en een brede, drieledige kerkruimte met kleine zadeldaktoren. Na de bouw van een houten noodkerk in 1912-'13 begon men met de onderbouw van de hoofdtoren, de Lourdeskapel en de pastorie (nr. 9) naar een traditionalistisch ontwerp van A.J. Kropholler. De rest van de kerk kon in 1924-'25 worden voltooid naar een door C.M. van Moorsel gewijzigd plan van Kropholler. De bovenbouw van de toren kwam pas in 1965 tot stand. Het interieur is voorzien van een muurschildering (J. Collette), tegeldecoraties (A.C. Ninaber van Eyben) en reliëfs (W.A. van der Winkel) en bevat een door G. Brom vervaardigde marmeren communiebank (circa 1890) afkomstig uit de Catharinakerk te Amsterdam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01676> a min:Passage,
