        min:gemeenteInBoek "Wassenaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wassenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wassenaar" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Wassenaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67258> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "524511" ;
        min:soort "inleiding" ;
        min:volgnummer 1934 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill784> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0182> ;
        schema:name "Wassenaar"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "De R.K. St.-Willibrorduskerk (Kerkstraat 77) is een basilicale kruiskerk met vijfzijdig gesloten koor en een toren van drie geledingen met achtzijdige lantaarn en naaldspits. Ter vervanging van een kerk uit 1724 verrees deze neogotische kerk in 1903-'05 naar ontwerp van N. Molenaar in opvallend helderrode baksteen. Het interieur van de in 1986-'88 gerestaureerde kerk wordt gedekt door kruisribgewelven op zuilen en halfzuilen voorzien van kapitelen met acanthusbladversiering. Het in 1912 door N. Winnubst gepolychromeerde interieur is rond 1965 wit gekalkt en in 1987-'88 opnieuw polychroom beschilderd met florale motieven. Uit de bouwtijd dateren de kerkbanken, de biechtstoelen en enkele glas-in-loodvensters vervaardigd door O. Mengelberg en J. Nicolas. De altaaropstand op het hoogaltaar is afkomstig uit de in 1999 gesloopte Engelbewaarderskerk te Den Haag."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01935> a min:Passage,
