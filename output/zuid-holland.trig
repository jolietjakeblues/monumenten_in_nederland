    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill43> a schema:ImageObject ;
        rdfs:label "Het veengebied bij Nieuwkoop werd in de 13de eeuw ontgonnen door middel van zogeheten cope-ontginningen, door sloten gescheiden langgerekte stroken veen (rechterzijde). In de 18de-eeuw werd dit gebied ten behoeve van de turfwinning verder uitgeveend en ontstonden grote plassen (voorgrond). Begin 19de eeuw zijn enkele van die plassen weer drooggelegd (linkerzijde)"@nl ;
