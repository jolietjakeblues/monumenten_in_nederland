        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe-Tonge (gemeente Middelharnis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwe-Tonge" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1241 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0108> ;
        schema:name "Nieuwe-Tonge (gemeente Middelharnis)"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "Voorstraatdorp met kerkring, gesticht kort na de bedijking van de polder Het Noordland (1461). De kerkring met kerkgracht komt uit op de korte Voorstraat. De haven werd na de bedijking van de polder Klinkerland (1504) gedempt en verplaatst naar het westelijker gelegen gehucht Battenoord. Nieuwe-Tonge had te lijden van de Watersnoodramp van 1953. Daarna is het dorp aan de oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe-Tonge (gemeente Middelharnis)"@nl ;
        min:adres "Kerkring 29" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Middelharnis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe-Tonge (gemeente Middelharnis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwe-Tonge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52545> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29798" ;
        min:soort "inleiding" ;
        min:volgnummer 1242 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill526> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0108> ;
        schema:name "Nieuwe-Tonge (gemeente Middelharnis)"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "De Herv. kerk (Kerkring 29) is een eenbeukige kruiskerk met vijfzijdig gesloten koor en een gedrongen toren van vijf lage geledingen met balustrade en achtzijdige spits. Deze laat-gotische kerk werd rond 1500 gebouwd. Tegen de toren bouwde men in de 16de eeuw een doopkapel. Het koor brandde in 1723 gedeeltelijk uit. Tegen de noordzijde van het schip werd in 1777 een hardstenen portaal geplaatst. Bij de restauratie in 1965-'69 heeft de toren de gemetselde balustrade gekregen en hebben schip en transept hun 19de-eeuwse venstertraceringen behouden. Het interieur wordt gedekt door een houten tongewelf en bevat een preekstoel met lezenaar in Lodewijk XVI-vormen (1817)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0108.php> .

