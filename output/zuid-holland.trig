        min:soort "lemma" ;
        min:volgnummer 1392 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0125> ;
        schema:name "Mildenburg"@nl ;
        schema:pageEnd "387" ;
        schema:pageStart "387" ;
        schema:pagination "387" ;
        schema:text "Mildenburg (Hoflaan 13). Deze buitenplaats werd in 1736 gekocht door Diederik van Leyden. Zijn zoon Helenus Willem liet rond 1765 het bestaande, vóór 1726 gebouwde, huis verbeteren en het huidige park aanleggen. Het huis werd in 1947 gesloopt. De resterende parkaanleg bevat een zichtlaan, delen van een sterrenbos, een vergraven vijver en een doolhof (gebaseerd op die van Versailles)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01393> a min:Passage,
