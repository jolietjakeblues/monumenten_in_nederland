        min:gemeenteInBoek "Noordwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordwijk-Binnen (gemeente Noordwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noordwijk-Binnen" ;
