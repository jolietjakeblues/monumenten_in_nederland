        schema:name "Boerderijen"@nl ;
        schema:pageEnd "412" ;
        schema:pageStart "412" ;
        schema:pagination "412" ;
        schema:text "Boerderijen. Voorbeelden van langhuisboerderijen uit circa 1800 zijn Herenweg 8, met jongere stal, en St.-Jan (Herenweg 12a), met op de schoorsteen een gebeeldhouwd Lam Gods. Naast deze boerderij staat een zomerhuis. De boerderij Herenweg 2 heeft als woongedeelte een gepleisterd eenlaags herenhuis in eclectische vormen (circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01535> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijnsaterwoude (gemeente Jacobswoude) – Windmolens"@nl ;
        min:adres "Heilige Geestlaan 6",
            "Herenweg 38" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
