        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16761" ;
        min:soort "inleiding" ;
        min:volgnummer 632 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De Oud Kath. kerk St. Jan Baptist (Hoge Gouwe 107) [7] ligt achter de panden Hoge Gouwe 109-113. In 1630 werd een rooms-katholieke schuilkerk gesticht in het van oorsprong 15de-eeuwse huis Hoge Gouwe 113. Ter plaatse van de tuin achter de buurpanden verrees in 1632 een nieuwe kerkzaal, die in 1685 werd vergroot tot de huidige omvang. Enige tijd na 1723 werd het gebouw een Oud Kath. kerk. Bij een ingrijpende verbouwing in 1863 ontstond een grote uitbouw ten behoeve van het hoofdaltaar. Het wit gestucte interieur is voorzien van wandpilasters en een tongewelf. Tot de inventaris uit circa 1690 behoren een hoofdaltaar met getorste dubbele corinthische zuilen (altaarstuk Jan Fransz Verzijl) en een barokke preekstoel en communiebank. Het orgel en orgelkast zijn gemaakt door Johannes Mitterreither (1778)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00633> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Gouda" ;
        min:gemeenteInBoek "Gouda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gouda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 633 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "In 1863 heeft men ook de 17de-eeuwse huizen aan de straat gesloopt en vervangen door het huidige dubbelhuis Hoge Gouwe 109-111 en een gang naar de kerk. Het als pastorie dienende huis Hoge Gouwe 113 werd door toevoeging van een gang verbreed. Het geheel kreeg gepleisterde gevels in rijke eclectische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00634> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
        min:adres "Turfmarkt 23" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Gouda" ;
        min:gemeenteInBoek "Gouda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gouda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11759> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16930" ;
        min:soort "inleiding" ;
        min:volgnummer 634 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "De voorm. synagoge (Turfmarkt 23) [8] werd in 1827 gebouwd ter plaatse van een in 1823 afgebroken Doopsgez. kerk, die al in 1798 was ingericht als sjoel. Dit sobere gebouw met fronton, spitsboogvensters en een empire-deurpartij dient sinds 1950 als kerk van de Vrije Evang. Gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00635> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
        min:adres "Peperstraat 128" ;
