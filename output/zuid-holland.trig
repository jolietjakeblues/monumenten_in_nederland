        min:soort "inleiding" ;
        min:volgnummer 1992 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0188> ;
        schema:name "Zoetermeer"@nl ;
        schema:pageEnd "543" ;
        schema:pageStart "543" ;
        schema:pagination "543" ;
        schema:text "De (Geref.) Pelgrimskerk (1ste Stationsstraat 86) werd in 1932 gebouwd naar ontwerp van B.W. Plooy. De toren bij deze zakelijk-expressionistische kruiskerk heeft een voor zijn werk karakteristieke paraboolvormige spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01993> a min:Passage,
