        min:volgnummer 1935 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0182> ;
        schema:name "Wassenaar"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "Voor de kerk staat een H. Hartbeeld. Molenaar ontwierp ook de in neorenaissance-stijl uitgevoerde pastorie (Kerkstraat 79; 1906), het voorm. patronaatsgebouw (nr. 75; 1907) met neorenaissance- en chaletstijl-details en het zusterhuis (nr. 32; 1899, vergroot 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01936> a min:Passage,
