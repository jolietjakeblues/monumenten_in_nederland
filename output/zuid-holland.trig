        schema:name "Maasland (gemeente Midden-Delfland)"@nl ;
        schema:pageEnd "345" ;
        schema:pageStart "345" ;
        schema:pagination "345" ;
        schema:text "De Geref. kerk (Slot de Houvelaan 28), een zaalkerk met portaal en glas-in-betonvensters, kwam in 1956 tot stand naar een traditionalistisch ontwerp van A. Warnaar en B.T. Boeyenga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0093.php> .

