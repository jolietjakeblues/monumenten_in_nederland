        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0002> ;
        schema:name "Voorwoord"@nl ;
        schema:pageEnd "7" ;
        schema:pageStart "7" ;
        schema:pagination "7" ;
        schema:text "Met dit werk over de provincie Zuid-Holland levert de reeks Monumenten in Nederland opnieuw een bijdrage aan de kennisoverdracht over ons cultureel erfgoed en het wekken van de belangstelling daarvoor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0002.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00011> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwoord"@nl ;
