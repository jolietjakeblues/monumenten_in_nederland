        min:hoofdstuk "Steden, dorpen, monumenten › Lisse" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Lisse" ;
        min:lemma "Kwekerswoningen met bollenschuren" ;
