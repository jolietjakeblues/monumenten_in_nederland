        min:rijksmonumentnummer "515508" ;
        min:soort "lemma" ;
        min:volgnummer 1803 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0167> ;
        schema:name "Gemalen"@nl ;
        schema:pageEnd "497" ;
        schema:pageStart "497" ;
        schema:pagination "497" ;
        schema:text "Gemalen. Rond 1865 werd het poldergemaal Geer- en Klein Blankaartpolder (Ondermeerweg 4-6) gebouwd met bijbehorend woonhuis. Uit 1882 dateren het poldergemaal De Volharding (Dr. Van Noortstraat 4) en het stoomgemaal De Antagonist (Stompwijkseweg 11), dat rond 1930 werd omgebouwd tot een dieselgemaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0167.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01804> a min:Passage,
            schema:CreativeWork ;
