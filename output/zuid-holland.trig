        schema:name "Windmolens"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "348" ;
        schema:pagination "348" ;
        schema:text "Windmolens. De Wippersmolen (Wipperskade 1) is een grondzeiler uit 1726 met ronde bakstenen romp en een met riet gedekte kap. Deze poldermolen bemaalde voorheen de Sluispolder. Korenmolen De Hoop (Zuiddijk 94), een ronde stellingmolen met een met dakleer beklede kap, werd gebouwd in 1792 (gerestaureerd 1992)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0094.php> .

