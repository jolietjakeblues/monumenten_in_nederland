        min:volgnummer 563 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0038> ;
        schema:name "Giessen-Oudekerk (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Ontginningsdorp, ontstaan in de 11de eeuw aan de noordzijde van de veenstroom de Giessen tegenover het op een schiereiland gelegen kasteel De Giessenburg van de heren van Brederode (gesloopt 1802; nu bungalowpark De Giessenburg). Rond de Oudkerkseweg heeft enige verdichting van de bebouwing plaatsgevonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00564> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessen-Oudekerk (gemeente Giessenlanden)"@nl ;
        min:adres "Oudkerkseweg 22" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessen-Oudekerk (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessen-Oudekerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13353>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24645> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16115",
            "16116" ;
        min:soort "inleiding" ;
        min:volgnummer 564 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill216> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0038> ;
        schema:name "Giessen-Oudekerk (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "De Herv. kerk (Oudkerkseweg 22) is een eenbeukige kerk met aangebouwde consistorie en een forse toren van vier geledingen met tentdak. De in het midden van de 15de eeuw opgetrokken toren heeft met pinakels bekroonde overhoekse steunberen en bevat een door Steven Butendiic gegoten klok (1446). Het eind 15de eeuw gebouwde schip in laat-gotische vormen onderging in 1657 een verbouwing. Het koor werd in 1838 gesloopt en vervangen door een consistorie (herbouwd 1950). Restauraties zijn uitgevoerd in 1941 (toren; B. van Bilderbeek) en in 1950-'52 (kerk). Het kerkinterieur wordt gedekt door een houten tongewelf met trekbalken (1657). Tot de inventaris behoren een preekstoel met doophek (1658), een tekstbord (1768) en een rouwbord in Lodewijk XV-vormen voor ambachtsheer Jacobus Hoffman (1793)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00565> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessen-Oudekerk (gemeente Giessenlanden) – Scholen"@nl ;
        min:adres "Bovenkerkseweg 14",
            "Oudkerkseweg 18-20" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessen-Oudekerk (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessen-Oudekerk" ;
        min:lemma "Scholen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 565 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0038> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text """Scholen. Het gebouw ‘De Oude School’ (Oudkerkseweg 18-20) kwam rond 1890 tot stand als een drieklassige school met aangebouwde onderwijzerswoning. De met dwars geplaatste onderwijzerswoning opgezette Chr. lagere school (Bovenkerkseweg 14) werd in 1898 gesticht als openbare lagere school en in 1925 ingericht als ‘School met den Bijbel’.

Het herenhuis Oudkerkseweg 16 is een tweelaags dwars huis uit circa 1840 met neoclassicistische ingangspartij."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00566> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessen-Oudekerk (gemeente Giessenlanden) – Boerderijen"@nl ;
        min:adres "Oudkerkseweg 2" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessen-Oudekerk (gemeente Giessenlanden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Giessen-Oudekerk" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25172> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16111" ;
        min:soort "lemma" ;
        min:volgnummer 566 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0038> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "169" ;
        schema:pagination "169-170" ;
        schema:text "Boerderijen. De in oorsprong 17de-eeuwse krukhuisboerderij Binnendamseweg 94 heeft rechts een uitbouw, links een ouderkamer met eigen toegang en achter een dwarsdeelschuur. De gepleisterde 17de-eeuwse krukhuisboerderij Oudkerkseweg 6-8 is voorzien van een hoge stoep en een onderkel-derde aanbouw (rechts). De krukhuisboerderij Binnendamseweg 62 is vermoedelijk 18de-eeuws. Een voorbeeld van een gave dwarshuisboerderij is Oudkerkseweg 10 (circa 1860). De uit 1861 daterende hallenhuisboerderij Oudkerkseweg 9 heeft een hoog zadeldak. Een dwarsdeelschuur hebben de boerderijen De Baat (Oudkerkseweg 2; circa 1850) en Oudkerkseweg 38 (1899). Jongere boerderijen zijn Binnendamseweg 42 (1911-'12), met sierspant, en Binnendamseweg 64 (1921) met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00567> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Giessen-Oudekerk (gemeente Giessenlanden) – Grenspaal"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Giessenlanden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Giessen-Oudekerk (gemeente Giessenlanden)" ;
