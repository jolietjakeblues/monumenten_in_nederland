        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16391>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50501>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78909>,
