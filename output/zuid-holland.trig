        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooltgensplaat (gemeente Oostflakkee)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ooltgensplaat" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0124> ;
        schema:name "Ooltgensplaat (gemeente Oostflakkee)"@nl ;
        schema:pageEnd "385" ;
        schema:pageStart "385" ;
        schema:pagination "385" ;
        schema:text "Voorstraatdorp met kerkring, gesticht in de polder Het Oudeland (1481-'83). De haven met spuikom (Spuidijk) heeft sinds de aanleg van de polder Het Rietveld (1741) een havenkanaal naar het Volkerak. De Voorstraat (met achterwegen) komt uit op de Kerksingel, waarvan de gracht in 1929 werd gedempt. Tijdens de Tachtigjarige Oorlog was het dorp van strategisch belang vanwege de beheersing van het Volkerak. In 1811 legde men verder oostelijk een fort aan, alsmede aan de landzijde drie redoutes; de noordelijkste daarvan (Noordzijdsedreef) is nu in gebruik als begraafplaats. Na de Watersnoodramp van 1953 is het dorp aan de westzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0124.php> .

