        min:kern "Oud-Beijerland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58078> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "31919" ;
