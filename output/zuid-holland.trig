        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Woonhuizen. Laat-19de-eeuwse eenlaagspanden zijn het dwarse huis Julianalaan 52 uit 1886 en het met mansardedak uitgevoerde middenganghuis Julianalaan 9 (circa 1900). Zakelijk-expressionistische invloeden vertoont de villa Julianalaan 6 uit 1937. De houten eenlaagspanden Prins Bernhardlaan 2-14 met steile kap, zijn in 1946-'48 gebouwd uit Zweedse bouwpakketten in het kader van Oostenrijkse herstelbetalingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00889> a min:Passage,
            schema:CreativeWork ;
