        schema:name "Streefkerk (gemeente Liesveld)"@nl ;
        schema:pageEnd "497" ;
        schema:pageStart "497" ;
        schema:pagination "497" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 31) is een fors vierkant pand uit circa 1860. De naoorlogse natuurstenen deuromlijsting toont het gemeentewapen boven de kroonlijst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01809> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Streefkerk (gemeente Liesveld)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
