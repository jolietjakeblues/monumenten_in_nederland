        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Kethel" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 915 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0074> ;
        schema:name "Kethel (gemeente Schiedam)"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "Dorp, gelegen in het in de 12de eeuw ontgonnen gebied van de Noord-Kethelpolder en de Hollierhoekschepolder. Aan de oostzijde werd rond 1280 de Poldervaart gegraven. Bij de op een verhoging gelegen kerk ontstond een kleine kern en eind 19de eeuw vormde zich een tweede kern rond de katholieke kerk bij het spoor. Nadat de gemeente in 1941 bij Schiedam was gevoegd, is Kethel aan Schiedam vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00916> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kethel (gemeente Schiedam)"@nl ;
        min:adres "Noordeinde 10" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Schiedam" ;
        min:gemeenteInBoek "Schiedam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schiedam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kethel (gemeente Schiedam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Kethel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50731> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "33299" ;
        min:soort "inleiding" ;
        min:volgnummer 916 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0074> ;
        schema:name "Kethel (gemeente Schiedam)"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "De Herv. kerk (Noordeinde 10), oorspronkelijk gewijd aan St. Jacobus, is een tweebeukige, recht gesloten kerk met een toren van twee geledingen met tentdak. De oostwaarts hellende toren verrees rond 1300 en werd in de tweede helft van de 15de eeuw aan de oostzijde hersteld. Begin 16de eeuw heeft men de toren verhoogd en voorzien van een nieuwe ingang. De laat-gotische noordbeuk van het schip kwam waarschijnlijk in de tweede helft van de 15de eeuw tot stand, waarna een ouder schip werd vervangen door het huidige laat-gotische schip (eerste helft 16de eeuw). Nadat de kerk in 1573 was verwoest, zijn het hoofd- en het zijkoor niet meer herbouwd. Het herstel van de toren was gereed in 1601 en dat van het schip in 1630. De kerk werd in 1928-'29 gerestaureerd onder leiding van J. Snijders en J. van der Vlis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00917> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kethel (gemeente Schiedam)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Schiedam" ;
        min:gemeenteInBoek "Schiedam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schiedam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kethel (gemeente Schiedam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Kethel" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 917 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0074> ;
        schema:name "Kethel (gemeente Schiedam)"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven. De schipbeuken worden gescheiden door toscaanse zuilen (circa 1630). Tot de inventaris behoren een preekstoel (1625), een schepenbank (1631) en een door Johannes Blommendael vervaardigd wit-marmeren epitaaf (1684) voor ambachtsheer Jacob de Brauw († 1680). Verder zijn er een Tiengebodenbord (circa 1700), een doophek en herenbank (beide eerste helft 18de eeuw) en een door de firma Leichel gemaakte orgelkast (1885)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00918> a min:Passage,
            schema:CreativeWork ;
