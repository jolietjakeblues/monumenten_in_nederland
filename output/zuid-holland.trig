            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23829> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16918",
            "16957" ;
        min:soort "lemma" ;
        min:volgnummer 652 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill262> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "198" ;
        schema:pageStart "197" ;
        schema:pagination "197-198" ;
        schema:text "Windmolens. Als ronde bakstenen stellingmolen uitgevoerd zijn de korenmolens De Rode Leeuw (Vest 65) [48], gebouwd eind 17de eeuw en gerestaureerd in 1984, en 't Slot (Punt 17) [49], opgetrokken in 1832 op een voormalig bolwerk. De laatstgenoemde molen heeft een molenaarswoning met ingezwenkte lijstgevel. De uit 1862 daterende poldermolen De Haastrechtse molen (Provincialeweg West 64), voorzien van een vijzel en een met riet gedekte kap, bemaalt de polder Beneden-Haastrecht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00653> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda – Pakhuizen"@nl ;
        min:adres "Vest 266-268" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
