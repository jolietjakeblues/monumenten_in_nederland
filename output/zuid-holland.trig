        min:adres "Dorpsstraat 36" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Pijnacker-Nootdorp" ;
        min:gemeenteInBoek "Pijnacker-Nootdorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Pijnacker-Nootdorp> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nootdorp (gemeente Pijnacker-Nootdorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nootdorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39524>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47985>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49231> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30776",
            "30777",
            "30778" ;
        min:soort "inleiding" ;
        min:volgnummer 1350 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill550> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0121> ;
        schema:name "Nootdorp (gemeente Pijnacker-Nootdorp)"@nl ;
        schema:pageEnd "380" ;
        schema:pageStart "379" ;
        schema:pagination "379-380" ;
        schema:text "De Herv. kerk (Dorpsstraat 36), oorspronkelijk gewijd aan St. Bartholomeus, is een zaalkerk voorzien van een aangebouwde consistorie en een toren van drie geledingen met tentdak. De begin 16de eeuw gebouwde toren heeft een laat-gotische ingangsomlijsting en bij de onderste geleding overhoekse steunberen. De oude kerk werd in 1894 vervangen door de huidige neogotische zaalkerk met steunberen en muizentandfries. Het gepleisterde interieur wordt gedekt door een houten kap met gesneden consoles en trekstangen. Tot de 17de-eeuwse inventaris behoren een tiengebodenbord (1607), een doophek en een herenbank (overhuiving 18de eeuw). Uit de 18de eeuw dateren een preekstoel in Lodewijk XV-stijl, afkomstig uit de afgebroken kerk van Wilsveen, en een door Pieter van Assendelft en zoon gebouwd orgel (1764-'69)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01351> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nootdorp (gemeente Pijnacker-Nootdorp)"@nl ;
        min:adres "Veenweg 36",
