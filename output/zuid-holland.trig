        min:gemeenteInBoek "Vianen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vianen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Vianen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18668> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "37251" ;
        min:soort "inleiding" ;
        min:volgnummer 1843 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0173> ;
        schema:name "Vianen"@nl ;
        schema:pageEnd "505" ;
        schema:pageStart "505" ;
        schema:pagination "505" ;
        schema:text "De voorm. synagoge (Bakkerstraat 8) [3] is een wit gepleisterd dwars pand, toegankelijk via een poortje en een ingang in de zijgevel. In 1756 vestigden zich hier Hoogduitse joden. De synagoge werd in 1828 en 1847 vernieuwd en in 1924 verkocht aan de Ned. Protestantenbond. Het door een houten tongewelf gedekte interieur bevat een vrouwengalerij op toscaanse zuilen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0173.php> .

