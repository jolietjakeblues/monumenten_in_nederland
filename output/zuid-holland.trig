        schema:name "Bodegraven"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "Het woonhuis Overtocht 22 (circa 1907) hoorde bij een R.K. complex waarvan ook een inmiddels afgebroken zusterhuis en school deel uitmaakten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00363> a min:Passage,
