        min:gemeenteInBoek "Cromstrijen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Numansdorp (gemeente Cromstrijen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Numansdorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23104> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30834" ;
        min:soort "inleiding" ;
        min:volgnummer 1359 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0122> ;
        schema:name "Numansdorp (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "381" ;
        schema:pageStart "381" ;
        schema:pagination "381" ;
        schema:text "De Herv. kerk (Torenstraat 18) is een zaalkerk met driezijdige sluiting en een ingebouwde toren van vier geledingen met ingesnoerde naaldspits. Deze door dorische pilasters gelede kerk dateert uit 1648. De in 1781 toegevoegde toren bevat een door Antoni Wilkes gegoten klok (1655). De noordelijke uitbouw en de ombouwing van de toren kwamen tot stand in 1838. Het interieur wordt gedekt door een houten tongewelf. Tot de 17de-eeuwse inventaris behoren de preekstoel en het doophek; verder is er een herenbank in Lodewijk XIV-stijl. De door Reyer Boeckestyn in 1705 gesneden orgelkast is afkomstig uit de Waalse Kerk te Rotterdam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01360> a min:Passage,
