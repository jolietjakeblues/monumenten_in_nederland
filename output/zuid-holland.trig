        min:gemeenteInBoek "Bernisse" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nissewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidland (gemeente Bernisse)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zuidland" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2014 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0191> ;
        schema:name "Zuidland (gemeente Bernisse)"@nl ;
        schema:pageEnd "548" ;
        schema:pageStart "548" ;
        schema:pagination "548" ;
        schema:text "Het voorm. raadhuis (Ring 24) werd in 1878 gebouwd in eclectische stijl. Het als school dienende langgerekte eenlaags middendeel wordt geflankeerd door een aangebouwde onderwijzerswoning en een tweelaags raadhuisgedeelte met raadzaal op de verdieping."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02015> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidland (gemeente Bernisse) – Woonhuizen"@nl ;
        min:adres "Raadhuisstraat 31",
            "Stationsweg 7" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Nissewaard" ;
        min:gemeenteInBoek "Bernisse" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nissewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidland (gemeente Bernisse)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zuidland" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19214>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53039> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "525169",
            "9422" ;
        min:soort "lemma" ;
        min:volgnummer 2015 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill811> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0191> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "548" ;
        schema:pageStart "548" ;
        schema:pagination "548" ;
        schema:text "Woonhuizen. Van de diverse oude en overwegend diepe huizen in het dorp gaan er enkele tot de 17de eeuw terug. Een gepleisterde puntgevel heeft Kerkstraat 21, dat met jaartalankers is gedateerd ‘1608’. Het rijkst uitgevoerd is het in 1637 (gevelsteen) op de spuisluis van 1609 gebouwde huis Ring 13. De in een tuitgevel veranderde trapgevel is voorzien van sierankers en siermetselwerk in de boogvelden boven de verdiepingsvensters. In opzet 17de-eeuws zijn de diepe huizen Ring 7, Ring 22 (gevel circa 1840) en Ring 1 (gevel 1907). Laat-18de-eeuws is het pand Ring 3 met smalle halsgevel. Het uit 1820 daterende gepleisterde huis Raadhuisstraat 46 kreeg rond 1890 een chaletstijl-sierspant. Hoofd 15 is een eenvoudig dwars eenlaagspand uit circa 1850. Voorbeelden van rentenierswoningen met eclectische details zijn de dwarse eenlaagspanden Kerkweg 5 (circa 1860) en Neckwaerdt (Stationsweg 7). Eveneens in eclectische vormen uitgevoerd is het diepe huis Breedstraat 7 (circa 1880). Het grote tweelaagse notarishuis Huize Loeff (Raadhuisstraat 31) kwam in 1875 tot stand in neoclassicistische stijl. Zakelijk-expressionistische elementen vertoont de forse villa Stationsweg 9 (circa 1925)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02016> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidland (gemeente Bernisse) – Tuinkoepels"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
