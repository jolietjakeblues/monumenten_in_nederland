        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "De voorm. R.K. St.-Jozefkerk (Hoge Gouwe 41) [11], nu ‘Gouwekerk’, is een driebeukige basilicale kruiskerk met vijfzijdig gesloten koor en transeptarmen, een zeszijdige houten vieringtoren en een rijke voorgevel met drie portalen en twee achtzijdige traptorens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00638> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
        min:adres "Hoge Gouwe 39" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
