        schema:name "Noordwijkerhout"@nl ;
        schema:pageEnd "378" ;
        schema:pageStart "378" ;
        schema:pagination "378" ;
        schema:text "De pastorie (St.-Victorlaan 11) is een L-vormig wit gesausd herenhuis uit 1897 met neogotische details (verbouwd 1940). De wit gepleisterde kosterij met garage (St.-Victorlaan 15) dateert uit 1936 en is voorzien van een terracottareliëf met Regina Coeli-voorstelling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01340> a min:Passage,
            schema:CreativeWork ;
