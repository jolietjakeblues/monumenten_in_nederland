        schema:name "Nieuwe-Tonge (gemeente Middelharnis)"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "Ter afsluiting van de brug over de kerkgracht staat een toegangshek met siervazen in Lodewijk XV-stijl, afkomstig van het buiten Langendam bij Sommelsdijk (1842 hier geplaatst)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0108.php> .

