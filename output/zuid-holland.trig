        min:gemeenteInBoek "Alkemade" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oude Wetering (gemeente Alkemade)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Oude Wetering" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37769> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "7110" ;
        min:soort "inleiding" ;
        min:volgnummer 1443 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0131> ;
        schema:name "Oude Wetering (gemeente Alkemade)"@nl ;
        schema:pageEnd "395" ;
        schema:pageStart "395" ;
        schema:pagination "395" ;
        schema:text "De Herv. kerk (Kerkstraat 11) is een T-vormige kerk, waarvan het dwarse deel in 1685-'91 werd gebouwd. De dakruiter heeft men in 1695 toegevoegd en in 1843 verrees de haakse aanbouw met neoclassicistisch fronton en ingangsomlijsting. Het door houten tongewelven gedekte interieur bevat onder meer een preekstoel uit circa 1700 en een orgelkast uit 1784. De pastorie (Kerkstraat 10) is een fors neoclassicistisch pand uit 1879."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01444> a min:Passage,
            schema:CreativeWork ;
