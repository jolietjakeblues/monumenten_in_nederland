        schema:pageStart "550" ;
        schema:pagination "550" ;
        schema:text "Het voorm. raadhuis (Henry Fordstraat 2) is een tweelaags diep pand uit circa 1870 met een omlijste ingang en wenkbrauwen boven de vensters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0193.php> .

