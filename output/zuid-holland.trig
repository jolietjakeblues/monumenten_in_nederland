        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21270> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16958" ;
        min:soort "inleiding" ;
        min:volgnummer 630 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De O.L.-Vrouwetoren (Vrouwesteeg 34) [5] was onderdeel van de in 1493 voor de Rozenkransbroederschap gebouwde O.L.-Vrouwekapel (afgebroken rond 1585). In 1754 werd deze met een traptoren uitgevoerde toren aan de zuidzijde beklampt en voorzien van een achtzijdige houten lantaarn met spits (vernieuwd 1961-'62). De toren bevat een door Thomas Both gegoten klok (1590)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00631> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gouda"@nl ;
