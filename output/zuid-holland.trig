        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heinenoord (gemeente Binnenmaas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Heinenoord" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 813 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0058> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Woonhuizen. Karakteristiek zijn de langs de dijk gelegen dwarse huizen - eenlaags voor en tweelaags achter - zoals Dorpsstraat 26 (circa 1850) en Dorpsstraat 23 (1869). Vergelijkbaar is de rentenierswoning Dorpsstraat 59, gebouwd in 1879 naar ontwerp van J.Th. Beljers voor A. Leeuwenburgh, die de boerderij Midden Leeuwenstein bewoonde. Aardige voorbeelden van wederopbouwarchitectuur zijn de huizen Hofplein 4-28."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00814> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heinenoord (gemeente Binnenmaas) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 13",
            "Dorpsstraat 63",
            "Dorpsstraat 65",
            "Dorpsstraat 79" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Hoeksche Waard" ;
        min:gemeenteInBoek "Binnenmaas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoeksche_Waard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heinenoord (gemeente Binnenmaas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Heinenoord" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39862>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49207>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53822> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "21351",
            "21353",
            "21354" ;
        min:soort "lemma" ;
        min:volgnummer 814 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0058> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text """Boerderijen. Ten zuiden van de dijk staan drie fraaie boerderijen. Een breed 17de-eeuws woongedeelte met schoudergevel bezit de grote boerderij Oost Leeuwenstein (Dorpsstraat 13). Het zomerhuis met puntgevel, fronton en hoekvoluten dateert van 1763. De gepleisterde boerderij West Leeuwenstein (Dorpsstraat 79) heeft een zijlangsdeelschuur met het jaartal ‘1762’ en een woonhuis met puntgevel en fronton uit 1865. Bij de boerderij Midden Leeuwenstein (Dorpsstraat 63) dateert de zijlangsdeelschuur van 1763 en het woongedeelte van 1851. Het laat-18de-eeuws inrijhek is voorzien van hardstenen hekpalen met schilddragende leeuwen.

De smederij (Dorpsstraat 65) is een rond 1880 langs de dijk gebouwd pand met haaks woongedeelte. Voor de werkplaatsingang staat een ijzeren travalje met een wielsteen in de bestrating."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00815> a min:Passage,
