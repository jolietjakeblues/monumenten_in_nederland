        min:gemeenteInBoek "Leiderdorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leiderdorp_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
