        min:gemeenteInBoek "Schiedam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schiedam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schiedam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schiedam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13169> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "525402" ;
        min:soort "inleiding" ;
        min:volgnummer 1694 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0156> ;
        schema:name "Schiedam"@nl ;
        schema:pageEnd "468" ;
        schema:pageStart "468" ;
        schema:pagination "468" ;
        schema:text "Het voorm. dominicanessenklooster (Korte Haven 127) [6] is een in 1886-'87 naar plannen van Th.L. Kanters opgetrokken L-vormig klooster met bijbehorend schoolgebouw. Het aan de straat gelegen bouwdeel heeft een neorenaissance-detaillering, de kapel vertoont neoromaanse details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0156.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01695> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schiedam"@nl ;
        min:adres "Lange Nieuwstraat 219" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Schiedam" ;
        min:gemeenteInBoek "Schiedam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schiedam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schiedam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schiedam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40635> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "33253" ;
        min:soort "inleiding" ;
        min:volgnummer 1695 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0156> ;
        schema:name "Schiedam"@nl ;
        schema:pageEnd "468" ;
        schema:pageStart "468" ;
        schema:pagination "468" ;
        schema:text "De Evang. Luth. kerk (Lange Nieuwstraat 219) [7] draagt als opschrift ‘Een Vaste Burg is Onze God’. Deze deels gepleisterde neoclassicistische kerk met dakruiter ontstond in 1892 na verbouwing van een monumentaal gistpakhuis (circa 1860). De kerk wordt geflankeerd door de pastorie en de consistoriekamer en bevat een uit de Doopsgez. kerk te Deventer afkomstige preekstoel (eind 18de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0156.php> .

