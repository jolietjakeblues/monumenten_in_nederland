        min:volgnummer 1871 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill758> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0176> ;
        schema:name "Voorburg (gemeente Leidschendam-Voorburg)"@nl ;
        schema:pageEnd "515" ;
        schema:pageStart "515" ;
        schema:pagination "515" ;
        schema:text "De voorm. Waalse kerk (Franse Kerkstraat 24) is een zaalkerk uit 1726 met geveltoren. De natuurstenen ingangsomlijsting is voorzien van ionische pilasters en een fronton. In 1958 is de kerk achteren verlengd en in gebruik genomen als Geref. Vrijgem. kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01872> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorburg (gemeente Leidschendam-Voorburg)"@nl ;
