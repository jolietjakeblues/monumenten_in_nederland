        min:soort "inleiding" ;
        min:volgnummer 1790 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0165> ;
        schema:name "Stellendam (gemeente Goedereede)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "De Geref. kerk (Kerkhoflaan 4), een traditionalistische zaalkerk met geveltoren en opengewerkte dakruiter, is in 1956 tot stand gekomen naar ontwerp van L.F. Kloppers en verving een in 1953 door het zeewater aangetaste voorganger."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01791> a min:Passage,
