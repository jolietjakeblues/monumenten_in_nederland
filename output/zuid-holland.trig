        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Middelharnis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stad aan 't Haringvliet (gemeente Middelharnis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Stad aan 't Haringvliet" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41939> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29747" ;
        min:soort "lemma" ;
        min:volgnummer 1787 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0164> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Boerderijen. In de omgeving van het dorp liggen verschillende waardevolle boerderijen. De in 1746 gebouwde langhuisboerderij Zeedijk 1 bestaat uit een woonhuis met puntgevel en een houten schuur onder één doorgaand dak, waarin met blauwe pannen het bouwjaar is ingelegd. Onder een afluiving bevindt zich de ouderkamer. De dwarsdeelboerderij Geerweg 6 dateert uit circa 1850 en heeft een schuur met gepotdekselde houten wanden. Begin 20ste eeuw zijn de hoeve Torenstee (Potterweg 1; 1907) met zomerhuis en de boerderij Zeedijk 27 (1916) met vrijstaande schuur gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01788> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stellendam (gemeente Goedereede)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Goedereede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stellendam (gemeente Goedereede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Stellendam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1788 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0165> ;
        schema:name "Stellendam (gemeente Goedereede)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Klein voorstraatdorp, ontstaan na de aanleg van de Statendam tussen Goeree en Overflakkee (1751) over een ‘stelle’ (buitendijkse hoogte). Aan de noordzijde bedijkte men de Eendrachtspolder (1780). Ambachtsheer Iman Cau liet kort daarop in Stellendam een rechthuis liet bouwen. Het dorp werd in 1953 door de Watersnoodramp getroffen, waarna de Eendrachtsdijk is verhoogd en de haven van de Voorstraat is gescheiden. Na de aanleg van de Haringvlietdam heeft men daar een nieuwe binnen- en buitenhaven met visafslag gerealiseerd (1974)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01789> a min:Passage,
            schema:CreativeWork ;
