        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50340> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "527171" ;
        min:soort "inleiding" ;
        min:volgnummer 1459 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0133> ;
        schema:name "Overschie (gemeente Rotterdam)"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "De Herv. kerk (Overschiese Dorpsstraat 95) is een driebeukige kruiskerk met een toren van drie geledingen voorzien van een sierlijke spits met ui-vormige bekroning. De middeleeuwse dorpskerk brandde in 1899 af. Onder leiding van B. Hooijkaas werd de toren naar oude voorbeelden herbouwd in neorenaissance-vormen en verrees er een kerkgebouw met preekstoel, banken en een doophek in een stijl met gotische- en jugendstil-motieven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0133.php> .

