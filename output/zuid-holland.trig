        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Lekkerland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Lekkerland" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1235 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0107> ;
        schema:name "Nieuw-Lekkerland"@nl ;
        schema:pageEnd "362" ;
        schema:pageStart "362" ;
        schema:pagination "362" ;
        schema:text "De Geref. kerk (Dorpslaan 5) is een zaalkerk met ranke dakruiter, gebouwd in 1935 naar een zakelijk-expressionistisch ontwerp van B.W. Plooy."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01236> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Lekkerland"@nl ;
        min:adres "Lekdijk 354" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Nieuw-Lekkerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Lekkerland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Lekkerland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60791> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "516160" ;
        min:soort "inleiding" ;
        min:volgnummer 1236 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0107> ;
        schema:name "Nieuw-Lekkerland"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "362" ;
        schema:pagination "362-363" ;
        schema:text "Het voorm. Tehuis voor ouden van dagen ‘L. & N. Smit's Stichting’ (Lekdijk 354), gebouwd in 1885 in opdracht van ambachtsheer L. Smit en zijn echtgenote, is een imposant onderkelderd tweelaags dijkhuis in eclectische stijl met midden- en hoekrisalieten voorzien van gepleisterde en geblokte lisenen. De zijrisalieten hebben opzetstukken met acroteriën. Het gebouw is in 1960 in gebruik genomen als raadhuis en sinds de renovatie in 1996 dient het als kantoor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01237> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Lekkerland – Boerderijen"@nl ;
        min:adres "Lekdijk 79",
            "Lekdijk 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Nieuw-Lekkerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Lekkerland" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuw-Lekkerland" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1237 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0107> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "Boerderijen. De 17de-eeuwse hallenhuisboerderij Lekdijk 63 is een goed voorbeeld van een binnendijks aan de dijkvoet gelegen boerderij. De voorgevel heeft een geblokte ontlastingsboog en muurankers. Tegen de dijk aangebouwd is de gepleisterde, in de kern 17de-eeuwse, boerderij Lekdijk 123-125; benedendijks aangebouwd is een jongere stal. De evenwijdig aan de dijk geplaatste dwarsdeelboerderij Lekdijk 22-23 dateert uit 1789. Voorbeelden van laat-19de-eeuwse langhuisboerderijen zijn Bongers Wens (Lekdijk 9) en Lekdijk 40 en 81. De boerderij Lekdijk 236 valt op door haar schoudergevel met pinakels met pirons (circa 1900). Uit circa 1920 dateert de langhuisboerderij Hier in den Tijd - Nooit Volmaakt (Lekdijk 79). Voorbeelden van laat-19de-eeuwse boerderijen met een tegen de dijk aangebouwd dwars voorhuis zijn Lekdijk 11, 20 en 62."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01238> a min:Passage,
