        schema:pageStart "524" ;
        schema:pagination "524" ;
        schema:text "Wegdorp, ietwat verhoogd gelegen op een verlande rivierarm in een in de 12de eeuw ontgonnen gebied. De dorpskern met 16de-eeuwse kerk ligt ten noorden van het boerderijlint Westeinde-Oosteinde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0179.php> .

