        schema:name "Scholen"@nl ;
        schema:pageEnd "273" ;
        schema:pageStart "273" ;
        schema:pagination "273" ;
        schema:text "Scholen. Uit 1921 dateert de Chr. lagere school (Terbregse Rechter Rottekade 122-130) met onderwijzerswoning. Voorbeelden van tweelaagse scholen in sobere zakelijk-expressionistische stijl zijn de openbare lagere school (Kerkstraat 39-41; circa 1920) en de gebouwen A. van der Doeslaan 13-15 (circa 1925), Hilleniussingel 23 (1928), Hillegondastraat 25 (1929)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00843> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hillegersberg (gemeente Rotterdam) – Woonhuizen"@nl ;
        min:adres "C.N.A. Looslaan 15",
            "Straatweg 206",
            "Straatweg 5-7" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Rotterdam" ;
        min:gemeenteInBoek "Rotterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rotterdam> ;
