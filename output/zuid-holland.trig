        min:soort "lemma" ;
        min:volgnummer 299 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0013> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Boerderijen. Een dwars geplaatst woonhuis met rieten zadeldak heeft de rond 1800 gebouwde boerderij Lekdijk 91. Binnendijks ligt de boerderij Lekdijk 80 uit 1878."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00300> a min:Passage,
