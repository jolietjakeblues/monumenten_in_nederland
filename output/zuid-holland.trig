        schema:name "Melissant (gemeente Dirksland)"@nl ;
        schema:pageEnd "350" ;
        schema:pageStart "350" ;
        schema:pagination "350" ;
        schema:text "De Herv. kerk (Julianaweg 2), een neoclassicistische zaalkerk, werd in 1862-'63 gebouwd door aannemer J. van Bochove. In de geveltoren hangt een door Gerrit Bakker gegoten klok (1790)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0096.php> .

