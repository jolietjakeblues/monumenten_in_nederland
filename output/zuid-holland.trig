        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68724>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68725> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "517602",
            "517603" ;
