        schema:pageEnd "549" ;
        schema:pageStart "549" ;
        schema:pagination "549" ;
        schema:text "Begraafplaatsen. De in 1830 aangelegde Alg. begraafplaats (Raadhuissstraat ong.) heeft een gietijzeren hek met gevleugelde zandlopers als decoraties (circa 1900). De uit 1888 daterende Isr. begraafplaats (bij Kerkweg 38) bevat nog vijf grafstenen (1916-'40)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02021> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidland (gemeente Bernisse) – Simonshaven"@nl ;
        min:adres "Lageweg 1",
            "Ring 42",
            "Ring 73" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Nissewaard" ;
        min:gemeenteInBoek "Bernisse" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nissewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidland (gemeente Bernisse)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zuidland" ;
        min:lemma "Simonshaven" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38364> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "9410" ;
        min:soort "lemma" ;
        min:volgnummer 2021 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0191> ;
        schema:name "Simonshaven"@nl ;
        schema:pageEnd "549" ;
        schema:pageStart "549" ;
        schema:pagination "549" ;
        schema:text "Simonshaven. Dit havendorp ten oosten van Zuidland ontstond begin 14de eeuw na de bedijking van de Polder Simonshaven en had een haven op de Bernisse. Net buiten het dorp staat de Herv. kerk (Lageweg 1), een gepleisterde neoclassicistische zaalkerk met geveltoren, gebouwd in 1852 ter plaatse van de afgebrande middeleeuwse kerk. Het interieur is voorzien van pilasters en een gestukadoord houten koofplafond en bevat een preekstoel met doophek, enkele luifelbanken en een orgel uit de bouwtijd. Een ingezwenkte lijstgevel met iel pronkrisaliet heeft het woongedeelte van de boerderij Ring 16 (circa 1852). Uit 1863 dateert het forse voorm. raadhuis (Ring 42) met gepleisterd middenrisaliet, hoekpilasters en eclectische details. De voorm. eenklassige openbare lagere school (Ring 73) werd rond 1875 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02022> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwammerdam (gemeente Alphen aan den Rijn)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwammerdam (gemeente Alphen aan den Rijn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zwammerdam" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2022 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0192> ;
        schema:name "Zwammerdam (gemeente Alphen aan den Rijn)"@nl ;
        schema:pageEnd "549" ;
        schema:pageStart "549" ;
        schema:pagination "549" ;
        schema:text "Dijkdorp, ontstaan op een oeverwal aan de zuidzijde van de Oude Rijn nabij de samenkomst met de Meije. Ten westen van de huidige dorpskom, op het terrein van de Hooge Burch, stond in de Romeinse tijd een castellum (circa 70-250 na Chr.) als onderdeel van de Romeinse grensverdediging (Limes). In de vroege middeleeuwen was opnieuw sprake van bewoning. Later in de middeleeuwen ontwikkelde Zwammerdam zich tot een handelsnederzetting nabij de Svadenburgerdam, die graaf Floris III kort voor 1165 in de Oude Rijn liet aanleggen om de wateroverlast tegen te gaan. De overwegend lineaire bebouwing op de zuidoever van de Oude Rijn kreeg in de vroege 17de eeuw een kleine dorpskom nabij de brug over de Oude Rijn (Brugstraat). Na de Tweede Wereldoorlog heeft enige verdichting van de bebouwing plaatsgevonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0192.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/02023> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwammerdam (gemeente Alphen aan den Rijn)"@nl ;
        min:adres "Kerkplein 6",
            "Kerkplein 7" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
