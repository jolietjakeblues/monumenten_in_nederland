        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29795",
            "29855",
            "31706" ;
        min:soort "inleiding" ;
        min:volgnummer 472 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0031> ;
        schema:name "Den Bommel (gemeente Oostflakkee)"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "De Herv. kerk (Voorstraat 25) is een aan beide korte zijden driezijdig gesloten zaalkerk, gebouwd in 1646-'47 met gotische elementen en steunberen. In de in 1759 toegevoegde dakruiter hangt een door Cornelis Ouderogge gegoten klok (1647). Het portaal met ingezwenkte topgevel in Lodewijk XV-vormen dateert uit 1779. Bij een restauratie in 1963 is de 19de-eeuwse torenopbouw verwijderd. De kerk bevat een midden-17de-eeuwse preekstoel. De forse pastorie (Voorstraat 38) uit 1927 vertoont zakelijkexpressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0031.php> .

