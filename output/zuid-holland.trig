        min:kern "Leidschendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45454> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "25706" ;
        min:soort "inleiding" ;
        min:volgnummer 1065 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill474>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill475> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0086> ;
        schema:name "Leidschendam (gemeente Leidschendam-Voorburg)"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "333" ;
        schema:pagination "333-334" ;
        schema:text "De Herv. kerk (Delftsekade 7), een rijzige achtzijdige kerk, werd gebouwd in 1647-'53 naar ontwerp van Arent van 's-Gravesande en vervolgens na brand (1691) herbouwd in 1693-'96 naar plannen van Jacob Roman. In 1864-'65 heeft men de kerk verhoogd en deels gepleisterd, en kreeg ze haar huidige neoclassicistische aanzien met achtzijdig tentdak en opengewerkte lantaarn. Daarin hangt een door Claude Fremy gegoten klok (1685). Tot de inventaris behoren een rijk gesneden laat-17de-eeuwse preekstoel met bijbehorend doophek en een herenbank uit 1697."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01066> a min:Passage,
