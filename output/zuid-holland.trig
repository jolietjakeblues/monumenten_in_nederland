        min:gemeenteInBoek "Papendrecht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Papendrecht_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Papendrecht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Papendrecht" ;
        min:lemma "Bruggen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1472 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0134> ;
        schema:name "Bruggen"@nl ;
        schema:pageEnd "400" ;
        schema:pageStart "400" ;
        schema:pagination "400" ;
        schema:text """Bruggen. De ophaalbrug naar het eiland Slobbengors (Havenstraat ong.) is een geklonken welijzeren ophaalbrug uit circa 1910. De betonboogbrug over de rijksweg A 15 (Veerweg ong.), met laaggelegen rijvloer en aan de bovenzijde tussen beide bogen een diagonaal windverband, werd in 1938 gebouwd.

De zeszijdige muziektent aan de Kazernestraat dateert uit circa 1960 en heeft een tentdak en een bakstenen voet."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01473> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Pernis (gemeente Rotterdam)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Rotterdam" ;
        min:gemeenteInBoek "Rotterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rotterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Pernis (gemeente Rotterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Pernis" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1473 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0135> ;
        schema:name "Pernis (gemeente Rotterdam)"@nl ;
        schema:pageEnd "400" ;
        schema:pageStart "400" ;
        schema:pagination "400" ;
        schema:text "Dijkdorp, hoogstwaarschijnlijk genoemd naar Jacobus van Pernesse, aan wie in 1249 het gebruik van een haven werd toegestaan. In de 15de eeuw vormde zich bebouwing aan de Pastoriedijk, die samen met de Ring een cirkelvormig gebied omsluit. In 1929 werd aan de westkant de 1ste Petroleumhaven gegraven voor de olieraffinaderij van Shell (1936). Na de annexatie van Pernis door Rotterdam in 1934 volgde de aanleg van de 2de Petroleumhaven (1938). Sinds de aanleg van de Eemhaven (1946) aan de oostzijde is Pernis geheel door havens ingesloten. Binnen de cirkelvormige kern is in 1958 een nieuwbouwwijk verwezenlijkt. Na het dempen van de vissershaven (Nieuwedijk) in 1959 is meer westelijk de Madroelhaven gegraven (1960)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0135.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01474> a min:Passage,
