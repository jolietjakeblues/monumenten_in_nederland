        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koudekerk aan den Rijn (gemeente Rijnwoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Koudekerk aan den Rijn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26938>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49996> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "7517",
            "8995" ;
        min:soort "inleiding" ;
        min:volgnummer 938 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill406> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0077> ;
        schema:name "Koudekerk aan den Rijn (gemeente Rijnwoude)"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven. Tot de inventaris behoren een gesneden koorhek (waarschijnlijk uit 1678 met delen uit 1765 in Lodewijk XV-stijl), een rouwbord voor Alida van Schellingwoude (1717) en een door Gerrit Schotsman in Lodewijk XV-stijl vervaardigde preekstoel (1765). Verder zijn er twee 17de-eeuwse banken met rugschotten, twee overhuifde herenbanken (circa 1700) en een overhuifde herenbank in Lodewijk XV-stijl (circa 1775). Bij de restauratie in 1935-'36 is het 18de-eeuwse doophek samengesteld uit panelen in Lodewijk XV-stijl afkomstig uit de Rotterdamse St.-Rosaliakerk. Verder bevat de kerk enkele 17de- en 18de-eeuwse grafzerken. De pastorie (Dorpsstraat 48), een gepleisterd blokvormig pand uit circa 1870, vertoont eclectische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0077.php> .

