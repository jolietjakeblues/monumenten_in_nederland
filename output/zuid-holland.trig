        min:volgnummer 243 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0008-01> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "71" ;
        schema:pageStart "71" ;
        schema:pagination "71" ;
        schema:text "Boerderijen. Waardevolle hallenhuisboerderijen zijn de laat-18de-eeuwse boerderij Zuideinde 10 (zomerhuis circa 1880) en de gepleisterde vroeg-19de-eeuwse kleine boerderij Zuideinde 69. Rond 1840 gebouwd zijn de boerderij Zuideinde 12, met dwars geplaatst woonhuis en omlijste ingang, en de vergelijkbare boerderij Denk en Werk (Zuideinde 30). Versierde windveren hebben de langhuisboerderijen Noordeinde 16 (circa 1895) en Semper Gaudensis (Zuideinde 24; 1912)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0008.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00244> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aarlanderveen (gemeente Alphen aan den Rijn) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Alphen aan den Rijn" ;
        min:gemeenteInBoek "Alphen aan den Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen_aan_den_Rijn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aarlanderveen (gemeente Alphen aan den Rijn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Aarlanderveen" ;
