        min:kern "Noordwijkerhout" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1338 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0120> ;
        schema:name "Noordwijkerhout"@nl ;
        schema:pageEnd "377" ;
        schema:pageStart "377" ;
        schema:pagination "377" ;
        schema:text "De R.K. H.H. Victor en Petrus en Pauluskerk (St.-Victorlaan 13) is een driebeukige neogotische kerk, gebouwd in 1851-'52 naar ontwerp van Th. Molkenboer. In 1897-'98 werd het koor vervangen door een groter neogotisch transept en koor naar plannen van P. Snel. Het oorspronkelijke geveltorentje heeft men in 1937 gesloopt. Naast de kerk verrees toen een sobere toren met ingesnoerde spits naar ontwerp van B.J.M. Stevens. De kerk is in 1985 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01339> a min:Passage,
