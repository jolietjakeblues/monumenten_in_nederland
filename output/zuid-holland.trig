        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69759>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69760> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "510300",
            "510301" ;
        min:soort "inleiding" ;
        min:volgnummer 1066 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0086> ;
        schema:name "Leidschendam (gemeente Leidschendam-Voorburg)"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text "De R.K. St.-Petrus en Pauluskerk (Sluiskant 29) is een driebeukige basilicale kruiskerk met driezijdig gesloten koor en aan de zuidwestzijde een toren met frontalen en naaldspits. De eindgevels van middenbeuk en transept zijn voorzien van roosvensters. Deze neogotische kerk verrees in 1878-'80 naar ontwerp van E.J. Margry. In 1990-'91 heeft men de toren en de voorgevel gerestaureerd. De glas-in-loodramen (1881) zijn van atelier F. Nicolas & Zn. en J.B.F. Capronnier (Brussel). J. Dunselman verzorgde de interieurpolychromie (hersteld circa 1990) en de kruiswegstaties. Het Maria-altaar is ontworpen door Margry, evenals de in neorenaissance-stijl uitgevoerde pastorie (Sluiskant 28; 1880)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01067> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leidschendam (gemeente Leidschendam-Voorburg) – Overige kerken"@nl ;
        min:adres "Burg. Roeringlaan 6",
            "Burg. Sweenslaan 5-9",
            "Raadhuisplein 1",
            "Veursestraatweg 185" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Leidschendam-Voorburg" ;
        min:gemeenteInBoek "Leidschendam-Voorburg" ;
