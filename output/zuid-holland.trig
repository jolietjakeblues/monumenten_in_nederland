        schema:name "Gouda"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "Het voorm. lokaal van de Vergadering van Gelovigen (Peperstraat 20) [10] kwam in 1897 tot stand in neorenaissance-stijl in opdracht van manufacturenkoopman P. de Raadt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00637> a min:Passage,
            schema:CreativeWork ;
