        schema:text "Voor de hulp die wij vanuit de provincie mochten ontvangen gaat onze dank uit naar W.J. Berghuis, J. Dröge, J. van der Hoeve, C. van der Hoeven-Scheffer, T. Knibbeler, B. Koopmans, C. van Nes, E. Orsel, G. Snel, D. Valentijn en W.F. Weve."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0003.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00026> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ten geleide"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
