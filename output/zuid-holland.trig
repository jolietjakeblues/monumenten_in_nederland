        min:gemeenteInBoek "Schoonhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schoonhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonhoven" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51014> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "525035" ;
        min:soort "inleiding" ;
        min:volgnummer 1728 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0158> ;
        schema:name "Schoonhoven"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "De Oud Kath. St.-Bartholomeuskerk (Wal 30) [7] is een zaalkerk met driezijdig gesloten koor en een voorgevel met robuust kruis, geflankeerd door een zeszijdige traptoren met spits. Kerk en pastorie kwamen in 1905 tot stand naar een vereenvoudigd ontwerp in rationalistische stijl van J.G. Copper, ter vervanging van een kleine schuilkerk uit 1784 (Wal 14). Het interieur bevat een barok-tabernakel (circa 1690) en enkele 18de-eeuwse heiligenbeelden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01729> a min:Passage,
