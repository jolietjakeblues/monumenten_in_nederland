        min:lemma "Vestingwerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15246>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18758>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26445>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36267>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38188>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53119>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58975>,
