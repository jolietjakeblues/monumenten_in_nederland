        schema:name "Arkel (gemeente Giessenlanden)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text "Het raadhuis (Dam 1-3) is een rond 1939 in traditionalistische vormen opgetrokken breed pand met balkon boven de ingangspartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00304> a min:Passage,
