        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill599> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0141> ;
        schema:name "Reeuwijk-Brug (gemeente Reeuwijk)"@nl ;
        schema:pageEnd "407" ;
        schema:pageStart "406" ;
        schema:pagination "406-407" ;
        schema:text "De Herv. kerk ('s-Gravenbroekseweg 85, Sluipwijk) is een sobere neoclassicistische zaalkerk, gebouwd in 1863 naar ontwerp van A. Koorevaar ter vervanging van een 16de-eeuwse kruiskerk. De geveltoren werd in 1887 toegevoegd. Het kerkhof wordt omringd door een muur uit 1829 in gele baksteen. De voorm. pastorie ('s Gravenbroekseweg 85a) dateert uit 1884."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0141.php> .

