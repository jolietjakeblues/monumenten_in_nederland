        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0164> ;
        schema:name "Stad aan 't Haringvliet (gemeente Middelharnis)"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Het voorm. brandspuithuisje (bij Voorstraat 25) is een eenvoudig klein gebouw uit 1928 met het opschrift ‘Motorspuit’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01785> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stad aan 't Haringvliet (gemeente Middelharnis) – Woonhuizen"@nl ;
        min:adres "Haven 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Goeree-Overflakkee" ;
        min:gemeenteInBoek "Middelharnis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Goeree-Overflakkee> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stad aan 't Haringvliet (gemeente Middelharnis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Stad aan 't Haringvliet" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1785 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0164> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text """Woonhuizen. Aan de Voorstraat staan nog enkele diepe huizen die in opzet uit de 17de eeuw dateren, zoals Voorstraat 34 (met sierankers) en Voorstraat 36. Hetzelfde geldt voor Voorstraat 9 en 11, die in de 19de eeuw een gepleisterde voorgevel kregen. Het later gepleisterde huis Voorstraat 19 stamt uit de 18de eeuw. Rond 1880 gebouwd zijn de gepleisterde neoclassicistische dokterswoning Molendijk 4 en het huis Achterdijk 65, dat een met verf geaccentueerde blokbepleistering heeft. De omstreeks 1870 opgetrokken gevel van Voorstraat 25 kreeg rond 1915 een gepleisterde lijst.

De redoute (Haven 4), oorspronkelijk een vierkant gebouw uit 1621 met schietgaten, werd in 1901 opgehoogd en verbouwd tot ‘polderkamer’."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

