        min:kern "Numansdorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61941> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30835" ;
        min:soort "inleiding" ;
        min:volgnummer 1360 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0122> ;
        schema:name "Numansdorp (gemeente Cromstrijen)"@nl ;
        schema:pageEnd "381" ;
        schema:pageStart "381" ;
        schema:pagination "381" ;
        schema:text "Op het kerkhof met centrale aanleg bevinden zich onder meer de grafzerk voor burgemeester A. Vlielander († 1872) en een grafteken met mozaïekwerk voor C. Frederek († 1886). De voorm. pastorie (Voorstraat 30) is een fors tweelaags pand uit circa 1840 met ingangsomlijsting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0122.php> .

