        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noorden (gemeente Nieuwkoop)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Noorden" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1304 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0117> ;
        schema:name "Noorden (gemeente Nieuwkoop)"@nl ;
        schema:pageEnd "372" ;
        schema:pageStart "372" ;
        schema:pagination "372" ;
        schema:text "Ontginningsdorp met twee kernen, ontstaan in de middeleeuwen. De ontginningsbasis wordt gevormd door zowel de Noordse Dorpsweg als de zuidelijker gelegen S. van Capelweg-Voorweg. Het gebied ten zuiden van het dorp werd in de 18de en 19de eeuw uitgeveend, waarna zich de Nieuwkoopse Plassen vormden. In 1809 ontstond aan de noordwestzijde de Polder Nieuwkoop en aan de noordoostzijde de polder Noordse Buurt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01305> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noorden (gemeente Nieuwkoop)"@nl ;
        min:adres "Noordse Dorpsweg 12",
            "Noordse Dorpsweg 4" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
