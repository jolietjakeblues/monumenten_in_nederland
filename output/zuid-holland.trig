        min:hoofdstuk "Steden, dorpen, monumenten › Ridderkerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Ridderkerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12030>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57379> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "32481",
            "32482" ;
        min:soort "inleiding" ;
        min:volgnummer 1525 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0144> ;
        schema:name "Ridderkerk"@nl ;
        schema:pageEnd "411" ;
        schema:pageStart "411" ;
        schema:pagination "411" ;
        schema:text "De voorm. synagoge (Benedenrijweg 9) was van 1853 tot 1924 gevestigd in de voorkamer op de verdieping van een vroeg-19de-eeuws woonhuis. De mannensjoel was overdekt met een houten koepelgewelf, de Ark stond tussen twee vensters aan de voorzijde en in een nevenruimte, afgescheiden door een balusterhek met deur, bevonden zich de vrouwenplaatsen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01526> a min:Passage,
