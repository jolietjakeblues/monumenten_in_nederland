        schema:name "Hei- en Boeicop (gemeente Zederik)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Het voorm. rechthuis (Hei- en Boeicopweg 29) is een eenvoudig pand uit 1827, waarin ook een herberg, winkel en stal waren gehuisvest en dat tot 1960 als gemeentehuis heeft gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0057.php> .

