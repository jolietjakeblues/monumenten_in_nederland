        min:gemeenteInBoek "Leidschendam-Voorburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leidschendam-Voorburg> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Voorburg (gemeente Leidschendam-Voorburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Voorburg" ;
        min:lemma "Huis de Werve" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24978> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "37966" ;
        min:soort "lemma" ;
        min:volgnummer 1882 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0176> ;
        schema:name "Huis de Werve"@nl ;
        schema:pageEnd "517" ;
        schema:pageStart "517" ;
        schema:pagination "517" ;
        schema:text "Huis de Werve (Park de Werve 1) is een grotendeels gepleisterd T-vormig buitenhuis. Van een in 1801 gesloopte - in oorsprong middeleeuwse - ridderhofstad bleef alleen het bouwhuis met achtkantige traptoren behouden (1619). In opdracht van J. Ancher werd daaraan rond 1820 een dwars voorgebouw toegevoegd, waaraan A.J. Bicker Caarten in 1894 een verdieping liet toevoegen. Verbouwingen volgden in 1913 en 1942; het gebouw is in 1969-'70 gerestaureerd en heeft in 1987 een colonnade gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01883> a min:Passage,
