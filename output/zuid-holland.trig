        schema:name "Dubbeldam (gemeente Dordrecht)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Het voorm. raadhuis (Dubbelsteynlaan West 39) is een neoclassicistisch gebouw uit 1890 met een souterrain en een tot een torentje opgetrokken gepleisterd middenrisaliet. Het ontwerp is van A. van der Linden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0035.php> .

