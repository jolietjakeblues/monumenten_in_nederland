        min:hoofdstuk "Steden, dorpen, monumenten › Wijngaarden (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Wijngaarden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58488> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "39853" ;
        min:soort "inleiding" ;
        min:volgnummer 1971 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill796> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0185> ;
        schema:name "Wijngaarden (gemeente Graafstroom)"@nl ;
        schema:pageEnd "540" ;
        schema:pageStart "540" ;
        schema:pagination "540" ;
        schema:text "De Herv. kerk (Dorpsstraat 25) bestaat uit het recht gesloten gotische schip van een vroeg-15de-eeuwse kerk. In de dakruiter hangt een door Jan Moer gegoten klok (1547, hergoten 1917). Ter plaatse van het op een onbekend tijdstip gesloopte koor (opgegraven 1982) heeft men in 1856 een consistorie gebouwd. Bij de restauratie van 1981-'82 zijn de gevels ontpleisterd en is de consistoriekamer (‘Eben Haëzer’) herbouwd. Tot de kerkinventaris behoren een preekstoel en doophek (beide circa 1650) en een 17de-eeuws tiengebodenbord."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0185.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01972> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijngaarden (gemeente Graafstroom) – Scholen"@nl ;
        min:adres "Dorpsstraat 16-17",
            "Oosteinde 43-44" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Graafstroom" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijngaarden (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Wijngaarden" ;
        min:lemma "Scholen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1972 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0185> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "540" ;
        schema:pageStart "540" ;
        schema:pagination "540" ;
        schema:text "Scholen. De voorm. openbare lagere school (Dorpsstraat 16-17) is een markant neoclassicistisch eenlaagspand uit 1876 (gevelsteen) met twee lokalen. De ingebouwde onderwijzerswoning diende tevens als raadskamer. Tegenwoordig zijn in het gebouw de oudheidkamer en de historische vereniging ondergebracht. In het buitengebied van Wijngaarden ligt een tweeklassige voorm. openbare lagere school met onderwijzerswoning (Oosteinde 43-44) uit 1918."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0185.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01973> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijngaarden (gemeente Graafstroom) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 28" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Graafstroom" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijngaarden (gemeente Graafstroom)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Wijngaarden" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62251> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "29952" ;
        min:soort "lemma" ;
        min:volgnummer 1973 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0185> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "540" ;
        schema:pageStart "540" ;
        schema:pagination "540" ;
        schema:text "Boerderijen. Tot de oudere boerderijen van Wijngaarden behoren de mogelijk 18de-eeuwse boerderij Eeuwenoud (Dorpsstraat 28), met langgerekt dwars woonhuis en de stal als parallelle achtervleugel, en de vroeg-19de-eeuwse boerderij Westeinde 9 met dwars geplaatst woonhuis. De boerderij Westeinde 28 (eerste helft 19de eeuw) bestaat uit een tweelaags woongedeelte met aangebouwde zijbeuk en een hoge gepotdekselde dwarsdeelschuur. Andere voorbeelden van dwarsdeelboerderijen zijn Westeinde 18-19 (circa 1860) en Oosteinde 42 (circa 1870). Een rond venster in de geveltop hebben de langhuisboerderijen Westeinde 34 (1879) en Dorpsstraat 26-27 (circa 1885); mooie windveren zijn aangebracht bij Oosteinde 47 en Westeinde 32 (beide eind 19de eeuw). De langhuisboerderij Oosteinde 45 (1892) heeft een opvallende schoudergevel voorzien van lisenen en banden. Een voorbeeld van een moderne langhuisboerderij met mansardedak is Oosteinde 39 (1926)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0185.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01974> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woubrugge (gemeente Jacobswoude)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woubrugge (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Woubrugge" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1974 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0186> ;
        schema:name "Woubrugge (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "540" ;
        schema:pageStart "540" ;
        schema:pagination "540" ;
        schema:text "Ontginningsdorp, ontstaan in de middeleeuwen ter plaatse van het meer oostelijk gelegen Jacobswoude. Toen die ontginning later door vervening verdween, vormde zich een uitgestrekte lintbebouwing langs de mogelijk al in de 13de eeuw gegraven Woudwetering. Rond de Herv. kerk kwam in de 19de eeuw een kleine dorpskom tot ontwikkeling. Na de Tweede Wereldoorlog is Woubrugge aan de westzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01975> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woubrugge (gemeente Jacobswoude)"@nl ;
        min:adres "Comriekade 7",
            "Comriekade 9" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woubrugge (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Woubrugge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40147> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "39526" ;
        min:soort "inleiding" ;
        min:volgnummer 1975 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0186> ;
        schema:name "Woubrugge (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "540" ;
        schema:pagination "540-541" ;
        schema:text "De Herv. kerk (Comriekade 7) is een pseudo-kruiskerk met zowel aan de lange als de korte arm een driezijdige sluitingen. Naar ontwerp van Pieter Post kwam deze classicistische kerk in 1652-'53 tot stand met kenmerkende ingezwenkte steunberen, een houten ingangsportaal met bordes en een twaalfzijdige dakruiter met naaldspits. Daarin hangt een door François Hemony gegoten klok (1665). De in 1911 onder leiding van A. Mulder gerestaureerde kerk wordt binnen gedekt door een houten tongewelf met steekkappen. Tot de inventaris uit de bouwtijd behoren een preekstoel, herenbanken en een dooptuin naar ontwerp van Post. Het orgel is in 1794 gebouwd door Johannes Mitterreither. De pastorie (Comriekade 9) is een blokvormig herenhuis uit 1898 met neorenaissancedetails."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01976> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woubrugge (gemeente Jacobswoude)"@nl ;
        min:adres "Dr. A. Kuyperweg 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woubrugge (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Woubrugge" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1976 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0186> ;
        schema:name "Woubrugge (gemeente Jacobswoude)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "De Geref. kerk (Dr. A. Kuyperweg 1), een moderne zaalkerk met souterrain en opengewerkte dakruiter, is gebouwd in 1957 naar ontwerp van C. van der Bom ter plaatse van een in 1944 gesloopte voorganger uit 1896."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01977> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woubrugge (gemeente Jacobswoude) – Boerderijen"@nl ;
        min:adres "Boddens Hosangweg 112",
            "Vierambachtsweg 20" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woubrugge (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Woubrugge" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1977 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0186> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "Boerderijen. In 1856 gebouwd is de gepleisterde langhuisboerderij Bouwlust (Vierambachtsweg 20) met ingezwenkte lijstgevel. Het zomerhuis met stal heeft eveneens een afgeknotte ingezwenkte voorgevel. Andere voorbeelden van langhuisboerderijen zijn Boddens Hosangweg 116 (1828), met roedenberg en 19de-eeuwse houten schuur, de boerderij Boddens Hosangweg 39-41 (circa 1880), met zomerhuis voorzien van een klokgevel, en Hoeve Weltevrede (Boddens Hosangweg 112; circa 1925) met een villa-achtig woongedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01978> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woubrugge (gemeente Jacobswoude) – Woonhuizen"@nl ;
        min:adres "Boddens Hosangweg 84",
            "Kerkweg 64",
            "Van Hemessenkade 20" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Kaag en Braassem" ;
        min:gemeenteInBoek "Jacobswoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kaag_en_Braassem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woubrugge (gemeente Jacobswoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Woubrugge" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38009> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "509925" ;
        min:soort "lemma" ;
        min:volgnummer 1978 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill797> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0186> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text """Woonhuizen. Uit circa 1915 dateren het dubbele tweelaags huis Kerkstraat 14-16 en het dwarse tweelaags pand Comriekade 12-15. De villa Jacobswoude (Boddens Hosangweg 84) werd in 1929 gebouwd in cottagestijl met expressionistische elementen naar plannen van J. Rebel voor burgemeester J.E. Boddens Hosang. Voorbeelden van blokvormige zakelijk-expressionistische villa's zijn Kerkstraat 13 (circa 1930) en de dokterswoning 't Huis De Boe (Van Hemessenkade 20) uit 1931.

De Alg. begraafplaats (Kerkweg 64) heeft een uit 1933 daterende zaalvormige aula met driezijdige sluitingen en een opengewerkte zeskantige dakruiter."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01979> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        min:adres "Tweemanspolder 1734" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Zuidplas" ;
        min:gemeenteInBoek "Zevenhuizen-Moerkapelle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zuidplas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zevenhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1979 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0187> ;
        schema:name "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "Ontginningsdorp, ontstaan in de 13de eeuw aan een dijk langs de Rotte. Aan het einde van de middeleeuwen werd het dorp oostwaarts verplaatst. Nadat de veenplassen waren drooggemaakt (Tweemanspolder 1734; Eendrachtspolder 1753), werd het langgerekte dorp omgeven door een - nog aanwezige - gracht om inklinking van de bodem tegen te gaan. De droogmaking van de omvangrijke Zuidplaspolder aan de oostzijde volgde in 1828-'39. Na de Tweede Wereldoorlog heeft de glastuinbouw haar intrede in Zevenhuizen gedaan en is het dorp in oostelijke en zuidwestelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01980> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        min:adres "Dorpsstraat 170" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Zuidplas" ;
        min:gemeenteInBoek "Zevenhuizen-Moerkapelle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zuidplas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zevenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57979> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "40452" ;
        min:soort "inleiding" ;
        min:volgnummer 1980 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill798> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0187> ;
        schema:name "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "De Herv. kerk (Dorpsstraat 170) is een tweebeukige hallenkerk voorzien van een aangebouwde consistoriekamer en een toren van drie geledingen met haakse steunberen en ingesnoerde spits. De begin 16de eeuw gebouwde toren heeft een boogfries en een hoge spits (vernieuwd 1967) en bevat een door Joannes Ouderogge gegoten klok (1709). Het schip is na brand (1699) herbouwd in 1699-1701, waarbij delen van het oude muurwerk zijn behouden en de twee koorsluitingen zijn samengetrokken. De zuidbeuk heeft een lagere, smalle zijbeuk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01981> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Zuidplas" ;
        min:gemeenteInBoek "Zevenhuizen-Moerkapelle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zuidplas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zevenhuizen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1981 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0187> ;
        schema:name "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven die op een houten jukconstructie rusten, waarvan de stijlen begin 19de eeuw met gestuct metselwerk zijn omkleed tot ronde zuilen op een achtzijdig basement. Tot de inventaris behoren een preekstoel (circa 1600) met klankbordversiering (1702), een dooptuin, een koorhek met gesneden middenstuk en drie herenbanken met wapens (alle eerste helft 18de eeuw). Verder dateren twee eenvoudige bankenblokken en het houten portaal met daarboven een tiengebodenbord uit de 18de eeuw. Het orgel is vermoedelijk in 1835 door W. Beekes gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01982> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenhuizen (gemeente Zevenhuizen-Moerkapelle)"@nl ;
        min:adres "Dorpsstraat 139" ;
