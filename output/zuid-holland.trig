        schema:name "Windmolen"@nl ;
        schema:pageEnd "494" ;
        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Windmolen ‘De Korenaar’ (Molendijk 79) is een ronde grondzeiler met een met dakleer beklede kap. Deze in 1746 gebouwde korenmolen is in 1969-'71 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01787> a min:Passage,
            schema:CreativeWork ;
