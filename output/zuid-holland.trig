        min:kern "Leiderdorp" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1056 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0085> ;
        schema:name "Leiderdorp"@nl ;
        schema:pageEnd "332" ;
        schema:pageStart "332" ;
        schema:pagination "332" ;
        schema:text "Dijkdorp, ontstaan in de vroege middeleeuwen op de oeverwal van de Oude Rijn. Leiderdorp wordt voor het eerst vermeld tussen 1130 en 1157. Bij het beleg van Leiden in 1573-'74 bleef er weinig van het dorp over. Tot in de 20ste eeuw concentreerde de langgerekte bebouwing zich langs de Oude Rijn (Achthoven, Hoofdstraat) en vanaf 1930 volgde een uitbreiding van het lint in noordelijke richting. Na de Tweede Wereldoorlog is Leiderdorp een forenzengemeente geworden en is het aan Leiden vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01057> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leiderdorp"@nl ;
