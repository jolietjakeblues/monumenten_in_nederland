        min:adres "Irenelaan 23",
            "Julianalaan 3",
            "Piet Heinplein 13" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Zoetermeer" ;
        min:gemeenteInBoek "Zoetermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zoetermeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoetermeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Zoetermeer" ;
        min:lemma "Overige kerken" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1993 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0188> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "543" ;
        schema:pageStart "543" ;
        schema:pagination "543" ;
        schema:text "Overige kerken. Sobere zaalkerken in traditionalistische vormen (wederopbouw) zijn het gebouw van de Geref. Gem. Het Kompas (Piet Heinplein 13; 1955, D. Huurman) en de met klokkentoren ontworpen Adventskerk (Julianalaan 3; 1955, A. van Eck), nu in gebruik bij de Vereniging van Vrijz. Herv. en de Remonstrantse gemeente. De Oud Geref. Gemeentekerk (Irenelaan 23; N.Ch. Dekker & P. van der Sterre) dateert uit 1956. Opvallend is de kerk van Jezus Christus van de Heiligen der Laatste Dagen (Osylaan), een in 2002 in lichtgrijze steen gebouwde driebeukige tempel met gelede torenvormige opbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01994> a min:Passage,
