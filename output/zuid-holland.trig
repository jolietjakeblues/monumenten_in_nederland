        min:gemeenteInBoek "Schoonhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schoonhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonhoven" ;
        min:lemma "Begraafplaatsen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36293> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "33546" ;
        min:soort "lemma" ;
        min:volgnummer 1742 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0158> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "485" ;
        schema:pageStart "485" ;
        schema:pagination "485" ;
        schema:text "Begraafplaatsen. De in 1767 gestichte en in 1867 uitgebreide Isr. begraafplaats (Nes ong.) [31] werd ook gebruikt voor joden uit Lekkerkerk en omgeving. De Alg. begraafplaats (Wal 3-7) [32], aangelegd in 1829 op één van de oostelijke bastions, heeft een neoclassicistische hardstenen toegangspoort. Deze wordt geflankeerd door wit gepleisterde neoclassicistische paviljoens (gedeeltelijk vernieuwd 1857). Tegen het noordelijke paviljoen is de beheerderswoning (circa 1940) aangebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01743> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schoonhoven – Willige Langerak"@nl ;
        min:adres "De Montignylaan 18",
            "De Montignylaan 28",
            "Tiendweg 1" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Krimpenerwaard" ;
        min:gemeenteInBoek "Schoonhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schoonhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonhoven" ;
        min:lemma "Willige Langerak" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11019>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25783> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "33553",
            "33554" ;
        min:soort "lemma" ;
        min:volgnummer 1743 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0158> ;
        schema:name "Willige Langerak"@nl ;
        schema:pageEnd "486" ;
        schema:pageStart "485" ;
        schema:pagination "485-486" ;
        schema:text "Willige Langerak. Dit dorp ten oosten van Schoonhoven ontstond in de middeleeuwen op een donk. Via de Tiendweg is het verbonden met de boerderijen in de gelijknamige polder. De gemeente is in 1943 opgesplitst tussen Schoonhoven en Lopik (U). De Herv. kerk (De Montignylaan 18) is een gepleisterde zaalkerk voorzien van een toren van drie geledingen met ingesnoerde spits. Het onderste deel van de toren stamt vermoedelijk uit de late 13de eeuw. Een verbouwing en ophoging volgde in 1627 (gevelsteen). De kerk zelf heeft men in 1650 (sluitsteen) vernieuwd en in 1836 ingrijpend verbouwd. Tot de inventaris behoren een preekstoel en doophek (beide 1650), drie midden-17de-eeuwse herenbanken en een door L. van Dam & Zn. gebouwd orgel (1875). Het voorm. ambachtshuis of ‘Jachthuis’ (De Montignylaan 28) is een middenganghuis met in de kern een 18de-eeuws aangebouwd diep gedeelte met zadeldak. Een gedeelte van het pand was van 1923 tot 1942 als raadzaal in gebruik. Daarvóór diende een vertrek in de boerderij ‘Roosenburg’ (Tiendweg 1; circa 1890) als zodanig. Aan de rivierzijde van de Lekdijk Oost staat een peilschaalhuisje uit 1896."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01744> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schoonrewoerd (gemeente Leerdam)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schoonrewoerd (gemeente Leerdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonrewoerd" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1744 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0159> ;
        schema:name "Schoonrewoerd (gemeente Leerdam)"@nl ;
        schema:pageEnd "486" ;
        schema:pageStart "486" ;
        schema:pagination "486" ;
        schema:text "Kerkdorp, ontstaan in de 13de eeuw op een zanderige stroomrug en bij de haaks daarover lopende weg Leerdam-Everdingen. Bij de kerk is de Dorpsstraat van oudsher al breder en met bomen beplant. Na de Tweede Wereldoorlog is het dorp aan weerszijden van de Dorpsstraat uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01745> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schoonrewoerd (gemeente Leerdam)"@nl ;
        min:adres "Dorpsstraat 31",
            "Dorpsstraat 35" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Vijfheerenlanden" ;
        min:gemeenteInBoek "Leerdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vijfheerenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schoonrewoerd (gemeente Leerdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Schoonrewoerd" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1745 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill711> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0159> ;
        schema:name "Schoonrewoerd (gemeente Leerdam)"@nl ;
        schema:pageEnd "486" ;
        schema:pageStart "486" ;
        schema:pagination "486" ;
        schema:text "De Herv. kerk (Dorpsstraat 35) is een eenbeukige kerk met driezijdig gesloten koor en een robuuste toren van drie geledingen met balustrade en tentdak. Deze laat-romaanse toren met lisenen en spaarnissen met rondboogfriezen verrees in de 14de eeuw (toegang 17de eeuw). Van de kerk zelf resteert weinig ouder materiaal na oorlogsschade (1672) en een zware storm (1674). Het rond 1850 aangebouwde neoclassicistische portaal bevat een gevelsteen uit 1701. Restauraties zijn uitgevoerd in 1955 (kerk) en 1965 (toren, ontpleistering gevels). Tot de inventaris behoren een preekstoel (tweede kwart 17de eeuw) en drie koperen kronen (18de eeuw). De kerkenraadskamer werd in 1874 opgetrokken tussen de toren en de pastorie (Dorpsstraat 31), een tweelaags herenhuis uit 1862. Vlakbij staat de bakstenen dorpspomp (1908) met ingezwenkt tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0159.php> .

