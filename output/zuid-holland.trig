        schema:name "Weegbruggen"@nl ;
        schema:pageEnd "501" ;
        schema:pageStart "500" ;
        schema:pagination "500-501" ;
        schema:text "Weegbruggen. Bij de westelijke landbouwhaven en bij de ‘Groote Haven’ staat een weeghuisje met weegbrug, respectievelijk uit circa 1910 en circa 1950."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01830> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tiengemeten (gemeente Korendijk) – Nieuwendijk"@nl ;
        min:adres "Dwarsweg 6",
            "Nieuwendijk 1",
            "Nieuwendijk 8" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeenteInBoek "Korendijk" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tiengemeten (gemeente Korendijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Tiengemeten" ;
        min:lemma "Nieuwendijk" ;
        min:provincie "Zuid-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0171> ;
        schema:name "Nieuwendijk"@nl ;
        schema:pageEnd "501" ;
        schema:pageStart "501" ;
        schema:pagination "501" ;
        schema:text """Nieuwendijk. Dit dijkdorp ten noorden van Tiengemeten ligt in de Eendrachtspolder (1653).

Boerderijen. De hekpijlers in Lodewijk XV-stijl geven de datering - 1780 - van de boerderij ‘De Eendracht’ (Nieuwendijk 8), een zijlangsdeelboerderij met haaks uitgebouwde zijkamers. Een modernere variant is de zijlangsdeelboerderij ‘Gelriahoeve’ (Dwarsweg 6) uit circa 1875. Aan de monding van de veerhaven staat een lichtbaak (bij Nieuwendijk 1) uit circa 1900 (gerestaureerd 1989), een opengewerkte ijzeren constructie met trap, omgang en lichthuis."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01831> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenburg"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Katwijk" ;
        min:gemeenteInBoek "Valkenburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Katwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenburg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Valkenburg" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1831 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0172> ;
        schema:name "Valkenburg"@nl ;
        schema:pageEnd "501" ;
        schema:pageStart "501" ;
        schema:pagination "501" ;
        schema:text "Wegdorp, ontstaan op een oeverwal langs de Oude Rijn. In de Romeinse tijd lag hier een castellum. De in 866 voor het eerst vermelde kerk werd gebouwd op een terp. De bebouwing concentreerde zich langs de Hoofdstraat. Het dorp en het in 1938-'39 aan de zuidzijde aangelegde marinevliegveld werden bij een bombardement op 10 mei 1940 zwaar beschadigd. De herbouw van het vliegveld vond plaats in 1942, het dorp volgde later."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0172.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01832> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenburg"@nl ;
