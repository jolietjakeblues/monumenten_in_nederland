        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46547> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "30569" ;
        min:soort "inleiding" ;
        min:volgnummer 1280 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill533> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0114> ;
        schema:name "Nieuwpoort (gemeente Liesveld)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "De Herv. kerk (Binnenhaven 21) is een driebeukige pseudo-basilicale kerk met vijfzijdig gesloten koor en kooromgang. De oorspronkelijk in 1420 gebouwde kerk werd waarschijnlijk na een brand in 1524 herbouwd. In 1774 heeft men de toren en een deel van het schip gesloopt en vervangen door een nieuwe westgevel met achtzijdige houten dakruiter. Daarin hangt een door Henricus Meurs gegoten klok (1605). De kerk onderging reparaties in 1842 en een restauratie in 1972-'74."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01281> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwpoort (gemeente Liesveld)"@nl ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Molenlanden" ;
        min:gemeenteInBoek "Liesveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Molenlanden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwpoort (gemeente Liesveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Nieuwpoort" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1281 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0114> ;
        schema:name "Nieuwpoort (gemeente Liesveld)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven met trekbalken en is voorzien van spitse smalle scheibogen met blindnissen erboven. Tot de inventaris behoren een herenbank (1652), doophek (tweede helft 17de eeuw) en preekstoel (1842). Verder bevat de kerk een tekst- en een rouwbord (1603, 1679) en verscheidene grafzerken (17de-begin 18de eeuw). Bij de kerk staan twee maniëristische hardstenen stoeppalen met wapenschildjes (circa 1620)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01282> a min:Passage,
