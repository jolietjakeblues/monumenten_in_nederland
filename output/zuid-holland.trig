        min:gemeenteInBoek "Bergambacht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Krimpenerwaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berkenwoude (gemeente Bergambacht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Berkenwoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26611>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54221> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "9351",
            "9352" ;
        min:soort "inleiding" ;
        min:volgnummer 339 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill99> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0020> ;
        schema:name "Berkenwoude (gemeente Bergambacht)"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "89" ;
        schema:pagination "89-90" ;
        schema:text "De Herv. kerk (bij Dorpsstraat 18), gelegen op een verhoogd terrein, is een zaalkerk met een deels ingebouwde forse toren en een ingesnoerde spits. De kort na 1513 opgetrokken toren is voorzien van haakse steunberen en metseltekens met Andreaskruisen bij de onderste geleding en blindnissen bij de twee bovenste geledingen. In de dubbele eikenhouten klokkenstoel hangt een door Johan Nicolaus Derck gegoten klok (1755). De bijbehorende kerk bevat delen van de kap en het tongewelf uit circa 1512 (d). Na een blikseminslag in 1732 vond een algehele restauratie plaats en in 1833 volgde een ingrijpende verbouwing, waarbij de kerk werd beklampt en voorzien van rondboogvensters en een nieuwe consistorie. De toren is gerestaureerd in 1949-'50, de kerk in 1972-'74. Tot de inventaris behoren een zeshoekige preekstoel met klankbord (1686), een doophek (circa 1686) en een door L. van Dam & Zn. gebouwd orgel (1896)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0020.php> .

