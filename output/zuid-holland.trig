        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Herkingen (gemeente Dirksland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Herkingen" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0061> ;
        schema:name "Herkingen (gemeente Dirksland)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Dijkdorp aan de Grevelingen, ontstaan na de herindijking van de polder Oud-Herkingen (1483). In 1511 kwam het dorp weer onder water te staan, waarna een definitieve herindijking volgde in 1604. De dorpsbebouwing ontwikkelde zich bij een kruising van dijken. Bij de Watersnoodramp in 1953 leed Herkingen veel schade. Aan de westzijde van het dorp ligt een bungalowpark."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0061.php> .

