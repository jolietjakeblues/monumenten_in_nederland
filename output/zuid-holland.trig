        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gouda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Gouda" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39571> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "16836" ;
        min:soort "inleiding" ;
        min:volgnummer 631 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/afbeelding/sten009monu10ill246> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0043> ;
        schema:name "Gouda"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De Barbaratoren (Kuiperstraat 42) [6] behoorde bij de in 1505 als gasthuis gestichte Barbarakapel (afgebroken 1581). Deze in 1635 herstelde en in 1988 gerestaureerde laat-gotische toren heeft drie geledingen met natuurstenen hoekblokken en spitsboognissen met bakstenen traceringen. De vierzijdige spits is voorzien van houten wijzerplaten (1635)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/00632> a min:Passage,
