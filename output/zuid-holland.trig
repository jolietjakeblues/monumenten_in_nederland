        min:volgnummer 315 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0016> ;
        schema:name "Benthuizen (gemeente Rijnwoude)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Het voorm. raadhuis (Secretaris Runsinkbrink 1) is een traditionalistisch tweelaags pand met zadeldak en forse schoorstenen, gebouwd in 1955 naar ontwerp van R.H. Fledderus. De wapensteen is gemaakt door C. van Kralingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0016.php> .

