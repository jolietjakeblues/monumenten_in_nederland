        min:gemeenteInBoek "Maassluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maassluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maassluis" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Maassluis" ;
        min:provincie "Zuid-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1134 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0094> ;
        schema:name "Maassluis"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text "De voorm. R.K. kerk St.-Petrus en St.-Paulus (Zuidvliet 140) is een in 1787-'88 opgetrokken eenbeukige schuilkerk met steunberen en rondboogvensters. De vierkante dakruiter heeft men in 1826 toegevoegd. In 1962 werd het interieur door brand beschadigd, waarna in 1983-'84 de restauratie en ombouw tot theater en cultureel centrum volgde. Aan de voorzijde werd in 1790 de tweelaagse pastorie aangebouwd met een lijstgevel en een omlijste ingang in Lodewijk XVI-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01135> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maassluis – Overige kerken"@nl ;
        min:adres "G.A. Brederolaan 49",
            "Hoogstraat 1",
            "Hoogstraat 11",
            "Lange Boonestraat 5",
            "Zuiddijk 11" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
        min:gemeente "Maassluis" ;
        min:gemeenteInBoek "Maassluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maassluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maassluis" ;
