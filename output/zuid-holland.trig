        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0123> ;
        schema:name "Oegstgeest"@nl ;
        schema:pageEnd "382" ;
        schema:pageStart "382" ;
        schema:pagination "382" ;
        schema:text "De voorm. pastorie (Rhijngeesterstraatweg 45) is een herenhuis uit 1772 in sobere classicistische stijl. Aan de zuidzijde staat de nieuwe pastorie uit 1901. Het R.K. patronaatshuis ‘Willibrord’ (Rhijngeesterstraatweg 41-43; 1922) is een expressionistisch ontwerp van J.A. van der Laan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0123.php> .

