        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De Geref. kerk (Dr. Stapenseastraat 36) is een zaalkerk uit 1912 voorzien van een opengewerkt geveltorentje met spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01077> a min:Passage,
            schema:CreativeWork ;
