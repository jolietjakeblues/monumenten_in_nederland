        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zuid-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wassenaar" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01> ;
        min:kern "Wassenaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39581> ;
        min:provincie "Zuid-Holland" ;
        min:rijksmonumentnummer "38402" ;
        min:soort "inleiding" ;
        min:volgnummer 1933 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0182> ;
        schema:name "Wassenaar"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "Op het kerkhof met hekwerk (1888) bevinden zich een vroeg-19de-eeuws grafmonument voor de familie Van Wassenaer en een grafzerk met marmeren inleg voor S. Wondt († 1866). Het van oorsprong 15de-eeuwse adellijke huis van Floris van Cralingen dient sinds 1612 als pastorie (Schoolstraat 2). Dit wit gepleisterde herenhuis, verbouwd in 1796 en in 1856 met een verdieping verhoogd, heeft nog overwelfde kelders en samengestelde balklagen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01934> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wassenaar"@nl ;
        min:adres "Kerkstraat 77" ;
        min:deel "Monumenten in Nederland. Zuid-Holland" ;
