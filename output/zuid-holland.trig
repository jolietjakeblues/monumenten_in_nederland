        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0154> ;
        schema:name "Koningshuis"@nl ;
        schema:pageEnd "457" ;
        schema:pageStart "457" ;
        schema:pagination "457" ;
        schema:text "Koningshuis (Wilhelminalaan 13). Deze rond 1628 aangelegde buitenplaats heette oorspronkelijk Ter Nieuwburgh. Het op een omgracht terrein gelegen statige buitenhuis heeft bij een verbouwing in de 18de eeuw het huidige aanzicht gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/passage/01666> a min:Passage,
