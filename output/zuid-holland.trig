        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu10_01/hoofdstuk/0080> ;
        schema:name "Langeraar (gemeente Ter Aar)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Het voorm. R.K. St.-Anthoniusgesticht (Langeraarseweg 82) is een tweelaags dwars pand met een tot topgevel opgetrokken middengedeelte en een driezijdige uitbouw met trapgevel. Het werd in 1911-'12 gebouwd als liefdesgesticht annex meisjesschool naar ontwerp van C.L.M. Robbers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0080.php> .

