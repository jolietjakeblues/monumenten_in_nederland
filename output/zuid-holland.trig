        schema:pageEnd "373" ;
        schema:pageStart "373" ;
        schema:pagination "373" ;
        schema:text "De (Geref.) Buurtkerk (Hoofdstraat 10), een driebeukige kerk in rationalistische stijl met klokkentoren, dateert uit 1899."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu10_01/sten009monu10_01_0118.php> .

