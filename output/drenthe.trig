        schema:name "Ruinen (gemeente De Wolden)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De pastorie (Kloosterstraat 2) dateert uit circa 1840, maar heeft twee middeleeuwse kelders met gewelven. Deze kelders zijn restanten van het benedictijnenklooster."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00714> a min:Passage,
            schema:CreativeWork ;
