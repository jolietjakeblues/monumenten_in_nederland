        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Woonhuizen. De voorm. baanwerkerswoning Kampsweg 25 is in 1903 gebouwd aan de spoorlijn Zwolle-Groningen. De woningen Kampsweg 5-9 en 17-21 met expressionistische elementen dateren uit circa 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00873> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijster (gemeente Midden-Drenthe) – Boerderijen"@nl ;
        min:adres "Meester Haddersstraat 2" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijster (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Wijster" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 873 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0103> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text """Boerderijen. De fraaie 18de-eeuwse hallenhuisboerderij Beilerweg 2 heeft een rieten dak, een onderschoer en een aangebouwde houten bijschuur met rieten dak en vlechtwerk van geknoopt stro. De met riet gedekte kleine dwarsdeelboerderij Bruntingerweg 1 dateert uit circa 1860. De boerderij Drijberseweg 46 heeft een met riet gedekte schuur en een dwars geplaatst woonhuis uit circa 1929. Oosterse Veldweg 1 en Oosterse Veldweg 2 zijn moderne ontginningsboerderijen met zijlangsdeel uit 1938. Deze boerderijen betrokken hun meststoffen van het nabij gelegen composteringsbedrijf VAM. Dit geldt ook voor de in 1939 opgetrokken moderne kop-rompboerderijen Vamweg 6 en Vamweg 8.

Het café-restaurant ‘Café Pot’ (Meester Haddersstraat 2), een fors hoekpand met afgewolfd zadeldak en een deels hoger opgetrokken gevelpartij, dateert uit circa 1929."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00874> a min:Passage,
