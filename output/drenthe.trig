        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0105> ;
        schema:name "Zeyen (gemeente Tynaarlo)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Esdorp zonder kerk, ontstaan in de middeleeuwen op de hogere zandgronden van het Drentse plateau. Het dorp heeft een zeer grote rechthoekige brink. Na de Tweede Wereldoorlog ontstond aan de zuidzijde van het dorp enige bebouwing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00882> a min:Passage,
