        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dwingeloo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32320> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "14227" ;
        min:soort "inleiding" ;
        min:volgnummer 362 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0027> ;
        schema:name "Dwingeloo (gemeente Westerveld)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "Het voorm. schultehuis (Brink 12) is een gepleisterd dwars eenlaagspand met puntgevel. Het in 1969 gerestaureerde gebouw heeft een 19de-eeuws uiterlijk maar stamt in de kern uit de tweede helft van de 17de eeuw. De deuromlijsting dateert uit de late 18de eeuw, de winkelpui uit circa 1920. In het interieur bevinden zich stucwerk, deuren en een betimmering in eenvoudige Lodewijk XIV-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00363> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dwingeloo (gemeente Westerveld)"@nl ;
        min:adres "Brink 1" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dwingeloo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25260>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35087> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "507324",
            "509322" ;
        min:soort "inleiding" ;
        min:volgnummer 363 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0027> ;
        schema:name "Dwingeloo (gemeente Westerveld)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "Het voorm. raadhuis (Brink 1), een tweelaags gebouw met zadeldak en dakruiter, werd in 1939 gebouwd naar een traditionalistisch ontwerp van A. Baart. In het trappenhuis en de raadszaal zijn gebrandschilderde ramen van glazenier Le Nobel aangebracht, waarop de vier havezaten van Dwingeloo, scènes uit het boerenleven, en de familiewapens van de diverse bewoners van de voorm. havezate Batinghe zijn afgebeeld. De aanbouw dateert uit 1983."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00364> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dwingeloo (gemeente Westerveld)"@nl ;
        min:adres "Heuvelenweg 29" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dwingeloo" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 364 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0027> ;
        schema:name "Dwingeloo (gemeente Westerveld)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "De voorm. openbare lagere school ‘De Vogelsang’ (Heuvelenweg 29) werd rond 1935 in zakelijk-expressionistische vormen gebouwd als een tweeklassige middengangschool met een tot topgevel opgetrokken middenrisaliet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00365> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dwingeloo (gemeente Westerveld) – Westrup"@nl ;
        min:adres "Entingheweg 20" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dwingeloo" ;
        min:lemma "Westrup" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31130> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "14231" ;
        min:soort "lemma" ;
        min:volgnummer 365 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0027> ;
        schema:name "Westrup"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "Westrup (Entingheweg 20). Deze voorm. havezate is een gepleisterd herenhuis met omlijste ingang en schilddak. Het oorspronkelijk rond 1600 door Reint van den Clooster gebouwde eenlaags huis werd kort na 1740 door Cornelis van Dongen tot Oldengaerde vergroot. Het huidige neoclassicistische uiterlijk kwam in 1870 tot stand, toen het huis in opdracht van notaris W.O. Servatius een verdieping kreeg. In 1984-'86 is het huis gerestaureerd en heeft men de naastgelegen kantoorruimte gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0027.php> .

