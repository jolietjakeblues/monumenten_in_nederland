        min:volgnummer 889 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0106> ;
        schema:name "Zorgvlied (gemeente Westerveld)"@nl ;
        schema:pageEnd "209" ;
        schema:pageStart "209" ;
        schema:pagination "209" ;
        schema:text "Het naast de kerk gelegen gepleisterde eenlaagspand Dorpsstraat 33-39 dateert uit 1823 en behoorde tot het landbouwinstituut; het is in 1978 tot bejaardenwoningen verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00890> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zorgvlied (gemeente Westerveld) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 40",
            "Verwersweg 30",
