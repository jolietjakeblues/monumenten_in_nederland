        min:soort "lemma" ;
        min:volgnummer 752 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0083> ;
        schema:name "Achterste Erm"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Achterste Erm. Dit esdorp ten zuidoosten van Sleen is ontstaan in de middeleeuwen aan de zuidzijde van de Grote Ermeres. Boerderijen. Een 18de-eeuwse oorsprong hebben enkele in de 19de eeuw gewijzigde hallenhuisboerderijen met langsdeel, zoals Achterste Erm 13 en Achterste Erm 2 (met houten bijschuur). De laatstgenoemde boerderij is blijkens de jaartalankers in 1851 gewijzigd. Achterste Erm 18 is een krimpenboerderij met langsdeel uit 1907."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00753> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Smilde (gemeente Midden-Drenthe)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Smilde (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Smilde" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 753 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill266> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0084> ;
        schema:name "Smilde (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Langgerekt kanaaldorp, ontstaan rond 1770 na de aanleg van de Drentsche Hoofdvaart in 1767-'80, waardoor het noordelijk deel van het Smilderveen kon worden ontgonnen. Vanuit Assen werd langs het kanaal de nederzetting Kloosterveen gesticht, die later Smilde ging heten. De hier in 1780 gestichte kerk werd ook gebruikt door de inwoners van de vrijwel gelijktijdig vanuit Hijken langs het kanaal gestichte nederzetting Hijkersmilde. Met de stichting van Bovensmilde in de eerste helft van de 19de eeuw was nagenoeg het gehele gebied vergraven. Langs de Drentsche Hoofdvaart had zich een ononderbroken bebouwingslint gevormd van hoofdzakelijk boerderijen, landarbeiders- en vervenerswoningen. Smilde was omstreeks 1850 het grootste dorp. Het zwaartepunt van de dorpsbebouwing lag aan de oostzijde van de vaart. De in 1780 langs het kanaal aangelegde weg Meppel-Assen (verhard rond 1835) gaat ter hoogte van de Veenhoopsbrug over van de west- naar de oostoever. In de 19de eeuw vond een aanzienlijke verdichting van de bebouwing plaats met burgerwoningen, villa's en allerhande dorpsvoorzieningen. Daarnaast waren er industriële ontwikkelingen. In 1915-'16 werden door de Nederlandse Tramweg Maatschappij spoorlijnen aangelegd naar Assen en Meppel met een station in Hijkersmilde. Na de Tweede Wereldoorlog is Smilde aan de oostzijde verder uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00754> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Smilde (gemeente Midden-Drenthe)"@nl ;
        min:adres "Veenhoopsweg 13" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
