        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De voorm. synagoge (Hoofdweg 120) is een sober dwars pand met afgewolfd zadeldak, gebouwd in 1839 en in 1893 naar ontwerp van W.C. Metzelaar. Het is later ingrijpend verbouwd en uitgebreid om te dienen tot hoofdkantoor van de directie van de kolonie Veenhuizen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Kerklaan 6" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29531> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "422057" ;
        min:soort "inleiding" ;
        min:volgnummer 795 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill280> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "191" ;
        schema:pagination "191-192" ;
        schema:text "De R.K. St.-Hiëronymus Aemilianuskerk (Kerklaan 6) is een neogotische zaalkerk met driezijdig gesloten apsis, steunberen en een kleine dakruiter. De kerk werd in 1891-'93 gebouwd naar plannen van W.C. Metzelaar ter vervanging van een kleinere voorganger uit 1826. De hoofdingang heeft een gemetselde omlijsting. Tegen de noordgevel en de zuidgevel zijn portalen gebouwd en aan de achterzijde ontstond een consistorie. De kerk is in 1998-'99 gerestaureerd. Het schip wordt gedekt door een houten spantconstructie. Het gestukadoord gewelf van de apsis is in 1948 beschilderd door A.C.E. Gantzert. Tot de inventaris behoren een door T.J. Robson gebouwd neogotisch orgel (1843) en een uit het Chigago Theater te Tilburg overgebracht bioscooporgel (1922)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

