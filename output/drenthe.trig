        min:adres "Ten Have 21" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wapse (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Wapse" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 839 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0096> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Boerderijen. Voorbeelden van 19de-eeuwse hallenhuisboerderijen zijn Soerte 3-3a (circa 1860), met dwarsdeel en hoekbaander, en Ten Have 9 (circa 1865). Een ingezwenkte lijstgevel hebben de rond 1900 opgetrokken hallenhuisboerderijen Ten Have 11, met twee dwarsdelen, en Ten Darperweg 53. Uit dezelfde tijd is de boerderij Ten Have 7 met langsdeel en terzijde gesitueerd dwars voorhuis. Andere voorbeelden van moderne boerderijen zijn De Veldhof (Ten Have 21; circa 1910), met twee dwarsdelen, en Ten Darperweg 112 (circa 1920), uitgevoerd in witte en rode kalkzandsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00840> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wapse (gemeente Westerveld) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 84" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wapse (gemeente Westerveld)" ;
