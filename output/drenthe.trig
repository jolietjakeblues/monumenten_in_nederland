        schema:name "Gasselternijveen (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De pastorie (Vaart 1) dateert uit 1828 en is in 1908 verbouwd. Het voorm. catechisatielokaal (Vaart 3) is een eenlaags ‘leerkamer’ met rondboogvensters en geschulpte windveren, gebouwd in 1927 en uitgebreid in 1891."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00467> a min:Passage,
            schema:CreativeWork ;
