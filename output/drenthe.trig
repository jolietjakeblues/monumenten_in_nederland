        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Weerdinge (gemeente Emmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Nieuw-Weerdinge" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 608 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill215> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0062> ;
        schema:name "Nieuw-Weerdinge (gemeente Emmen)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Langgerekt kanaaldorp, gesticht in 1872. De Groningse vervener P. Lindeman begon met de aanleg van de Weerdingermond, die vanuit het Ter Apelerkanaal doorliep tot de Drentse grens en vandaar westwaarts als hoofdkanaal A of Weerdingerkanaal. Het veenkoloniale dorp had oorspronkelijk twee bebouwingskernen en kreeg in 1902 de naam Nieuw-Weerdinge. Het westelijke deel van het hoofdkanaal is in de jaren zestig gedempt, evenals het kanaal de Tramwijk ter hoogte van de westelijk kern. Bij de oostelijke dorpskern is na de Tweede Wereldoorlog een uitbreidingswijk ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00609> a min:Passage,
            schema:CreativeWork ;
