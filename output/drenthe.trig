        min:hoofdstuk "Steden, dorpen, monumenten › Tynaarlo (gemeente Tynaarlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Tynaarlo" ;
        min:lemma "Hunebed" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 774 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0087> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "Hunebed. Ten oosten van Tynaarlo, gelegen aan de Hunebedstraat, bevindt zich hunebed D6 dat bestaat uit acht draag- en drie dekstenen. Het is een van de weinige hunebedden waarvan alle dekstenen nog op hun oorspronkelijke plaats liggen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00775> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tynaarlo (gemeente Tynaarlo) – Oudemolen"@nl ;
        min:adres "Hoofdweg 107",
            "Linthorst Homanweg 1",
            "Molensteeg 8" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Tynaarlo" ;
        min:gemeenteInBoek "Tynaarlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tynaarlo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tynaarlo (gemeente Tynaarlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Tynaarlo" ;
        min:lemma "Oudemolen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 775 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill272> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0087> ;
        schema:name "Oudemolen"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "187" ;
        schema:pagination "187-188" ;
        schema:text "Oudemolen. Kleine esnederzetting ten zuidoosten van Tynaarlo. Windmolen ‘De Zwaluw’ (Molensteeg 8), een achtkantige grondzeiler met gemetselde veldmuren en een met riet beklede romp en kap, werd in 1837 gebouwd door de molenmakers L. Reinds en B. Sluter ter vervanging van een standerdmolen. In 1951 heeft men deze korenmolen gerestaureerd. Boerderijen. ‘Huize den Dollard’ (Linthorst Homanweg 1) is een krimpenboerderij met lage zaadzolder, opgetrokken in 1903 met gele steen in de strekken boven de vensters. Hoofdweg 118, een kop-rompboerderij annex café uit 1912, heeft een sobere neorenaissance-detaillering. De voorm. onderwijzerswoning (Hoofdweg 107) bij de inmiddels vernieuwde school, dateert uit circa 1910. Het is een onderwijzerswoning van het type dat door J. van Houten is ontwikkeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00776> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tynaarlo (gemeente Tynaarlo) – Taarlo"@nl ;
        min:adres "Hoofdweg 205" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Tynaarlo" ;
        min:gemeenteInBoek "Tynaarlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tynaarlo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tynaarlo (gemeente Tynaarlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Tynaarlo" ;
        min:lemma "Taarlo" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 776 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0087> ;
        schema:name "Taarlo"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Taarlo. Dit esdorp ten zuiden van Tynaarlo heeft een fraaie met bomen beplante driezijdige brink met dobbe en een driezijdige weilandbrink. Boerderijen. De rond 1800 gebouwde, met riet gedekte, boerderij Dorpsweg 6 heeft bij het woonhuisgedeelte een smallere, uitgebouwde eindkamer en aan de achterzijde een aangebouwde houten bijschuur. ‘Hoeve Hofsteenge’ (Hoofdweg 205) is een hallenhuisboerderij uit 1860 met inrijdeur in de voorgevel. Van hetzelfde type is de boerderij Brinkweg 1 uit 1888. Voorbeelden van krimpenboerderijen zijn Dorpsweg 4 (1857) en Hoofdweg 212 (1914). De in 1919 gebouwde boerderij Hoofdweg 210 heeft als woonhuisgedeelte een dwars geplaatst middenganghuis met een hoger opgetrokken en door pinakels bekroonde middenpartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00777> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Uffelte (gemeente Westerveld)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Uffelte (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Uffelte" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 777 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0088> ;
        schema:name "Uffelte (gemeente Westerveld)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Esdorp, ontstaan op een zandrug en voor het eerst vermeld in 1040. Vanaf 1048 was het lange tijd in bezit van het kapittel van St. Pieter te Utrecht. Het dorp heeft twee grote essen - de Noordesch en de Westeres - en aan de Dorpsstraat een brink. Vanaf circa 1850 is Uffelte met name in de richting van en langs de Drentsche Hoofdvaart en de daarlangs lopende rijksweg Meppel-Assen uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00778> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Uffelte (gemeente Westerveld)"@nl ;
        min:adres "Schoolstraat 5" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
