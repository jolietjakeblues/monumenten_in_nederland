        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Boerderijen. De krimpenboerderij Bonnerveen 52 is rond 1900 opgetrokken door de gebroeders Bartelds. Uit 1913 dateren de moderne krimpenboerderijen Bonnerveen 37 en Bonnerveen 56."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00488> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gieterveen (gemeente Aa en Hunze) – Windmolen"@nl ;
        min:adres "Broek 62" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gieterveen (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Gieterveen" ;
        min:lemma "Windmolen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 488 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0043> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text """Windmolen ‘De Eendracht’ (Broek 62) is een stellingmolen met achtkantige gemetselde onderbouw, ronde gemetselde romp en een met dakleer beklede kap. De molen werd in 1877 gebouwd door H. Wiertsema met gebruik van een uit Nieuw-Buinen afkomstige molen. De oorspronkelijke achtkantige romp brandde in 1904 af, waarna C. Bremer de molen herbouwde als ronde stenen stellingmolen. De laatste restauratie is uitgevoerd in 1976.

De Alg. begraafplaats (Broek ong.) is midden 19de eeuw gesticht. Vermeldenswaardige graftekens zijn de afgeknotte obelisk op postament voor J.R. Groenwold († 1917), vervaardigd door H. Hoekzema, en het vergelijkbare grafteken voor H. Meijering († 1940), door D. Kalk en R. Schuiling."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00489> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grolloo (gemeente Aa en Hunze)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
