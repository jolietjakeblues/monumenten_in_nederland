        min:volgnummer 796 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De pastorie (Kerklaan 8) is een wit gepleisterd tweelaags pand uit 1908, uitgevoerd met afgewolfd zadeldak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00797> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Oude Gracht 15-27" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75482> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "479225" ;
        min:soort "inleiding" ;
        min:volgnummer 797 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Het voorm. Tweede Gesticht (Oude Gracht 15-27) is het oudste nog bestaande gestichtgebouw. Dit in 1825 door H. Wind ontworpen carré-vormige en nog deels omgrachte complex heeft lange eenlaags vleugels met afgeplat zadeldak. De hoofdingang aan de zuidzijde wordt gevormd door een poort voorzien van een sluitsteen met het bouwjaar en de naam W. Visser (Directeur Koloniën). Boven de poort bevindt zich een dakruiter met wijzerplaat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00798> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 798 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Omstreeks 1900 heeft men het Tweede Gesticht verbouwd tot werkgesticht met enkel dagopvang nadat aan de Meidoornlaan de nieuwe Rijkswerkinrichting Tweede Gesticht met detentie was gerealiseerd. In 1928 werd de oostzijde van het gebouw gesloopt en vervangen door een garage. Rond die tijd is een deel van de omgrachting gedempt. Bij de hoofdentree staat een gedeeltelijk gereconstrueerde klokkenstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00799> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Oude Gracht 30",
            "Oude Gracht 32" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
