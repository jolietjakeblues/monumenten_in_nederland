        schema:pageEnd "88" ;
        schema:pageStart "88" ;
        schema:pagination "88" ;
        schema:text "De Baptistenkerk (Aleida Kramerstraat 9) is een zaalgebouw met aangrenzende woning. De kerk heeft zijn huidige vorm gekregen bij een verbouwing in 1957 naar ontwerp van H. Bennink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

