        min:soort "inleiding" ;
        min:volgnummer 833 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0095> ;
        schema:name "Wachtum (gemeente Coevorden)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Esdorp zonder kerk, ontstaan in de vroege middeleeuwen op een zandrug ten westen van het Drostendiep. Het dorp heeft aan de westzijde enkele essen en bij de splitsing Westereind/D'Olde Hoek een kleine driehoekige brink. De in de 19de eeuw aan het Middendorp tot ontwikkeling gekomen wegdorp-achtige bebouwing is vanaf het eind van die eeuw geleidelijk aan het oude dorp vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00834> a min:Passage,
            schema:CreativeWork ;
