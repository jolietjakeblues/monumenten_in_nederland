        min:volgnummer 737 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill262> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0082> ;
        schema:name "Schoonoord (gemeente Coevorden)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "181" ;
        schema:pagination "181-182" ;
        schema:text "De Herv. kerk (Kerklaan 15) is een dwars geplaatste, deels gepleisterde neoclassicistische zaalkerk uit 1866 met opengewerkte dakruiter en een hoger opgaand middenrisaliet met fronton. Rond 1950 is het fronton gewijzigd; de huidige dakruiter is in 1976 geplaatst. Tot de inventaris behoort een preekstoel uit de bouwtijd. De kosterswoning (Kerklaan 16) dateert uit 1929."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00738> a min:Passage,
