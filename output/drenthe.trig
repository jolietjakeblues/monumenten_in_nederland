        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "De voorm. synagoge (Zuiderstraat 1) is een eenvoudig zaalgebouw uit 1884 met afgewolfd zadeldak en rondboogvensters. Boven de ingang zit een onleesbaar geworden gevelsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0107.php> .

