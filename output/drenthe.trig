        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Annerveensche-Kanaal (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Annerveensche-Kanaal" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 216 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill66> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0011> ;
        schema:name "Annerveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "64" ;
        schema:pagination "64-65" ;
        schema:text "Langgerekt kanaaldorp, ontstaan in de 18de eeuw. In 1764 begon de Annerveensche Heeren Compagnie de vervening van het gebied, met de landmeter Lambartus Grevijlink als initiator. In 1768 werd met de stad Groningen een overeenkomst gesloten voor de afvoer van de turf via een aansluiting op het Kieldiep. Evenwijdig aan de provinciegrens met Groningen groef men in 1771-'75 het Grevelinkskanaal. Het veenkoloniale dorp, oorspronkelijk Nieuw-Annerveen genoemd, gaat aan de zuidzijde over in de bebouwing langs het Eexterveensche kanaal richting Bareveld. Rond 1850 is men gestopt met de vervening. Het beschermde Annerveenschekanaal is een van de weinige niet gedempte Drentse veenkanalen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00217> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Annerveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        min:adres "Greveling 117",
            "Greveling 119" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Annerveensche-Kanaal (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Annerveensche-Kanaal" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47118> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "8155" ;
        min:soort "inleiding" ;
        min:volgnummer 217 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0011> ;
        schema:name "Annerveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "De Herv. kerk (Greveling 117) is een dwars geplaatste zaalkerk met een aangebouwde pastorie (Greveling 119) en een toren van twee geledingen met ingesnoerde spits. De sober neoclassicistische zaalkerk met rondboogvensters werd in 1835 gebouwd door de plaatselijke timmerman Kliphuis. Vooral vanwege de aangebouwde pastorie vertoont de kerk enige overeenkomst met de nabijgelegen kerk van Kielwindeweer. De toren verrees in 1860 vóór de oorspronkelijke ingang. In de toren hangt een klok uit 1949. De in 1982-'83 gerestaureerde kerk bevat een preekstoel en banken uit de bouwtijd en een orgel uit 1916."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0011.php> .

