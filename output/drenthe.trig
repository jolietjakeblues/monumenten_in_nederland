        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18588> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "478477" ;
        min:soort "inleiding" ;
        min:volgnummer 803 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De Rijkswerkinrichting Tweede Gesticht (Meidoornlaan 38), nu de Penitentiaire Inrichting (P.I.) Esserheem, werd gebouwd in 1898-1901 naar plannen van W.C. Metzelaar. Het Eerste Gesticht diende hierbij als voorbeeld. Het complex nam de detentietaak over van het oude Tweede Gesticht, dat werd ingericht als werkgesticht met enkel dagopvang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

