        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerbork (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Westerbork" ;
        min:lemma "Eursinge" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 863 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0101> ;
        schema:name "Eursinge"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "Eursinge. Deze kleine esnederzetting ten zuiden van Westerbork is ontstaan in de middeleeuwen en heeft enkele interessante boerderijen. In een gebint van de hallenhuisboerderij De Vledders 8 staat het jaartal 1736. De boerderij is nadien uitgebreid en aangepast en in 1975-'80 gerestaureerd. Vooral de verspringing van de kap is opvallend. In aanleg eveneens 18de-eeuws is de hallenhuisboerderij De Vledders 6 met middenlangsdeel. Belangrijke wijzigingen zijn aangebracht rond 1890, toen het woonhuis een nieuwe gevelindeling kreeg en de achterbaander met onderschoer werd vervangen door een baander in het vlak van de achtergevel. Achter deze boerderij en bij De Goorns 2 staan houten schaapskooien met rieten dak en vlechtwerk decoraties van geknoopt stro."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00864> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbork (gemeente Midden-Drenthe) – Bruntinge"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerbork (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Westerbork" ;
