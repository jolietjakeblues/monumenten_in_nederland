        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0019> ;
        schema:name "Coevorden"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "88" ;
        schema:pagination "88-89" ;
        schema:text "Het douanegebouw (Esschenbruggerdijk 8) is een eenlaags pand met overstekend zadeldak op consoles, gebouwd in 1891-'92 naar een ontwerp met chaletstijl-elementen van C.H. Peters. Het gebouw is in 1986-'88 gerestaureerd en uitgebreid onder leiding van M.L. Schijve."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00303> a min:Passage,
            schema:CreativeWork ;
