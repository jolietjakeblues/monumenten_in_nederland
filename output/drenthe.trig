        min:volgnummer 412 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0034> ;
        schema:name "Emmen"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "De (Geref.) Zuiderkerk (Wilhelminastraat 13) is een kruiskerk met aangebouwde consistoriekamer en een geveltoren met slanke spits, gebouwd in 1922 naar plannen van J.H. van der Veen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00413> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Emmen" ;
        min:gemeenteInBoek "Emmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 413 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0034> ;
        schema:name "Emmen"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "De Herv. kerk Kapelstraat 28, een zaalkerk met terugliggende, terzijde staande toren met tentdak, is gebouwd in 1923 met traditionalistische details naar plannen van J. en Th. Stuivinga. De kerk is in 1951 vergroot en bevat een door de firma Verschueren gebouwd orgel (1961)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00414> a min:Passage,
