        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0049> ;
        schema:name "Hoogeveen"@nl ;
        schema:pageEnd "134" ;
        schema:pageStart "134" ;
        schema:pagination "134" ;
        schema:text "Het verenigingsgebouw ‘Irene’ (Schutstraat 39) kwam in 1906 tot stand in opdracht van de Vereeniging tot bevordering van Christelijke Belangen naar een jugendstil-ontwerp van G. Hofman. Het tweelaags hoekpand is opgetrokken in witte verblendsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00530> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogeveen – Overige kerken"@nl ;
        min:adres "Bentinckslaan 31",
            "Bentinckslaan 33",
