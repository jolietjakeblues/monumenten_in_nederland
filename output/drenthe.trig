        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32804> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "510950" ;
        min:soort "inleiding" ;
        min:volgnummer 411 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0034> ;
        schema:name "Emmen"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "De synagoge (Julianastraat 27) is een recht gesloten zaalgebouw uit 1878 met een gepleisterde voorgevel voorzien van spitsboogvensters. In 1909 heeft men een vierde travee toegevoegd. Het in 1993 gerestaureerde gebouw is de enige nog in gebruik zijnde synagoge in Drenthe. Het interieur bevat een ark, biema en banken uit de bouwtijd; het balkon dateert van de uitbreiding in 1909."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00412> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmen"@nl ;
        min:adres "Wilhelminastraat 13" ;
