        schema:text "De Geref. kerk (Drostenraai 41) is een recht gesloten zaalkerk uit 1904 met jonger portaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0067.php> .

