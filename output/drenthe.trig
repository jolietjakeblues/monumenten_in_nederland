        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "482947" ;
        min:soort "inleiding" ;
        min:volgnummer 514 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0048> ;
        schema:name "Hoogersmilde (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "De Herv. kerk (Rijksweg 178) is een eenvoudige zaalkerk uit 1845 met dakruiter en omlijste ingangspartij, uitgevoerd met neoclassicistische en neogotische detaillering. De naastgelegen pastorie dateert uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00515> a min:Passage,
            schema:CreativeWork ;
