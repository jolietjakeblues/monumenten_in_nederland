        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 507 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Hollandscheveld (gemeente Hoogeveen)"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "Langgerekt kanaaldorp, geleidelijk ontstaan in de 18de eeuw nadat in circa 1660 de Hollandscheveldsche Opgaande en vanaf circa 1714 de Zuideropgaande gegraven waren. In de tweede helft van de 19de eeuw is de veenkoloniale bebouwing verdicht en in de 20ste eeuw is een dorpskern ontstaan nabij de kruising Riegshoogtendijk-Hollandscheveldsche Opgaande."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00508> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen)"@nl ;
        min:adres "Hendrik Raakweg 19" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37076> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "22262" ;
        min:soort "inleiding" ;
        min:volgnummer 508 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Hollandscheveld (gemeente Hoogeveen)"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "131" ;
        schema:pagination "131-132" ;
        schema:text "De Herv. kerk (Hendrik Raakweg 19) is een recht gesloten zaalkerk met omlijste ingang en een geveltoren met opengewerkte lantaarn en ingesnoerde spits. Deze in 1851 gebouwde neoclassicistische kerk heeft een aangebouwde consistoriekamer en bevat een preekstoel uit de bouwtijd en een door J. Proper gebouwd orgel (1910) in een veel oudere orgelkast (derde kwart 17de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00509> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 509 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Boerderijen. Langs de gedempte vroegere vaart staat de rond 1830 gebouwde boerderij Hollandscheveldsche Opgaande 6 met dubbel woonhuis; het woon- en het bedrijfsgedeelte liggen parallel aan de weg. Andere interessante boerderijen langs dezelfde weg zijn de krimpenboerderij Holl. Opgaande 4 (circa 1860), met ingezwenkte lijstgevel, de hallenhuisboerderij Holl. Opgaande 10-12 (circa 1890), met dwars geplaatst voorhuis, en de krimpenboerderij Holl. Opgaande 54 (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00510> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 510 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text """Woonhuizen. De voorm. dokterswoning Het Hoekje 41 (1868) is een blokvormig middenganghuis met bakstenen dakkapel. Het diepe pand Zuideropgaande 2 (circa 1870) heeft opvallende prefab eclectische pilasterkapitelen. De gepleisterde eenlaagspanden Kerkenkavel 14-16 kregen, nadat hier vanaf 1819 een lagere school in was gevestigd, rond 1890 als diaconiewoningen met eclectische elementen, hun huidige vorm. In zakelijk-expressionistische vormen gebouwd is het huis Hendrik Raakweg 18 (circa 1935).

De Alg. begraafplaats (Kerkhoflaan ong.) bezit een baarhuisje met een tot topgevel verhoogd middendeel, gebouwd in 1875 naar een ontwerp van B. Reinders uit 1874 voor een baarhuisje te Hoogeveen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00511> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen) – Zuideropgaande"@nl ;
        min:adres "Jan Wintersdijkje 33",
            "Zuideropgaande 150" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:lemma "Zuideropgaande" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 511 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Zuideropgaande"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Zuideropgaande. Dit langgerekte kanaaldorp ten zuiden van Hollandscheveld is ontstaan in de 18de eeuw aan weerszijden van de gelijknamige, tussen 1714 en 1770 gegraven vaart, die inmiddels is gedempt. Aardige woonhuizen in het dorp zijn Zuideropgaande 56, gebouwd rond 1915 als onderwijzerswoning, het L-vormige hoekhuis Zuideropgaande 46 uit 1923 en de onderwijzerswoning Zuideropgaande 152 uit circa 1930. Laatstgenoemde woning hoort bij de Chr. lagere school ‘Het Mozaïek’ (Zuideropgaande 150), een rond 1930 gebouwde tweeklassige middengangschool met diverse latere toevoegingen. De Geref. kerk (Jan Wintersdijkje 33), een zaalkerk met overhoeks geplaatste dakruiter, is in 1952 gebouwd naar ontwerp van J. Winterswijk en J. Haveman ter vervanging van een voorganger uit 1871."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00512> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen) – Elim"@nl ;
        min:adres "Carstensdijk 73",
            "Dorpsstraat 21",
            "Dorpsstraat 23",
            "Prieswijk 101" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollandscheveld (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hollandscheveld" ;
        min:lemma "Elim" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39630> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "507295" ;
        min:soort "lemma" ;
        min:volgnummer 512 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0047> ;
        schema:name "Elim"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Elim. Dit veenkoloniale kanaaldorp ten zuidoosten van Hollandscheveld is ontstaan in het laatste kwart van de 19de eeuw. Het hoofdkanaal is inmiddels gedempt. De Herv. kerk (Dorpsstraat 23) is een recht gesloten zaalkerk voorzien van een toren met drie geledingen en een achtkantige bekroning met tentdak. De kerk is in 1916 gebouwd met rationalistische elementen naar ontwerp van H.J. Beijlevelt. Inwendig heeft de kerk een ziende kap. De in 1916 opgetrokken pastorie (Dorpsstraat 21) is verbouwd in 1928. Interessante woonhuizen zijn het gepleisterde ‘Huize Elim’ (Prieswijk 101) uit 1919, het expressionistische huis Carstensdijk 158 (circa 1935), met paraboolvormige kap, en het huis Carstensdijk 162 (1936), dat zakelijk-expressionistische invloeden vertoont. Rond 1935 gebouwd zijn de moderne kop-rompboerderij Dorpsstraat 44 en de voorm. openbare lagere school ‘'t Vonder’ (Carstensdijk 73), een tweeklassige gangschool in zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00513> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogersmilde (gemeente Midden-Drenthe)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoogersmilde (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hoogersmilde" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 513 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill179> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0048> ;
        schema:name "Hoogersmilde (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Langgerekt kanaaldorp, ontstaan nadat in 1614 een uitgestrekt veengebied in de marken van Diever en Leggeloo was gekocht door een groep Amsterdammers onder aanvoering van Adriaan Pauw, die zich hierdoor Heer van Hoogersmilde mocht noemen. De door hen opgerichte Compagnie der Dieverder, Leggeler en Smilder Venen verveende dit gebied. Rond 1730 stagneerde de vervening, maar een nieuwe impuls werd gegeven door de aanleg van de Drentsche Hoofdvaart in 1767-'80. Het dorp, dat ook Oude Smilde werd genoemd, kreeg bebouwing aan beide zijden van de vaart. Na de Tweede Wereldoorlog is aan de westzijde een nieuwbouwwijk tot stand gekomen. Aan de oostzijde staat de televisie-zendmast van Smilde uit circa 1960."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00514> a min:Passage,
            schema:CreativeWork ;
