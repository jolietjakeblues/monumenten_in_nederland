        schema:pageEnd "152" ;
        schema:pageStart "152" ;
        schema:pagination "152" ;
        schema:text "De voorm. marechausseekazerne (Vaart Z.Z. 104-105, Nieuw-Amsterdam) is een fors - op een boerderij lijkend - dwars pand naar plannen van H. Rozeman uit 1891, voorzien van een iets risalerende middenpartij met fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00593> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Amsterdam (gemeente Emmen)"@nl ;
