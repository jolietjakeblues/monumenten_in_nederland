        min:hoofdstuk "Steden, dorpen, monumenten › Hoogeveen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hoogeveen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 528 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0049> ;
        schema:name "Hoogeveen"@nl ;
        schema:pageEnd "134" ;
        schema:pageStart "134" ;
        schema:pagination "134" ;
        schema:text "Het voorm. Karmelietenklooster van de paters uit Zenderen (Brinkstraat 5) is een dwars pand met een tot topgevel opgetrokken middenrisaliet, gebouwd in 1904-'05 naar een ontwerp met neogotische details van K.L. Croonen. Thans is hier het Glasmuseum Hoogeveen gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00529> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogeveen"@nl ;
        min:adres "Schutstraat 39" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
