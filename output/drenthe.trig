        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 540 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0050> ;
        schema:name "Laaghalen"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text "Laaghalen. Esdorp ten westen van Hooghalen met enkele interessante boerderijen. De hallenhuisboerderij Boermarkeweg 11, met langsdeel en aangebouwde (verlengde) houten bijschuur, dateert in aanleg uit de eerste helft van de 18de eeuw, maar is in het midden van de 19de eeuw vergroot tot de huidige omvang. Verder is er nog een vrijstaande houten bijschuur met traditioneel ambachtelijk vlechtwerk. Van hetzelfde type is de boerderij Boermarkeweg 25, met rieten dak en de jaartalsteen ‘1882’. De uit 1927 daterende kop-rompboerderij ‘Bosrand’ (Boermarkeweg 27) heeft een dwars voorhuis voorzien van een inpandig portiek met siermetselwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00541> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klazienaveen (gemeente Emmen)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
