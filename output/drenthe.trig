        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 628 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0066> ;
        schema:name "Nijeveen (gemeente Meppel)"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "157" ;
        schema:pagination "157-158" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf boven de gebintdekbalken. Tot de inventaris behoren een avondmaalstafel uit 1631, een preekstoel uit 1744 en een in 1846 door de firma Stulting & Maarschalkerweerd gebouwd orgel, dat hier in 1897 is geplaatst zonder de oorspronkelijke orgelkast. Het orgel is afkomstig uit de Kleine Kerk te Zierikzee (Z). In de kerk bevinden zich verder een altaarsteen uit circa 1480 en grafstenen uit 1506 en uit 1827 (voor J.J. Ehl)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00629> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijeveen (gemeente Meppel)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
