        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0087> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "Woonhuizen. Voorbeelden van eenvoudige baanwerkershuizen zijn Zwarte Weg 8 en Loopstukkenweg 5. Ze zijn rond 1900 gebouwd aan de spoorlijn Groningen-Zwolle en hebben beide een nummer op de zijgevel. De rond 1905 gebouwde, wit gepleisterde Villa Echo (Zuidlaarderweg 20) vertoont een combinatie van jugendstil- en neorenaissance-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0087.php> .

