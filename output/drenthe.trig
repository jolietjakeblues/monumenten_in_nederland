        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Anloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Anloo" ;
        min:lemma "Terborgh" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65455>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65456>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65457> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "510973",
            "510974",
            "510975" ;
        min:soort "lemma" ;
        min:volgnummer 207 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0009> ;
        schema:name "Terborgh"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Terborgh (Gasterenseweg 1). Deze ten westen van Anloo gelegen recreatiewoning is rond 1925 voor de familie Everts gebouwd naar een ontwerp in expressionistische stijl van J. van Houten. Het met riet gedekte huis heeft een hoger opgaand middendeel en een verhoogd terras. Uit dezelfde tijd dateren de garage en de dienstwoning (Gasterenseweg 3). Ten zuidoosten hiervan ligt het in 1922-'30 aangeplante landgoed Terborgh, waar de familie Everts in 1954 naar plannen van G. Bootsman het Pinetum Ter Borgh liet aanleggen (uitgebreid in 1993) met vierhonderd verschillende coniferen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00208> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anloo (gemeente Aa en Hunze) – Hunebed"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Anloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Anloo" ;
        min:lemma "Hunebed" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 208 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0009> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Hunebed. Ten zuidoosten van Anloo in het Evertsbos nabij het Pinetum Ter Borgh bevindt zich het hunebed D11, dat bestaat uit tien draag- en vier dekstenen. Van de ingangspartij resteert één poortsteen. In 1878 zijn eerste onderzoekingen gedaan. Het hunebed is in 1952 gerestaureerd. In de nabijheid bevindt zich een tumulus-vormige grafheuvel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00209> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anloo (gemeente Aa en Hunze) – Gasteren"@nl ;
        min:adres "Oosteinde 1" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Anloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Anloo" ;
        min:lemma "Gasteren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56860> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "46514" ;
        min:soort "lemma" ;
        min:volgnummer 209 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0009> ;
        schema:name "Gasteren"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Gasteren. Dit esdorp ten westen van Anloo is ontstaan in de middeleeuwen. De langgerekte vorm van het tussen twee essen gelegen dorp wordt bepaald door de weg van Anloo naar Assen, waarlangs drie brinken liggen. Boerderijen. De hallenhuisboerderij ‘Roelof Gerardus Jantiena Hoeve’ (Oosteinde 1) is gedateerd ‘1798’ en heeft een voorhuis met roedenvensters en een bedrijfsgedeelte met middenlangsdeel. De boerderij Westeinde 11 (circa 1850) is hiervan een kleinere variant. Voorbeelden van ontginningsboerderijen van het krimpentype zijn Brink 12 (1890) en Oosteinde 8 (circa 1905). Ten noorden van het dorp in 't Voorste Veen, nabij de weg Gasteren-Oudemolen, ligt het hunebed D10, dat bestaat uit zeven draag- en twee dekstenen. De eerste beschrijving van dit hunebed dateert van 1694. Het werd in 1869, 1878, 1952 en in 1996 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00210> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Annen (gemeente Aa en Hunze)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
