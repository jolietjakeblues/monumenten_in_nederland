        schema:name "Wijster (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "De Herv. kerk (Kampsweg 10) is een eenvoudige zaalkerk met dakruiter, gebouwd in 1929. De pastorie (Kampsweg 8) is uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0103.php> .

