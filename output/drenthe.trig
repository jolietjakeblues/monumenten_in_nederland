        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill115> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0022> ;
        schema:name "Huis Voorwijk"@nl ;
        schema:pageEnd "94" ;
        schema:pageStart "93" ;
        schema:pagination "93-94" ;
        schema:text "Huis Voorwijk (Dorpsstraat 4) is een landhuis met schilddak en omlijste ingang met Lodewijk XVI-details, gebouwd in 1791-'91 in opdracht van Wijncko Tonckens. Het huis is via gebogen muren verbonden met de bouwhuizen op het voorplein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00325> a min:Passage,
