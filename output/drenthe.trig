        min:volgnummer 467 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0040> ;
        schema:name "Gasselternijveen (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De voorm. Geref. kerk (Hoofdstraat 131) is een recht gesloten zaalkerk met gedeeltelijk gepleisterde voorgevel en een kleine dakruiter. De rond 1906 gebouwde kerk is nu in gebruik als woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00468> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gasselternijveen (gemeente Aa en Hunze)"@nl ;
        min:adres "Vaart 9" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gasselternijveen (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Gasselternijveen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 468 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0040> ;
        schema:name "Gasselternijveen (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Het voorm. raadhuis (Vaart 9), een dwars pand met middeningang, werd in 1890-'91 gebouwd als eenlaags raadhuis naar plannen van G. Stel. Bij een verbouwing in 1918, naar plannen van H. de Vries, kreeg het een nieuwe voorgevel met portiek en balkon in ‘Um 1800’-vormen, waarbij voor de details bricornasteentjes zijn gebruikt. In 1975 is het gebouw ingrijpend gewijzigd naar plannen van J.J. Sterenberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0040.php> .

