        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill258> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0081> ;
        schema:name "Schoonebeek (gemeente Emmen)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De Herv. kerk (Europaweg 116) is een recht gesloten kerk met een half ingebouwde toren met tentdak. Deze kerk met zakelijk expressionistische details werd in 1928-'29 gebouwd en bevat een uit circa 1400 stammend doopvont, afkomstig uit de oude St.-Nicolaaskerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00732> a min:Passage,
            schema:CreativeWork ;
