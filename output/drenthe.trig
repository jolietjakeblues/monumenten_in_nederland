        min:soort "inleiding" ;
        min:volgnummer 629 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0066> ;
        schema:name "Nijeveen (gemeente Meppel)"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "Het langgerekte catechisatiegebouw bij de kerk oogt ouder, maar is in 1936 naar ontwerp van J. Jans gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00630> a min:Passage,
