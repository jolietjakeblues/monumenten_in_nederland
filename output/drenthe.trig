        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Coevorden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26167> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "11485" ;
        min:soort "inleiding" ;
        min:volgnummer 299 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0019> ;
        schema:name "Coevorden"@nl ;
        schema:pageEnd "88" ;
        schema:pageStart "88" ;
        schema:pagination "88" ;
        schema:text "Het voorm. arsenaal (Haven 4-6) [8] bestaat uit twee diepe drielaags pakhuizen met puntgevels, gebouwd in de 17de eeuw. Aan de achterzijde staat een jonger tweelaags haaks bouwdeel. Na de restauratie in 1974-'76 zijn de openbare bibliotheek en het museum ‘Drenthe's Veste’ in het complex ondergebracht. Het aangrenzende, minder diepe, drielaags pakhuis Haven 2 is een uitbreiding van het arsenaal uit circa 1900. Hier is thans de VVV gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00300> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Coevorden"@nl ;
        min:adres "Friesestraat 42" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Coevorden" ;
        min:gemeenteInBoek "Coevorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Coevorden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Coevorden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Coevorden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15364> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "11484" ;
        min:soort "inleiding" ;
        min:volgnummer 300 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0019> ;
        schema:name "Coevorden"@nl ;
        schema:pageEnd "88" ;
        schema:pageStart "88" ;
        schema:pagination "88" ;
        schema:text "De voorm. kazerne (Friesestraat 42) [9] is in oorsprong een 17de-eeuws diep pand met trapgevel. De in het verlengde van de kazerne gebouwde rij huizen Molenstraat 5-31 diende voor de huisvesting van het garnizoen. De voorgevel van de kazerne werd in 1765 gewijzigd en gepleisterd; behalve het jaartalcartouche dateren de boogvullingen mogelijk ook uit die tijd. Rond 1890 kreeg het pand een winkelpui. Het complex huisvest nu winkels, woonhuizen en een café."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00301> a min:Passage,
