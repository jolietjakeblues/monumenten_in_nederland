        schema:name "Steenbergen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "Esdorp zonder kerk, ontstaan in de middeleeuwen op de hogere zandgronden van het Drentse plateau. Het dorp heeft een grote driehoekige brink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0085.php> .

