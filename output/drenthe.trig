        min:volgnummer 799 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Het voorm. cellengebouw (Oude Gracht 30), een tweelaags gebouw met gedrukt zadeldak, dateert uit 1860 naar plannen van A.C. Pierson. In 1889 is het verbouwd en uitgebreid met een dienstwoning (Oude Gracht 32). Thans dient het gebouw zelf als magazijn van de gestichtswacht en is de woning ingericht als kantoor ten behoeve van het in 1939-'40 aangebouwde cellengebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00800> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Hospitaallaan 5" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 800 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De voorm. gestichtswachtkazerne (Hospitaallaan 5) is een tweelaags pand met zadeldak, gebouwd in 1886. Boven de deur zit een sluitsteen met de initialen van W.C. Metzelaar, het wapen van de Koninklijke Marechaussee en de jaartallen 1886 en 1902. Het laatste jaartal duidt waarschijnlijk op een interne verbouwing, uitgevoerd om het pand geschikt te maken als onderkomen voor lijders aan besmettelijke ziekten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00801> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Plantsoenstraat 5" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27911> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "478501" ;
        min:soort "inleiding" ;
        min:volgnummer 801 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Het voorm. Werkgesticht Norgerhaven (Plantsoenstraat 5) kwam tot stand in 1884-'90 naar een ontwerp van W.C. Metzelaar. Ten tijde van de oplevering waren de vrouwelijke gedetineerden voor wie het gebouw bestemd was, echter al in de strafinrichting van Leiden ondergebracht. Het gebouw ging tijdelijk dienst doen als strafinrichting voor mannen. Na de voltooiing van de nabijgelegen Rijkswerkinrichting Eerste Gesticht in 1897-'03, kreeg het de functie van werkgesticht met enkel dagopvang. Het carrévormige complex heeft een poortgebouw en twee flankerende dienstwoningen (‘Rust Roest’ en ‘Werklust’). De zijgevels hebben getraliede vensters. Inwendig bevat het gebouw gietijzeren kolommen met kussenkapitelen, gemetselde troggewelven met ijzeren balken en gietijzeren trappen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00802> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Oude Asserstraat 20" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48873> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "478489" ;
        min:soort "inleiding" ;
        min:volgnummer 802 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De Rijkswerkinrichting Eerste Gesticht (Oude Asserstraat 20), nu de Penitentiaire Inrichting (P.I.) Norgerhaven, is een carrévormig complex uit 1897-1903, gebouwd naar een neorenaissance-ontwerp van W.C. Metzelaar. Het frontgebouw heeft een middenrisaliet met trapgevel; boven de ingang bevindt zich een gevelsteen met de oorspronkelijke naam van het complex. Het gebouw is in 1965 en in 1989-'90 verbouwd. Bij de laatste verbouwing, naar ontwerp van Bureau C. Kalfsbeek, zijn hoekvolumes toegevoegd. Tevens is de westzijde uitgebreid en heeft men een hekwerk rond het gebouw geplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00803> a min:Passage,
