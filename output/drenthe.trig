        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenbergen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Steenbergen" ;
        min:lemma "De Vennen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34363>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38308> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "469410",
            "478214" ;
        min:soort "lemma" ;
        min:volgnummer 762 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0085> ;
        schema:name "De Vennen"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "De Vennen (Hoofdweg 16). Dit tussen Steenbergen en Roderesch gelegen landhuis is in 1936-'37 in zakelijk-expressionistische stijl gebouwd naar plannen van H.C. Hillebrands en T. Zondag voor de arts J.B. Bruins. Het in twee kleuren metselwerk opgetrokken huis heeft een trappenhuis met houten geveltopbetimmering en windkast. Onder het huis bevindt zich de garage. Het huis ligt in een bosrijke omgeving aan de rand van een groot ven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00763> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenbergen (gemeente Noordenveld) – Hunebed"@nl ;
        min:adres "Giezenstraat 1-3" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenbergen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Steenbergen" ;
        min:lemma "Hunebed" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 763 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0085> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text """Hunebed. Ten noorden van Steenbergen aan de rand van de Noorder Duinen bevindt zich hunebed D1, dat bestaat uit twaalf draag- en zes dekstenen. De ingang wordt gevormd door een paar poortzijstenen met deksteen. Er zijn restauraties uitgevoerd in 1953, 1954, 1965, 1993 en 1997.

De openbare lagere school ‘Steenbergen’ (Giezenstraat 1-3) werd gebouwd in Roderesch, een nederzetting die eind 19de, begin 20ste eeuw een verzorgende functie voor de nabijgelegen buurtschappen kreeg. Het langgerekte vierklassige schoolgebouw dateert uit 1921 (vensters gewijzigd) en heeft een aangebouwde onderwijzerswoning met hoger opgetrokken, risalerende gevelpartij."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00764> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tweede Exloërmond (gemeente Borger-Odoorn)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Borger-Odoorn" ;
        min:gemeenteInBoek "Borger-Odoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borger-Odoorn> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tweede Exloërmond (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Tweede Exloërmond" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 764 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill270> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0086> ;
        schema:name "Tweede Exloërmond (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "Langgerekt kanaaldorp, gesticht rond 1840 toen vanuit het Groningse Musselkanaal een mond werd gegraven die in het Drentse gebied als enkel kanaal westwaarts liep. Westelijk van de Drentse Mondenweg ging de veenkoloniale nederzetting over in een dubbel kanaalsysteem met op de tussengelegen zogeheten vooraffen, verveners- en landarbeiderswoningen en aan de buitenzijde dwarsplaatsen met boerderijen. Haaks op het westelijke einde van het dorp ontwikkelde zich het gehucht Eexloërkijl. Op de samenkomst van Tweede Exloërmond en Exloërkijl ontstond na de Tweede Wereldoorlog enige verdichting van de bebouwing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0086.php> .

