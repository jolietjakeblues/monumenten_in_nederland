        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Woonhuizen. Langs de Mr. J.B. Kanweg staan verschillende arbeiderswoningen uit 1926 naar plannen van A. de Vries en J. Boelens met afgewolfd zadeldak en een ingang in de zijgevel. Sommige van deze woningen hebben een boerderij-achtig karakter gekregen door aanbouw van een schuur. De eenvoudige woonhuizen Kerkweg 10-14 zijn rond 1930 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00880> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Witteveen (gemeente Midden-Drenthe) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Witteveen (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Witteveen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 880 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill306> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0104> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text """Boerderijen. Van de ontginningsperiode en beginperiode van het dorp dateren de forse hallenhuisboerderijen Mr. J.B. Kanweg 12 (1926), met hoog rieten zadeldak en door steunberen gelede zijgevels en Mr. J.B. Kanweg 11, met afgewolfd rieten zadeldak, de kop-rompboerderijen Mr. J.B. Kanweg 5 en 8, met zijlangsdelen, en de krimpenboerderij Westerborkerveld 1. De laatstgenoemde heeft een met riet gedekte schuur. Het woonhuisgedeelte is uitgevoerd met opvallend brede vensterstijlen en een vensterreeks onder de dakgoot.

De ijzeren draaibrug (Westerborkerveld/Zuideresweg) dateert uit circa 1930 en bestaat uit twee gewapend betonnen jukken, gewalste ijzeren profielbalken, trekstangen en een houten wegdek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0104.php> .

