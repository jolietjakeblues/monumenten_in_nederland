        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill123> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0023> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Hunebed. Ten noordoosten van Diever ligt op de Hezenes het hunebed D52 (Groningerweg ong.) dat bestaat uit veertien draagstenen en zeven dekstenen. De ingang wordt gevormd door één paar poortzijstenen. Restauraties zijn uitgevoerd in 1953 en 1995."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00341> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diever (gemeente Westerveld) – Wittelte"@nl ;
        min:adres "Wapserveenseweg 1",
            "Wittelterweg 25",
            "Wittelterweg 27" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diever (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Diever" ;
        min:lemma "Wittelte" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 341 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0023> ;
        schema:name "Wittelte"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Wittelte. Dit esgehucht ten zuiden van Diever is ontstaan in de vroege middeleeuwen en heeft enkele interessante boerderijen. De hallenhuisboerderij Noordsweg 1, met topgevel, draagt de jaartalankers ‘1840’. Jongere hallenhuisboerderijen zijn: ‘d'Oerte’ (Wapserveenseweg 1; circa 1900), met topgevel en dwarsdeel, en Wapserveenseweg 3 (1920), met twee dwarsdelen. De boerderij Wittelterweg 15 bezit een voorhuis uit circa 1915 met hoger opgetrokken middenrisaliet en jugendstil-details. De moderne krimpenboerderij Wittelterweg 18 (circa 1925) is ook uitgevoerd met een middenopbouw; tegen de zijgevel staat een jongere uitbreiding. Het voorm. tolbuisje (Wittelterweg 25) dateert uit circa 1890. Rond 1915 gebouwd is het eenlaags middenganghuis Wittelterweg 10 met verhoogd middenrisaliet. Het trafohuisje (Wittelterweg 27) is een klein blokvormig gebouw uit circa 1930 met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00342> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dieverbrug (gemeente Westerveld)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
