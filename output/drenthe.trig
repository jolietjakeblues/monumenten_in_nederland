        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "478024" ;
        min:soort "inleiding" ;
        min:volgnummer 669 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill232> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Peize (gemeente Noordenveld)"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "165" ;
        schema:pagination "165-166" ;
        schema:text "De pastorie ‘Kortland’ (Kortlandsweg 31) is een gepleisterd eclectisch middenganghuis met hoger opgetrokken mid- denpartij, in oorsprong daterend uit de 18de eeuw, maar rond 1880 grotendeels vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00670> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld)"@nl ;
        min:adres "Vrieserweg 8-10" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
