        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0075> ;
        schema:name "Roden (gemeente Noordenveld)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De pastorie (Brink 5) is een sober 19de-eeuws pand met afgeplat schilddak voorzien van hoekschoorstenen. De T-vormige achteraanbouw dateert uit circa 1930. Op de Brink staat een door S. Berkhout ontworpen beeldje van Ot en Sien."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00687> a min:Passage,
