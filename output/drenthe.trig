        min:hoofdstuk "Steden, dorpen, monumenten › Schoonoord (gemeente Coevorden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Schoonoord" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 736 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0082> ;
        schema:name "Schoonoord (gemeente Coevorden)"@nl ;
        schema:pageEnd "181" ;
        schema:pageStart "181" ;
        schema:pagination "181" ;
        schema:text "Langgerekt kanaaldorp, ontstaan rond 1850 op een zandopduiking aan de rand van het veen. Langs het in 1853-'58 gegraven Oranjekanaal en de haaks hierop staande weg van Coevorden naar Assen kwam een zich snel uitbreidende lintbebouwing tot stand, die aanvankelijk vooral uit plaggenhutten bestond. Na de Tweede Wereldoorlog is het dorp in westelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0082.php> .

