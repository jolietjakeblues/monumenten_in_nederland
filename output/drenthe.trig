        min:soort "inleiding" ;
        min:volgnummer 622 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0065> ;
        schema:name "Nijensleek (gemeente Westerveld)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "Wegdorp, ontstaan in de late middeleeuwen op een zandrug als randveenontginning. In de 16de en 17de eeuw werden de ontginningen voortgezet door de bewoners van het thans verdwenen Huis Moersbergen en - vanaf 1614 op systematisch wijze georganiseerd - door François van Westerbeek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0065.php> .

