    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00003> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwerk"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
