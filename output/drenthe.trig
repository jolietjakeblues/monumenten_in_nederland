        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25186> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "527223" ;
        min:soort "lemma" ;
        min:volgnummer 271 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0016> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text """Boerderijen. Uit de 19de eeuw dateren de hallenhuisboerderijen Hoofdstraat 8 en Hunebedstraat 9. De rond 1910 gebouwde boerderijen Koesteeg 1 en 12 vertonen neorenaissance-details.

De voorm. smederij (Hunebedstraat 14) werd rond 1895 gebouwd en bestaat uit een eenlaags woonhuis met bedrijfsdeel en een aangebouwde ouderwoning."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00272> a min:Passage,
            schema:CreativeWork ;
