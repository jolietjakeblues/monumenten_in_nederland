        min:soort "lemma" ;
        min:volgnummer 869 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0102> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Hunebed. Aan de noordrand van Westervelde bevindt zich hunebed D2 dat bestaat uit acht draag- en vier dekstenen. De ingang wordt gevormd door een paar poortzijstenen. Restauraties zijn uitgevoerd in 1928, 1952 en 1965."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0102.php> .

