        schema:name "Zwartemeer (gemeente Emmen)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "De nieuwe St.-Anthonius van Paduakerk (De Klinken 8), ook wel Verrijzeniskerk genoemd, is een moderne langgerekte kerk uit 1968-'69 naar plannen van J. Dresme."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0110.php> .

