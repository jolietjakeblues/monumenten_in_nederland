        min:volgnummer 688 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0075> ;
        schema:name "Roden (gemeente Noordenveld)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De openbare lagere school (Schoolstraat 1) is rond 1890 gebouwd als vierklassige middengangschool met neorenaissance-details. Het later aan de achterzijde uitgebreide gebouw is nu een school voor praktische vorming. De rond 1925 gebouwde onderwijzerswoning (Schoolstraat 3) vertoont expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0075.php> .

