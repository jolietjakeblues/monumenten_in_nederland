        min:adres "Dorpsstraat 58" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Meppel" ;
        min:gemeenteInBoek "Meppel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meppel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijeveen (gemeente Meppel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Nijeveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58199> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "30959" ;
        min:soort "inleiding" ;
        min:volgnummer 627 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0066> ;
        schema:name "Nijeveen (gemeente Meppel)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "De Herv. kerk (Dorpsstraat 58), oorspronkelijk gewijd aan St. Barbara, is een eenbeukige kerk met een smaller, driezijdig gesloten koor en een half ingebouwde toren met ingesnoerde naaldspits. De kort na 1477 tot stand gekomen kerk heeft inwendig een gebintconstructie, die veel overeenkomsten vertoont met de gebinten van een grote hallenhuisboerderij. In plaats van ankerbalken zijn hier evenwel dekbalken toegepast. De zijwanden zijn waarschijnlijk in 1627 versteend en in de 19de eeuw verhoogd voor de plaatsing van grotere ramen. De eveneens kort na 1477 opgetrokken toren heeft een torenkruis met het jaartal 1683 - mogelijk is de kerk toen hersteld of gewijzigd. De kerk is in 1976 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0066.php> .

