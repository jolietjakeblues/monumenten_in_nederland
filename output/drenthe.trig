        min:gemeenteInBoek "Emmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Erica (gemeente Emmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Erica" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 432 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill158> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0036> ;
        schema:name "Erica (gemeente Emmen)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "Langgerekt kanaaldorp, ontstaan in 1863 als boekweitkolonie op een zandopduiking. Het dorp heette aanvankelijk Nieuw-Slagharen, naar het dorp waar de kanaalgravers die zich hier vestigden, vandaan kwamen. Later werd het dorp Erica genoemd, de Latijnse naam van een in de omgeving veel voorkomende heidesoort. Vanaf 1867 liet de Drentsche Kanaal Maatschappij de Verlengde Hoogeveensche Vaart graven, die na 1882 als het Van Echtenskanaal tot Klazienaveen werd doorgetrokken met een brug over de weg van Emmen naar Schoonebeek: de Ericasebrug. Naast de al bestaande kern rondom de katholieke kerk, vormde zich bij deze brug een tweede dorpskern. Na de Tweede Wereldoorlog is het tussenliggende gebied volgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0036.php> .

