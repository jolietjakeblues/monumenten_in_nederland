        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15432>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54742> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "44562",
            "44563" ;
        min:soort "lemma" ;
        min:volgnummer 318 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill113> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0020> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "92" ;
        schema:pagination "92-93" ;
        schema:text """Windmolens. De windmolen De Bente (De Bente 40) is een met riet gedekte achtkantige stellingmolen met een gemetselde onderbouw. Deze korenmolen werd in 1814 gebouwd door C.J. Volkers en M. Kars, ter vervanging van een in 1813 afgebrande voorganger. In 1976 is de molen gerestaureerd. De windmolen Jan Pol (Molenwijk 8) is een met riet gedekte achtkantige stellingmolen met een hoge gemetselde onderbouw. Deze koren- en pelmolen werd in 1876 gebouwd door molenmaker Schiller ter vervanging van een voorganger uit 1820. De molen is in 1993 voor het laatst gerestaureerd.

De voorm smederij (De Bente 51) is een eenlaagspand met zadeldak, gebouwd rond 1910."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00319> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalerveen (gemeente Coevorden)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Coevorden" ;
        min:gemeenteInBoek "Coevorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Coevorden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalerveen (gemeente Coevorden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dalerveen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 319 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0021> ;
        schema:name "Dalerveen (gemeente Coevorden)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Dorp, ontstaan in de middeleeuwen als een randveenontginning vanuit Dalen en gelegen op de overgang van het beekdal van het Drostendiep naar het oostelijke hoogveengebied. De dorpsbebouwing kwam tot ontwikkeling aan de oostzijde van de noord-zuid lopende Dwarsdijk (thans deels Hoofdstraat). In het noordelijke deel van het dorp (De Haar) ligt de bebouwing direct aan de dijk, in het zuidelijke deel (Dalerveen) ver van de dijk. Rond 1940 zijn delen van het dorp aan elkaar gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00320> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dalerveen (gemeente Coevorden) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Coevorden" ;
        min:gemeenteInBoek "Coevorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Coevorden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dalerveen (gemeente Coevorden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dalerveen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 320 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0021> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text """Boerderijen. De hallenhuisboerderij De Haar 3, met langsdeel en bijschuur, dateert in oorsprong uit 1698. In aanleg 18de-eeuws en gewijzigd in de 19de eeuw is de hallenhuisboerderij Noorderakkers 18. De aangebouwde, eveneens tot de 18de eeuw teruggaande kleine houten hooischuur met schaapskooi heeft decoraties van geknoopt stro. Mogelijk uit 1712 stamt de hallenhuisboerderij De Lichtenburg 7, die is voorzien van een aangebouwde bakstenen schuur met ankerbalkconstructie. Andere voorbeelden van hallenhuisboerderijen met langsdeel zijn Hoofdstraat 139 (circa 1800), NAM-weg 23 (circa 1840), met dubbel woonhuis en bijschuur, en Hoofdstraat 108 (circa 1885), met dubbel woonhuis. De in 1923 gebouwde boerderij Hoofdstraat 141 heeft een dwars geplaatst voorhuis met portiek en een tot topgevel met chaletstijl-elementen opgetrokken middenrisaliet.

Het woonhuis Hoofdstraat 122 is rond 1930 gebouwd in zakelijk-expressionistische vormen als directeurswoning bij de coöperatieve stoomzuivelfabriek ‘De Hoop’. Deze in 1894 gestichte fabriek is inmiddels verdwenen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00321> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Wijk (gemeente De Wolden)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "De Wolden" ;
        min:gemeenteInBoek "De Wolden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Wolden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Wijk (gemeente De Wolden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "De Wijk" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 321 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill114> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0022> ;
        schema:name "De Wijk (gemeente De Wolden)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Esdorp zonder kerk, ontstaan in de 12de eeuw op een reeks zandopduikingen ten noorden van het Reestdal. In de middeleeuwen lagen hier boerderijen van waaruit ontginningen in noordelijke richting plaatsvonden. Enkele hoeven ontwikkelden zich tot landgoederen (Havixhorst, Dikninge en Voorwijk), andere vormden gezamenlijk kleine buurtschappen, zoals Schiphorst, Havixhorst, Dikninge, De Wijk, Haalweide, Oosterwijk en De Stapel. Mede door de vestiging in 1325 van het benedictijner dubbelklooster Dickninge (gesloopt in 1796) en de gunstige ligging ontwikkelde de buurtschap De Wijk zich tot een grotere nederzetting. Vanuit De Wijk kerkte men in het nabijgelegen IJhorst (Ov.). De dorpsbebouwing stond vanouds hoofdzakelijk langs de doorgaande Dorpsstraat. Na 1850 kwam een uitloper in noordelijke richting tot stand langs de Molenstraat en na de Tweede Wereldoorlog is het dorp vooral in noord- en noordoostelijke richting uitgebreid, in mindere mate in zuidelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00322> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Wijk (gemeente De Wolden)"@nl ;
        min:adres "Dorpsstraat 74",
            "Dorpsstraat 78" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "De Wolden" ;
        min:gemeenteInBoek "De Wolden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Wolden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Wijk (gemeente De Wolden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "De Wijk" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 322 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0022> ;
        schema:name "De Wijk (gemeente De Wolden)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 74) bestaat uit twee bouwdelen. Het oudste gedeelte is de in 1882 naar ontwerp van S.H. van der Veen tot raadhuis annex veldwachterswoning verbouwde herberg het ‘Roode Hert’. Het linker bouwdeel met topgevel werd in 1910 gebouwd ter vervanging van de afgebrande veldwachterswoning. In 1987-'89 is naar ontwerp van H. Klunder een nieuw raadhuis gebouwd (Dorpsstraat 78)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00323> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Wijk (gemeente De Wolden)"@nl ;
        min:adres "Dorpsstraat 55",
            "Dorpsstraat 57" ;
