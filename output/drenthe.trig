        schema:name "Nijensleek (gemeente Westerveld)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "De Geref. kerk (Hoofdweg 59) is een recht gesloten zaalkerk uit 1934 met dakruiter, portaal en aangebouwde consistoriekamer. De pastorie (Hoofdweg 57) dateert uit circa 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00624> a min:Passage,
            schema:CreativeWork ;
