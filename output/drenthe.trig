        min:hoofdstuk "Steden, dorpen, monumenten › Dieverbrug (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dieverbrug" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 342 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0024> ;
        schema:name "Dieverbrug (gemeente Westerveld)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Wegdorp, ontstaan na de aanleg van de Drentsche Hoofdvaart (1767-'80) bij de brug op de kruising met de weg van Dwingeloo naar Diever. De bebouwing concentreerde zich aanvankelijk langs de Dwingelerdijk en de vaart en de parallel daaraan gelegen Rijksweg Assen-Meppel. Vanaf circa 1900 werd het dorp, ten westen van de vaart, langs de weg naar Diever uitgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00343> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dieverbrug (gemeente Westerveld) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dieverbrug (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dieverbrug" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 343 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0024> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Woonhuizen. Het forse neoclassicistische huis Dwingelerdijk 4 dateert uit circa 1880 en heeft een jongere achteraanbouw. Aardige vroeg-20ste eeuwse eenlaags huizen zijn Dieverbrug 41 uit 1915, met hoger opgetrokken middenrisaliet en jugendstil-details, en het deels gepleisterde huis Rijksweg 56 (circa 1920), met een tot topgevel opgetrokken hoekrisaliet. Rond 1935 gebouwd zijn de eenlaagspanden Dieverbrug 25-27 en Dwingelerdijk 21; de laatste vertoont zakelijk-expressionistische invloeden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0024.php> .

