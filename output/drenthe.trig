        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zorgvlied (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Zorgvlied" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 890 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill309> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0106> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "209" ;
        schema:pageStart "209" ;
        schema:pagination "209" ;
        schema:text """Woonhuizen. Aardige eenlaags huizen zijn Aurora (Dorpsstraat 40; circa 1890), met houten dakkapel, en het middenganghuis Dorpsstraat 44 (circa 1900). Het blokvormige huis Dorpsstraat 15 met gebroken tentdak is rond 1935 gebouwd in zakelijk expressionistische stijl.

Het voorm. tolhuis (Verwersweg 30) dateert uit circa 1880.

De voorm. openbare lagere school in het gehucht Wateren (Wateren 13), gelegen ten zuidoosten van Zorgvlied, is een deels gepleisterde drieklassige gangschool met risalerend middengedeelte, gebouwd in 1919."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00891> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidlaren (gemeente Tynaarlo)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
