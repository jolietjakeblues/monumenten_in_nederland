        min:hoofdstuk "Steden, dorpen, monumenten › Echten (gemeente De Wolden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Echten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79364> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "515664" ;
        min:soort "inleiding" ;
        min:volgnummer 374 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0028> ;
        schema:name "Echten (gemeente De Wolden)"@nl ;
        schema:pageEnd "105" ;
        schema:pageStart "105" ;
        schema:pagination "105" ;
        schema:text "Op het voorplein staan twee bouwhuizen uit circa 1685. Bij de restauratie heeft men het zuidelijke bouwhuis vergroot. Dit bouwhuis heeft een dakruiter met een in 1715 door Claes Noorden en Jan Albert de Grave gegoten klok. De tuinaanleg is in 1992 gerestaureerd onder leiding van bureau Hollema. In een weide staat een in oorsprong vermoedelijk 17de-eeuws houten duifhuis op houten stijlen en bakstenen poeren. Aan het begin van de oprijlaan bevinden zich de 18de-eeuwse bakstenen pijlers van een niet meer aanwezig toegangshek en daarnaast een portierswoning (Zuidwolderweg 1) uit 1741-'44."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00375> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Echten (gemeente De Wolden)"@nl ;
