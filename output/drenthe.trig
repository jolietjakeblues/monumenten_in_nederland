        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill67> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0011> ;
        schema:name "Annerveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Huis Grevelink (Ellentshoek 2) is een sober maar statig tweelaags pand met souterrain, gebouwd in 1785 - naar verluidt in zeventien dagen - voor de landmeter en vervener Lambartus Grevijlink. Rond 1990 is het gebouw aan de achterzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00220> a min:Passage,
            schema:CreativeWork ;
