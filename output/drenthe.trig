        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grolloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Grolloo" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 489 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill173> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0044> ;
        schema:name "Grolloo (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "127" ;
        schema:pagination "127-128" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op een westflank van de Hondsrug als dochternederzetting van Rolde. Het dorp heeft aan de oostzijde twee essen en aan de Voorstreek een kleine brink. In 1853 werd Grolloo een zelfstandige parochie. De bebouwing heeft sterk te lijden gehad van dorpsbranden in 1915 (Oostereind) en 1922 (Hoofdstraat). Na de Tweede Wereldoorlog is het dorp aan de zuidzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00490> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grolloo (gemeente Aa en Hunze)"@nl ;
        min:adres "Hoofdstraat 19",
            "Hoofdstraat 21" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grolloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Grolloo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68438>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68439> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "482937",
            "482948" ;
        min:soort "inleiding" ;
        min:volgnummer 490 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0044> ;
        schema:name "Grolloo (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "De Herv. kerk (Hoofdstraat 19) is een recht gesloten zaalkerk voorzien van een geveltoren met houten opbouw, opengewerkte achtkantige lantaarn en naaldspits. De in 1853 in neoclassicistische vormen opgetrokken kerk is in 1975 gerestaureerd. In de geveltoren hangt een van elders afkomstige klok uit 1422. De kerk bevat een preekstoel en banken uit de bouwtijd. De neoclassicistische pastorie (Hoofdstraat 21) is een middenganghuis uit 1853."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00491> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grolloo (gemeente Aa en Hunze) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grolloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Grolloo" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 491 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill174> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0044> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Boerderijen. Uit de 17de of 18de eeuw dateert de grote hallenhuisboerderij Middenstreek 5 met onderschoer. Het voorhuis is uitgevoerd in stijl- en regelwerk en heeft stroomlagen in het opvullend metselwerk. De roedenvensters zijn van de restauratie rond 1975. Op het erf staat een mogelijk in oorsprong 18de-eeuwse houten schuur op stenen voet. De boerderij Voorstreek 4 (circa 1880) is een kleinere versie met dwarsdeel. De boerderij Hoofdstraat 3 (circa 1890) heeft een zijlangsdeel met baander in de voorgevel. Voorbeelden van krimpenboerderijen zijn: Oostereind 8 (1907), Oostereind 2 (circa 1910) en Oostereind 3 (circa 1915). Schoonloërstraat 7 is een moderne kop-rompboerderij uit circa 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00492> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grolloo (gemeente Aa en Hunze) – Woonhuizen"@nl ;
        min:adres "Schoonloërstraat 49" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grolloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Grolloo" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60431> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "32696" ;
        min:soort "lemma" ;
        min:volgnummer 492 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0044> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text """Woonhuizen. Expressionistische details vertoont het woonhuis Schoonloërstraat 8 (circa 1920). Een goed voorbeeld van een dorpswinkel annex woonhuis is Hoofdstraat 23 (circa 1930).

De Grolloërkuil (bij Schoonloërstraat 49), gelegen ten zuiden van Grollo, is de plaats waar de Etstoel, het vroegere landgerecht van Drenthe van 1550 tot 1669 in de open lucht zou hebben vergaderd. Vanwege de historische betekenis werd deze plek in het bos het Grollerholt in 1877 door de provincie aangekocht en op deze plek werd in 1897 de Drentse zuivelbond opgericht. Door recent onderzoek is echter twijfel gerezen over de juiste locatie voor de Etstoel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00493> a min:Passage,
            schema:CreativeWork ;
