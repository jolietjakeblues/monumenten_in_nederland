        schema:name "Eexterveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "111" ;
        schema:pageStart "111" ;
        schema:pagination "111" ;
        schema:text "De voorm. marechausseekazerne (Semsstraat 147-151) is een uit drie woningen bestaand eenlaags complex met chaletstijl-elementen, gebouwd in 1910 op verzoek van het bestuur van de nabijgelegen aardappelmeelfabriek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00403> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eexterveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        min:adres "Semsstraat 26-28" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eexterveensche-Kanaal (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Eexterveensche-Kanaal" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 403 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill146> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0032> ;
        schema:name "Eexterveensche-Kanaal (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "111" ;
        schema:pagination "111-112" ;
        schema:text "De voorm. coöperatieve aardappelmeelfabriek ‘Wildervank e.o.’ (Semsstraat 26-28) werd in 1903 opgericht en bestaat uit een eenlaags bouwdeel uit 1903 en een hoger opgaand deel in gewapend beton uit circa 1935. De bijbehorende directeurswoning is sterk verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00404> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eexterveensche-Kanaal (gemeente Aa en Hunze) – Draaibruggen"@nl ;
        min:adres "Bareveld 6",
            "Semsstraat 17" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eexterveensche-Kanaal (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Eexterveensche-Kanaal" ;
        min:lemma "Draaibruggen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24135> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "510984" ;
        min:soort "lemma" ;
        min:volgnummer 404 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0032> ;
        schema:name "Draaibruggen"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text """Draaibruggen. Over het Eexterveensche kanaal liggen twee getuide draaibruggen met op het draaipunt een ijzeren pyloon en onder de brug een gietijzeren draaijuk met stabilisatiewielen. De brug bij Semsstraat 2 werd in 1891 gebouwd, die bij Semsstraat 4 in 1892. De bijbehorende brugwachterswoningen dateren uit circa 1880 en hebben evenals de brugwachterswoning Semsstraat 24 een terugliggende portiek met op de hoek een gietijzeren zuil onder een vooruitstekende gevelpunt. De sluis in het Eexterveensche kanaal (bij Semsstraat 17) is een rond 1895 gebouwde schutsluis met ovale sluiskom. Bij de noordelijke sluisdeur bevindt zich een smalle voetgangersdraaibrug uit dezelfde tijd. De sluisdeuren zijn later vernieuwd.

De rolpaal (bij Bareveld 6) aan het jaagpad van de trekvaart op de hoek van het Eexterveensche kanaal en de mond richting Wildervank dateert uit het eind van de 19de eeuw."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00405> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eexterveensche-Kanaal (gemeente Aa en Hunze) – Eexterveen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
