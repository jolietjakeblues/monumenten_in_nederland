        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52311> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "32149" ;
        min:soort "inleiding" ;
        min:volgnummer 670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Peize (gemeente Noordenveld)"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Het voorm. Diakonie Armhuis (Vrieserweg 8-10), gesticht in 1859, is een eenvoudig langgerekt dwars pand met afgewolfd zadeldak. Ernaast staat een landbouwschuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld)"@nl ;
        min:adres "Hoofdstraat 34-36" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peize (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Peize" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 671 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Peize (gemeente Noordenveld)"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Het voorm. postkantoor (Hoofdstraat 34-36) is een eenlaags woonhuis met kantoor, gebouwd rond 1905 naar een ontwerp met neorenaissance-detaillering. De afgeschuinde gevelhoek bevatte mogelijk oorspronkelijk de ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00672> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld)"@nl ;
        min:adres "Hoofdstraat 12-14",
            "Kerkstraat 4",
            "Raadhuisstraat 1" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peize (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Peize" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29786>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40362> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "32142",
            "478025" ;
        min:soort "inleiding" ;
        min:volgnummer 672 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Peize (gemeente Noordenveld)"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Het raadhuis (Raadhuisstraat 1) is een blokvormig pand met overstekend schilddak, gebouwd in 1917-'18 naar een ontwerp van J. Smallenbroek & Zn. in sobere nieuw historiserende stijl. De uitbreiding aan de achterzijde kwam in 1938-'40 tot stand naar plannen van gemeenteopzichter L.J. Elema. Het pand is verder verbouwd in 1968, gevolgd door interne verbouwingen in 1984 en in 1990-'91. Vóór 1918 werden de raadsvergaderingen gehouden in logementen te Peize, aanvankelijk in ‘Naast de Kerk’ (Kerkstraat 4) en later in ‘Café Boonstra’ (Hoofdstraat 12-14)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00673> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld) – Woonhuizen"@nl ;
        min:adres "De Horst 21",
            "Roderweg 22" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peize (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Peize" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12044>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17473> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "32139",
            "32147" ;
        min:soort "lemma" ;
        min:volgnummer 673 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Woonhuizen. Het Huis ter Hansouwe (De Horst 21) is het restant van een oorspronkelijk middeleeuws steenhuis, dat in de 17de eeuw werd verlengd en in de 18de eeuw werd verbonden met stallen en bedrijfsruimten. De dwars aangebouwde hoge Friese schuur dateert blijkens de jaartalankers uit 1837. Deze schuur en de stallen zijn met riet gedekt. Het deels in kloostermoppen opgetrokken woonhuisgedeelte heeft gedeeltelijk dichtgemetselde, smalle kloostervensters. In de opkamer bevindt zich een laat-17de-eeuwse bedstede, in de woonkamer een 18de-eeuwse schouw. De gietijzeren hekpalen van het 19de-eeuwse toegangshek zijn afkomstig uit Groningen. Het Huis Willinge (Roderweg 22), ook wel het ‘Jachthuis’ genoemd, bestaat uit een middenganghuis, voorzien van een hoger opgetrokken middenpartij met een fronton en een deur met pilasteromlijsting, en een aangebouwde schuur. Het complex dateert van oorsprong uit 1763 en heeft bij een verbouwing in 1880 het huidige aanzicht gekregen. Het is in de tweede helft van de 20ste eeuw nog enkele malen verbouwd. Het woonhuis Brinkweg 2, een dwars huis met schilddak en hoge schuifvensters, werd rond 1815 gebouwd voor G. Kemkers. Bij de bouw heeft men materiaal gebruikt van de kort tevoren afgebroken, nabij gelegen havezate Huis te Peize. Zo ook de in de muur tussen het huis en de bijbehorende schuur ingemetselde gevelsteen uit 1706, met het alliantiewapen van de families De Coninck en Van den Clooster."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00674> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld) – Boerderijen"@nl ;
        min:adres "Brinkweg 19",
            "Groningerweg 38",
            "Molenpad 1" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peize (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Peize" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12410>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35667> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "32145",
            "478023" ;
        min:soort "lemma" ;
        min:volgnummer 674 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill233>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill234> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "166" ;
        schema:pagination "166-167" ;
        schema:text """Boerderijen. Het woongedeelte van de hallenhuisboerderij Oosterweg 7 heeft schuifvensters met luiken en draagt in de topgevel de jaartalankers ‘1662’. De schuur met zijbaander is met riet gedekt. De in de kern mogelijk 16de-eeuwse hallenhuisboerderij Kerkstraat 4 heeft in 19de eeuw de huidige vorm gekregen. Deze boerderij is ook in gebruik geweest als café en logement, en als winkel. Uit de 18de of begin 19de eeuw dateren de hallenhuisboerderijen Kerkstraat 12, met dwarsdeel, en Hoofdstraat 25-27. De laatstgenoemde is na een ingrijpende verbouwing in gebruik als bibliotheek. De uit de eerste helft van de 19de eeuw daterende boerderij Hoofdstraat 3 heeft een dwars geplaatst woonhuis. Na de restauratie rond 1988 heeft het pand de functie van café en bierbrouwerij gekregen, waarbij de naam ‘Peizer Hopbel’ verwijst naar de hopteelt rond Peize in 17de en 18de eeuw. De uit 1907 daterende kop-rompboerderij De Horst 19 heeft als woongedeelte een middenganghuis met neorenaissance-detaillering. Het woonhuisgedeelte van Hoeve Woudrust (Groningerweg 38) is gebouwd in 1914 in nieuw historiserende stijl. Voorbeelden van krimpenboerderijen zijn De Horst 17 (1905) en De Horst 15 (1919), de laatste is uitgevoerd met zaadzoldervensters en kolossale ionische pilasters (zijgevel).

De windmolen ‘Paiser Meul’ (Molenpad 1) is een achtkantige stellingmolen met hoge gemetselde onderbouw en een met riet beklede romp en kap. Deze korenmolen werd oorspronkelijk in 1845 gebouwd als oliemolen in Enumatil (Gr) en in 1890 overgebracht naar de huidige plaats. Bij de restauratie in 1973 heeft men de houten bekleding vervangen door een rietbedekking.

De voorm. coöperatieve landbouwvereniging ‘Peize’ (Brinkweg 19) is een bedrijfsgebouw uit 1935, ontworpen door L.J. Elema & Zn. in zake-lijk-expressionistische vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peize (gemeente Noordenveld) – Tolhuizen"@nl ;
        min:adres "De Pol 22" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peize (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Peize" ;
        min:lemma "Tolhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0073> ;
        schema:name "Tolhuizen"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text """Tolhuizen. Het ten westen van Peize gelegen tolhuis Moleneind 1 heeft een gepleisterde cartouche met het bouwjaar ‘1884’ en siermetselwerk in verschillende kleuren baksteen. Te Peizerwold, ten noorden van Peize, staat het tolhuis Groningerweg 31, eveneens gebouwd in 1884 langs de toen aangelegde straatweg Roden-Peize-Groningen. Het door A. Schotanus ontworpen pand vertoont neorenaissance-details en heeft een houten geveltopversiering met makelaar en eenvoudige windveren.

De voorm. school De Pol 24, gelegen ten zuidoosten van Peize, is een rond 1925 opgetrokken L-vormig, drieklassig schoolgebouw met uitgebouwde ingangspartij. Naast de school staat de voorm. onderwijzerswoning (De Pol 22)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00676> a min:Passage,
