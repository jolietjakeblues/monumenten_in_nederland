        min:soort "inleiding" ;
        min:volgnummer 724 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0080> ;
        schema:name "Ruinerwold (gemeente De Wolden)"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "De voorm. Chr. lagere school (Wolddijk 26) werd in 1908 als een tweeklassige school gebouwd en in 1966 met een lokaal uitgebreid. De onderwijzerswoning dateert eveneens uit 1908."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0080.php> .

