        schema:name "Zuidlaren (gemeente Tynaarlo)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "In de zuidgevel van de toren heeft men de grafzerk voor predikant Jacobus Biben († 1784) ingemetseld. De voorm. pastorie (Kerkbrink 44) is een rond 1890 opgetrokken herenhuis met ingangsomlijsting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0107.php> .

