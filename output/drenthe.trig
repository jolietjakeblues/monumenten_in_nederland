        min:volgnummer 860 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0101> ;
        schema:name "Westerbork (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "De voorm. landbouwschool (Wilhelminastraat 27) is in 1940 gebouwd mogelijk naar ontwerp van J. Boelens. Het schoolgebouw met opvallende gebogen kapvorm en stalen vensters is thans in gebruik als speelgoedfabriek ‘Samenspel’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00861> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbork (gemeente Midden-Drenthe) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerbork (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Westerbork" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 861 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill302>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill303> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0101> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "205" ;
        schema:pagination "205-206" ;
        schema:text "Woonhuizen. Het rond 1890 gebouwde middenganghuis Hoofdstraat 33 vertoont neorenaissancedetails. Het vrijstaande, wit gepleisterde woonhuis Westeinde 16 (circa 1915) is een burgemeesterswoning geweest. Hoofdstraat 13 (circa 1930) heeft een karakteristieke samengestelde kap met overstek in traditionalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00862> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbork (gemeente Midden-Drenthe) – Boerderijen"@nl ;
        min:adres "Hoofdstraat 44" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerbork (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Westerbork" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 862 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0101> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text """Boerderijen. De met riet gedekte 19de-eeuwse hallenhuisboerderij Zandhoeklaan 23 heeft een achter- en een zijbaander. Zuidbrink 13, thans in gebruik als bibliotheek, is een 19de-eeuwse hallenhuisboerderij met een lang, deels onderkelderd woonhuis met de ingang in het midden van de lange gevel. Bij de boerderij staat een houten schaapskooi met rieten dak en decoraties van geknoopt stro. Museumboerderij ‘In de Ar’ (Hoofdstraat 44), gebouwd rond 1870 en gewijzigd in 1890, heeft een lang voorhuis en een inrijdeur in de achtergevel. Oosteinde 8 is een 19de-eeuwse boerderij met een fors tweelaags woonhuisgedeelte en een bedrijfsgedeelte met overhoeks geplaatste inrijdeuren. Krimpenboerderijen zijn Hoofdstraat 2 (1865) en Hoofdstraat 34 (1875); de laatste met een overhoeks geplaatste inrijdeur. De boerderij Hoofdstraat 35 heeft een vrijstaand dwars woonhuis uit 1893. De opvallende, moderne langhuisboerderij Oosteinde 2, met gebroken schilddak en Vlaamse geveltop aan de voorzijde, dateert uit circa 1920.

De windmolen Oosteinde 14, oorspronkelijk een achtzijdige stellingmolen met gemetselde onderbouw is in 1927 ontmanteld, waarbij de onderbouw is blijven staan.

De Alg. begraafplaats (Kerkhoflaan ong.), gesticht rond 1830, bevat diverse interessante graftekens, waaronder de zerken voor H. Nijsingh († 1840), mr. M.O. Gratema († 1900) en burgemeester L.N. Kymmell († 1933). De garage voor de lijkwagen stamt uit 1941."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00863> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbork (gemeente Midden-Drenthe) – Eursinge"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
