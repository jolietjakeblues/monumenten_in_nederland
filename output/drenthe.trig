        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 554 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0054> ;
        schema:name "Langelo (gemeente Noordenveld)"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op een uitloper van de hogere zandgronden van het Drentse plateau. De hoofdzakelijk agrarische bebouwing is gesitueerd rond de driehoekige Westerbrink en de driehoekige Schoolbrink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0054.php> .

