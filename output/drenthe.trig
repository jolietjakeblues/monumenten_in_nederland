        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0019> ;
        schema:name "Coevorden"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "De voorm. marechausseekazerne (Esschenbruggerdijk 10-14) dateert uit 1921 en is ontworpen door de te Zwolle gevestigde majoor-eerstaanwezend-ingenieur in opdracht van het Eerste Commandement Groningen. Het forse pand heeft een vooruitspringend tweelaags middendeel geflankeerd door eenlaags zijvleugels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00304> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Coevorden"@nl ;
        min:adres "Churchilllaan 13-75",
            "Churchilllaan 77" ;
