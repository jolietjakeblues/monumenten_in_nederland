        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21687> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "33787" ;
        min:soort "lemma" ;
        min:volgnummer 750 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0083> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text """Windmolen ‘De Hoop’ (Drostenstraat 16) is een met riet gedekte achtkantige stellingmolen met gemetselde onderbouw. Deze korenmolen werd in 1914 door molenmaker L. Reinds in opdracht van H. Berends vanuit Amersfoort overgebracht naar Sleen ter vervanging van een afgebrande voorganger. De molen is in 1978 gerestaureerd.

Het trafohuisje (tegenover Schaapstreek 2-4) is een blokvormig gebouwtje uit circa 1930 met expressionistische details."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00751> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sleen (gemeente Coevorden) – Erm"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
