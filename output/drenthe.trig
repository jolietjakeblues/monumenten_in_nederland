        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 609 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0062> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Kerken. Uit 1907 dateert de Geref. kerk (Weerdingerkanaal Z.Z. 116), een recht gesloten zaalkerk met in de boogvulling boven de ingang een opvallend mozaïek met diverse kleuren bricornasteen. De Herv. kerk (Weerdingerkanaal Z.Z. 143) is een sobere recht gesloten zaalkerk met geveltoren, opgetrokken in 1911. De voorm. Baptistenkerk (Weerdingerkanaal N.Z. 52) is een sobere recht gesloten zaalkerk met portaal, gebouwd in 1916."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00610> a min:Passage,
