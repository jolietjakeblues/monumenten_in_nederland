        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drouwen (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Drouwen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 347 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0025> ;
        schema:name "Drouwen (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "99" ;
        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text "Esdorp, ontstaan in de vroege middeleeuwen, mogelijk als dochternederzetting van Borger. Het dorp zonder kerk wordt omringd door vier essen en heeft een open structuur met daarin enkele brinkrestanten. De brink op de samenkomst van de Allinghoek en de Hoofdstraat is het best bewaard."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00348> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drouwen (gemeente Borger-Odoorn) – Boerderijen"@nl ;
        min:adres "Hoofdstraat 2" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Borger-Odoorn" ;
        min:gemeenteInBoek "Borger-Odoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borger-Odoorn> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drouwen (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Drouwen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 348 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0025> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "99" ;
        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text """Boerderijen. De boerderij Hoofdstraat 11 is een hallenhuisboerderij met onderschoer en voorhuis met zijingang uit circa 1850. De hallenhuisboerderij Hoofdstraat 17 werd in 1868 gebouwd en heeft een mooie deur in het midden van de kopse kant van het woongedeelte. Een latere variant hierop is de krimpenboerderij Stobbenweg 2 uit 1920-'21.

Het trafohuisje (bij Hoofdstraat 2) is rond 1930 gebouwd en heeft een zadeldak met sierkorbelen op de hoeken."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00349> a min:Passage,
