        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0105> ;
        schema:name "Zeyen (gemeente Tynaarlo)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "De openbare lagere school ‘Zeyen’ (Ubbenaseweg 3) is een later gewijzigd, drieklassig schoolgebouw uit circa 1910 met naastgelegen onderwijzerswoning (Ubbenaseweg 1), gebouwd volgens een door J. van Houten ontwikkeld schooltype met onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00883> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeyen (gemeente Tynaarlo) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Tynaarlo" ;
        min:gemeenteInBoek "Tynaarlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tynaarlo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeyen (gemeente Tynaarlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Zeyen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 883 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0105> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Boerderijen. Uit 1774 dateert Zuiderstraat 7, een met riet gedekte hallenhuisboerderij met schaapskooi, voorzien van een inrijdeur in de achtergevel. Vóór het oorspronkelijke woonhuis is rond 1850 een smallere eindkamer aangebouwd. Uit het begin van de 19de eeuw dateren de boerderij Brinkstraat 5 (1818), met zijbaander en de keuterij Hoofdstraat 21 (circa 1830) met dwarsdeel; beide zijn met riet gedekt. Hoofdstraat 14 is een karakteristiek voorbeeld van een moderne kop-rompboerderij uit circa 1930. De gevels van de ten zuiden van het dorp gelegen krimpenboerderij Zeyerweg 33 (circa 1925) zijn uitgevoerd in twee kleuren kalkzandsteen. De schuur is riet gedekt. De poldermolen aan de Oosterweg, een vóór 1930 gebouwde houten paaltjasker met tonmolen, is na restauratie in 1983 overgebracht naar de huidige plaats ten behoeve van de watercirculatie van een vennetje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00884> a min:Passage,
            schema:CreativeWork ;
