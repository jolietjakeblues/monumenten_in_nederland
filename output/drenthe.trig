        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loon (gemeente Assen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Loon" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 557 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0055> ;
        schema:name "Loon (gemeente Assen)"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "Esdorp zonder kerk, ontstaan in de vroege middeleeuwen op een dekzandrug. Het dorp heeft een es aan de noordzijde en groengronden langs het Loonerdiep aan de oostzijde. Aan de Asserweg hoek Balloërweg bevindt zich een grote driehoekige brink en aan de Markeweg hoek Balloërweg een kleine brink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00558> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loon (gemeente Assen) – Boerderijen"@nl ;
        min:adres "Asserstraat 5",
            "Balloërweg 7" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Assen" ;
        min:gemeenteInBoek "Assen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Assen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loon (gemeente Assen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Loon" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 558 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0055> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text """Boerderijen. De hallenhuisboerderij Markeweg 2 heeft mogelijk een 18de-eeuwse oorsprong. Het huidige aanzien dateert uit de 19de eeuw. In 1917 is een deel van het voorhuis verhoogd. Het erf is grotendeels nog met keitjes bestraat. De boerderij Asserweg 3 heeft een voorhuis met ingang in de langszijde, gebouwd in 1830 en verbouwd in 1872 voor J. Dockter. In opdracht van J. Bos werd in 1871 de boerderij Asserweg 13 gebouwd. De ouderwoning zal er niet veel later tegenaan zijn gebouwd. De in 1867 voor J. Smeenge gebouwde boerderij Lonerbroekweg 11 heeft een baander in de voorgevel. Festina Lente (Balloërweg 7) is een krimpenoerderij uit 1911, gebouwd voor J. Hofsteenge.

De voorm. smederij (Asserstraat 5) bestaat uit een bedrijfsgedeelte dat door middel van een krimp overgaat in een iets smaller eenlaags voorhuis met winkel- en woongedeelte. Het geheel werd in 1925 gebouwd in opdracht van H. Ratering."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00559> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loon (gemeente Assen) – Hunebed"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Assen" ;
        min:gemeenteInBoek "Assen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Assen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loon (gemeente Assen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Loon" ;
        min:lemma "Hunebed" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 559 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0055> ;
        schema:name "Hunebed"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "Hunebed. Ten noorden van Loon aan de noordzijde van de Looner es, bevindt zich hunebed D15 dat bestaat uit tien draag- en vijf dekstenen en twee paar poortzijstenen. Ook de steenkrans resteert nog grotendeels. Het mogelijk al in 1654 vermelde hunebed werd in 1870 van de dekheuvel ontdaan. In 1952 heeft onderzoek en restauratie plaatsgevonden. Verdere restauraties zijn gevolgd in 1965 en 1993."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00560> a min:Passage,
