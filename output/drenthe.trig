        min:kern "Smilde" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 758 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0084> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "185" ;
        schema:pageStart "185" ;
        schema:pagination "185" ;
        schema:text "Begraafplaatsen. De rond 1830 gestichte Oude Alg. begraafplaats (A.M. Sorgstraat ong.) heeft drie verhoogde, omhekte grafrijen. De Alg. begraafplaats ‘Kerkenveld’ (Kerkhoflaan ong.), gesticht rond 1890, bezit een landschappelijke aanleg en een smeedijzeren toegangshek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00759> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Smilde (gemeente Midden-Drenthe) – Hijkersmilde"@nl ;
        min:adres "Rijksweg 76",
            "Rijksweg 77",
            "Rijksweg 85" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Smilde (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Smilde" ;
        min:lemma "Hijkersmilde" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 759 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill269> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0084> ;
        schema:name "Hijkersmilde"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "185" ;
        schema:pagination "185-186" ;
        schema:text "Hijkersmilde. Dit langgerekte veenkoloniale kanaaldorp ten zuiden van Smilde is ontstaan in de tweede helft van de 18de eeuw. De voorm. marechausseekazerne (Rijksweg 85) heeft een tweelaags middengedeelte in eclectische stijl (circa 1860), geflankeerd door eenlaags vleugels van jonger datum. Het gebouw, dat voorheen bekend stond onder de naam ‘Nieuw Salverdt’, is van oorsprong een boerderij geweest, mogelijk van de familie Salverda uit Franeker. De rond 1910 opgetrokken forse krimpenboerderij Vaartweg 82 heeft een voorgevel met zoldervensters en omlijste ingang en een met riet gedekte schuur. De voorm. tramremise (Rijksweg 76) van de Nederlandsche Tramweg Maatschappij is gebouwd in 1915. Het langgerekte gebouw met late neorenaissance-detaillering bevatte oorspronkelijk ook een wachtkamer en loketruimte; nu is het een werkplaats met woonhuis. De bijbehorende woning (Rijksweg 77) is in dezelfde tijd en in dezelfde stijl gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00760> a min:Passage,
