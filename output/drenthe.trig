        schema:name "Anloo (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Het voorm. armenhuis (Lunsenhof 2-4) is een met riet gedekt, langgerekt eenlaagspand uit circa 1850 met daarin enkele kleine woningen en een schuurgedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00206> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anloo (gemeente Aa en Hunze) – Boerderijen"@nl ;
        min:adres "Lunsenhof 20" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Anloo (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Anloo" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12562> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "8157" ;
        min:soort "lemma" ;
        min:volgnummer 206 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill63> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0009> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "62" ;
        schema:pagination "62-63" ;
        schema:text """Boerderijen. Een mogelijk 17de-eeuwse oorsprong heeft de hallenhuisboerderij Homanshof (Lunsenhof 20), bestaande uit een langgerekt voorhuis en een bedrijfsgedeelte met onderschoer. Vergelijkbaar zijn de boerderijen Annerweg 2, mogelijk eveneens van 17de- of 18de-eeuwse oorsprong, en Kerkbrink 12 (1768). De hallenhuisboerderij Brinkstraat 5 heeft een gepleisterd voorhuis met daarin een dubbele woning. De boerderij heeft waarschijnlijk enige tijd als schultenhuis dienst gedaan. In de neuten van de toegangsdeur in de langszijde staat de datering ‘1733’; de kopse gevel heeft de jaartalankers ‘1818’. Het bedrijfsgedeelte is rond 1900 herbouwd. De gepleisterde boerderij Esweg 1, een hallenhuisboerderij met dwarsdeel, dateert in opzet uit circa 1870. De rond 1900 gebouwde boerderij Kerkbrink 4 heeft eveneens een dwarsdeel.

De Alg. begraafplaats (Bosweg ong.) werd in het midden van de 19de eeuw gesticht. Opvallend zijn de door D. Kalk vervaardigde rijke marmeren graftekens voor C.E. Kniphorst († 1901), met omfloerste gebroken zuil, en mw. M.M.J.J. Kniphorst († 1902) met biddende engel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00207> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anloo (gemeente Aa en Hunze) – Terborgh"@nl ;
        min:adres "Gasterenseweg 1",
            "Gasterenseweg 3" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
