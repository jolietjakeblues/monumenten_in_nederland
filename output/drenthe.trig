        min:kern "Hijken" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0046> ;
        schema:name "Hijken (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "Esdorp, ontstaan in de vroege middeleeuwen als dochternederzetting van Beilen. Dit dorp zonder kerk - met aan de noordzijde de Hijkeres - heeft twee grote brinkachtige ruimten. Bij een grote brand in 1822 zijn diverse boerderijen verloren gegaan. Door de aanleg van het Oranjekanaal (1858) werd het noordelijke deel van Hijken van de oude dorpskern afgescheiden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00505> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hijken (gemeente Midden-Drenthe)"@nl ;
        min:adres "Westeinde 7" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hijken (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hijken" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 505 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0046> ;
        schema:name "Hijken (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "De Geref. kerk (Westeinde 7) dateert uit 1906 en is een sobere zaalkerk met spitsboogvensters en een topgevel met hoekpilasters, blokversiering en afdeklijst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00506> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hijken (gemeente Midden-Drenthe) – Boerderijen"@nl ;
        min:adres "Drift 1" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hijken (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Hijken" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 506 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0046> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text """Boerderijen. De hallenhuisboerderij Westeinde 11, met rieten dak en onderschoer, heeft een aangebouwde bijschuur met decoraties in de vorm van geknoopt stro. Datzelfde geldt voor de boerderij Dorpsstraat 26.

De stoomzuivelfabriek annex korenmaalderij ‘De Goede Verwachting’ (Drift 1) dateert uit 1915 en bestaat uit een woonhuis, een kantoor en een bedrijfsgedeelte. Dit complex verving het gebouw van het gelijknamige, in 1896 opgerichte boterfabriekje, dat in 1908 werd gewijzigd in een stoomzuivelfabriek. Na de sluiting in 1928 heeft men het middengedeelte als kerkzaal gebruikt tot de bouw van een nieuwe Herv. kerk aan De Drift in 1960. Nu is het complex in gebruik als bedrijfsgebouw voor een veevoeder- en kunstmesthandel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00507> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollandscheveld (gemeente Hoogeveen)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
