        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52065>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55156> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "21038",
            "21039" ;
        min:soort "lemma" ;
        min:volgnummer 502 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0045> ;
        schema:name "Eursinge"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "Eursinge. Dit esgehucht ten zuidwesten van Havelte is ontstaan in de late middeleeuwen. Eursinge is een beschermd dorpsgezicht met diverse interessante hallenhuisboerderijen. In de kern laat-18de-eeuws is ‘Het Eursinger Hof’ (Eursingerlaan 8), een boerderij met langsdeel en aangebouwde houten bijschuur. Een 18de-eeuwse kern hebben mogelijk ook de met dwarsdeel uitgevoerde boerderijen Eursingerlaan 1 - met kruiskozijnen -, Busselterweg 2 en Busselterweg 8; de laatste heeft een deels onderkelderd voorhuis (circa 1790) en een vernieuwd stalgedeelte. Voorbeelden uit de 19de eeuw zijn: Eursingerlaan 3 (1846), de ‘Bralshoeve’ (Eursingerlaan 5; circa 1855) en ‘Ut Buut'nhuus’ (Eursingerlaan 4; circa 1860)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00503> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Havelte (gemeente Westerveld) – Veendijk"@nl ;
        min:adres "Veendijk 25" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Havelte (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Havelte" ;
        min:lemma "Veendijk" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 503 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill178> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0045> ;
        schema:name "Veendijk"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "Veendijk. Dit wegdorp ten zuidwesten van Havelte is een veenkolonie die teruggaat tot de tweede helft van de 18de eeuw en die in de eerste helft van de 19de eeuw verder tot ontwikkeling is gekomen. Enkele ontginningsboerderijen - alle met dwarsdeel - zijn: Veendijk 18 (circa 1890), Veendijk 10 (circa 1915), Veendijk 19-21 (circa 1915), met recent aangebouwde ouderwoning, en de met twee dwarsdelen uitgevoerde boerderij Veendijk 14 (circa 1920). De voorm. openbare lagere school (Veendijk 25) is een gepleisterde tweeklassige middengangschool uit 1912. Aardige woonhuizen zijn het eenlaags middenganghuis Veendijk 51 (circa 1915), met portiek en hoger opgetrokken middenrisaliet, en het tweelaags huis Veendijk 23 (circa 1935), dat zakelijk-expressionistische invloeden vertoont."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00504> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hijken (gemeente Midden-Drenthe)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
