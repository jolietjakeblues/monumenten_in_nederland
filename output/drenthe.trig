        min:soort "inleiding" ;
        min:volgnummer 599 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0060> ;
        schema:name "Nieuw-Buinen (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De Herv. kerk (Kerklaan 1), nu S.O.W.-kerk, is een L-vormige kerk, gebouwd in 1853 als zaalkerk met neoclassicistische elementen en een opengewerkte geveltoren. De kerk is in 1904 uitgebreid met een dwars geplaatste aanbouw. Tot de inventaris behoort een door de gebroeders Van Oeckelen gebouwd orgel (1879)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00600> a min:Passage,
