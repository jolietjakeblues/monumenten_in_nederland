        min:gemeenteInBoek "Borger-Odoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borger-Odoorn> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drouwenerveen (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Drouwenerveen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 355 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0026> ;
        schema:name "Drouwenerveen (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "De Alg. begraafplaats van Drouwenerveen en Drouwenermond (Verbindingsweg ong.), gesticht rond 1895, bevat onder meer een graf met postament en stèle voor H. Kamps († 1921). In een moderne ijzeren klokkenstoel hangt een klokje uit 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00356> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drouwenerveen (gemeente Borger-Odoorn) – Drouwenermond"@nl ;
        min:adres "Zuiderdiep 27",
            "Zuiderdiep 75" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Borger-Odoorn" ;
        min:gemeenteInBoek "Borger-Odoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borger-Odoorn> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drouwenerveen (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Drouwenerveen" ;
        min:lemma "Drouwenermond" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 356 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0026> ;
        schema:name "Drouwenermond"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Drouwenermond. Dit langgerekte kanaaldorp ten oosten van Drouwenerveen werd in 1823 gesticht, toen vanuit het Groningse Stadskanaal de Drouwenermond werd gegraven. In het Drentse gebied splitste dit kanaal zich in een dubbel kanaalsysteem. De overwegend oostwest gerichte veenkoloniale nederzetting kreeg slechts een beperkte bebouwing langs het Zuiderdiep. Het inmiddels overwegend gedempte Zuiderdiep liep westwaarts door tot aan de Drentse Mondenweg, de overgang naar het gebied van Drouwenerveen. De Herv. kapel (Zuiderdiep 27), nu S.O.W.-kerk, is een kleine zaalkerk uit 1920 met gepleisterde muurvlakken en een dakruiter. Langs het Zuiderdiep staan enkele boerderijen in de veenkoloniale variant van de krimpenboerderij. Ze hebben een wolfdak en zogeheten zaadzoldervensters (de zolders werden echter vooral gebruikt voor de opslag van pootaardappelen). Bij de boerderij Zuiderdiep 38 (circa 1880) liggen baander en voorgevel nog in één lijn; bij Zuiderdiep 48 (circa 1885) en Zuiderdiep 60 (circa 1900) is het woondeel versmald en liggen de baanderdeuren iets terug. Boerderij Zuiderdiep 33 (circa 1935) is een meer moderne variant. In het dorp staan twee rond 1930 gebouwde trafohuisjes (bij Zuiderdiep 75 en tegenover Zuiderdiep 65); beide hebben een zadeldak met sierkorbelen op de hoeken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00357> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dwingeloo (gemeente Westerveld)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Dwingeloo" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 357 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill128> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0027> ;
        schema:name "Dwingeloo (gemeente Westerveld)"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "100" ;
        schema:pagination "100-101" ;
        schema:text "Esdorp, ontstaan in de vroege middeleeuwen. De kerk staat aan de noordkant van een zeer grote veelhoekige brink met daarin nog een dobbe genaamd ‘De Riete’. Van de vier havezaten bij Dwingeloo, te weten Entinghe, Batinghe, Westrup en Oldengaerde (bij Westeinde), zijn alleen de laatste twee behouden. Tot in de 19de eeuw concentreerde de bebouwing zich hoofdzakelijk rond de Brink en langs de Heuvelenweg, de Entingheweg en het begin van het Moleneinde. In de tweede helft van de 19de eeuw en het begin van de 20ste eeuw werd de bestaande bebouwing verdicht en breidde het dorp zich uit langs de uitvalswegen, zoals de Drift, de Heuvelenweg en het Moleneinde. Bij dorpsbranden in 1895, 1923 en 1949 ging een deel van de oude dorpsbebouwing verloren. Na de Tweede Wereldoorlog is Dwingeloo hoofdzakelijk aan de oostzijde gegroeid. Dwingeloo is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00358> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dwingeloo (gemeente Westerveld)"@nl ;
        min:adres "Brink 29" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Westerveld" ;
        min:gemeenteInBoek "Westerveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dwingeloo (gemeente Westerveld)" ;
