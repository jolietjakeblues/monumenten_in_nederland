        schema:name "Ruinerwold (gemeente De Wolden)"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "Bij de kerk staan een rond 1930 gebouwd ketelhuis met tentdak en een kosterswoning (Blijdenstein 1) met stal uit circa 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00723> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ruinerwold (gemeente De Wolden)"@nl ;
        min:adres "Dijkhuizen 7",
            "Dijkhuizen 97" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "De Wolden" ;
        min:gemeenteInBoek "De Wolden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Wolden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ruinerwold (gemeente De Wolden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Ruinerwold" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 723 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0080> ;
        schema:name "Ruinerwold (gemeente De Wolden)"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "De Herv. kapel (Dijkhuizen 97) is een recht gesloten zaalgebouw, opgetrokken in 1912 voor de Vereniging voor Evangelisatie en vergroot in 1925. Het voorm. raadhuis (Dijkhuizen 7) is een dwars eenlaagspand in neorenaissance-stijl met tot trapgevels opgetrokken hoekrisalieten en een uurwerk in het midden. Het gebouw kwam in 1903 tot stand naar plannen van G. Otten ter plaatse van een voorganger uit 1848, waarvan de ‘eerste steen’ werd herplaatst in de nieuwe zijgevel. De uitbreiding aan de achterzijde is in 1950 uitgevoerd naar ontwerp van F.O. Bloembergen. Het gebouw is in 1993 gerestaureerd en opnieuw uitgebreid naar ontwerp van architectenbureau Wouda & Van der Schaaf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00724> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ruinerwold (gemeente De Wolden)"@nl ;
        min:adres "Wolddijk 26" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
