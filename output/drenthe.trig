        schema:pageStart "110" ;
        schema:pagination "110" ;
        schema:text "De Herv. kerk (Haulerwijksterweg 1) is een eenvoudige, recht gesloten zaalkerk uit 1913 met rondboogvensters en houten geveltoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0030.php> .

