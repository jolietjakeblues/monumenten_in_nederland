        min:soort "inleiding" ;
        min:volgnummer 626 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill219> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0066> ;
        schema:name "Nijeveen (gemeente Meppel)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "Wegdorp, ontstaan in de 14de eeuw op een zandrug als randveenontginning. Met het verder opstrekken van de ontginning kwam ten noorden van Nijeveen een tweede bebouwingslint tot ontwikkeling langs de Nijeveense Bovenboer. Na de Tweede Wereldoorlog is de dorpskern van Nijeveen, nabij de kruising van de huidige Dorpsstraat en de Molenstraat, sterk gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00627> a min:Passage,
