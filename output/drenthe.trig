        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Echten" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 372 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0028> ;
        schema:name "Echten (gemeente De Wolden)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen nabij het Huis te Echten. De familie Van Echten heeft grote invloed gehad op de ontwikkeling en ontginning van het omliggende veengebied. De bebouwing van het dorp concentreert zich in de omgeving van de havezate. Na de Tweede Wereldoorlog is het dorp aan de zuidzijde enigszins uitgebreid. Echten is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00373> a min:Passage,
