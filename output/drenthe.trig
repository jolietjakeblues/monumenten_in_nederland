        schema:name "Zwartemeer (gemeente Emmen)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "De Geref. kerk (Verlengde Van Echtenkanaal N.Z. 33), een sobere zaalkerk met geveltoren, is in 1921 tot stand gekomen naar plannen van B.T. Kleinenberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0110.php> .

