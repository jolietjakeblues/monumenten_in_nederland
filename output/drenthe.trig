        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Woonhuizen. Het woonhuis Bonnerveen 8 (circa 1915) vertoont chaletstijl-elementen en heeft twee kruisende zadeldaken. Dat is ook het geval bij het in zakelijk-expressionistische vormen uitgevoerde huis Broek 18 (circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0043.php> .

