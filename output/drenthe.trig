        schema:name "Pesse (gemeente Hoogeveen)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Het voorm. woonhuis-kantoor van de rijkspolitie (Dorpsstraat 1-3) dateert uit circa 1935 en vertoont zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00680> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Pesse (gemeente Hoogeveen) – Boerderijen"@nl ;
        min:adres "Beilerstraat 6",
            "Hoogeveenseweg 2" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Pesse (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Pesse" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 680 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0074> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Boerderijen. De hallenhuisboerderij Kerkweg 1, uitgevoerd met twee dwarsdelen, kreeg rond 1850 zijn huidige vorm, maar heeft mogelijk een oudere kern. De boerderij Unicum (Hoogeveenseweg 2) is in 1911 gebouwd naar ontwerp van J. Carmiggelt en heeft een dwars geplaatst voorhuis met een tot topgevel opgetrokken middenrisaliet. Nuil. Dit ten noorden van Pesse gelegen gehucht heeft een aardige dubbeldriehoekige brink met enkele interessante hallenhuisboerderijen, zoals Beilerstraat 5 (circa 1860), met middenlangsdeel en aangebouwde houten schuur en bijschuur, het ingrijpend gerestaureerde ‘Lindshoes’ (Beilerstraat 6; circa 1860), met twee dwarsdelen, en Beilerstraat 7 (circa 1869), met middenlangsdeel, aangebouwde schuur en deels vernieuwde gevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00681> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Pesse (gemeente Hoogeveen) – Eursinge"@nl ;
        min:adres "Eursinge 9" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Pesse (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Pesse" ;
        min:lemma "Eursinge" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 681 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0074> ;
        schema:name "Eursinge"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Eursinge (gemeente De Wolden). Esgehucht ten noordwesten van Pesse. Interessante hallenhuisboerderijen zijn de rond 1800 gebouwde boerderij Eursinge 2 met langsdeel en een naar rechts uitgebouwd voorhuis, en de in 1931 opgetrokken boerderij Eursinge 12 met dwarsdeel. De voorm. onderwijzerswoning (Eursinge 9) is een middenganghuis uit circa 1912 met jugendstil-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00682> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Pesse (gemeente Hoogeveen) – Kraloo"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Hoogeveen" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoogeveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Pesse (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Pesse" ;
        min:lemma "Kraloo" ;
