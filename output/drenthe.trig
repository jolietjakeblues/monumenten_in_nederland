        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25260>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35087> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "507324",
            "509322" ;
        min:soort "inleiding" ;
        min:volgnummer 818 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0093> ;
        schema:name "Vledder (gemeente Westerveld)"@nl ;
        schema:pageEnd "197" ;
        schema:pageStart "197" ;
        schema:pagination "197" ;
        schema:text "Het voorm. raadhuis (Brink 1) is een blokvormig eenlaagspand, gebouwd in 1901-'02 als gemeentehuis annex logement naar ontwerp van A. de Boer en voorzien van een forse dakkapel met pilasters en een doorbroken fronton met uurwerk. Aan de achterzijde bevinden zich uitbreidingen uit circa 1985."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0093.php> .

