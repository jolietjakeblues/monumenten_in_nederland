        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0017> ;
        schema:name "Bovensmilde (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De voorm. School met den Bijbel (Kanaalweg 139-140) is rond 1900 gebouwd als een drieklassige lagere school met aangebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00281> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bovensmilde (gemeente Midden-Drenthe) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Midden-Drenthe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bovensmilde (gemeente Midden-Drenthe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Bovensmilde" ;
        min:lemma "Boerderijen" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 281 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0017> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Boerderijen. De forse kop-rompboerderij Hoofdweg 220 uit circa 1860 heeft een wit gepleisterd neoclassicistisch woonhuisgedeelte met zolderetage en ingangsomlijsting en een grote, deels met riet gedekte schuur. Het eveneens wit gepleisterde woonhuis van de boerderij Kanaalweg 150 bezit een eclectische detaillering. De schuur is vernieuwd. Kanaalweg 130 is een kop-rompboerderij uit circa 1910, voorzien van een met riet gedekte schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00282> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Buinen (gemeente Borger-Odoorn)"@nl ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Borger-Odoorn" ;
        min:gemeenteInBoek "Borger-Odoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borger-Odoorn> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Buinen (gemeente Borger-Odoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Buinen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 282 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0018> ;
        schema:name "Buinen (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen als dochternederzetting van Borger. Buinen ligt tussen het Voorste en het Achterste Diep, twee beken die aan de noordzijde van het dorp in de Hunze overgaan. Het langgerekte dorp zonder brink en zonder kerk bevindt zich tussen een noorder- en een zuideres. De aansluiting van het dorp in 1905 op de spoorlijn Emmen-Stadskanaal (opgeheven in 1963) leidde niet tot noemenswaardige uitbreidingen. Aansluitend op het in 1905 tot Buinen doorgetrokken Zuiderdiep groef men in 1926-'31 aan de noordzijde om Buinen heen het kanaal Buinen-Schoonoord."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00283> a min:Passage,
            schema:CreativeWork ;
