        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42513> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "30807" ;
        min:soort "inleiding" ;
        min:volgnummer 791 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "Veenhuizen is de hiërarchische verstening van orde en tucht. Deze indruk wordt versterkt door strenge architectonische details en benadrukt door de strakke ordening van de ruimte. In het gevangenismuseum (Hoofdweg 8) wordt een beeld geschetst van de geschiedenis deze bijzondere penitentiaire nederzetting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00792> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Hoofdweg 114" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 792 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill279> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De Herv. kerk (Hoofdweg 114) is een achtkantige neoclassicistische koepelkerk voorzien van een tentdak met houten lantaarn, gebouwd in 1825-'26 naar plannen van H. Wind en naar voorbeeld van de koepelkerk in Smilde. Aan vier zijden bevindt zich een omlijste ingang, met boven de hoofdingang de ‘eerste steen’, gelegd door mevr. R.W. van den Bosch-De Sturler. Het in 1960-'61 gerestaureerde interieur wordt bepaald door de koepel op acht dorische zuilen en de omgang met galerij. Tot de inventaris uit de bouwtijd behoren een preekstoel, kerkenraadbanken en banken op de galerij. Het orgel is in 1820 door J.A. Hillebrand gebouwd voor de Herv. kerk te Akkrum en in 1856 door P. van Oeckelen & Zn. overgebracht en uitgebreid (gerestaureerd in 1963-'64)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00793> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenhuizen (gemeente Noordenveld)"@nl ;
        min:adres "Hoofdweg 110" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Noordenveld" ;
        min:gemeenteInBoek "Noordenveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordenveld> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veenhuizen (gemeente Noordenveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Veenhuizen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 793 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0091> ;
        schema:name "Veenhuizen (gemeente Noordenveld)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De voorm. kosterswoning (Hoofdweg 110), een wit gepleisterde woonhuisje uit 1865 dat bekend staat als het pannenkoekhuisje, dient tegenwoordig als kerkelijk verenigingsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0091.php> .

