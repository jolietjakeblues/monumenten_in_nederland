        schema:name "Witteveen (gemeente Midden-Drenthe)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Ontginningsdorp, ontstaan in 1926 op initiatief van de ontginningsmaatschappij N.V. Het Landschap Drenthe. Toen werd begonnen met de bouw van vijftig arbeiderswoningen aan weerszijden van de Mr. J.B. Kanweg en de Mr. Harm Smeengeweg. Langs de Mr. J.B. Kanweg werd een groenstrook aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0104.php> .

