        min:kern "Nieuweroord" ;
        min:lemma "Nieuw-Balinge" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 617 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0063> ;
        schema:name "Nieuw-Balinge"@nl ;
        schema:pageEnd "156" ;
        schema:pageStart "156" ;
        schema:pagination "156" ;
        schema:text "Nieuw-Balinge (gemeente Midden-Drenthe). Deze ontginningsnederzetting ten noordoosten van Nieuweroord is ontstaan rond 1830 bij de ontginning van het Mantingerveld. De Chr. Geref. kerk (Verlengde Middenraai 97) is een eenvoudige zaalkerk met rondboogvensters, gebouwd in 1907 ter plaatse van een voorganger uit 1834. De naastgelegen voorm. pastorie dateert uit 1921. De Herv. kerk (Verlengde Middenraai 38) is een aardige zaalkerk met slanke opengewerkte dakruiter, gebouwd in 1955 in traditionalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00618> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuweroord (gemeente Hoogeveen) – Tiendeveen"@nl ;
        min:adres "Kerkweg 3",
            "Schoolweg 11" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Midden-Drenthe" ;
        min:gemeenteInBoek "Hoogeveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Drenthe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuweroord (gemeente Hoogeveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Nieuweroord" ;
