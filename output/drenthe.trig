        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Dorp, ontstaan als randveenwegdorp aan de oostzijde van het Achterste of Grote Diep. De overwegend noord-zuid gerichte nederzetting ontstond vanuit Drouwen vanaf 1820."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0026.php> .

