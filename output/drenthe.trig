        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmer-Compascuum (gemeente Emmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmer-Compascuum" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 428 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0035> ;
        schema:name "Emmer-Compascuum (gemeente Emmen)"@nl ;
        schema:pageEnd "117" ;
        schema:pageStart "117" ;
        schema:pagination "117" ;
        schema:text "De Herv. kerk van Emmer-Compascuum (De Runde Z.Z. 108) is een recht gesloten zaalkerk met van een terzijde staande ongelede toren met zadeldak. De in 1925 opgetrokken kerk vertoont zakelijk-expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00429> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmer-Compascuum (gemeente Emmen)"@nl ;
        min:adres "Hoofdkanaal O.Z. 81",
            "Kloosterweg 2",
            "Kloosterweg 40-42" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Emmen" ;
        min:gemeenteInBoek "Emmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmer-Compascuum (gemeente Emmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmer-Compascuum" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 429 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill157> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0035> ;
        schema:name "Emmer-Compascuum (gemeente Emmen)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "117" ;
        schema:pagination "117-118" ;
        schema:text "De R.K. St-Willehaduskerk van Munsterseveld (Kloosterweg 2) is een forse driebeukige kruiskerk met ingangsportaal en een terzijde staande, ongelede toren met tentdak. De kerk, die neoromaanse invloeden vertoont, kwam in 1924-'26 tot stand naar ontwerp van H. Kroes ter plaatse van een voorganger uit 1889. H.J. Bakx ontwierp de in 1959 toegevoegde bidkapel. De kerk is in 1992 gerestaureerd en bevat een door de firma Verschueren gebouwd orgel (circa 1958). Op het kerkhof bevinden zich onder meer een postament met kruis voor J.G. Hoge († 1906) en het priestergraf van J.J. Swildens († 1949). Tot het katholieke complex behoort huize St. Hendricus (Kloosterweg 40-42), gebouwd rond 1920 als zusterhuis bij het in 1917 gestichte meisjespensionaat en de uit 1915 daterende R.K. Leer-, naai en bewaarschool. Verder is er nog de voorm. R.K. huishoudschool ‘Mariahof’ (Hoofdkanaal O.Z. 81), een tweelaags pand met expressionistische details uit 1924."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00430> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmer-Compascuum (gemeente Emmen) – Overige kerken"@nl ;
        min:adres "De Runde N.Z. 110",
            "Hoofdkanaal W.Z. 9",
            "Kanaal A N.Z. 106",
            "Kanaal A N.Z. 219",
            "Middenweg O.Z. 5" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Emmen" ;
        min:gemeenteInBoek "Emmen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmer-Compascuum (gemeente Emmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmer-Compascuum" ;
        min:lemma "Overige kerken" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 430 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0035> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text """Overige kerken. De Geref. kerk van Emmer-Erfscheidenveen (Middenweg O.Z. 5) is een zaalkerk met zakelijk-expressionistische details uit circa 1925. De kerk voor Chr. Samenkomsten te Emmer-Erfscheidenveen (Kanaal A N.Z. 106) is een zaalkerk uit 1939, opgetrokken in traditionalistische vormen met portaal en steunberen. De Geref. kerk van Emmer-Compascuum (Hoofdkanaal W.Z. 9) is een moderne zaalkerk uit circa 1950 met open geveltoren.

Het voorm. postkantoor van Emmer-Erfscheidenveen (Kanaal A N.Z. 219), bestaande uit een woonhuis met aangebouwd kantoor en ingang op de hoek, is gebouwd in 1913.

Het voorm. buurthuis (De Runde N.Z. 110) is een eenlaagspand uit 1926 met in het midden een zaal met verhoogde lichtbeuk."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00431> a min:Passage,
