        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Wolden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Echten (gemeente De Wolden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Echten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79359>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79360>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79361>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79362>,
