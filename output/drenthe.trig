        min:gemeente "Coevorden" ;
        min:gemeenteInBoek "Coevorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Coevorden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wachtum (gemeente Coevorden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Wachtum" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 834 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0095> ;
        schema:name "Wachtum (gemeente Coevorden)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "De voorm. openbare lagere school (Middendorp 25) is in 1891 gebouwd als een drieklassige gangschool."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00835> a min:Passage,
