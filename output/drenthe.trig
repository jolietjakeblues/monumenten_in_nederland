        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Emmen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Emmen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 410 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/afbeelding/sten009monu07ill149> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0034> ;
        schema:name "Emmen"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "Het gepleisterde kerkinterieur wordt gedekt door een gestukadoord houten tongewelf met trekstangen en een omlopende kooflijst. Het interieur is gerestaureerd in 1964-'65. Tot de inventaris behoren een doopvont van Bentheimer zandsteen (eerste helft 13de eeuw), drie 17de-eeuwse grafzerken en een door R. Meijer gebouwd orgel (1872-'73)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00411> a min:Passage,
