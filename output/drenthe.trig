        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De Geref. kerk (Hoogeveenseweg 22), een recht gesloten zaalkerk met dakruiter en twee ingangsportalen, is in 1937 opgetrokken in traditionalistische vormen. De consistorie en de pastorie (Hoogeveenseweg 20) dateren van circa 1955."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00679> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Pesse (gemeente Hoogeveen)"@nl ;
        min:adres "Dorpsstraat 1-3" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
