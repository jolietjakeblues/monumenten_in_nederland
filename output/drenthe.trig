        min:hoofdstuk "Steden, dorpen, monumenten › Gieterveen (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Gieterveen" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 483 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0043> ;
        schema:name "Gieterveen (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Dorp, ontstaan kort na 1450 vanuit Gieten op een langgerekte zandopduiking aan de oostzijde van de Hunze. In 1840 werd Gieterveen een zelfstandige parochie. In de 20ste eeuw is het dorp vooral aan de oostzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00484> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gieterveen (gemeente Aa en Hunze)"@nl ;
        min:adres "Broek 5",
            "Broek 7" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Aa en Hunze" ;
        min:gemeenteInBoek "Aa en Hunze" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aa_en_Hunze> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gieterveen (gemeente Aa en Hunze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Gieterveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30628> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "16131" ;
        min:soort "inleiding" ;
        min:volgnummer 484 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0043> ;
        schema:name "Gieterveen (gemeente Aa en Hunze)"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "De Herv. kerk (Broek 7) is een recht gesloten zaalkerk uit 1840 met neoclassicistische ingangsomlijsting, spitsboogvensters, schilddak en een vierkante opengewerkte dakruiter met ingesnoerde spits. In de dakruiter hangt een door Cyprianus Crans gegoten klok (1732). Rond 1915 is aan de achterzijde een consistoriekamer aangebouwd. De kerk bevat een preekstoel uit de bouwtijd. De pastorie (Broek 5) is een middenganghuis met breed dakerker uit circa 1840."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0043.php> .

