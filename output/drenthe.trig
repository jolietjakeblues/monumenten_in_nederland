        min:kern "Borger" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 268 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0016> ;
        schema:name "Borger (gemeente Borger-Odoorn)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text "Tot de kerkinventaris behoren: een 17de-eeuwse zerk boven de grafkelder van de broers ds. J.A. Erkelenswijk († 1820) en mr. W.H. Erkelenswijk († 1820), een in 1833 met ijzer beslagen laat-17de-eeuws offerblok en een door H.E. Freytag gebouwd orgel (1855; gerestaureerd in 1979). De gebrandschilderde ramen dateren uit 1939, 1945 en 1956."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00269> a min:Passage,
