        schema:name "Vries (gemeente Tynaarlo)"@nl ;
        schema:pageEnd "199" ;
        schema:pageStart "199" ;
        schema:pagination "199" ;
        schema:text "De (Geref.) Ontmoetingskerk (Oude Asserstraat 40) is in 1969 gebouwd naar plannen van W. Ingwersen, honderd jaar na de eerste Geref. kerk aan de Oude Asserstraat. De asymmetrisch opgebouwde kerk heeft een lessenaardak met aan de hoge zijde een lichtbeuk en een open klokkentoren aan de voorkant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00825> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vries (gemeente Tynaarlo)"@nl ;
