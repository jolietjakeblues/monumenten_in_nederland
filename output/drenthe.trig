        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Coevorden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Coevorden" ;
        min:provincie "Drenthe" ;
        min:soort "inleiding" ;
        min:volgnummer 293 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0019> ;
        schema:name "Coevorden"@nl ;
        schema:pageEnd "88" ;
        schema:pageStart "88" ;
        schema:pagination "88" ;
        schema:text "De Geref. kerk (Van Heutszsingel 21) [4] is een recht gesloten kruiskerk uit 1912 voorzien van een geveltoren met achthoekige lantaarn en spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00294> a min:Passage,
