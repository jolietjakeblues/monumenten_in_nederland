        min:kern "Roden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59452>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59802> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "478209",
            "478210" ;
