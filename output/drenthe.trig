        schema:pageEnd "156" ;
        schema:pageStart "156" ;
        schema:pagination "156" ;
        schema:text "Ontginningsdorp, ontstaan kort voor 1850 met de ontginning van het zuidelijk hoogveengebied van Westerbork. In korte tijd ontwikkelde zich een lintbebouwing langs de Middenraai."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0063.php> .

