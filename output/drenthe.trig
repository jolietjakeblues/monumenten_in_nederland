        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0062> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "156" ;
        schema:pageStart "155" ;
        schema:pagination "155-156" ;
        schema:text "Woonhuizen. Het woonhuis Weerdingerkanaal N.Z. 207, gebouwd rond 1920 in een combinatie van chaletstijl- en jugendstil-elementen, heeft een opvallend rijk sierspant. Soberder van vorm is Weerdingerkanaal N.Z. 107 (circa 1910). Late jugendstil-details vertoont het woon- en winkelpand Tramwijk N.Z. 1 (circa 1915), waarvan de ingangspartij op de hoek wordt geaccentueerd door een extra bouwlaag."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0062.php> .

