            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68412> ;
        min:provincie "Drenthe" ;
        min:rijksmonumentnummer "393990",
            "41094" ;
        min:soort "lemma" ;
        min:volgnummer 904 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0107> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "Windmolen ‘De Wachter’ (Havenstraat 36) is een achtkantige stellingmolen met een met riet beklede kap en romp op een gemetselde vierkante onderbouw. Aan weerszijden van de hoge onderbouw is een woning opgetrokken. De molen werd in 1851 gebouwd als olie- en korenmolen en is in 1978 gerestaureerd. In een bijgebouwde bedrijfsruimte bevindt zich een grote compound-stoommachine uit 1895, die rond 1960 naar hier is overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00905> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidlaren (gemeente Tynaarlo) – De Groeve"@nl ;
        min:adres "Hunzeweg 18-20",
            "Hunzeweg 4",
            "Hunzeweg 82",
            "Hunzeweg 84" ;
        min:deel "Monumenten in Nederland. Drenthe" ;
        min:gemeente "Tynaarlo" ;
        min:gemeenteInBoek "Tynaarlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tynaarlo> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Drenthe> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidlaren (gemeente Tynaarlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01> ;
        min:kern "Zuidlaren" ;
        min:lemma "De Groeve" ;
        min:provincie "Drenthe" ;
        min:soort "lemma" ;
        min:volgnummer 905 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0107> ;
        schema:name "De Groeve"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text """De Groeve. Deze nederzetting ten noordoosten van Zuidlaren is ontstaan na 1850. De openbare lagere school ‘De Schuthoek’ (Hunzeweg 82) is rond 1925 gebouwd als een tweeklassige school in expressionistische vormen. De naastgelegen onderwijzerswoning (Hunzeweg 84) dateert uit dezelfde tijd. De voorm. zuivelfabriek (Hunzeweg 18-20) werd in 1893 opgericht en kreeg het huidige zakelijk-expressionistische uiterlijk bij een verbouwing rond 1935.

Opvallend zijn de geglazuurde tegels op de gevelhoeken. Op de grens van Zuidlaren en De Groeve staat de poldermolen ‘De Boezemvriend’ (Hunzeweg 4), een achtkantige grondzeiler voorzien van een vijzel. De molen heeft gemetselde veldmuren, een met hout beklede romp en een met dakleer beklede kap. De molen werd in 1871 gebouwd door molenmaker P. Medendorp ter vervanging van een voorganger. De in 1990 gerestaureerde molen dient nu als hulpbemaling voor het Waterschap Oostermoerse Vaart."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00906> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidlaren (gemeente Tynaarlo) – Zuidlaarderveen"@nl ;
