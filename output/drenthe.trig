        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "De Ten Darperschoele (Ten Darperweg 50) is een drieklassige gangschool uit circa 1910 met latere wijzigingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00839> a min:Passage,
            schema:CreativeWork ;
