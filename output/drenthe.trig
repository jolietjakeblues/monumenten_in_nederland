        min:volgnummer 887 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/hoofdstuk/0106> ;
        schema:name "Zorgvlied (gemeente Westerveld)"@nl ;
        schema:pageEnd "209" ;
        schema:pageStart "209" ;
        schema:pagination "209" ;
        schema:text "De Herv. kapel (Dorpsstraat 5) is een houten veldkapel met omlijste ingang en kleine geveltoren, gebouwd in 1904 en in 1968 aan de voorzijde uitgebreid. Het gebouw bevat een in 1785 door J.S. Strümphler gebouwd orgel (gerestaureerd rond 1969)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00888> a min:Passage,
