        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "De openbare lagere school (Greveling 137) is een goed gedetailleerde tweeklassige gangschool met ingangsportaal, gebouwd rond 1955."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu07_01/sten009monu07_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu07_01/passage/00219> a min:Passage,
