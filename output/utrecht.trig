        schema:name "De Bilt"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De voorm. bewaarschool (Burg. De Withstraat 2) uit 1872 was oorspronkelijk een school ter grootte van drie lokalen. Het pand is in 1895 aan de achterzijde en in 1932 aan de rechterzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00298> a min:Passage,
