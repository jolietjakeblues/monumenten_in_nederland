        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0048> ;
        schema:name "Loosdrecht"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Het gemeentehuis (Nieuw-Loosdrechtsedijk 2) is in 1880 als combinatie van gemeentehuis, postkantoor, veldwachters- en dokterswoning gebouwd, naar een ontwerp van de Haarlemse architect D.E.L. van den Arend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00546> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loosdrecht"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Wijdemeren" ;
