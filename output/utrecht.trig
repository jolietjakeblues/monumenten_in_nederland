        schema:name "Eemnes"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "Het tolhuis aan de Wakkerendijk zal uit circa 1830 dateren. Het is tegen een boerderij aangebouwd (Wakkerendijk 168-170)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0028.php> .

