            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35033>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37437>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47531>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51042>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58703> ;
