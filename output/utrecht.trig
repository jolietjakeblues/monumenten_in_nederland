        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "26453",
            "26454",
            "520610" ;
        min:soort "lemma" ;
        min:volgnummer 592 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill254> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0053> ;
        schema:name "Leeuw en Vecht"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text """Leeuw en Vecht (Straatweg 23) is een laag, wit gepleisterd huis met een verhoogde middenpartij en eclectische versieringen, omstreeks 1860 gebouwd nadat het oorspronkelijke huis was afgebrand. Bij het huis staat een tot woonhuis verbouwd koetshuis uit dezelfde tijd. Voorts is er een groot, wit gepleisterd theehuis uit het eind van de 18de eeuw, voorzien van een met lood gedekt koepeldak en 19de-eeuwse vensters.

De vrij afgelegen Joodse begraafplaats (Machinekade) dateert uit 1749. Er liggen enkele omgevallen grafstenen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00593> a min:Passage,
            schema:CreativeWork ;
