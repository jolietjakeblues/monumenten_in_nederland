        schema:name "Anderstein"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "Anderstein (Andersteinweg 2) is een buitenhuis uit 1913, gebouwd in Engelse landhuisstijl naar ontwerp van J. Stuivinga voor H.A. van Beuningen. Op het terrein bevindt zich onder andere een vroeg voorbeeld van een betonnen zwembassin met badhuisje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0052.php> .

