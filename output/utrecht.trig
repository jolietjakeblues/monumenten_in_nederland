        min:hoofdstuk "Steden, dorpen, monumenten › De Bilt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "De Bilt" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 293 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0017> ;
        schema:name "De Bilt"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De R.K. St.-Michaëlskerk (Kerklaan 31) is een zaalkerk in de traditionele vormen van de Delftse School. Ze heeft een open klokkenstoel en een portaal met drie hoge rondbogen. Het gebouw verrees in 1955 naar ontwerp van B.J. en H.M. Koldewey, en verving een neogotische kerk uit 1893-'94 van A. Tepe."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00294> a min:Passage,
