        schema:name "Gemalen"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Gemalen. Bij Harmelen zijn twee gemalen met dienstwoning te vinden, namelijk Utrechtsestraatweg 1 uit 1878 (verbouwd 1923) en Gerverskop 5 uit 1907."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0033.php> .

