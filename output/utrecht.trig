        min:volgnummer 957 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill501>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill502> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0087> ;
        schema:name "Molenbosch"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "319" ;
        schema:pagination "319-320" ;
        schema:text "Molenbosch (Driebergseweg 7) is een blokvormig landhuis, dat in 1837 werd gebouwd naar ontwerp van J.D. Zocher jr. in opdracht van de Amsterdammer J.B. Stoop. Het bakstenen gebouw, in neo-Grec, wordt geleed door enkele en dubbele kolossale pilasters die een zwaar hoofdgestel dragen. Het portiek in het midden van de voorzijde is ingebouwd en heeft Grieks-dorische zuilen. Tegen de achtergevel bevindt zich een houten veranda, ongeveer uit 1898. In het landschapspark staan enkele 19de-eeuwse bijgebouwen, waaronder een koetshuis, een tuinmanswoning, een houten tuinprieel en een aardig, zeshoekig kippenhuis uit 1898."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0087.php> .

