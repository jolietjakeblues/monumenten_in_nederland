        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "Mariënhof (Diependaalsedijk 52). Klein, rechthoekig 18de-eeuws landhuis met omlopend schilddak en een gave Lodewijk XVI-omlijsting van ingang en bovenvenster. Verder is er een laag smeedijzeren hek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0053.php> .

