        min:volgnummer 360 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0024> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Boerderijen. In en rond het dorp staan enkele interessante boerderijen, zoals Brink 5, een dwarshuisboerderij uit 1815, Brink 6, een combinatie met een herberg uit 1902 en de Cloetingshofstede (Caspergauw 8), een krukhuisboerderij uit circa 1700, in 1890 verbouwd in opdracht van de familie Van Beeck Calckoen van Rhijnestein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00361> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Cothen – Korenmolen"@nl ;
        min:adres "Kerkweg 24",
            "Molenplein 1" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Wijk bij Duurstede" ;
        min:gemeenteInBoek "Cothen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wijk_bij_Duurstede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Cothen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Cothen" ;
        min:lemma "Korenmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71529>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71532> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "532494",
            "532497" ;
        min:soort "lemma" ;
        min:volgnummer 361 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0024> ;
        schema:name "Korenmolen"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text """Korenmolen. Het dorpssilhouet wordt mede bepaald door de molen Oog in 't Zeil (Molenplein 1), een ronde bakstenen stellingkorenmolen, in 1869-'70 gebouwd na het afbranden van de oude houten standerdmolen. In 1936 onttakelde men de molen tot een stenen romp; in 1986-'87 volgde een restauratie waarbij hij weer compleet werd gemaakt.

De Schutsluis in de Kromme Rijn, met bijbehorende sluiswachterswoning (Kerkweg 24), is in 1870 aangelegd in het kader van de Nieuwe Hollandse Waterlinie. De Kromme Rijn diende toen als inundatiekanaal en daarvoor moesten een aantal bochten afgesneden en drie sluizen gebouwd worden."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00362> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Dolder (gemeente Zeist)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Zeist" ;
        min:gemeenteInBoek "Zeist" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zeist_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Dolder (gemeente Zeist)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Den Dolder" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 362 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0025> ;
        schema:name "Den Dolder (gemeente Zeist)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Den Dolder kwam in 1895 tot ontwikkeling na opening van een spoorweghalte aan de lijn Utrecht-Amersfoort. De buurtschap kreeg haar naam in 1911. Vlakbij de halte werd in 1902 de zeepfabriek ‘De Duif’ gevestigd; de fabriek is verdwenen maar de bijbehorende arbeiderswoningen zijn bewaard gebleven. In de bosrijke omgeving ontstonden verscheidene herstellingsoorden en inrichtingen, waaronder de Willem Arntszhoeve."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00363> a min:Passage,
