        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oudewater_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hekendorp (gemeente Oudewater)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Hekendorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10331>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26071> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "14130",
            "14131" ;
        min:soort "inleiding" ;
        min:volgnummer 429 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0034> ;
        schema:name "Hekendorp (gemeente Oudewater)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De huidige schutsluis van Goejanverwelle dateert uit 1607 en de brug uit 1659. In de loop der tijd heeft men het geheel wel een aantal malen gemoderniseerd. De naastgelegen sluiswachterswoning (Goejanverwelle 74) dateert uit 1728."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00430> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hekendorp (gemeente Oudewater)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Oudewater" ;
        min:gemeenteInBoek "Oudewater" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oudewater_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hekendorp (gemeente Oudewater)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Hekendorp" ;
        min:provincie "Utrecht" ;
