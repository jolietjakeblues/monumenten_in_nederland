        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "De voormalige Geref. kerk (Dorpsstraat 185) is een simpele zaalkerk met eenvoudige neorenaissance-elementen, gebouwd omstreeks 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0033.php> .

