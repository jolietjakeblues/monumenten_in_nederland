        min:lemma "Herv. kerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10889>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12829>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17286>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19152>,
