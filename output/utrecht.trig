        schema:name "Dierenpark Ouwehand"@nl ;
        schema:pageEnd "198" ;
        schema:pageStart "198" ;
        schema:pagination "198" ;
        schema:text "Dierenpark Ouwehand (Grebbeberg 109), gelegen ten oosten van de stad, ontstond in 1932 uit de kippenfokkerij van C.W. Ouwehand. Het park liep schade op in de oorlog, maar een aantal uit omstreeks 1935 daterende, dierenverblijven bleef behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0067.php> .

