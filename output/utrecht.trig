        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loosdrecht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Loosdrecht" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 546 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0048> ;
        schema:name "Loosdrecht"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "In 1888 kwam er een koetshuis bij en precies honderd jaar later een nieuwe raadzaal. Het gebouw zelf, een mooi voorbeeld van een rijkere variant van het neoclassicisme, is vergelijkbaar met de grotere stedelijke woonhuizen in die tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0048.php> .

