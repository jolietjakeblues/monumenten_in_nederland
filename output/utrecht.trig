        min:volgnummer 427 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0034> ;
        schema:name "Hekendorp (gemeente Oudewater)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Dijkdorp, ontstaan in de 14de eeuw bij de sluis waar de Dubbele Wiericke in de Hollandse IJssel uitmondt. De eigenlijke kern is de bebouwing op de IJsseldijk, Goejanverwelle genaamd. Het dorp is vooral bekend door de Goejanverwellesluis, waar de patriotten in 1787 prinses Wilhelmina van Pruisen aanhielden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00428> a min:Passage,
