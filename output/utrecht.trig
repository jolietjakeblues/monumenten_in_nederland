        schema:name "Driebergen-Rijsenburg"@nl ;
        schema:pageEnd "114" ;
        schema:pageStart "114" ;
        schema:pagination "114" ;
        schema:text "Het Iona-gebouw (Hoofdstraat 20) is een school in antroposofische stijl uit 1977-'78, naar ontwerp van J.I. Risseeuw. De organische vormen zijn sterk geïnspireerd door die van het tweede Goetheanum van Rudolf Steiner te Dornach (Zwitserland)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0027.php> .

