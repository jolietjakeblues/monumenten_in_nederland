        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0020> ;
        schema:name "Overige buitenplaatsen"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Overige buitenplaatsen bij Breukelen zijn: Klein Boomrijk (Zandpad 49) ongeveer uit 1700, Vegtzigt (Zandpad 27), Slangevecht (Straatweg 40) uit de 18de eeuw, Vrede en Rust (Straatweg 30) uit de 19de eeuw en Silversteyn (Zandpad 75), waarvan het huis in 1930 in opdracht van jhr. mr. H.H. Roëll, burgemeester van Breukelen, werd gebouwd. Het ontwerp is van H.J. Pothoven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00329> a min:Passage,
