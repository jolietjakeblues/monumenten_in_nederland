        schema:name "Soesterberg (gemeente Soest)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De H. Carolus Borromeus (Rademakerstraat 75) is een pseudobasiliek met zwaar westwerk, tussenlid en driebeukig schip onder één dak. De kerk is gebouwd in 1952-'53 op de plaats van een kerk uit 1837. W. Thunissen maakte het ontwerp in traditionele vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00742> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Soesterberg (gemeente Soest)"@nl ;
        min:adres "Amersfoortsestraat 18" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Soest" ;
        min:gemeenteInBoek "Soest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Soest_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Soesterberg (gemeente Soest)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Soesterberg" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 742 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0071> ;
        schema:name "Soesterberg (gemeente Soest)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Het R.K. Slotklooster Cenakel (Amersfoortsestraat 18) werd in 1939 gebouwd voor de ‘Congregatie van de Dienaressen van de Heilige Geest van de Altijddurende Aanbidding’. J. Franssen uit Roermond ontwierp het in traditionele vormen. Het klooster ligt deels op de voormalige buitenplaats Eikenhorst. Dat geldt ook voor het naastgelegen Contact der Continenten, eveneens gebouwd in traditionele vormen. In eerste aanleg dateert het gebouw uit 1925. Het is in 1953 uitgebreid met onder meer een kapel naar ontwerp van A.J. Kropholler."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0071.php> .

