        min:hoofdstuk "Steden, dorpen, monumenten › Elst (gemeente Rhenen/Amerongen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Elst" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 403 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0029> ;
        schema:name "Elst (gemeente Rhenen/Amerongen)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "Esdorp op de zuidflank van de Utrechtse Heuvelrug, vanouds bestaande uit lintbebouwing langs de rijksstraatweg Utrecht-Arnhem en enige bebouwing langs de Franseweg. De vroegere gemeenschappelijke akkerbouwgronden of engen zijn deels nog te herkennen. Met Amerongen, Remmerden en Rhenen was Elst vooral in de 19de eeuw een centrum van tabakscultuur. Na 1850 is de lintbebouwing richting Rhenen doorgetrokken met huizen van tabaksplanters en middenstanders."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0029.php> .

