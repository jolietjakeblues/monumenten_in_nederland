        schema:name "Baarn"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Het gemeentehuis (Laanstraat 1) verrees in 1907 naar plannen van gemeentearchitect F.F. de Boois. Dit in Jugendstil-vormen uitgevoerde pand heeft de uitstraling van een grote villa. Dat is niet verwonderlijk in een snel groeiend villadorp als Baarn. In 1979-'80 heeft men het gemeentehuis gerenoveerd en uitgebreid naar plannen van A.J.H. Haak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Baarn"@nl ;
