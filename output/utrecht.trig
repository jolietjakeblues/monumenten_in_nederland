        schema:name "Gemeente- en Polderhuis"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text "Gemeente- en Polderhuis van Abcoude-Proosdij (Raadhuisplein 3). De voorgevel van dit bakstenen gebouw uit 1882-'83 heeft in stuc aangebrachte accenten en wordt geleed door geblokte pilasters en getoogde vensters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00181> a min:Passage,
