        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0015> ;
        schema:name "Baarn"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De Geref. kerk (Oude Utrechtseweg 4a) is een neoromaanse kerk op T-vormige plattegrond, voorzien van een toren met zeer slanke spits. Zij werd gebouwd in 1880 naar ontwerp van Tj. Kuipers en uitgebreid in 1904."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0015.php> .

