        schema:name "Lage Vuursche (gemeente Baarn)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De Herv. kerk (Hoge Vuurseweg 4) is een eenvoudige eenbeukige kruiskerk, in 1659 gebouwd in gotische trant, in opdracht van de heer van Drakestein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00480> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lage Vuursche (gemeente Baarn)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Baarn" ;
        min:gemeenteInBoek "Baarn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Baarn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lage Vuursche (gemeente Baarn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Lage Vuursche" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 480 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0041> ;
        schema:name "Lage Vuursche (gemeente Baarn)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Opmerkelijk is dat hier pilasters de plaats van steunberen innemen. Het schip bestaat uit twee traveeën, het koor is driezijdig gesloten. Een zeskante dakruiter bekroont de viering. Inwendig bezit de kerk houten tongewelven met trekbalken. De kroonlijst in de koorsluiting wordt ondersteund door twee consoles in de vorm van gebeeldhouwde kopjes. In 1938 is de kerk gerestaureerd en voorzien van een nieuw portaal en een consistorie. Het interieur bevat enig 17de-eeuws meubilair en een in 1881 door P. van Oeckelen te Haren vervaardigd orgel, dat in 1938 sterk werd vereenvoudigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00481> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lage Vuursche (gemeente Baarn)"@nl ;
        min:adres "Hoge Vuurseweg 2" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Baarn" ;
        min:gemeenteInBoek "Baarn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Baarn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lage Vuursche (gemeente Baarn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Lage Vuursche" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26055> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "8560" ;
        min:soort "inleiding" ;
        min:volgnummer 481 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0041> ;
        schema:name "Lage Vuursche (gemeente Baarn)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De grote pastorie (Hoge Vuurseweg 2) is in 1861 gebouwd naar ontwerp van N.J. Kamperdijk. Het kerkhof is sinds 1659 in gebruik. Opmerkelijk zijn een uit 1919 stammend grafmonument in Egyptische stijl voor de amateur-egyptoloog J.H. Insinger naar ontwerp van J.W. Hanrath en het familiegraf waar Anton Pieck (†1987) begraven ligt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00482> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lage Vuursche (gemeente Baarn)"@nl ;
        min:adres "Slotlaan 9" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Baarn" ;
        min:gemeenteInBoek "Baarn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Baarn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lage Vuursche (gemeente Baarn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Lage Vuursche" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 482 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill213> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0041> ;
        schema:name "Lage Vuursche (gemeente Baarn)"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "138" ;
        schema:pagination "138-139" ;
        schema:text "De ridderhofstad Drakestein (Slotlaan 9) wordt al in 1359 genoemd, maar het huidige huis kwam in 1640-'43 tot stand in opdracht van Gerard van Reede. De achtkante centraalbouw wordt omgeven door een gracht en is toegankelijk via een toegangsbrug. Op het omgaand schilddak bevindt zich een uitkijkplateau met balustrade en koepeltje. De ongepleisterde voorgevel heeft een classicistische ingangspartij en geblokte pilasters op de hoeken, aangebracht bij een verbouwing omstreeks 1780. Daarbij zijn tevens de kruisvensters door schuifvensters vervangen. Begin 19de eeuw werd het huis wit gepleisterd, met uitzondering van de voorgevel. In 1960-'62 is het hoofdgebouw gerestaureerd. De in oorsprong 18de-eeuwse bouwhuizen aan weerszijden van het voorplein werden in 1964 gesloopt en vervangen door nieuwbouw. Het park is rond 1830 verlandschappelijkt naar plannen van H. van Lunteren. Daarnaast bevinden zich op het landgoed onder meer een neogotische bakstenen duiventoren uit het begin van de 19de eeuw en een ijskelder uit de tweede helft van de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00483> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lage Vuursche (gemeente Baarn) – Klein Drakestein"@nl ;
        min:adres "Biltseweg 4",
            "Kloosterlaan 4" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Baarn" ;
        min:gemeenteInBoek "Baarn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Baarn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lage Vuursche (gemeente Baarn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Lage Vuursche" ;
        min:lemma "Klein Drakestein" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67496>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67499>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67501>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74545> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "515718",
            "515732",
            "515734",
            "515737" ;
        min:soort "lemma" ;
        min:volgnummer 483 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0041> ;
        schema:name "Klein Drakestein"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text """Klein Drakestein (Kloosterlaan 4), een sober blokvormig landhuis, is in 1780 gebouwd voor de Amsterdamse gezusters Van Loon. Het huis is in 1967 gerestaureerd.

Het buiten Pijnenburg (Biltseweg 4) stamt uit 1647 en werd in opdracht van de Amsterdamse Sara de Wael ontworpen door Philips Vingboons. Het pand heeft een hoog souterrain en een afgeplat schilddak. In 1835 is het in opdracht van Andries de Wilde aan de voorzijde uitgebreid met een hoger, rechthoekig deel met schilddak en portico naar ontwerp van E.F. Homan, haaks op het bestaande gebouw. Beide bouwdelen zijn wit gepleisterd en hebben een neoclassicistisch aanzien. Het gebouw ligt in een landschapspark aangelegd in 1823 naar ontwerp van H. van Lunteren. Het koetshuis annex dienstwoning in traditionele vorm kwam in 1917 tot stand naar ontwerp van J.A.H.W. Cramer."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00484> a min:Passage,
