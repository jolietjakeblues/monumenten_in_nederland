            "Hogenbiezendijk 64a",
            "Lagedijk 23",
            "Noord IJsseldijk 14",
            "Noord IJsseldijk 28" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "IJsselstein" ;
        min:gemeenteInBoek "IJsselstein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/IJsselstein_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJsselstein" ;
