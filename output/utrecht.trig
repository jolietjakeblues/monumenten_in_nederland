        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0008> ;
        schema:name "Achterberg (gemeente Rhenen)"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text "Van het oorspronkelijk 16de-eeuwse landgoed Remmerstein zijn delen van de oude aanleg bewaard gebleven. Buiten het huidige landgoed werd in 1720 uit de resten van het oude huis een ronde bakstenen duiventoren met zinken tentdak opgericht (achter Cuneraweg 305-307)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0008.php> .

