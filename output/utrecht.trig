        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "405781",
            "405782",
            "405783",
            "405785",
            "405787" ;
        min:soort "lemma" ;
        min:volgnummer 530 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill233> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0046> ;
        schema:name "Oud-Over"@nl ;
        schema:pageEnd "152" ;
        schema:pageStart "151" ;
        schema:pagination "151-152" ;
        schema:text "Oud-Over (Oud-Over 33). Het blokvormige huis heeft een omlopend schilddak met langgerekte schoorstenen. Aan voor- en achterzijde wordt de deur met bovenlicht bekroond door een driehoekig fronton. Het huis dateert vermoedelijk uit het midden van de 18de eeuw. Zo oud is ook de houten theekoepel, die bij het water staat en vooral vanaf de overkant goed zichtbaar is. Het is een ongelijkzijdige achtkant met geblokte hoekpilasters en tentdak. Boven de deuren bevinden zich een snijraam en een kuif in Lodewijk XV-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00531> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loenen – Terra Nova"@nl ;
        min:adres "Oud-Over 154" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
