        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De voorm. R.K. pastorie (Beverweertseweg 10) is een wit gepleisterd laag herenhuis met mansardekap uit 1835. Het heeft een grote siertuin en een spijlenhek uit 1839."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0080.php> .

