        schema:name "De Bilt"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De voorm. Oude School (Burg. De Withstraat 31-31D) dateert evenals de Herv. kerk uit 1652 en werd gebouwd als school annex schoolmeesterwoning. De schoolmeester was tevens koster. In 1846 werd het een bewaarschool. Na het vertrek van die school in 1873 volgden verscheidene uitbreidingen en inwendige verbouwingen, waaronder een ingrijpende in 1913. Het resultaat is het huidige, wit gepleisterde complex, dat in 1981-'82 werd gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00297> a min:Passage,
            schema:CreativeWork ;
