    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00898> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijk bij Duurstede – Steenfabrieken"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Wijk bij Duurstede" ;
        min:gemeenteInBoek "Wijk bij Duurstede" ;
