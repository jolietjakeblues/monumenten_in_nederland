        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 623 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0057> ;
        schema:name "Montfoort"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "In de ruimte boven de poort bevindt zich een renaissanceschouw. Deze schouw werd omstreeks 1894 geplaatst, toen het gebouw diende als museum van oudheden; hij is afkomstig uit het Rijksmuseum. In de voorm. raadzaal, nu in gebruik als café-restaurant, hangt sinds 1649 het schilderstuk ‘Pompeius bij de wijsgeer Posidonius’, door Hendrick Heerschop in rembrandteske trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00624> a min:Passage,
