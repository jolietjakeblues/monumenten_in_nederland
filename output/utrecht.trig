        schema:pagination "292" ;
        schema:text "De bakstenen stellingmolen (Werkhovenseweg 26) dateert uit 1882. Hij werd gebouwd als opvolger van de standerdmolen van Beverweerd. Na in 1933 te zijn onttakeld is de molen in 1994 weer hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0080.php> .

