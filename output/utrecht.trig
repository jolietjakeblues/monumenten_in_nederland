    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00003> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwerk"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Voorwerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:provincie "Utrecht" ;
        min:soort "alinea" ;
        min:volgnummer 3 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0001> ;
        schema:name "Voorwerk"@nl ;
        schema:pageEnd "5" ;
        schema:pageStart "5" ;
        schema:pagination "5" ;
        schema:text "INHOUD Voorwoord 7 Ten geleide 8 Historie 11 Stijl en verschijningsvormen 21 Materiaal en constructie 33 Regio's 39 Steden, dorpen, monumenten 55 Beknopte literatuuropgave 324 Verklaring van enige termen 330 Topografisch register 337 Register van personen 342 Verantwoording van de afbeeldingen 351"@nl ;
