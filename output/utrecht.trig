        schema:name "'t Goy (gemeente Houten)"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "De oude nederzetting ligt op de kruising Wickenburgseweg-Groenedijkje, waar ook de omstreeks 1800 afgebroken middeleeuwse dorpskerk was gelegen. De Wickeburgseweg kronkelt zich om de plaats waar zich het, in de late middeleeuwen reeds verdwenen, belangrijke kasteel Ten Goye bevond. In de loop van de 19de en 20ste eeuw ontstond nabij de R.K. kerk de huidige lintbebouwing langs de Beusichemseweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00407> a min:Passage,
            schema:CreativeWork ;
