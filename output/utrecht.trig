        schema:name "Soest"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "De R.K. kerk van de H. Familie (St.-Willibrordusstraat 19) is een pseudobasiliek uit 1938, gebouwd naar plannen van A. Ardeman en A. Brouwer in de traditionele vormen van de Delftse School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00730> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Soest"@nl ;
        min:adres "Steenhoffstraat 2" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Soest" ;
        min:gemeenteInBoek "Soest" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Soest_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Soest" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Soest" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 730 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0069> ;
        schema:name "Soest"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Het voorm. raadhuis (Steenhoffstraat 2) werd in 1892 gebouwd naar ontwerp van de Utrechtse architect P.J. Houtzagers in diens persoonlijke, op de neogotiek geïnspireerde bouwstijl. Het pand deed oorspronkelijk bovendien dienst als postkantoor en brandspuitenbergplaats. Boven de deur zijn het gemeentewapen en het opschrift ‘Raadhuis’ aangebracht. De ingang wordt bekroond door een toren met daarnaast een trapgevel. In het interieur bevindt zich een 17de-eeuwse schouw, afkomstig uit een pand dat was gesloopt om plaats te maken voor de door Houtzagers ontworpen sociëteit ‘Sic Semper’ aan de Nieuwegracht te Utrecht. In 1921 werd het raadhuis uitgebreid en in 1965 kreeg het een bordes. Toen heeft men de torenspits verwijderd en is het geheel aanzienlijk versoberd. In 1992 is het pand verbouwd tot gezinsvervangend tehuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00731> a min:Passage,
            schema:CreativeWork ;
