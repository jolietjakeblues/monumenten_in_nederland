        schema:name "De Meern (gemeente Vleuten-De Meern)"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text "De Herv. kerk (Zandweg 126), een kruiskerk uit 1912-'13, is gebouwd naar ontwerp van J. Dillewijn uit Hilversum. Het gebouw staat op de plaats van een laat-middeleeuwse kapel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00606> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Meern (gemeente Vleuten-De Meern)"@nl ;
        min:adres "Pastoor Boelenslaan 9-11" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Utrecht" ;
