        schema:pageStart "194" ;
        schema:pagination "194" ;
        schema:text "Boerderijen. Tot de interessante boerderijen van Renswoude behoren twee 18de-eeuwse exemplaren, te weten Dorpsstraat 37 (1761) en Dorpsstraat 40 en één uit 1866, Dorpsstraat 1."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00703> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rhenen"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
