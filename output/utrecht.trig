        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driebergen-Rijsenburg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Driebergen-Rijsenburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10601>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60768> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "14076",
            "14099" ;
        min:soort "inleiding" ;
        min:volgnummer 380 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill166> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0027> ;
        schema:name "Driebergen-Rijsenburg"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "De R.K. kerk St.-Petrus' Banden (Kerkplein 5) is een zaalkerkje in neoclassicistische vormen. Het werd in 1809-'10 gebouwd naar een ontwerp van A. Tollus. Het is het vroegste voorbeeld van een kerkje waarbij een klokkentoren op het westeinde van het dak gecombineerd wordt met een neoclassicistisch vormgegeven voorgevel. Boven het dorische zuilenportiek bevindt zich de door ionische pilasters gelede onderbouw van de toren, waarop een achtkantige opbouw met koepelvormig dak staat. In 1879 werd de kerk in oostelijke richting vergroot. In 1951-'52 maakte dit gedeelte plaats voor een dubbel dwarspand met koor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Driebergen-Rijsenburg"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Utrechtse Heuvelrug" ;
        min:gemeenteInBoek "Driebergen-Rijsenburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Utrechtse_Heuvelrug> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driebergen-Rijsenburg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Driebergen-Rijsenburg" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 381 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill167>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill168> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0027> ;
        schema:name "Driebergen-Rijsenburg"@nl ;
        schema:pageEnd "114" ;
        schema:pageStart "113" ;
        schema:pagination "113-114" ;
        schema:text "In het interieur zijn de wanden geleed met halfzuilen met ionische kapitelen van gips. De kroonlijst daarboven en het tongewelf zijn versierd met stucornamenten, die voor de restauratie van de kerk in 1976-'78 deels verguld waren. Enkele van de vensters hebben gebrandschilderde ramen; het oudste dateert uit ongeveer 1840. De medaillons in de ramen van de dwarspanden bevonden zich oorspronkelijk in de kapel van het Groot Seminarie Rijsenburg. In een zijkapel staat een door de Belgische beeldhouwer J. Ducaju in 1863 vervaardigd grafmonument voor de stichters van de kerk, het echtpaar Oosthuyse-de Jongh. Achter de kerk ligt een restant van het kerkhof, met onder meer de graftombe van de familie Van Rijckevorsel. De tombe, in 1856 vervaardigd door de Utrechtse beeldhouwer E.F. Georges, is afgedekt met een kleed in steen. Tegen de absis van de kerk is het wapen bevestigd van Johannes Zwijsen, aartsbisschop van Utrecht en stichter van het Groot Seminarie voor het bisdom Utrecht te Rijsenburg. Het wapen is afkomstig van de voorgevel van het in 1984-'85 afgebroken seminarie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00382> a min:Passage,
