        schema:name "Nieuwegein"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Ten zuiden van de kerk ligt de François Heytink-Baesjoustichting (Herenstraat 6, Jutphaas), in 1894-'95 waarschijnlijk naar ontwerp van A. Tepe gebouwd, met in het midden het zusterklooster. De twee haakse, oorspronkelijk lage, vleugels waren bestemd voor lager onderwijs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0058.php> .

