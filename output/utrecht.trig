        schema:name "Soest"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Het postkantoor (Steenhoffstraat 11) werd omstreeks 1908 gebouwd in de karakteristieke postkantorenstijl van kort na de eeuwwisseling. Het heeft een bakstenen onderkant en een wit gepleisterd bovendeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00732> a min:Passage,
