        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Dorpsschool (Dorpsstraat 30). School van één lokaal uit 1865, waar in 1867 een schoolmeesterswoning tegenaan werd gebouwd. Ten gevolge van de leerplichtwet is het gebouw in 1902 uitgebreid. Tussen 1973 en 1995 heeft het als gemeentehuis dienst gedaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00358> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Cothen – Kasteel Rhijnestein"@nl ;
        min:adres "Rhijnestein 1-2" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
