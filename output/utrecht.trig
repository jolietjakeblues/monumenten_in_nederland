        schema:text "De Ned. Herv. Vredeskerk (Kerkewijk 125) is een basilicale kruiskerk uit 1947, uitgevoerd in traditionele vormen naar een ontwerp van G. van Hoogevest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00845> a min:Passage,
            schema:CreativeWork ;
