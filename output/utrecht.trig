        min:volgnummer 869 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0079> ;
        schema:name "Molens"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Molens. Langs de Vecht staat de korenmolen De Ruiter (Nigtevechtseweg 8), een met riet gedekte achtkante bovenkruier op stelling. Toen zijn voorganger, een grondzeiler, in 1910 afbrandde, werd de molen voor een betere windvang herbouwd op een stenen onderbouw met stelling. Als bovendeel werd een uit 1735 daterende poldermolen uit Barsingerhorn (Kaagpolder) gebruikt. Verder naar het noorden langs de Vecht staat de Hoekermolen (Nigtevechtseweg 39), een met riet gedekte achtkantige bovenkruier, herbouwd in 1874. Tot 1960 bemaalde deze poldermolen de Hoeker Polder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00870> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vreeland (gemeente Loenen) – Boerderijen"@nl ;
        min:adres "Loenenseweg 4",
            "Nigtevechtseweg 37" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Stichtse Vecht" ;
        min:gemeenteInBoek "Loenen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stichtse_Vecht> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vreeland (gemeente Loenen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Vreeland" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36560> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "26148" ;
        min:soort "lemma" ;
        min:volgnummer 870 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill460> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0079> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Boerderijen. In de omgeving van Vreeland komen enkele waardevolle 17de-eeuwse boerderijen voor, zoals Sans Souci (Loenenseweg 4). Het brede woongedeelte van deze langhuisboerderij heeft aan de voorkant een opkamer; de topgevel wordt afgesloten door een recht opzetstuk en een natuurstenen segmentboog, waarin het jaartal 1688 is aangebracht. Aan de linker zijde is een zomerhuis aangebouwd. Een 17de-eeuwse krukhuisboerderij is Altoos Dankbaar (Nigtevechtseweg 37). De puntgevel aan de voorkant wordt aangezet door voluten en is verder afgewerkt als bij ‘Sans souci’. Het stalgedeelte is met riet gedekt. Aan de overzijde van de weg staat een eenvoudige bakstenen schuur. Nigtevechtseweg 41 en Bergseweg 16 zijn stolpboerderijen - een voor Utrecht ongebruikelijk type - uit het einde van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00871> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Werkhoven (gemeente Bunnik)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Bunnik" ;
        min:gemeenteInBoek "Bunnik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bunnik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Werkhoven (gemeente Bunnik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Werkhoven" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 871 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0080> ;
        schema:name "Werkhoven (gemeente Bunnik)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Gestrekt engdorp op een oeverwal van de Achter Rijn, een zijtak van de Kromme Rijn. De nederzetting heeft een hoge ouderdom; de bronnen noemen de kerk al in het midden van de 9de eeuw. Vanaf de met lage bebouwing omringde en met bomen beplante Brink leidt de Beverweertseweg naar het aan de overzijde van de Kromme Rijn gelegen kasteel Beverweerd. Sinds 1966 is Werkhoven beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00872> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Werkhoven (gemeente Bunnik)"@nl ;
        min:adres "Brink 5" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Bunnik" ;
        min:gemeenteInBoek "Bunnik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bunnik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Werkhoven (gemeente Bunnik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Werkhoven" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44973> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "11292" ;
        min:soort "inleiding" ;
        min:volgnummer 872 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0080> ;
        schema:name "Werkhoven (gemeente Bunnik)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "291" ;
        schema:pagination "291-292" ;
        schema:text "De Herv. kerk (Brink 5), oorspronkelijk aan St.-Steven gewijd, is een wit gepleisterd, ten dele tufstenen, zaalkerkje met westtoren. De romaanse tufstenen toren dateert vermoedelijk uit de 13de eeuw. De eerste geleding wordt afgesloten door een fries van kleine rondbogen, de tweede door een diamantkopfries en een waterlijst. De derde geleding, die ongeveer even hoog is als de twee eronder samen, heeft aan drie zijden lisenen. Deze gaan op ongeveer driekwart hoogte over in een fries van grotere rondbogen; halverwege loopt binnen het spaarveld een fries van keperbogen, waaronder zich een middenliseen bevindt. Boven de in de 16de eeuw gewijzigde galmgaten zit een rond venster. De toren heeft een klok van Steven Butendiic uit 1480, geschonken door de heer van Beverweerd. In het boogveld boven de ingang herdenken een wapen en een inscriptie het herstel van de toren in 1862."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0080.php> .

