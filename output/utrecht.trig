        schema:name "Achterberg (gemeente Rhenen)"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text "Esdorp in de Gelderse Vallei, op de noordflank van de stuwwal. Het dorp heeft een kern en verspreide bebouwing langs de Cuneraweg. In de nabijheid, aan de voet van de Grebbeberg, lag het rond 1160 gestichte en in 1528 afgebroken kasteel Ter Horst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0008.php> .

