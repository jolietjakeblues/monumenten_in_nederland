        min:gemeenteInBoek "Bunnik" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bunnik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bunnik" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Bunnik" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 334 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0021> ;
        schema:name "Bunnik"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "Het voorm. raadhuis (Langstraat 2) verrees in 1897 naar een ontwerp in neorenaissance-stijl van E.G. Wentinck. Momenteel dient het pand als kantoor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00335> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bunnik – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
