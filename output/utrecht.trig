        schema:name "Woerden"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Het arsenaal (Groenendaal 26) [8] is een vierkant gebouw onder omlopend schilddak uit 1762. Enkele van de rondboogpoorten worden geflankeerd door als schamppalen gebruikte kanonslopen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0084.php> .

