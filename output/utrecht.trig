        min:gemeenteInBoek "Nieuwegein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nieuwegein> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwegein" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Nieuwegein" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 643 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0058> ;
        schema:name "Nieuwegein"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "De voorm. Geref. Kerk (Dorpsstraat 16, Vreeswijk) is een zaalkerk met haakse voorbouw. Het gebouw is in 1898 in neorenaissance-stijl opgetrokken, naar ontwerp van R. Barneveld en in 1985 verbouwd tot woning met atelier."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00644> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwegein"@nl ;
        min:adres "Herenstraat 9" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
