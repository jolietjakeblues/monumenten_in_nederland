        min:soort "lemma" ;
        min:volgnummer 514 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0044> ;
        schema:name "Tolhuis"@nl ;
        schema:pageEnd "146" ;
        schema:pageStart "146" ;
        schema:pagination "146" ;
        schema:text "Tolhuis (Treekerweg 1). Dit eenvoudige, neoclassicistische pand uit 1846-'47 is evenals de tolhuizen te Maarn (zie Maarsbergen) en Woudenberg gebouwd aan de op particulier initiatief aangelegde weg Leersum-Amersfoort."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00515> a min:Passage,
            schema:CreativeWork ;
