        schema:name "Wilnis (gemeente De Ronde Venen)"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De Geref. kerk (Dorpsstraat 22) is een bakstenen kruiskerk met dakruiter op de voorgevel. Het gebouw dateert uit 1911-'12."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0083.php> .

