        schema:pagination "183" ;
        schema:text "Breevegt (Klompweg 18) is een buitenplaats met een asymmetrische villa op vrije plattegrond, gebouwd omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0061.php> .

