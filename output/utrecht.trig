        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rhenen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Achterberg (gemeente Rhenen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Achterberg" ;
        min:lemma "Stuivenes" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56571> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "32452" ;
        min:soort "lemma" ;
        min:volgnummer 188 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0008> ;
        schema:name "Stuivenes"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text """Stuivenes (Cuneraweg 132) is een torenvormig gebouw van twee bouwlagen, uitgevoerd in zwaar metselwerk daterend uit de 15de of 16de eeuw. De later aangebouwde boerderij werd in 1990 gesloopt.

Interessant is de in oorsprong 18de-eeuwse krukhuisboerderij Achterbergsestraatweg 164. Langs de Cuneraweg bevindt zich een tabaksschuur (Cuneraweg 100)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00189> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Achterveld (gemeente Leusden)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
