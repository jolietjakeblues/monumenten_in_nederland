        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "524867",
            "524868" ;
        min:soort "inleiding" ;
        min:volgnummer 687 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill302> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0064> ;
        schema:name "Oud-Zuilen (gemeente Maarssen)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "190" ;
        schema:pagination "190-191" ;
        schema:text "Het voorm. gemeentehuis (Dorpsstraat 3) van de in 1954 opgeheven gemeente Zuilen is een bescheiden, maar fraai vormgegeven gebouw in neorenaissance-stijl uit 1896, naar ontwerp van A. Nijland. Het pand met trapgevel heeft aan de zijde van de Vecht versierde smeedijzeren stoephekjes en lantarens. Nijland ontwierp in 1887 ook de Koningin Emmaschool (Zuilenselaan 4), gelegen aan de overzijde van de Vecht en eveneens in neorenaissance-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00688> a min:Passage,
