        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loosdrecht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Loosdrecht" ;
        min:lemma "Fort Spion" ;
        min:provincie "Utrecht" ;
        min:soort "lemma" ;
        min:volgnummer 553 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0048> ;
        schema:name "Fort Spion"@nl ;
        schema:pageEnd "156" ;
        schema:pageStart "155" ;
        schema:pagination "155-156" ;
        schema:text "Fort Spion (Bloklaan), gelegen aan de westoever van de Loenderveense Plas, werd in 1844-'47 gebouwd voor de Nieuwe Hollandse Waterlinie, op de plaats van de oude batterij De Spion. Het fort, een vierkante redoute met afgeronde hoeken en een bomvrij wachthuis, sloot de weg van Loosdrecht naar Loenen af. In 1880 kreeg het een verbeterde gronddekking, remises en een kruitmagazijn. Aan de overzijde van de Veendijk bevindt zich een kazemat van gewapend beton uit 1933."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00554> a min:Passage,
            schema:CreativeWork ;
