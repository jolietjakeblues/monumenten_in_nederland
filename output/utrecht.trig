        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill206> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0038> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "Boerderijen. Aan de voet van de dijk staan verschillende karakteristieke boerderijen, waaronder Zorgwijk (Lekdijk Oost 5). Deze grote, wit gepleisterde boerderij met gekoppelde topgevel is in aanleg 17de-eeuws, maar heeft nadien verschillende wijzigingen ondergaan. Het toegangshek is 18de-eeuws, de wapens op de houten pijlers dateren uit 1874."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00468> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kamerik (gemeente Woerden)"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
