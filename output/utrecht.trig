        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill126> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0017> ;
        schema:name "De Bilt"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De Geref. Immanuelkerk (Soestdijkseweg Zuid 49) is een kruiskerk uit 1922, ontworpen door P.J. Houtzagers. Twee kleine, driezijdige kapellen flankeren de toren, die zich naar boven toe enigszins verjongt. In het interieur heeft de kerk een open spantenkap. De naastgelegen pastorie is uit dezelfde tijd en heeft de originele stalen vensters behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00295> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Bilt"@nl ;
        min:adres "Dorpsstraat 25-27" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "De Bilt" ;
        min:gemeenteInBoek "De Bilt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Bilt_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Bilt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "De Bilt" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 295 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0017> ;
        schema:name "De Bilt"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "Het voorm. raadhuis annex postkantoor en politiebureau (Dorpsstraat 25-27) werd in 1884-'85 in eenvoudige neorenaissance-vormen gebouwd, naar ontwerp van raadslid C. Pothoven. De rechter ingang leidde naar het postkantoor en de linker deur gaf toegang tot de gemeentelijke vertrekken op de verdieping. Via een steeg aan de rechterzijde waren politiebureau en brandspuitenberging bereikbaar. In 1977 is het pand tot wooneenheden verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00296> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Bilt"@nl ;
        min:adres "Burg. De Withstraat 31-31D" ;
