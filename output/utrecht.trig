        min:volgnummer 854 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0077> ;
        schema:name "Vinkeveen (gemeente De Ronde Venen)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "De Herv. kerk (Herenweg 201) is een bakstenen kruiskerk met simpele westtoren. Ze wordt gedekt door een zadeldak. De kerk is gebouwd in de jaren twintig van de 20ste eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00855> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vinkeveen (gemeente De Ronde Venen) – Boerderijen"@nl ;
        min:adres "Demmerik 68",
            "Demmeriksekade 5" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "De Ronde Venen" ;
        min:gemeenteInBoek "De Ronde Venen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Ronde_Venen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vinkeveen (gemeente De Ronde Venen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Vinkeveen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43275> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "514693" ;
        min:soort "lemma" ;
        min:volgnummer 855 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0077> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text """Boerderijen. In de vrij gesloten bebouwing langs de Herenweg staat een aantal boerderijen, waaronder de boerderij Herenweg 78 uit de 18de eeuw. Aan de vrij gesloten, waardevolle boerderijstrook Donkereind ten zuiden van Vinkeveen staat een aantal exemplaren uit het begin van de 20ste eeuw. Bijzonder is de ronde veestal bij boerderij Provincialeweg 14.

Het voorm. station (Demmerik 68), uit 1914, behoorde tot de Haarlemmermeerspoorlijn, die liep van Uithoorn naar Nieuwersluis.

Ten westen van het dorp ligt een gemaal (Demmeriksekade 5) uit 1923, met elektrisch aangedreven centrifugaalpomp."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0077.php> .

