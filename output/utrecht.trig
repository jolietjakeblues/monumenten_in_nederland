        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill162>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill163> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0026> ;
        schema:name "Doorn"@nl ;
        schema:pageEnd "110" ;
        schema:pageStart "110" ;
        schema:pagination "110" ;
        schema:text "De R.K. St.-Martinuskerk (Dorpsstraat 15) dateert uit 1950-'51 en is een ontwerp van J. Starmans. De eenvoudige, bakstenen kerk is gebouwd in de vorm van een vroeg-christelijke basiliek met uitgebouwd voorportiek. Het geheel is, evenals de pastorie, opgetrokken in de traditionele vormen van de Delftse School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00370> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Doorn"@nl ;
