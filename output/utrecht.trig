        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "Dorp aan de noordoostrand van de Utrechtse Heuvelrug in de nabijheid van kasteel Maarsbergen. De Herensteeg, gelegen in het zichtveld van het kasteel en nu gedeeltelijk opgenomen in de Woudenbergseweg, vormde de verbinding tussen kasteel en dorp. Een spooren een snelwegviaduct scheiden tegenwoordig kasteel en dorpscentrum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00568> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maarsbergen (gemeente Maarn)"@nl ;
        min:adres "Woudenbergseweg 52" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Utrechtse Heuvelrug" ;
        min:gemeenteInBoek "Maarn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Utrechtse_Heuvelrug> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maarsbergen (gemeente Maarn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Maarsbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16927>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29135> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "498262",
            "509005" ;
        min:soort "inleiding" ;
        min:volgnummer 568 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0052> ;
        schema:name "Maarsbergen (gemeente Maarn)"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "De Herv. kerk (Woudenbergseweg 52) is een zaalkerk met vierkante toren en achtkante spits boven de ingang. De kerk werd in 1883-'84 gebouwd in opdracht van de familie Du Bois, bewoners van kasteel Maarsbergen naar ontwerp van de architecten J.D. van Gendt en A.R. Freem. Het gebouw is opgetrokken in neorenaissance-vormen met in pleisterwerk uitgevoerde speklagen. De steunberen zijn versierd met driehoekige en segmentvormige frontons. De achtkante opengewerkte torenspits werd in 1934 toegevoegd naar ontwerp van J. Pothoven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00569> a min:Passage,
