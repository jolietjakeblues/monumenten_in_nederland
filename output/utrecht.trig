        min:soort "inleiding" ;
        min:volgnummer 407 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill178> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0030> ;
        schema:name "'t Goy (gemeente Houten)"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "De R.K. kerk O.L.-Vrouw ten Hemelopneming (Beusichemseweg 104) is een kleine bakstenen kruiskerk in sobere neogotische stijl met houten tongewelf, gebouwd in 1870-'71 naar ontwerp van L. Snijders. Het laatgotische kerkje van Blauwkapel werd als voorbeeld genomen. In het redelijk gave interieur bevinden zich gepolychromeerde kruiswegstaties, enkele heiligenbeelden en een gepolychromeerd altaar uit 1888. De hardstenen doopvont stamt uit 1919."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00408> a min:Passage,
