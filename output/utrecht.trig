        min:hoofdstuk "Steden, dorpen, monumenten › Odijk (gemeente Bunnik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Odijk" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60849> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "11291" ;
        min:soort "lemma" ;
        min:volgnummer 675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0062> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Boerderijen. Boerderij De Beug (Werkhovenseweg 1) heeft een dwars op de stal gebouwd, vrij hoog woonhuis met gepleisterde voorgevel en een aan de zijkant afgewolfd rieten dak. In het midden bevindt zich een kelder met opkamer. Ook de stal is met riet gedekt. De boerderij is deels 17de-, deels 18de-eeuws. Boerderij 't Burgje (Weteringdijk 6-8) is mogelijk 17de-eeuws en heeft een tweebeukige krukhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00676> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudewater"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Oudewater" ;
        min:gemeenteInBoek "Oudewater" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oudewater_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudewater" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Oudewater" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 676 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill291> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0063> ;
        schema:name "Oudewater"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Stad ontstaan bij de uitmonding van de Lange Linschoten, ‘het Oude Water’, in de Hollandse IJssel. Omstreeks 1100 werd hier een kerk gebouwd. De eerste vermelding van de nederzetting dateert uit 1239. In 1265 werd Oudewater door de Utrechtse bisschop met stadsrechten begiftigd, ten einde een grensvesting tegen Holland te creëren. In 1280 stond de bisschop de stad echter in onderpand af aan de graaf van Holland. Pas bij een wijziging van de provinciegrenzen in 1970 kwam Oudewater weer op Utrechts grondgebied te liggen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00677> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudewater"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Oudewater" ;
        min:gemeenteInBoek "Oudewater" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oudewater_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudewater" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Oudewater" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 677 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0063> ;
        schema:name "Oudewater"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "De stadsmuur om het vrijwel rechthoekige stadsgebied werd in 1321 gebouwd. Nadat Oudewater in 1572 de zijde van de prins van Oranje had gekozen, werden de grachten uitgediept en de muren versterkt. Het mocht niet baten; de Spanjaarden namen de stad in 1575 in. Een bloedbad was het gevolg en een groot deel van de stad werd door brand verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00678> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudewater"@nl ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Oudewater" ;
        min:gemeenteInBoek "Oudewater" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oudewater_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudewater" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Oudewater" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 678 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0063> ;
        schema:name "Oudewater"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Oudewater is een typische dijkstad, waarbij de kronkelende Linschoten als haven het hart vormt en de overkluizing in het midden als marktplein dient. Het stratenpatroon is bepaald door de loop van de Linschoten en de ligging van de Michaëlskerk aan de IJssel. Oorspronkelijk was de stad dubbel omgracht. Na 1575 werd het verdedigingsstelsel gemoderniseerd, onder meer door het samentrekken van de grachten en aanleg van bastions op de hoekpunten en in het midden van de oostelijke wal. Het toen al bebouwde IJsselvere, gelegen op de westoever van de IJssel, werd in 1585 door middel van een hoornwerk bij de stad getrokken. In de loop der tijd ontwikkelde Oudewater zich tot centrum voor de touwfabricage. Een periode van economische bloei tussen 1575 en 1640 maakte herstel van de door de Spanjaarden verwoeste huizen en de bouw van veel nieuwe huizen mogelijk. Midden 19de eeuw werden de poorten en de muurtorens afgebroken, de grachten deels gedempt en de vestingwerken geslecht om ruimte te scheppen voor nieuwe stedelijke bebouwing en een begraafplaats. Na de oorlog zijn vooral in noordelijke richting nieuwe wijken gebouwd. De historische kern van Oudewater is beschermd stadsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0063.php> .

