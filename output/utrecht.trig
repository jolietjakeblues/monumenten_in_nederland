        schema:name "Soesterberg (gemeente Soest)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De kazerne (Amersfoortseweg 80) is een zogenaamde Du Moulin-kazerne. Ze is in 1938-'39 gebouwd naar ontwerp van J.C. Stumphius en in 1983 sterk gewijzigd. Ze bestaat uit een logisgebouw met kantine, bad- en keukengebouw, bureel en wachtgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0071.php> .

