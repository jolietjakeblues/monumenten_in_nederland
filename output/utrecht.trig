        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Het officierscasino (Kampweg 1) werd in 1941 gebouwd door de Duitse bezetter. Het bakstenen gebouw, met een eenvoudige, symmetrische opzet, bevat onder meer een theaterruimte, officiersmess en ontvangsthal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0071.php> .

