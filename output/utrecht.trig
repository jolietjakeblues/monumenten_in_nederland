        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Cabauw (gemeente Lopik)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Cabauw" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 349 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0023> ;
        schema:name "Cabauw (gemeente Lopik)"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "Oorspronkelijk een laagveendorp met lintbebouwing in een cope-ontginning, waarvan de Lopikerwetering de ontginningsbasis vormde. Bij de kerk ontwikkelde zich een kleine bebouwingskern. Aan de Lekdijk bevindt zich een deel van de nederzetting Willige-Langerak, waarvan de kern in Zuid-Holland ligt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00350> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Cabauw (gemeente Lopik)"@nl ;
        min:adres "Cabauwskade 53-54" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
