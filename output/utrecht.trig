        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "Het nieuwe raadhuis (Raadhuisplein 1) uit 1965-'67 is ontworpen door Van Embden, Choisy, Roorda van Eysinga Smelt en Wittermans (later bekend onder de naam OD 205). Het is een goed voorbeeld van een representatief overheidsgebouw in ‘laat-moderne’ vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00846> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veenendaal"@nl ;
        min:adres "Nieuweweg-Noord 251" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Veenendaal" ;
