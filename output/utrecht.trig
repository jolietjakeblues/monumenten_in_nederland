            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55687> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "18330",
            "36371",
            "514425" ;
        min:soort "lemma" ;
        min:volgnummer 824 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill427> ;
