        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "10614",
            "26455" ;
        min:soort "lemma" ;
        min:volgnummer 591 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill253> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0053> ;
        schema:name "Vecht en Dijk"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "162" ;
        schema:pagination "162-163" ;
        schema:text "Vecht en Dijk (Straatweg 68). Aan het 18de-eeuwse huis van twee bouwlagen is in het begin van de 19de eeuw aan de Vechtzijde een vleugel in empirestijl toegevoegd. In de tuin staat een rijk gedetailleerde tuinkoepel van gietijzer en glas, deels uitkragend boven de Vecht. De koepel is in 1861 vervaardigd door Nering Bögel & Co te Deventer. Ook de serre van het huis en de hekken langs de weg hebben gietijzeren bestanddelen en kunnen uit dezelfde fabriek afkomstig zijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0053.php> .

