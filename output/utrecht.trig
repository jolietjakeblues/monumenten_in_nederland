        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13065>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34164> ;
