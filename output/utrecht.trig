        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "Oliefabrieken. Even buiten Maarssen aan het Amsterdam-Rijnkanaal liggen de uit 1920 daterende fabrieken van Twijnstra's Oliefabrieken NV (nu: UTD Mengvoeders) en N.V. Olieraffinaderij ‘Zuilen’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0053.php> .

