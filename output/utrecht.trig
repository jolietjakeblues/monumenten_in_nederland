        schema:name "Baarn"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De R.K. St.-Nicolaaskerk (Kerkstraat 19) is een neogotische hallenkerk uit 1904, ontworpen door A.G. Welsing uit Arnhem met onvoltooide toren aan de rechterzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00274> a min:Passage,
