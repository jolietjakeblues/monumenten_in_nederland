        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34746> ;
        min:provincie "Utrecht" ;
        min:rijksmonumentnummer "22954" ;
        min:soort "lemma" ;
        min:volgnummer 746 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/afbeelding/sten009monu01ill323> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0072> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Boerderijen. De boerderijen van Teckop zijn karakteristiek voor de streek. De meeste zijn zeer langgerekte langhuisboerderijen. Ze dateren vooral uit het begin van de 19de eeuw. Interessante voorbeelden zijn: De Winter (Teckop 9), De Lente (nr. 40) en Vrede best (nr. 17), met rieten wolfdak en met leilinden voor het huis. De Zomer (nr. 23) is een wit gepleisterde krukhuisboerderij voorzien van zijkamer met kelder en opkamer; ze heeft een rijk geornamenteerde zijgevel. Boerderij Teckop 20 dateert uit 1814 en boerderij De Herfst (nr. 38) uit 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00747> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tienhoven (gemeente Maarssen)"@nl ;
        min:adres "Laan van Niftarlake 62" ;
        min:deel "Monumenten in Nederland. Utrecht" ;
        min:gemeente "Stichtse Vecht" ;
        min:gemeenteInBoek "Maarssen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stichtse_Vecht> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Utrecht_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tienhoven (gemeente Maarssen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01> ;
        min:kern "Tienhoven" ;
        min:provincie "Utrecht" ;
        min:soort "inleiding" ;
        min:volgnummer 747 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/hoofdstuk/0073> ;
        schema:name "Tienhoven (gemeente Maarssen)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Dorpje, ontstaan eind 12de eeuw als ontginningsnederzetting langs de Looijdijk in het laagveengebied ten oosten van de Vecht. Sinds de 15de eeuw vond vervening ten behoeve van turfwinning plaats, waarbij aan weerszijden van het dorp plassen werden gevormd. Die aan de westzijde werden in 1880 drooggemalen (polder Bethune). Aan de oostzijde bevindt zich een gebied met legakkers, waarop het gebaggerde veen lag te drogen en petgaten: met water gevulde gaten waar het veen is weggestoken. De Herv. kerk (Laan van Niftarlake 62) is een eenvoudige zaalkerk in neoclassicistische vormen met een dakruiter boven de ingang. De eerste steen werd in 1813 gelegd door de ambachtsvrouwe J.M.E. Willink van Collen en haar zuster."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu01_01/sten009monu01_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu01_01/passage/00748> a min:Passage,
