        schema:name "Colijnsplaat (gemeente Noord-Beveland)"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De voorm. kerk van de Geref. Gemeente (Oost Havenstraat 22), een eenvoudige zaalkerk uit circa 1900 met rondboogvensters, is tot 1989 in gebruik geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0023.php> .

