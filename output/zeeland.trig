        schema:name "Hoedekenskerke (gemeente Borsele)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Het voorm. raadhuis (Havenstraat 13) is in 1956 (gevelsteen) tot stand gekomen in wederopbouwstijl met geometrische betonnen raamtraceringen. Het ontwerp is van J. van der Valk. Thans dient het gebouw als gemeenschapshuis ‘De Griend’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0043.php> .

