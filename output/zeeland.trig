        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De (Herv.) Bethelkerk (Coudorp 1) is een recht gesloten zaalkerk voorzien van een toren met hoog tentdak. Deze kerk kwam in 1917-'18 tot stand naar een ontwerp met sobere expressionistische elementen van H. van der Kloot Meijburg. In de toren hangt een door Gillis van Gilde gegoten klok (1710). Van 1918 dateren ook de aangebouwde consistoriekamer en de terzijde geplaatste pastorie (Coudorp 3)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00683> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwdorp (gemeente Borsele) – Scholen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
