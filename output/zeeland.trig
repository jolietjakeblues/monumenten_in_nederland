        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biggekerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Biggekerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 276 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill88> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0015> ;
        schema:name "Biggekerke (gemeente Veere)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Kerkringdorp, ontstaan in de middeleeuwen op een kreekrug waar reeds vóór 1235 sprake was van een kerk. Rond 1850 was er hoofdzakelijk bebouwing aan de kerkring en langs de Dorpsstraat, de weg richting Koudekerke. Eind 19de eeuw vond verdichting van de bebouwing langs deze weg plaats. Bij een bombardement op 17 september 1944 werd het dorp zwaar getroffen. Recent is het dorp aan de zuidoostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biggekerke (gemeente Veere)"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biggekerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Biggekerke" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18889>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31534> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "36852",
            "36853" ;
        min:soort "inleiding" ;
        min:volgnummer 277 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0015> ;
        schema:name "Biggekerke (gemeente Veere)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De Herv. kerk (Kerkplein 1) is een eenbeukige kerk met driezijdig gesloten koor en een gedeeltelijk ingebouwde toren van twee geledingen met haakse steunberen, gepleisterde blindnissen en een achtzijdige spits. De toren met stenen kruisribgewelf in de benedenruimte stamt uit circa 1400, evenals enkele delen van het koor. Het schip werd waarschijnlijk begin 17de eeuw in oude vormen herbouwd. Bij de restauratie in 1957 is aan de zuidzijde een nieuwe consistorie toegevoegd. Het kerkinterieur wordt gedekt door een houten tongewelf met trekbalken. Tot de inventaris behoren onder meer een preekstoel met boogpanelen uit circa 1630 en een in 1896 geplaatst wapenbord."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00278> a min:Passage,
