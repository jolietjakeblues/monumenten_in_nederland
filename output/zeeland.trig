        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "Het voorm. raadhuis van Elkerzee (Dorpsstraat 7) is een in 1909-'10 naar ontwerp van M. van der Linden opgetrokken dwars pand met een topgevel boven het risalerende rechter gedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00825> a min:Passage,
            schema:CreativeWork ;
