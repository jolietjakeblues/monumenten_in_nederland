        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "11162",
            "11163",
            "11186",
            "11187",
            "38790" ;
        min:soort "inleiding" ;
        min:volgnummer 358 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill121>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill122> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0025> ;
        schema:name "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "96" ;
        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text "De Herv. kerk (Ring 1), oorspronkelijk gewijd aan St. Adrianus, is een tweebeukige gotische hallenkerk voorzien van een vijfzijdig gesloten koor en een toren van drie geledingen met ronde traptoren en een ingesnoerde naaldspits. Rond 1350 begon de bouw van het koor, kort na 1400 gevolgd door een eenbeukig schip met aan de noordzijde een rechthoekige zijkapel, die mogelijk was bedoeld als aanzet tot een noordtransept. In de eerste helft van de 15de eeuw verrees de toren, met hoeksteunberen bij de onderbouw en boven een afsluitend boogfries; de huidige spits dateert van 1867. Verder heeft de traptoren een hoge, achtzijdige, gemetselde spits. In de toren hangt een door Johannes Burgerhuys gegoten klok (1634). De laat-gotische zuidbeuk met driezijdige sluiting kwam eind 15de eeuw tot stand. De gevels zijn voorzien van natuurstenen banden. De rond 1550 haaks op het zuidkoor opgetrokken sacristie heeft een benedenruimte met kruisribgewelf en laat-gotische schouw en een bovenruimte die wellicht als librije dienst heeft gedaan. De bij de ingrijpende verbouwing van de kerk in 1873-'75 aangebrachte bepleistering en ombouw tot bewaarschool van de zuidbeuk zijn ongedaan gemaakt bij de restauratie in 1959-'68. Daarbij heeft men de steunberen herbouwd en de vijfzijdige doopkapel op de zuidwesthoek. Aan de noordzijde bij het koor is een vrijstaand nieuw gebouw ingericht als winterkerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00359> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dreischor (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Dreischor" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 359 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill123> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0025> ;
        schema:name "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "97" ;
        schema:pageStart "96" ;
        schema:pagination "96-97" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven. De muurstijlen onder de doorlopende gewelfribben rusten op muurkolonetten met gebeeldhouwde consoles. In het koor zijn vanwege verbetering van de akoestiek klankpotten aangebracht, verborgen achter bewerkte plankjes. De scheibogen tussen de twee beuken rusten op ronde natuurstenen kolommen met koolbladkapitelen (circa 1450). De tijdens de restauratie ontdekte muurschilderingen - cartouches met grafschriften en bijbelteksten (na 1572) - zijn deels geconserveerd. Tot de inventaris behoren enkele oude grafzerken, een midden-17de-eeuws koorhek, herenbanken (tweede kwart 17de eeuw) en een preekstoel (circa 1670)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00360> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dreischor (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Dreischor" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 360 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0025> ;
        schema:name "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "97" ;
        schema:pageStart "97" ;
        schema:pagination "97" ;
        schema:text "Het verhoogde zuidkoor diende als grafkapel voor de heren van Dreischor. Het houten gewelf ter plaatse is voorzien van allegorische grisailleschilderingen betreffende de dood, geschilderd door Pieter Bossenblij (circa 1750). Achter een smeedijzeren hek staan twee rijk gebeeldhouwde grafmonumenten. De monumenten voor de gebroeders Cornelis († 1728) en Jan Daniëlsz. Ockerse († 1742) werden rond 1742 vervaardigd door Nicolaas Seuntjes en zijn uitgevoerd in Lodewijk XIV-stijl met portretmedaillons en allegorische figuren. Nog monumentaler is het door Matthijs van Nooijen uitgevoerde monument voor Pieter Mogge († 1756), ontworpen in Lodewijk XV-stijl door A. Wapperon en op onderdelen door Jan Peter van Baurscheit de Jonge. Het is voorzien van een portretmedaillon en een figurengroep, waaronder een skelet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0025.php> .

