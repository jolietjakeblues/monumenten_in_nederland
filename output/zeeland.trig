        schema:name "Ipenoord"@nl ;
        schema:pageEnd "197" ;
        schema:pageStart "197" ;
        schema:pagination "197" ;
        schema:text "Ipenoord (Noordweg 43). Deze in 1841 door de familie Boddaert gestichte buitenplaats heeft als kern een wit gepleisterd neoclassicistisch herenhuis. Het huis en het omringende park in landschapsstijl zijn mogelijk tot stand gekomen naar ontwerp van K.G. Zocher."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00725> a min:Passage,
            schema:CreativeWork ;
