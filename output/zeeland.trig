        min:hoofdstuk "Steden, dorpen, monumenten › Rilland (gemeente Reimerswaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Rilland" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33696> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "32423" ;
        min:soort "lemma" ;
        min:volgnummer 800 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0081> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "211" ;
        schema:pagination "211-212" ;
        schema:text "Boerderijen. Van de Mariahoeve (Hoofdweg 6) is het deels onderkelderde, 18de-eeuwse woonhuis opgetrokken in gele baksteen; het hoge zadeldak is vernieuwd. Erachter staan een in gele steen opgetrokken bak- en zomerhuis en een 19de-eeuwse, zwart geteerde houten dwarsdeelschuur. Uit circa 1915 dateren het van de hoeve Reigersberg (Bathseweg 50) resterende woonhuis met imitatievakwerk en erker en de even ten noorden van de dorpskom gelegen boerderij Valckenisseweg 1 met vrijstaand woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0081.php> .

