        schema:name "Krabbendijke (gemeente Reimerswaal)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 85), een tweelaags pand voorzien van een ingebouwde centrale torenpartij met uurwerk en open klokkenstoel, dateert in zijn huidige vorm uit circa 1955."@nl ;
