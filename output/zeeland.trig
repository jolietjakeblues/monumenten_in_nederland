        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58925> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "37031" ;
        min:soort "lemma" ;
        min:volgnummer 857 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0089> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "Windmolen ‘De Hoop’ (Vrouwenpolderseweg 55a), vroeger ‘De Jonge Johannes’ geheten, is een achtkantige houten grondzeiler met veldmuren, gesitueerd op een molenberg. De ingesnoerde romp en de molenkap zijn bekleed met dakleer. Deze korenmolen verving - vermoedelijk in 1835 - een standerdmolen. In 1959 is de kap vernieuwd en in 1985 heeft men de molen vanaf de Molenweg verplaatst naar de huidige standplaats en vervolgens gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00858> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Annaland (gemeente Tholen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Tholen" ;
        min:gemeenteInBoek "Tholen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tholen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaland (gemeente Tholen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Sint Annaland" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 858 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0090> ;
        schema:name "Sint Annaland (gemeente Tholen)"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "Voorstraatdorp met kerkring, gesticht vanaf 1476 na de bedijking van de schorren van het zogeheten Nieuwland (nu Oudelandpolder). Dit geschiedde in opdracht van Anna van Bourgondië, zuster van hertog Karel de Stoute. Met de aanleg van de Suzannapolder (1668), genoemd naar de dochter van Constantijn Huygens, kreeg de haven van Sint Annaland een kort havenkanaal. De belangrijkste bebouwing verrees aan de Voorstraat, de verbinding tussen de haven en de oorspronkelijk geheel omgrachte kerk. Het dorp werd in 1692 door brand geteisterd en ook dijkdoorbraken eisten van tijd tot tijd hun tol. Na de overstroming van 1953 is Sint Annaland uitgebreid aan de west- en zuidzijde. In 1960 heeft men de oude haven gedempt en aan de noordzijde een nieuwe haven aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00859> a min:Passage,
