        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biggekerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Biggekerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 278 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0015> ;
        schema:name "Biggekerke (gemeente Veere)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Op het kerkhof bevinden zich de grafkelder van J.T. Werndly Clinge († 1831) en zijn moeder († 1841), voorts het graf van K. Wielemaker († 1918), hoofd van de Chr. lagere school."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00279> a min:Passage,
