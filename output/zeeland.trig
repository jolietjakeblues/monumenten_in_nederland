        min:volgnummer 370 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0026> ;
        schema:name "Driewegen (gemeente Borsele)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De voorm. Geref. kerk ‘Eben Haezer’ (Korteweg 21), een kleine zaalkerk met opvallend siermetselwerk in de voorgevel, en de met mansardedak uitgevoerde pastorie (Korteweg 19) zijn tot stand gekomen in 1907."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00371> a min:Passage,
            schema:CreativeWork ;
