        schema:name "Sint Laurens (gemeente Middelburg)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "De Geref. kerk (Noordweg 372, Brigdamme) is een zaalkerk met eenvoudige expressionistische details, gebouwd in 1923 ter vervanging van een voorganger uit 1894."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00881> a min:Passage,
