        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0008> ;
        schema:name "Aardenburg (gemeente Sluis)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Het voorm. burgerweeshuis ‘De Meiboom’ (Weststraat 22-24) werd in 1624 opgericht. Het dubbele diepe pand met trapgevels en natuurstenen onderdelen verrees in 1631. Het rijkste onderdeel is de in maniëristische stijl uitgevoerde zandstenen poortomlijsting met een wapen in het boogfronton. Na de sluiting van het burgerweeshuis in 1929 is het gebouw gerestaureerd in 1949."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00231> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aardenburg (gemeente Sluis)"@nl ;
        min:adres "Oude Kerkstraat 7" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Sluis" ;
        min:gemeenteInBoek "Sluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aardenburg (gemeente Sluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Aardenburg" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 231 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0008> ;
        schema:name "Aardenburg (gemeente Sluis)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Het voorm. burgergasthuis (Oude Kerkstraat 7) ontstond uit het middeleeuwse St.-Jansgasthuis. Het dwarse pand aan de straatzijde bevat mogelijk nog oude delen. Interessant is het hierachter staande gepleisterde tweelaags gebouw in eclectische vormen, dat in 1892 tot stand kwam als tehuis voor oude mannen en vrouwen. Na de opheffing van het gasthuis in 1929 zijn de gebouwen ingericht als garagebedrijf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00232> a min:Passage,
