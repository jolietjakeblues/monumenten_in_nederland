        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "De pastorie (Schoolstraat 3) is een fors tweelaags pand uit circa 1860. Ernaast staat een wegkapel van 1953, gebouwd uit dankbaarheid voor het gespaard blijven van het dorp voor de Watersnood van 1953."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0045.php> .

