        min:kern "Noordgouwe" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 698 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0066> ;
        schema:name "Noordgouwe (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "Kerkringdorp, ontstaan in de middeleeuwen op een kreekrug en genoemd naar het water dat het eiland Dreischor van Schouwen scheidde. Dit water werd in 1374 afgedamd. Het dorp kwam tot ontwikkeling rond de op een omgracht terrein gelegen kerk. Vanaf 1900 is de bebouwing enigszins verdicht, vooral langs de Heereweg. Noordgouwe is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00699> a min:Passage,
