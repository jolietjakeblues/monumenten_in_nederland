        min:volgnummer 576 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0052> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Begraafplaatsen. De Herv. begraafplaats (bij Hulsterweg 67) is rond 1830 gesticht, gezien de hekpijlers met vazen in late empire-vormen. Het baarhuisje dateert uit circa 1880. De R.K. begraafplaats (bij Kerklaan 5), gesticht rond 1870, bevat enkele gietijzeren grafkruisen en een hardstenen kruis op postament ter markering van de pastoorsgraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00577> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kloosterzande (gemeente Hulst) – Walsoorden"@nl ;
        min:adres "Eeckseweg 3",
            "Walsoordensestraat 2" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Hulst" ;
        min:gemeenteInBoek "Hulst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hulst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kloosterzande (gemeente Hulst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Kloosterzande" ;
        min:lemma "Walsoorden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18414> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "509220" ;
        min:soort "lemma" ;
        min:volgnummer 577 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0052> ;
        schema:name "Walsoorden"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Walsoorden. Dit gehucht ten noordoosten van Kloosterzande is ontstaan na de herdijking van de Noorddijkpolder (1622). In de 18de eeuw nam het de taken van de haven van Hulst over en in 1857 volgde de bouw van een nieuwe havenkom. Het in 1886 begonnen stoomveer Walsoorden-Hansweert over de Westerschelde werd in 1938 naar de noordelijker gelegen nieuwe veerhaven van Perkpolder verplaatst. De enorme schuur Walsoordensestraat 11 werd in 1778 gebouwd als meestoof onder de naam ‘Orange Stove’. De voorm. meelfabriek (Walsoordensestraat 2), gesticht in 1908 door A.C.M. Poppe, is uitgevoerd in neorenaissance-vormen. Het pand werd in 1911 door brand geteisterd en is na de fabriekssluiting in 1923 tot woonhuis omgebouwd. De Beaufortsluis (bij Eeckseweg 3) is een spuisluis in de vorm van een duiker met aan de Westerscheldezijde een houten afsluiting met handwindwerk. Deze sluis uit 1761 is herbouwd na de overstroming van 1906."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00578> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koewacht (gemeente Terneuzen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
