        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vrouwenpolder (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Vrouwenpolder" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 998 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0104> ;
        schema:name "Vrouwenpolder (gemeente Veere)"@nl ;
        schema:pageEnd "262" ;
        schema:pageStart "262" ;
        schema:pagination "262" ;
        schema:text "De Geref. kerk (Fort den Haakweg 16), een zaalkerk in traditionalistische vormen met achtzijdige ingangstoren, is in 1953 tot stand gekomen naar ontwerp van A. Rothuizen en P.J. 't Hooft."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00999> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vrouwenpolder (gemeente Veere) – Woonhuizen"@nl ;
        min:adres "Kon. Emmaweg 20-22",
            "Koningin Emmaweg 24",
            "Koningin Emmaweg 26",
            "Liebertsweg 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vrouwenpolder (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Vrouwenpolder" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38391> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "37010" ;
        min:soort "lemma" ;
        min:volgnummer 999 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill419> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0104> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "263" ;
        schema:pageStart "262" ;
        schema:pagination "262-263" ;
        schema:text """Woonhuizen. Een van de oudste nog bestaande woonhuizen is het wit gepleisterde huis Dorpsdijk 40 met tuitgevel, schuiframen en de jaartalsteen ‘1620’. Een mogelijk 18de-eeuwse kern heeft het pand Dorpsdijk 42-44, met een voormalige werkplaats aan de Schoolstraatzijde aansluitend op een topgevel met een later toegevoegde winkelpui. De villa Fort den Haakweg 7 uit circa 1910 was oorspronkelijk een hervormde pastorie.

Van de uitspanning ‘Oranjezon’ (Koningin Emmaweg 26), oorspronkelijk een boerderij, is het L-vormige woonhuis gedateerd ‘1726’ (jaartalankers en jaartal in dakpannen ingelegd). Verder zijn er een stenen schuur met houten top en rieten dak, een lagere stenen bijschuur met gedeeltelijk rieten dak en een vrijstaande houten schuur.

De boerderij ‘'t hof Christina’ (Liebertsweg 1) heeft een gepleisterd L-vormig woonhuisgedeelte uit circa 1870 met geblokte hoeklisenen en een grote, deels houten, schuur.

Het pompstation ‘Oranjezon’ (Koningin Emmaweg 24) in het gelijknamige duingebied dateert van 1892 en bestaat uit een pompgebouw in sobere neoclassicistische vormen en een dubbel woonhuis in chaletstijl (Kon. Emmaweg 20-22)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01000> a min:Passage,
            schema:CreativeWork ;
