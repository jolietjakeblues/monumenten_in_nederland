        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Het voorm. raadhuis (Korteweg 2-4), een fors wit geschilderd pand uit 1927, deed tevens dienst als onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0062.php> .

