        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22878> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "37014" ;
        min:soort "inleiding" ;
        min:volgnummer 385 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0029> ;
        schema:name "Gapinge (gemeente Veere)"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "De Geref. kerk (Dorpsstraat 7) is een zaalkerk met schilddak, gebouwd in 1957 naar ontwerp van G. Steen en G. Tuinhof. Tot de inventaris behoort een rond 1765 door Hendrik Hermanus Hess gebouwd kabinetorgel (gerestaureerd 1957-'58), dat tussen 1866 en 1926 in de Herv. kerk van Serooskerke stond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00386> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gapinge (gemeente Veere) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gapinge (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Gapinge" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 386 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0029> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "Woonhuizen. Het wit gepleisterde dwarse huis Schotsehoek 7 dateert in oorsprong uit de 18de eeuw en heeft een lagere aanbouw. Rond 1900 gebouwd zijn het dwarse huis Dorpsstraat 46 en het pand Schotsehoek 6, dat is voorzien van neorenaissance-details en een in twee kleuren gelegd pannendak. Het laatstgenoemde pand is in gebruik geweest als onderwijzerswoning bij de (verdwenen) openbare lagere school en als gemeentesecretarie. De hardstenen brievenbus draagt het opschrift ‘gemeentebestuur’. Dorpsstraat 40-42 is een voorbeeld van een huis met werkplaats uit het eerste kwart van de 20ste eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00387> a min:Passage,
