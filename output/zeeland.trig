        schema:name "Stavenisse (gemeente Tholen)"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "234" ;
        schema:pagination "234" ;
        schema:text "Het voorm. postkantoor (Poststraat 2) is een hoekpand met dienstwoning, uitgevoerd in 1920-'21 met expressionistische details naar ontwerp van P.F. de Bordes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00925> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stavenisse (gemeente Tholen)"@nl ;
        min:adres "Bos 17" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
