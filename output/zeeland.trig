        min:soort "lemma" ;
        min:volgnummer 627 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0059> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "Boerderijen. De boerderij J. de Waalstraat 8 heeft een dwars geplaatst eenlaags woonhuis met tegelkamer, gedateerd 1834. Vermoedelijk 18de-eeuws is het vrijstaande bakhuis. De boerderij Roverbergsedijk 19 bestaat uit een woonhuis uit circa 1905 en een vroeg-19de-eeuwse zwart geteerde houten schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00628> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lamswaarde (gemeente Hulst) – Kuitaart"@nl ;
        min:adres "Frederik Hendrikstraat 75",
            "Meerdijk 5" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Hulst" ;
        min:gemeenteInBoek "Hulst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hulst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lamswaarde (gemeente Hulst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
