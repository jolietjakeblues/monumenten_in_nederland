        schema:name "Oost-Souburg (gemeente Vlissingen)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Het ommuurde kerkhof heeft aan weerszijden van de toegang hekposten waarop miniatuur-burchten zijn aangebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00736> a min:Passage,
