        min:volgnummer 752 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill319>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill320> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0074> ;
        schema:name "Oud-Vossemeer (gemeente Tholen)"@nl ;
        schema:pageEnd "203" ;
        schema:pageStart "203" ;
        schema:pagination "203" ;
        schema:text "De forse pastorie (Raadhuisstraat 7), thans in gebruik als dorpshuis, werd in 1896 in eclectische stijl gebouwd, naar ontwerp van A. le Clercq en is voorzien van hoeklisenen en een middenrisaliet met balkon."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0074.php> .

