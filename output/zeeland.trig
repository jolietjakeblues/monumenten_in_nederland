        min:kern "Wissenkerke" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 1036 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0110> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Boerderijen. Van de boerderij Dorpsweg 1a dateert het eenlaags middenganghuis uit circa 1880. Aan de achterzijde bevinden zich een kelder en een opkamer. Het vrijstaande boerenwoonhuis Dorpsdijk 100, een middenganghuis met omlijste ingang, is rond 1895 gebouwd. Bij Dorpsdijk 98 staan twee karakteristieke houten schuren met een mogelijk 18de-eeuwse oorsprong."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0110.php> .

