        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "11176" ;
        min:soort "inleiding" ;
        min:volgnummer 361 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0025> ;
        schema:name "Dreischor (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "97" ;
        schema:pageStart "97" ;
        schema:pagination "97" ;
        schema:text "Het ruime, ringvormige en omgrachte, kerkhof bevat nog enkele zerken, waaronder die voor ds. Benjamin Kam († 1869). De voorm. pastorie (Ring 16) is een in opzet 18de-eeuws gebouw met een rond 1860 vernieuwde lijstgevel (met gietijzeren goot). Het pand is rond 1916 ingrijpend verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00362> a min:Passage,
