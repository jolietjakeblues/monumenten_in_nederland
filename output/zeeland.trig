        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "De Geref. kerk (Dorpsstraat 5), gebouwd in 1924 naar ontwerp van H. Onvlee, is een zaalkerk met geveldakruiter en gekoppelde smalle spitsboogvensters. De pastorie (Dorpsstraat 3) is uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0056.php> .

