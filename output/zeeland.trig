        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0028> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Woonhuizen. Uit circa 1880 dateert het deels onderkelderde dwarse huis Zomerstraat 24 met brede kroonlijst. Van Hattumstraat 18 is een voorbeeld van een middenganghuis met hoger opgetrokken middenpartij, gebouwd rond 1900 in neorenaissance-stijl. Het werd bewoond door burgemeester E.A. van der Bent, die circa 1915 de tuinkamer in chaletstijl liet aanbouwen. Het diepe huis Langeviele 52 (circa 1910) is voorzien van decoratief metselwerk en een getrapt houten topgevelbeschot. Het tuinhek is uitgevoerd in jugendstil-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ellewoutsdijk (gemeente Borsele) – Boerderijen"@nl ;
        min:adres "Hellewoudstraat 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ellewoutsdijk (gemeente Borsele)" ;
