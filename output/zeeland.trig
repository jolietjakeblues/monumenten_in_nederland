        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kapelle" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Kapelle" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 551 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0049> ;
        schema:name "Kapelle"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "De Geref. kerk (Biezelingsestraat 67) is een T-vormig gebouw met terzijde geplaatste toren, gebouwd in 1915-'17 in rationalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00552> a min:Passage,
