        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "De voorm. (Geref.) Ontmoetingskerk (Geersdijkseweg 1) is een moderne zaalkerk met wit gepleisterd portaal en een slanke toren, gebouwd in 1958 naar plannen van A. Rothuizen en P.J. 't Hooft."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0030.php> .

