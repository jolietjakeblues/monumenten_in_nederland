        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Atlantikwall. Ter hoogte van Noordervroon 8 en aan de Duinweg liggen betonnen bunkers die in 1942-'43 zijn gebouwd als onderdeel van de Atlantikwall. Twee exemplaren in de duinen zijn opengesteld als museumbunker."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01100> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zoutelande (gemeente Veere) – Boerderijen"@nl ;
        min:adres "Boomweg 13",
            "Sint Janskerke 1",
            "Werendijke 12" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoutelande (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zoutelande" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17957>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40270>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52002> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "36866",
            "36867",
            "36869" ;
        min:soort "lemma" ;
        min:volgnummer 1100 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0116> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text """Boerderijen. Buiten de kern van Zoutelande liggen enkele interessante boerderijen. Mogelijk gebouwd op het terrein van een in 1249 vermeld benedictinessenklooster is de boerderij Groot Werendyke (Werendijke 12), waarvan het L-vormige woongedeelte oorspronkelijk stamt uit eind 17de of begin 18de eeuw. De vroeg-20ste-eeuwse boerderij Werendijkseweg 12 wordt gevormd door een dwars woonhuis uit 1908 (jaartal in dakpannen ingelegd) en een deels houten landbouwschuur en een wagenschuur.

In het gehucht Sint Janskerke ten noorden van Zoutelande bevindt zich de boerderij St.-Janshof (Boomweg 13), met een deels gepleisterd woonhuis uit 1668 (jaartalankers) en een vrijstaande stenen dwarsdeelschuur met mendeuren uit 1832 (jaartal in dakpannen ingelegd). Interessant in dit gehucht zijn verder de boerderij Tramzicht (Sint Janskerke 1), met een 18de-eeuws dwars woonhuis en een wagenschuur en grote vrijstaande schuur uit de 19de eeuw, en verder de grote 19de-eeuwse houten dwarsdeelschuur bij Sint Janskerke 21 met twee mendeuren en drie wagendeuren."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01101> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zuiddorpe" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 1101 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Zuiddorpe (gemeente Terneuzen)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Wegdorp met een brinkachtig dorpsplein, ontstaan op een oude dekzandrug. Al in 1236 is er sprake van een parochie en wordt het dorp vanwege de veenontginningen in de omgeving De Moeren genoemd. Dit gebied werd in 1698 bedijkt. Het bescheiden dorp kreeg in 1788 een katholieke schuurkerk, die dienst deed totdat de ruïneuze middeleeuwse kerk in 1807 aan de katholieken werd teruggegeven (gesloopt 1817). De lintvormige bebouwing is na de Tweede Wereldoorlog aan de zuidzijde verbreed."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01102> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen)"@nl ;
        min:adres "Dorpsplein 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
