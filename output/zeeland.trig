        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Serooskerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Serooskerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 850 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0089> ;
        schema:name "Serooskerke (gemeente Veere)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "Kerkringdorp, ontstaan in de 12de eeuw op een kreekrug. De naam is een verbastering van 's-Heer Alardskerke. In de 13de eeuw verrees aan de zuidzijde van de dorpskerk het klooster Mariëndaal, later Soetendaal geheten (verwoest 1574). Het dorp ontwikkelde zich in westelijke richting naar de kruising met de belangrijke weg van Middelburg naar Oostkapelle. Na de Tweede Wereldoorlog is Serooskerke uitgebreid aan de zuidzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00851> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Serooskerke (gemeente Veere)"@nl ;
        min:adres "Noordweg 3",
            "Torenstraat 8" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Serooskerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Serooskerke" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13960>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29275>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42317>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51715> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "28118",
            "37028",
            "37029",
            "507837" ;
        min:soort "inleiding" ;
        min:volgnummer 851 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0089> ;
        schema:name "Serooskerke (gemeente Veere)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Herv. kerk (Noordweg 3), oorspronkelijk gewijd aan St. Johannes de Evangelist, heeft een recht gesloten eenbeukig schip en een forse toren van twee geledingen met overhoekse steunberen, een aanzet van een derde geleding en een vierzijdige spits. In de 15de-eeuwse toren hangt een door Johannes Burgerhuys gegoten klok (1676). Na de verwoesting van het middeleeuwse schip en koor in 1572-'74 volgde in de 17de eeuw enkel de herbouw van het schip. De kerk is in 1958 gerestaureerd en de torenspits heeft men na stormschade in 1966 hersteld. De kerk bevat een preekstoel met houten lezenaar (1661). In de zuidwand is een grote grafzerk ingemetseld voor Philibert van Tuyll van Serooskerke († 1661), ambachtsheer van Serooskerke, en Vincentia Magdalena van Swieten († 1629). Verder zijn er drie vroeg-17de-eeuwse grafstenen. Op het kerkhof bevindt zich een herplaatste zerk van P.E. Bland-Mathijssen († 1867) en R.J. Bland († 1871). De voorm. pastorie (Torenstraat 8) is een sober neoclassicistisch herenhuis met lijstgevel en werd gebouwd in 1879 ter vervanging van een eerdere pastorie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0089.php> .

