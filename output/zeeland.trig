        schema:name "Westdorpe (gemeente Terneuzen)"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Het voorm. cachot (bij Graaf Jansdijk A154), bestaande uit twee cellen, werd rond 1910 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01018> a min:Passage,
