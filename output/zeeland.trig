        min:volgnummer 507 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill176>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill177> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0045> ;
        schema:name "Hoofdplaat (gemeente Sluis)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "De R.K. St.-Eligiuskerk (Kersenlaan 8) - ook St.-Elooikerk genoemd - is een driebeukige kerk met een gepleisterd, driezijdig gesloten koor en een ranke geveltoren met ingesnoerde spits. Deze sobere neogotische kerk kwam in 1860-'61 tot stand naar plannen van P. Soffers, ter plaatse van een voorganger uit 1795. Het in 1962 gemoderniseerde interieur bezit een triomfbalk en kruiswegstaties uit de bouwtijd en een sterk gewijzigd Adema-orgel (1885)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00508> a min:Passage,
