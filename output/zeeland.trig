        schema:name "Kerkwerve (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "143" ;
        schema:pageStart "143" ;
        schema:pagination "143" ;
        schema:text "De (Chr. Geref.) Pniëlkerk (Beatrixstraat 5) is een moderne zaalkerk met opengewerkte klokkentoren, gebouwd in 1966 naar plannen van C.G. Geenen & L.R.T. Oskam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0050.php> .

