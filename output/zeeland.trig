        min:hoofdstuk "Steden, dorpen, monumenten › Vrouwenpolder (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Vrouwenpolder" ;
        min:lemma "Fort Den Haak" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 1000 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0104> ;
        schema:name "Fort Den Haak"@nl ;
        schema:pageEnd "263" ;
        schema:pageStart "263" ;
        schema:pagination "263" ;
        schema:text "Fort Den Haak (Vrouwenpolderseweg), gelegen ten noordoosten van Vrouwenpolder, werd in 1588 aangelegd ter bescherming van het Veerse Gat. De wallen zijn nog gedeeltelijk herkenbaar in het landschap."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01001> a min:Passage,
