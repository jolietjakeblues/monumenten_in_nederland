        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Gapinge" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 382 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0029> ;
        schema:name "Gapinge (gemeente Veere)"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Kerkringdorp, ontstaan in de late middeleeuwen op een kreekrug. De kerkring is aan de zuidzijde niet geheel voltooid. Het dorp ontwikkelde zich verder hoofdzakelijk door verlenging en verdichting van de lintbebouwing langs de Dorpsstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00383> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gapinge (gemeente Veere)"@nl ;
        min:adres "Dorpsstraat 25" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gapinge (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Gapinge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40829>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44413> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "36850",
            "37011" ;
        min:soort "inleiding" ;
        min:volgnummer 383 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill128> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0029> ;
        schema:name "Gapinge (gemeente Veere)"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "100" ;
        schema:pagination "100-101" ;
        schema:text "De Herv. kerk (Dorpsstraat 25) is een laat-gotische eenbeukige kerk met driezijdig gesloten koor, sacristie en een half ingebouwde toren met inpandige ingangsnis, achtzijdige lantaarn en naaldspits. De toren verrees in de eerste helft van de 15de eeuw. Midden 15de eeuw volgde het koor, waarna bij de bouw van het huidige schip rond 1500 de toren half ingebouwd raakte en een lantaarn kreeg. Ook bouwde men toen aan de zuidzijde een sacristie. De kerk is gerestaureerd in 1920-'24. In 1947-'49 heeft men de bij de inundatie van Walcheren in 1944 opgelopen schade hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00384> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gapinge (gemeente Veere)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gapinge (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Gapinge" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 384 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill129> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0029> ;
        schema:name "Gapinge (gemeente Veere)"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "Inwendig wordt het schip gedekt door een houten tongewelf. Koor en schip zijn van elkaar gescheiden door een smalle triomfboog op muurkolommen. In de daarbinnen in 1947 geplaatste (deels glazen) wand naar ontwerp van E.P. Messer is het orgel opgenomen. Dit rococo-kabinetorgel (1753), vermoedelijk uit de school van Ludovicus de Backer, staat sinds 1903 in deze kerk. De gekroonde figuur met harp (David) en twee bazuinblazende jongelingen op het orgel zijn niet de oorspronkelijk bij het orgel behorende beelden. Die staan in de Herv. kerk in Oostkapelle. Verder is er een preekstoel met boogpanelen uit 1637."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00385> a min:Passage,
            schema:CreativeWork ;
