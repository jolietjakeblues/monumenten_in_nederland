            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54890> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "39098",
            "39099",
            "507659" ;
        min:soort "lemma" ;
        min:volgnummer 1037 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill427>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill428> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0110> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "269" ;
        schema:pageStart "268" ;
        schema:pagination "268-269" ;
        schema:text """Windmolens. De molen De Onderneming (Ooststraat 28) is een ronde stellingmolen met een stenen romp en een met dakleer beklede kap. Deze korenmolen werd in 1867 gesticht door H. de Looff en is rond 1985 gerestaureerd. De korenmolen Landzigt (Boomdijk 1) is een ronde stenen grondzeiler uit 1869.

De gietijzeren dorpspomp (bij Voorstraat 12) dateert uit circa 1870. De in de vorm van een zuil uitgevoerde pomp wordt bekroond door een bol en is voorzien van een waaiervormige lekbak op bewerkte voet.

De Alg. begraafplaats (tegenover Noordeindstraat 116), aangelegd rond 1870, heeft een gietijzeren toegangshek voorzien van doodssymboliek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01038> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wolphaartsdijk (gemeente Goes)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
