        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0084> ;
        schema:name "Scharendijke (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "De (Herv.) Bethlehemkerk (Bethlehemplein 4) is een moderne zaalkerk met toren, gebouwd in 1955 naar ontwerp van T. van Hoogevest. In de toren hangt een door Pieter van Dormen gegoten klok (1456), afkomstig van het in 1572 verwoeste klooster Bethlehem bij Elkerzee."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00824> a min:Passage,
