        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill85> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0013> ;
        schema:name "Biervliet (gemeente Terneuzen)"@nl ;
        schema:pageEnd "77" ;
        schema:pageStart "76" ;
        schema:pagination "76-77" ;
        schema:text "De Herv. kerk (Kerkstraat 6) is een deels gepleisterde zaalkerk met portaal, traptoren en opengewerkte dakruiter, gebouwd in 1659-'60 door François Ritsaert met gebruik van materiaal van de middeleeuwse St.-Nicolaaskerk. De in 1944 verwoeste dakruiter heeft men in 1947-'48 herbouwd onder leiding van P. van Beveren. Het interieur wordt gedekt door een balkenplafond met korbeelstellen. Tot de inventaris behoren een preekstoel en doophek uit 1660. Cornelis van Barlaar vervaardigde in 1660 voor de kerk drie gebrandschilderde ramen. Een ervan toont het wapen en een portretmedaillon van stadhouder Willem III, een tweede toont het wapen van Zeeland en het raam van Biervliet heeft zes wapens en een beeltenis van Willem Beukelszoon. Tegen de kerk staat de voorm. tweeklassige openbare lagere school (Kerkstraat 4) uit circa 1850, die na 1884 lange tijd als bewaarschool heeft gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00265> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biervliet (gemeente Terneuzen)"@nl ;
        min:adres "Noordstraat 44",
            "Noordstraat 46" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biervliet (gemeente Terneuzen)" ;
