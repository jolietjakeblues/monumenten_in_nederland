        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De pastorie (Ring 3) is een tweelaags middenganghuis uit circa 1870, waarvan de entree en het bovenvenster door neoclassicistische omlijstingen zijn geaccentueerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0066.php> .

