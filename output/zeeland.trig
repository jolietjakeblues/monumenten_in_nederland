        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Woonhuizen. Het gepleisterde middenganghuis Langstraat 17 dateert uit circa 1860. Het rijzige pand Noordstraat 4 werd rond 1900 gebouwd als hotel ‘'s Lands Welvaren’ en rond 1920 vergroot en verhoogd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00504> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoek (gemeente Terneuzen) – Boerderijen"@nl ;
        min:adres "Binnendijk 5",
            "Langestraat 1",
            "Lovenweg 2" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoek (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Hoek" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29268>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40415> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "35020",
            "508133" ;
        min:soort "lemma" ;
        min:volgnummer 504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0044> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text """Boerderijen. De 18de-eeuwse boerderij Binnendijk 2 heeft een eenlaags gepleisterd woongedeelte en een ingangsomlijsting met gecanneleerde pilasters. Uit 1854 dateert de boerderij Weinig Rust (Binnendijk 5), bestaande uit een vrijstaand eenlaags woonhuis, een deels in hout uitgevoerde grote schuur met wolfdak en een stenen varkensschuur.

De windmolen ‘Windlust’ (Langestraat 1) is een stellingmolen met een ronde bakstenen romp en een met schalieën beklede kap. Deze in 1979-'80 gerestaureerde korenmolen werd in 1856-'57 gebouwd, vermoedelijk in opdracht van W. de Feijter ter vervanging van een standerdmolen bij de Molendijk.

De dijkverhoging (bij Lovenweg 2), gelegen ten noorden van Hoek, bestaat uit diverse in 1933 op de kruin van de zeedijk geplaatste betonnen dijkverhogingelementen volgens een systeem dat is ontwikkeld door R.R.L. de Muralt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00505> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoofdplaat (gemeente Sluis)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Sluis" ;
        min:gemeenteInBoek "Sluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoofdplaat (gemeente Sluis)" ;
