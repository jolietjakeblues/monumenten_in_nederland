        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Scharendijke (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Scharendijke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 821 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0084> ;
        schema:name "Scharendijke (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "Dijkdorp, ontstaan bij de in 1901-'02 aangelegde landbouwhaven Kloosternol. Na de Watersnoodramp van 1953 is een deel van de dorpskern herbouwd. Vanaf de jaren zeventig is Scharendijke aan weerszijden uitgebreid met recreatiecomplexen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00822> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Scharendijke (gemeente Schouwen-Duiveland)"@nl ;
        min:adres "Dijkstraat 23" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Scharendijke (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Scharendijke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 822 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0084> ;
        schema:name "Scharendijke (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "De Geref. kerk (Dijkstraat 23) is een recht gesloten zaalkerk uit 1916 met neogotische spitsboogvensters. De smalle en kleine massieve klokkentoren boven de ingang is in de plaats gekomen van een houten dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0084.php> .

