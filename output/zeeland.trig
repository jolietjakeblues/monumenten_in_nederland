        min:soort "inleiding" ;
        min:volgnummer 704 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0067> ;
        schema:name "Noordwelle (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "Kerkringdorp met kerkgracht, ontstaan in de middeleeuwen op een kreekrug nabij een 13de-eeuws kasteel, verdwenen bij overstromingen in 1421, 1424 of 1530. Het dorp heeft zware schade opgelopen bij de Watersnoodramp van 1953."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00705> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordwelle (gemeente Schouwen-Duiveland)"@nl ;
        min:adres "Dorpsring 32-33" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordwelle (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Noordwelle" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32246>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36684> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "38818",
            "38819" ;
        min:soort "inleiding" ;
        min:volgnummer 705 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0067> ;
        schema:name "Noordwelle (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "De Herv. kerk (Dorpsring 32-33), gelegen op een lichte verhoging, is een eenbeukige kerk met een driezijdig gesloten koor en een toren van drie geledingen, aan de bovenzijde overgaand in een achtkant met spits. De onderbouw van de toren stamt uit circa 1450, de achtzijdige bovenbouw werd rond 1550 toegevoegd; hierin hangt een klok uit circa 1450. De bijbehorende 15de-eeuwse kerk werd in 1576 verwoest. Bij de herbouw in de 17de eeuw heeft men het schip hoger opgetrokken. Het koor werd toen of mogelijk pas in 1754 op de oude muurresten herbouwd. In 1875 kreeg de kerk een bepleistering en inwendig een houten tongewelf. Verder werd het koor tot school verbouwd. Bij de restauratie in de jaren vijftig van de 20ste eeuw is de kerk ontpleisterd en het koor in omvang gereconstrueerd. Ook zijn toen schuine steunberen tegen de toren opgemetseld. Tot de inventaris behoren een preekstoel uit 1754 en een in 1868 door Flaes en Brunjes gebouwd orgel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00706> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordwelle (gemeente Schouwen-Duiveland) – Woonhuizen"@nl ;
        min:adres "Dorpsring 4" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
