        schema:name "Brouwershaven (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text "De voorm. pastorie (Haven Zuidzijde 15) is een 19de-eeuws, sober neoclassicistisch pand, dat in 1911 is verbouwd. Het herbergt thans het Brouws Museum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0018.php> .

