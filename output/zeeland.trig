        min:kern "Aardenburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48911>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58299> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "6900",
            "6901" ;
        min:soort "inleiding" ;
        min:volgnummer 228 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill70>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill71> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0008> ;
        schema:name "Aardenburg (gemeente Sluis)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "68" ;
        schema:pagination "68-69" ;
        schema:text "De R.K. O.L. Vrouwe Hemelvaartkerk (Weststraat 80) is een driebeukige kruiskerk met driezijdig gesloten koor, koepeltoren en dakruiter, en een ingebouwde westtoren van drie geledingen met ingesnoerde spits. Deze kerk in vroege neogotische stijl verrees in 1850-'51 naar plannen van P. Soffers. In 1924-'25 werd het koor vervangen door een oostpartij met transept en koepeltoren naar ontwerp van J. van Groenendael. De kerk liep in de Tweede Wereldoorlog schade op, die in 1947 is hersteld. Inwendig heeft de kerk een wit gepleisterd schip met pijlers die gestukadoorde houten kruisribgewelven dragen en een in schoon metselwerk uitgevoerd koor. Tot de inventaris behoren een preekstoel en kruiswegstaties uit circa 1855 en altaren en een communiebank uit circa 1925. Tegelijk met de kerk verrezen de wit gepleisterde pastorie (Weststraat 84) en het voorm. klooster (Weststraat 82), dat tot 1955 als zodanig dienst deed."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00229> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aardenburg (gemeente Sluis)"@nl ;
        min:adres "Sassenstraat 1-3" ;
