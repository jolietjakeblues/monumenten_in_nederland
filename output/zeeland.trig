        schema:name "Oudelande (gemeente Borsele)"@nl ;
        schema:pageEnd "202" ;
        schema:pageStart "202" ;
        schema:pagination "202" ;
        schema:text "Het voorm. raadhuis (Burg. van Lierestraat 1) werd in 1938 (eerste steen) in traditionalistische vormen gebouwd naar ontwerp van C. van Maris ter vervanging van een voorganger uit 1883."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00749> a min:Passage,
