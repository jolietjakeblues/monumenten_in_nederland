        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24662> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "31514" ;
        min:soort "inleiding" ;
        min:volgnummer 442 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill157> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0035> ;
        schema:name "Groede (gemeente Sluis)"@nl ;
        schema:pageEnd "117" ;
        schema:pageStart "117" ;
        schema:pagination "117" ;
        schema:text "De Luth. kerk (Molenstraat 28) is een recht gesloten en door lisenen gelede zaalkerk voorzien van een ingangspartij met sobere omlijsting. Deze kerk werd in 1742-'43 gebouwd door immigranten uit de stad Dürnberg bij Salzburg. De in 1998-'99 gerestaureerde kerk bevat een preekstoel uit circa 1800. Voor de voorgevel staan twee 17de-eeuwse Schellinger stoeppalen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00443> a min:Passage,
            schema:CreativeWork ;
