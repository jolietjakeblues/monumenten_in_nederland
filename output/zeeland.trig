        min:volgnummer 229 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0008> ;
        schema:name "Aardenburg (gemeente Sluis)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "De Geref. kerk (Sassenstraat 1-3) is een moderne zaalkerk, gebouwd in 1969 ter plaatse van een voorganger uit 1928."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00230> a min:Passage,
