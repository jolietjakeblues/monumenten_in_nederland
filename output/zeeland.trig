        schema:pageEnd "150" ;
        schema:pageStart "149" ;
        schema:pagination "149-150" ;
        schema:text "De (Geref.) Immanuelkerk (Tramstraat 31) is een moderne zaalkerk met een open klokkentoren, gebouwd in 1963 naar plannen van G. Steen en G. Tuinhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0055.php> .

