        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwdorp (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Nieuwdorp" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 680 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0063> ;
        schema:name "Nieuwdorp (gemeente Borsele)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Dijkdorp, ontstaan na de bedijking van de West-Kraayertpolder (1642) en de Nieuwe Kraayertpolder (1675). Het heette aanvankelijk Dorp van Nieuw 's-Heer Arendskerke. Rondom een groot dorpsplein, aangelegd tegen een bocht in de dijk, werden de eerste huizen gebouwd. Hier verrezen later ook een school (1821) en een kerk (1841). Aan de overzijde van het plein volgde in 1918 de bouw van een tweede kerk. Na de Tweede Wereldoorlog is het dorp aan de zuidzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00681> a min:Passage,
