        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terneuzen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Terneuzen" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 931 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0099> ;
        schema:name "Terneuzen"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De Herv. kerk (Noordstraat 62) [1] is een brede zaalkerk voorzien van een geveltoren met vierkante lantaarn, frontons en spits. Deze kerk met neorenaissance-details werd in 1885-'86 gebouwd ter vervanging van een kerk uit 1659. In het interieur bevindt zich een beschadigde grafzerk voor Joos Laureijs, baljuw van Axel († 1630)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00932> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terneuzen – Katholieke kerken"@nl ;
        min:adres "Alberdingk Thijmstraat 2",
            "Korte Kerkstraat 19",
            "Korte Kerkstraat 20",
            "Korte Kerkstraat 22" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terneuzen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Terneuzen" ;
        min:lemma "Katholieke kerken" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 932 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill380> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0099> ;
        schema:name "Katholieke kerken"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "Katholieke kerken. Van de R.K. St.-Willibrorduskerk (Korte Kerkstraat 20) [2] resteert de rijzige toren van twee geledingen met hoektorentjes en achtkantige spits, die in 1913-'14 verrees naar plannen van J. Vermeulen (gerestaureerd 1991). De bijbehorende kerk, gebouwd ter vervanging van een nabijgelegen voorganger van 1849, werd in 1969 gesloopt. De tot parochiehuis omgebouwde oorspronkelijke kerk van 1849 verdween in 1981. Eveneens bewaard bleven de rond 1922 opgetrokken pastorie (Korte Kerkstraat 22) met expressionistische elementen en het voorm. klooster (Korte Kerkstraat 19) uit circa 1931. De R.K. Triniteitskerk (Alberdingk Thijmstraat 2) is een lage vierkante kerk zonder toren, gebouwd in 1961-'62 in de Bossche school-variant van het traditionalisme naar plannen van A. Siebers & W. van Dael."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00933> a min:Passage,
