        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0009> ;
        schema:name "Anna Jacobapolder (gemeente Tholen)"@nl ;
        schema:pageEnd "71" ;
        schema:pageStart "71" ;
        schema:pagination "71" ;
        schema:text "Dorp, ontstaan na de drooglegging van de Anna Jacobapolder in 1847 en genoemd naar de vrouw van initiatiefnemer W.F. del Campo. Het eiland behoorde oorspronkelijk tot de gemeente Bruinisse en was van Sint Philipsland gescheiden door de Bruintjeskreek. In 1867 werd het bij Sint Philipsland gevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00241> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anna Jacobapolder (gemeente Tholen) – Geref. kerken"@nl ;
        min:adres "Langeweg 23" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Tholen" ;
        min:gemeenteInBoek "Tholen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tholen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Anna Jacobapolder (gemeente Tholen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Anna Jacobapolder" ;
        min:lemma "Geref. kerken" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 241 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill75> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0009> ;
        schema:name "Geref. kerken"@nl ;
        schema:pageEnd "71" ;
        schema:pageStart "71" ;
        schema:pagination "71" ;
        schema:text """Geref. kerken. De voorm. Geref. kerk Langeweg 40 is een kleine zaalkerk uit 1895 met spitsboogvensters in de voorgevel. In 1959 naar ontwerp van G. Steen en G. Tuinhof tot stand gekomen is de Geref. kerk Langeweg 49. Deze moderne zaalkerk met zadeldak heeft een vrijstaande - boven het ingangsportaal geplaatste - klokkentoren.

De voorm. openbare lagere school (Langeweg 23), een drieklassige school in neoclassicistische vormen, werd in 1861 gebouwd door J. Elenbaas op initiatief van W.F. del Campo. In 1984 is het pand verbouwd tot woningen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Anna Jacobapolder (gemeente Tholen) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
