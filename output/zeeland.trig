        min:hoofdstuk "Steden, dorpen, monumenten › Hengstdijk (gemeente Hulst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Hengstdijk" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 490 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0042> ;
        schema:name "Hengstdijk (gemeente Hulst)"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Dijkdorp, gesticht in 1161 aan de noordelijke oever van de kreek De Vogel. In 1797 kreeg het een eigen parochie en ging het dorp Hengstdijk heten in plaats van Heijnsdijk. De middeleeuwse kerk heeft men in 1892 afgebroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00491> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hengstdijk (gemeente Hulst)"@nl ;
        min:adres "Kerkstraat 6" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Hulst" ;
        min:gemeenteInBoek "Hulst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hulst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hengstdijk (gemeente Hulst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Hengstdijk" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 491 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0042> ;
        schema:name "Hengstdijk (gemeente Hulst)"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "De R.K. St.-Catharinakerk (Kerkstraat 6) is een eenbeukige kruiskerk met vijfzijdig gesloten koor, een aangebouwde sacristie en een toren van drie geledingen met naaldspits. Deze op de vroege gotiek geïnspireerde neogotische kerk kwam in 1892-'93 tot stand naar plannen van P.J. van Genk en is gerestaureerd in 1977. De dakruiter op de viering is in 1994 vernieuwd. In de toren hangt een klok uit 1669. Het kerkinterieur wordt gedekt door gestukadoorde houten kruisgewelven, gesteund door kolonnetten met knopkapitelen. De polychromie dateert uit 1911. Tot de inventaris behoort het schilderstuk ‘de Aanbidding der Wijzen’ (1649) door Simon de Vos. Hoofdaltaar, preekstoel en doopvont (circa 1895) zijn ontworpen door J. van Genk-Seelen. De kruiswegstaties zijn gemaakt door mw. Mannen uit Brussel. Het Vermeulen-orgel dateert van 1917. De glas-in-loodvensters zijn in 1921 vervaardigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0042.php> .

