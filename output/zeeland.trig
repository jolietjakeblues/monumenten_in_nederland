        schema:name "Scherpenisse (gemeente Tholen)"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "Op het oude omheinde kerkhof, waarachter in 1926 de huidige Alg. begraafplaats is aangelegd, dateren de oudste grafstenen van rond 1900, bijvoorbeeld de ranke grafzerk voor C.D. Bolier († 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00832> a min:Passage,
