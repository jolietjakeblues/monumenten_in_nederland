        schema:name "Meliskerke (gemeente Veere)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De Chr. lagere school (Dorpsstraat 6-8) is rond 1920 gebouwd als een tweeklassige school met vrijstaande onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00635> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meliskerke (gemeente Veere) – Woonhuizen"@nl ;
        min:adres "Molenweg 2" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meliskerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Meliskerke" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 635 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill229> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0060> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text """Woonhuizen. Een van de oudste huizen van Meliskerke is de dubbele arbeiderswoning Valkenburgstraat 5-7, die met de zijtopgevel naar de weg toe ligt. Inwendig bevinden zich mogelijk 18de-eeuwse betimmeringen en tegeltableaus. Voorbeelden van laat-19de-eeuwse dwarse huizen zijn Valkenburgstraat 3 - het woonhuis van Jan Vader uit 1871 (gevelsteen) - en het gerenoveerde pand Dorpsstraat 2 uit 1890.

De windmolen (bij Molenweg 2) is een grondzeiler met ronde bakstenen romp en een met dakleer beklede kap. Deze korenmolen verving in 1801 een standerdmolen die bij een storm in 1800 was omgewaaid. De molen is in 1987 gerestaureerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0060.php> .

