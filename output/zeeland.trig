        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Geref. kerk (Ds. Van Wouwestraat 41), gebouwd in 1953 naar ontwerp van H. Eldering, is een markant in de as van de weg gelegen Y-vormig gebouw met in de hoek een verhoogde ingangspartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00853> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Serooskerke (gemeente Veere)"@nl ;
        min:adres "Torenstraat 37" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
