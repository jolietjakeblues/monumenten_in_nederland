        min:hoofdstuk "Steden, dorpen, monumenten › Aagtekerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Aagtekerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 216 ;
