        min:kern "Hoofdplaat" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 505 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0045> ;
        schema:name "Hoofdplaat (gemeente Sluis)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Kruiswegdorp, gesticht na de bedijking van de schorren van de Hoge Plaat tot Hoofdplaatpolder in 1775-'78. Tussen 1790 en 1820 verdween van deze polder met name aan de oostzijde weer een deel in het water. De in 1808 gegraven haven heeft men in het kader van de Deltawerken in 1969 afgedamd en gedempt. De Dorpsstraat en de parallel lopende Achterweg geven Hoofdplaat in zekere zin het karakter van een voorstraatdorp. Na de Tweede Wereldoorlog is dit vrij geïsoleerd gelegen dorp aan de zuidwestzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00506> a min:Passage,
            schema:CreativeWork ;
