        min:volgnummer 1004 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill421> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0105> ;
        schema:name "Waarde (gemeente Reimerswaal)"@nl ;
        schema:pageEnd "263" ;
        schema:pageStart "263" ;
        schema:pagination "263" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 16) kwam in 1909 tot stand naar een ontwerp met neorenaissance- en jugendstil-details van W. Sterk. Een boog van rode strengperssteen op natuurstenen pilasters bevat een tegeltableau in florale jugendstil-vormen met het opschrift ‘Gemeentehuis’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01005> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waarde (gemeente Reimerswaal) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
