        schema:pagination "101" ;
        schema:text "De voorm. Herv. kerk (Barkey Wolfstraat 2) is een moderne zaalkerk met aangebouwde ontmoetingsruimte, gebouwd in 1961 naar plannen van A. Rothuizen en P.J. 't Hooft. Het gebouw is nu in gebruik als het Haydn Huis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0030.php> .

