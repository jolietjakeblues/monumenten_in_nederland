        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 848 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0088> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Woonhuizen. Uit circa 1890 dateert het dwarse huis Dorpsplein 10 met forse dakerker en uit circa 1910 het huis Dorpsplein 14 met een gevel voorzien van gepleisterde banden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00849> a min:Passage,
