        rdfs:label "Driewegen (gemeente Borsele) – Boerderijen"@nl ;
        min:adres "Paulushoekseweg 5",
            "Van Tilburghstraat 43",
            "Van Tilburghstraat 50" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
