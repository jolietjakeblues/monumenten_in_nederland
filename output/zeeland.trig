        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 762 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "Dijkdorp, ontstaan op de grens van de Oud-Ovezandepolder (1280) en de polder Nieuw-Ovezande (1395). Van een kapel ter plaatse wordt in 1419 voor het eerst melding gemaakt. Tot circa 1865 stond er hoofdzakelijk bebouwing aan het Kerkplein en langs de Hoofdstraat. De voormalige heerlijkheid Ovezande is tot 1970 een zelfstandige gemeente geweest. Na de Tweede Wereldoorlog is het dorp aan de noordoostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00763> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele)"@nl ;
        min:adres "Kerkplein 8" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23259>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51026> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "10018",
            "10019" ;
        min:soort "inleiding" ;
        min:volgnummer 763 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill324> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "De Herv. kerk (Kerkplein 8), oorspronkelijk gewijd aan St. Petrus en St. Paulus, is een recht gesloten eenbeukige kerk met aangebouwde consistorie en een half ingebouwde ongelede toren met ingesnoerde naaldspits. De smalle toren met laat-gotische details verrees in de 14de of vroege 15de eeuw en heeft een grote open voorhal met de ingang tot de kerk. Rond 1840 heeft men het in opzet 15de-eeuwse schip gepleisterd en van nieuwe vensters voorzien en het koor vervangen door de huidige consistorie. De toren is in 1955 ontpleisterd en gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00764> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 764 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "Inwendig bevinden zich boven het moderne plafond van het schip de ribben van het oude tongewelf. Tot de inventaris behoren een preekstoel uit circa 1750 en een Van Dam-orgel uit 1893. Van de in 1887 aangetroffen 15de-eeuwse muurschilderingen zijn die met voorstellingen van Christus en Andreas uit het zicht verdwenen en is die met de H. Adrianus in 1958 verplaatst naar de zuidwand van de toren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00765> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 765 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "Tegen de kerkhofmuur zijn drie cartouches met wapenschilden (1646), afkomstig van het na de oorlog afgebroken viskot aangebracht. In de hekpijlers zijn twee van elders afkomstige hardstenen pijlers uit 1703 opgenomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00766> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele)"@nl ;
        min:adres "Hoofdstraat 58",
            "Hoofdstraat 60" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 766 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "De R.K. kerk O.L. Vrouwe ten Hemelopneming (Hoofdstraat 60) is een zaalkerk met smal, recht gesloten koorgedeelte en een houten geveltoren. Deze in Willem II-gotiek uitgevoerde kerk kwam in 1858-'59 tot stand naar plannen van W.J. van Vogelpoel. In 1906-'07 heeft men het koor uitgebreid en de bescheiden geveltoren aangebracht. Opvallend zijn de gepleisterde deur- en vensteromlijstingen en de hoekpilasters met pinakels. Tot de inventaris uit de bouwtijd behoren het rijk gesneden hoofdaltaar en het orgel. De naastgelegen pastorie (Hoofdstraat 58) is een sober herenhuis uit 1871."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00767> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele)"@nl ;
        min:adres "Hoofdstraat 54" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 767 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Ovezande (gemeente Borsele)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "De voorm. R.K. lagere St. Aloysiusschool (Hoofdstraat 54) is in 1912-'13 gebouwd als een vierklassige middengangschool met aangebouwde onderwijzerswoning in late neorenaissance-stijl. De hoger opgetrokken middenpartij bevat een beeld van St. Aloysius."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00768> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 768 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill325> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "205" ;
        schema:pagination "205-206" ;
        schema:text "Woonhuizen. In oorsprong daterend van 1645 is het wit gepleisterde dwarse huis Kerkplein 1 met lage verdieping en een zadeldak tussen puntgevels. Het was oorspronkelijk een herberg ('t Vergulde Paard). Omstreeks 1870 opgetrokken is het eclectische middenganghuis Kerkplein 5, voorzien van vensters met afgeronde bovenhoeken. Voorbeelden van huizen met neorenaissance-details zijn het middenganghuis Hoofdstraat 89 en de dwarse panden Hoofdstraat 12, 16 en 43 (alle circa 1900). Het rond 1905 als pastorie bij de Herv. kerk gebouwde diepe huis Nieuwstraat 18 is een wit gepleisterd pand met getrapt topgevelbeschot en in schoon metselwerk uitgespaarde details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00769> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ovezande (gemeente Borsele) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ovezande (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Ovezande" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 769 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0076> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text """Boerderijen. Aan de rand van de dorpskom liggen enkele kleine boerderijen uit circa 1900, zoals Hoofdstraat 7, met een aangebouwde houten dwarsdeelschuur, en Nieuwstraat 13, met een hogere bakstenen schuur. Ten westen van Ovezande liggen twee 18de-eeuwse hoeven. Kraaijertsedijk 4 heeft een woonhuis uit 1789 (jaartalankers), een aangebouwde houten schuur met bijbehorend zomerhuis-bakhuis en een wagenschuur in zwart geteerd hout. Op de plek waar voorheen een eilandje in de Zwake lag, werd in 1789 de boerderij Hollestelleweg 1a gebouwd. Het woonhuis heeft een betegelde woonkamer. De aangebouwde houten dwarsdeelschuur is in 1918 gedeeltelijk vernieuwd en verlengd. Voor de boerderij staat een bakhuisje uit 1908.

De windmolen Molenweg 4, gelegen ten westen van Ovezande op een molenbelt, is een achtkantige grondzeiler met een stenen voet en een - sinds de restauratie van 1969 - met riet beklede romp en kap. Deze als korenmolen ingerichte molen werd in 1884 in opdracht van A.M. Rijk herbouwd op de plaats van een standerdmolen (verdwenen in 1863). De molen, afkomstig uit Eemnes (U.), was daar als poldermolen in gebruik."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00770> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Philippine (gemeente Terneuzen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Philippine (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Philippine" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 770 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0077> ;
        schema:name "Philippine (gemeente Terneuzen)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "Vesting, gesticht in 1505 door hertog Philips de Schone op de plaats waar de Braakman zich splitste in het Axelse Gat en het Sasse Gat. De in de vorm van een veelhoekig bastion uitgevoerde vesting kreeg in het midden een driehoekig plein. Met de aanleg van een haven in 1599 ontwikkelde Philippine zich tevens tot een vissersdorp. In 1633 viel de vesting in Staatse handen; in 1816 werd zij opgeheven. In 1899-1900 ontstonden de Kanaalpolder en de Mosselpolder, maar Philippine behield de verbinding met de Braakman door de aanleg van het Philippinekanaal tussen beide polders. Mede door de komst van vissers uit het nabijgelegen Boekhoute (B) werd Philippine vanaf 1939 een centrum voor de mosselvangst en mosselhandel. Door de afdamming van de Braakman in 1952 ging de verbinding met de Westerschelde verloren. Na de Tweede Wereldoorlog is Philippine aan de noordzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00771> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Philippine (gemeente Terneuzen)"@nl ;
        min:adres "Achterweg 7" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Philippine (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Philippine" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 771 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0077> ;
        schema:name "Philippine (gemeente Terneuzen)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De Herv. kerk (Achterweg 7) is een wit geschilderde zaalkerk met een kleine houten dakruiter. De oorspronkelijk in 1646 gestichte kerk werd in 1900 in de huidige vorm herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00772> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Philippine (gemeente Terneuzen)"@nl ;
        min:adres "Gentsebreedstraat 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
