        min:kern "Yerseke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 1048 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0112> ;
        schema:name "Yerseke (gemeente Reimerswaal)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De R.K. St.-Annakerk (Langeville 37) is een eenbeukige kerk met recht gesloten koor, noorderdwarsbeuk, dakruiter en een kleine geveltoren. Deze neoromaanse kerk verrees in 1894-'95 naar ontwerp van P.J. van Genk. De huidige geveltoren werd in 1928 geplaatst ter vervanging van een in 1921 omver gewaaide houten voorganger. De kerk is in 1976 gerestaureerd. De voorm. pastorie (Langeville 39) is een villa uit circa 1895 met neorenaissance- en chaletstijl- elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01049> a min:Passage,
