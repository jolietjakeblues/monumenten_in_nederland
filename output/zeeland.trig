        min:hoofdstuk "Steden, dorpen, monumenten › Grijpskerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Grijpskerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 432 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0034> ;
        schema:name "Grijpskerke (gemeente Veere)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Kerkringdorp, ontstaan op een splitsing van twee kreekruggen. Grijpskerke wordt al in 1190 vermeld als zelfstandige parochie. In 1344 werd er een gasthuis gesticht en was er een uithof van de abdij van Middelburg. De bebouwing bleef beperkt tot de Kerkring en de Dorpsweg (nu Gasthuisstraat). Begin 20ste eeuw vond enige verdichting van de bebouwing plaats en recent zijn enkele kleine nieuwbouwwijken ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00433> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grijpskerke (gemeente Veere)"@nl ;
        min:adres "Kerkring 26" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grijpskerke (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Grijpskerke" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13542> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "28113" ;
        min:soort "inleiding" ;
        min:volgnummer 433 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0034> ;
        schema:name "Grijpskerke (gemeente Veere)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "De Herv. kerk (Kerkring 26), oorspronkelijk gewijd aan St. Michaël, is een tweebeukige kerk met een uitgebouwd ingangsportaal en een tussen beide kappen geplaatst open houten klokkentorentje. Daarin hangt een door Jasper van Erpecom gegoten klok (1685). Het oudste deel van de kerk is de vroeg-14de-eeuwse zuidbeuk; de noordbeuk kwam een eeuw later tot stand. In 1770 heeft men de kerk met een travee naar het westen verlengd, de klokkentoren en het portaal toegevoegd, de kap aangepast en het interieur het huidige aanzicht gegeven. Inwendig worden de beuken gescheiden door gedrukte bogen op houten kolommen en gedekt door een vlakke zoldering van 1861. Tot de inventaris behoort een preekstoel met boogpanelen uit het tweede kwart van de 17de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00434> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grijpskerke (gemeente Veere)"@nl ;
        min:adres "Jacob Catsstraat 7" ;
