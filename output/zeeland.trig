        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De Geref. kerk (Beatrixstraat 6) is een zaalkerk uit circa 1900 die bij een verbouwing in 1966-'67 het huidige aanzicht heeft gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00343> a min:Passage,
