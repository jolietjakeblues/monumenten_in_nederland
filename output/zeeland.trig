        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Woonhuizen. Uit circa 1880 dateert het eenvoudige eenlaagspand Langendam 18 met kleine gemetselde trap. Langendam 29 is een voorbeeld van een dwars eenlaagspand uit circa 1895. Rond 1925 gebouwd is Langstraat 26, een tweelaags huis met bedrijfsruimte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01098> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zoutelande (gemeente Veere) – Recreatiewoningen"@nl ;
        min:adres "Duinweg 24",
            "Duinweg 48",
            "Molenweg 29",
            "Westkapelseweg 17" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Veere" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoutelande (gemeente Veere)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zoutelande" ;
        min:lemma "Recreatiewoningen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26274> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "507651" ;
        min:soort "lemma" ;
        min:volgnummer 1098 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0116> ;
        schema:name "Recreatiewoningen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text """Recreatiewoningen. De Larense kunstschilder F. Hart Nibbrig liet in 1910 in de duinen het huis Santvlught (Duinweg 24) bouwen naar een ontwerp van G. Sturm. Voor advocaat Vonk uit Amsterdam ontwierp Sturm 't Streefkerkse Huis (Duinweg 48), een landhuis met rieten kap uit circa 1925.

Het pension ‘Huize Haga’ (Westkapelseweg 17), uitgevoerd met rationalistische elementen, is rond 1915 aan de voet van de duinen gebouwd.

De windmolen (Molenweg 29) is een ronde bakstenen grondzeiler met een met dakleer beklede kap. Een gevelsteen vermeldt dat de molen in 1722 als korenmolen is gebouwd in opdracht van het stadsbestuur van Vlissingen ter vervanging van een omgewaaide standerdmolen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01099> a min:Passage,
