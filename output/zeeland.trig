        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Middelburg" ;
        min:gemeenteInBoek "Middelburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Middelburg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw- en Sint Joosland (gemeente Middelburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Nieuw- en Sint Joosland" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0062> ;
        schema:name "Nieuw- en Sint Joosland (gemeente Middelburg)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Voorstraatdorp met rechthoekige kerkring, gesticht in 1644 na de bedijking van de Middelburgse Polder. Ten zuiden hiervan was al in 1631 de Oud-Sint Jooslandpolder bedijkt. Het daar gelegen gehucht Oude Dorp kwam niet verder tot ontwikkeling; de bebouwing concentreerde zich te Nieuwland. Tot de drooglegging van de Mortierepolder (1846) lag hier het veer naar Middelburg van dit tot dan toe geïsoleerd gelegen eiland. Na 1871 begon men aan de oostzijde met de drooglegging van het Sloe. In 1966 is het gebied bij Middelburg gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw- en Sint Joosland (gemeente Middelburg)"@nl ;
