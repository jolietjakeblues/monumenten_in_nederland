        min:kern "Driewegen" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 369 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0026> ;
        schema:name "Driewegen (gemeente Borsele)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De toegang tot het kerkterrein wordt geflankeerd door bakstenen pijlers bekroond door schilddragende leeuwen met de wapens van Driewegen en Coudorpe."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0026.php> .

