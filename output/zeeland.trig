        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0016> ;
        schema:name "Borssele (gemeente Borsele)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "De (Herv.) Kleine Kerk (Plein 66) is een in 1849-'52 naar plannen van A. de Muijnck opgetrokken neoclassicistische zaalkerk met aangebouwde consistorie en een half ingebouwde toren met opengewerkte houten klokkenlantaarn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00287> a min:Passage,
