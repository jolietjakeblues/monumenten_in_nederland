        min:kern "Zuiddorpe" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80126>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80127>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80128>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80129>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80130> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "508091",
            "508092",
            "508093",
            "508094",
            "508095" ;
        min:soort "inleiding" ;
        min:volgnummer 1102 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill475> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Zuiddorpe (gemeente Terneuzen)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "292" ;
        schema:pagination "292-293" ;
        schema:text "De R.K. O.L. Vrouwe ten Hemelopneming (Dorpsplein 1) is een driebeukige basilikale kruiskerk met een recht gesloten koor en een aan de noordwestzijde geplaatste toren van twee geledingen met ingesnoerde vierzijdige spits. Deze neogotische kerk werd in 1885-'86 gebouwd naar ontwerp van P.J. van Genk ter vervanging van een voorganger uit 1817. Het interieur wordt gedekt door gestukadoorde houten kruisgewelven, waarvan de polychromie (1905-'06) rond 1965 grotendeels onder witkalk is verdwenen. Belangwekkend is de van 1637 daterende, rijk gebeeldhouwde preekstoel (zonder klankbord) met afbeeldingen van de vier evangelisten op de kuippanelen (gerestaureerd 1994). Tot de inventaris behoren verder diverse door J. van Genk-Seelen vervaardigde ongeschilderde houten beelden, op koper geschilderde kruiswegstaties (1906-'07) van A. Windhausen en een door B. Pels & Zn. gebouwd orgel (1929)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01103> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zuiddorpe" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 1103 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill476> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Zuiddorpe (gemeente Terneuzen)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Op het kerkhof bevinden zich enkele belangrijke graftekens, waaronder één in neogotische vormen voor mw. R.J. van Haelst († 1852) en J.B. Onghena († 1871), alsmede één met kruisbekroning voor mw. R.E. Thomaes († 1887) en burgemeester A.A. van Haelst († 1899). Achter de kerk ligt een processiepark, bestaande uit een groep van zeven neogotische half-open kapellen en een Mariakapel (voorheen ‘Het Vagevuur’) uit 1888. De oorspronkelijk in 1876 gestichte Lourdesgrot is verdwenen. In 1982 ontstond een kleine nieuwe grot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01104> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen)"@nl ;
        min:adres "Dorpsplein 3" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zuiddorpe" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 1104 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Zuiddorpe (gemeente Terneuzen)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Het voorm. raadhuis (Dorpsplein 3) is een wit geschilderd pand met trapgevel aan één zijde. De kern wordt gevormd door een midden-19de-eeuwse school die in 1884 tot raadhuis werd verbouwd en vergroot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01105> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zuiddorpe" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 1105 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text """Woonhuizen. Het in de kern mogelijk 18de-eeuwse herenhuis Dorpsplein 13 was het woonhuis van de familie Onghena. De huidige façade is rond 1840 tot stand gekomen. Op het achterterrein bevindt zich de na 1817 als koetshuis gebruikte schuurkerk van het dorp uit 1788. Mogelijk ook een 18de-eeuwse oorsprong hebben de tweelaagse huizen Dorpsplein 12, 17 en 19. Vergelijkbaar van vorm en voorzien van eenvoudige jugendstil-details zijn de herenhuizen Dorpsplein 4 (circa 1910) en Dorpsplein 10 (1912). Eenvoudige art decó-details vertoont het herenhuis Dorpsplein 11, dat rond 1920 tot stand kwam na verbouwing van twee oudere panden.

Het voorm. fort St.-Jan (St.-Janstraat ong.), gelegen ten westen van Zuiddorpe, is een vierkant fort, gebouwd in 1596 door Spaanse troepen als onderdeel van een gordel van forten ten zuiden van Axel. Na de verovering van Sas van Gent (1644) verloor het zijn strategisch belang en in de 19de eeuw bouwde men er een woonhuis."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01106> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiddorpe (gemeente Terneuzen) – Overslag"@nl ;
        min:adres "'t Hoeksken 5",
            "'t Hoeksken 9" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiddorpe (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Zuiddorpe" ;
        min:lemma "Overslag" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 1106 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0117-01> ;
        schema:name "Overslag"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Overslag. Dit grensdorp ten zuiden van Zuiddorpe was tot 1970 de kleinste gemeente van Nederland en besloeg de Overslag- (1692), de Varempé- (1689) en de Moerbekepolder (1699). De kerk van dit dorp staat op Belgisch grondgebied. Bij Dorpsstraat 1 staan enkele grenspalen. De hardstenen paal stamt uit de late 18de eeuw en toont de Staatse leeuw (Nederland) en de dubbelkoppige gekroonde adelaar (Oostenrijk). De beide gietijzeren grenspalen (nrs. 298 en 299) zijn in 1843 aan weerszijden van de weg geplaatst. Vermeldenswaardig zijn verder de voorm. openbare lagere school ('t Hoeksken 5), een eenklassig gebouw uit circa 1900, en het voorm. raadhuis ('t Hoeksken 9), een eenlaagspand uit 1905 met hoger opgetrokken ingangspartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/01107> a min:Passage,
