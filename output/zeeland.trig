        min:adres "Kapelleweg 6" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Scharendijke (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Scharendijke" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 825 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill342> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0084> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "215" ;
        schema:pageStart "215" ;
        schema:pagination "215" ;
        schema:text "Woonhuizen. De oudste huizen bevinden zich nabij de haven, zoals de kleine 19de-eeuwse gepleisterde huizen Baken 16-20 (met verbouwde schuur), Baken 32 en Baken 36. Uit circa 1900 dateert het dwarse huis Dijkstraat 7. Beïnvloed door de neorenaissance-stijl en voorzien van siermetselwerk in afwijkende kleuren baksteen zijn Baken 34, Elkerzeeseweg 32 en de woning annex postkantoor Dorpsstraat 12 (circa 1913). In dezelfde stijl, maar opvallend door een vooruitstekend gedeelte en samengestelde daken, zijn De Acacia's (Kapelleweg 6; circa 1905) en het tweelaags huis Platteweg 28 (circa 1910); beide hebben een balkon en windveren in chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00826> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Scharendijke (gemeente Schouwen-Duiveland) – Boerderijen"@nl ;
        min:adres "Elkerzeeseweg 11" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
