        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 502 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill174>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill175> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0044> ;
        schema:name "Geref. kerken"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text """Geref. kerken. De kerk bij Tramstraat 2 - nu Geref. kerk Vrijgemaakt - is een zaalkerk met sobere neorenaissance-details uit circa 1890. De voorm. Geref. kerk Dr. Leenhoutsstraat 45 - nu woonhuis - is een zaalgebouw met portaal in traditionalistische stijl van 1953 naar plannen van J.A. Wentink, J. van Dijk en J. Kolff.

Het voorm. raadhuis (Molendijk 5), een fors tweelaags gebouw met expressionistische details, dateert uit circa 1920. De hoger opgetrokken ingangspartij is voorzien van een halfrond balkon met het opschrift ‘raadhuis’."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00503> a min:Passage,
            schema:CreativeWork ;
