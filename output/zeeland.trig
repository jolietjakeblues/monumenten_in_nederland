        min:gemeenteInBoek "Sluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJzendijke (gemeente Sluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "IJzendijke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 531 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0047> ;
        schema:name "IJzendijke (gemeente Sluis)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Tot de kerkinventaris behoren een tiengebodenbord (1620), twee gedenkborden (1620 en 1623), een doophek (1815) en een door G.C.F. Witte gebouwd orgel (1872). In de gave zerkenvloer ligt één (van elders afkomstige) zerk uit 1561 en verder overwegend 17de-eeuwse zerken. Het rond 1860 tegen de kerk aan gebouwde middenganghuis bij Kerkstraat 2 deed dienst als pastorie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0047.php> .

