    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00029> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ten geleide"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
