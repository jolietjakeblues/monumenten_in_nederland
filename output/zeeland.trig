        schema:name "Lamswaarde (gemeente Hulst)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De hardstenen dorpspomp (bij J. de Waalstraat 19) is in de knopvormige bekroning gedateerd ‘1886’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00626> a min:Passage,
