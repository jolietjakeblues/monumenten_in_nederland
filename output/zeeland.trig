        min:hoofdstuk "Steden, dorpen, monumenten › Schore (gemeente Kapelle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Schore" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 838 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0086> ;
        schema:name "Schore (gemeente Kapelle)"@nl ;
        schema:pageEnd "217" ;
        schema:pageStart "217" ;
        schema:pagination "217" ;
        schema:text "Kerkringdorp van bescheiden omvang, waarvan de oude dorpskern in 1940 werd verwoest. Bij de wederopbouw werd J. Roodenburgh aangetrokken als supervisor voor het stedenbouwkundig plan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00839> a min:Passage,
            schema:CreativeWork ;
