        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "De kerk van de Geref. Gemeente (Schoolstraat 4) is een forse moderne kerk met dakruiter, gebouwd rond 1980 naast de oude kerk (circa 1880), die nu als verenigingsgebouw in gebruik is."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0085.php> .

