        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driewegen (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Driewegen" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 371 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0026> ;
        schema:name "Driewegen (gemeente Borsele)"@nl ;
        schema:pageEnd "99" ;
        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text "Het voorm. raadhuis (Van Tilburghstraat 31), een dwars pand met trapgevelpartij in neorenaissance-stijl, is een in 1913 naar plannen van J.W. de Weert verbouwde lagere school. Ter vervanging ontwierp hij in 1912 de drieklassige openbare lagere school Van Tilburghstraat 41."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0026.php> .

