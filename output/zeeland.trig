        schema:name "Hoofdplaat (gemeente Sluis)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 1) is een vierkant gebouw uit 1913 met hoektoren en trapgevels op de hoek van beide straatzijden. Het ontwerp met aan de jugendstil verwante details is van J. van Baal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0045.php> .

