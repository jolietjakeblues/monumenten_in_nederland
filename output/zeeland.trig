        schema:name "Sas van Gent (gemeente Terneuzen)"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "Het voorm. postkantoor (Wilhelminastraat 35) is een tweelaags hoekpand uit 1898 met een torenachtig hoekaccent en aan de neorenaissance verwante metselwerkdecoraties."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00817> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sas van Gent (gemeente Terneuzen)"@nl ;
        min:adres "Westkade 89" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
