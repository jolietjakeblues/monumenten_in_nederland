        min:soort "inleiding" ;
        min:volgnummer 378 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill127> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0028> ;
        schema:name "Ellewoutsdijk (gemeente Borsele)"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "99" ;
        schema:pagination "99-100" ;
        schema:text "De Herv. kerk (Van Hattumstraat 5) is een zaalkerk met forse westtoren, gebouwd in 1948-'51 naar plannen van A. Rothuizen en P.J. 't Hooft op de fundamenten van de in de Tweede Wereldoorlog verwoeste middeleeuwse kerk. Deze op een terp gelegen kerk werd al in 1216 vermeld. In de toren hangt een door Peter Waghevens gegoten klok (1527). De pastorie (Van Hattumstraat 3) is gelijk met de huidige kerk gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0028.php> .

