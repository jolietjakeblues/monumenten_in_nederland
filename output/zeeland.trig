        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0080-01> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Woonhuizen. Het forse dwarse huis Dorpsstraat 5 is voorzien van de jaartalankers ‘17..’; het huidige aanzien is echter laat-19de-eeuws. Dorpsstraat 24 is rond 1910 gebouwd als dokterswoning met praktijkruimte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00797> a min:Passage,
