        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Het woonhuis ‘'t Veerschip’ (Veerstraat 1) is een tweelaags gepleisterd pand met omlijste ingang, muurankers en een gevelsteen gedateerd ‘1705’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0062.php> .

