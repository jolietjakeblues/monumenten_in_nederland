        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "6902" ;
        min:soort "inleiding" ;
        min:volgnummer 232 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0008> ;
        schema:name "Aardenburg (gemeente Sluis)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "De Kaaipoort of Westpoort (bij Weststraat 90) is een restant van de in 1620-'25 aangelegde vestingwerken. Deze lage poort in maniëristische vormen heeft aan de landzijde pilasters met de wapens van de Generaliteit en de stad en aan de stadszijde simpele toskaanse pilasters. Het wachthuis met dakruiter en wijzerplaat dateert van 1650. De dakruiter heeft men bij een restauratie in 1890 vernieuwd; de beide lage aanbouwen kregen in 1926 elk een doorgang voor voetgangers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

