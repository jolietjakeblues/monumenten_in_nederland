        schema:name "Ossenisse (gemeente Hulst)"@nl ;
        schema:pageEnd "202" ;
        schema:pageStart "202" ;
        schema:pagination "202" ;
        schema:text "Het voorm. raadhuis (Lageweg 27) is een bescheiden eenlaagspand uit 1924 naar plannen van P.F. Voet. Boven het ingangsportiek staat het opschrift ‘Gemeentehuis’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0072.php> .

