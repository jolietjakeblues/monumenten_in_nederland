        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Kapelle" ;
        min:gemeenteInBoek "Kapelle" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kapelle_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schore (gemeente Kapelle)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Schore" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27989> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "508054" ;
        min:soort "inleiding" ;
        min:volgnummer 839 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill346> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0086> ;
        schema:name "Schore (gemeente Kapelle)"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "217" ;
        schema:pagination "217-218" ;
        schema:text "De Herv. kerk (Nieuwe Kerkplein 4) is een recht gesloten zaalkerk met een aangebouwde consistorie en een ongelede slanke toren met borstwering en smalle naaldspits. Deze kerk kwam in 1942 tot stand naar een ontwerp in traditionalistische vormen van J. Roodenburgh. Opvallend zijn de tuitgeveltjes aan weerszijden van het schip. In de toren hangt een door Pieter van den Ghein gegoten klok (1531). Het kerkinterieur wordt gedekt door een paraboolvormige houten kapconstructie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00840> a min:Passage,
