        min:hoofdstuk "Steden, dorpen, monumenten › Tholen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Tholen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49346>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59570> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "35419",
            "496069" ;
        min:soort "inleiding" ;
        min:volgnummer 943 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill387> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0100> ;
        schema:name "Tholen"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De R.K. O.L. Vrouwe Hemelvaartkerk (Markt 22) is een zaalkerk met portaal en aan de zuidzijde een toren van vier geledingen met achtkantige spits. Deze neogotische kerk verrees in 1900 naar plannen van P. Snel ter plaatse van de Waalse kerk. De toren is ingebouwd door een catechisatiegebouw uit dezelfde tijd. Het interieur wordt gedekt door een houten tongewelf met daarop christelijke symbolen, geschilderd naar plannen van Jac. van Gils en in 1911 uitgevoerd door A. Federle uit Kleef. Achter het hoofdaltaar bevindt zich een schildering van H. Luns. Tot de kerkinventaris behoren een neogotisch hoofdaltaar en een preekstoel (zonder klankbord) vervaardigd door M. van Bokhoven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00944> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tholen"@nl ;
