        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "508042",
            "508043",
            "508044",
            "508045",
            "508046" ;
        min:soort "lemma" ;
        min:volgnummer 840 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0086> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Boerderijen. De rond 1870 gebouwde boerderij Hof Westdorp (Steenweg 42), heeft een onderkelderd dwars woonhuis en een vrijstaande, grotendeels houten schuur die met riet is gedekt. De boerderijen Steenweg 6 en Steenweg 36, met aangebouwde dwarsdeelschuur, dateren uit circa 1900. De in 1908 opgetrokken Anna Hoeve (Frisostraat 13) bestaat uit een vrijstaand middenganghuis, een houten wagenschuur en - in kalkzandsteen - een bakhuis en een varkensstal. De traditionalistisch vormgegeven wederopbouwboerderij Haaimeet 23 (circa 1945) heeft een vrijstaand woonhuis met erker en balkon, en een grote schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0086.php> .

