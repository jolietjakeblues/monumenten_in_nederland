            "Molenstraat 1",
            "Noordstraat 47" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Sluis" ;
        min:gemeenteInBoek "Sluis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sluis_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Retranchement (gemeente Sluis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Retranchement" ;
        min:lemma "Boerderijen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 797 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill336> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0080-01> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Boerderijen. De boerderij Markt 11 heeft een gepleisterd woongedeelte, waarvan de kern waarschijnlijk vroeg-19de-eeuws is. De boerderij De Vlierhof (Braamdijk 9) in de buurtschap Terhofstede heeft een dwars geplaatst woonhuis van 1870. De opvallend aan de noordzijde van de vesting gelegen Oranjehoeve (Noordstraat 47) is een wederopbouwboerderij uit circa 1950. De windmolen (Molenstraat 1) is een open standerdmolen op een molenberg, gesticht in 1643 door Bartholomeus de Vos. In de van een schalieënkap voorziene kast bevinden zich twee zolders. In 1818 is de korenmolen omgewaaid en opnieuw opgebouwd. Herstellingen zijn uitgevoerd in 1948, 1956 en 2002-'03."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00798> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rilland (gemeente Reimerswaal)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Reimerswaal" ;
