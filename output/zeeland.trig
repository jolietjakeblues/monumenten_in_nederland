        schema:name "Windmolen"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Windmolen ‘De Lelie’ (Middelburgsestraat 110) is een gepleisterde ronde stellingmolen met een met dakleer beklede kap. Deze in 1872 gebouwde korenmolen is in het verleden ook als pelmolen in gebruik geweest en is in 1980-'81 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0055.php> .

