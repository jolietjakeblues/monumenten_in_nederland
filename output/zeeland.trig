        min:hoofdstuk "Steden, dorpen, monumenten › Driewegen (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Driewegen" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 367 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0026> ;
        schema:name "Driewegen (gemeente Borsele)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Wegdorp, ontstaan op een driesprong van polderwegen in de rond 1300 bedijkte Coudorpsepolder (later Driewegenpolder geheten). De in 1351 voor het eerst vermelde nederzetting groeide pas in de loop van de 16de eeuw uit tot een dorp van enige omvang. Driewegen behoorde met Everinge en Coudorpe tot de heerlijkheid van Ellewoutsdijk en was tot 1970 een zelfstandige gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00368> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Driewegen (gemeente Borsele)"@nl ;
        min:adres "Van Tilburghstraat 27" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Borsele" ;
        min:gemeenteInBoek "Borsele" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Borsele_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driewegen (gemeente Borsele)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Driewegen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11659> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "9964" ;
        min:soort "inleiding" ;
        min:volgnummer 368 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0026> ;
        schema:name "Driewegen (gemeente Borsele)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De Herv. kerk (Van Tilburghstraat 27) is een recht gesloten zaalkerk met een zeszijdige houten dakruiter en een classicistische voorgevel met rijk gebeeldhouwd dorisch ingangspoortje. De kerk werd gesticht in 1678 (gedenksteen) door de tweelingbroers Frederik en Emmerik van Watervliet, respectievelijk ambachtsheer van Driewegen, Ellewoutsdijk, Everinge en Coudorpe en van 's Heer Hendrikskinderen en Wolphaartsdijk. In de dakruiter hangt een door Nicolaas Muller gegoten klok (1735). De consistorie aan de achterzijde dateert van 1908. Bij een restauratie in 1911-'14, onder leiding van J. Sterk, heeft men de kerk inwendig gewijzigd en vensters aangebracht aan weerszijden van de ingang. In 1985 is een algehele restauratie uitgevoerd. Het interieur wordt gedekt door een houten tongewelf (1914) en bevat een gebeeldhouwde preekstoel van 1679."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0026.php> .

