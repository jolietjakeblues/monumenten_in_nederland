        min:soort "inleiding" ;
        min:volgnummer 846 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0088> ;
        schema:name "Serooskerke (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Kerkringdorp met rechthoekige kerkring, ontstaan op een kreekrug bij een vermoedelijk uit de tweede helft van de 12de eeuw daterende kerk. Het was een heerlijkheid van de heren Van Tuyll van Serooskerke. Bij de belegering van Zierikzee in 1576 werd het dorp verwoest en daarna herbouwd. Bij de Watersnoodramp van 1953 heeft Serooskerke zwaar te lijden gehad."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00847> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Serooskerke (gemeente Schouwen-Duiveland)"@nl ;
        min:adres "Dorpsplein 22" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Veere" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veere> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Serooskerke (gemeente Schouwen-Duiveland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Serooskerke" ;
        min:provincie "Zeeland" ;
        min:soort "inleiding" ;
        min:volgnummer 847 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/afbeelding/sten009monu09ill350> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0088> ;
        schema:name "Serooskerke (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "De Herv. kerk (Dorpsplein 22) is een eenbeukige, recht gesloten kerk met een aangebouwde consistorie en een toren van drie geledingen met ingesnoerde spits. De laat-gotische toren verrees in de eerste helft van de 15de eeuw; erin hangt een door Johannes Meurs gegoten klok (1621). Het van oorsprong vroeg-15de-eeuwse schip heeft men na de brand in 1576 weer opgebouwd, deels met materiaal van het gesloopte koor. De in de 18de eeuw ter plaatse van het koor opgetrokken consistorie is bij de restauratie in 1958 vervangen. Tevens is toen de sterk oostwaarts hellende toren meer rechtop gezet en in de kerk het houten tongewelf vernieuwd. Tot de inventaris behoren een preekstoel uit circa 1660 en een door Johannes Specht vervaardigde koperen kroon uit 1727."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0088.php> .

