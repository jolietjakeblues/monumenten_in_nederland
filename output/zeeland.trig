        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Het voorm. postkantoor annex directeurswoning (Weststraat 44-46) is een fors pand uit 1903 met trapgevels en neorenaissance-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0008.php> .

