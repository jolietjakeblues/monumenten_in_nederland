        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0027> ;
        schema:name "Ellemeet (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "99" ;
        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text "Dijkdorp zonder kerk, ontstaan in de 16de eeuw aan de hoger gelegen Kuijersdam na de verwoesting van het meer zuidelijk gelegen oorspronkelijke dorp met kerk. Het vroeger Oudendijke genoemde dorp had in 1953 zwaar van de Watersnoodramp te lijden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00375> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ellemeet (gemeente Schouwen-Duiveland) – Woonhuizen"@nl ;
        min:adres "Schelpweg 20" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Schouwen-Duiveland" ;
        min:gemeenteInBoek "Schouwen-Duiveland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schouwen-Duiveland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ellemeet (gemeente Schouwen-Duiveland)" ;
