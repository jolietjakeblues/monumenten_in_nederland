        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0050> ;
        schema:name "Kerkwerve (gemeente Schouwen-Duiveland)"@nl ;
        schema:pageEnd "143" ;
        schema:pageStart "143" ;
        schema:pagination "143" ;
        schema:text "Het voorm. raadhuis met onderwijzerswoning (Ring 10-11), een dubbelpand met vooruitstekende entrees en dakerkers, werd in 1909 opgetrokken naar een ontwerp met neoclassicistische en chaletstijl-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00559> a min:Passage,
