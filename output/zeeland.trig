        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De nieuwe R.K. H. Maria ten Hemelopnemingkerk (Philipsplein 10) is een grote koepelkerk met narthex en een terzijde geplaatste toren met tentdak. Deze in 1953-'54 gebouwde kerk ter plaatse van een in 1944 verwoeste voorganger is ontworpen door A. Siebers en W. van Dael in de traditionalistische stijl van de Bossche school en met Byzantijnse elementen. Het bezienswaardige interieur heeft een koorschildering van E. Dekker (1955). De kruiswegstaties (1938) zijn gemaakt door A. Ysabie, de preekstoel (1957) door N. Steenbergen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00774> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Philippine (gemeente Terneuzen)"@nl ;
        min:adres "Meerpaalstraat 3",
            "Stadhuisplein 1" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Philippine (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Philippine" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58699> ;
        min:provincie "Zeeland" ;
        min:rijksmonumentnummer "509987" ;
        min:soort "inleiding" ;
        min:volgnummer 774 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0077> ;
        schema:name "Philippine (gemeente Terneuzen)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "Het voorm. stadhuis (Stadhuisplein 1) is een sober neoclassicistisch eenlaagspand met hoekrisalieten en een kleine dakruiter boven de vooruitstekende ingangspartij met fronton. Het gebouw kwam in 1869 tot stand naar ontwerp van I. Bleijenberg als raadhuis annex openbare lagere school. Aan de Weststraat 2 werd rond 1905 een burgemeesterwoning met neorenaissance-details aangebouwd. In 1905 stichtte men een zelfstandige openbare lagere school (Meerpaalstraat 3) in de vorm van een vijfklassige gangschool."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00775> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Philippine (gemeente Terneuzen) – Woonhuizen"@nl ;
        min:adres "Zandstraat 40" ;
        min:deel "Monumenten in Nederland. Zeeland" ;
        min:gemeente "Terneuzen" ;
        min:gemeenteInBoek "Terneuzen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terneuzen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Zeeland_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Philippine (gemeente Terneuzen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01> ;
        min:kern "Philippine" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Zeeland" ;
        min:soort "lemma" ;
        min:volgnummer 775 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/hoofdstuk/0077> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "206" ;
        schema:pagination "206-207" ;
        schema:text """Woonhuizen. Het rond 1880 gepleisterde woonhuis Gentsebreedstraat 21 is een van de weinige panden waar achter de voorgevel mogelijk een oudere kern schuilgaat. Gele verblendsteen en geglazuurde banden heeft het rond 1905 gebouwde woonhuis Weststraat 1 met gezwenkte topgevel. Rationalistische elementen vertoont het herenhuis Gentsebreedstraat 15 uit circa 1908.

De hardstenen grenspaal tegenover Philipsplein 1 dateert uit de late 18de eeuw en vertoont aan de ene zijde de Staatse Leeuw (Nederland) en aan de andere kant de dubbelkoppige gekroonde adelaar (Oostenrijk).

De R.K. H. Pastoor van Arskerk te Zandstraat (Zandstraat 40), gelegen ten zuidoosten van Philip-pine, is een zaalkerk met portaal en hoge dakruiter in traditionalistische vormen, gebouwd als noodkerk in 1949."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu09_01/passage/00776> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Poortvliet (gemeente Tholen)"@nl ;
        min:deel "Monumenten in Nederland. Zeeland" ;
