        schema:name "Kloosterzande (gemeente Hulst)"@nl ;
        schema:pageEnd "146" ;
        schema:pageStart "146" ;
        schema:pagination "146" ;
        schema:text "De forse, wit gepleisterde pastorie (Groenendijk 38) werd in 1877-'78 gebouwd in neoclassicistische stijl. Het H. Hartbeeld op granieten sokkel is uit circa 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0052.php> .

