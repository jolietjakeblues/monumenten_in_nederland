        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De forse, gepleisterde pastorie (Dorpsstraat 40) dateert uit circa 1855. Het H. Hartbeeld (1926) is gemaakt door J. Custers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0032.php> .

