        schema:name "Nieuwdorp (gemeente Borsele)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De voorm. Geref. kerk (Ring 2) is een recht gesloten neoclassicistische zaalkerk uit 1841 met een achtkantige geveltoren. Het gebouw is in 2003 verbouwd tot appartementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu09_01/sten009monu09_01_0063.php> .

