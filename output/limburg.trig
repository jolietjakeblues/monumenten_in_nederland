        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bocholtz (gemeente Simpelveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bocholtz" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 350 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0025> ;
        schema:name "Bocholtz (gemeente Simpelveld)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Dorp, gelegen op het plateau van Baneheide en in de hoge middeleeuwen vanuit Simpelveld ontgonnen. Het kasteel De Bongard was van 1680 tot 1773 bestuurscentrum van de heerlijkheid Simpelveld-Bocholtz. Van 1803 tot 1982 was Bocholtz een zelfstandige gemeente. Door uitbreiding en ten zuiden van de spoorlijn Maastricht-Aken is Bocholtz thans vastgegroeid aan Bocholtzerheide."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0025.php> .

