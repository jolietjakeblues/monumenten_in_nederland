        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Obbicht (gemeente Sittard-Geleen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Obbicht" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1145 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0117> ;
        schema:name "Obbicht (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen en voorheen Bicht geheten. Bij een zware overstroming in het midden van de 17de eeuw ging het dorp geheel verloren, inclusief de middeleeuwse kerk. Rond de in 1688 nieuw gebouwde kerk ontstond een nieuwe nederzetting. In 1825 werd Obbicht getroffen door een grote dorpsbrand. De bebouwing ontwikkelde zich langs twee elkaar kruisende wegen en is later verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01146> a min:Passage,
