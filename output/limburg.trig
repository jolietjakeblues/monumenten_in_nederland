        min:kern "Thorn" ;
        min:lemma "Bedrijfsgebouwen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1513 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0162> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "362" ;
        schema:pageStart "362" ;
        schema:pagination "362" ;
        schema:text "Bedrijfsgebouwen. De voorm. stroopfabriek ‘De Hof’ (Eind 1-3) is een rijzig pand uit circa 1830, gebouwd voor de familie Sniekers. De bepleistering heeft men rond 1890 aangebracht. De in rijke neorenaissance-stijl uitgevoerde fabrikantenwoning Trippaardstraat 34 werd rond 1895 gebouwd als kantoor en woonhuis bij de voorm. stoomdakpannenfabriek ‘Hendrik van de Boel’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01514> a min:Passage,
            schema:CreativeWork ;
