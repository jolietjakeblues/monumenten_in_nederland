        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0142> ;
        schema:name "Schinveld (gemeente Onderbanken)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "De kerk bevat een ingemetselde Gallo-Romeinse vijzel die - evenals een 19de-eeuwse kopie - als wijwatervat in gebruik is. Tot de inventaris behoren verder kerkbanken en biechtstoelen uit circa 1900 en een door P.J. Vermeulen & Zn. in 1904 gebouwd neogotisch orgel met hergebruikte onderdelen van het oude orgel van de Gebr. Müller (1873)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0142.php> .

