    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00324> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berg en Terblijt (gemeente Valkenburg aan de Geul) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
