        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sittard" ;
        min:lemma "Winkels" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1407 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0149> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "337" ;
        schema:pageStart "337" ;
        schema:pagination "337" ;
        schema:text "Winkels. De laat-19de-eeuwse winkelpui van Markt 26 vertoont invloeden van de neorenaissance. Interessante dubbele winkelpanden in neorenaissance stijl zijn Steenweg 72-74 (circa 1890) en Steenweg 56-58 (circa 1900). Voorbeelden van winkelpanden met jugendstil-elementen zijn Steenweg 36 (circa 1905), Limbrichterstraat 69-71 (circa 1905) en Limbrichterstraat 41 (1911). De laatste is uitgevoerd in witte verblendsteen. Limbrichterstraat 51 (circa 1920) vertoont expressionistische invloeden. Het blokvormige hoekpand Parklaan 6-8 is een bankgebouw uit circa 1930. Zakelijk-expressionistische elementen bezit de winkelpui van Putstraat 47 (circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01408> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sittard (gemeente Sittard-Geleen) – Horeca"@nl ;
        min:adres "Engelenkampstraat 68",
            "Markt 36",
            "Rijksweg Zuid 25" ;
        min:deel "Monumenten in Nederland. Limburg" ;
