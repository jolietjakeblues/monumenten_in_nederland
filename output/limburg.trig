        schema:name "Sint Joost (gemeente Echt)"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "Lineair dorp, waarvan het ontstaan nauw verbonden is met de stichting van een caulietenklooster rond 1300. Het noordelijk deel van St. Joost behoort tot de gemeente Maasbracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0147.php> .

