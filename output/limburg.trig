        min:kern "Horst" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 716 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0071> ;
        schema:name "Horst (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "De voorm. kapelanie (Kloosterstraat 14) is een sober neoclassicistisch gebouw uit 1875 naar plannen van J. Buijssen. Het voorm. liefdesgesticht (Stationsstraat 1) is een fors pand met midden- en hoekrisalieten en neorenaissance-details, gebouwd in 1901 naar plannen van J. Jorna. De uit 1937 daterende kapel in ontworpen door J. Franssen. Het gebouw deed lange tijd dienst als ziekenhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00717> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horst (gemeente Horst aan de Maas)"@nl ;
        min:adres "Gebr. Van Doornelaan 25" ;
        min:deel "Monumenten in Nederland. Limburg" ;
