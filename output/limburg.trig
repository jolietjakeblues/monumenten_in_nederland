        schema:name "Scholen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Scholen. Het jongenspensionaat (Leudalweg 5) is een tweelaags pand in sobere zakelijk-expressionistische vormen, gebouwd in 1933 naar plannen van M.A. Geelen. In dezelfde stijl uitgevoerd is de R.K. lagere H. Hartschool (Steeg 7-9), een drieklassige school met aangebouwde onderwijzerswoning uit circa 1937."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01083> a min:Passage,
            schema:CreativeWork ;
