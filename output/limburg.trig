        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0076> ;
        schema:name "Ittervoort (gemeente Hunsel)"@nl ;
        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "Dorp, ontstaan aan een doorwaadbare plaats in de Itterbeek. Het dorp wordt voor het eerst vermeld in 1252, een brug in 1343. Ittervoort behoorde tot de heerlijkheid Kessenich en maakte tot 1794 met Neeritter en Thorn deel uit van ‘De Drie Eigenen’. De aanleg van de Napoleonsweg leidde tot een verdichting van de dorpsbebouwing. Na de Tweede Wereldoorlog is het dorp aan de noordzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00754> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ittervoort (gemeente Hunsel)"@nl ;
        min:adres "Margarethastraat 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Hunsel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ittervoort (gemeente Hunsel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ittervoort" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54265> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22872" ;
        min:soort "inleiding" ;
        min:volgnummer 754 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill247> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0076> ;
        schema:name "Ittervoort (gemeente Hunsel)"@nl ;
        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "De R.K. St.-Margaritakerk (Margarethastraat 4) is een eenbeukige kerk met verhoogd, recht gesloten koor en een half ingebouwde toren met ingesnoerde spits. Ter plaatse van een middeleeuwse voorganger verrees in 1844-'46 een kerk die in 1935 weer plaats maakte voor de huidige kerk met neoromaanse elementen naar plannen van J. Franssen. Daarbij werd gebruik gemaakt van een deel van de in 1894 gebouwde toren. In de toren hangt een door Jacob van Venrai gegoten klok uit 1472. Tot de inventaris behoren een kruisbeeld van de meester van Elsloo (circa 1500), een uit Heijen afkomstige preekstoel (1684; overgebracht in 1959) en een door P. van Assendelft gebouwd orgel (circa 1760; sinds 1958 in de kerk)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00755> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ittervoort (gemeente Hunsel) – Woonhuizen"@nl ;
        min:adres "Margarethastraat 73" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Hunsel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ittervoort (gemeente Hunsel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ittervoort" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26752> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22874" ;
        min:soort "lemma" ;
        min:volgnummer 755 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill248> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0076> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "171" ;
        schema:pagination "171-172" ;
        schema:text """Woonhuizen. De tot woonhuis verbouwde boerderij Margarethastraat 34 heeft een gevelsteen met het jaartal ‘1770’ en een beeld van St. Joannes Nepomuk. Het huis Margarethastraat 33 heeft jaartalankers ‘1823’. Beide huizen hebben gepleisterde gevels met schijnvoegen. Neorenaissance-details hebben Napoleonsweg 11 (circa 1926) en Napoleonsweg 2 (circa 1924), het laatstgenoemde pand fungeerde in het verleden ook als douanekantoor.

De watermolen ‘Schouwmolen’ (Margarethastraat 73) is een onderslagmolen op de Itterbeek, in opzet daterend uit circa 1630 en in 1830 vergroot in opdracht van J.M. Grispen. Deze korenmolen heeft nog de houten maalstoel met twee koppels stenen, die later door een elektromotor zijn aangedreven. Het waterrad is verdwenen met uitzondering van de spil. De wit gesausde molenaarswoning dateert uit 1822."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00756> a min:Passage,
