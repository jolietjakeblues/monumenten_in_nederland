        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0034> ;
        schema:name "Cadier en Keer (gemeente Margraten)"@nl ;
        schema:pageEnd "97" ;
        schema:pageStart "97" ;
        schema:pagination "97" ;
        schema:text "Op het kerkhof bevinden zich enkele grafkruisen (1632-1676) en het grafteken voor baron G.M.F. de Crassier († 1862). Het H. Hartbeeld dateert uit circa 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0034.php> .

