        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Meijel" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1009 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill388>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill389> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0096> ;
        schema:name "Meijel"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Het voorm. St.-Jozefklooster (Alexanderplein 2) is in 1898 gebouwd als franciscanessenklooster annex meisjesschool. Het tweelaags hoofdgebouw met - oorspronkelijk lagere - vleugels vertoont neogotische details. In 1923 werd een lokaal aangebouwd en in 1928 verrees een afzonderlijke tweeklassige bewaarschool. De noordvleugel heeft men in 1953 verhoogd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0096.php> .

