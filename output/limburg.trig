        min:soort "inleiding" ;
        min:volgnummer 1055 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill403> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0105> ;
        schema:name "Mook (gemeente Mook en Middelaar)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Het raadhuis (Raadhuisplein 6) is een diep pand met souterrain en bel-etage met bordestrap, geflankeerd door een toren met opengewerkte lantaarn. Dit in traditionalistische stijl uitgevoerde pand - mogelijk naar plannen van J.G. Deur - kwam in 1950-'51 tot stand ter vervanging van de in 1944 verwoeste voorganger uit 1867."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01056> a min:Passage,
