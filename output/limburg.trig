        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op het plateau van Margraten bij de herenhoeve De Puthof. Reijmerstok is uitgegroeid tot een bescheiden wegdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0129.php> .

