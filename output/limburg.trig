        rdfs:label "Meterik (gemeente Horst aan de Maas)"@nl ;
        min:adres "Rector De Fauwestraat 28-38" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Horst aan de Maas" ;
