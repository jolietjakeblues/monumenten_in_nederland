        min:adres "Kesselseweg 11" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Peel en Maas" ;
        min:gemeenteInBoek "Helden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Peel_en_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Helden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Helden" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0063> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text """Woonhuizen. Voorbeelden van sobere dorpshuizen zijn het tweelaagspand Mariaplein 3 (circa 1895) en het eenlaagspand Mariaplein 2 (circa 1905). Rond 1930 gebouwd zijn het dubbele woonhuis Molenstraat 29-31, met expressionistische elementen, en de forse expressionistische villa Eyckenduyn (Kesselseweg 11).

Van de boerderij Molenstraat 133 dateert het tweelaags woongedeelte uit 1751 en het bedrijfsgedeelte uit circa 1920."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Herkenbosch (gemeente Roerdalen)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Herkenbosch (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Herkenbosch" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 671 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0064> ;
        schema:name "Herkenbosch (gemeente Roerdalen)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Dorp, ontstaan in de middeleeuwen en in de 12de eeuw met Melick behorend tot de heerlijkheid Wassenberg. Rond 1558 werd de parochie Herkenbosch zelfstandig. De oorspronkelijke lintbebouwing verdichtte zich in de 19de eeuw. Na de Tweede Wereldoorlog heeft Herkenbosch - als forenzendorp van Roermond - door sterke uitbreiding het lineaire karakter verloren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00672> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Herkenbosch (gemeente Roerdalen)"@nl ;
        min:adres "Hoofdstraat 18",
            "Hoofdstraat 21" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Herkenbosch (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Herkenbosch" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39713> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "28550" ;
        min:soort "inleiding" ;
        min:volgnummer 672 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0064> ;
        schema:name "Herkenbosch (gemeente Roerdalen)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "De R.K. St.-Sebastianuskerk (Hoofdstraat 21) is een kruiskerk met een vijfzijdig gesloten koor en een westwerk. Het oudste gedeelte is het vroeggotische, 13de-eeuwse mergelstenen koor met steunberen en spitsboogfriezen. De rest van de kerk dateert van de herbouw uit 1948-'49 naar plannen van H.J.A. Koene. De westwerktoren heeft men na de aardbeving van 1992 in 1993-'94 gewijzigd en voorzien van een lage naaldspits van staal en hout naar plannen van R. Brouwers. Inwendig wordt het koor gedekt door een zesdelig kruisribgewelf, de koorsluiting door een straalgewelf. De scheibogen tussen schip en dwarsarmen rusten op ronde kolommen met bladkapitelen. Het glas-in-lood is in 1948-'49 vervaardigd door J. Scheffers. De pastorie (Hoofdstraat 18) dateert uit 1938."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00673> a min:Passage,
            schema:CreativeWork ;
