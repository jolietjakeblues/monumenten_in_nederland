        schema:name "Wegkapellen"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Wegkapellen. De St.-Antoniuskapel (bij Molenberg 14) is een gepleisterd zeszijdig gebouwtje, gesticht in 1740 door de St.-Urbanusschutterij. De St.-Annakapel (bij Hoogstraat 34) is een 18de-eeuwse driezijdig gesloten wegkapel met gezwenkte topgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0012.php> .

