        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Het voorm. raadhuis (Peterstraat 1) is een tweelaags dwars pand met middenrisaliet en bordestrap, gebouwd in 1954 naar een ontwerp met traditionalistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01062> a min:Passage,
