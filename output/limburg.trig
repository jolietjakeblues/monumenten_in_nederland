        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 239 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0009> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Boerderijen. De deels wit geschilderde voorm. kasteelhoeve Aan de Kerk 4 is een gesloten hoeve uit de tweede helft 17de eeuw met bakstenen fronton boven de poort en een schuur met gemetselde spanten. De mogelijk van 1774 daterende gesloten hoeve Oudestraat 5 is deels in baksteen met mergelbanden en deels in vakwerk uitgevoerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00240> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amstenrade (gemeente Schinnen) – Hommert"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
