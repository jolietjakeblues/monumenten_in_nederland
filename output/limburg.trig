        min:gemeenteInBoek "Meerssen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meerssen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulestraten (gemeente Meerssen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ulestraten" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1549 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0167> ;
        schema:name "Ulestraten (gemeente Meerssen)"@nl ;
        schema:pageEnd "367" ;
        schema:pageStart "367" ;
        schema:pagination "367" ;
        schema:text "Het voorm. raadhuis (St.-Catharinastraat 18) werd rond 1865 gebouwd als raadhuis annex onderwijzerswoning en openbare lagere school. Het rijzige neoclassicistische pand heeft een bordes en een balkon ondersteund door ionische zuilen. Het pand is tot 1982 als raadhuis in gebruik geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0167.php> .

