        min:kern "Gronsveld" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 576 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0053> ;
        schema:name "Gronsveld (gemeente Eijsden)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Het kerkhof is voorzien van een toegang met twee 18de-eeuwse hekpijlers en bevat diverse oude grafkruisen (1554-1718) en een grafsteen voor G.A. Hubertus († 1884). Zowel de pastorie (Kerkplein 4) als de kapelanie (Kerkplein 2) zijn gebouwd rond 1890 en vertonen neorenaissance-details. Het H. Hartbeeld dateert van 1921."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0053.php> .

