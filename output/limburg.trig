        schema:name "Sint Odiliënberg (gemeente Ambt Montfort)"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Het voorm. klooster van de Zusters van het Heilig Graf (Kerkberg 13), een tweelaags pand uit 1876, was tot 1890 de pastorie van de O.L.-Vrouwekapel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0148.php> .

