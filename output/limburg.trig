        schema:name "Huis Schérès"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Huis Schérès (Napoleonsbaan Zuid 12) is een tweelaags landhuis met aangebouwde toren. Het werd in 1766 gebouwd voor baron d'Olne, en kreeg zijn huidige vorm bij een verbouwing rond 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00264> a min:Passage,
