        schema:name "Helden"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Het voorm. patronaatsgebouw ‘St. Joseph’ (Nieuwstraat 7) is een eenlaagspand uit 1908 met mansardedak en neogotische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00670> a min:Passage,
            schema:CreativeWork ;
