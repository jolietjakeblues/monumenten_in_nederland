        min:kern "Neer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15716>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44917> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "17203",
            "30329" ;
        min:soort "inleiding" ;
        min:volgnummer 1080 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0108> ;
        schema:name "Neer (gemeente Roggel en Neer)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Het voorm. raadhuis (Kerkplein 2) is een tweelaags gebouw met souterrain, opvallend gelegen tegen de helling bij de kerk. In de gevel zit een wapensteen uit 1485. Het pand werd in 1646 gemoderniseerd en kreeg in 1818 zijn huidige gepleisterde aanzien. Tot 1852 diende het tevens als school. Sinds 1991 is het een horecagelegenheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01081> a min:Passage,
