        min:hoofdstuk "Steden, dorpen, monumenten › Tegelen (gemeente Venlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Tegelen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51077> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "34982" ;
        min:soort "inleiding" ;
        min:volgnummer 1487 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0160> ;
        schema:name "Tegelen (gemeente Venlo)"@nl ;
        schema:pageEnd "355" ;
        schema:pageStart "355" ;
        schema:pagination "355" ;
        schema:text "De R.K. St.-Martinuskerk (Kerkstraat 1) is een kruisbasiliek met vijfzijdig gesloten koor en een toren van vier geledingen met ingesnoerde spits. Op deze plek verrees in 1430-'40 een laat-gotische kerk (vergroot 1874) met een toren in Nederrijnse vormen. Bij het feest ter gelegenheid van de inhuldiging van koningin Wilhelmina in 1898 brandde de nieuwe torenspits van de in 1894 gerestaureerde toren af en vervolgens het dak van de kerk. Tegen het resterende deel van de toren bouwde men in 1899-1900 de huidige monumentale neogotische kruisbasiliek naar ontwerp van C.J.H. Franssen. De in 1944-'45 zwaar gehavende toren werd hersteld en verhoogd in 1956 naar plannen van J. Franssen. In de noordgevel van de toren is een stuk van een romaans doopvont (12de eeuw) ingemetseld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01488> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tegelen (gemeente Venlo)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Venlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tegelen (gemeente Venlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Tegelen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1488 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0160> ;
        schema:name "Tegelen (gemeente Venlo)"@nl ;
        schema:pageEnd "355" ;
        schema:pageStart "355" ;
        schema:pagination "355" ;
        schema:text "Tot de oude kerkinventaris behoren een Madonnabeeld (circa 1500), enkele vroeg-16de-eeuwse heiligenbeelden, een 17de-eeuws wijwatervat en een koperen doopvont (circa 1800). Verder bevat de kerk een monumentaal Nöhren-orgel (1905), een door F. Langenberg naar ontwerp van Jos. Windhausen vervaardigd vleugelaltaar (1928) en kruiswegstaties (1938) van P. Geraedts. De gebrandschilderde ramen zijn van de firma Nicolas (1912)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01489> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tegelen (gemeente Venlo)"@nl ;
        min:adres "Venloseweg 8" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Venlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tegelen (gemeente Venlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Tegelen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1489 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill545> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0160> ;
        schema:name "Tegelen (gemeente Venlo)"@nl ;
        schema:pageEnd "355" ;
        schema:pageStart "355" ;
        schema:pagination "355" ;
        schema:text "Het voorm. O.L.-Vrouweklooster (Venloseweg 8) is een fors tweelaags complex met kapel. In 1889 vestigden de Zusters van de O.L. Vrouwe zich in het huis ‘De Nieuwe Munt’. Op de plaats van dit huis werd in 1893 een nieuwe neogotische kapel en een eetzaal gebouwd. In 1898 werd het een pensionaat voor schipperskinderen, waarvoor men in 1901 twee vleugels en in 1906 een refter en zusterhuis bouwde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01490> a min:Passage,
