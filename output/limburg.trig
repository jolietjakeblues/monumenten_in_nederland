        schema:name "Nieuwenhagen (gemeente Landgraaf)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De voorm. R.K. lagere school (Aan de Voegelsjtang, achter Hoogstraat 139) is een tweelaags gebouw uit 1931 naar ontwerp van W.H. Nilissen. Het is nu in gebruik als parochiehuis bij de R.K.H. Hart van Jezuskerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01105> a min:Passage,
            schema:CreativeWork ;
