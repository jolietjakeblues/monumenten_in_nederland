        schema:name "Devotionalia"@nl ;
        schema:pageEnd "322" ;
        schema:pageStart "322" ;
        schema:pagination "322" ;
        schema:text "Devotionalia. Bij Wilhelminaplein 13 is een houten gevelkruis geplaatst met een gietijzeren crucifix uit 1810 en een nis met Mariabeeldje. Het in witte natuursteen uitgevoerde H. Hartbeeld bij de kruising Kloosterlaan-Schoolstraat dateert van 1934 en staat op een hardstenen sokkel met Christusmonogram."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01334> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sevenum"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Horst aan de Maas" ;
        min:gemeenteInBoek "Sevenum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Horst_aan_de_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sevenum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sevenum" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1334 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0143> ;
        schema:name "Sevenum"@nl ;
        schema:pageEnd "322" ;
        schema:pageStart "322" ;
        schema:pagination "322" ;
        schema:text "Dorp, ontstaan op de hogere zandgronden van de Noordelijke Peel. Sevenum, dat in 1317 voor het eerst wordt vermeld, behoorde eerst tot Gelre - vanaf 1648 Spaans Gelre - en werd in 1673 een zelfstandige heerlijkheid. In 1713 kwam het aan Pruisen en in 1815 werd het aan Nederland toegevoegd. Vooral na 1870 ontwikkelde het dorp zich tot een lineaire nederzetting met een langgerekt driehoekig plein. Sevenum werd in 1944-'45 zwaar beschadigd, waarbij onder meer het 17de-eeuwse raadhuis werd verwoest. Na de Tweede Wereldoorlog is het dorp uitgegroeid tot één van de grotere kernen in de Peel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0143.php> .

