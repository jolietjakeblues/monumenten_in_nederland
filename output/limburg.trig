        schema:name "Wegkapellen"@nl ;
        schema:pageEnd "340" ;
        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "Wegkapellen. De St.-Annakapel (nabij kruising Kerkdel/Schilbergerweg) is een wegkapel uit circa 1850, de Mariakapel (tegenover Dorpsstraat 57) is een grote wegkapel uit 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01420> a min:Passage,
