        min:soort "inleiding" ;
        min:volgnummer 233 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0008> ;
        schema:name "America (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "66" ;
        schema:pageStart "66" ;
        schema:pagination "66" ;
        schema:text "De voorm. openbare lagere school (Nusseleinstraat 1-5) werd in 1887-'88 gebouwd als een drieklassige gangschool met aangebouwde onderwijzerswoning naar plannen van E. Corbey. Een vierde lokaal is in 1903 toegevoegd en de ophoging dateert van de verbouwing tot woningen rond 1980."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00234> a min:Passage,
            schema:CreativeWork ;
