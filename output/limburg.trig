        schema:pageEnd "394" ;
        schema:pageStart "394" ;
        schema:pagination "394" ;
        schema:text "De R.K. Christus Koning ‘Vredeskerk’ (Whistlerstraat 1) is een moderne lage en brede kerk met rond gesloten koor en vrijstaande betonnen klokkentoren, gebouwd in 1963-'64 naar plannen van Th. Boosten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01647> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venray"@nl ;
