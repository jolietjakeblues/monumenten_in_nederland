        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amstenrade (gemeente Schinnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Amstenrade" ;
        min:lemma "Scholen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 237 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0009> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text """Scholen. De tweelaags voorm. onderwijzerswoning Hagendorenweg 8 deed vóór 1894 tevens dienst als openbare lagere school. Ernaast bouwde men in 1894 de neoclassicistische tweeklassige openbare lagere school Hagendorenweg 10, die later is verbouwd tot patronaat met concertzaal, veldwachterwoning en arrestantenlokaal. In 1922 kwam de openbare lagere school Hoofdstraat 36 tot stand als een vierklassige gangschool naar een ontwerp met neoclassicistische motieven van J. Bemelmans. In het gebouw werd toen tevens het raadhuis ondergebracht. In 1928 werd het de katholieke Aloysiusschool.

Het voorm. raadhuis annex brandweerkazerne (Raadhuisplein 10) is rond 1960 gebouwd in traditionalistische stijl."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00238> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amstenrade (gemeente Schinnen) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Schinnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amstenrade (gemeente Schinnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Amstenrade" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 238 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0009> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Woonhuizen. Het dwarse tweelaags huis Aan de Kerk 1 heeft een in vakwerk uitgevoerde zijgevel en draagt de jaartalankers ‘1792’. Het aangrenzende wit geschilderde pand Hagendorenweg 2 met haakse eenlaags vleugel dateert uit de eerste helft van de 19de eeuw. In 1880 gebouwd is het middenganghuis Hagendorenweg 11. Expressionistische details vertoont het huis Hoofdstraat 67 uit 1924 met hoger opgetrokken middenrisaliet. Zakelijk-expressionistische vormen hebben het dubbele herenhuis Hommerter Allee 8-10 (1931) naar ontwerp van A.J. Jeurissen en Nieuwstraat 2 (1933) naar ontwerp van L. Fiddelers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00239> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amstenrade (gemeente Schinnen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Schinnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
