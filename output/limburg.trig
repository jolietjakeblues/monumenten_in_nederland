        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asselt (gemeente Swalmen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Asselt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 253 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0011> ;
        schema:name "Asselt (gemeente Swalmen)"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "Het kerkhof rondom de kerk is uitgevoerd als een etagebegraafplaats met enkele 17de-19de-eeuwse grafkruisen en een exemplaar uit 1558."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00254> a min:Passage,
