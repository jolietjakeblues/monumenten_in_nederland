        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
        min:gemeenteInBoek "Brunssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
