        min:provincie "Limburg" ;
        min:rijksmonumentnummer "512731" ;
        min:soort "inleiding" ;
        min:volgnummer 638 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill197>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill198> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0060> ;
        schema:name "Heerlen"@nl ;
        schema:pageEnd "140" ;
        schema:pageStart "140" ;
        schema:pagination "140" ;
        schema:text "Naast de kerk staat het franciscanerklooster (Beersdalweg 64) uit 1929 in traditionalistische vormen. Dit gebouw, dat tevens de pastorie bevat, is ook ontworpen door Peutz, evenals het oorspronkelijk voor het kerkbestuur bestemde pand Beersdalweg 58 uit 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00639> a min:Passage,
