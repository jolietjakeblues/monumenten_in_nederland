        min:soort "lemma" ;
        min:volgnummer 1307 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0139> ;
        schema:name "Oensel"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "Oensel. Gehucht ten noordwesten van Schimmert. Een 17de-eeuwse kern heeft de gepleisterde L-vormige Hoeve Oensel (Langs de Gewannen 75), die overigens is gedateerd ‘1733’. De gesloten hoeve Haagstraat 5 dateert uit 1788 (sluitsteen en jaartalankers). Boerderij De Linde (Oensel 3) werd in 1941 gebouwd ter plaatse van een voorganger uit 1744 en heeft een verhoogde poortingang met tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01308> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
