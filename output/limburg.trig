        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Rimburg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1228 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill451> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0133> ;
        schema:name "Rimburg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op de westflank van het dal van de Worm nabij het in oorsprong 12de eeuwse kasteel Rimburg. In 1815 werd de vrije heerlijkheid Rimburg in een Nederlands en Duits deel gesplitst. De grenscorrectie van 1949 naar het oosten - tot de spoorlijn Aken-Dusseldorf - werd in 1963 ongedaan gemaakt; het Nederlandse deel is thans een beschermd gezicht, het kasteel ligt op Duits grondgebied."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0133.php> .

