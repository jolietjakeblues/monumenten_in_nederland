        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwenhagen (gemeente Landgraaf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nieuwenhagen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1107 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0111> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "274" ;
        schema:pagination "274-275" ;
        schema:text """Woonhuizen. Uit het eerste kwart van de 20ste eeuw dateren de villa's Heigank 27 en Heigank 29 en het herenhuis Heigank 132 (1924), dat naar ontwerp van A.J.N. Boosten werd gebouwd als woonhuis met dokterspraktijk voor dr. Snijders.

Het voorm. café Heigank 24 dateert van 1901 en wordt gekenmerkt door decoratief gestukadoorde gevels in eclectische stijl. Het pand is in 1955 verbouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01108> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwstadt (gemeente Susteren)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Echt-Susteren" ;
        min:gemeenteInBoek "Susteren" ;
