        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Epen (gemeente Gulpen-Wittem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Epen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30214> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "39150" ;
        min:soort "inleiding" ;
        min:volgnummer 479 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill148>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill149> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0042> ;
        schema:name "Epen (gemeente Gulpen-Wittem)"@nl ;
        schema:pageEnd "110" ;
        schema:pageStart "109" ;
        schema:pagination "109-110" ;
        schema:text "De R.K. St.-Pauluskerk (Kapelaan Houbenstraat 3) is een eenbeukige kerk met rond gesloten koor, aangebouwde sacristie en een half ingebouwde toren met ingesnoerde naaldspits. Deze neoclassicistische kerk kwam in 1841-'42 tot stand naar ontwerp van J.H.J. Dumoulin op de plaats van een romaanse voorganger. De toren werd in 1847-'48 toegevoegd naar plannen van architect Lintzen. De sacristie heeft een gevel met fronton en madonnabeeld. In 1932 kreeg het torenfront aan de westzijde een uitbreiding met een voorbouw met ingangsportaal en nevenruimte naar plannen van M. Clairfays. Het kerkinterieur wordt gedekt door stucgewelven. Tot de inventaris uit circa 1843 behoren het neobarokke hoofdaltaar met altaarstuk, de zijaltaren, de koorbanken en een communiebank. De gebrandschilderde glazen zijn van H. Oidtmann (1894)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00480> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Epen (gemeente Gulpen-Wittem)"@nl ;
        min:adres "Wilhelminastraat 39/Heerstraat 7" ;
        min:deel "Monumenten in Nederland. Limburg" ;
