        min:rijksmonumentnummer "35514" ;
        min:soort "inleiding" ;
        min:volgnummer 1505 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0162> ;
        schema:name "Thorn"@nl ;
        schema:pageEnd "360" ;
        schema:pageStart "360" ;
        schema:pagination "360" ;
        schema:text "Het voorm. begijnhof, ook wel ‘Pottenhuis’ genoemd (Kloosterberg 1), is een langgerekt gebouw met hardstenen vensteromlijstingen. Op een ingangsomlijsting in de noordgevel staat het jaartal ‘1772’. Het gebouw is ook in gebruik geweest als pottenbakkerij van het stift."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01506> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Thorn"@nl ;
        min:adres "Daalstraat 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Maasgouw" ;
        min:gemeenteInBoek "Thorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasgouw> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Thorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
