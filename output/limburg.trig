        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 382 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Brunssum"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De voorm. pastorie (Kerkstraat 360) is een wit gepleisterde villa, die in 1909 zijn vorm kreeg met handhaving van een deel van de voorgevel van een voorganger uit 1737."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00383> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Brunssum – Overige kerken"@nl ;
        min:adres "Akerstraat 99",
            "Essenstraat 1",
            "Kloosterstraat 17",
            "Lindeplein 2b",
            "Lindestraat 40",
            "Prins Hendriklaan 213-221",
            "Raadhuisstraat 13",
            "St.-Gregoriuslaan 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
        min:gemeenteInBoek "Brunssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:lemma "Overige kerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12756>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56463> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "518600",
            "518605" ;
        min:soort "lemma" ;
        min:volgnummer 383 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill118>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill119> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text """Overige kerken. De R.K.H. Familiekerk (Akerstraat 99) is een driebeukige kruiskerk in traditionalistische vormen, in 1951-'52 gebouwd naar een ontwerp van de toen al overleden A.J.N. Boosten. De R.K. kerk O.L. Vrouwe van Fatima (Lindestraat 40), een zaalkerk met inpandig voorportaal en hoger koorgedeelte, werd in 1952-'53 gebouwd naar een traditionalistisch ontwerp van gemeente-architect J. Drummen. De in 1959-'60 naar plannen van A. Schwencke gebouwde moderne R.K. St.-Jozefkerk (St.-Gregoriuslaan 2) is een kruiskerk met betonskelet en geprefabriceerde houten dakconstructie.

De voorm. marechausseekazerne (Prins Hendriklaan 213-221) werd in 1914 opgetrokken in traditionalistische vormen, in aansluiting op de opzichterwoningen van de Staatsmijn Hendrik. De kazerne is later verbouwd tot een complex woonhuizen.

Het voorm. raadhuis (Lindeplein 2b) is een onderkelderd tweelaags pand met bordes en overhoeks geplaatste klokkentoren, gebouwd in 1919 in Nieuw-Historiserende stijl naar ontwerp van J. Bemelmans. De achteraanbouw dateert van 1921. De gevels zijn later wit gesausd. In 1952 en 1974 zijn interieurwijzigingen uitgevoerd.

Het voorm. Groene Kruisgebouw (Kloosterstraat 17) werd in 1934 gebouwd in functionalistische stijl naar ontwerp van J.L.M. Willems. Het deels gepleisterde pand heeft bij het trappenhuis een karakteristieke verticale vensterstrook.

Het postkantoor (Raadhuisstraat 13) kwam in 1938 tot stand in traditionalistische vormen naar plannen van J. de Bruin van de Rijksgebouwendienst. De voorgevel heeft rechts een topgevel met schouderstukken en links een licht risalerend gedeelte met entree en bordestrap.

De R.K. lagere school ‘Fatima’ (Essenstraat 1) werd rond 1950 gebouwd naar een ontwerp met functionalistische elementen van J. Drummen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00384> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Brunssum – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
