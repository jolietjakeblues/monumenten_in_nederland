        min:soort "inleiding" ;
        min:volgnummer 326 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0021> ;
        schema:name "Bergen"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "Dorp, enigszins geïsoleerd aan de Maas gelegen op korte afstand van de weg van Nijmegen naar Venlo. Het voor het eerst in 1269 vermelde dorp behoorde tot de heerlijkheid Well dat in 1648 onderdeel van Spaans Gelre werd, in 1713 aan Pruisen kwam en in 1815 bij Nederland werd gevoegd. In de Franse tijd ontstond uit de heerlijkheden Heijen, Afferden en Well één gemeente, met het raadhuis te Bergen. Na zware oorlogsschade in 1944-'45 volgde de wederopbouw van het dorp. Op de iets hogere gronden ten oosten van de rijksweg ontstond het dorp Nieuw-Bergen. In 1969 bouwde men hier het raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00327> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen"@nl ;
        min:adres "Oude Kerkstraat 9" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bergen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 327 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0021> ;
        schema:name "Bergen"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "De kerktoren van de oude R.K. St.-Petruskerk (bij Oude Kerkstraat 9) is een rond 1975 geconsolideerde torenruïne van drie geledingen. Deze bij een kleine, rond 1250 gebouwde, kerk behorende romaanse toren heeft een - oorspronkelijk gepleisterde - onderbouw in ijzeroer. De anderhalve geleding daarboven is uitgevoerd in mergelsteen en versierd met lisenen en een rondboogfries. In de late middeleeuwen is de toren in baksteen verhoogd. De in 1827 vernieuwde, kerk werd in 1932 gesloopt. De nog in 1941 gerestaureerde toren werd in 1944 zwaar beschadigd en verloor daarbij zijn spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00328> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen"@nl ;
        min:adres "Kerkstraat 6",
            "Kerkstraat 8" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bergen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 328 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill97> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0021> ;
        schema:name "Bergen"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "De nieuwe R.K. St.-Petruskerk (Kerkstraat 6) is een sobere driebeukige kruiskerk met een terzijde geplaatste toren met ingesnoerde spits. Deze oorspronkelijk in 1932 naar ontwerp van M. van Beek gebouwde kerk werd in 1944-'45 zwaar beschadigd en bij de herbouw in 1948-'50 onder leiding van dezelfde architect met enige wijzigingen - zoals de veelhoekige koorsluiting - herbouwd. Behalve de koperen preekstoel (1932), stamt de inventaris uit de herbouwtijd. De sobere blokvormige pastorie (Kerkstraat 8) dateert uit het eind van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00329> a min:Passage,
