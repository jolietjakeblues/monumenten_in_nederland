        min:kern "Posterholt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1194 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0126> ;
        schema:name "Posterholt (gemeente Ambt Montfort)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Langgerekte boshoevennederzetting, ontstaan in de 12de eeuw aan de rand van het dal van de Vlootbeek. In 1793 werd Posterholt een zelfstandige parochie door afscheiding van Vlodrop."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01195> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Posterholt (gemeente Ambt Montfort)"@nl ;
        min:adres "Hoofdstraat 59" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Ambt Montfort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Posterholt (gemeente Ambt Montfort)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Posterholt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1195 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0126> ;
        schema:name "Posterholt (gemeente Ambt Montfort)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "De R.K. St.-Mathiaskerk (tegenover Hoofdstraat 59) is een pseudobasilicale mergelstenen kruiskerk met ronde apsis, gebouwd in 1950-'51 in neoromaanse vormen naar plannen van F.P.J. Peutz. De westtoren met hoge ingesnoerde naaldspits heeft men in 1961-'62 toegevoegd. Tot de inventaris behoren enkele beelden en kruiswegstaties, afkomstig uit de in 1945 verwoeste neogotische dorpskerk. Het H. Hartbeeld is in 1934 geschonken door mijnwerkers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01196> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Posterholt (gemeente Ambt Montfort) – Huis Aerwinckel"@nl ;
        min:adres "Burg. Geradtsstraat 97" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Ambt Montfort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Posterholt (gemeente Ambt Montfort)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Posterholt" ;
        min:lemma "Huis Aerwinckel" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1196 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill443> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0126> ;
        schema:name "Huis Aerwinckel"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Huis Aerwinckel (Burg. Geradtsstraat 97). Dit huis werd in 1856 gebouwd voor de familie Geradts naar ontwerp van P.J.H. Cuypers in vroege neogotische stijl. Het verving het oude middeleeuwse kasteel Aerwinckel. Het blokvormige pand heeft een verhoogd middenrisaliet tussen trapgevels. Opvallend zijn de vele arkeltorentjes en kantelen. Boven de hoofdingang heeft men verschillende oude gevelstenen ingemetseld. Na de oorlog is het huis in gebruik geweest als rusthuis voor de Zusters van de Goddelijke Voorzienigheid. Rond het huis ligt een park in rijpe landschapsstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01197> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Posterholt (gemeente Ambt Montfort) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
