        min:volgnummer 1292 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0138> ;
        schema:name "Schaesberg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Op het kerkhof staan enkele oude stenen grafkruisen (1710-1811), waaronder een 18de-eeuws kruis met daarop een kleine Calvarie en ‘memento mori’. Verder zijn er enige fragmenten van beeldhouwwerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01293> a min:Passage,
            schema:CreativeWork ;
