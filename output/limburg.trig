            "Ingberdorpsstraat 38" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Gulpen-Wittem" ;
        min:gemeenteInBoek "Gulpen-Wittem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gulpen-Wittem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gulpen (gemeente Gulpen-Wittem)" ;
