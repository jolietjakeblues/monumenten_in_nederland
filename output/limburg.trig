        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill92> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0018> ;
        schema:name "Belfeld (gemeente Venlo)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Het stuw- en sluiscomplex in de Maas (Aan de Stuw ong.) werd in 1920-'21 gebouwd in het kader van de Maaskanalisering. Het centrale deel van de stuw bestaat uit twee portaalvormige afvoeropeningen met zogeheten stalen ‘Stoneyschuiven’. De oostelijk gelegen scheepvaartopening heeft stalen wielschuiven die bij hoog water weggehaald worden. In opgestuwde situatie maakt de scheepvaart gebruik van de westelijk gelegen dubbele schutsluis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00309> a min:Passage,
            schema:CreativeWork ;
