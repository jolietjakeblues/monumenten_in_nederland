        schema:text "De voorm. openbare lagere school (St.-Jansstraat 18), gebouwd in 1894 als een drieklassige gangschool naar plannen van J. Jorna, doet nu dienst als voorbouw van de sporthal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01040> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meterik (gemeente Horst aan de Maas) – Woonhuizen"@nl ;
        min:adres "Afhangweg 13",
            "Schadijkerweg 28" ;
        min:deel "Monumenten in Nederland. Limburg" ;
