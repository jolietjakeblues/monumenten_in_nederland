        schema:name "Roermond"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "De voorm. Geref. kerk ‘Oos Kirk’ (Kapellerlaan 71) [9] is een zaalkerk met terzijde staande toren, gebouwd in 1921 met expressionistische en neoromaanse elementen. De kerk is na 1973 tot woonhuis verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0134.php> .

