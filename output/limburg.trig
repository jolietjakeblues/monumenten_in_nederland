        schema:name "Steijl (gemeente Venlo)"@nl ;
        schema:pageEnd "344" ;
        schema:pageStart "344" ;
        schema:pagination "344" ;
        schema:text "Het H. Geestklooster (Kloosterstraat 19) is een slotklooster van vier vleugels om een binnenplaats, gebouwd in 1912-'14 in een rijk gedetailleerde neogotische stijl. Het werd de vestiging van de in 1896 gestichte Dienaressen van de H. Geest van Altijddurende Aanbidding of Aanbiddingszusters, vanwege de kleur van hun kleding ‘rose nonnen’ genoemd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01442> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steijl (gemeente Venlo)"@nl ;
        min:adres "Waterloostraat 28" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Venlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steijl (gemeente Venlo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
