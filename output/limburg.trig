        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Het voorm. raadhuis (Breusterstraat 1) is een fors pand voorzien van een hoektoren en een ingangsrisaliet met puntgevel. Het rond 1910 opgetrokken gebouw vertoont neorenaissance- en rationalistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0038.php> .

