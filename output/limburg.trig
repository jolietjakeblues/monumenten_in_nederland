        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Banholt (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Banholt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 273 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0014> ;
        schema:name "Banholt (gemeente Margraten)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De R.K. lagere school (Bredeweg 3) is een rond 1925 opgetrokken T-vormige school met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00274> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Banholt (gemeente Margraten) – Boerderijen"@nl ;
        min:adres "Terhorst 11" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Banholt (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Banholt" ;
        min:lemma "Boerderijen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 274 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0014> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text """Boerderijen. Het uit circa 1563 (d) daterende vakwerkpand Bergstraat 16 is in 1978-'79 overgebracht uit Eijsden. De kapitale boerderij Mheerderweg 65 is een nagenoeg gesloten hoeve waarvan het gedeeltelijk onderkelderde woonhuis in opzet 17de-eeuws is; de gevel dateert van een verbouwing rond 1800. De tweebeukige langsdeelschuur met aangebouwde, halfopen wagenschuur is midden-19de-eeuws. Van de begin 18de eeuw opgetrokken gesloten hoeve Dalestraat 24 is het woongedeelte met mergelstenen speklagen uitgevoerd. De grote gesloten hoeve Loverixplein 8 werd mogelijk gebouwd als laathof van het Akense Munsterstift. De sluitsteen van de schuur is gedateerd ‘1768’, die boven de huisingang ‘1773’. Van de L-vormige boerderij Terhorst 23 stamt het woonhuis uit de 18de eeuw en de doorrijschuur uit de eerste helft van de 19de eeuw. De naastgelegen vakwerkboerderij Terhorst 21 uit circa 1800 is na brand herbouwd. De gesloten hoeve Bredeweg 5-7 is op de poortsluitsteen gedateerd ‘1816’; de vergelijkbare hoeve Bredeweg 2 is gedateerd ‘1819’. De kleine vakwerkhoeve Bredeweg 14 bestaat uit een rond 1800 gebouwd woongedeelte en een haakse poortvleugel uit 1843.

Het trafohuisje (Bredeweg ong.) is een blokvormig gebouwtje uit 1926 met tentdak.

De Mariakapel (bij Terhorst 11) is een wit gepleisterde wegkapel uit 1949."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Banholt (gemeente Margraten) – Bruisterbosch"@nl ;
        min:adres "Bruisterbosch 1-3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Banholt (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Banholt" ;
        min:lemma "Bruisterbosch" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27950> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "34650" ;
        min:soort "lemma" ;
        min:volgnummer 275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0014> ;
        schema:name "Bruisterbosch"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Bruisterbosch. Dit gehucht ten noorden van Banholt is een in oorsprong eenrijige plateaunederzetting - ook Breusterbosch genoemd -, gesticht in 1157 vanuit Breust bij Eijsden. Bruisterbosch is een beschermd gezicht. De forse gesloten herenhoeve Breusterbosch (Bruisterbosch 1-3) heeft een haaks op de straat staand herenhuis uit de eerste helft van de 18de eeuw dat later naar de straat toe is verlengd. De poortsluitsteen is gedateerd ‘1706’. De bedrijfsvleugels - waaronder een schuur uit 1850 - zijn overwegend 19de-eeuws. Uit de 19de eeuw dateren ook de geschakelde U-vormige hoeven Bruisterbosch 9 (1837), 7 (1864) en 5 (circa 1870)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Banholt (gemeente Margraten) – Terlinden"@nl ;
        min:adres "Terlinden 30" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Banholt (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Banholt" ;
        min:lemma "Terlinden" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 276 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0014> ;
        schema:name "Terlinden"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Terlinden. Dit gehucht ten oosten van Banholt is een lintvormige plateaunederzetting, waarvan de bebouwing terug gaat tot de 18de eeuw. Deels in vakwerk uitgevoerd is de sterk gerestaureerde gesloten hoeve Terlinden 8-10, die op de poortlatei is gedateerd ‘1754’. De bijna-gesloten hoeve Terlinden 16-16a heeft een 18de-eeuwse kern met vakwerk- en breuksteenwanden. Eveneens 18de-eeuws is de L-vormige vakwerkhoeve Terlinden 22-24. Uit de 19de eeuw dateert de grote gesloten hoeve Terlinden 36-38 met vakwerkschuur. De gietijzeren wegwijzer (Gulperstraat/Terlinden) is rond 1890 vervaardigd. De O.L.-Vrouwekapel (Terlinden 30) is een aardige moderne wegkapel uit circa 1960."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beegden (gemeente Heel)"@nl ;
