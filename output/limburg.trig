        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18100>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32722> ;
        min:provincie "Limburg" ;
