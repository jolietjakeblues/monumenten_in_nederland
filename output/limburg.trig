        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venray_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Venray" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Venray" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1640 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0174> ;
        schema:name "Venray"@nl ;
        schema:pageEnd "393" ;
        schema:pageStart "393" ;
        schema:pagination "393" ;
        schema:text "Rondom de kerk bevinden zich enkele uit de kerk afkomstige grafzerken (15de-18de eeuw) en acht grafkruisen (17de-19de eeuw). De kapelanie (Raadhuisstraat 18) dateert uit circa 1890, de pastorie (Kerkpad 1) uit circa 1931."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01641> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venray"@nl ;
        min:adres "Stationsweg 46",
            "Stationsweg 65" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venray" ;
        min:gemeenteInBoek "Venray" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venray_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Venray" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Venray" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67585> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "524023" ;
        min:soort "inleiding" ;
        min:volgnummer 1641 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0174> ;
        schema:name "Venray"@nl ;
        schema:pageEnd "393" ;
        schema:pageStart "393" ;
        schema:pagination "393" ;
        schema:text "Het psychiatrisch ziekenhuis St. Servatius (Stationsweg 46) - nu onderdeel van het ‘Vincent van Gogh Instituut’ - werd in 1905-'07 gebouwd in opdracht van de Broeders van Liefde uit Gent als krankzinnigeninstituut voor mannelijke patiënten. De gebouwen zijn ontworpen door de Belgische architect H. Vandeplas. Centraal geplaatst is de met neoromaanse details uitgevoerde gestichtskerk met dwarsschip en dakruiter. Op het terrein staan enkele interessante gestichtsgebouwen, waaronder paviljoen G met rondbogen en twee hoektorens met neobarokke bekroningen. De dokterswoning (Stationsweg 65) uit 1905 vertoont hetzelfde materiaalgebruik. Rond 1920 zijn enkele gebouwen toegevoegd. Het hoofdgebouw is in 1945 afgebrand; het nieuwe dateert uit 1958."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01642> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venray"@nl ;
        min:adres "Dr. Kortmannweg 1",
            "Noordsingel 39",
            "St.-Annalaan 1-4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venray" ;
