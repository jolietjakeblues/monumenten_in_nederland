        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venray_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geysteren (gemeente Meerlo-Wanssum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geysteren" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 543 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill173> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0049> ;
        schema:name "Geysteren (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "123" ;
        schema:pagination "123-124" ;
        schema:text "De voorm. openbare lagere school (Dorpstraat 17) werd rond 1915 gebouwd als een drieklassige gangschool met aangebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00544> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geysteren (gemeente Meerlo-Wanssum)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
