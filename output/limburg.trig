        min:kern "Nieuwenhagen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67739>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67740> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "521672",
            "521673" ;
        min:soort "inleiding" ;
        min:volgnummer 1102 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0111> ;
        schema:name "Nieuwenhagen (gemeente Landgraaf)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De R.K.H. Hart van Jezuskerk (Hoogstraat 137) is een kruiskerk met halfronde apsis, uitgebouwd ingangsportaal en een terzijde geplaatste toren. Deze kerk in zakelijk-expressionistische vormen kwam in 1919-'20 tot stand naar ontwerp van J. Wielders. Tot de inventaris behoren het oorspronkelijke kerkmeubilair en de authentieke houten deuren. De glas-in-loodramen in het schip en de gewelfschilderingen zijn uitgevoerd door J. Verheyen (1925). De door Wielders in expressionistische vormen ontworpen pastorie (Hoogstraat 139) dateert van 1917."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01103> a min:Passage,
