        schema:name "Merselo (gemeente Venray)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "De ballonzuil (Rozendaal ong.), gelegen ten noorden van Merselo, is een in 1896 onthulde obelisk op sokkel. Herdacht wordt de landing in 1871 van drie Franse ballonvaarders, die uit het toen door de Duitsers belegerde Parijs waren opgestegen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01028> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Merselo (gemeente Venray)"@nl ;
        min:adres "Joh. van Stalbergweg 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venray" ;
        min:gemeenteInBoek "Venray" ;
