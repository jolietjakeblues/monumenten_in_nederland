        schema:name "Kessel"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Op het kerkhof bevinden zich enkele 17de-eeuwse grafkruisen, een grafkruis voor J. Timmermans († 1896) en een baarhuisje uit 1916. Het H. Hartbeeld stamt uit 1925. De voorm. pastorie (Kerkplein 2) werd rond 1870 gebouwd. De huidige pastorie (Dorpstraat 13) kwam in 1934 in traditionalistische vormen tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0079.php> .

