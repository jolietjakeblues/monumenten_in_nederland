        rdfs:label "Mook (gemeente Mook en Middelaar)"@nl ;
        min:adres "Rijksweg 38" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Mook en Middelaar" ;
        min:gemeenteInBoek "Mook en Middelaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Mook_en_Middelaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mook (gemeente Mook en Middelaar)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Mook" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1054 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0105> ;
        schema:name "Mook (gemeente Mook en Middelaar)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "De R.K. kweekschool ‘Maria Immaculata’ (Rijksweg 38) is het enige restant van het in 1848 door de Franciscanessen van Heythuysen gestichte Klooster Maria, dat in 1944 zware oorlogsschade opliep. Het in 1922-'23 opgetrokken tweelaags schoolgebouw heeft neogotische details en een middenrisaliet met puntgevel. Na van 1977 tot 1993 als school en internaat voor de Rijn- en binnenvaartschool te hebben gediend, is het pand in 1997 verbouwd tot wooneenheden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01055> a min:Passage,
