        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ubachsberg (gemeente Voerendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ubachsberg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1542 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0166> ;
        schema:name "Ubachsberg (gemeente Voerendaal)"@nl ;
        schema:pageEnd "366" ;
        schema:pageStart "366" ;
        schema:pagination "366" ;
        schema:text "De voorm. R.K. lagere school (Oude Schoolstraat 33), uitgevoerd in Kunradersteen met twee kleine trapgevels, is gebouwd in 1916 en is sinds een renovatie in 1979 in gebruik als oefenruimte voor de fanfare. E.G. Meijers-Crouten ontwierp tegelijkertijd de onderwijzerswoning (Oude Schoolstraat 35), een blokvormig tweelaags pand van Kunradersteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01543> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ubachsberg (gemeente Voerendaal) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
