        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijckholt (gemeente Eijsden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Rijckholt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1225 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0132> ;
        schema:name "Rijckholt (gemeente Eijsden)"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen in het dal van de Maas. Vanaf de 12de eeuw was het een Vrije Rijksheerlijkheid en van de 16de eeuw tot 1794 een Rijksbaronie. Rijckholt ontwikkelde zich in de 19de eeuw tot een wegdorp aan de weg van Maastricht naar Luik."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01226> a min:Passage,
            schema:CreativeWork ;
