        min:soort "inleiding" ;
        min:volgnummer 1109 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill416>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill417> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0112> ;
        schema:name "Nieuwstadt (gemeente Susteren)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "De R.K. St.-Johannes de Doperkerk (Millenerstraat 1) is een driebeukige basilicale kerk met een driezijdig gesloten koor, een houten klokkentorentje en een ongelede toren met tentdak. Het schip kwam in de tweede helft van de 13de eeuw tot stand. Het enigszins scheef aangelegde koor volgde in de eerste helft van de 14de eeuw. Bij een ingrijpende restauratie in 1862 door P.J.H. Cuypers zijn aan weerszijden van het koor sacristieruimten aangebouwd. In 1927 verrees naar ontwerp van J. Wielders op een middeleeuwse onderbouw de huidige zware mergelstenen toren met aan weerszijden een lage zijbeuk aansluitend op de zijbeuken van het schip. In de toren hangt een door J. Simon en G. Foissey gegoten klok (1789). De oorlogsschade aan de kerk heeft men in 1946 hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01110> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwstadt (gemeente Susteren)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Echt-Susteren" ;
        min:gemeenteInBoek "Susteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Echt-Susteren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwstadt (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nieuwstadt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1110 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0112> ;
        schema:name "Nieuwstadt (gemeente Susteren)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "Het interieur wordt gedekt door gemetselde ribgewelven (koor, zijbeuken) en een houten zoldering (middenbeuk). De scheibogen rusten op zware korte zuilen met bladkapitelen. Tot de inventaris behoren twee biechtstoelen (circa 1800), een gepolychromeerd houten beeld van St. Johannes de Doper (circa 1600) en een zogeheten Johannes in Disco, een voorstelling van diens afgehouwen hoofd op een schaal (16de eeuw). De kerk bevat ook een drietal 17de-eeuwse hardstenen grafkruisen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01111> a min:Passage,
