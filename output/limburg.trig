        schema:name "Merselo (gemeente Venray)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "De windmolen ‘Nooit Gedacht’ (Grootdorp 93) is een bergmolen met ronde stenen romp en een met dakleer beklede kap. Deze voor molenaar Lambertus van den Brekel gebouwde korenmolen uit 1867 is rond 1987 voor het laatst gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01027> a min:Passage,
            schema:CreativeWork ;
