        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36839" ;
        min:soort "inleiding" ;
        min:volgnummer 1342 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0144> ;
        schema:name "Sibbe (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "De R.K. St.-Rosa de Limakerk (Sibberkerkstraat 42) is een driebeukige kruiskerk met halfrond gesloten koor en een ongelede toren met ingesnoerde spits. In 1843-'44 werd een kapel opgetrokken, waarschijnlijk naar plannen van Mathias Soiron. Hier tegenaan verrees in 1866 een mergelstenen toren naar ontwerp van J.H.J. Dumoulin. Het koor werd in 1927 vervangen door de huidige oostpartij naar ontwerp van J. Beurskens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01343> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sibbe (gemeente Valkenburg aan de Geul)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
