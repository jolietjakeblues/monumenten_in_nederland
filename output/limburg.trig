        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwstadt (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nieuwstadt" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1108 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0112> ;
        schema:name "Nieuwstadt (gemeente Susteren)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "Kleine stad, voortgekomen uit de oude nederzetting (H)elsene aan de Geleenbeek. Rond het midden van de 13de eeuw werd de nederzetting een Gelderse grensvesting. Nieuwstadt kreeg een omwalling en stadsrechten (1263). Na een verwoesting in 1398 werd de aanvankelijk ruime opzet ingekrompen. Beide structuren zijn nog zichtbaar. Rond 1573 werden de vestingmuren ontmanteld en nam Nieuwstadt nog verder in betekenis af. Pas na de Tweede Wereldoorlog is de oude kern aan de oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01109> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwstadt (gemeente Susteren)"@nl ;
        min:adres "Millenerstraat 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
