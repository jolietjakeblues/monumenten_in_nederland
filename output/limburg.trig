        min:adres "Geuldalweg 16",
            "Molenweg 5-7" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Maastricht" ;
        min:gemeenteInBoek "Meerssen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maastricht_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rothem (gemeente Meerssen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Rothem" ;
        min:lemma "Watermolens" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1288 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill479> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0137> ;
        schema:name "Watermolens"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Watermolens. De voorm. Nieuwe of IJzeren molen (Molenweg 5-7) is een middenslagmolen op de Kleine Geul. De molen wordt in 1381 vermeld als behorend tot het huis Vaeshartelt. Het huidige U-vormige pand is kort na 1789 ontstaan en bevat een 16de-eeuwse gevelsteen. De blokbepleistering dateert van 1906. Rond 1886 werd de oliemolen omgevormd tot een korenmolen. Het ijzeren rad is uit 1920. De voorm. oliemolen (Geuldalweg 16) is een middenslagmolen op het Geulke. De in opzet mogelijk 18de-eeuwse korenmolen werd in 1944 beschadigd en is nu in gebruik als woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01289> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schaesberg (gemeente Landgraaf)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Landgraaf" ;
        min:gemeenteInBoek "Landgraaf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landgraaf_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schaesberg (gemeente Landgraaf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schaesberg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1289 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0138> ;
        schema:name "Schaesberg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Dorp, vroeger ook Scheijdt genoemd, ontstaan in de 17de eeuw en gelegen halverwege de in oorsprong 13de-eeuwse kastelen Schaesberg en Strijthagen. De in 1618 zelfstandig geworden heerlijkheid Schaesberg was van 1661 tot 1713 een Spaanse en daarna tot 1785 een Oostenrijkse enclave in Staats gebied. De bebouwing bleef tot het eind van de 19de eeuw beperkt tot de hoofdstraat, waar net ten noorden van de kerk in 1896 de spoorlijn Sittard-Heerlen-Herzogenrath kwam te lopen. Vanaf 1905 ontstonden hier mijnwerkerskolonies ten behoeve van de Oranje-Nassaumijnen, zoals de Leenhof, Het Eikske, Aan de Slagboom (Schaesberg) en De Kakert. Na de Tweede Wereldoorlog is de bebouwing verder verdicht en uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01290> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schaesberg (gemeente Landgraaf)"@nl ;
        min:adres "Kerkplein 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Landgraaf" ;
        min:gemeenteInBoek "Landgraaf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landgraaf_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schaesberg (gemeente Landgraaf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schaesberg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1290 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0138> ;
        schema:name "Schaesberg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "De R.K.H.H. Petrus- en Pauluskerk (Kerkplein 4) is een kruiskerk met driezijdig gesloten koor, dwarskapellen en een ongelede toren met ingesnoerde naaldspits. De kerk werd gesticht in 1648 door Johan Frederik, heer van Schaesberg. De voltooiing van het eenbeukige schip met de beide dwarskapellen en de toren vond in 1699 plaats onder Frederik Sigismund Theodor, kleinzoon van Johan Frederik. De oude koorsluiting werd in 1914 vervangen door een transept en koor naar ontwerp van J. Stuyt. In 1958 heeft men een zijkapel toegevoegd. Mijnschade is hersteld in 1964-'66."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01291> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schaesberg (gemeente Landgraaf)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Landgraaf" ;
        min:gemeenteInBoek "Landgraaf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landgraaf_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schaesberg (gemeente Landgraaf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schaesberg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1291 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0138> ;
        schema:name "Schaesberg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Het interieur van schip en zijkapellen wordt gedekt door kruisribgewelven met brede platte gordelbogen, voorzien van sluitstenen met het wapen van de heer van Schaesberg. De kerk bevat de nieuw opgehakte grafsteen van Frederik Sigismund Theodor van Schaesberg († 1733). Tot de inventaris behoren onder meer een doopvont (eind 17de eeuw), een preekstoel (circa 1700), een door atelier Cuypers vervaardigd altaar en een door de Gebr. Müller gebouwd orgel (circa 1860)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01292> a min:Passage,
            schema:CreativeWork ;
