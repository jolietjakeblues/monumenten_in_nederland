        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Geertruid (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sint Geertruid" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1358 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0146> ;
        schema:name "Sint Geertruid (gemeente Margraten)"@nl ;
        schema:pageEnd "325" ;
        schema:pageStart "325" ;
        schema:pagination "325" ;
        schema:text "Dorp, gelegen op het plateau van Margraten. Het vanuit Breust (bij Eijsden) ontgonnen gebied werd in 1222 een zelfstandige parochie. Tot 1794 bleef Sint Geertruid een onderdeel van de heerlijkheid Breust en van 1828 tot 1982 vormde het een zelfstandige gemeente. Zowel Sint Geertruid als het zuidwestelijker gelegen Moerslag zijn beschermde gezichten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01359> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Geertruid (gemeente Margraten)"@nl ;
        min:adres "Eindstraat 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Geertruid (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sint Geertruid" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19488> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "34688" ;
        min:soort "inleiding" ;
        min:volgnummer 1359 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0146> ;
        schema:name "Sint Geertruid (gemeente Margraten)"@nl ;
        schema:pageEnd "325" ;
        schema:pageStart "325" ;
        schema:pagination "325" ;
        schema:text "De R.K. St.-Gertrudiskerk (Eindstraat 2) is een driebeukige kerk met driezijdig gesloten koor en een ongelede toren met ingesnoerde spits. Van de 11de-eeuwse basilicale kerk zijn enkele muurresten bewaard gebleven. Rond 1300 werd de mergelstenen toren opgetrokken en rond 1400 kwamen het schip en het gotische koor tot stand. In de 15de-eeuw heeft men de huidige zijbeuken toegevoegd. In de 16de-eeuw verrees aan de zuidoostzijde de scheef gebouwde grafkapel van de heren van Libeek, in 1619 gevolgd door een doopkapel aan de zuidkant van de toren. In 1700 werden de zijbeuken verhoogd tot een hallenkerk en kwam de huidige kap tot stand. De westingang in de toren dateert van 1836. De kerk is gerestaureerd in 1956-'57, onder leiding van J.H.A. Huysmans, en in 1988."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01360> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Geertruid (gemeente Margraten)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Geertruid (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sint Geertruid" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1360 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill499> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0146> ;
        schema:name "Sint Geertruid (gemeente Margraten)"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "325" ;
        schema:pagination "325-326" ;
        schema:text "Het bij de eerstgenoemde restauratie ontpleisterde interieur wordt gedekt door een vlak balkenplafond. In de scheibogen is breuksteenwerk te zien van het 11de-eeuwse kerkje. De grafkapel wordt gedekt door een stucplafond met alliantiewapen uit 1717. Tot de inventaris behoren een gotische Annatrits (15de eeuw), een beeld van St. Johannes de Evangelist (eind 15de eeuw), een drieluik met taferelen uit het leven van St. Johannes de Doper (eind 16de eeuw) en een laat-maniëristische zijaltaar (1644). Van de voorm. communiebank in rococo-vormen (midden 18de eeuw) resteren twee panelen. Het door Pereboom & Leyser gebouwde orgel (1870) bevindt zich in een 18de-eeuwse kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0146.php> .

