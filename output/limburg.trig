        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geleen" ;
        min:lemma "Scholen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 513 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill159> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0045> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Scholen. De voorm. openbare lagere school (Groenseijckerstraat 30) is een langgerekt eenlaagspand met neorenaissance-trapgevels. Het linker deel werd in 1915 als drieklassige school gebouwd en in 1920-'21 uitgebreid met drie lokalen. Van 1928 tot 1972 was het gebouw in gebruik als R.K. jongensschool St. Augustinus. De onderwijzerswoning (Groenseijckerstraat 32) is een blokvormig pand uit 1915. De voorm. R.K. St.-Antoniuskleuterschool (Leurstraat 3), een tweelaags pand uit circa 1925, heeft in een nis boven de ingang een Antoniusbeeld van atelier Ramakers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00514> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geleen (gemeente Sittard-Geleen) – Huis Maes"@nl ;
        min:adres "Leurstraat 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Sittard-Geleen" ;
        min:gemeenteInBoek "Sittard-Geleen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geleen (gemeente Sittard-Geleen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geleen" ;
        min:lemma "Huis Maes" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 514 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0045> ;
        schema:name "Huis Maes"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Huis Maes (Leurstraat 4, Oud-Geleen) is een tweelaags dwars huis met mergelstenen speklagen. Het noordelijke gedeelte stamt in de kern uit de 16de eeuw en werd gebouwd voor de familie Beltgens. Lemmen Maes breidde het in 1623 in zuidelijke richting uit. De oorspronkelijke haakse noordvleugel is rond 1900 voor de familie Ramakers vervangen door het huidige tweelaags huis Leurstraat 6."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00515> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geleen (gemeente Sittard-Geleen) – Huis Corten of Drossaardhuis"@nl ;
        min:adres "Geenstraat 34-36" ;
