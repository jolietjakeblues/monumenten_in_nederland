        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schin op Geul (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schin op Geul" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1308 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0140> ;
        schema:name "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "Dorp, ontstaan in het dal van de Geul en voor het eerst vermeld in 847. Schin op Geul behoorde tot het Land van Valkenburg. Aan de noordzijde werd in 1846-'53 de spoorlijn Maastricht-Aken aangelegd. In 1879 heeft men aan de zuidzijde de gemeente Strucht toegevoegd. Tussen beide kernen ontwikkelde zich na de Tweede Wereldoorlog enige bebouwing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01309> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schin op Geul (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schin op Geul" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1309 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0140> ;
        schema:name "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "De R.K. St.-Mauritiuskerk (Kerkplein 1) is een driebeukige pseudobasilicale kerk voorzien van een hoger, halfrond gesloten koor met dakruiter en een ongelede toren met ingesnoerde naaldspits. Het in oorsprong mogelijk 11de-eeuwse romaanse schip kreeg begin 16de eeuw laat-gotische kruisribgewelven. Toren en noordbeuk stortten in 1762 in, waarna in 1768 de herbouw in mergelsteen volgde van toren en zijbeuken. Het koor uit 1796 werd in 1926 vervangen door het huidige in Kunradersteen uitgevoerde koor naar ontwerp van J. van Groenendael. Tot de inventaris behoren een romaans hardstenen doopvont (12de eeuw), een Madonnabeeld (14de eeuw) en een calvarie met laat-gotische beelden van Maria en Johannes (circa 1500)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01310> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        min:adres "Kerkewegje 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schin op Geul (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schin op Geul" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23186> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36826" ;
        min:soort "inleiding" ;
        min:volgnummer 1310 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0140> ;
        schema:name "Schin op Geul (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "Op het kerkhof bevinden zich enkele grafkruisen (1611-1777). De mogelijk in opzet 18de-eeuwse pastorie (Kerkewegje 2) werd in 1890 verbouwd en in 1972 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01311> a min:Passage,
