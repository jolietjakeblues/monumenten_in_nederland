        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill422> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0115> ;
        schema:name "Nunhem (gemeente Haelen)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 7-11) is een eenlaagspand uit 1930, voorzien van een verhoogd gedeelte met portiek. Het is in 1938 ingrijpend verbouwd naar plannen van M.A. Geelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0115.php> .

