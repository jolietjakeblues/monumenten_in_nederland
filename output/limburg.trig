        min:rijksmonumentnummer "507199" ;
        min:soort "inleiding" ;
        min:volgnummer 1300 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0139> ;
        schema:name "Schimmert (gemeente Nuth)"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "De R.K. St.-Remigiuskerk (Hoofdstraat 86) is een driebeukige basilicale kruiskerk voorzien van een vijfzijdig gesloten koor met zijkapellen, een dakruiter en een brede ongelede zadeldaktoren met naaldspits. De in onregelmatige blokken Nievelsteiner zandsteen opgetrokken kerk kwam in 1924-'26 tot stand naar een traditionalistisch ontwerp van J.Th.J. en P. Cuypers ter vervanging van een voorganger uit 1832. In 1938 werd een sacristie aangebouwd. De oorlogsschade aan de toren heeft men in 1956 hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01301> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schimmert (gemeente Nuth)"@nl ;
        min:adres "Montfortstraat 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Nuth" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schimmert (gemeente Nuth)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Schimmert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42150> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "507200" ;
        min:soort "inleiding" ;
        min:volgnummer 1301 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0139> ;
        schema:name "Schimmert (gemeente Nuth)"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Het interieur wordt gedekt door mergelstenen kruisribgewelven. De kerk bevat een hardstenen doopvont uit 1570. Een deel van de inventaris is uit de oude kerk afkomstig en vervaardigd door de Gebr. Ramakers, zoals het Maria-altaar (eind 19de eeuw) en de tot balustrade van het zangkoor omgevormde communiebank (1870). Uit circa 1926 dateren twee marmeren altaren (St. Jozef en St. Gerardus) en een gepolychromeerd triomfkruis. De gebrandschilderde ramen zijn in 1957 en 1975 geplaatst naar ontwerp van J. Stassen. De pastorie (Montfortstraat 2) is een tweelaags middenganghuis uit 1898."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0139.php> .

