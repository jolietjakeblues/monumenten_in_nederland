        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maastricht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Maastricht" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 894 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0090> ;
        schema:name "Maastricht"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De bij het kerkkoor gelegen zogeheten Commandantswoning werd waarschijnlijk rond 1680 gebouwd als woning van de hospitaalmeester van het garnizoenshospitaal (tot 1798). In de tijd dat het voormalige klooster dienst deed als kazerne, was het een officierswoning. Het in 1767 al ingrijpend verbouwde pand is gerestaureerd rond 1988."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00895> a min:Passage,
