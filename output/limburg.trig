        min:adres "Grachterstraat 60",
            "Grachterstraat 62" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Kerkrade" ;
        min:gemeenteInBoek "Kerkrade" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Kerkrade_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Spekholzerheide (gemeente Kerkrade)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Spekholzerheide" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1432 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0152> ;
        schema:name "Spekholzerheide (gemeente Kerkrade)"@nl ;
        schema:pageEnd "342" ;
        schema:pageStart "342" ;
        schema:pagination "342" ;
        schema:text "De R.K. kerk O.L. Vrouwe van Lourdes (Grachterstraat 60, Gracht) is een driebeukige kerk met hoger, recht gesloten koorpartij en een uitgebouwd ingangsportaal met terzijde geplaatste slanke toren. Deze traditionalistische kerk verrees in 1934-'35 naar ontwerp van J.A. Wiegerinck en is in 1987-'88 gerestaureerd. Tot de inventaris behoren uit Vaals afkomstige kruiswegstaties (1895). De gebrandschilderde ramen zijn van Ch. Eyck. De traditionalistische pastorie (Grachterstraat 62) dateert uit dezelfde tijd als de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0152.php> .

