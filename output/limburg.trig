        schema:name "Herkenbosch (gemeente Roerdalen)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Het voorm. klooster (Europalaan Centrum 35) is een tweelaags L-vormig pand in zakelijk-expressionistische vormen, gebouwd rond 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00674> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Herkenbosch (gemeente Roerdalen) – Kasteel Daelenbroeck"@nl ;
        min:adres "Kasteellaan 1",
            "Kasteellaan 1-2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Herkenbosch (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Herkenbosch" ;
        min:lemma "Kasteel Daelenbroeck" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48493>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60753> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "28548",
            "28549" ;
        min:soort "lemma" ;
        min:volgnummer 674 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill217> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0064> ;
        schema:name "Kasteel Daelenbroeck"@nl ;
        schema:pageEnd "152" ;
        schema:pageStart "151" ;
        schema:pagination "151-152" ;
        schema:text "Kasteel Daelenbroeck (Kasteellaan 1-2) vormde als heerlijkheid een Gelderse enclave binnen Guliks grondgebied. Op een omgracht terrein ligt de kasteelruïne. Dit kort voor 1326 begonnen kasteel met nagenoeg vierkant grondplan had aan de noordzijde twee vierkante torens en aan de zuidwestzijde een rond 1464 toegevoegde ronde toren. Het muurwerk aan de binnenpleinzijde kreeg zijn vorm bij een grootscheepse verbouwing in 1550. Het in verval geraakte kasteel werd begin 18de eeuw in fases afgebroken. De voorburcht, bestaande uit drie vleugels met een poortpaviljoen rond een binnenplein, werd in 1707 als woonverblijf gebouwd in opdracht van Jan Ernest van Rollingen. Het hogere poortpaviljoen heeft een met natuursteen omlijste poortdoorgang. Op een van de sluitstenen van de woonvleugel staat het jaartal ‘1707’. Aan de binnenplaatszijde bevinden zich binnen een dichtgezette galerij vijf hergebruikte 16de-eeuwse renaissance-kolommen. Het in 1970-'79 en 1991-'92 gerestaureerde complex is nu in gebruik als hotelrestaurant. De bijbehorende kasteelboerderij Hoeve Daelenbroek (Kasteellaan 1) bestaat uit een haakvormig bouwdeel uit 1701 en een op de plaats van een 18de-eeuwse open wagenschuur gebouwde nieuwe vleugel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Herkenbosch (gemeente Roerdalen) – Boerderijen"@nl ;
        min:adres "Steegstraat 82" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Herkenbosch (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Herkenbosch" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24459> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "524082" ;
        min:soort "lemma" ;
        min:volgnummer 675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0064> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "152" ;
        schema:pageStart "152" ;
        schema:pagination "152" ;
        schema:text "Boerderijen. De 18de-eeuwse gesloten hoeve Hammerstraat 21 heeft een op puntgevels aansluitend, omlopend schilddak. De eindgevels zijn uitgevoerd in vakwerk met leem- of baksteenvulling. Het in 1985 gerestaureerde complex is van circa 1750 tot 1978 als boerderij in bedrijf geweest. De Beatrixhof (Steegstraat 82), gebouwd in 1899 in opdracht van baron De Pelichy, is een gesloten hoeve met in de middenvleugel een risalerende poortdoorgang met dakruiter. Bijzonder in het interieur van het bedrijfsgedeelte zijn de houten hoekspanten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00676> a min:Passage,
