        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0017> ;
        schema:name "Beesel"@nl ;
        schema:pageEnd "77" ;
        schema:pageStart "77" ;
        schema:pagination "77" ;
        schema:text "De R.K. St.-Gertrudiskerk (Kerkplein 2) is een driebeukige kerk met driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde spits. De kerk werd in 1925-'26 gebouwd naar plannen van C.J.H. Franssen ter vervanging van een uit 1840-'42 daterende voorganger. De in 1944 beschadigde kerk werd in 1947 hersteld; herbouw van de toren volgde in 1954. Het H. Hartbeeld (circa 1950) is in terracotta uitgevoerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00297> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beesel"@nl ;
