        min:soort "inleiding" ;
        min:volgnummer 1655 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Vijlen (gemeente Vaals)"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "396" ;
        schema:pagination "396-397" ;
        schema:text "Het interieur wordt gedekt door gestukadoorde houten kruisribgewelven. Tot de inventaris behoren een biechtstoel (1843), altaren en een preekstoel (1868), een triomfkruis (1926) en kruiswegstaties, en een drieluik vervaardigd door Ch. Eyck (circa 1975)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01656> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals)"@nl ;
        min:adres "Vijlenstraat 57" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Vaals" ;
        min:gemeenteInBoek "Vaals" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vaals_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62103> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36709" ;
        min:soort "inleiding" ;
        min:volgnummer 1656 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Vijlen (gemeente Vaals)"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Het voorm. panhuis (Vijlenstraat 57), waar de schepenbank van Vijlen haar zittingen hield, werd gebouwd in de 17de eeuw. De bijbehorende vakwerkschuur dateert uit de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01657> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Vaals" ;
        min:gemeenteInBoek "Vaals" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vaals_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1657 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Woonhuizen. Het 17de-eeuwse huis Groenenweg 20 heeft boven een gedeeltelijk in mergelsteen uitgevoerde onderbouw twee verdiepingen in vakwerk. Groenenweg 18 is een tot woonhuis verbouwde dwarsdeelschuur met verdieping. Op de bovendorpel van de oude deeldeuren staat het jaartal ‘1727’. Andere 18de-eeuwse voorbeelden van vakwerkpanden zijn Vijlenstraat 49 en Vijlenstraat 18 (1730, gerestaureerd 1985). De voorm. kapelanie Vijlenberg 123 is een vakwerkpand met een jongere, bakstenen voorgevel (1839). Het dubbele vakwerkpand Groenenweg 12-16 is gedateerd ‘1744’. De topgevel is in baksteen vernieuwd. Ook Vijlenberg 131, samengesteld uit drie bouwdelen, heeft in de 19de en 20ste eeuw aangebrachte bakstenen topgevels. Vijlenstraat 53, is een bakstenen herenhuis uit 1834 (jaartalankers). De vensters op de begane grond hebben een hardstenen omlijsting. Vijlenberg 6 is een eclectisch gedetailleerd, deels gepleisterd herenhuis met balkon, gebouwd in 1904."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01658> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals) – Boerderijen"@nl ;
        min:adres "Vijlenstraat 51" ;
