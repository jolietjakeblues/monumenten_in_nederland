        min:lemma "Bosschenhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1357 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0145> ;
        schema:name "Bosschenhuizen"@nl ;
        schema:pageEnd "325" ;
        schema:pageStart "325" ;
        schema:pagination "325" ;
        schema:text "Bosschenhuizen. Gehucht ten westen van Simpelveld met enkele interessante boerderijen. In 1759 gebouwd is de gesloten hoeve Bosschenhuizen 20, die is opgetrokken in vakwerk, baksteen en Kunradersteen. De sluitsteen van de poort meldt het jaartal ‘1780’. De gesloten hoeve Bosschenhuizen 21 is voorzien van de jaartalankers ‘1773’ en ‘1774’. De H. Hartkapel (Bosschenhuizen ong.) is een grote in Kunradersteen opgetrokken wegkapel uit 1958 naar plannen van A.F. Brenninkmeyer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01358> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Geertruid (gemeente Margraten)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
