        min:kern "Sittard" ;
        min:lemma "Horeca" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15111>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44497> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "521637",
            "521649" ;
        min:soort "lemma" ;
        min:volgnummer 1408 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0149> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "337" ;
        schema:pageStart "337" ;
        schema:pagination "337" ;
        schema:text """Horeca. Het voorm. hotel De Hollande (Markt 36) [24] is een drielaags hoekpand uit 1889 in neorenaissance-stijl met een gepleisterde begane grond. Het glas-in-loodwerk van de bovenlichten is uit circa 1925. Expressionistische invloeden zijn herkenbaar bij het voorm. hotel-restaurant Engelenkampstraat 23 (1920) [25] en het langgerekte hotel-restaurant De Prins (Rijksweg Zuid 25; circa 1925) [26].

De bioscoop ‘Forum’ (Engelenkampstraat 68) [27] werd in 1929 gebouwd in opdracht van H. Martens naar een ontwerp met zakelijk-expressionistische invloeden van J. Wielders. De gesloten gevelwand met verticale accenten is later wit geschilderd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01409> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sittard (gemeente Sittard-Geleen) – Watermolens"@nl ;
        min:adres "Molenweg 56",
            "Oudeweg 235",
            "Paardestraat 40" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Sittard-Geleen" ;
        min:gemeenteInBoek "Sittard-Geleen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sittard (gemeente Sittard-Geleen)" ;
