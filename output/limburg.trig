        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text "De voorm. openbare lagere school (Vliegenstraat 51) werd in 1886 gebouwd als een tweeklassige school met onderwijzerswoning en uitgevoerd met neorenaissance-elementen. In 1929 werd het een R.K. jongensschool."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00406> a min:Passage,
            schema:CreativeWork ;
