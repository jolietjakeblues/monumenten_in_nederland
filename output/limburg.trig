        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Geertruid (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sint Geertruid" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1363 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0146> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "Woonhuizen. Het forse met trapgevels en in mergelsteen uitgevoerde Stenen Huis (bij Burg. Wolfsstraat 34-38) stamt uit de 16de eeuw, maar bevat ook restanten van 15de-eeuws muurwerk. Dit in de 16de en 17de eeuw als de ‘Poorthof’ aangeduide bouwwerk raakte in de 18de eeuw ingebouwd en werd begin 19de eeuw in tweeën gesplitst. Inwendig bevindt zich een laat-gotische schouw. Het L-vormige vakwerkhuis Libeek 24 dateert uit de 18de eeuw. Vroeg-19de-eeuws is het woonhuis Dorpstraat 2 met tegen de gevel een wegkruis. De uit 1932 daterende onderwijzerswoning Dorpstraat 16 heeft van circa 1960 tot 1982 als raadhuis gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01364> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Geertruid (gemeente Margraten) – Herkenrade"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Geertruid (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Sint Geertruid" ;
        min:lemma "Herkenrade" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1364 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0146> ;
        schema:name "Herkenrade"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "Herkenrade. Dit gehucht ten oosten van Sint Geertruid werd in de vroege middeleeuwen ontgonnen vanuit Eijsden en werd vroeger ook Eijsden op den Berg genoemd. De gesloten hoeve Heerkuil 1 heeft een woonvleugel met de jaartalankers ‘1750’ en een poortsluitsteen gedateerd ‘1859’. Het (agrarische) woonhuis Herkenrade 10 is een rijzig tweelaags vakwerkhuis met een mogelijk 18de-eeuwse oorsprong."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0146.php> .

