        min:hoofdstuk "Steden, dorpen, monumenten › Neerbeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Neerbeek" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1086 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0109> ;
        schema:name "Neerbeek (gemeente Beek)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Dorp, ontstaan in de middeleeuwen aan de Keutelbeek en voor het eerst vermeld in 1225. De oudste bebouwing ligt langs de Keulsteeg, de Neerbekerstraat, in de bocht van de Spaubekerstraat en langs een deel van de Fattenbergstraat. Na de aanleg van de Staatsmijn Maurits te Geleen (1925) en de oprichting van een parochiekerk (1931) groeide het dorp. Neerbeek is na de Tweede Wereldoorlog een forenzendorp geworden en heeft zich verder uitgebreid in noordwestelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01087> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Neerbeek (gemeente Beek)"@nl ;
        min:adres "Aldenhofstraat 47" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beek" ;
        min:gemeenteInBoek "Beek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Neerbeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Neerbeek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44773> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "513193" ;
        min:soort "inleiding" ;
        min:volgnummer 1087 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0109> ;
        schema:name "Neerbeek (gemeente Beek)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De R.K. St.-Callistuskerk (bij Aldenhofstraat 47) is een eenbeukige, recht gesloten kerk met een lagere dwarsbeuk aan de zuidzijde en een ongelede toren met spits. De kerk verrees in 1932-'33 naar een traditionalistisch ontwerp van A.J. Kropholler. De geplande noordelijke dwarsbeuk is nooit gebouwd. Het interieur wordt gedekt door een ziende houten kap. De schildering met tronende Christus in de koorsluiting (1934) is aangebracht door R. Smeets naar ontwerp van J. Adams. Uit de bouwtijd zijn verder de gebrandschilderde ramen van J. Scheffers en een marmeren St.-Callistusbeeld, een doopvont en een granieten Callistusreliëf (timpaan ingang), alle vervaardigd door Dom. Van der Mey."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01088> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Neerbeek (gemeente Beek)"@nl ;
        min:adres "Aldenhofstraat 47" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beek" ;
        min:gemeenteInBoek "Beek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Neerbeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Neerbeek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44773> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "513193" ;
        min:soort "inleiding" ;
        min:volgnummer 1088 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0109> ;
        schema:name "Neerbeek (gemeente Beek)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De van 1933 daterende pastorie (Aldenhofstraat 47) is ontworpen door Kropholler. Het H. Hartbeeld is in 1946 vervaardigd door J. Weerts als oorlogsmonument."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01089> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Neerbeek (gemeente Beek) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beek" ;
        min:gemeenteInBoek "Beek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Neerbeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Neerbeek" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1089 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0109> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Woonhuizen. Het wit geschilderde eenlaags vakwerkpand Neerbeekerstraat 13 heeft mogelijk een 18de-eeuwse kern. Uit de jaren twintig van de 20ste eeuw zijn de tweelaags huizen Spaubeekerstraat 35-41 (1923) naar plannen van H.A.L. Erkens en de door P. Daelmans ontworpen dubbele woning Neerbeekerstraat 29-31 (1928) met poortdoorgang. De huizen uit de jaren dertig vertonen invloeden van het zakelijk-expressionisme, zoals te zien is bij Aldenhofstraat 90-92 (1933; ontwerp H. Janssen), Laurentiusstraat 40 (1933; J. Philips) en de vrijstaande villa Aldenhofstraat 79 (1934; J. Zander). De rij (dubbele) huizen Aldenhofstraat 19-27 (1939) is ontworpen door A. Lemmens. Aldenhofstraat 102 (1949) is een tweelaags vrijstaand huis in traditionalistische vormen naar plannen van J.G.M. Haeren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01090> a min:Passage,
