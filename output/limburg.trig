        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22467> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "507259" ;
        min:soort "lemma" ;
        min:volgnummer 1592 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill580> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0170> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "378" ;
        schema:pageStart "377" ;
        schema:pagination "377-378" ;
        schema:text "Overige kerken. In 1930 in mergelsteen opgetrokken is de door A.J.N. Boosten ontworpen R.K. St.-Josephkerk (Koningswinkelstraat 1), een kruiskerk met rond gesloten koor en een terzijde staande toren met sterk ingesnoerde naaldspits. Het interieur bevat schilderingen van E. Laudy en glas-in-loodvensters van H. Jonas, Ch. Eyck en H. Schoonbrood. Naar plannen van Th. Boosten verrees in 1960-'61 de R.K. kerk O.L. Vrouwe van Altijddurende Bijstand (St.-Pieterstraat 1a) [5], een moderne zaalkerk met hellend dak en een vrijstaande stalen klokkentoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01593> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenburg (gemeente Valkenburg aan de Geul) – Stadsmuur"@nl ;
        min:adres "Berkelstraat 2",
            "Grendelplein 2",
            "Kerkstraat 19",
            "Kerkstraat 31",
            "Theo Dorrenplein 5" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenburg (gemeente Valkenburg aan de Geul)" ;
