        schema:pageEnd "394" ;
        schema:pageStart "394" ;
        schema:pagination "394" ;
        schema:text "Het klooster St. Oda (Merseloseweg 121) werd rond 1950 gebouwd in verzorgde wederopbouwstijl voor de ursulinen van de Romeinse Unie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0174.php> .

