        min:gemeenteInBoek "Horst aan de Maas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Horst_aan_de_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horst (gemeente Horst aan de Maas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Horst" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 717 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0071> ;
        schema:name "Horst (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "De R.K. St.-Norbertuskerk (Gebr. Van Doornelaan 25) is een opvallende, moderne, lage en brede kerk met terzijde staande klokkentoren, gebouwd in 1962-'63 naar plannen van H.M. Koldewey. De gebrandschilderde ramen zijn van J. Frenken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00718> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horst (gemeente Horst aan de Maas)"@nl ;
        min:adres "St.-Lambertusplein 3a",
            "Veemarkt 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Horst aan de Maas" ;
        min:gemeenteInBoek "Horst aan de Maas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Horst_aan_de_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horst (gemeente Horst aan de Maas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Horst" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 718 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0071> ;
        schema:name "Horst (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "Het voorm. raadhuis (St.-Lambertusplein 3a), met op de hoek een ingangspartij met balkon en bordes, werd in 1890 gebouwd in rijke neorenaissance-stijl naar ontwerp van J. Jorna. Het postkantoor (Veemarkt 3), gebouwd in 1902 als post- en telegraafkantoor, is een fors pand met neorenaissance-details. Het ontwerp van H. Seelen is geheel in de traditie van de door C.H. Peters ontworpen rijkspostkantoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00719> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horst (gemeente Horst aan de Maas) – Woonhuizen"@nl ;
        min:adres "Gasthuisstraat 14",
            "Herstraat 53",
            "Herstraat 61",
            "Jacob Merlostraat 6",
            "Venloseweg 21",
            "Venloseweg 9" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Horst aan de Maas" ;
        min:gemeenteInBoek "Horst aan de Maas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Horst_aan_de_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horst (gemeente Horst aan de Maas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Horst" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30709>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46874> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "523263",
            "523264" ;
        min:soort "lemma" ;
        min:volgnummer 719 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill236>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill237> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0071> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "163" ;
        schema:pagination "163-164" ;
        schema:text """Woonhuizen. De gezwenkte achtergevel van het woon- en winkelpand Loevestraat 2 kan van kort na de dorpsbrand van 1729 dateren; de gepleisterde voorgevel heeft eclectische details. Eenvoudig neoclassicistisch van vorm is het rond 1840 gebouwde herenhuis Thomeerstraat 1 met gepleisterde hoekblokken. Soberder uitgevoerd is de dorpsherberg Het Groene Woud (Jacob Merlostraat 6) uit 1859, die inwendig enkele 17de-eeuwse fragmenten bevat. De rond 1860 gebouwde eclectische dokterswoning Venloseweg 1-3 is een statig gepleisterd pand met middenrisaliet en rondboogvensters. Vroege neogotische details in de vorm van versimpelde arkeltorentjes heeft het rond 1870 voor de familie Thomeer gebouwde herenhuis Hoofdstraat 19. Het ontwerp wordt aan P.J.H. Cuypers toegeschreven. Het herenhuis Veemarkt 7, gebouwd in 1875 naar plannen van M. Keijsers, heeft wenkbrauwen boven de vensters.

Voorbeelden van eenlaags middenganghuizen met een verhoogd middenrisaliet voorzien van een topgevel met neorenaissance-details zijn: Herstraat 13 (circa 1895), Kerkstraat 34 (1905), naar plannen van A. Haegens, en de door J.M. Keijsers ontworpen huizen Loevestraat 28 (1904) en Hoofdstraat 27 (1908). Iets rijker uitgevoerd zijn de hoekpanden Meterikseweg 78 (1909) en Kloosterstraat 18 (1909), de laatste naar plannen van J.C. Duijf). Het in 1909 gebouwde huis Venloseweg 14-16 heeft een chalet-sierspant. Textielfabrikant T. Rutten liet in 1913 het forse herenhuis Villa Anna (Gasthuisstraat 14) bouwen naar een ontwerp met jugendstil-elementen van H. Seelen. Zakelijk-expressionistische vormen vertoont de in 1921 naar plannen van J. van Dullaart voor textielfabrikant J. Rutten gebouwde gepleisterde villa Weisterbeek (Herstraat 53). In dezelfde stijl uitgevoerd, maar met een rieten kap, zijn de villa's De Riethorst (Venloseweg 21; 1926), naar plannen van H.P.J. Duijf, en De Roskam (Herstraat 61; 1931), ontworpen door C.G. Geenen voor bierbrouwer J. Vullinghs. De villa Sonneheerdt (Venloseweg 9; circa 1950) is een goed voorbeeld van een naoorlogse villa in traditionalistische stijl."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00720> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horst (gemeente Horst aan de Maas) – Boerderijen"@nl ;
        min:adres "Americaanseweg 8",
            "Gastendonkstraat 36",
            "Schoolstraat 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Horst aan de Maas" ;
        min:gemeenteInBoek "Horst aan de Maas" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Horst_aan_de_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horst (gemeente Horst aan de Maas)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Horst" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46432>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47781> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22644",
            "523261" ;
        min:soort "lemma" ;
        min:volgnummer 720 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0071> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text """Boerderijen. De 18de-eeuwse hallenhuisboerderij De Risselt (Gastendonkstraat 36) is gebouwd ter plaatse van een laat-middeleeuwse hofstede. In deze boerderij met dwars uitgebouwd woongedeelte (krukhuis) zijn oudere onderdelen verwerkt; het bedrijfsgedeelte heeft ankerbalkgebinten. Uit het midden van de 19de eeuw stamt de hallenhuisboerderij Gortmolenweg 19 met gepleisterd woongedeelte.

De voorm. brouwerij (Schoolstraat 1) is een gepleisterd pand uit circa 1850, waarvan de eclectische details boven de vensters dateren van rond 1900.

De voorm. Zuid-Ned. Kantfabriek (Americaanseweg 8), gesticht in 1928, verhuisde in 1930 naar de huidige plaats. Daar werd toen vóór een voorm. sigarenfabriek een nieuwe fabrieksruimte met woonhuis annex kantoor opgetrokken in rationalistische vormen naar plannen van H.P.J. Duijf."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00721> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horst (gemeente Horst aan de Maas) – Wegkapellen"@nl ;
        min:adres "Gastendonkstraat 38",
            "Herstraat 25b",
            "Kloosterstraat 7" ;
