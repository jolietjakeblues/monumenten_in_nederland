        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "Woonhuizen. Rond 1910 gebouwd zijn het met neorenaissance-details uitgevoerde woonhuis annex café Raadhuisplein 2 en het woon- en winkelpand Raadhuisplein 4-5, waarvan het materiaalgebruik verwijst naar de jugendstil."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01181> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ottersum (gemeente Gennep) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
