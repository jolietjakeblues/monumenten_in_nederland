        schema:name "Geleen (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "Het zusterklooster MSC (Molenstraat 44) is een L-vormig pand met middenrisaliet en aan de achterzijde een haaks geplaatst schoolgedeelte, gebouwd rond 1930 in traditionalistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00507> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geleen (gemeente Sittard-Geleen)"@nl ;
        min:adres "Prins de Lignestraat 31" ;
        min:deel "Monumenten in Nederland. Limburg" ;
