        min:hoofdstuk "Steden, dorpen, monumenten › Nuth" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nuth" ;
        min:lemma "Grijzegrubben" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1144 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0116> ;
        schema:name "Grijzegrubben"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Grijzegrubben. Wegdorp ten westen van Nuth. Aardige gesloten hoeven zijn Berger Verbindingsweg 26 (circa 1860), Berger Verbindingsweg 6-8 (eind 19de eeuw) en Grijzegrubben 94-95 (1893). Bij de laatste boerderij staat midden op de weg de recht gesloten Mariakapel uit 1945. Het dubbele woonhuis Grijzegrubben 4-6 werd in 1933 gebouwd naar een ontwerp met zakelijk-expressionistische vormen van J. Zander."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01145> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Obbicht (gemeente Sittard-Geleen)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
