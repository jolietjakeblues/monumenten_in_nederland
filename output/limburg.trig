        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0033> ;
        schema:name "Bunde (gemeente Meerssen)"@nl ;
        schema:pageEnd "96" ;
        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text "Het voorm. raadhuis (Burchtstraat 18-20) kwam in 1860 tot stand in neoclassicistische vormen als openbare lagere school met onderwijzerswoning en raadkamer. Van 1886 tot 1979 was het hele gebouw in gebruik als raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0033.php> .

