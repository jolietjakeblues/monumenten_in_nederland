        min:volgnummer 466 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0039> ;
        schema:name "Wegkapellen"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Wegkapellen. De driezijdig gesloten Mariakapel (bij Everstraat 68) werd in 1894 met neogotische details gebouwd. Van 1937 dateert de recht gesloten St.-Theresiakapel (bij Heistraat 82) met hoog zadeldak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00467> a min:Passage,
            schema:CreativeWork ;
