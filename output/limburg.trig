        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Dorp, ontstaan in de 18de eeuw op de plaats waar de weg van Maastricht naar Meerssen de Geul kruist."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01285> a min:Passage,
