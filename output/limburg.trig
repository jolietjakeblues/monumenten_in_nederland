        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 935 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill331> ;
