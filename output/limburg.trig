        schema:name "Treebeek (gemeente Brunssum)"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Het klooster (Zonnestraat 3) dateert van 1925 en is uitgevoerd in expressionistische vormen naar plannen van W. Damen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01527> a min:Passage,
            schema:CreativeWork ;
