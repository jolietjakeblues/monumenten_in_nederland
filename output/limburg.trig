        min:gemeenteInBoek "Sittard-Geleen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geleen (gemeente Sittard-Geleen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geleen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72842> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "517850" ;
        min:soort "inleiding" ;
        min:volgnummer 507 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0045> ;
        schema:name "Geleen (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De R.K. St.-Augustinuskerk (bij Prins de Lignestraat 31) is een driebeukige kruisbasiliek voorzien van een recht gesloten koor met crypte en zijkoren, en een dubbeltorenfront met ongelede zadeldaktorens. De zijbeuken hebben een reeks zadeldaken met topgevels. De kerk werd in 1933-'34 gebouwd in traditionalistische vormen naar ontwerp van J.Th.J. & P. Cuypers ter vervanging van een voorganger aan de Groenseykerstraat uit 1863. Het interieur wordt gedekt door houten spitsbooggewelven. Het door F.B. Loret Vermeersch gebouwde orgel (1863), met een neogotisch front van de firma Maarschalkerweerd & Zn. (1904), staat sinds 1967 in Geleen. De kruiswegstaties zijn vervaardigd door A. en P. Windhausen (1922), de glas-in-loodramen (1935) door glazenier J. Postmes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

