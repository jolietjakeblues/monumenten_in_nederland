        min:kern "Sittard" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1388 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0149> ;
        schema:name "Sittard (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "De toren heeft vier geledingen, een omloop met hoekspitsen en een achtzijdige lantaarn met spits. De in baksteen met mergelstenen banden opgetrokken toren zal kort na 1500 gereed zijn gekomen. In 1686-'87 werd de torenspits naar ontwerp van Adam Wynants vernieuwd. Er volgden herstellingen in 1828, onder leiding van N. Dukers, en in 1834 (bovenste gedeelte). Nadat de torenspits in 1857 door brand was verwoest, kreeg de toren bij de restauratie in 1859-'61, onder leiding van P.J.H. Cuypers, de neogotische achtzijdige klokkenverdieping met omgang en hoektorentjes en de neogotische westingang. De torenspits werd in 1874-'75 toegevoegd. In de in 1956-'57 en in 1985 gerestaureerde toren hangen zes luidklokken uit 1949 en een carillon uit 1988 van de firma Eijsbouts."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01389> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sittard (gemeente Sittard-Geleen)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
