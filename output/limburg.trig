        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noorbeek (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Noorbeek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15539> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "34795" ;
        min:soort "inleiding" ;
        min:volgnummer 1122 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0114> ;
        schema:name "Noorbeek (gemeente Margraten)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "De St.-Brigidakapel (Pley 9), gesticht in 1772 voor de beschermheilige tegen de veepest, is een vierkante kapel met afgeronde hoeken en een mansardetentdak. Het gestukadoorde interieur is voorzien van corinthische pilasters en Lodewijk XV-decoraties. De in 1963 gerestaureerde kapel bevat een St.-Brigidabeeld van S. Eymael (1978). Voor de kapel staat de jaarlijks nieuw door de Jonkheid op te richten Brigida-den."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01123> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noorbeek (gemeente Margraten)"@nl ;
        min:adres "Dorpsstraat 15",
            "Dorpsstraat 4",
            "Paviljoenstraat 1",
            "Pley 5" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
