        min:adres "Landsraderweg 40" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Gulpen-Wittem" ;
        min:gemeenteInBoek "Gulpen-Wittem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gulpen-Wittem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Slenaken (gemeente Gulpen-Wittem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Slenaken" ;
        min:lemma "Heijenrath" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1420 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0150> ;
        schema:name "Heijenrath"@nl ;
        schema:pageEnd "340" ;
        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "Heijenrath. Gehucht op het plateau van Eperheide ten noordoosten van Slenaken. De boerderij Heijenratherweg 17 is een langgerekte vakwerkhoeve met haakse vleugel, deels 18de- en deels 19de-eeuws. Inwendig bevinden zich twee kelders met mergelstenen tongewelven, verbonden door een overwelfd gangetje. Aan de kruising Grote Bosweg/Heijenratherweg staat de oorspronkelijk in 1715 door Jan de Ney gestichte Mariakapel, in de huidige vorm een driezijdig gesloten wegkapel van breuksteen met mergelstenen daklijst uit 1875. De gietijzeren wegwijzer (tegenover Landsraderweg 40) dateert uit het eerste kwart van de 20ste eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01421> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Spaubeek (gemeente Beek)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beek" ;
        min:gemeenteInBoek "Beek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Spaubeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Spaubeek" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1421 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0151> ;
        schema:name "Spaubeek (gemeente Beek)"@nl ;
        schema:pageEnd "340" ;
        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "Dorp, ontstaan in de middeleeuwen aan de noordzijde van de Geleenbeek. Daar bouwde men ook de eerste kerk (Oude Kerk). Aan de zuidzijde van de Geleenbeek, tegen de flanken van het plateau van Schimmert, vormden zich drie min of meer evenwijdige bebouwingslinten: Hoeve, Hobbelrade (eerste vermelding in 1264) en langs de Kupstraat. Door de aanleg van de spoorlijn Sittard-Heerlen in 1896 werd Oude Kerk gescheiden van de andere bebouwing. Na de Tweede Wereldoorlog is Spaubeek uitgebreid ten noorden van de Looiwinkelstraat. De aanleg van de rijksweg A 76 versterkte de al eerder ontstane scheiding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01422> a min:Passage,
            schema:CreativeWork ;
