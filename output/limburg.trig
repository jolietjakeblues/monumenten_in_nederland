        min:soort "inleiding" ;
        min:volgnummer 461 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0039> ;
        schema:name "Einighausen (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "Dorp, ontstaan in de middeleeuwen. Nabij de kruising van de Brandstraat-Heistraat met de Everstraat-Kappelerweg lag de dries. In de 19de eeuw ontstond lintbebouwing langs de Heistraat en Everstraat. Na de Tweede Wereldoorlog is het dorp aan de zuidoostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00462> a min:Passage,
