        rdfs:label "Geleen (gemeente Sittard-Geleen)"@nl ;
        min:adres "Groenseijckerstraat 21-23",
            "Groenseijckerstraat 25-27" ;
        min:deel "Monumenten in Nederland. Limburg" ;
