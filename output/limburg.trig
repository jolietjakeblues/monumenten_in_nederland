        min:hoofdstuk "Steden, dorpen, monumenten › Bemelen (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bemelen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 310 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0019> ;
        schema:name "Bemelen (gemeente Margraten)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Dorp, ontstaan tegen de oostflank van het Maasdal waar de in oorsprong Romeinse weg van Maastricht naar Aken de Bemelerberg opgaat. Het in 1018 voor het eerst vermelde dorp bleef tot 1794 een heerlijkheid van het O.L.-Vrouwekapittel te Maastricht. In 1982 werd het bij de gemeente Margraten gevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00311> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bemelen (gemeente Margraten)"@nl ;
        min:adres "St.-Laurentiusstraat 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bemelen (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bemelen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 311 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0019> ;
        schema:name "Bemelen (gemeente Margraten)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "De R.K. St.-Laurentiuskerk (St.-Laurentiusstraat 1) is een eenbeukige kerk met rond gesloten koor, aangebouwde sacristie en een ongelede toren met ingesnoerde spits. Van de mergelstenen toren gaan delen van de oostmuur terug tot de 12de eeuw, de rest dateert uit circa 1350. De huidige spits heeft men rond 1760 geplaatst. De vroegere kerk werd in 1845 vervangen door een neoclassicistische kerk naar een ontwerp van de in dat jaar overleden Mathias Soiron. De kerk is in 1976 gerestaureerd. Het interieur wordt gedekt door een gestukadoord tongewelf, de wanden worden geleed door ionische pilasters. Tot de inventaris behoren een schilderij van St. Pieter (1737) door J.B. Coclers, een vroeg-19de-eeuwse biechtstoel in Lodewijk XVI-stijl naar ontwerp van Mathias Soiron en een hoofdaltaar in neobarokke vormen (1855), geschonken door mevr. Neys-De Bouman de Ryckholt. Het door Pereboom & Leyser gebouwde orgel (1881) heeft een orgelkast uit circa 1845."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00312> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bemelen (gemeente Margraten)"@nl ;
        min:adres "St.-Laurentiusstraat 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Margraten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bemelen (gemeente Margraten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Bemelen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 312 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill94> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0019> ;
        schema:name "Bemelen (gemeente Margraten)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Op het kerkhof staat de grafsteen van Mathias Soiron († 1845). Het midden-19de-eeuwse missiekruis werd geschonken door de familie Neys. De grafkelder (1887) van deze familie ligt voor de toren, evenals die voor J. Xhonneux († 1899). De vroeg-19de-eeuwse pastorie (St.-Laurentiusstraat 3) werd in 1880 herbouwd. Op de kruising voor de kerk staat een zwingelput met draairad en houten puthuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00313> a min:Passage,
