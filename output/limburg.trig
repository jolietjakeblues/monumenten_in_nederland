        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1691 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0179> ;
        schema:name "Wanssum (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "403" ;
        schema:pageStart "403" ;
        schema:pagination "403" ;
        schema:text "Het voorm. raadhuis (Venrayseweg 2), een dwars eenlaagspand met dakruiter, bordes en verhoogd middenrisaliet, werd in 1940 gebouwd naar ontwerp van A.J. Kropholler, in 1944 opgeblazen en in 1954 herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01692> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wanssum (gemeente Meerlo-Wanssum)"@nl ;
        min:adres "Oude Kerkstraat 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
