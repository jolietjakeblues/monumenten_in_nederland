        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22866",
            "22868" ;
        min:soort "inleiding" ;
        min:volgnummer 469 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill144>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill145> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0040> ;
        schema:name "Ell (gemeente Hunsel)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "De voorm. pastorie (Niesstraat 1) is een dwars huis uit circa 1840. Op het nabijgelegen kerkhof staat een hardstenen kruisigingsbeeld (1916), vervaardigd door J. Thissen & Zonen. Het H. Hartbeeld (bij Niesstraat 3) werd in 1933 vervaardigd door F.A.J. Thissen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0040.php> .

