        schema:name "Geleen (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "De R.K. kerk Verrijzenis van Onze Heer Jesus Christus (Potterstraat ong.) is een moderne, recht gesloten, driebeukige kerk met kleine open dakruiter, gebouwd in 1960 als noodkerk naar ontwerp van M.G.E. Hoen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00512> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geleen (gemeente Sittard-Geleen)"@nl ;
        min:adres "Markt 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Sittard-Geleen" ;
        min:gemeenteInBoek "Sittard-Geleen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geleen (gemeente Sittard-Geleen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geleen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 512 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0045> ;
        schema:name "Geleen (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Het raadhuis (Markt 1) is een blokvormig drielaags gebouw uit 1922 voorzien van een dakruiter en een breed middenrisaliet met overdekt bordes. J.Th.J. en P. Cuypers maakten het ontwerp in Nieuw-Historiserende stijl. Het carillon is van de Engelse firma Gillett en Johnston (1929). De langgerekte achteraanbouw uit 1977-'79 is ontworpen door J.J.G. Zöllner. Voor het raadhuis staat het door P. Roovers in de vorm van een fontein ontworpen Wilhelminamonument (1958). Uit een rond bassin rijst een zuil op met daarop een bronzen beeld van koningin Wilhelmina geflankeerd door een mijnwerker en een landbouwer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00513> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geleen (gemeente Sittard-Geleen) – Scholen"@nl ;
        min:adres "Groenseijckerstraat 30",
            "Groenseijckerstraat 32",
            "Leurstraat 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Sittard-Geleen" ;
        min:gemeenteInBoek "Sittard-Geleen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sittard-Geleen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
