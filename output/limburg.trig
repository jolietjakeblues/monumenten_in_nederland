        min:soort "inleiding" ;
        min:volgnummer 1176 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0123> ;
        schema:name "Ottersum (gemeente Gennep)"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "Dorp aan de Niers, ontstaan in de vroege middeleeuwen. De parochie wordt voor het eerst in 1413 vermeld. Ottersum was onderdeel van de heerlijkheid Gennep, later van het Land van Kleef en werd in 1815 bij Nederland gevoegd. Op de R.K. begraafplaats lag de laat-middeleeuwse dorpskerk, die in 1932 werd afgebroken. Tot 1973 was Ottersum een zelfstandige gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0123.php> .

