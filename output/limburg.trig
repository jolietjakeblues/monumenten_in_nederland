        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 378 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Brunssum"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De Lourdesgrot uit 1887, met Mariabeeld en een ingemetseld stukje rots uit Lourdes, werd aangelegd voor de Liefdezusters van het Kostbaar Bloed en groeide uit tot een belangrijke pelgrimsplaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00379> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Brunssum"@nl ;
        min:adres "Prins Hendriklaan 380" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
        min:gemeenteInBoek "Brunssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59141> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "518603" ;
        min:soort "inleiding" ;
        min:volgnummer 379 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Brunssum"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De R.K. St.-Vincentius á Paulokerk (bij Prins Hendriklaan 380) is een eenbeukige kerk met recht gesloten koor en een gedrongen westtoren met klokkenkoepel. Naar een door het rationalisme beïnvloed ontwerp van F.P.J. Peutz verrees deze kerk in 1924-'25 in opdracht van het Lazaristenconvent, waaraan de zielzorg in het toenmalige mijnwerkersrectoraat Rumpen was toevertrouwd. In verband met de ligging bij de Staatsmijn Hendrik werd een extra zware fundering toegepast om verzakkingen te voorkomen. In 1954 kreeg de kerk een kinderkapel (nu dagkapel) en na 1955 heeft men een rouwkapel toegevoegd. Voor de toren staat een groot Vincentiusbeeld (stichter van Lazaristenorde)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00380> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Brunssum"@nl ;
        min:adres "Prins Hendriklaan 380" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
        min:gemeenteInBoek "Brunssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59141> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "518603" ;
        min:soort "inleiding" ;
        min:volgnummer 380 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Brunssum"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "91" ;
        schema:pagination "91-92" ;
        schema:text "In het interieur bevinden zich schilderingen van Ch. Eyck (1928). Van zijn hand zijn ook vier gebrandschilderde ramen in de zijbeuken (1927) en het Vincentius-raam in de doopkapel. De moderne glazen zijn vervaardigd door E. Laudy en F. Slijpen (circa 1960). Tot de inventaris behoren kruiswegstaties van P. Killaars (1964) en een door Peutz ontworpen marmeren hoofdaltaar, uitgevoerd door de firma Laudy (1960). De pastorie (Prins Hendriklaan 380) dateert uit dezelfde tijd als de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Brunssum"@nl ;
        min:adres "Kerkstraat 125" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Brunssum" ;
        min:gemeenteInBoek "Brunssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Brunssum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Brunssum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Brunssum" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0030> ;
        schema:name "Brunssum"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De R.K. St.-Gregorius de Grotekerk (Kerkstraat 125) is een grote zaalkerk met halfronde apsis, torenachtige Mariakapel, uitgebouwde doopkapel en een vrijstaande betonnen toren met tentdak. Ter vervanging van een door mijnschade aangetaste koepelkerk uit 1918 kwam deze opvallende kerk met achthoekige vensters in 1961-'63 tot stand naar plannen van de Duitse architect G. Böhm, met C. Okhuysen als uitvoerend architect. In de toren hangt een door J.P. Perrin en Regnaud gegoten klok (1818). Tot de inventaris behoren een laat-gotisch doopvont (circa 1500; koperen deksel 1818) en het Müllerorgel uit 1857."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00382> a min:Passage,
