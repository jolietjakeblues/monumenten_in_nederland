        min:adres "Vroenhof 18-20" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Houthem-Sint Gerlach (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Houthem-Sint Gerlach" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37149> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "507273" ;
        min:soort "inleiding" ;
        min:volgnummer 729 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0072> ;
        schema:name "Houthem-Sint Gerlach (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De voorm. openbare lagere school (Vroenhof 18-20) werd in 1881 gebouwd als een zesklassige tweelaags school achter een neoclassicistische onderwijzerswoning. Na 1920 was het een R.K. school."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00730> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Houthem-Sint Gerlach (gemeente Valkenburg aan de Geul) – Boerderijen"@nl ;
        min:adres "Vroenhof 60",
            "Vroenhof 61" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Houthem-Sint Gerlach (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Houthem-Sint Gerlach" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15887>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33113> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36805",
            "36808" ;
        min:soort "lemma" ;
        min:volgnummer 730 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0072> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "167" ;
        schema:pagination "167-168" ;
        schema:text "Boerderijen. De gesloten mergelstenen hoeve St. Gerlach 22 uit 1660 heeft het woongedeelte evenwijdig aan de straat, voorzien van een classicistisch trigliefenfries en een poort met pilasters. Bij de gesloten hoeve St. Gerlach 17 uit 1668 is het haaks op de straat geplaatste woongedeelte voorzien van een in- en uitgezwenkte topgevel. De poort met ionische pilasters is van 1720. Van hetzelfde type is de gesloten hoeve St. Gerlach 20 uit 1683. Naast de poort bevindt zich een kleinere voetgangerspoort. Dit is ook het geval bij St. Gerlach 11. Deze gesloten mergelstenen hoeve heeft een woongedeelte met gezwenkte topgevel uit 1720 en een poort uit 1723. De St.-Maartenshoeve (Vroenhof 60) heeft een haaks op de straat staand woonhuisgedeelte met een zonnewijzer in de topgevel uit 1699. De naastgelegen poort met ionische pilasters dateert van 1721. De Wijnantshof op Gurtsenich (Vroenhof 61) is voorzien van een fors, haaks op de straat staand, woongedeelte met de jaartalankers ‘1685’, dat zijn huidige neorenaissance-vorm echter eind 19de eeuw heeft gekregen. In de afsluitende muur bevindt zich een 18de-eeuwse poort met ionische pilasters en vazen. Bij de U-vormige hoeve Vroenhof 31-33 hebben de twee haaks op de straat staande bouwdelen een gezwenkte gevel; de linker is van 1730. Voorbeelden van L-vormige boerderijen zijn St. Gerlach 12 (1765) en Vroenhof 100 (1772). De bakstenen gesloten hoeve St. Gerlach 32 is een goed voorbeeld van een boerderij uit de eerste helft van de 19de-eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00731> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Houthem-Sint Gerlach (gemeente Valkenburg aan de Geul) – Woonhuizen"@nl ;
        min:adres "Meerssenderweg 30-34",
            "Onderstestraat 60",
            "St. Gerlach 70-72" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
