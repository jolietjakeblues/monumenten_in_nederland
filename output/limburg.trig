        min:soort "inleiding" ;
        min:volgnummer 277 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0015> ;
        schema:name "Beegden (gemeente Heel)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Dorp, ontstaan op de hogere zandgronden aan de Maas en voor het eerst genoemd in 1202. Beegden behoorde tot het Land van Horn en later tot het prinsbisdom Luik. In 1676 werd het een zelfstandige heerlijkheid. In de 19de eeuw vormde zich een langgerekte dorpsbebouwing die later is verbreed."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0015.php> .

