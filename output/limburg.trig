        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0072> ;
        schema:name "Wegkapellen"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Wegkapellen. De mergelstenen niskapel (Calvaire) aan de Meerssenderweg (bij nr. 30) dateert uit de eerste helft van de 19de eeuw (hersteld 1939) en stond bij een in 1825 afgebroken kluizenaarshut. De kapel van St. Gerlachus in de eik (bij St.-Gerlachstraat 18) is een neoclassicistische open kapel uit 1870 met een 18de-eeuws barokke altaarretabel en Gerlachusbeeldje (kopie 1977). De Mariakapel (bij Provinciale Weg 24) werd in 1902 gesticht door M. Geuskens en vertoont neogotische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00734> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hulsberg (gemeente Nuth)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
