        min:volgnummer 1690 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0179> ;
        schema:name "Wanssum (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "403" ;
        schema:pageStart "402" ;
        schema:pagination "402-403" ;
        schema:text "De R.K. St.-Michaëlkerk (Pastoorstraat ong.) is een driebeukige kerk met aangebouwde kapellen en sacristie, gebouwd in 1950-'51 naar plannen van P.J.H. Coumans ter vervanging van de in 1944 verwoeste laat-gotische voorganger. De traptoren heeft men in 1960-'61 tot een bescheiden klokkentoren opgehoogd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0179.php> .

