        min:volgnummer 1527 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0164> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Overige kerken. Van 1953 dateert de door B.W. Plooij ontworpen (Geref.) Opstandingskerk (Ds. Boumastraat 1), een sobere zaalkerk met hoge smalle vensterpartijen en een verhoogde ingangspartij met bordestrap. De R.K. kerk O.L. Vrouwe van de Rozenkrans (Komeetstraat 5), een doosvormige zaalkerk met ingangsportaal en terzijde geplaatste toren, is in 1956-'57 tot stand gekomen naar een traditionalistisch ontwerp van F.P.J. Peutz. De pastorie (Komeetstraat 5c) is een in functionalistische vormen gebouwde bungalow."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01528> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Treebeek (gemeente Brunssum) – Scholen"@nl ;
