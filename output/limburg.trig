        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0166> ;
        schema:name "Ubachsberg (gemeente Voerendaal)"@nl ;
        schema:pageEnd "366" ;
        schema:pageStart "366" ;
        schema:pagination "366" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op het plateau van Ubachsberg aan de weg van Simpelveld naar Sittard. Opvallend is de cirkelstructuur van Kerkstraat-Hunsstraat-Oude Schoolstraat. Binnen de bestaande structuur is de bebouwing in de loop van de tijd verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01540> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ubachsberg (gemeente Voerendaal)"@nl ;
        min:adres "Kerkstraat 30" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Voerendaal" ;
        min:gemeenteInBoek "Voerendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voerendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ubachsberg (gemeente Voerendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ubachsberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22812> ;
