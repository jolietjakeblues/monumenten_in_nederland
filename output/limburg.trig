        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landgraaf_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rimburg (gemeente Landgraaf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Rimburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62339> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "23855" ;
        min:soort "inleiding" ;
        min:volgnummer 1229 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0133> ;
        schema:name "Rimburg (gemeente Landgraaf)"@nl ;
        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "De R.K.H. Drievuldigheidkerk (Brugstraat 1) is een kruiskerk met driezijdig gesloten koor en een getrapt westwerk met een centrale toren voorzien van een spits met frontalen. In de toren hangt een door Johan Heinrich Dinckelmeijer gegoten klok (1732). Het schip kwam in 1726 tot stand. Bij verbouwingen in 1900 en 1934 kreeg de kerk het huidige neoromaanse aanzicht. In het portaal bevindt zich een ingemetseld 17de-eeuws hardstenen wijwatervat. Het orgel is circa 1900 gebouwd door de Gebr. Vermeulen met gebruik van ouder pijpwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0133.php> .

