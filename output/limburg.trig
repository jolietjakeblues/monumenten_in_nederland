        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Het voorm. raadhuis (Grijzegraaf 17-19) is een wit gepleisterd L-vormig pand uit 1876, gebouwd als raadhuis annex school en onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0100.php> .

