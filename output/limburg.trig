        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Afferden (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Afferden" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 228 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0007-01> ;
        schema:name "Afferden (gemeente Bergen)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Het stuw- en sluiscomplex in de Maas (Nieuwe Stuwweg 1), ten noordwesten van Afferden, werd in 1929 gebouwd in het kader van de Maaskanalisering. Het centrale deel van de stuw bestaat uit twee portaalvormige afvoeropeningen met zogeheten stalen ‘Stoneyschuiven’. De noordelijk gelegen scheepvaartopening heeft stalen wielschuiven, die bij hoog water weggehaald kunnen worden. In de opgestuwde situatie maakt de scheepvaart gebruik van de zuidelijk gelegen dubbele schutsluis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00229> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Afferden (gemeente Bergen) – Siebengewald"@nl ;
        min:adres "Boterdijk 2",
            "Kloosterweg 13-15" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Gennep" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gennep_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Afferden (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Afferden" ;
        min:lemma "Siebengewald" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 229 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill72> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0007-01> ;
        schema:name "Siebengewald"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Siebengewald. Dit dorp ten oosten van Afferden is ontstaan in de late middeleeuwen en hoort sinds een grenscorrectie in 1818 bij Nederland. De inwoners kerkten tot 1823 in de kapel van het nabijgelegen klooster Gaesdonck (D), maar kregen in 1863 een eigen parochie. De bebouwing van het in 1945 zwaar verwoeste dorp concentreerde zich na de oorlog bij de Nieuwe Weg. Het voorm. Liefdesgesticht (Kloosterweg 13-15), gebouwd in 1928 voor de Zusters van O.L. Vrouwe van Tegelen, is een tweelaags pand met expressionistische details en een middenrisaliet met puntgevel. Ter vervanging van de in 1945 verwoeste kerk uit circa 1865 kwam in 1955-'56 de huidige R.K. St.-Josephkerk (Boterdijk 2) tot stand, een forse moderne kruiskerk met terzijde een vrijstaande, ongelede toren. Opvallend aan deze door P.W. Lerou ontworpen, belangrijke wederopbouwkerk zijn de door betonnen traceringen gelede lichtstroken boven de zijbeuken en de in beton met ronde gaten uitgevoerde veelhoekige apsis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00230> a min:Passage,
