        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0134> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Boerderijen. Rondom Roermond liggen enkele grote boerderijen. Van de gesloten hoeve Kloosterhof (Kloosterweg 95) is het woonhuisgedeelte gedateerd ‘1750’ en het schuurgedeelte ‘1766’. De Heisterhof (Straat 11) is een gesloten hoeve uit 1765. De gesloten hoeve Donk (De Weerd 94) dateert uit circa 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0134.php> .

