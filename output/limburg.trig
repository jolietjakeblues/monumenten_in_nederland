        min:soort "inleiding" ;
        min:volgnummer 523 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill167>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill168> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0046> ;
        schema:name "Gennep"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "De kerktoren van de oude R.K. St.-Martinuskerk (bij Torenstraat 17) [2] is een slanke neogotische toren uit 1864 van drie geledingen met ingesnoerde spits. Het ontwerp wordt wel toegeschreven aan P.J.H. Cuypers. De rest van de in oorsprong middeleeuwse en in 1665 en 1864 verbouwde kerk heeft men afgebroken na de in 1945 opgelopen zware oorlogsschade."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00524> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gennep"@nl ;
        min:adres "Zuid Oostwal 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
