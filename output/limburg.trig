        schema:name "Roggel (gemeente Roggel en Neer)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 9-13) bestaat uit een diep pand met verhoogd gelegen bel-etage onder wolfdak en een dwars aangebouwd eenlaags bouwdeel. Het met siermetselwerk uitgevoerde gebouw dateert uit 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0135.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roggel (gemeente Roggel en Neer)"@nl ;
        min:adres "Raadhuisstraat 1-3" ;
