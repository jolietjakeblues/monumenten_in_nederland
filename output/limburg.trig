        schema:name "Maasbree"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Het voorm. St.-Jozefklooster (Op de Kemp 45) werd in 1902-'03 gebouwd als liefdesgesticht van de Zusters der Goddelijke Voorzienigheid. Het tweelaags gebouw met neorenaissance-details heeft een middenrisaliet met puntgevel en een St.-Jozefbeeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00840> a min:Passage,
            schema:CreativeWork ;
