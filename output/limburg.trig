        min:soort "lemma" ;
        min:volgnummer 988 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill383> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0094> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "255" ;
        schema:pagination "255-256" ;
        schema:text "Woonhuizen. Het rijzige, wit geschilderde dwarse huis Mgr. Jenneskensstraat 2 heeft twee gezwenkte topgevels uit circa 1700 en een vroeg-19de-eeuwse ingang met gesneden bovenlicht. Sober neoclassicistisch van vorm zijn de herenhuizen Huize Catharina (Hoofdstraat 20) uit 1887 en Hoofdstraat 13 uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00989> a min:Passage,
