        min:adres "Kolleberg 2",
            "Leyenbroekerweg 107",
            "Leyenbroekerweg 111-113",
            "Leyenbroekerweg 52",
            "Walramstraat 23" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Sittard-Geleen" ;
        min:gemeenteInBoek "Sittard-Geleen" ;
