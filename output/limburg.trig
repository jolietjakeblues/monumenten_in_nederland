        min:rijksmonumentnummer "39752" ;
        min:soort "lemma" ;
        min:volgnummer 1739 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0184> ;
        schema:name "Etenaken"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Etenaken. Dit gehucht ten noordwesten van Wijlre heeft enkele, voornamelijk 18de-eeuwse boerderijen, opgetrokken in mergelsteen en/of vakwerk. Voorbeelden zijn de U-vormige boerderij Tuinstraat 13, de deels in vakwerk uitgevoerde boerderijen Valkenburgerweg 111 en Valkenburgerweg 100 (1790), en verder de gesloten hoeven Etenakerhof (Valkenburgerweg 44) en Valkenburgerweg 105 (jaartalankers 1768) en het 19de-eeuwse vakwerkhuis Valkenburgerweg 38."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0184.php> .

