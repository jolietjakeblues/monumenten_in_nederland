        min:lemma "Watermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27389>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40489> ;
