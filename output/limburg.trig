        schema:name "Neer (gemeente Roggel en Neer)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "De voorm. schepenbank (Engelmanstraat 13) is een dwars eenlaagspand met de jaartalankers ‘1667’ en gezwenkte topgevels in laat-maniëristische vormen met invliegopeningen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0108.php> .

