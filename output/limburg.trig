    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00012> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwoord"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
