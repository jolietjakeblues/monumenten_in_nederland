        min:hoofdstuk "Steden, dorpen, monumenten › Kerkrade" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Kerkrade" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 773 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0078> ;
        schema:name "Kerkrade"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Op het kerkhof staat een grafsteen met engel voor J.H.H. Lemmens (circa 1920). De pastorie (Dr. Kreyenstraat 8-9) is in 1911 in Nieuw-Historiserende vormen gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00774> a min:Passage,
