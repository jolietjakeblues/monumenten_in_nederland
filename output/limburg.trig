        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasbree" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Maasbree" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 837 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0088> ;
        schema:name "Maasbree"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Dorp, ontstaan in de middeleeuwen en in 1348 Brede genoemd. Maasbree behoorde tot het land van Kessel en werd in 1673 een zelfstandige heerlijkheid. Het ontwikkelde zich tot een flankesdorp met lineaire structuur en had sterk te lijden van een dorpsbrand in 1786. Na de Tweede Wereldoorlog is het dorp aan de noord- en zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00838> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasbree"@nl ;
        min:adres "Dorpstraat 25",
            "Dorpstraat 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Peel en Maas" ;
        min:gemeenteInBoek "Maasbree" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Peel_en_Maas> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasbree" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Maasbree" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50820>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60029> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "26525",
            "521977" ;
        min:soort "inleiding" ;
        min:volgnummer 838 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0088> ;
        schema:name "Maasbree"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De R.K. St.-Aldegundiskerk (bij Dorpstraat 25) is een driebeukige pseudobasiliek met driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde spits. Het laat-gotische schip werd in de 15de eeuw gebouwd en in 1535 met een vierde travee uitgebreid. In 1920-'21 verving men het in 1866 uitgebreide koor door het huidige neogotische koor naar plannen van J.Th.J. Cuypers. Van de in 1944 zwaar beschadigde kerk werd het schip in 1950-'51 herbouwd. Op de 15de-eeuwse onderbouw van de opgeblazen toren verrees een op de oude vormen geïnspireerde, maar rijziger uitgevoerde bovenbouw naar ontwerp van J.H.J. Kayser. De pastorie (Dorpstraat 4) dateert uit 1866."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0088.php> .

