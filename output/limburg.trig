            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74117>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74118> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "526748",
            "526935",
            "526937",
            "526938",
            "528756" ;
        min:soort "lemma" ;
        min:volgnummer 282 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0015> ;
        schema:name "Huis Nederhoven"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Huis Nederhoven (Nieuwstraat 65), gelegen ten zuidwesten van Beegden, wordt al in 1480 genoemd. Het huidige, deels omgrachte huis met mergelstenen speklagen dateert echter uit 1614. De windvaan met het jaartal ‘1819’ stamt van een verbouwing waarbij ook de vensters zijn vernieuwd. De nederhof (Dorpstraat 1) bestaat uit een gedeeltelijk omgrachte, U-vormige hoeve met gebouwen uit de 17de en 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00283> a min:Passage,
