        schema:name "Ubachsberg (gemeente Voerendaal)"@nl ;
        schema:pageEnd "366" ;
        schema:pageStart "366" ;
        schema:pagination "366" ;
        schema:text "De rond 1850 opgetrokken pastorie (Kerkstraat 28) is sterk gemoderniseerd. Het H. Hartbeeld voor de kerk dateert uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01542> a min:Passage,
