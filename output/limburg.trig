        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65823>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65824> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "513738",
            "513739" ;
        min:soort "inleiding" ;
        min:volgnummer 1498 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0161> ;
        schema:name "Terwinselen (gemeente Kerkrade)"@nl ;
        schema:pageEnd "357" ;
        schema:pageStart "357" ;
        schema:pagination "357" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (bij St.-Hubertuslaan 80) is een kruiskerk met halfronde apsis, dubbel transept en een terzijde geplaatste toren met hoog tentdak. Deze kerk met eclectische elementen werd in 1921-'23 gebouwd naar ontwerp van J.J.H. van Groenendael."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01499> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terwinselen (gemeente Kerkrade)"@nl ;
        min:adres "St.-Hubertuslaan 80" ;
        min:deel "Monumenten in Nederland. Limburg" ;
