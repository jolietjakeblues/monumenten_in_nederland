        min:volgnummer 1179 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0123> ;
        schema:name "Ottersum (gemeente Gennep)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "Het voorm. raadhuis (Raadhuisplein 1) is een dwars eenlaagspand met bordes, hoger opgaande middenpartij en dakruiter, uitgevoerd in 1902 in rijke neorenaissance-stijl naar ontwerp van A. Korting. Het raadhuis bevatte oorspronkelijk een veldwachterwoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0123.php> .

