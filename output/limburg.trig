        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "Het brouwershuis (Veerweg 15) is een fors, sober pand met schilddak en 18de-eeuwse ingangsomlijsting. Het gebouw kreeg het huidige aanzien in 1858."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0028.php> .

