        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Merkelbeek (gemeente Onderbanken)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Merkelbeek" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1020 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0098-01> ;
        schema:name "Merkelbeek (gemeente Onderbanken)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "De R.K. St.-Clemenskerk (Wilmenweg 1) is een driebeukige kerk met driezijdig gesloten koor en een ingebouwde toren van drie geledingen met ingesnoerde naaldspits. Deze neogotische kerk kwam in 1876-'78 tot stand naar plannen van Joh. Kayser. Het koor werd in 1935 vervangen door een transept en koorpartij in neogotische trant naar plannen van J. Franssen. In 1972-'73 is de kerk gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0098.php> .

