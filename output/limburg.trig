        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Valkenburg (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Oud-Valkenburg" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0124> ;
        schema:name "Oud-Valkenburg (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "Dorp, ontstaan in het dal van de Geul nabij twee kastelen en voor het eerst vermeld in 1041. In 1087 werd van hieruit het kasteel Valkenburg gesticht. Het oude kasteel (Genhoes) werd zetel van de heerlijkheid; kasteel Schaloen had deze functie van 1670 tot 1794. Het tussen Gerendal en Schaelsberg gelegen dorp is een beschermd gezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01184> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Valkenburg (gemeente Valkenburg aan de Geul) – Kasteel Genhoes"@nl ;
        min:adres "Oud-Valkenburg 17" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Valkenburg (gemeente Valkenburg aan de Geul)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Oud-Valkenburg" ;
        min:lemma "Kasteel Genhoes" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70708> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "514719" ;
        min:soort "lemma" ;
        min:volgnummer 1184 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill438> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0124> ;
        schema:name "Kasteel Genhoes"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "287" ;
        schema:pagination "287-288" ;
        schema:text """Kasteel Genhoes of ‘Het Huis’ (Oud-Valkenburg 17) is een omgracht kasteel dat in 1241 als ‘Alden-Valkenburg’ wordt vermeld. Mogelijk in oorsprong laat-15de-eeuws is de zuidwestelijke vleugel met de gedrongen - bijna vrijstaande - vierkante hoektoren. Beide bouwdelen kregen in opdracht van Johan van Strijthagen tussen 1545 en 1560 hun huidige hoogte gezien het laat-gotische boogfries aan de dakrand. Rond 1575 werd het kasteel beschadigd. Herstel (van de gordingenkappen) volgde in 1620 (jaartal op de windvaan). In 1701 kwam het kasteel in handen van H.G. baron von Thunderfeldt die het in 1749 verkocht aan Leonard Thimus. De kap van de bakstenen noordvleugel met mergelstenen ingangspoort dateert uit 1748-'49 (d). Het interieur bevat een balustertrap (circa 1700) en een stucplafond en schoorsteenmantel in Lodewijk XIV-stijl.

De U-vormige nederhof dateert in aanleg uit de 18de eeuw, maar brandde rond 1860 geheel uit. Aan de zuidzijde heeft het een mergelstenen hameipoort met pilasters en gebogen fronton (circa 1760). Aan de zuidoostzijde bevindt zich het restant van een bescheiden 19de-eeuwse landschappelijke tuinaanleg met bij de gracht een eendenhuis uit de tweede helft van de 18de eeuw."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01185> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Valkenburg (gemeente Valkenburg aan de Geul) – Kasteel Schaloen"@nl ;
        min:adres "Oud Valkenburg 25",
            "Oud-Valkenburg 1",
            "Oud-Valkenburg 2",
            "Oud-Valkenburg 29",
            "Oud-Valkenburg 3",
            "Schaelsberg 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Valkenburg aan de Geul" ;
        min:gemeenteInBoek "Valkenburg aan de Geul" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenburg_aan_de_Geul> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Valkenburg (gemeente Valkenburg aan de Geul)" ;
