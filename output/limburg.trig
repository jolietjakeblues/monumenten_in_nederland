        schema:name "Mesch (gemeente Eijsden)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Op het kerkhof staan tegen de kerkmuur enkele oude hardstenen grafkruisen (1632-1702). De rijzige pastorie (Kerkplein 1) werd kort na 1781 gebouwd met hardstenen vensteromlijstingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0100.php> .

