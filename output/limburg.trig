        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Het voorm. raadhuis annex burgemeesterswoning (Hoogstraat 12) is een in 1908 met neorenaissance-details gebouwd tweelaags pand, voorzien van een middenrisaliet met tuitgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00471> a min:Passage,
