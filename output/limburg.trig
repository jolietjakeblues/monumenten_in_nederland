        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14970> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36711" ;
        min:soort "lemma" ;
        min:volgnummer 1658 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Boerderijen. De herenhoeve Munnikshof (Vijlenstraat 51), voormalige zetel van de heerlijkheid Vijlen, is een van oorsprong 17de-eeuws bakstenen gebouw met verdieping en in het midden een uitbouw. De vensters zijn vernieuwd. In de gevel van de grotendeels moderne schuur is een wapensteen uit 1643 ingemetseld van Henrica Raitz von Frentz, abdis van Burtscheid. De boerderijen Hopschet 6 en Hopschet 16-18 zijn van oorsprong mogelijk 17de-eeuwse vakwerkpanden. Het laatstgenoemde heeft een lage verdieping met een geschoord dakoverstek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01659> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals) – Harles"@nl ;
        min:adres "Harles 1-2",
            "Harles 22" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Vaals" ;
        min:gemeenteInBoek "Vaals" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vaals_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:lemma "Harles" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18579>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39253> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36661",
            "36668" ;
        min:soort "lemma" ;
        min:volgnummer 1659 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Harles"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Harles. Dit gehucht ten zuidoosten van Vijlen is ontstaan in de vroege middeleeuwen. De gesloten hoeve De Hof (Harles 22) dateert blijkens de jaartalankers uit 1738. De poort wordt geflankeerd door met beeldnissen bekroonde pilasters en heeft een sluitsteen met het jaartal ‘1739’. Het bakstenen woongedeelte van Hoeve De Ploum (Harles 1-2) dateert uit 1842. Rechts sluit een ouder vakwerkgedeelte aan. Verder zijn er een vrijstaande, grotendeels in vakwerk opgetrokken schuur (1783) en een in vakwerk uitgevoerd bakhuis. Voorbeelden van 18de-eeuwse vakwerkpanden zijn verder het boerenhuis Harles 4, met geschoord dakoverstek, en de tweelaagse hoeven Harles 12 en Harles 15. Uit de 19de eeuw dateren het vakwerkhuis Harles 18 en de gesloten hoeve Harles 3 (1841) met grote inrijpoort."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01660> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals) – Rott"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Vaals" ;
        min:gemeenteInBoek "Vaals" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vaals_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:lemma "Rott" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1660 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Rott"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Rott. Dit gehucht ten westen van Vijlen bestaat voornamelijk uit 18de-eeuwse vakwerkpanden, zoals de hoeve Rott 14. Vakwerkpanden met een lage verdieping zijn het diepe huis Rott 36, met een los bakhuis met uitgebouwde ovenruimte, het dwarse pand Rott 46, met geschoord dakoverstek, en Rott 48, met vakwerkschuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01661> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vijlen (gemeente Vaals) – Camerig"@nl ;
        min:adres "Camerig 22" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Vaals" ;
        min:gemeenteInBoek "Vaals" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vaals_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vijlen (gemeente Vaals)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vijlen" ;
        min:lemma "Camerig" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19817> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "36648" ;
        min:soort "lemma" ;
        min:volgnummer 1661 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Camerig"@nl ;
        schema:pageEnd "397" ;
        schema:pageStart "397" ;
        schema:pagination "397" ;
        schema:text "Camerig. Dit gehucht ten zuidwesten van Vijlen is in de middeleeuwen ontstaan als ontginningsnederzetting in bebost gebied (Vijlenerbos). Het behoorde samen met Cottessen al sinds de 14de eeuw tot de heerlijkheid Vijlen. De open lintbebouwing bestaat voor een belangrijk deel uit vakwerkhuizen. De herenhoeve Winneberg (Camerig 22) is van oorsprong mogelijk middeleeuws. Camerig 4-5 is een vakwerkhoeve met open binnenplaats. De ingang van nr. 4 draagt het jaartal ‘1613’ en heeft een bespijkerde deur. Camerig 1-2 is een vakwerkhoeve met gebouwen aan weerszijden van een langwerpige hof. Het van oorsprong 17de-eeuwse woonhuisgedeelte is later vergroot. De topgevel in kolenzandsteen draagt de jaartalankers ‘1749’. Het bedrijfsgedeelte dateert uit de eerste helft van de 19de eeuw. Camerig 3 is een 18de-eeuws, deels onderkelderd, dwars vakwerkpand. De voorgevel en de zuidelijke kopgevel zijn in baksteen vernieuwd. De vakwerkhoeve Camerig 6 bestaat uit een evenwijdig naast elkaar gelegen woongedeelte en schuur. De deurkalf van de schuur is voorzien van het jaartal ‘1762’. Andere voorbeelden van 18de- en 19de-eeuwse huizen zijn Camerig 7-9, waarvan nr. 9 in baksteen is uitgevoerd, en iets daarachter, Camerig 10-11."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01662> a min:Passage,
