        min:volgnummer 409 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0033> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "96" ;
        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text """Woonhuizen. Sobere expressionistische vormen vertoont het woon- en winkelpand Vliegenstraat 44 uit 1929. Van expressionistische details voorzien is de villa De Nachtegaal (Kloosterberg 8) uit circa 1932. Zonnehoekje (Hemelboomlaan 11), een mergelstenen villa in traditionalistische vormen uit circa 1935, is ontworpen door S. Claessens.

De brug over het Julianakanaal (bij Meerstraat 54) is een in 1931-'34 naar ontwerp van Rijkswaterstaat gebouwde stalen boogbrug met een geklonken vakwerkconstructie."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00410> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bunde (gemeente Meerssen) – Weert"@nl ;
        min:adres "Weert 78",
