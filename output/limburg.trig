        min:volgnummer 710 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0070> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text "Boerderijen. De in 1984 gerestaureerde gesloten hoeve Het Posthuis (Posthuisweg 12), met aan de straat een woonvleugel uit 1780, was een pleisterplaats voor de post. Baexemerweg 2 is een L-vormige boerderij met een statig woongedeelte uit 1846. De langgevelboerderij Kasteelstraat 9 is voorzien van de jaartalankers ‘1861’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0070.php> .

