        min:hoofdstuk "Steden, dorpen, monumenten › Venlo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Venlo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58823> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "524775" ;
        min:soort "inleiding" ;
        min:volgnummer 1623 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0173> ;
        schema:name "Venlo"@nl ;
        schema:pageEnd "386" ;
        schema:pageStart "386" ;
        schema:pagination "386" ;
        schema:text "Het voorm. klooster Mariadal (Schoolweg 140-146) werd in 1889 door Duitse dominicanessen gesticht als Kulturkampfklooster onder de naam ‘Mariënthal’. In twee fasen (1890 en 1894) kwam een fors carrévormig klooster in neogotische stijl tot stand. Aan de oostzijde werd in 1901 een flinke neogotische kapel toegevoegd naar ontwerp van J. Baeten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01624> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venlo"@nl ;
        min:adres "Sinselveldstraat 35",
            "Sinselveldstraat 37" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venlo" ;
        min:gemeenteInBoek "Venlo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venlo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Venlo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Venlo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33765> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "37172" ;
        min:soort "inleiding" ;
        min:volgnummer 1624 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0173> ;
        schema:name "Venlo"@nl ;
        schema:pageEnd "387" ;
        schema:pageStart "386" ;
        schema:pagination "386-387" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (Sinselveldstraat 35) [6] is een driebeukige kruisbasiliek met vijfzijdig gesloten koor, zeszijdige kruising met dakruiter en een toren van vier geledingen met frontalen en ruitdaken. Deze kerk uit 1913-'14 was het laatste neogotische kerkontwerp van P.J.H. Cuypers. De toren heeft romanogotische vormen. De in 1944-'45 zwaar beschadigde kerk heeft men in 1947-'48 hersteld onder leiding van F. Stoks, waarbij de torenspits lager is herbouwd. Bijzonder is inwendig de zeszijdige kruising, die wordt bekroond door een hoge koepel. De kerk bevat een bescheiden hoofdaltaar uit de bouwtijd. De door H. Seelen ontworpen pastorie (Sinselveldstraat 37) dateert uit 1912."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01625> a min:Passage,
