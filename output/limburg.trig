        schema:name "Noorbeek (gemeente Margraten)"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Op het kerkhof staan diverse oude stenen grafkruisen (1608-1765) en een bronzen H. Hartbeeld van A. Falise (1925). De pastorie (Klompestraat 9) is een onderkelderd huis met hardstenen vensteromlijstingen, gebouwd in de tweede helft van de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0114.php> .

