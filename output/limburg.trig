        min:soort "inleiding" ;
        min:volgnummer 559 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0051> ;
        schema:name "Grevenbicht-Papenhoven (gemeente Sittard-Geleen)"@nl ;
        schema:pageEnd "126" ;
        schema:pageStart "126" ;
        schema:pagination "126" ;
        schema:text "De voorm. R.K. lagere jongensschool (Aan de Greune Poal 13, Grevenbicht) werd rond 1925 gebouwd als een drieklassige school met gymnastieklokaal en stalen vensters. Het pand is in 1968 verbouwd tot sportzaal en bibliotheek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00560> a min:Passage,
