        schema:name "Maasniel (gemeente Roermond)"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "De pastorie (Pastoor Ramakersstraat 9) is een fors tweelaags pand met hardstenen vensteromlijstingen en de jaartalankers ‘1768’. Het interieur bevat een schoorsteenmantel en stucplafond in Lodewijk XV-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0089.php> .

