    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00534> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geulle (gemeente Meerssen)"@nl ;
        min:adres "Geulderlei 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
