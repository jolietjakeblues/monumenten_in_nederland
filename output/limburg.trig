        schema:name "Scholen"@nl ;
        schema:pageEnd "324" ;
        schema:pageStart "324" ;
        schema:pagination "324" ;
        schema:text "Scholen. De voorm. openbare lagere school (Dorpstraat 22) is een gepleisterd diep pand uit 1827, dat tot 1870 als school in gebruik is geweest. De R.K. St.-Jozefschool (Kloosterstraat 66) is een achtklassige middengangschool, gebouwd in 1931 naar ontwerp van A.H.J. Swinkels in opdracht van het bestuur van Huize Loreto. Opvallend is de risalerende ingangspartij met expressionistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01353> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Simpelveld – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Simpelveld" ;
        min:gemeenteInBoek "Simpelveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Simpelveld_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Simpelveld" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Simpelveld" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1353 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0145> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "324" ;
        schema:pageStart "324" ;
        schema:pagination "324" ;
        schema:text "Woonhuizen. Het in Kunradersteen opgetrokken huis Irmstraat 88 werd gebouwd in 1797 (gevelsteen) voor burgemeester Theodoor van Wersch. De villa Pastoriestraat 9 uit circa 1910 vertoont chaletstijl-elementen. Een voorbeeld van een fors herenhuis met rationalistische elementen is Kloosterstraat 17, gebouwd in 1923 naar ontwerp van L. Lerschen. St.-Nicolaasbergweg 1-11 is een blok van drie dubbele woningen in Kunradersteen uit circa 1920. Het dubbele woonhuis Panneslagerstraat 16-18, met hoger opgetrokken middenpartij en expressionistische details, kwam in 1930 tot stand naar plannen van W.J. Nievelstein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01354> a min:Passage,
