        rdfs:label "Geysteren (gemeente Meerlo-Wanssum)"@nl ;
        min:adres "Dorpstraat 18" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venray" ;
        min:gemeenteInBoek "Meerlo-Wanssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venray_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geysteren (gemeente Meerlo-Wanssum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Geysteren" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 542 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0049> ;
        schema:name "Geysteren (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "De R.K. St.-Willibrorduskerk (Dorpstraat 18) is een rijzige eenbeukige kerk met een rond gesloten koor, aangebouwde kapellen en een ingangsportaal. De kerk kwam in 1949 tot stand naar plannen van A.J.N. Boosten ter vervanging van de in 1944 verwoeste laat-gotische kerk. De geplande toren werd niet uitgevoerd. Tegen de buitenmuur staat een maniëristische grafzerk voor Jacob van Eyll († 1574) en Elisabeth van Groesbeek († 1566)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00543> a min:Passage,
