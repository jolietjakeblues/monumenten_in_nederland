        schema:name "Vaals"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "De pastorie (Kerkstraat 27a) is een gepleisterd dwars huis uit circa 1900 met een eclectische voorgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0169.php> .

