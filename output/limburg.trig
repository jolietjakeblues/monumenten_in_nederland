        min:kern "Blitterswijck" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27214> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "28435" ;
        min:soort "inleiding" ;
        min:volgnummer 348 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0024> ;
        schema:name "Blitterswijck (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De boerderij ‘Wijnhoverhof’ (Ooijenseweg 5) is een gesloten hoeve met een fors, haaks op de weg geplaatst woongedeelte uit 1790. De naastgelegen poort met ellipsboog geeft toegang tot een binnenhof met overwegend 19de-eeuwse bijgebouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00349> a min:Passage,
            schema:CreativeWork ;
