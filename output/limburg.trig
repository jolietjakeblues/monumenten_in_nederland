        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill185> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0056> ;
        schema:name "Grubbenvorst (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "131" ;
        schema:pageStart "131" ;
        schema:pagination "131" ;
        schema:text "Op het kerkhof bevinden zich enkele 17de- en 18de-eeuwse grafkruisen en - zerken, waaronder twee priesterzerken (1749 en 1785). De pastorie (Pastoorstraat 5) is uit 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0056.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00593> a min:Passage,
