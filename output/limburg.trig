        min:soort "lemma" ;
        min:volgnummer 970 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0092> ;
        schema:name "Honthem"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text "Honthem. Dit gehucht ten zuidwesten van Margraten is een plateaunederzetting waarvan de huidige bebouwing tot de 18de eeuw teruggaat. De L-vormige vakwerkboerderij Honthem 8 dateert uit die tijd. De Honthemershof (Honthem 43) is een gesloten herenhoeve uit 1849 (poortsluitsteen). De gepleisterde wegkapel (Honthem ong.) met dakruiter dateert van 1924 en is herbouwd in 1999."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00971> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mechelen (gemeente Gulpen-Wittem)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Gulpen-Wittem" ;
        min:gemeenteInBoek "Gulpen-Wittem" ;
