        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijswiller (gemeente Gulpen-Wittem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nijswiller" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1116 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0113> ;
        schema:name "Nijswiller (gemeente Gulpen-Wittem)"@nl ;
        schema:pageEnd "276" ;
        schema:pageStart "276" ;
        schema:pagination "276" ;
        schema:text "Dorp, ontstaan in de middeleeuwen aan de oude weg van Maastricht naar Aken waar deze de Selzerbeek kruist. Dit in 1178 voor het eerst vermelde dorp behoorde tot 1802 tot de parochie van Eys. In 1835 vond samenvoeging plaats met de parochie van Wahlwiller. Na de aanleg van de rijksstraatweg Maastricht-Aken (1824-'25) verschoof het zwaartepunt van de bebouwing naar deze weg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01117> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijswiller (gemeente Gulpen-Wittem)"@nl ;
        min:adres "Kerkstraat 31" ;
        min:deel "Monumenten in Nederland. Limburg" ;
