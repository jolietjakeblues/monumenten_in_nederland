        min:provincie "Limburg" ;
        min:rijksmonumentnummer "522190",
            "522191" ;
        min:soort "inleiding" ;
        min:volgnummer 1150 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0118> ;
        schema:name "Ohé (gemeente Maasbracht)"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Op het ommuurde kerkhof staat een beeld van St. Michaël (circa 1920) en nabij de kerk een H. Hartbeeld op basement met engelen (1930) en een beeld van Moeder Magdalena Daemen (1933). De voorm. pastorie (Kerkstraat 4), gebouwd rond 1885 in sobere neorenaissance-stijl, is verbouwd in 1909."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01151> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ohé (gemeente Maasbracht)"@nl ;
        min:adres "Kerkstraat 1-3",
            "Raadhuisstraat 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Maasgouw" ;
        min:gemeenteInBoek "Maasbracht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasgouw> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ohé (gemeente Maasbracht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ohé" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49760> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "522193" ;
        min:soort "inleiding" ;
        min:volgnummer 1151 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0118> ;
        schema:name "Ohé (gemeente Maasbracht)"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 2) is een U-vormig complex. In 1851 verrees een school met onderwijzerswoning (Kerkstraat 1-3). De woning werd in 1877-'78 verhoogd en voorzien van het opschrift ‘Ohé en Laak’. Aan de achterzijde van de speelplaats bouwde men toen een bescheiden raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01152> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ohé (gemeente Maasbracht) – Huis Hasselholt"@nl ;
        min:adres "Burg. Minkenberglaan 9",
            "Prior Gielenstraat 1-3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Maasgouw" ;
        min:gemeenteInBoek "Maasbracht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasgouw> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ohé (gemeente Maasbracht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ohé" ;
        min:lemma "Huis Hasselholt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37074> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "31252" ;
        min:soort "lemma" ;
        min:volgnummer 1152 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill430> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0118> ;
        schema:name "Huis Hasselholt"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text """Huis Hasselholt (Burg. Minkenberglaan 9), ook wel ‘Het Goedje’ genoemd, is een nu ommuurd maar oorspronkelijk omgracht adellijk huis. Het tweelaags hoofdgebouw is voorzien van mergelstenen trapgevels met overhoekse pinakels en laat-gotische korfboognissen. Een gevelsteen met het alliantiewapen van de families In der Horst-Hillen geeft de vermoedelijke bouwdatum: 1548. De bakstenen langsgevel werd in 1651 vernieuwd. Het zadeldak loopt door over een lagere uitbouw, die inwendig is voorzien van een netgewelf. De achtzijdige toren met spits aan de noordzijde is toegevoegd bij de restauratie in 1972 op basis van aangetroffen bouwsporen. De lange haakse noordvleugel werd blijkens de jaartalankers van de trapgevel toegevoegd in 1629. De binnenplaatszijde is in vakwerk uitgevoerd. Het interieur bevat een schouw met kariatiden (begin 17de eeuw) en een schoorsteenmantel met stucwerk (1777).

De boerderij ‘Huize Geno’ (Prior Gielenstraat 1-3) is een wit gesausde gesloten hoeve. Blijkens gevelstenen dateert het woonhuis uit 1788 en de schuur uit 1780. De stallen zijn in 1937 gebouwd naar ontwerp van J.H.J. Kayser."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01153> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ohé (gemeente Maasbracht) – Laak"@nl ;
        min:adres "St.-Annastraat 1",
            "St.-Annastraat 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Maasgouw" ;
        min:gemeenteInBoek "Maasbracht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasgouw> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ohé (gemeente Maasbracht)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ohé" ;
        min:lemma "Laak" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1153 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0118> ;
        schema:name "Laak"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Laak. Dit lintdorp langs de Maas, gelegen ten noordwesten van Ohé, vormde vroeger met Ohé één heerlijkheid. Het Witte Huis (St.-Annastraat 2) heeft een hoog 18de-eeuws voorhuis en een wat lager achterhuis. Door de 19de-eeuwse U-vormige bedrijfsvleugels heeft het huis een boerderijachtig voorkomen. Aardige woonhuizen zijn St.-Annastraat 5, dat blijkens een gevelsteen uit 1800 dateert, en het rond 1890 in eenvoudige neorenaissance-stijl gebouwde huis St.-Annastraat 10. De neogotische St.-Annakapel (St.-Annastraat 1) werd gebouwd in 1896 naar ontwerp van N. van der Schuit."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01154> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oirsbeek (gemeente Schinnen)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
