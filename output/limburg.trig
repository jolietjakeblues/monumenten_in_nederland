        min:kern "Groot Haasdal" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 587 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0055> ;
        schema:name "Groot Haasdal (gemeente Nuth)"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "Gehucht met dries, ontstaan in de middeleeuwen op het plateau van Schimmert. Op de dries kwamen in de vroege 19de eeuw vier bebouwingslinten uit (Nieuwstraat, Trichterstraat, Kleverstraat en Groot Haasdal)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00588> a min:Passage,
