        min:kern "Urmond" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1553 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill563> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0168> ;
        schema:name "Urmond (gemeente Stein)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "Dorp, gelegen op de hogere oostelijke Maasoever nabij de monding van de Ur (een oude Maasstrang). De nederzetting wordt in 1153 voor het eerst vermeld als Overmunte. In 1400 werd Urmond bezit van de hertog van Gulik. Het ontwikkelde zich tot een havenplaats met tol. Het stedelijk karakter (vlek) kwam tot uitdrukking door de gedeeltelijke omwalling met vier poorten en vijf rondelen. In de late 18de eeuw vond enige uitbreiding plaats in westelijke richting naar de lager gelegen Maasoever. Eind 19de eeuw verdween de haven. Het Julianakanaal (1931-'34) werd aan de oostzijde van de oude kern - een beschermd gezicht - gegraven. Na de Tweede Wereldoorlog is Urmond aan de oostzijde van het Julianakanaal sterk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01554> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Urmond (gemeente Stein)"@nl ;
        min:adres "Grotestraat 67" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Stein" ;
        min:gemeenteInBoek "Stein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stein_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Urmond (gemeente Stein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Urmond" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1554 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0168> ;
        schema:name "Urmond (gemeente Stein)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "De voorm. Herv. kerk (Grotestraat 67), nu S.O.W.-kerk, is een wit geschilderde eenbeukige kerk met rond gesloten koor, dakruiter en aan de voorzijde een vlakke topgevel. Deze classicistische kerk met brede ionische pilasters dateert uit 1685. In de kerk bevindt zich de grafsteen van Johannes Bussy († 1694)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01555> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Urmond (gemeente Stein)"@nl ;
        min:adres "Grotestraat 63",
            "Grotestraat 65" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Stein" ;
        min:gemeenteInBoek "Stein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stein_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Urmond (gemeente Stein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Urmond" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1555 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0168> ;
        schema:name "Urmond (gemeente Stein)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "De voorm. pastorie (Grotestraat 65) werd in 1705 gebouwd op middeleeuwse fundamenten en kreeg bij een ingrijpende verbouwing in 1827 de huidige vorm als fors middenganghuis. De bijbehorende voorm. openbare lagere school (Grotestraat 63) is een in de kern mogelijk 18de-eeuws dwars eenlaagspand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01556> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Urmond (gemeente Stein)"@nl ;
        min:adres "Grotestraat 26" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Stein" ;
        min:gemeenteInBoek "Stein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stein_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Urmond (gemeente Stein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Urmond" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1556 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0168> ;
        schema:name "Urmond (gemeente Stein)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "De voorm. oude R.K. St.-Martinuskerk (Grotestraat 26) is een eenbeukige kerk met driezijdig gesloten koor, aangebouwde sacristie en een ingebouwde toren met klokdak met spits. De kerk kwam in 1791-'93 tot stand ter vervanging van een 14de-eeuwse voorganger. De sacristie dateert uit 1805. De toren van de oude kerk bleef los van de nieuwe kerk behouden tot 1841, toen de huidige toren verrees naar ontwerp van S. Beugels. Een hardstenen ingangsomlijsting uit 1812 werd in de nieuwe toren geplaatst. In de toren hangen klokken uit 1494 en 1506. De kerk ligt op een verhoogd ommuurd kerkhof"@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01557> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Urmond (gemeente Stein)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Stein" ;
        min:gemeenteInBoek "Stein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stein_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Urmond (gemeente Stein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Urmond" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1557 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill564> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0168> ;
        schema:name "Urmond (gemeente Stein)"@nl ;
        schema:pageEnd "368" ;
        schema:pageStart "368" ;
        schema:pagination "368" ;
        schema:text "De nieuwe R.K. St.-Martinuskerk (St.-Maartenstraat ong.) is een moderne zaalkerk met een kleine klokkentoren boven het recht gesloten koor en een breder en hoger voorportaal. De kerk werd in 1954-'56 gebouwd in functionalistische vormen naar ontwerp van F.P.J. Peutz. De kerk bezit onder meer een Calvariegroep (15de eeuw) en een doopvont (16de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01558> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Urmond (gemeente Stein)"@nl ;
        min:adres "Raadhuisstraat 13",
            "Raadhuisstraat 45" ;
        min:deel "Monumenten in Nederland. Limburg" ;
