        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De pastorie (Prins de Lignestraat 31) is gelijk met de kerk gebouwd. De in traditionalistische stijl uitgevoerde kapelanie (Prins de Lignestraat 20) dateert uit 1936."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0045.php> .

