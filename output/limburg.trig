        min:adres "Bongerd 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beek" ;
        min:gemeenteInBoek "Beek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Spaubeek (gemeente Beek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Spaubeek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12292> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "513191" ;
        min:soort "inleiding" ;
        min:volgnummer 1422 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0151> ;
        schema:name "Spaubeek (gemeente Beek)"@nl ;
        schema:pageEnd "340" ;
        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "De R.K. St.-Laurentiuskerk (Bongerd 4) is een driebeukige basilicale kruiskerk met dakruiter en een ongelede toren met zijkapellen, lantaarn en ingesnoerde spits. Deze uit brokken Nivelsteiner zandsteen opgetrokken kerk kwam in 1925-'26 tot stand naar ontwerp van J.E. Schoenmaekers ter vervanging van een kerk uit 1837. Het interieur wordt gedekt door een houten spitsbooggewelf. De muurschilderingen van de Twaalf Apostelen in schip en kruisarmen zijn vervaardigd door G. Tielens (circa 1930). Tot de inventaris behoren een preekstoel en twee biechtstoelen (alle eerste helft 19de eeuw), een door L. Vermeulen gebouwd orgel (1868) en de door Jos Thissen vervaardigde gepolychromeerde beelden van Maria (1873) en St. Laurentius (1875). Uit de oude kerk afkomstig zijn vier gebrandschilderde koorramen (1837); de overige ramen zijn van J. Postmes (circa 1926)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01423> a min:Passage,
