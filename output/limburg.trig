        min:volgnummer 1181 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0123> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "Boerderijen. Op het erf van de rond 1890 gebouwde boerderij St.-Janstraat 22, met dwars geplaatst voorhuis, staat een waarschijnlijk uit de tweede helft van de 18de eeuw daterende grote schuur met zijlangsdeel. Deze schuur heeft forse etagegebinten in de vorm van ankerbalkgebinten, waarvan de bovenste eenzijdig oversteken. St.-Janstraat 1 is een forse boerderij met dwars geplaatst, sober neoclassicistisch voorhuis, gebouwd rond 1875."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0123.php> .

