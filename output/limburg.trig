        min:volgnummer 400 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0033> ;
        schema:name "Bunde (gemeente Meerssen)"@nl ;
        schema:pageEnd "95" ;
        schema:pageStart "95" ;
        schema:pagination "95" ;
        schema:text "Dorp, ontstaan tegen de oostflank van het Maasdal en voor het eerst vermeld in 1145. Bunde behoorde later tot het Land van Valkenburg en werd in 1626 een zelfstandige heerlijkheid. Het wegdorp is na de Tweede Wereldoorlog uitgegroeid tot een fors forensendorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00401> a min:Passage,
