        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "Het postkantoor met bovenwoning (Maastrichterlaan 29) [7] dateert uit 1906 en heeft een op de chaletstijl geïnspireerde gepleisterde verdieping en vakwerktopgevel. Het inpandige portiek heeft aan de bovenzijde een jugendstilhekwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01574> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vaals"@nl ;
