        min:volgnummer 1341 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0144> ;
        schema:name "Sibbe (gemeente Valkenburg aan de Geul)"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "Dorp, gelegen op het plateau van Margraten dat in de middeleeuwen vanuit Oud-Valkenburg werd ontgonnen. Onder het dorp bevindt zich een groeve waar nog mergelsteen wordt gewonnen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01342> a min:Passage,
