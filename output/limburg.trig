        schema:text "De voorm. R.K. lagere school (Kerkplein 8) is een forse tweelaags gangschool met neogotische details, gebouwd in 1886 naar ontwerp van architect Ubachs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00578> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gronsveld (gemeente Eijsden) – Kasteel Gronsveld"@nl ;
        min:adres "Rijksweg 68" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Eijsden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gronsveld (gemeente Eijsden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Gronsveld" ;
        min:lemma "Kasteel Gronsveld" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69586>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69587>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69588>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69591>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69592> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "509953",
            "509955",
            "509958",
            "509959",
            "509960" ;
        min:soort "lemma" ;
        min:volgnummer 578 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill184> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0053> ;
        schema:name "Kasteel Gronsveld"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Kasteel Gronsveld (Rijksweg 68) is mogelijk ontstaan in de 13de eeuw als mottekasteel. Dit vormde het uitgangspunt voor de rond 1300 tot stand gekomen rechthoekige aanleg met ronde hoektorens. Na verwoesting in 1594 werd het kasteel in dezelfde vorm herbouwd. Het in 1634 in handen van een roversbende gevallen kasteel werd na de herovering ontmanteld. Het oostelijke deel bleef eerst deels gespaard, maar na verdere afbraak in 1827 bleef slechts de ruïne van de zuidoostelijke toren over. De fundamenten van de noordoostelijke toren vormden de basis voor het in 1833 in opdracht van A.A. Gadiot gebouwde rijzige landhuis, dat rond 1880 werd verbouwd in neogotische vormen en toen onder meer arkeltorentjes kreeg. Gelijktijdig bouwde men tegen de resten van de noordelijke kasteelmuur een oranjerie. Het opvallend rijke poortgebouw Rijksweg 70, met hoger opgaande poorttoren, verrees in 1881 in een Frans aandoende stijl met neogotische en neoclassicistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00579> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gronsveld (gemeente Eijsden) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Eijsden-Margraten" ;
        min:gemeenteInBoek "Eijsden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eijsden-Margraten> ;
