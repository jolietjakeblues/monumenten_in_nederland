        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlodrop (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vlodrop" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1667 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0176> ;
        schema:name "Vlodrop (gemeente Roerdalen)"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "Het voorm. raadhuis (Markt 1) kreeg het huidig aanzicht in traditionalistische vormen in 1950 naar ontwerp van J. Bongaerts, die ook het oorspronkelijke ontwerp van 1928 had geleverd. Thans is het als kantoor in gebruik."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01668> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlodrop (gemeente Roerdalen) – Kasteel Steenhuis"@nl ;
        min:adres "Kasteelweg 2",
            "Kasteelweg 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlodrop (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vlodrop" ;
        min:lemma "Kasteel Steenhuis" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1668 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0176> ;
        schema:name "Kasteel Steenhuis"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "Kasteel Steenhuis (Kasteelweg 2) is een omgracht, onderkelderd herenhuis uit 1664, gebouwd voor Gerard Bordels ter vervanging van een ouder kasteel. Aan de pleinzijde heeft het een torenvormig middenrisaliet met een samengestelde spits. De voorgevel is gepleisterd. De in de 18de eeuw gewijzigde vensters hebben een hardstenen omlijsting. Boven de ingang bevindt zich een wapensteen met het jaartal ‘1664’ en aan weerszijden van de kleine stoep staan twee natuurstenen vlampotten uit 1742, afkomstig van de brugpijlers. Van de twee bouwhuizen aan weerszijden van het voorplein is die aan de westzijde vernieuwd. Tegenover het kasteel ligt de voorm. kasteelboerderij ‘Huyserhof’ (Kasteelweg 3) met een schuur voorzien van grote inrijpoorten uit 1854."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01669> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlodrop (gemeente Roerdalen) – Boerderijen"@nl ;
        min:adres "Bergerweg 48",
            "Kerkbergweg 3" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlodrop (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vlodrop" ;
        min:lemma "Boerderijen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1669 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0176> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text "Boerderijen. De L-vormige boerderij Rentelaershof (Kerkbergweg 3) dateert in de huidige vorm uit het begin van de 19de eeuw. Het voorste gedeelte van het hogere woonhuis is mogelijk het restant van een oudere, 15de-eeuwse voorganger (De Hof van Nuynhem). In 1684 werd de boerderij eigendom van Balthasar Renteler en kreeg het de huidige naam. De gesloten hoeve Bergerweg 17 dateert in oorsprong uit het eind van de 18de eeuw. Bij een verbouwing in 1948 heeft men het woonhuis verhoogd en voorzien van gezwenkte gevel. Hoeve Moorsel (Bergerweg 48), een gesloten hoeve uit het begin van de 19de eeuw, is in 1947 na oorlogsschade verbouwd. Reeds in de 13de eeuw is er sprake van een boerderij ter plaatse (Hoeve Mursel)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01670> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlodrop (gemeente Roerdalen) – Woonhuizen"@nl ;
        min:adres "Tussen de Bruggen 8" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlodrop (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vlodrop" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1670 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill612> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0176> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "398" ;
        schema:pageStart "398" ;
        schema:pagination "398" ;
        schema:text """Woonhuizen. Het in 1807 gebouwde diepe pand Kleine Wal 12, met zadeldak tussen puntgevels, is in gebruik geweest als marechausseekazerne, boerderij, winkel en café. Boomgaardweg 12-14 is een vroeg-19de-eeuwse dubbele woning. Het eclectisch vorm gegeven herenhuis Bergerweg 30 uit 1896 heeft een gepleisterde frontgevel voorzien van decoratieve sluitsteenornamenten. Dezelfde stucornamenten vertoont het eenvoudige diepe pand Grootestraat 15. Het uit 1916 daterende woonblok Kerkstraat 3-5 is voorzien van een afgeschuinde hoekpartij met trapgeveltje en gemetseld rondboogfries.

De voorm. café-concertzaal (Tussen de Bruggen 8), voorheen bekend als ‘Zaal Wolken’, is in 1932 gebouwd naar ontwerp van J.P. Coumans en G.G.M. Timmermans. Het cafégedeelte is een drielaags bouwdeel met gebroken kap en aan de voor- en rechterzijde een deels dichtgezette veranda met balkon."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlodrop (gemeente Roerdalen) – Watermolens"@nl ;
        min:adres "Gitstappermolenweg 1a",
            "Gitstappermolenweg 3",
            "Herkenbosserweg 7-9",
            "Tussen de Bruggen 24" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roerdalen" ;
        min:gemeenteInBoek "Roerdalen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roerdalen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlodrop (gemeente Roerdalen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Vlodrop" ;
        min:lemma "Watermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26634> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "37867" ;
        min:soort "lemma" ;
        min:volgnummer 1671 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill613> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0176> ;
        schema:name "Watermolens"@nl ;
        schema:pageEnd "399" ;
        schema:pageStart "398" ;
        schema:pagination "398-399" ;
        schema:text """Watermolens. Aan de Rode Beek ligt de Vlodroppermolen (Tussen de Bruggen 24), gebouwd in 1834 als een koren- en oliemolen. Rond 1875 heeft men de molen na brand herbouwd als een korenmolen met een turbine, die rond 1884 is vervangen door een nieuwe verticale turbine. Aan dezelfde beek ligt ten noordoosten van Vlodrop, voorbij het dorp Etsberg, de Gitstappermolen (Gitstappermolenweg 3). Deze als middenslagmolen uitgevoerde korenmolen werd gebouwd in de 18de eeuw op de plaats van een 14de-eeuwse voorganger. Oorspronkelijk bestond het complex uit een koren- en een oliemolen, elk met eigen waterrad, en een woonhuis. Rond 1918 heeft men de oliemolen stilgelegd en het waterrad en olieslagwerk afgebroken. In 1987-'88 is de molen gerestaureerd en zijn het houten waterrad en twee koppels maalstenen teruggebracht. De bijbehorende schuur (Gitstappermolenweg 1a) uit circa 1750 heeft gedeeltelijk nog de originele houten kapconstructie.

De voorm. douanepost (Herkenbosserweg 7-9) bij de grensovergang Rothenbach ten noordoosten van Vlodrop dateert uit 1857. De verhoogde risalerende middenpartij is voorzien van een gestukadoorde omlijsting. Het in 1975 gerestaureerde pand is nu als woonhuis in gebruik."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01672> a min:Passage,
