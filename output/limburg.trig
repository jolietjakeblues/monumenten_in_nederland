        schema:name "Vaals"@nl ;
        schema:pageEnd "371" ;
        schema:pageStart "371" ;
        schema:pagination "371" ;
        schema:text "Het voorm. raadhuis (Maastrichterlaan 27) [6] is een blokvormig pand uit 1913 in nieuw-historiserende vormen met een zandstenen kroonlijst en fronton. Het is thans in gebruik als bankgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0169.php> .

