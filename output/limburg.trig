        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mesch (gemeente Eijsden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Mesch" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1029 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0100> ;
        schema:name "Mesch (gemeente Eijsden)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Dorp, gelegen in het dal van de Voer en ontstaan in de vroege middeleeuwen. Mesch ontwikkelde zich tot een kerkdorp en bleef tot 1794 als Vrije Rijksheerlijkheid in bezit van het Akense Munsterstift. In 1943 kwam het bij de gemeente Eijsden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01030> a min:Passage,
