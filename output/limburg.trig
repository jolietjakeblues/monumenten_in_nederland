        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill83> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0013> ;
        schema:name "Baexem (gemeente Heythuysen)"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Het klooster Mariabosch (Lindelaan 8) werd eind 19de eeuw gesticht door Duitse Jezuïeten en in 1918 overgenomen door de zusters Dienaressen van de H. Geest. Het complex werd in 1934 uitgebreid met een kapel en rond 1955 met een nieuwe vleugel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0013.php> .

