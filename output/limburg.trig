        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwstadt (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Nieuwstadt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54754> ;
