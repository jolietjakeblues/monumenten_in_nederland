        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roermond_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasniel (gemeente Roermond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Maasniel" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 842 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0089> ;
        schema:name "Maasniel (gemeente Roermond)"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "Dorp, ontstaan nabij de Maasnielder beek en in 943 voor het eerst vermeld. De parochie werd in 1298 gesticht en behoorde oorspronkelijk tot de heerlijkheid Daelenbroek en na 1716 tot het Oostenrijks Overkwartier. In 1960 kwam Maasniel bij Roermond, waarna beide kernen aan elkaar zijn gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00843> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasniel (gemeente Roermond)"@nl ;
        min:adres "Raadhuisstraat 19" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Roermond" ;
        min:gemeenteInBoek "Roermond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roermond_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Maasniel (gemeente Roermond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Maasniel" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 843 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0089> ;
        schema:name "Maasniel (gemeente Roermond)"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "De R.K. St.-Laurentiuskerk (Raadhuisstraat 19) is een driebeukige kruisbasiliek met recht gesloten koor, vieringtoren en een westtoren met achtkantige lantaarn. De oorspronkelijke kleine romaanse kerk ter plaatse werd in 1755 vervangen. Tegen de oude toren verrees in 1880-'81 een neogotische kerk, die in 1945 onherstelbaar werd beschadigd. De huidige kerk in traditionalistische vormen kwam in 1950-'51 tot stand naar ontwerp van J. Franssen; de toren werd in 1954 afgebouwd. De aardbevingsschade uit 1992 is in 1993-'94 hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00844> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Maasniel (gemeente Roermond)"@nl ;
        min:adres "Pastoor Ramakersstraat 9" ;
