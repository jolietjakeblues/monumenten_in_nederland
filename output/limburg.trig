        schema:name "Merselo (gemeente Venray)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "De R.K. kerk O.L. Vrouwe van de Vrede te Vredepeel (Joh. van Stalbergweg 4), gelegen ten westen van Merselo, is een moderne doosvormige kerk met lage aanbouw en vrijstaande stalen klokkenstoel. De kerk werd in 1962-'63 gebouwd naar plannen van J. Magis & W.A.S. Witlox in dit in 1955 gestichte Peeldorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01029> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mesch (gemeente Eijsden)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
