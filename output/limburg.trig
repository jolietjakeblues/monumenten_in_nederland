        min:soort "inleiding" ;
        min:volgnummer 370 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0029> ;
        schema:name "Broekhuizenvorst (gemeente Horst aan de Maas)"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "Het wat verhoogd gelegen kerkhof wordt omringd door een vroeg-17de-eeuwse muur met ‘schietgaten’ aan de zuidzijde. Op het kerkhof bevinden zich enkele 17de-eeuwse grafkruisen en een oorlogsmonument voor twee in 1940 gesneuvelde Nederlandse soldaten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0029.php> .

