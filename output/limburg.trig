        min:soort "inleiding" ;
        min:volgnummer 1203 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill444> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0128> ;
        schema:name "Ransdaal (gemeente Voerendaal)"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Dorp, ontstaan in de middeleeuwen tegen een flank van het plateau van Schinnen aan de weg van Heerlen naar Valkenburg. Aan de noordzijde werd in 1913-'14 de spoorlijn Schin op Geul-Heerlen aangelegd. Tussen weg en spoor ontstond na de Tweede Wereldoorlog enige dorpsuitbreiding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0128.php> .

