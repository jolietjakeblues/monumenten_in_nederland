        min:soort "lemma" ;
        min:volgnummer 1484 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0159> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "354" ;
        schema:pageStart "354" ;
        schema:pagination "354" ;
        schema:text "Woonhuizen. Uit de 18de eeuw dateert het gepleisterde, deels in vakwerk uitgevoerde, L-vormige huis Bergstraat 88. Rond 1890 gebouwd zijn de huizen Bergstraat 55, met een tot topgevel opgetrokken gevelgedeelte, en Bergstraat 89-91 met eclectisch sierpleisterwerk. Het woonhuis-café Bergstraat 79 kwam in 1930 tot stand naar ontwerp van G.J. Pijls."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01485> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sweikhuizen (gemeente Schinnen) – Boerderijen"@nl ;
        min:adres "Bergstraat 1",
            "Moorheide 1",
            "Stammen 1" ;
