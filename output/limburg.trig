        schema:pageStart "342" ;
        schema:pagination "342" ;
        schema:text "De R.K. kerk O.L. Vrouwe van Altijddurende Bijstand (Kampstraat 50, Heilust), een kruiskerk met ronde koorsluiting en inpandig portaal, is gebouwd in 1955-'56 naar een traditionalistisch ontwerp van H.J.A. Koene."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0152.php> .

