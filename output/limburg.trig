        schema:name "Itteren (gemeente Maastricht)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "Het voorm. raadhuis (Pasestraat 25) is rond 1930 gebouwd in traditionalistische vormen, met hoog zadeldak en grote trapgevels. Het pand heeft tot 1970 als raadhuis dienst gedaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0075.php> .

