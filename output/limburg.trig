        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0103> ;
        schema:name "Middelaar (gemeente Mook en Middelaar)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "De O.L.-Vrouwe van Lourdeskapel (bij Eindweg 8) is een kleine wegkapel met trapgevels, gebouwd in 1887 in opdracht van pastoor E. Wisman. De kapel werd herbouwd in 1946 en gerestaureerd in 1981."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01048> a min:Passage,
