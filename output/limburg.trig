        min:kern "Baexem" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 268 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0013> ;
        schema:name "Baexem (gemeente Heythuysen)"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "De R.K. St.-Joannes de Doperkerk (Mgr. Kierkelsplein 19) is een driebeukige kerk met rond gesloten koor en een terzijde daarvan geplaatste toren. De kerk kwam in 1949-'50 tot stand naar plannen van A.J.N. Boosten. De gedrongen en ongelede toren heeft men in 1958 toegevoegd. De op enige afstand gelegen oude dorpskerk werd in 1944 verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00269> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Baexem (gemeente Heythuysen) – Scholen"@nl ;
