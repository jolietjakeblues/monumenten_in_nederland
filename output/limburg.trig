            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59338> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "23638",
            "23643" ;
        min:soort "inleiding" ;
        min:volgnummer 789 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0079> ;
        schema:name "Kessel"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "De R.K.O.L.-Vrouwe Geboortekerk (Kerkplein 3) is een driebeukige kerk met driezijdig gesloten koor, dwarsschip en toren van drie geledingen met frontalen en achtzijdige spits. Deze neogotische kerk kwam in 1870-'73 tot stand naar plannen van P.J.H. Cuypers ter vervanging van de iets noordelijker gelegen middeleeuwse kerk. In 1944 werd de toren opgeblazen en het schip beschadigd. Bij het herstel in 1947-'48 heeft men aan de westzijde een dwarsschip toegevoegd. Naar plannen van J. Franssen herrees de toren in 1953 in licht gewijzigde vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00790> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kessel"@nl ;
        min:adres "Dorpstraat 13",
            "Kerkplein 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Peel en Maas" ;
