        min:soort "inleiding" ;
        min:volgnummer 734 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0073> ;
        schema:name "Hulsberg (gemeente Nuth)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Dorp met dries, ontstaan in de middeleeuwen. De kerk wordt in 1147 voor het eerst vermeld. Vanaf de dries - de huidige Kerkheuvel - vormden zich de Kerkstraat en Kerkbergweg en de jongere lineaire bebouwing langs de Raadhuisstraat en Wissengrachtweg. Na de Tweede Wereldoorlog is het dorp ten zuidwesten van de kerk sterk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00735> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hulsberg (gemeente Nuth)"@nl ;
        min:adres "Kerkheuvel 10-12",
            "Kerkheuvel 7" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Nuth" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hulsberg (gemeente Nuth)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Hulsberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26187> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "507193" ;
        min:soort "inleiding" ;
        min:volgnummer 735 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0073> ;
        schema:name "Hulsberg (gemeente Nuth)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De R.K. St.-Clemenskerk (Kerkheuvel 7) is een driebeukige basilicale kruiskerk met driezijdig gesloten koor, vieringtorentje en een ongelede toren met achtkantige spits. Ter uitbreiding van een voorganger uit 1820 kwam in 1908 naar ontwerp van J.Th.J. Cuypers en J. Stuyt het huidige koor met twee sacristieruimten tot stand. In 1930 werden het schip, het transept en de bovenbouw van de toren vernieuwd naar een ontwerp met neoromaanse elementen van J.Th.J. Cuypers. In 1990 is de kerk gerestaureerd. Het interieur wordt gedekt door een tongewelf. De kerk bevat een hardstenen doopvont (1622) en een door Pereboom & Leyser gebouwd orgel (1871). Van de in 1930 door atelier Cuypers vervaardigde inventaris zijn de kruiswegstaties en fragmenten van het hoofdaltaar, de communiebank en de preekstoel behouden. De gebrandschilderde ramen zijn van H. Truyen (1967). De voorm. kapelanie (Kerkheuvel 10-12) is een tweelaags middenganghuis uit circa 1905 met een tot topgevel verhoogd middenrisaliet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00736> a min:Passage,
            schema:CreativeWork ;
