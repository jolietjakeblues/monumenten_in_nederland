        min:volgnummer 1129 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0115> ;
        schema:name "Nunhem (gemeente Haelen)"@nl ;
        schema:pageEnd "278" ;
        schema:pageStart "278" ;
        schema:pagination "278" ;
        schema:text "Het voorm. klooster Maria Schoot (Voort 6) van de zusters van de O.L. Vrouwe van Ommel heeft een L-vormig gepleisterd hoofdgebouw uit 1735. De binnenplaats van de aansluitende hoeve is toegankelijk via een 18de-eeuws poortpaviljoen met fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01130> a min:Passage,
