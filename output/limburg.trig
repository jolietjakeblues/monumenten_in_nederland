        min:gemeenteInBoek "Heythuysen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heythuysen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Heythuysen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55736> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22127" ;
        min:soort "inleiding" ;
        min:volgnummer 684 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill219> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0066> ;
        schema:name "Heythuysen"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Op het kerkhof bevinden zich fragmenten van oude grafstenen en grafkruisen (1604-1761). De voorm. missiekapel (bij Dorpstraat 120) is een rechthoekig neoclassicistisch gebouw met een prostylos in de vorm van een dorisch tempelfront met vier zuilen. De kapel werd in 1850-'51 gebouwd als onderdak voor de - in processies gebruikte - missiegroep en is kapel in 1988 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00685> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heythuysen – Kloosters"@nl ;
        min:adres "Aan de Kreppel 1",
            "Dorpstraat 98",
            "Op de Bos 2" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Heythuysen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heythuysen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Heythuysen" ;
        min:lemma "Kloosters" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 685 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0066> ;
        schema:name "Kloosters"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text """Kloosters. Op het uit 1757 stammende landgoed De Kreppel werd in 1835 het klooster St. Elisabeth (Aan de Kreppel 1) gebouwd, dat de hoofdvestiging werd van de door Catharina Daemen gestichte - en tot de franciscanessen behorende - congregatie van Zusters van Heythuysen. De bijbehorende kapel werd in 1944 verwoest en is rond 1950 herbouwd. Het klooster is nu een kloosterbejaardenoord. Het H. Geestklooster (Op de Bos 2) is een fors drielaags gebouw uit 1930 van de Witte Paters van St. Charles.

Het voorm. raadhuis (Dorpstraat 98) is een tweelaags pand met banden in siermetselwerk, gebouwd rond 1908 als raadhuis annex postkantoor."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00686> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heythuysen – Scholen"@nl ;
        min:adres "Notaris Ruttenlaan 17",
            "Tienderweg 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Heythuysen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heythuysen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Heythuysen" ;
        min:lemma "Scholen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 686 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0066> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Scholen. De lagere school ‘De Beukenhof’ (Notaris Ruttenlaan 17) is een tweelaags gebouw uit 1936, oorspronkelijk gebouwd als dubbele school. Het zakelijk-expressionistische ontwerp van P.J. Coppen vertoont verticale gevelelementen, waarin de twee entreepartijen zijn ondergebracht. Uit 1960 dateert de naar ontwerp van J.J.G. Zöllner in sobere functionalistische wederopbouwvormen uitgevoerde middelbare school (Tienderweg 1). Het gebouw heeft twee bouwlagen met klaslokalen boven een terug liggende begane grond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00687> a min:Passage,
