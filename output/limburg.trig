        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ell (gemeente Hunsel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ell" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 467 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0040> ;
        schema:name "Ell (gemeente Hunsel)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op de hogere gronden nabij de Tungelroyse Beek. In 1492 werd hier een kapel gebouwd. Begin 20ste eeuw heeft Ell zich ontwikkeld tot een bescheiden wegdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00468> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ell (gemeente Hunsel)"@nl ;
        min:adres "Niesstraat 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Hunsel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ell (gemeente Hunsel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Ell" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45527> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "22866" ;
        min:soort "inleiding" ;
        min:volgnummer 468 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0040> ;
        schema:name "Ell (gemeente Hunsel)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "De R.K. St.-Antonius Abtkerk (Niesstraat 1) is een driebeukige basilicale kerk met rond gesloten koor en een terzijde staande toren. Deze kerk met neoromaanse details kwam in 1912 tot stand naar ontwerp van C.J.H. Franssen ter vervanging van een kerk uit 1823, die was gebouwd op de plaats van de laat-gotische kapel (1492) van Ell. De toren werd in 1944 opgeblazen, waarna men de kerk in 1946 heeft hersteld. In 1953 volgde onder leiding van J. Franssen een verlenging van de kerk en de herbouw van de toren. In de westgevel is de poort van de laat-gotische kapel herplaatst, waarboven een beeld van St.-Antonius is ingemetseld. Het interieur wordt gedekt door een vlakke zoldering (schip) en kruisgewelven (zijbeuken). De kerk bevat enkele houten beelden, waaronder een Annatrits en een beeld van St. Antonius Abt (beide 16de eeuw). Tegen de kerk staat een grafkruis van Geurt Lutten († 1666)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00469> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ell (gemeente Hunsel)"@nl ;
        min:adres "Niesstraat 1",
