        min:volgnummer 1653 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0175> ;
        schema:name "Vijlen (gemeente Vaals)"@nl ;
        schema:pageEnd "396" ;
        schema:pageStart "396" ;
        schema:pagination "396" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op het plateau van Vijlen. De hoog gelegen parochiekerk lag aanvankelijk in het vrije veld tussen enkele kleine gehuchten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0175.php> .

