        schema:name "Rothem (gemeente Meerssen)"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "De R.K. lagere school ‘Lindegaerde’ (Past. Geelenplein 2) is een forse tweelaags middengangschool met acht klassen, gebouwd in 1922 als dubbele school voor gescheiden onderwijs aan jongens en meisjes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01287> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rothem (gemeente Meerssen) – Woonhuizen"@nl ;
        min:adres "Emmaweg 86" ;
        min:deel "Monumenten in Nederland. Limburg" ;
