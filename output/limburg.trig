        schema:pageEnd "96" ;
        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text "De voorm. pastorie (Patronaatstraat 1) dateert uit 1896. In de nabijheid (bij Patronaatstraat 8) staat een kunststenen H. Hartbeeld (circa 1925)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0033.php> .

