        min:kern "Blitterswijck" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 344 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0024> ;
        schema:name "Blitterswijck (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Dorp aan de Maas, ontstaan bij een middeleeuws kasteel en gelegen op de oostrand van een zandrug. Het dorp wordt voor het eerst vermeld in 1242. In 1776 werden Wanssum en Blitterswijck samen één heerlijkheid en de hieruit ontstane gemeente werd in 1815 bij Nederland gevoegd. In 1944 werd het dorp zwaar beschadigd, waarbij het kasteel werd verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00345> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blitterswijck (gemeente Meerlo-Wanssum)"@nl ;
        min:adres "Plein 1" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Venray" ;
        min:gemeenteInBoek "Meerlo-Wanssum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Venray_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blitterswijck (gemeente Meerlo-Wanssum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Blitterswijck" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31662> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "28433" ;
        min:soort "inleiding" ;
        min:volgnummer 345 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill103> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0024> ;
        schema:name "Blitterswijck (gemeente Meerlo-Wanssum)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De R.K.O.L.-Vrouwekerk (Plein 1) is een tweebeukige kerk met driezijdig gesloten koor, transept en een toren van twee geledingen met ingesnoerde spits. Van de rond 1500 voltooide kerk werd het in 1944 beschadigde laat-gotische schip in 1950-'51 hersteld naar plannen van A.H.J. Swinkels. Het koor werd vervangen door een nieuw koor en een dwarsbeuk. De in 1953 opgetrokken nieuwe en hogere toren is geïnspireerd op de in 1944 opgeblazen laat-gotische voorganger, begonnen in 1455. Het interieur wordt gedekt door eenvoudige kruisribgewelven (1953). Boven de scheibogen in het schip zijn enkele restanten van 16de-eeuwse muurschilderingen behouden gebleven. Tot de inventaris behoren een calvariegroep (vroeg 16de eeuw) en de kruiswegstaties (19de eeuw); tot de herinrichting van rond 1951 horen de altaren, de communiebank en het spreekgestoelte. De kerkhofkapel annex baarhuisje dateert uit circa 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00346> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blitterswijck (gemeente Meerlo-Wanssum)"@nl ;
        min:adres "Beeteweg 1" ;
