            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20684> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "33346",
            "33348" ;
        min:soort "inleiding" ;
        min:volgnummer 1157 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill431> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0119> ;
        schema:name "Oirsbeek (gemeente Schinnen)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "283" ;
        schema:pagination "283-284" ;
        schema:text "De pastorie (Raadhuisstraat 10) en de voorm. kapelanie (Grachtstraat 16), respectievelijk gebouwd in de tweede helft van de 18de eeuw en de eerste helft van de 19de eeuw, zijn tweelaags middenganghuizen met hardstenen segmentboogvensters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01158> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oirsbeek (gemeente Schinnen)"@nl ;
        min:adres "Raadhuisstraat 19" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Schinnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oirsbeek (gemeente Schinnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Oirsbeek" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1158 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0119> ;
        schema:name "Oirsbeek (gemeente Schinnen)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 19), een tweelaags dwars pand in traditionalistische vormen, is in 1938 gebouwd naar ontwerp van W. Schelberg ter vervanging van een voorganger uit 1837."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01159> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oirsbeek (gemeente Schinnen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Beekdaelen" ;
        min:gemeenteInBoek "Schinnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beekdaelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oirsbeek (gemeente Schinnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Oirsbeek" ;
        min:lemma "Boerderijen" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1159 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0119> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "Boerderijen. De gesloten hoeve Dorpstraat 1-3 is voorzien van de jaartalankers ‘1669’ en een in de 19de eeuw gepleisterde voorgevel met rondboogpoort. Deels in vakwerk uitgevoerde U-vormige hoeven zijn Dorpsstraat 31-35, met een kern uit 1771, en Provincialeweg Zuid 39, dat mogelijk een laat-18de-eeuwse oorsprong heeft. Voorbeelden van gesloten hoeven zijn de deels gepleisterde boerderij Hagendoornweg 7 uit 1796 (sluitsteen) en de wit geschilderde boerderij Grachtstraat 1 uit de eerste helft van de 19de eeuw. Beide hebben een tweelaags woongedeelte met hardstenen vensteromlijstingen. De U-vormige hoeve Beukenberg 52, eveneens met tweelaags woongedeelte, kreeg het huidige gepleisterde aanzien met eclectische details in 1883, maar heeft een oudere kern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0119.php> .

