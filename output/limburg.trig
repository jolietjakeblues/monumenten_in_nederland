        schema:text "Het voorm. postkantoor met directeurswoning (Raadhuisstraat 1-3) is een tweelaags pand met neorenaissance-details uit 1901."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0135.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roggel (gemeente Roggel en Neer) – Woonhuizen"@nl ;
        min:adres "Koppelstraat 65-67",
            "Nijken 24",
            "Pater Van Donstraat 4" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Leudal" ;
        min:gemeenteInBoek "Roggel en Neer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leudal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roggel (gemeente Roggel en Neer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Roggel" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46840> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "32694" ;
        min:soort "lemma" ;
        min:volgnummer 1277 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0135> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text """Woonhuizen. In 1868 gebouwd is de voorm. molenaarswoning Koppelstraat 50. Van de bijbehorende molen resteert sinds een brand in 1946 enkel de romp. De gepleisterde burgemeesterswoning Raadhuisstraat 6, met imitatie rusticablokken op de hoeken, is rond 1890 gebouwd. Goede voorbeelden van villa's in zakelijk-expressionistische vormen, opgetrokken naar plannen van J.M.J. Wagemans, zijn Dorpstraat 1 (1931) en Raadhuisstraat 17 (1933). De windmolen ‘Sint Petrus’ (Nijken 24) is een bergmolen met ronde stenen romp en een met dakleer beklede kap. Deze korenmolen is gebouwd in 1901 (volgens opschrift in 1892). De in 1914 in de berg ingebouwde ruimte voor een maalinstallatie bevat een uit De Lage Weide (U) afkomstige dieselmotor (1930). De in 1975 gerestaureerde molen en de maalderij zijn sinds 1987 weer in gebruik.

De voorm. zuivelfabriek ‘Sint-Petrus’ (Koppelstraat 65-67) werd in 1908 gebouwd met neogotische elementen en bestaat uit een diepe directeurswoning naast een L-vormig bedrijfsgedeelte.

De R.K. St.-Isidoruskerk te Heibloem (Pater Van Donstraat 4), gelegen ten noorden van Roggel, is een moderne zaalkerk met bescheiden klokkentoren, gebouwd in 1951-'52 naar plannen van P.H. Weegels. Het dorp Heibloem is ontstaan in 1852 door de stichting van het St.-Aloysiusgesticht; een jongensinternaat (gesloten 1952, gesloopt 1960-'65)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0135.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01278> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roosteren (gemeente Susteren)"@nl ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Echt-Susteren" ;
        min:gemeenteInBoek "Susteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Echt-Susteren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roosteren (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Roosteren" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 1278 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0136> ;
        schema:name "Roosteren (gemeente Susteren)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "Dorp, ontstaan in de middeleeuwen met oorspronkelijk een lineaire nederzettingsstructuur. Vanaf de 13de eeuw behoorde Roosteren tot het gebied van de hertog van Gelre. De kern van het huidige Roosteren is het gehucht Scheiereynde, waar in 1843 een nieuwe parochiekerk werd gebouwd. Van de oude kerk in Oud-Roosteren resteert het kerkhof. Door het graven van het Julianakanaal is het lineaire karakter van Roosteren verloren gegaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01279> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roosteren (gemeente Susteren)"@nl ;
        min:adres "Maasheuvel 6" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Echt-Susteren" ;
        min:gemeenteInBoek "Susteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Echt-Susteren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roosteren (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Roosteren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16159> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "28656" ;
        min:soort "inleiding" ;
        min:volgnummer 1279 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/afbeelding/sten009monu08ill477> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0136> ;
        schema:name "Roosteren (gemeente Susteren)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "De R.K. St.-Jacobus de Meerderekerk (Maasheuvel 6) is een driebeukige neoclassicistische kerk met een rond gesloten koor en een ingebouwde vierkante westtoren met ingesnoerde spits. De kerk werd in 1843 gebouwd naar plannen van J.H.J. Dumoulin. In de toren hangt een door Joris Sulris gegoten klok (1529). De oorlogsschade aan de kerk is in 1946 hersteld. Inwendig zijn middenschip en koor voorzien van een gestukadoord tongewelf, de zijbeuken zijn vlak gedekt. Tot de inventaris behoren een hardstenen doopvont (circa 1200), twee herenbanken (18de-eeuw), een biechtstoel (1758), een neogotisch hoofdaltaar en triomfkruis, en een door M. van Dinter en L. Vermeulen gebouwd orgel (1857)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01280> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roosteren (gemeente Susteren) – Kasteel Eyckholt"@nl ;
        min:adres "Eyckholtstraat 19" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Echt-Susteren" ;
        min:gemeenteInBoek "Susteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Echt-Susteren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roosteren (gemeente Susteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Roosteren" ;
        min:lemma "Kasteel Eyckholt" ;
        min:provincie "Limburg" ;
        min:soort "lemma" ;
        min:volgnummer 1280 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0136> ;
        schema:name "Kasteel Eyckholt"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "Kasteel Eyckholt (Eyckholtstraat 19), ook bekend onder de naam 't Heufken, is een laat-16de-eeuws, in mergel en baksteen opgetrokken huis met een gepleisterde voorgevel en een 19de-eeuwse vierkante hoektoren. In de rechter zijgevel met mergelstenen speklagen zijn vensters met gotische omlijstingen aanwezig. Een steentje met het jaar 1688 herinnert aan een verbouwing in opdracht van Johan van Rossum. Sinds 1769, nadat Joannes Henricus Eyckholt van Maaseik eigenaar was geworden, is er sprake van kasteel Eyckholt. In de periode 1877-1951 heeft het kasteel als klooster van de Zusters der Goddelijke Voorzienigheid gediend. Na de restauratie in 1977 is het kasteel als hotel-restaurant in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/01281> a min:Passage,
