        min:kern "Heerlen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45313> ;
        min:provincie "Limburg" ;
        min:rijksmonumentnummer "512810" ;
        min:soort "inleiding" ;
        min:volgnummer 639 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0060> ;
        schema:name "Heerlen"@nl ;
        schema:pageEnd "140" ;
        schema:pageStart "140" ;
        schema:pagination "140" ;
        schema:text "De Herv. kerk (Tempsplein 14) [3] is een kruiskerk met een zadeldaktoren in de zuidwesthoek, gebouwd in 1931-'32 naar een ontwerp met rationalistische en zakelijk-expressionistische elementen van J. en Th. Stuivinga. Een tussenlid verbindt de kerk met de gelijktijdig gebouwde kosterswoning. Kerk en kosterswoning zijn gerenoveerd in 1993."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00640> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerlen"@nl ;
        min:adres "Stationstraat 24a" ;
        min:deel "Monumenten in Nederland. Limburg" ;
        min:gemeente "Heerlen" ;
        min:gemeenteInBoek "Heerlen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerlen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Limburg> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heerlen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01> ;
        min:kern "Heerlen" ;
        min:provincie "Limburg" ;
        min:soort "inleiding" ;
        min:volgnummer 640 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/hoofdstuk/0060> ;
        schema:name "Heerlen"@nl ;
        schema:pageEnd "140" ;
        schema:pageStart "140" ;
        schema:pagination "140" ;
        schema:text "De voorm. synagoge (Stationstraat 24a) [4] werd in 1935-'36 naar plannen van H. Dassen gebouwd over de oude Joodse begraafplaats (1811-'98) omdat toen geen andere locatie voorhanden was. Oude grafstenen worden bewaard in een kelder onder de voorplaats van de synagoge. Het gebouw gaat schuil achter een jongere apotheek aan de Stationsstraat en doet sinds 1985 dienst als opslagruimte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu08_01/sten009monu08_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu08_01/passage/00641> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerlen"@nl ;
        min:adres "Heerenweg 45" ;
        min:deel "Monumenten in Nederland. Limburg" ;
