        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "De voorm. Geref. kerk ‘'t Heechhout’ (Molenweg 7-9) is een recht gesloten zaalkerk uit 1927 met dakruiter en een aangebouwde woning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0201.php> .

