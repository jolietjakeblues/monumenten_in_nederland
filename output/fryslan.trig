        min:volgnummer 1673 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0205> ;
        schema:name "Workum (Warkum) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "Op het kerkhof achter de kerk staat een laat-19de-eeuws neogotisch gietijzeren grafmonument met beelden van St. Bernardus en St. Cecilia onder een baldakijn. Dit monument is opgericht voor B. Fluitman en S. Fluitman-Ydema, weldoeners van de kerk, en is vervaardigd door ijzergieterij A. Aerschot. De in 1877 gebouwde neogotische pastorie (Noard 173) is eveneens ontworpen door Tepe. Bij de kerk staat de gietijzeren dorpspomp (circa 1875)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0205.php> .

