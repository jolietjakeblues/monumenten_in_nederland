        min:gemeenteInBoek "Leeuwarderadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Cornjum (Koarnjum) (gemeente Leeuwarderadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Cornjum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 444 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "De familiebegraafplaats Van Burmania (bij Aldlânsdyk 1) is een in 1809 gestichte, omgrachte grafheuvel met tien grote zerken, waaronder die voor R.J. Arntzenius van Burmania († 1816), R.J. Artzenius Quaestius († 1824), E.S. van Burmania († 1831) en P.M. van Burmania Vegelin van Claerbergen († 1894)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00445> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 445 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "102" ;
        schema:pagination "102-103" ;
        schema:text "Langgerekt streekdorp, ontstaan in de middeleeuwen op een zandrug. Deze diende als ontginningsas voor de nederzettingen Akkerwoude, Murmerwoude en Dantumawoude, die in 1971 zijn samengevoegd tot Damwoude. Het laaggelegen terrein ten zuiden van Akkerwoude heeft bij het voortgaan van de ontginning de verplaatsing van dit dorp verhinderd; de oude Achterweg en de nieuwere Voorweg komen dan ook bij de kerk samen. Bij Murmerwoude en Dantumawoude vond de verplaatsing in zuidelijke richting - naar de nieuwe as Voorweg-Doniaweg - wel plaats. Haaks op die as legde men in 1880 de Hoofdweg aan. Hier liep ook de trambaan van Dokkum naar Veenwouden. Na de Tweede Wereldoorlog hebben vooral bij Murmerwoude uitbreidingen plaatsgevonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00446> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:adres "Doniaweg 76" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 446 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "De Herv. kerk van Dantumawoude (Doniaweg 76), oorspronkelijk gewijd aan St. Benedictus, is een eenbeukige kerk met driezijdig gesloten koor en een rijzige zadeldaktoren van twee geledingen. In de 12de eeuw kwam een tufstenen kerk tot stand, mogelijk met een gereduceerd westwerk. Van deze fase is aan de zuidzijde het met granieten keien gevulde tufstenen muurwerk (kistwerk) zichtbaar. De gevel heeft grote spaarvelden met keperfriezen. De noordgevel kreeg in de 16de eeuw een beklamping en grotere vensters. De huidige koorsluiting stamt uit 1775. In de 13de eeuw werd het westwerk vervangen door een half ingebouwde toren, die in 1686 meer vrij kwam te staan toen de beëindiging van het schip iets werd teruggelegd. De westgevel van de toren heeft men toen vernieuwd. In de in 1948-'50 gerestaureerde toren hangt een door L. Haverkamp gegoten klok (1786). De kerk is in 1963-'66 naar plannen van A. Baart jr. gerestaureerd en deels ontpleisterd. Het interieur wordt gedekt door een houten tongewelf met trekbalken, aangebracht in de 16de eeuw bij de vernieuwing van de kap. Op de wand zijn vier geschilderde maniëristische cartouches met bijbelcitaten (1599) zichtbaar. Tot de inventaris behoren een koperen lezenaar (1776) en een doophek en preekstoel (beide 1777), met rococo-snijwerk van Lieuwe Geerts en Yge Rintjes, die ook het rococo-snijwerk van het door A.A. Hinsz gebouwde orgel (1777) maakte. Verder zijn er twee grote rouwborden in Lodewijk XVI-vormen voor de echtelieden Dodenea Jacoba Bergsma-Doitsma (1794) en Pieter Adrianus Bergsma († 1824)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00447> a min:Passage,
