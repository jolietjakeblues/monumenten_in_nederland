        min:soort "lemma" ;
        min:volgnummer 1303 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0149> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Boerderijen. Voorbeelden van kophals-rompboerderijen met onderkelderd voorhuis zijn Poppenwiersterdyk 5, met de jaartalankers ‘1828’, en Hegedyk 10 uit de tweede helft van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01304> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reduzum (Roordahuizum) (gemeente Boarnsterhim)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
