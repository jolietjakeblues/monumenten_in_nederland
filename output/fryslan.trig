        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text "De voorm. Geref. kerk (Uniawei 37) is een zaalkerk uit 1878 met later sterk verbouwde voorgevel met sober neoclassicistische pastorie uit 1878."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0169.php> .

