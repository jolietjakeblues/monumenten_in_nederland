        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "De voorm. Doopsgez. kerk (Hoofdstraat 12) is een driezijdig gesloten zaalkerk, gesticht in 1807. De kosterij aan de voorzijde is rond 1935 vernieuwd. De kerk verloor in die tijd zijn functie en werd als schuur in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00359> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blije (Blija) (gemeente Ferwerderadiel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
