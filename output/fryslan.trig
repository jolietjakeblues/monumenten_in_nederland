        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0140> ;
        schema:name "Oudeschoot (Aldskoat) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text "Streekdorp, ontstaan in de late middeleeuwen en tot 1934 hoofdplaats van de grietenij Schoterland. Door de aanleg van de weg van Zwolle naar Leeuwarden in 1828 kreeg het dorp een kruisvormige plattegrond. Na de Tweede Wereldoorlog is Oudeschoot deel gaan uitmaken van Zuid-Heerenveen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0140.php> .

