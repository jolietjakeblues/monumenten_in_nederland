        schema:name "Harich (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Dorp, ontstaan op de hogere zandgronden en voor het eerst vermeld in de 12de eeuw. De dorpskern ligt rond de kerk. De verspreide bebouwing van de buurten Westerein en Frisbuorren strekt zich in zuidwestelijke richting uit. Ten oosten van de dorpskern ligt enige agrarische bebouwing aan de Lorbuorren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00712> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harich (gemeente Gaasterlân-Sleat)"@nl ;
        min:adres "Stinsenwei 16" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
