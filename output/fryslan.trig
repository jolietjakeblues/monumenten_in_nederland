        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lippenhuizen (Lippenhuzen) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Lippenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31204> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31859" ;
        min:soort "inleiding" ;
        min:volgnummer 997 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0102> ;
        schema:name "Lippenhuizen (Lippenhuzen) (gemeente Opsterland)"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "De Herv. kerk (De Buorren 30) is een in oorsprong uit 1743 daterende, driezijdig gesloten zaalkerk met houten geveltoren. Het huidige uiterlijk met gepleisterde banden om de rondboogvensters dateert van de herbouw rond 1860. Tot de inventaris behoren een preekstoel (derde kwart 17de eeuw), een herenbank en een door L. van Dam gebouwd orgel (1859)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00998> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lippenhuizen (Lippenhuzen) (gemeente Opsterland)"@nl ;
        min:adres "Buorren 47",
            "Buorren 49" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lippenhuizen (Lippenhuzen) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Lippenhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 998 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0102> ;
        schema:name "Lippenhuizen (Lippenhuzen) (gemeente Opsterland)"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "De openbare lagere school (Buorren 49) is een rond 1905 gebouwde vierklassige middengangschool met onderwijzerswoning (Buorren 47). Het dubbele woonhuis Buorren 65-67 uit circa 1914 is gebouwd in chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00999> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lippenhuizen (Lippenhuzen) (gemeente Opsterland) – Boerderijen"@nl ;
        min:adres "De Buorren 149",
            "Sweachsterwei 7",
            "Tj. Harkeswei 27" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lippenhuizen (Lippenhuzen) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Lippenhuizen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58447>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66197>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66198> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31864",
            "513162",
            "513163" ;
        min:soort "lemma" ;
        min:volgnummer 999 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0102> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "221" ;
        schema:pagination "221-222" ;
        schema:text """Boerderijen. De stelpboerderij Compagnonsfeart 36 werd in 1776 gebouwd voor de erven Albert Tjebbes. De boerderij Buorren 88 heeft een dwars voorhuis uit circa 1910 met jugendstil-details. De uit 1918 daterende kop-rompboerderij Sweachsterwei 2 is uitgevoerd in nieuw historiserende stijl, mogelijk naar plannen van S. de Clercq.

Het voorm. Nieuwe Tolhuis (Sweachsterwei 7) is een eenlaagspand met afgeschuinde hoeken aan de straatzijde, gebouwd rond 1860 ter vervanging van een voorganger aan de andere zijde van de weg.

Het Lippenhuizerverlaat (bij Tj. Harkeswei 27) is het tweede verlaat in de Opsterlandse Compagnonsvaart. De oorspronkelijk in 1736 gebouwde sluis - herbouwd in steen in 1858 - is in 1902 geheel vernieuwd. De sluiswachterwoning (Tj. Harkeswei 27) dateert uit circa 1880.

De watertoren (De Buorren 149) verrees in 1932, vermoedelijk naar ontwerp van E.C. Storm van 's-Gravensande, ingenieur van de N.V. Intercommunale Waterleiding Gebied Leeuwarden. De vierkante bakstenen toren in zakelijk expressionistische stijl heeft een zadeldak en twee betonnen reservoirs."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01000> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lollum (gemeente Wûnseradiel)"@nl ;
