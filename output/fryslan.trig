        min:soort "inleiding" ;
        min:volgnummer 1276 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0145> ;
        schema:name "Peperga (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "255" ;
        schema:pagination "255" ;
        schema:text "Streekdorp, ontstaan in de middeleeuwen langs de (Binnen)weg van Oldemarkt naar Noordwolde. De spoorweghalte uit 1870 (gesloten in 1941) was vooral van belang voor het vervoer van boter uit Oldemarkt en stoelen uit Noordwolde"@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01277> a min:Passage,
            schema:CreativeWork ;
