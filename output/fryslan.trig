        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De Geref. kerk (Buorren 23) is een driezijdig gesloten zaalkerk uit 1892 voorzien van een houten geveltoren met spits. De pastorie (Buorren 25) dateert uit circa 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0189.php> .

