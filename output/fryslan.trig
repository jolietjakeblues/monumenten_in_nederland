        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De Geref. kerk (Tilledijk 16) is een recht gesloten zaalkerk met ingezwenkte houten geveltoren, gebouwd in 1908 in late neorenaissance-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01077> a min:Passage,
