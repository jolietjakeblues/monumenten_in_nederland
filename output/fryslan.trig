        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0079> ;
        schema:name "Hemrik (De Himrik) (gemeente Opsterland)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De Geref. kerk (Binnenwei 8) is een sobere recht gesloten zaalkerk uit 1937. Het grote woonhuis ‘Het Koetshuis’ (Binnenwei 19) is in 1901 gebouwd voor de vervenersfamilie Van der Sluis. Het woonhuis en het naastgelegen koetshuis vertonen neorenaissance-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00783> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hemrik (De Himrik) (gemeente Opsterland) – Boerderijen"@nl ;
        min:adres "Tj. Harkeswei 49" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hemrik (De Himrik) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hemrik" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 783 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0079> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "167" ;
        schema:pagination "167-168" ;
        schema:text """Boerderijen. De kleine hallenhuisboerderij Himrikerpead 4 stamt mogelijk uit de 18de eeuw. Dit geldt ook voor de keuterij Himrikerpaed 1, waarvan het schuurgedeelte met krimp overgaat in het voorhuis.

Het Hemrikerverlaat (bij Tj. Harkeswei 49) is het derde verlaat in de Opsterlandse Compagnonsvaart. De oorspronkelijk in 1755 gebouwde sluis - in steen herbouwd in 1855 - is in 1902 geheel vernieuwd. De ophaalbrug uit circa 1925 is in 1952 van elders overgebracht. De sluiswachterwoning (Tj. Harkeswei 49) dateert uit 1880."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00784> a min:Passage,
