        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Terpdorp, voor het eerst genoemd in 995 en gelegen ten noorden van de Slachtedijk. In de tweede helft van de 19de eeuw heeft de terpbebouwing zich verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00362> a min:Passage,
