        min:soort "inleiding" ;
        min:volgnummer 337 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0025> ;
        schema:name "Blauwhuis (Blauhus) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text "Dorp, waarvan de naam is ontleend aan Het Blauwhuis, de zetel met blauwe dakbedekking van het polderbestuur van het in 1632 drooggelegde Sensmeer. De buurtschap kwam eind 18de eeuw tot ontwikkeling als katholieke enclave en werd rond 1930 enigszins uitgebreid. Pas in 1950 kreeg Blauwhuis de status van dorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00338> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blauwhuis (Blauhus) (gemeente Wymbritseradiel)"@nl ;
        min:adres "Vitusdijk 27" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blauwhuis (Blauhus) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blauwhuis" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 338 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0025> ;
        schema:name "Blauwhuis (Blauhus) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "83" ;
        schema:pagination "83" ;
        schema:text "De R.K. St.-Vituskerk (Vitusdijk 27) is een forse driebeukige basilikale kruiskerk met vijfzijdig gesloten koor, dakruiter, aangebouwde kapellen en een toren van drie geledingen voorzien van een spits met frontalen. Aan de zuidzijde staat tegen het transept een toren met tentdak. De neogotische kerk werd in 1868-'71 gebouwd naar ontwerp van P.J.H. Cuypers, met C.H. Peters als opzichter, en is in 1991 gerestaureerd. Het interieur wordt gedekt door kruisribgewelven op een alternerend stelsel van kolommen en pijlers; de dwarskapellen hebben houten tongewelven. De polychromie van het interieur en de muurschilderingen in koor en sacristie zijn oorspronkelijk. De door atelier Cuypers-Stolzenberg geleverde inventaris, uitgevoerd door Klumpkens, is nog grotendeels aanwezig, zoals het ciboriumaltaar, het triomfkruis en de preekstoel. Uit de bouwperiode dateren ook de gebrandschilderde ramen van J. Nicolas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00339> a min:Passage,
