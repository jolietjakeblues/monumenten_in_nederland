        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opeinde (De Pein) (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Opeinde" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1205 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0132> ;
        schema:name "Opeinde (De Pein) (gemeente Smallingerland)"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "Streekdorp, ontstaan in de middeleeuwen op een zandrug met verspreide bebouwing langs de Lijkweg (nu Kommisjewei). De vaart tussen de Wijde Ee en De Leijen werd in 1883 verbreed. Bij de kruising van vaart en weg ontstond een kleine dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01206> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opeinde (De Pein) (gemeente Smallingerland)"@nl ;
        min:adres "Kommisjewei 25" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opeinde (De Pein) (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Opeinde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23479> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "499273" ;
        min:soort "inleiding" ;
        min:volgnummer 1206 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0132> ;
        schema:name "Opeinde (De Pein) (gemeente Smallingerland)"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "De Herv. kerk (Kommisjewei 25) is een kruiskerk, voorzien van een portaal en een toren van twee geledingen met tentdak. De kerk verrees in 1908 naar plannen van W. te Riele ter vervanging van een voorganger ter plaatse van de huidige begraafplaats. Boven de ingang is een maniëristische gevelsteen (circa 1630) hergebruikt. In de toren hangt een klok uit 1659. Het kerkinterieur heeft een gestukadoorde koepel over de middenruimte. Tot de inventaris behoort een door Bakker & Timmenga gebouwd orgel (1909)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01207> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opeinde (De Pein) (gemeente Smallingerland) – Boerderijen"@nl ;
        min:adres "Nijtap 21",
            "Nijtap 65" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opeinde (De Pein) (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Opeinde" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27114>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39689> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "33987",
            "33988" ;
        min:soort "lemma" ;
        min:volgnummer 1207 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill344>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill345> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0132> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text """Boerderijen. De keuterboerderij Nijtap 3 dateert vermoedelijk uit 1686 en heeft binnen een 19de-eeuwse bedstedewand en een schouw met tegelbekleding. Goede voorbeelden van kop-rompboerderijen zijn: Vrijburg (Nijtap 65), met de jaartalankers ‘1805’, Kommisjewei 7 (circa 1860) en Kommisjewei 161 (1875). De stelpboerderij Kommisjewei 163 dateert uit circa 1860. Het boerderijcomplex Kommisjewei 32-34 bestaat uit een vrijstaande villa met een veestal waar oorspronkelijk twee arbeiderswoningen waren ingebouwd. Het door C.R. de Boer en G.M. van Manen ontworpen complex is in 1928 gebouwd voor J.I. en J.K. Douma.

De winkel annex werkplaats Nijtap 2 is in 1930 gebouwd in zakelijk-expressionistische vormen naar plannen van J. Bosma voor E.C. Hogendijk.

De Alg. begraafplaats (bij Nijtap 21) ontstond circa 1860 rondom de kerk van Opeinde. Toen verrees ook de dubbele houten klokkenstoel met schilddak. De kerk werd in 1909 gesloopt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01208> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oppenhuizen (Toppenhuzen) (gemeente Wymbritseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
