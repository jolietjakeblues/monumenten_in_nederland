        min:soort "inleiding" ;
        min:volgnummer 1208 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0133> ;
        schema:name "Oppenhuizen (Toppenhuzen) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "246" ;
        schema:pagination "246-247" ;
        schema:text "Vaartdorp, ontstaan rond het jaar 1000. Tot circa 1850 bestond het dorp uit een lintbebouwing aan weerszijden van de vaart It Ges. Na de aanleg in 1866-'68 van de weg Sneek-Oppenhuizen - evenwijdig aan It Ges - ontstond bebouwing aan weerszijden van deze weg en groeide Oppenhuizen vast aan Uitwellingerga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0133.php> .

