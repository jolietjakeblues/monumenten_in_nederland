        min:rijksmonumentnummer "15642" ;
        min:soort "lemma" ;
        min:volgnummer 705 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0071> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "149" ;
        schema:pageStart "149" ;
        schema:pagination "149" ;
        schema:text "Poldermolen. De Genezareth Kloosterpoldermolen (Trekweg 8), staand ten zuidoosten van Hallum, is een met riet gedekte achtkantige grondzeiler op veldmuren, voorzien van een vijzel. De in 1850 gebouwde molen bemaalt de polder De Hekjebrêge."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00706> a min:Passage,
