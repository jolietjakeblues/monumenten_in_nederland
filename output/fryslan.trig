        min:hoofdstuk "Steden, dorpen, monumenten › Makkinga (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Makkinga" ;
        min:lemma "Windmolen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1008 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0104> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Windmolen ‘De Weijert’ (Lycklamaweg 15) is een met riet gedekte achtkantige stellingkorenmolen met deels houten en deels stenen onderbouw in de vorm van een schuur. De oorspronkelijk als houtzaagmolen in Gorredijk gebouwde molen is in 1925 voor W. Zeephat overgebracht naar de huidige plaats en in 1983-'84 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01009> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Makkinga (gemeente Ooststellingwerf) – Elsloo"@nl ;
        min:adres "Hoofdweg 42" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Makkinga (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Makkinga" ;
        min:lemma "Elsloo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10285>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57570> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31720",
            "514113" ;
        min:soort "lemma" ;
        min:volgnummer 1009 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0104> ;
        schema:name "Elsloo"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "222" ;
        schema:pagination "222-223" ;
        schema:text "Elsloo. Streekdorp ten zuiden van Makkinga op de splitsing van de Buitenweg en de Peperstraat. De Herv. kerk (Hoofdweg 42) is een recht gesloten zaalkerk met jugendstil-elementen, uitgebouwde kamer en dakruiter, gebouwd in 1913 ter plaatse van een voorganger uit 1632. De dubbele houten klokkenstoel met schilddak is in 1987 vernieuwd en heeft een 15de-eeuwse klok en een klok uit 1953. Interessante boerderijen zijn de kop-rompboerderij Hoofdweg 54, waarvan het gepleisterde voorhuis is voorzien van de jaartalankers ‘1684’, en de naastgelegen boerderij Hoofdweg 54a, een kleine woudboerderij met krimp, vermoedelijk uit de eerst helft van de 19de eeuw. De poldermolen ‘Vesuvius’ in het natuurgebied de Stobbepoel is een houten paaltjasker met tonmolen, gebouwd rond 1900 door R.W. Dijksma. Hij is in 1977-'78 gerestaureerd en in 1987 naar zijn huidige plaats overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0104.php> .

