        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "De kerk bevat een door E. Leichel gebouwd orgel (1878). De voorm. pastorie (Grote Buren 17) is een eclectisch pand uit circa 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0146.php> .

