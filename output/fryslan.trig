        schema:name "Buitenpost (Bûtenpost) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "Op het kerkhof bevinden zich onder meer omhekte stenen voor notaris G. de Jong Posthumus, een grafsteen met molen voor H. Kuipers († 1828) en een omhekt grafperk met zerken voor leden van de familie Kuipers-Siccama."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0034.php> .

