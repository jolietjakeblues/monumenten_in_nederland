        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72959>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72960> ;
        min:provincie "Fryslân" ;
