        schema:name "Echten (Ychten) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "Het woonhuis Hoofdweg 2 is een gedeeltelijk gepleisterd eenlaagspand uit 1925, voorzien van een schilddak met diverse steekkappen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0054.php> .

