        min:hoofdstuk "Steden, dorpen, monumenten › Nij Beets (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nij Beets" ;
        min:lemma "Kerken" ;
