        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "De Doopsgez. kerk (Voorstraat 44) is een recht gesloten zaalkerk uit 1904 voorzien van een geveltoren met sierspant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01710> a min:Passage,
