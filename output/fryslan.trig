        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ee (Ie) (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ee" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 593 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill161> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0055> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "126" ;
        schema:pageStart "126" ;
        schema:pagination "126" ;
        schema:text "Woonhuizen. In opzet mogelijk nog 18de-eeuws is het dwarse eenlaagspand Humaldawei 13. Vergelijkbaar, maar vroeg-19de-eeuws is Grutte Loane 9. Een diepe variant is het huis Grutte Loane 11, met in de nokgevelanker de datering ‘1804’. Het dwarse huis Omgong 4, met souterrain en beletage, werd rond 1840 gebouwd. Uit circa 1870 dateert het neoclassicistische middenganghuis Grutte Loane 2. Het van gemetselde versieringen voorziene huis Uniastrjitte 24 kwam rond 1905 tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0055.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00594> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ee (Ie) (gemeente Dongeradeel) – Boerderijen"@nl ;
