        min:hoofdstuk "Steden, dorpen, monumenten › Rinsumageest (Rinsumageast) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Rinsumageest" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1325 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0154> ;
        schema:name "Rinsumageest (Rinsumageast) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Tot de inventaris behoren twee vermeldenswaardige zerken voor de geslachten Tjaarda (circa 1600) en Aylva (1618), een 19de-eeuwse preekstoel en een door Bakker & Timmenga gebouwd orgel (1892). Aan de oostzijde van de zuiderbeuk bevindt zich een epitaaf in vroegerenaissance vormen voor Syds Tjaarda († 1545) en Moedt van Sythiema († 1557)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01326> a min:Passage,
            schema:CreativeWork ;
