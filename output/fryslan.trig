        min:hoofdstuk "Steden, dorpen, monumenten › Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Kollumerzwaag" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 907 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0097> ;
        schema:name "Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "Streekdorp, gelegen op een keileemrug aan de rand van de hoger gelegen pleistocene gronden (Zwaag). Deze rug diende in de 11de of 12de eeuw als ontginningsas. Ten noorden van de langgerekte dorpsbebouwing (Foarwei) is na de Tweede Wereldoorlog een uitbreidingswijk tot stand gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00908> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        min:adres "Foarwei 141" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Kollumerland en Nieuw Kruisland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Kollumerzwaag" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57241> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "23747" ;
        min:soort "inleiding" ;
        min:volgnummer 908 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0097> ;
        schema:name "Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Herv. kerk (Foarwei 141) is een eenbeukige kerk met driezijdig gesloten koor en een ongelede zadeldaktoren. Tegen de 12de eeuwse toren werd rond het midden van die eeuw een schip gebouwd. In de 15de eeuw kwam het huidige koor tot stand. In de 16de eeuw heeft men laat-gotische ingangen aangebracht met een spitsboognis gevat in een rechthoekig veld. De in 1872 gewijzigde torentop is bij de kerkrestauratie in 1960, naar plannen van A. Baart jr., aangepast. In de toren hangt een door Johan Borchhardt gegoten klok (1769). Het kerkinterieur wordt gedekt door een houten tongewelf (1888). Tot de inventaris behoren een eenvoudige preekstoel (circa 1800), een doophek (1870) en een door Bakker & Timmenga gebouwd orgel (1904)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0097.php> .

