        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "De voorm. Geref. kerk (Flieterpsterdyk 23) is een recht gesloten zaalkerk uit 1896 met houten geveltoren en aangebouwde consistorie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0151.php> .

