        min:hoofdstuk "Steden, dorpen, monumenten › Hijum (gemeente Leeuwarderdeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hijum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 786 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0080> ;
        schema:name "Hijum (gemeente Leeuwarderdeel)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De (Geref.) Bethelkerk (Lege Hearewei 7-9) is een T-vormige kerk uit 1877 met neogotische details en een geveltoren die overgaat in een slanke overhoekse houten dakruiter. Het voorm. station (De Loane 5) is een eenlaags gebouw met een iets uitspringend deel. Het werd in 1900-'01 gebouwd als haltegebouw derde klasse van de Noord-Friesche Locaalspoorwegmaatschappij aan de spoorlijn Leeuwarden-Dokkum (opgeheven in 1936)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00787> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
