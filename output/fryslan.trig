        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordwolde (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Noordwolde" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1146 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0124> ;
        schema:name "Noordwolde (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Dorp, ontstaan in de middeleeuwen aan de Drentse kant van de Lindevallei. Op de kruising van de Heerenweg (nu Hoofdstraat) en de in 1642 gegraven Noordwolder Sloot (later Kolonievaart) ontstond een kern die vanwege de turfwinning uitgroeide en tot in de 19de eeuw de hoofdplaats van Weststellingwerf was. Na het midden van de 19de eeuw verschoof de werkgelegenheid naar rietvlechterijen, mandenmakerijen, stoelenfabricage (opgericht 1873) en later rotanverwerking. In 1914 opende de stroomtram Oosterwolde-Steenwijk. Na de Tweede Wereldoorlog is Noordwolde vooral aan de zuidzijde uitgebreid en heeft men de Kolonievaart gedempt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01147> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordwolde (gemeente Weststellingwerf)"@nl ;
        min:adres "Hoofdstraat Oost 55",
            "Hoofdstraat Oost 57" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordwolde (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Noordwolde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62037> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38863" ;
        min:soort "inleiding" ;
        min:volgnummer 1147 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill333> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0124> ;
        schema:name "Noordwolde (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De Herv. kerk (Hoofdstraat Oost 57) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1639-'40 ter plaatse van een laat-gotische voorganger, waarvan mogelijk nog een deel van de westmuur resteert. De kerkkap stamt uit 1639. Na een verbouwing en vergroting in 1853 werd in 1874 de geveltoren toegevoegd. Bij de restauratie in 1966 heeft men het stucgewelf uit 1853 vervangen door een nieuw houten gewelf. Tot de inventaris behoren een 17de-eeuwse preekstoelkuip, een 18de-eeuwse afscheiding tussen schip en portaal en een door L. van Dam & Zn. gebouwd orgel (1876). Op het kerkhof staat een 17de-eeuwse Schellinger stoepsteen, hergebruikt als grafsteen. De pastorie (Hoofdstraat Oost 55) dateert uit 1868."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0124.php> .

