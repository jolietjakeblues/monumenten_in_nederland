        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woudsend (Waldsein) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Woudsend" ;
        min:lemma "Indijk (Yndyk)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1694 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0206> ;
        schema:name "Indijk (Yndyk)"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Indijk (Yndyk). Gehucht ten westen van Woudsend. Op de Alg. begraafplaats (Indijk ong.) staat een enkele houten klokkenstoel met helmdak, gebouwd in 1978 ter vervanging van een in 1949 omgewaaide voorganger. Erin hangt een mogelijk 13de-eeuwse klok. De boerderij Indijk 13 is een koprompboerderij uit 1792 met onderkelderd voorhuis en een gevel met Lodewijk XV-voluten. Het stalgedeelte is grotendeels vernieuwd in de jaren dertig van de 20ste eeuw. Het interieur bevat 18de-eeuwse betimmeringen en twee schoorsteenmantels met tegeltableaus."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0206.php> .

