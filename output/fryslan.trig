        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41981> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "33985" ;
        min:soort "lemma" ;
        min:volgnummer 1229 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0136> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text """Woonhuizen. Het diepe pand Buorren 19 heeft mogelijk een 18de-eeuwse oorsprong. Het pand kreeg recent een nieuwe voorgevel. Mounehoek 4 werd in 1908 met jugendstil-vormen gebouwd als molenaarshuis. Van de in 1908 gebouwde stellingmolen resteert de romp en een uit 1918 stammend pakhuis.

De Blauwe steen (bij Aldegeasterdyk 30) is een omhekte granieten kei, die al uit 1664 bekend is en die de grens tussen Oudega en Nijega markeert."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01230> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudega (Aldegea) (gemeente Smallingerland) – Nijega (Nyegea)"@nl ;
        min:adres "Hearrewei 1",
            "Hearrewei 3",
            "Kommisjewei 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudega (Aldegea) (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
