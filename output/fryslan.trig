        min:soort "inleiding" ;
        min:volgnummer 284 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0018> ;
        schema:name "Bakhuizen (Bakhuzen) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "Op het kerkhof (1900) bevinden zich onder meer een Calvarieberg met kruisiginggroep en enkele kruisvormige graftekens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00285> a min:Passage,
