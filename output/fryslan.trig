        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Earnewâld (Eernewoude) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Earnewâld" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 543 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0049> ;
        schema:name "Earnewâld (Eernewoude) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "De Herv. kerk (Dominee Offerhausweg 1) is een in 1794 gebouwde, driezijdig gesloten zaalkerk voorzien van een ongelede toren met omlijste ingangspartij en ingesnoerde spits. In de toren hangt een door Geert van Wou gegoten klok (1500). Tot de kerkinventaris behoren een barokke preekstoel (1699) en een door L. van Dam & Zn. gebouwd orgel (1874). Op het kerkhof liggen onder meer twee 18de-eeuwse zerken en een gedenksteen voor Indiëstrijder R. Kiers († 1947)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0049.php> .

