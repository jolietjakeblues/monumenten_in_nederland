        min:gemeenteInBoek "Kollumerland en Nieuw Kruisland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kollum (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Kollum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40068> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "23730" ;
        min:soort "inleiding" ;
        min:volgnummer 900 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0096> ;
        schema:name "Kollum (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "185" ;
        schema:pageStart "185" ;
        schema:pagination "185" ;
        schema:text "Het raadhuis (Voorstraat 46) is in 1809 als herenhuis gebouwd voor W.H. van Sytzama. Het onderkelderde deftige pand heeft een middenrisaliet met afsluitend fronton en een pronkrisaliet en fraaie deur in empire-vormen. Van 1836 tot 1895 was het huis in het bezit van H. Eskes, waarna het als raadhuis werd ingericht. In de gestucte gang bevinden zich onder meer gestucte panelen met voorstellingen van de seizoenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00901> a min:Passage,
