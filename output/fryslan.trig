        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill233> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0086> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Boerderijen. Interessante boerderijen met voorhuis en schuur met dwarsdeel zijn: Dorpsstraat 94 (voorhuis 1750), 78 (1865), 89 (1874), 51 (1881), 37 (1888) en Kooiweg 3 (1889). De schuur van de 19de-eeuwse boerderij Dorpsstraat 23 is voorzien van een ‘schúntsje’ (dakvormige beeïndiging van de dwarsdeeldeuren). De stelpboerderij Aest Kaemerke (Dorpsstraat 65) dateert uit circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00827> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoorn (Hoarne) (gemeente Terschelling) – Oosterend (Aasterein)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Terschelling" ;
        min:gemeenteInBoek "Terschelling" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terschelling_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoorn (Hoarne) (gemeente Terschelling)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hoorn" ;
        min:lemma "Oosterend (Aasterein)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 827 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0086> ;
        schema:name "Oosterend (Aasterein)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Oosterend (Aasterein). Dit gehucht ten oosten van Hoorn is ontstaan in de late middeleeuwen nabij de stinswier van de in de 16de eeuw gesloopte Popmastins uit de 14de eeuw. Interessant zijn de boerderijen Oosterend 31 (1878), Oosterend 21 (1879) - met schúntsje - en de stelpboerderij Oostereind 29 (1896). De gedenksteen aan de Hoofdweg (bij de Dwarsdijk) is geplaatst in 1910 ter herdenking van de verharding van deze dwars over het eiland lopende weg. Naar ontwerp van J.M. Krijger jr. is de steen uitgevoerd met jugendstil-details. De aan de Stuifdijk op de Boschplaat gelegen bunker is een overblijfsel van de rond 1943 gebouwde Duitse Marineflakbatterie Terschelling Ost."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00828> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hurdegaryp" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 828 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0087> ;
        schema:name "Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Langgerekt dorp, ontstaan op een zandrug (Rijp), waarover de in 1528-'31 aangelegde Zwarteweg in 1830 als ‘Grinzer Strjitwei’ naar Groningen werd doorgetrokken. De bebouwing concentreerde zich langs deze weg en bij het in 1866 aangelegde station. De rond 1665 gebouwde Bennemastate werd in 1970 afgebroken. Na de Tweede Wereldoorlog zijn aan de zuidzijde nieuwe woonwijken ontstaan en is Hurdegaryp uitgegroeid tot een forensendorp van Leeuwarden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00829> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)"@nl ;
        min:adres "Rijksstraatweg 54" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hurdegaryp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36604> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35655" ;
        min:soort "inleiding" ;
        min:volgnummer 829 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0087> ;
        schema:name "Hurdegaryp (Hardegarijp) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "174" ;
        schema:pagination "174-175" ;
        schema:text "De Herv. kerk (Rijksstraatweg 54) is een driezijdig gesloten zaalkerk met houten geveltoren, blijkens het opschift boven de ingang in 1711 gebouwd door timmerman Eilof Johannes uit Wyns. Tot de inventaris behoren een rijk gesneden preekstoel met corintische zuilen en evangelistensymbolen (begin 18de eeuw), een 17de- en een 18de-eeuwse herenbank - de laatste met het wapen van Roorda - en een door P. van Oeckelen gebouwd orgel (1879). Verder bevat de kerk enkele oude grafzerken, waaronder die voor Jan van Roorda († 1657) en Watze van Roorda († 1670). Op het kerkhof staat onder meer een kunststenen grafopbouw voor R.J. Wijmenga († 1932)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0087.php> .

