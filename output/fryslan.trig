        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Munnekezijl (Muntsjesyl) (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Munnekezijl" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1098 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill324> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0116> ;
        schema:name "Munnekezijl (Muntsjesyl) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "De Herv. kerk (Methardusstraat 42) is een recht gesloten zaalkerk met opengewerkte geveltoren, gebouwd in 1899 ter vervanging van een 17de-eeuwse voorganger. Het ontwerp met neorenaissance-details is van H.A. Zondag. De kerk bevat een preekstoel uit 1759, gemaakt door Engbert Hendriks, Gabe Freeks en Freek Gabes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0116.php> .

