        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74908>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/74909> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15585",
            "388520" ;
        min:soort "lemma" ;
        min:volgnummer 423 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill117>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill118> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0035> ;
        schema:name "Molens"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "99" ;
        schema:pagination "99-100" ;
        schema:text "Molens. De windmolen De Zwaluw (Mounewei 17) is een hoge met riet gedekte achtkantige stellingmolen met gemetselde onderbouw. De molen werd in 1875 herbouwd ter plaatse van een afgebrande korenmolen uit 1826 en fungeert als koren-, pel- en houtzaagmolen. De houtzagerij met drie zaagramen is ondergebracht in een gebouw ten westen van de molen. Daarnaast staat een in 1877 opgetrokken en in 1890 verlengde houtopslagloods met het opschrift ‘K. Steenhuisen en Zonen’. De molen is in 1972 afgebrand en in 1984-'87 herbouwd en gerestaureerd. De poldermolen De Olifant (Wiereweg 20), gelegen ten zuiden van Burdaard, is een met riet gedekte achtkantige grondzeiler op veldmuren; opmerkelijk zijn de drie vijzels (twee uitmalers en een inmaler). De oorspronkelijk in 1856 in Groningen gebouwde molen werd in 1867 overgebracht naar de huidige plaats en fungeerde als in- en uitmaler van de polder De Olifant. De molen is voor het laatst gerestaureerd in 1991."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00424> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Burgum (Bergum) (gemeente Tytsjerksteradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
