        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Jelsum (gemeente Leeuwarderadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jelsum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 849 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0090> ;
        schema:name "Jelsum (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "In opdracht van J.H.J. van Wageningen kreeg het huis in 1905 een nieuwe toegangsbrug met poort. De omringende parkaanleg heeft een door knotlinden beplante oprijlaan en wordt van het dorp gescheiden door een rond 1905 opgetrokken muur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0090.php> .

