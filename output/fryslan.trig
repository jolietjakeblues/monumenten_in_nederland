        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het woonhuis Foarstrjitte 21, gebouwd in 1913 met jugendstil-elementen, heeft een aangebouwd pakhuis voor de toenmalige aardappel- en graanhandel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01121> a min:Passage,
            schema:CreativeWork ;
