        min:soort "lemma" ;
        min:volgnummer 228 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0010> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Boerderijen. Bij het kerkhof staan enkele aardige boerderijen, zoals de koprompboerderij Fjildwei 17 (circa 1850), met onderkelderd voorhuis, en de stelpboerderij Fjildwei 19 (circa 1880) met inrit naast het woongedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00229> a min:Passage,
