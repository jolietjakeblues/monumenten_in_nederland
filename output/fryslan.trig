        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28579" ;
        min:soort "lemma" ;
        min:volgnummer 355 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0027> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Boerderijen. De kop-hals-rompboerderij Terphûs (Blessumerdyk 2) uit 1823 heeft een onderkelderd voorhuis met zadeldak tussen topgevels bekroond door schoorstenen met borden. Van hetzelfde type is de boerderij Buorren 3, met een woonhuisgedeelte uit circa 1850 en een opvallend hoge schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00356> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blije (Blija) (gemeente Ferwerderadiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blije (Blija) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blije" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 356 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0028> ;
        schema:name "Blije (Blija) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van onze jaartelling op een kwelderwal. Bij de ten noorden hiervan kruisende wegen lag de (later gedempte) haven van de Blijaër Vaart. Daar en aan de Voorstraat concentreerde zich de bebouwing. Eind 19de eeuw is de lage terp grotendeels afgegraven, tot aan het ringvormige pad rondom het kerkhof. Na de Tweede Wereldoorlog is Blije aan de noord- en de zuidzijde enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00357> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blije (Blija) (gemeente Ferwerderadiel)"@nl ;
        min:adres "Voorstraat 3",
            "Voorstraat 31" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blije (Blija) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blije" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53004> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15592" ;
        min:soort "inleiding" ;
        min:volgnummer 357 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0028> ;
        schema:name "Blije (Blija) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "84" ;
        schema:pagination "84-85" ;
        schema:text "De Herv. kerk (Voorstraat 3), oorspronkelijk gewijd aan St. Nicolaas, is forse een eenbeukige kerk met vijfzijdig gesloten koor en een ongelede zadeldaktoren. De romaanse toren met overwelfde benedenruimte verrees in de 13de eeuw, kreeg vermoedelijk in 1741 de huidige beëindiging en werd in 1949-'52 gerestaureerd. Rond 1540 kwam de huidige laat-gotische kerk met steunberen tot stand op de plaats van een voorganger. Het interieur wordt gedekt door een houten tongewelf uit 1858. Tot de vroeg-18de-eeuwse inventaris behoren een preekstoel met Lodewijk XIV-motieven, twee overhuifde herenbanken en enkele knopbanken; verder is er een door L. van Dam & Zn. gebouwd orgel (1870). Belangrijk is de in 1552 door Vincent Lucas in vroege renaissance-vormen gehakte portretzerk voor Janke van Unema († 1540) en Tet Wyboltsma († 1532). Het overlijden van Tet Wyboltsma was waarschijnlijk aanleiding tot de herbouw van de kerk. Verder liggen in de kerk een kinderzerk in gotische vormen voor Douwe van Aebinga († 1556) en een zerk voor Bartel Tyaerda van Starkenborg († 1637). De voorm. pastorie (Voorstraat 31) is een eclectisch middenganghuis uit 1871."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0028.php> .

