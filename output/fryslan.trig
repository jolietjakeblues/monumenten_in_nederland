        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "De voorm. openbare lagere school (Skoallestrjitte 17) is rond 1890 in eclectische vormen gebouwd als een vierklassige gangschool met gedraaide klassen op de kop. De bijbehorende onderwijzerswoning (Skoallestrjitte 19) is een eclectisch middenganghuis. De school in nu deels in gebruik als brandweergarage."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01040> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marssum (gemeente Menaldumadeel)"@nl ;
        min:adres "Slotleane 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marssum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marssum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17299> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28623" ;
        min:soort "inleiding" ;
        min:volgnummer 1040 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill313> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "227" ;
        schema:pagination "227-228" ;
        schema:text "De Heringastate of het Poptaslot (Slotleane 1), gelegen op een omgracht terrein, is een deels onderkelderd dwars pand met een zadeldak tussen trapgevels, een traptoren en een ingangstoren met een uivormige spits. De gevels zijn opgetrokken met afwisselend lagen gele en rode baksteen. De state werd in de eerste helft van de 16de-eeuw gebouwd voor Sakser van Camstra van Heringa. Bij een verbouwing in 1631, in opdracht van Tjalling van Eysinga, heeft men de ingangstoren toegevoegd. Henricus Popta kocht de state in 1687 en liet dit bezit bij zijn dood in 1712 na aan het door hem in het jaar daarvoor gestichte Poptagasthuis. De voogden van dit gasthuis lieten het ‘Poptaslot’ rond 1780 moderniseren en uitbreiden met een vertrek ter plaatse van het woonhuis van de naastgelegen boerderij. Het resterende deel van die boerderij is in de 19de eeuw vernieuwd. Het Poptaslot is in 1906-'08 grondig gerestaureerd naar plannen van J.F.L. Frowein. Kort daarna is een serre in galerijvorm aangebouwd. Het Poptaslot is thans een museum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01041> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marssum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marssum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marssum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1041 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "Het interieur bevat enkele belangrijke 17de-eeuwse onderdelen in maniëristische stijl, zoals een doorgang bekroond door een zandstenen fries, een doorgang en een schouw geflankeerd door beelden in zandsteen in een later als voogdenkamer ingericht vertrek en voorts enkele bedsteden. De voogdenkamer heeft bij de restauratie een inrichting in Lodewijk XVI-stijl gekregen met een schoorsteenstuk van Frans Jurjen Swart (1782)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01042> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marssum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marssum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marssum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1042 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill314> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "Voor het woongebouw staat een poortgebouw met traptorentje. De sobere onderbouw dateert uit de 16de eeuw, de rijk versierde bovenbouw in maniëristische stijl uit 1631. De verhoogde halsgevel is voorzien van gekoppelde pilasters, frontons, cartouches en friezen met de wapens van de familie Heringa-Eysinga. Boven de doorgang bevindt zich een (later toegevoegd) omlijst wapenschild met het Poptawapen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01043> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marssum (gemeente Menaldumadeel)"@nl ;
        min:adres "Hegedyk 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marssum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marssum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14423> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28620" ;
        min:soort "inleiding" ;
        min:volgnummer 1043 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "Het Poptagasthuis (Hegedyk 6), in 1711 door Henricus Popta gesticht, bestaat uit vier eenlaags vleugels om een binnenhof. Oorspronkelijk waren er 26 eenkamerwoningen. De ingangsvleugel heeft een middenpartij met halsgevel en poortdoorgang met dubbele stoep. De in Lodewijk XIV-stijl rijk gebeeldhouwde zandstenen omlijsting met corintische pilasters wordt bekroond door twee allegorische vrouwenfiguren en het Poptawapen. Rechts en links bevinden zich dakerkers met versierde halsgevels en ook aan de hofzijde van de oost- en westvleugel zitten halsgevels met gebeeldhouwde klauwstukken. De lange gevel langs de Buorren heeft een kleiner zandstenen toegangspoortje met corintische pilasters, festoenen en siervazen. Aan deze zijde kreeg het gasthuis in 1852 een uitbreiding met een rij woningen. In 1952 zijn de eenkamerwoningen intern omgevormd tot grotere wooneenheden en is het washuis verbouwd tot ketelhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01044> a min:Passage,
            schema:CreativeWork ;
