        schema:name "Scholen"@nl ;
        schema:pageEnd "86" ;
        schema:pageStart "86" ;
        schema:pagination "86" ;
        schema:text "Scholen. De voorm. openbare lagere school (Waltawei 20) is in 1880 gebouwd als een tweeklassige middengangschool. De voorm. Chr. lagere school (Waltawei 9), gebouwd in 1922 als tweeklassige middengangschool, vertoont expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00365> a min:Passage,
