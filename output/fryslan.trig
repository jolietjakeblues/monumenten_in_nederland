        min:soort "inleiding" ;
        min:volgnummer 491 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0043> ;
        schema:name "Dongjum (Doanjum) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Het voorm. station (Hovensreed 1) is een bescheiden eenlaagspand met neorenaissance-elementen, opgetrokken in 1902 als haltegebouw derde klasse van de Noord-Friesche Locaalspoorwegmaatschappij (NFLS) aan de spoorlijn Leeuwarden-Stiens-Harlingen (opgeheven in 1936)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00492> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongjum (Doanjum) (gemeente Franekeradeel) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongjum (Doanjum) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dongjum" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 492 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0043> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Boerderijen. In de omgeving van Dongjum liggen enkele interessante boerderijen. De kop-hals-rompboerderij Tzummarumerweg 30 heeft een onderkelderd voorhuis uit circa 1850 met zadeldak tussen topgevels en een omgaande kroonlijst. In de lange zijgevel bevindt zich een omlijste ingang met dubbele stoep. Rond 1870 gebouwd is de stelpboerderij Hovensreed 3, voorzien van een rieten dak met uileborden en een door fronton en hoekpilasters omlijst middenrisaliet in de voorgevel. De boerderij Hovensreed 10 heeft een neoclassicistisch, deels onderkelderd dwars voorhuis uit 1883."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00493> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongjum (Doanjum) (gemeente Franekeradeel) – Boer"@nl ;
        min:adres "Miedweg 2",
            "Oude Weg 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongjum (Doanjum) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dongjum" ;
        min:lemma "Boer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18482>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45663> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15849",
            "15850" ;
        min:soort "lemma" ;
        min:volgnummer 493 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0043> ;
        schema:name "Boer"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Boer. Terpdorp gelegen ten noordoosten van Dongjum. De voorm. Herv. kerk (Oude Weg 1), oorspronkelijk gewijd aan Maria, is een gepleisterde eenbeukige kerk met vijfzijdig gesloten koor en een ongelede toren met ingesnoerde spits. De van oorsprong vermoedelijk vroeg-12de-eeuwse kerk is in de 16de eeuw verhoogd en voorzien van een gotisch koor met steunberen en een toren. In de nadien beklampte toren hangt een door Willem Wegewaert gegoten klok (1561). Tegen de zuidgevel van het schip staat in rode zandsteen uitgevoerd classicistisch ingangsportaal uit 1664, gesierd met schilddragende leeuwen en vaas. Dit portaal is afkomstig van de nabijgelegen, gesloopte Elgersmastate. Het interieur wordt gedekt door een 17de-eeuws tongewelf. Tot de inventaris behoren een rijk versierde 17de-eeuwse preekstoel, gemerkt I.v. Kingma, met doophek, een scheidingswand met deuren en een doodsbaar (1731). Op het verhoogd gelegen kerkhof met voornamelijk 19de-eeuwse graven bevindt zich de grafkelder van de familie Stinstra-Banga met het graf van Joannes Stinstra († 1842). De voorm. pastorie (Miedweg 2) is een van oorsprong mogelijk 16de- of vroeg 17de-eeuwse onderkelderde woning, opgetrokken met grote baksteenmoppen. De topgevel is voorzien van kloostervensters en duivengaten. Inwendig bevinden zich balken op gesneden sleutelstukken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Donkerbroek (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Donkerbroek" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 494 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0044> ;
        schema:name "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Streekdorp, mogelijk in de 13de eeuw gesticht aan de weg van Heerenveen naar Assen. Met het graven van de Opsterlandse Compagnonsvaart ontstond op de kruising in 1789 een eerste brug. Donkerbroek is nooit een veenkoloniaal dorp geworden, wel verrees rond 1900 aan de vaart enige industrie. Na de Tweede Wereldoorlog kwam in het zuidoosten een woonwijk tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00495> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        min:adres "G. Wolter Smitweg 5" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Donkerbroek (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Donkerbroek" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 495 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0044> ;
        schema:name "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "De Herv. kerk (G. Wolter Smitweg 5) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1714 ter vervanging van een oudere, aan St. Laurentius gewijde kerk. Daarvan zijn delen van het muurwerk bewaard gebleven. De geveltoren dateert uit 1860. De door een gebeeldhouwde wapensteen uit 1714 bekroonde ingang is in 1918 hersteld. Tot de inventaris behoren een preekstoel uit circa 1700 en een vermoedelijk door Matthijs Verhofstad gebouwd orgel (1720), dat in 1879 is overgebracht uit de R.K. kerk van Jutphaas (Nieuwegein). Op het kerkhof staat een dubbele houten klokkenstoel met schilddak, herbouwd in 1802 en vernieuwd in 1984. Daarin hangen een klok uit circa 1300 en een door Geert van Wou en Johan Schonenborch gegoten klok (1520)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00496> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        min:adres "Herenweg 72" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Donkerbroek (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Donkerbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15056> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "460746" ;
        min:soort "inleiding" ;
        min:volgnummer 496 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0044> ;
        schema:name "Donkerbroek (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "De Geref. kerk (Herenweg 72) is een T-vormige kerk uit 1912 met rationalistische details, dakruiter en Lucas IJsbrandpannen. De kerk bevat een door Bakker & Timmenga gebouwd orgel (1920), waarin delen van een voor de kerk van Oppenhuizen door A. van Gruisen gebouwd orgel (1821) zijn hergebruikt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00497> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Donkerbroek (gemeente Ooststellingwerf) – Huis Ontwijk"@nl ;
        min:adres "Vaart Westzijde 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Donkerbroek (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Donkerbroek" ;
        min:lemma "Huis Ontwijk" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 497 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0044> ;
        schema:name "Huis Ontwijk"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Huis Ontwijk (Vaart Westzijde 1) is een breed eenlaags herenhuis gebouwd kort na 1845 in opdracht van R.L. Fruitier de Talma en J.W. Bergsma. Het gepleisterde neoclassicistische huis heeft een ingangspartij met blokbepleistering en fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00498> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Donkerbroek (gemeente Ooststellingwerf) – Woonhuizen"@nl ;
        min:adres "'t West 21",
            "Fruitier de Talmaweg 15",
            "Fruitier de Talmaweg 16",
            "Herenwal 2",
            "Vosseheer 7" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Donkerbroek (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Donkerbroek" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 498 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill137> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0044> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "112" ;
        schema:pagination "112-113" ;
        schema:text """Woonhuizen. Het zogeheten Veerhuis (Herenwal 2) is een gepleisterde eenlaags brugwachterwoning uit 1848. De in 1865 gebouwde arbeiderswoning Vaart WZ 6 is een mooi voorbeeld van een klein woonhuis met krimp; de schuur is later toegevoegd. De uit 1918 daterende directeurswoning (Vosseheer 7) van de voorm. zuivelfabriek vertoont chaletdetails.

De boerderij G. Wolter Smitweg 5 heeft een dwars geplaatst en gepleisterd eenlaags voorhuis met eclectische details uit circa 1850.

Het voorm. tolhuisje ('t West 21) dateert uit circa 1860; het diepe woonhuis gaat via een krimp over in een rijziger voorhuis.

De voorm. coöperatieve aankoopvereniging ‘Friesland’ (Fruitier de Talmaweg 15) is een complex van diverse bouwvolumes met rationalistische en jugendstil-elementen, gebouwd in 1911 naar plannen van M.O. Meek. De directeurswoning (Fruitier de Talmaweg 16) dateert uit 1935, de silo uit circa 1955."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00499> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drachten (gemeente Smallingerland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drachten (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Drachten" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 499 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0045> ;
        schema:name "Drachten (gemeente Smallingerland)"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "Dorp met stedelijk karakter (vlekke), ontstaan op de kruising van de weg van Heerenveen naar Dokkum en de in 1641 in opdracht van Passchier Hendriks Bolleman aangelegde Drachtster Compagnonsvaart. Deze vaart werd vanaf het Gaasterdiep gegraven door de zandrug waarop de middeleeuwse nederzettingen Noorder- en Zuider-Drachten lagen. Bij de veenrand aan de oostzijde splitste de vaart in een Noorder- en een Zuiderdwarsvaart, van waaruit het veen in oostelijke richting werd ontgonnen. Het nieuwe, kruisvormige dorp kreeg in 1743 een kerk ter vervanging van de in dat jaar afgebroken kerken te Zuider-Drachten (gesticht 1148) en Noorder-Drachten (gebouwd 1541)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00500> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drachten (gemeente Smallingerland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drachten (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Drachten" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 500 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0045> ;
        schema:name "Drachten (gemeente Smallingerland)"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "In de Franse tijd werd Drachten de hoofdplaats van Smallingerland. Van economisch belang waren de molens, de kalkovens en de tabaksverwerking. In de 20ste eeuw zette de groei van Drachten door. Rond de Rijks-HBS (1919) kwam een nieuwe wijk tot ontwikkeling op basis van een uitbreidingsplan uit 1918 van G. Stapensea en in 1938 volgde een stratenplan voor een uitbreiding in westelijke richting. Het door P. van Loo opgezette uitbreidingsplan uit 1940 vormde de basis voor enkele na-oorlogse woonwijken. Deze kwamen in eerste instantie tot stand rond de oude kern, daarna ten oosten van de (gedempte) Dwarsvaart (De Wiken, De Venen), in het zuidwesten (De Drait) en in het noordwesten (De Swetten, De Folgeren). Vooral na de komst van de Philips scheerapparatenfabriek (1950) groeide Drachten in snel tempo uit tot de tweede plaats van Friesland. Deze ontwikkeling leidde in de dorpskern tot een verkeersdoorbraak bij de kerk (1955), een gedeeltelijke demping van de Drachtstervaart (1963) en herstructurering van het gebied rond het Van Knobelsdorffplein, waar een nieuw raadhuis werd gebouwd (1984-'86)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00501> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drachten (gemeente Smallingerland)"@nl ;
        min:adres "Zuidkade 19" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Smallingerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Drachten (gemeente Smallingerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Drachten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36517> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "33978" ;
        min:soort "inleiding" ;
        min:volgnummer 501 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill138> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0045> ;
        schema:name "Drachten (gemeente Smallingerland)"@nl ;
        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "De Herv. kerk (Zuidkade 19) is een T-vormig gebouw met houten geveltoren. De rijke bekroning in Lodewijk XIV-stijl boven de ingang draagt de wapens van de stichters van deze in 1743 voltooide kerk. Het gebouw is in 1952 gerestaureerd. Het interieur wordt gedekt door een gestuct houten tongewelf. Tot de inventaris behoren een fraai gesneden preekstoel in Lodewijk XV-stijl (1743), een door C. Kooijstra vervaardigde herenbank (1744), een herenbank met kuifstuk in Lodewijk XIV-stijl (1750), vier 18de-eeuwse grafzerken en een door J.A. Hillebrand gebouwd orgel (1820; uitgebreid in 1986). Van de vier gebrandschilderde ramen (1743; gerestaureerd in 1916) zijn er drie gemaakt door Jurjen Staak en één door Ype Staak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00502> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Drachten (gemeente Smallingerland)"@nl ;
        min:adres "Zuiderbuurt 26" ;
