        min:adres "Pepergaweg 12" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peperga (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Peperga" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62250> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38872" ;
        min:soort "inleiding" ;
        min:volgnummer 1277 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill358> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0145> ;
        schema:name "Peperga (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "255" ;
        schema:pagination "255-256" ;
        schema:text "De Herv. kerk (Pepergaweg 12), oorspronkelijk gewijd aan St. Nicolaas, is een driezijdig gesloten zaalkerk met een rijzige toren van drie geledingen met achtkantige bakstenen lantaarn en ingezwenkte naaldspits. De toren van de in opzet laat-middeleeuwse kerk werd - volgens een gedenksteen in rode zandsteen - in 1537 verhoogd met een derde geleding en een lantaarn in laat-gotische vormen; de door kruisbloemen beëindigde pinakels geven de toren een rijk silhouet. De kerk zelf werd in 1810 herbouwd, mogelijk met gebruik van oudere muurresten. Tot de inventaris behoren een gotische priesterzerk (1510), grafzerken uit 1666 en 1668, een vermoedelijk 17de-eeuwse preekstoel en een orgel uit 1912. Op het kerkhof staat een grafteken met obelisk voor J.B. de Jong († 1918)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01278> a min:Passage,
            schema:CreativeWork ;
