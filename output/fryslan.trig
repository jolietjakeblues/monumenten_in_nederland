        min:adres "Rotstergaastweg 16",
            "Rotstergaastweg 43" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Heerenveen" ;
        min:gemeenteInBoek "Heerenveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerenveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudeschoot (Aldskoat) (gemeente Heerenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oudeschoot" ;
        min:lemma "Nieuweschoot (Nijskoat)" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52284> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21188" ;
        min:soort "lemma" ;
        min:volgnummer 1255 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0140> ;
        schema:name "Nieuweschoot (Nijskoat)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "Nieuweschoot (Nijskoat). Streekdorp ten westen van Oudeschoot aan de in 1840-'41 ter verbinding van de Heerensloot met de Tjonger gegraven Engelenvaart. De Herv. kerk (Rotstergaastweg 43) is een eenbeukige laatgotische kerk met steunberen en een driezijdig gesloten koor. De kerk werd waarschijnlijk pas in de 17de eeuw - maar mogelijk al in de 15de eeuw - uit ouder materiaal opgetrokken. Op het kerkhof staat een enkele klokkenstoel met zadeldak uit circa 1930, met daarin een 15de-eeuwse klok. Interessante boerderijen zijn de kop-hals-rompboerderij Rotstergaastweg 95 uit 1861 en de stelpboerderij ‘Masoncounty’ (Rotstergaastweg 16) uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0140.php> .

