        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eastermar (Oostermeer) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Eastermar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67243>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67244> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "512554",
            "512555" ;
        min:soort "inleiding" ;
        min:volgnummer 574 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0052> ;
        schema:name "Eastermar (Oostermeer) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De pastorie (Torenlaan 1) is een middenganghuis met hoger opgaand middendeel en eclectische vormen, gebouwd in 1875 naar plannen van D.D. Duursma. Het in 1924 door J.D. Schuilenga opgetrokken gebouw voor Chr. belangen (Torenlaan 12) heeft een expressief vorm gegeven ingangspartij in de vorm van een torentje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00575> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eastermar (Oostermeer) (gemeente Tytsjerksteradiel) – Woonhuizen"@nl ;
        min:adres "E.M. Beimastrjitte 18",
            "Grote Hornsterweg 16" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eastermar (Oostermeer) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Eastermar" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 575 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0052> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Woonhuizen. Het eenvoudige dwarse eenlaagspand E.M. Beimastrjitte 10 heeft boven de ingang de datering ‘1768’; het eenvoudige diepe eenlaagspand Waltsje 23 draagt de nokanker ‘1814’. De meeste grotere woonhuizen in het dorp hebben aan de achterzijde een schuurgedeelte. Dit geldt zowel voor het forse dorpshuis E.M. Beimastrjitte 46, in de nokanker gedateerd ‘1769’, als de eenlaags huizen E.M. Beimastrjitte 30 en 43, met mogelijk 18de-eeuwse kern. Neoclassicistische vormen hebben de rond 1860 gebouwde rentenierswoningen E.M. Beimastrjitte 2 en 36. Het vergelijkbare Dam Jaarsmahûs (E.M. Beimastrjitte 18) dateert uit circa 1880. De rentenierswoningen Seadwei 6 en Nieuw Stedma (Grote Hornsterweg 16) vertonen veel overeenkomsten. Beide hebben een dwars geplaatst voorhuis met terugliggend portiek en een iets uitgebouwde zijkamer. De eerstgenoemde heeft echter neorenaissance-vormen naar plannen van C.H. Eldering (1907), de andere jugendstil-achtige vormen naar plannen van B.J. Gros (1912)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00576> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eastermar (Oostermeer) (gemeente Tytsjerksteradiel) – Boerderijen"@nl ;
        min:adres "E.M. Beimastrjitte 8",
            "Snakkerbuorren 6",
            "Zwarteweg 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
