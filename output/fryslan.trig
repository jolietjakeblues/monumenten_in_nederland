        min:volgnummer 309 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0022> ;
        schema:name "Beetgum (Bitgum) (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van de jaartelling op een kwelderwal van de Boorneboezem (Middelzee). Tot 1850 lag de bebouwing voornamelijk op en rond de terp, daarna werd er aan de zuidzijde gebouwd. Na de Tweede Wereldoorlog is Beetgum vooral aan de zuidoostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00310> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetgum (Bitgum) (gemeente Menaldumadeel)"@nl ;
        min:adres "Buorren 13" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetgum (Bitgum) (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetgum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45296> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28571" ;
        min:soort "inleiding" ;
        min:volgnummer 310 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0022> ;
        schema:name "Beetgum (Bitgum) (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De Herv. kerk (Buorren 13), oorspronkelijk gewijd aan St. Martinus, is een eenbeukige kerk met vijfzijdig gesloten koor en een aangebouwde consistoriekamer tegen de toren van twee geledingen met ingesnoerde naaldspits. De toren, opgetrokken in gele en rode baksteen en rijk versierd met gekoppelde rondboognissen, dateert uit de 16de eeuw. In de toren hangt een 13de-eeuwse klok (1593). Het schip is in 1669 op initiatief van Isabella Schwartzenberg thoe Hohenlansberg in gotische stijl herbouwd. De zuidgevel heeft twee ingangspoortjes met classicistische zandstenen omlijsting en bevat een gedenksteen. De noordgevel is blind. Tot de 17de-eeuwse inventaris behoren de preekstoel (1673), het doophek, de vrouwenbanken met gesneden wangstukken en de tekstborden. Verder bevat de kerk een fraaie maniëristische zandstenen epitaaf voor Johan Onuphrius Schwartzenberg († 1584) en Maria von Grombach († 1564) - begonnen door Dirck Lieuwes en voltooid rond 1615 door Jelle Claesz. -, een herenbank (18de eeuw) en een door P. van Oeckelen gebouwd orgel (1861)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00311> a min:Passage,
