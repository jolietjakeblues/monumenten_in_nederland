        min:kern "Harlingen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47070> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "20635" ;
        min:soort "inleiding" ;
        min:volgnummer 731 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0074> ;
        schema:name "Harlingen (Harns)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Het voorm. brandspuithuisje (Rozengracht 1) [9] stamt uit 1767 en herbergde volgens het opschrift brandspuit nummer 1. Het kleine pand heeft een hoog schilddak met daar midden op een grote schoorsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00732> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harlingen (Harns)"@nl ;
        min:adres "Noorderhaven 88" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Harlingen" ;
        min:gemeenteInBoek "Harlingen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Harlingen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harlingen (Harns)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Harlingen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 732 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0074> ;
        schema:name "Harlingen (Harns)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "De voorm. beurs (Noorderhaven 88) [10] is een breed pand uit circa 1870, opgetrokken in neoclassicistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00733> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harlingen (Harns)"@nl ;
        min:adres "Scheerstraat 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
