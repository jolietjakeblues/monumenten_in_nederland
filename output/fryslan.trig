        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "De voorm. Doopsgez. kerk (Fermaningsteech 1), is een eenvoudige, driezijdig gesloten zaalkerk, gebouwd in 1858 naar ontwerp van S. Oppedijk, ter vervanging van een schuilkerk uit 1722. Sinds 1968 heeft het gebouw een horecafunctie ('t Ponkje)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0206.php> .

