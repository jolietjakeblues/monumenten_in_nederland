        schema:name "Wijnaldum (Winaam) (gemeente Harlingen)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "311" ;
        schema:pagination "311-312" ;
        schema:text "Terpdorp ontstaan in de middeleeuwen. De bebouwing concentreerde zich rond de kerk en langs het Tsjerkepaed en de Buorren. Behalve een geringe recente uitbreiding langs de Winamerdyk in noordwestelijke richting, is Wijnaldum in de loop der jaren nauwelijks gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01603> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijnaldum (Winaam) (gemeente Harlingen)"@nl ;
        min:adres "Tsjerkepaed 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Harlingen" ;
        min:gemeenteInBoek "Harlingen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Harlingen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijnaldum (Winaam) (gemeente Harlingen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijnaldum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42580> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8670" ;
        min:soort "inleiding" ;
        min:volgnummer 1603 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0197> ;
        schema:name "Wijnaldum (Winaam) (gemeente Harlingen)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "De Herv. kerk (Tsjerkepaed 1), oorspronkelijk gewijd aan St. Andreas, is een eenbeukige kerk met vijfzijdig gesloten koor en een westpartij met forse geveltoren. De kerk kwam rond 1500 tot stand in laat-gotische stijl. De in 1684 gedeeltelijk ingestorte toren heeft men in 1904 vervangen door een neogotische westpartij. De kerk is in 1931 gerestaureerd en ontpleisterd. Tot de inventaris behoren een rijk gesneden preekstoel met doophek, in 1728 vervaardigd door Arjen Lous, en 18de-eeuwse kerkbanken met gesneden wangstukken en een door L. van Dam en Zn. gebouwd orgel (1869)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0197.php> .

