        min:volgnummer 447 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "Op het kerkhof bevinden zich onder meer een zerk met opengeslagen bijbel voor J.A. Vietor († 1872) en een zerk voor de doopsgezinde predikant W.C. Schiff († 1892)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00448> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:adres "Voorweg 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 448 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill124> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "De Herv. kerk van Murmerwoude (Voorweg 2), oorspronkelijk gewijd aan St. Bonifatius, is een eenbeukige kerk met recht gesloten koor, haakse aanbouw en een ongelede zadeldaktoren. Van deze rond 1200 gebouwde romaanse bakstenen kerk wordt het muurwerk in de bovenste zone - tussen de smalle rondboogvensters - geleed door spaarvelden met rondboogfriezen. Het oorspronkelijk halfrond gesloten koor werd in de 16de eeuw vervangen door het huidige koor. De moderne haakse aanbouw dateert uit 1914. De toren verrees in de 13de eeuw. Van de oorspronkelijke vierzijdige helm zijn nog bouwsporen zichtbaar. De huidige zadeldakbeëindiging kwam vermoedelijk in 1772 tot stand. Bij de restauratie van 1962-'63, naar plannen van A. Baart jr., is de kerk ontpleisterd en is de romaanse muurgeleding hersteld. Tot de inventaris behoren een wit geschilderde preekstoel met de wapens van de familie Van Kleffens-Botnia (1818) en een door Bakker & Timmenga gebouwd orgel (1895)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00449> a min:Passage,
            schema:CreativeWork ;
