        schema:name "Scholen"@nl ;
        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "Scholen. De voorm. Chr. landbouwschool (Stationswei 23) dateert uit 1927 en vertoont expressionistische details. De voorm. Chr. lagere school (Master fan Loanstrjitte 33) is in 1922 gebouwd als een tweeklassige gangschool en in 1931 uitgebreid met een derde lokaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01060> a min:Passage,
