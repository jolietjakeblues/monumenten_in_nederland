        min:soort "lemma" ;
        min:volgnummer 1199 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0130> ;
        schema:name "Fochteloo"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Fochteloo. Streekdorp ten oosten van Oosterwolde. De dubbele klokkenstoel met schilddak (bij Zuideinde 25) is vernieuwd na de sloop van de kerk in 1837 en gerestaureerd in 1967. De twee klokken zijn mogelijk 14de-eeuws. De Herv. kapel (Zuideinde 34) is een zaalkerk met sierspant uit 1918. De in 1908 gebouwde, karakteristieke boerderij Zuideinde 12 heeft een eenlaags dwars voorhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01200> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterzee (Eastersee) (gemeente Lemsterland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterzee (Eastersee) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosterzee" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1200 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0131> ;
        schema:name "Oosterzee (Eastersee) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen en tot ontwikkeling gekomen met twee dorpskernen: Oosterzee-Buren en Oosterzee-Gietersebrug. Vanaf de 18de eeuw werd vanuit Oosterzee en Echten de zuidelijk gelegen Veenpolder van Echten eerst verveend en daarna in cultuur gebracht. Dit proces werd in de tweede helft van de 19de eeuw voltooid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01201> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterzee (Eastersee) (gemeente Lemsterland)"@nl ;
        min:adres "Buren 29" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterzee (Eastersee) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosterzee" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20459> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "25785" ;
        min:soort "inleiding" ;
        min:volgnummer 1201 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill341>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill342> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0131> ;
        schema:name "Oosterzee (Eastersee) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "245" ;
        schema:pagination "245-246" ;
        schema:text "De Herv. kerk (Buren 29) is een driezijdig gesloten zaalkerk voorzien van een bakstenen geveltoren met achthoekige open houten bekroning en koepeldak. De huidige kerk kwam in 1860 tot stand in neoclassicistische stijl ter vervanging van een middeleeuwse voorganger buiten de dorpskern. In de geveltoren hangt een door Geert van Wou gegoten klok (1498); het mechanisch smeedijzeren torenuurwerk dateert uit 1602. Het kerkinterieur wordt gedekt door een houten tongewelf. Tot de inventaris uit 1860 behoren een preekstoel met klankbord, een doophek, banken en een orgelgalerij. Het door de firma L. van Dam & Zn. gebouwde orgel (1891) bevindt zich sinds 1909 in deze kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01202> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterzee (Eastersee) (gemeente Lemsterland) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterzee (Eastersee) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosterzee" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1202 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0131> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "Woonhuizen. Het U-vormige herenhuis Buren 19 dateert uit 1782. De voorgevel heeft een kroonlijst en een bakstenen dakkapel met een kleine gedecoreerde klokgevel. In het dorp staan diverse eenlaags huizen met (afgeplat) schilddak en dakkapel, zoals Buren 10 en Buren 14 (circa 1850), met neoclassicistische ingangsomlijsting, Beukenlaan 38 (circa 1870), Herenweg 102 (circa 1875) en het dubbele huis Beukenlaan 34-36 (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01203> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterzee (Eastersee) (gemeente Lemsterland) – Boerderijen"@nl ;
        min:adres "Herenweg 37",
            "Herenweg 87" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterzee (Eastersee) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosterzee" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1203 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0131> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text """Boerderijen. Voorbeelden van koprompboerderijen met onderkelderd voorhuis zijn Westeind 4 en Buren 23 uit de eerste helft van de 19de eeuw en de boerderij Haniastate (Herenweg 87) uit 1876. De door architect De Groot ontworpen boerderij Buorren 35, gebouwd in 1928, heeft een villaachtig voorhuis met expressionistische vormen en een haaks geplaatste schuur met mansardedak.

Het elektrische gemaal (Herenweg 37) is een klein gebouw uit 1940 met traditionalistische vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01204> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterzee (Eastersee) (gemeente Lemsterland) – Bantega (Bantegea)"@nl ;
        min:adres "Bandsloot 16",
            "Middenweg 114",
            "Middenweg 125",
            "Middenweg 146" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterzee (Eastersee) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosterzee" ;
        min:lemma "Bantega (Bantegea)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1204 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill343> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0131> ;
        schema:name "Bantega (Bantegea)"@nl ;
        schema:pageEnd "246" ;
        schema:pageStart "246" ;
        schema:pagination "246" ;
        schema:text "Bantega (Bantegea). Dit dorp ten zuidoosten van Oosterzee is ontstaan rond 1900 toen het in cultuur brengen van de Veenpolder van Echten was voltooid. De voorm. Herv. kerk (Bandsloot 16) is een recht gesloten, donker geschilderde zaalkerk met neoclassicistische details, die bij een verbouwing in 1916 de huidige vorm kreeg. Op het kerkhof (tegenover Middenweg 146) staat een uit 1923 daterende houten klokkenstoel met helmdak. De recht gesloten zaalkerk van de Vrije Evangelische Gemeente Rehoboth (Middenweg 114) dateert uit circa 1950. De voorm. Chr. lagere school (Middenweg 125) werd in 1920 gebouwd als een drieklassige gangschool, mogelijk naar ontwerp van J. van der Werf. De lange voorgevel heeft een kanteelachtige beëindiging. Aardige woonhuizen zijn het eenlaagshuis Middenweg 123, gebouwd in 1920 naar ontwerp van A. de Weerd en K. Bangma, en de ten noordwesten van Bantega gelegen arbeiderswoning Otterweg 28 (circa 1920) met mansardedak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01205> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opeinde (De Pein) (gemeente Smallingerland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
