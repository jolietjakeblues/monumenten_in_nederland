        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harlingen (Harns)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Harlingen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11463> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "507135" ;
        min:soort "inleiding" ;
        min:volgnummer 723 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill199>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill200> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0074> ;
        schema:name "Harlingen (Harns)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "153" ;
        schema:pagination "153-154" ;
        schema:text "Een tussenlid verbindt de kerk met de neogotische pastorie (Zuiderhaven 77), gebouwd in 1881 naar plannen van A. Tepe. De trapgevels zijn voorzien van muizetandlijsten en pinakels (voorzijde). In 1927 heeft men de voorgevel vernieuwd en is tegen de linkerzijgevel een erker aangebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00724> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harlingen (Harns)"@nl ;
        min:adres "Simon Stijlstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Harlingen" ;
        min:gemeenteInBoek "Harlingen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Harlingen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harlingen (Harns)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Harlingen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 724 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0074> ;
        schema:name "Harlingen (Harns)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De voorm. Evang. Luth. kerk (Simon Stijlstraat 2) [3] is een zaalkerk uit 1879, ontworpen door de gebroeders J. en J. Posthumus in een op de Engelse neogotische ‘Perpendicular style’ geïnspireerde bouwstijl. Opvallend zijn de omlijste vensters met rijke traceringen. Bij de verbouwing tot woon- en winkelpand in 1977 ging het interieur grotendeels verloren en heeft men de voorgevel aangepast aan de nieuwe functie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00725> a min:Passage,
