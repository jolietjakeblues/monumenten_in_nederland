        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill380>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill381> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0160> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "269" ;
        schema:pageStart "269" ;
        schema:pagination "269" ;
        schema:text """Woonhuizen. Rond 1890 gebouwd is het middenganghuis It Lange Ein 46. Het deels in kalkzandsteen opgetrokken tweelaags huis It Lange Ein 11 met plat dak dateert uit circa 1910. Aesgewei 20-26 is een rij arbeiderswoningen uit circa 1920. Zakelijk-expressionistische vormen vertoont het huis Ljocht en Skaed (It Lange Ein 17) uit circa 1930. Het in die tijd in vakwerkbouw uitgevoerde pand Aesgewei 60 is mogelijk gebouwd als noodwoning.

De ophaalbrug over de Sijbrandabuurstervaart (bij Aesgewei 2) is een houten brug uit 1865, ingrijpend gerestaureerd in 1974 en 1999.

De voorm. coöperatieve zuivelfabriek ‘De Lege Geaen’ (Aesgewei 2) is opgericht in 1891. Het representatieve hoofdgebouw dateert uit circa 1930. De eenlaags directeurswoning (Aesgewei 4) met haakse uitbouw en jugendstil-vormen dateert uit circa 1910.

Het trafohuisje (bij Aesgewei 2) dateert uit circa 1930 en is uitgevoerd in expressionistische stijl."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01371> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sibrandabuorren (Sijbrandaburen) (gemeente Boarnsterhim) – Tersoal (Terzool)"@nl ;
        min:adres "Koumelkerspaed 1",
            "Westerein 2",
            "Westerein 5" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
