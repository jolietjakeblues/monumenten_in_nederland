        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Langgerekt gehucht, ontstaan aan een weg door de veenplassen van de Westhoek. De naastgelegen vaart werd in 1955 gedempt bij de aanleg van de Pieter Stuyvesantweg van Wolvega naar de Noordoostpolder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0121.php> .

