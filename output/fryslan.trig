        min:volgnummer 1445 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0169> ;
        schema:name "Stiens (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "288" ;
        schema:pageStart "288" ;
        schema:pagination "288" ;
        schema:text "Op het ruime, omhekte kerkhof bevinden zich onder meer een zerk uit 1601, hergebruikt in 1828, een zerk met driepas voor A.H. Rienks († 1898) en H.R. de Jong († 1908) en een stèle voor de gereformeerde predikant J.C. Raamsdonk (†1903). De pastorie (P. Jellessingel 6) in zakelijk expressionistische vormen dateert uit circa 1935."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0169.php> .

