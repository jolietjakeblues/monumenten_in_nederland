        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. In de 19de- en 20ste eeuw vond enige uitbreiding plaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00601> a min:Passage,
            schema:CreativeWork ;
