        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13345>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14358>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19222>,
