        schema:name "Echten (Ychten) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "De boerderij Hoofdweg 33 is een kop-rompboerderij met onderkelderd voorhuis. De voorgevel draagt een gevelsteen met het jaartal 1877."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0054.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00586> a min:Passage,
