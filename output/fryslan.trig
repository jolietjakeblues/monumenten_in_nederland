        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Woonhuizen. De gepleisterde villa De Stins (Keamerlânswei 1) dateert uit circa 1910. Het eenlaags huis Stinsenwei 5, met uitspringend en hoger opgetrokken gedeelte, dateert uit circa 1925 en vertoont expressionistische invloeden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00714> a min:Passage,
