        schema:name "Horeca"@nl ;
        schema:pageEnd "77" ;
        schema:pageStart "77" ;
        schema:pagination "77" ;
        schema:text "Horeca. Het als hotel-café-restaurant gebouwde pand Dubbelstraat 5-9, thans alleen café, dateert uit circa 1890. Het hotel-café Van Swinderenstraat 69 heeft een pui uit circa 1900, waar in de boogtrommels met jugendstiltegeltableaus de voormalige functies en naam zijn aangegeven: ‘Garage-Stalhouderij-Hotel-Teernstra’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00301> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Balk (gemeente Gaasterlân-Sleat) – Bedrijfsgebouwen"@nl ;
        min:adres "Gaaikemastraat 48",
            "Lytse Side 13",
            "Lytse Side 14",
            "Lytse Side 3",
            "Wilhelminastraat 42-46" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Balk (gemeente Gaasterlân-Sleat)" ;
