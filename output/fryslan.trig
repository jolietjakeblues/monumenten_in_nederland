        min:hoofdstuk "Steden, dorpen, monumenten › Hommerts (De Hommerts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hommerts" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 820 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Woonhuizen. Het deels onderkelderde eenlaags huis Jelteweg 102 uit circa 1870 vertoont neoclassicistische invloeden. Uit 1907 dateert het huis Jeltewei 110. Rond 1935 is het eenlaagspand Jeltewei 13 gebouwd met zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00821> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hommerts (De Hommerts) (gemeente Wymbritseradiel) – Boerderijen"@nl ;
        min:adres "Jeltewei 104",
            "Koufurderrige 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hommerts (De Hommerts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hommerts" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 821 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "173" ;
        schema:pagination "173-174" ;
        schema:text """Boerderijen. De rond 1860 gebouwde boerderij Jeltewei 61 heeft een statig, onderkelderd, dwars voorhuis. De stelpboerderij Jeltewei 108 (circa 1870) is aan de rechterzijde voorzien van een deels uitgebouwde melkkelder. Jeltewei 9 is een boerderij met dwars eenlaags voorhuis uit 1877. De in 1926 gebouwde stelpboerderij Pier en Hessel Bouwman Sate (Jeltewei 104) heeft een deels onderkelderd voorhuis en een tot topgevel hoger opgetrokken middendeel. Ten zuiden van Hommerts, in het streekdorp Koufurderigge, liggen de stelpboerderijen Reino Sathe (Koufurderrige 2; circa 1885) en Koufurderrige 39 (circa 1875), met aan de linkerzijde een melkkelder.

De klokkenstoel op het kerkhof van Smallebrugge (Smelbrêge), gelegen ten zuidwesten van Hommerts, is een enkele, wijdbeense houten klokkenstoel met zadeldak, gebouwd in 1963 ter vervanging van een voorganger. Erin hangt een door Henricus Meurs gegoten klok (1617). Op het kerkhof staan onder andere 18de-eeuwse grafpalen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00822> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hommerts (De Hommerts) (gemeente Wymbritseradiel) – Jutrijp (Jutryp)"@nl ;
        min:adres "Riperwei 7-9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hommerts (De Hommerts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hommerts" ;
        min:lemma "Jutrijp (Jutryp)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 822 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Jutrijp (Jutryp)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Jutrijp (Jutryp). Dit buurtschap ten noorden van Hommerts, met hoofdzakelijk bebouwing aan de oostzijde van de vaart het Var, is sinds het midden van de 19de eeuw met Hommerts verbonden door één lang bebouwingslint. De voorm. openbare lagere school met onderwijzerswoning (Riperwei 7-9) dateert uit 1886. Erachter - aan het water - staan twee geprefabriceerde betonnen privaten uit circa 1930. Interessante boerderijen zijn de stelpboerderij Riperwei 2 (circa 1915), de boerderij Binnenpaed 46 (circa 1920), met een villa-achtig eenlaags voorhuis, en de koprompboerderij Binnenpaed 12 (circa 1935) met expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

