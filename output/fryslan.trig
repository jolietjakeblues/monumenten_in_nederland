        min:soort "inleiding" ;
        min:volgnummer 1296 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0149> ;
        schema:name "Raerd (Rauwerd) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Terpdorp met een radiale structuur, ontstaan in de vroege middeleeuwen. Begin 20ste eeuw kwam enige lintbebouwing tot stand langs de Slotsdyk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01297> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Raerd (Rauwerd) (gemeente Boarnsterhim)"@nl ;
        min:adres "Buorren 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Raerd (Rauwerd) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Raerd" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24359>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61440> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21562",
            "32309" ;
        min:soort "inleiding" ;
        min:volgnummer 1297 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0149> ;
        schema:name "Raerd (Rauwerd) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De Herv. kerk (Buorren 9) is een driezijdig gesloten zaalkerk voorzien van een half ingebouwde, ongelede toren met ingesnoerde spits. De op een verhoogd kerkhof gelegen kerk kwam in 1814 tot stand ter vervanging van een middeleeuwse voorganger. In de toren hangt een door Johan Nicolaus Derck gegoten klok (1762). Tot de kerkinventaris uit het derde kwart van de 18de eeuw behoren een preekstoel met doophek, twee overhuifde herenbanken en twee rouwborden (1768 en 1793) voor Aedo Johan Heringa van Eysinga en Cecilia van Sminia. Het orgel is in 1816 door J.A. Hillebrand gebouwd (in 1863 gewijzigd door L. van Dam & Zn.). Verder staan in de kerk vier 16de- en 17de-eeuwse zerken opgesteld, waaronder één in vroege renaissance-vormen voor Aede van Jonghama († 1536), gebeeldhouwd door Benedictus Gerbrandtsz., en één in maniëristische vormen voor Aede van Heringa († 1575)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01298> a min:Passage,
