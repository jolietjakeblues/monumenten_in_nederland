        min:kern "Heerenveen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 758 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0077> ;
        schema:name "Heerenveen (It Hearrenfean)"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "Van de voorm. (Herv.) Schoterlandse kerk (Achter de Kerk ong.) [1], gesticht in 1637 en gesloopt in 1969, resteren het grondplan met lage muurtjes en de zerkenvloer met diverse 17de- en 18de-eeuwse zerken, waaronder die van Daniël de Block van Scheltinga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00759> a min:Passage,
