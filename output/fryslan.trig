        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijckel (Wikel) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijckel" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1596 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0196> ;
        schema:name "Wijckel (Wikel) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "311" ;
        schema:pageStart "311" ;
        schema:pagination "311" ;
        schema:text "Dorp, dat voor het eerst wordt vermeld in de 12de eeuw. Wijckel bestaat uit een dorpskom en verspreide bebouwing langs de uitvalswegen. Na 1850 heeft het dorp zich voornamelijk in westelijke richting uitgebreid. Ten noordwesten van de kerk ligt het Van Coehoornbos, waar Menno van Coehoorn in 1678 de buitenplaats Meerenstein liet bouwen (gesloopt in 1811)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01597> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijckel (Wikel) (gemeente Gaasterlân-Sleat)"@nl ;
        min:adres "Menno van Coehoornweg 2",
            "Menno van Coehoornweg 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijckel (Wikel) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijckel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35615> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15938" ;
        min:soort "inleiding" ;
        min:volgnummer 1597 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0196> ;
        schema:name "Wijckel (Wikel) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "311" ;
        schema:pageStart "311" ;
        schema:pagination "311" ;
        schema:text "De Herv. kerk (Menno van Coehoornweg 2) is een driezijdig gesloten zaalkerk met zadeldaktoren van drie geledingen. Tegen de 15de-eeuwse toren werd in 1671 de huidige kerk opgetrokken ter vervanging van een voorganger. De toren is daarbij verhoogd en hersteld in 1821. In de toren hangt een klok uit 1388. De kerk bevat het marmeren praalgraf voor krijgsheer en vestingbouwkundige Menno baron van Coehoorn († 1704). Het is naar ontwerp van Daniël Marot vervaardigd door beeldhouwer Pieter van der Plas. Verder bevat de kerk marmeren epitafen voor Frederik Willem graaf van Limburg Stirum († 1747) en zijn echtgenote Theodora van Coehoorn en voor Hendrik Casimir van Coehoorn († 1756). Ook zijn er grafzerken voor leden van de familie Van Wyckel. Het orgel is in 1900 gebouwd door Bakker & Timmenga. De pastorie (Menno van Coehoornweg 6) is een blokvormig eenlaagspand uit 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01598> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijckel (Wikel) (gemeente Gaasterlân-Sleat)"@nl ;
