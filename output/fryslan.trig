        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Witmarsum (Wytmarsum) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Witmarsum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1626 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0201> ;
        schema:name "Witmarsum (Wytmarsum) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Terpdorp, ontstaan in de vroege middeleeuwen. Rond 1850 concentreerde de bebouwing zich op de terp, langs de Witmarsummer Vaart en langs de weg Bolsward-Harlingen. Rond 1912 heeft men een deel van de terp afgegraven. Na de Tweede Wereldoorlog is het dorp aan de oost- en zuidzijde verder uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0201.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01627> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Witmarsum (Wytmarsum) (gemeente Wûnseradiel)"@nl ;
        min:adres "Kerkplein 2",
            "Kerkplein 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Witmarsum (Wytmarsum) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Witmarsum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54820> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39435" ;
        min:soort "inleiding" ;
        min:volgnummer 1627 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0201> ;
        schema:name "Witmarsum (Wytmarsum) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "De Herv. kerk (Kerkplein 2) is een aan de kopse zijden driebeukig gesloten eenbeukige kerk voorzien van een forse dakruiter met koepeldak. De kerk werd in 1633 gebouwd in opdracht van Tjaerd van Aylva ter vervanging van een middeleeuwse voorganger. De middeleeuwse toren verving men in 1819 door een driezijdige sluiting. Tevens werd toen de dakruiter toegevoegd, waarin een door Johannes van Bomen gegoten klok (1433) en een klok van Jurien Balthasar (1565) hangen. Het kerkinterieur wordt gedekt door een houten gewelf en heeft een lambrisering en galerij uit 1845. Tot de 17de-eeuwse inventaris behoren het doophek, een overhuifde herenbank en dertien vrouwenbanken (1683). Uit de 19de eeuw dateren de witgeschilderde preekstoel en het door L. van Dam & Zn. gebouwde orgel (1856). In de kerk liggen diverse 16de-eeuwse zerken, waaronder de door Benedictus Gerbrandtsz. gebeeldhouwde zerk (1541) voor Pieter Aggama († 1538) en de grote zerk voor Epo van Aylva († 1557) en Sjouck van Sickema († 1575). De pastorie (Kerkplein 9) dateert uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0201.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01628> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Witmarsum (Wytmarsum) (gemeente Wûnseradiel)"@nl ;
        min:adres "Arumerweg 66" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
