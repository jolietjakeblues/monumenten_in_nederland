        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De Doopsgez. kerk (Aengwirderweg 318) is een zaalkerk uit 1871 met consistoriekamer in het driezijdig gesloten uiteinde. Het orgel werd gebouwd door L. van Dam & Zn. (1888)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0176.php> .

