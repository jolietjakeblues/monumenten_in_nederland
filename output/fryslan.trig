        schema:name "Kollumerzwaag (Kollumersweach) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Geref. kerk (Foarwei 97) is een T-vormige kerk met dakruiter en portaal, gebouwd in 1925 ter vervanging van een voorganger uit 1894."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0097.php> .

