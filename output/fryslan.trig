        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill231> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Hommerts (De Hommerts) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De voorm. openbare lagere school (Jeltewei 25) is rond 1900 gebouwd als een tweeklassige middengangschool. Het uitgebouwde portaal en de naastgelegen onderwijzerswoning (Jeltewei 23) dateren uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00820> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hommerts (De Hommerts) (gemeente Wymbritseradiel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
