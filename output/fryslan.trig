        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0193> ;
        schema:name "West-Terschelling (West-Skylge) (gemeente Terschelling)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De Doopsgez. kerk (Molenstraat 22) is een recht gesloten zaalkerk uit 1850 met twee gebrandschilderde ramen in jugendstil-vormen van E.W.F. Kerling (1910). De forse pastorie met neoclassicistische details stamt uit 1847."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0193.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01585> a min:Passage,
