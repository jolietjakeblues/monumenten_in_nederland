        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Akmarijp (Eagmaryp) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Akmarijp" ;
        min:lemma "Goingarijp (Goaiïngaryp)" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26491>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47651> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "13228",
            "13229" ;
        min:soort "lemma" ;
        min:volgnummer 230 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0010> ;
        schema:name "Goingarijp (Goaiïngaryp)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Goingarijp (Goaiïngaryp). Dit vaartdorp ten noordwesten van Akmarijp is ontstaan in de middeleeuwen. De Herv. kerk (It Hôf 5) is een driezijdig gesloten zaalkerk met een stichtingssteen uit 1770. Uit dat jaar dateren ook de preekstoel en de gebrandschilderde glazen met wapens naar ontwerp van Ype Staak. Bij de kerk staat een houten klokkenstoel met helmdak, voor het eerst vermeld in 1543, maar in de huidige vorm daterend uit 1770. In de klokkenstoel hangt een door Geert van Wou gegoten klok (1527). Nabij de kerk ligt de kop-rompboerderij (It Hôf 3), blijkens de jaartalankers daterend uit 1874."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00231> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Heerenveen" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerenveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldeboarn" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 231 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0011> ;
        schema:name "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Dorp met stedelijk karakter (vlekke), waarschijnlijk ontstaan in de 11de-12de eeuw nabij de Boorne en voor het eerst vermeld in 1230 (Bornego). Rond 1200 werd het dorp van belang als handelsplaats. Oorspronkelijk lag de dorpskern op de langgerekte terp. In de loop van de tijd werd de bebouwing meer op het water gericht. Rond 1720 was dit proces aan de bochtige noordoever van de Boorne voltooid tot een aaneengesloten, enigszins stedelijk straatbeeld. De zuidoever van de Borne raakte bebouwd in de 18de en vroege 19de eeuw. Tot het eind van de 19de eeuw behield Aldeboarn een handelsfunctie. Vanaf circa 1925 is het dorp aan de noordzijde gegroeid. Aldeboarn is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00232> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        min:adres "Tsjerkebuorren 2-4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Heerenveen" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerenveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldeboarn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10931>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61700> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35950",
            "35951" ;
        min:soort "inleiding" ;
        min:volgnummer 232 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0011> ;
        schema:name "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De Herv. kerk (Tsjerkebuorren 2-4) is een driezijdig gesloten zaalkerk voorzien van een ongelede toren met ionische pilasters en een drie verdiepingen hoge, deels open, houten lantaarn met omlopen. De toren werd in 1736-'37 opgetrokken. In de toren hangt een door Geert van Wou gegoten klok (1526). De huidige kerk kwam in 1753 tot stand ter vervanging van een middeleeuwse voorganger. Boven de ingang bevindt zich een gebeeldhouwde stichtingscartouche in Lodewijk XIV-stijl, vervaardigd door Johannes Hardenberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00233> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Heerenveen" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerenveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldeboarn" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 233 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill65> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0011> ;
        schema:name "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf met geschilderde hemellichamen en engelfiguurtjes. Tot de inventaris behoren een overhuifde herenbank (1655) van de familie Lycklama, een door Dirk Embderveld gesneden preekstoel (1753) en een door L. van Dam gebouwd orgel (1779; gerestaureerd in 1966-'67). Verder bevat de kerk een klein epitaaf van tegels (1612) voor ds. Pibo Ovitius van Abbema en een door Jacob Sydzes Bruinsma vervaardigd grafmonument (circa 1765) voor Regnerus († 1754) en Livius Theodorus Andringa († 1765)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0011.php> .

