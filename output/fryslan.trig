        min:kern "Drogeham" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 524 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0047> ;
        schema:name "Drogeham (Droegeham) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Dorp, ontstaan in de 19de eeuw op enige afstand ten westen van het in 1242 gestichte premonstratenzer Buweklooster (gesloopt rond 1580). Het dorp met brinkachtige ruimte kreeg in 1891 verbinding met het Kolonelsdiep, vooral voor de afvoer van het ter plaatse gewonnen zand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00525> a min:Passage,
