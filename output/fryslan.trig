        min:kern "Hindeloopen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20104>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50259>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51443>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56248> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "22171",
            "39363",
            "510854",
            "9838" ;
        min:soort "inleiding" ;
        min:volgnummer 793 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill224> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0082> ;
        schema:name "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "De Herv. kerk (Kerkstraat 1), oorspronkelijk gewijd aan St. Gertrudis, is een vijfzijdig gesloten eenbeukige kerk met een toren van drie geledingen bekroond door een deels opengewerkt houten achtkant van drie geledingen met omgang en koepeldak. De zogeheten Westertoren werd in 1593 voltooid, maar de huidige bekroning naar ontwerp van Claes Piters kwam in 1724 tot stand nadat de oorspronkelijke spits in 1701 was afgebrand. In de toren hangt een door Petrus Overney gegoten klok (1685). De huidige kerk verrees in 1632 op de fundamenten van een laat-16de-eeuwse voorganger. In 1658 heeft men de kerk uitgebreid met een zuidbeuk, die in 1892 werd afgebroken. Toen werd ook de hoofdbeuk grotendeels vernieuwd. De huidige venstervormen dateren eveneens uit 1892. De ingangspoortjes aan de noord- en zuidzijde zijn in 1658 vervaardigd door Claes Lykles."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00794> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hindeloopen (Hylpen) (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hindeloopen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 794 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0082> ;
        schema:name "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf met trekbalken. Tot de inventaris behoren enkele 16de-eeuwse zerken (koor), een preekstoel (circa 1660) en een orgelbalustrade op gietijzeren zuiltjes (eind 19de eeuw), met daarop een in 1868 uit Oosterbierum overgebracht orgel van L. van Dam (1812). De orgelkast is vervaardigd door Harmen Jansz. (1665) en door zijn zoon Jan Harmensz. Camp (1719) aangepast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        min:adres "Schoolstraat 8",
            "Tuinen 12" ;
