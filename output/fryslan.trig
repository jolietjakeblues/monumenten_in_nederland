        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text "Scholen. De voorm. openbare lagere scholen Hoofdweg 40 en Wanswerterdijk 36 zijn beide in 1908 gebouwd, de eerste als een tweeklassige gangschool, de tweede als een vierklassige middengangschool met onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0035.php> .

