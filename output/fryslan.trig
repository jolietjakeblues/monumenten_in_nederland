        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollum (gemeente Ameland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hollum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 801 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0083> ;
        schema:name "Hollum (gemeente Ameland)"@nl ;
        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "Op het kerkhof bevinden zich diverse interessante 18de-eeuwse grafstenen; die voor de mannen vertonen een afbeelding van een schip, die voor de vrouwen één van een huis. Voorbeelden zijn die voor commandeur Barent Hansz († 1752), Hans Barentsz († 1790), Cornelis Meyndertsz († 1758) en zijn huisvrouw Antje Sytties († 1776)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0083.php> .

