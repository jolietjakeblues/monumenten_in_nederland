        min:kern "Arum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 271 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill71> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0016> ;
        schema:name "Arum (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "72" ;
        schema:pagination "72-73" ;
        schema:text "Terpdorp, ontstaan rond het begin van de jaartelling op een kwelderwal van de Marneslenk. De bebouwing concentreerde zich rond 1850 bij de kruising van de vaart van Arum naar Franeker en de weg Harlingen-Bolsward. Na de verharding van deze weg, kort na 1850, nam de bebouwing erlangs verder toe. Na 1900 groeide het dorp enigszins uit aan de oost- en zuidwestzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00272> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arum (gemeente Wûnseradiel)"@nl ;
        min:adres "Kerksingel 1",
            "Sytzamaweg 48" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arum (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Arum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 272 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0016> ;
        schema:name "Arum (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Herv. kerk (Kerksingel 1) is een eenbeukige kerk met driezijdig gesloten koor en een ongelede, half ingebouwde toren met opengewerkte houten lantaarn en open koepeltje. In 1836 werden de mogelijk uit de tweede helft van de 12de eeuw daterende toren en de in 1664-'65 herbouwde kerk gedeeltelijk door brand verwoest. Bij de herbouw in 1837 heeft men delen van de tufstenen torenmuur en grote delen van de kerkmuren opnieuw gebruikt. Van het ontwerp van Th.A. Romein voor deze nieuwe kerk werd alleen de torenlantaarn uitgevoerd. Tot de kerkinventaris behoren drie overhuifde banken (1837), een preekstoel met doophek (circa 1890) en een door D.S. Ypma gebouwd orgel (1840; vernieuwd in 1885 door E. Leichel). De pastorie (Sytzamaweg 48) is een blokvormig eenlaags huis met bakstenen dakkapel, gebouwd rond 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00273> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arum (gemeente Wûnseradiel)"@nl ;
        min:adres "Van Camminghaweg 13" ;
