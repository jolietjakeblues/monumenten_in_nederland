        schema:name "Buitenpost (Bûtenpost) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De Geref. kerk (Voorstraat 15) is een zaalkerk met spitsboogvensters uit 1897, die in 1923 tot een T-vorm werd uitgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0034.php> .

