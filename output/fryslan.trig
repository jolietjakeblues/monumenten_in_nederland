        min:volgnummer 1496 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0178> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Woonhuizen. De voorm. pastorie Kade 9 is een gepleisterd blokvormig eenlaagspand met hoger opgetrokken middendeel voorzien van een klokgevel in Lodewijk XV-stijl uit 1748. Waltaweg 2 en Waltaweg 4 zijn twee vergelijkbare laat-19de-eeuwse, deels onderkelderde, eenlaags woningen met overstekend zadeldak. Het diepe eenlaagspand Waltaweg 35 dateert uit 1897; ernaast staat een timmerwerkplaats. In 1922 gebouwd is Waltaweg 1, een eenlaags huis met een tot topgevel opgetrokken geveldeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0178.php> .

