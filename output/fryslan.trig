        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blije (Blija) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blije" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 359 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0028> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Woonhuizen. Het eenlaagspand Farrewei 1-5 heeft een kopgevel met vlechtingen en (mogelijk van elders afkomstige) vroeg-18de-eeuwse aanzetkrullen. Een laat-18de-eeuwse oorsprong heeft het eenlaagspand Hoofdstraat 1, en ook Voorstraat 4, met een sobere Vlaamse gevel, zou kort vóór 1800 zijn gebouwd. Het herenhuis Voorstraat 14 (nu winkel) dateert uit het eerste kwart van de 19de eeuw. Het middenganghuis Hoofdstraat 22 werd rond 1880 gebouwd als woonhuis annex smederij. De vrijstaande rentenierswoning Voorstraat 26 (circa 1908) vertoont jugenstil-kenmerken. Vergelijkbaar, maar soberder, zijn de rond 1910 gebouwde woningen Farrewei 7, Stationsweg 12 en 14."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00360> a min:Passage,
            schema:CreativeWork ;
