        schema:name "Scholen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Scholen. De voorm. lagere school Schoolsingel 7 dateert uit 1832 en is uitgevoerd met spitsboogvensters. De Chr. lagere school ‘De Hoekstien’ (Schoolstraat 12), gebouwd in 1929 naar ontwerp van L. Reinalda, vertoont zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arum (gemeente Wûnseradiel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arum (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Arum" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0016> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "Woonhuizen. Voorbeelden van eenlaags middenganghuizen zijn Van Camminghaweg 32 (circa 1870), met portiek, en Franekerkade 19 (circa 1880), met omlijste ingang en dakkapel. Polle 10 is een huis met werkplaats uit circa 1880. Het in 1882 als dokterswoning gebouwde eenlaagspand Sytzamaweg 13, met mezzanino en verhoogd middenrisaliet, is uitgevoerd in eclectische vormen. Uit het begin van de 20ste eeuw dateren de eenlaags woonhuizen Van Camminghaweg 47-69 (1900), de arbeiderswoningen Oude Kerkstraat 17-25 (1902) en het eenlaagspand Sytzamaweg 44 (1906). Rond 1920 gebouwd is het gepleisterde eenlaags huis Sytzamaweg 56, dat is voorzien van een met riet gedekt tentdak. Expressionistische vormen vertoont het huis Sytzamaweg 60 (circa 1930)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arum (gemeente Wûnseradiel) – Boerderijen"@nl ;
        min:adres "Baarderbuorren 15",
            "Sytzamaweg 15" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arum (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Arum" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47521> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "516534" ;
        min:soort "lemma" ;
        min:volgnummer 276 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill72>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill73> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0016> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text """Boerderijen. De boerderijen Baarderbuorren 8 (circa 1860), met onderkelderd voorhuis, en Baarderbuorren 17 (circa 1870) zijn voorbeelden van kop-hals-rompboerderijen. Interessante stelpboerderijen zijn: Baarderbuorren 9 (1871), met links van het woongedeelte de melkkelder, Sytzamaweg 43 (circa 1880), met onderkelderd woongedeelte, Groot Baarderburen (Baarderbuorren 15; 1899), Sytzamaweg 25 (circa 1915), met verhoogd middenrisaliet, en de grotendeels met riet gedekte boerderij Oude Kerkstraat 24 (circa 1935). De kop-rompboerderij Sytzamaweg 47 (circa 1915) heeft een villa-achtig voorhuis.

De voorm. herberg ‘De Gekroonde Leeuw’ (Sytzamaweg 15) uit 1876 is een statig blokvormig pand met gepleisterd middenrisaliet met fronton, een stalling en een beglaasde gietijzeren serre op gietijzeren kolommen. De herberg functioneerde tevens als halteplaats van de tramlijn Harlingen-Bolsward."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00277> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arum (gemeente Wûnseradiel) – Winkels"@nl ;
        min:adres "Baarderbuorren 4",
            "Sytzamaweg 54" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
