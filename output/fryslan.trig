        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0152> ;
        schema:name "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van de jaartelling aan de Riedstroom op een kwelderwal. Na de Tweede Wereldoorlog is het dorp uitgegroeid tot een dorp met een meer vierkante plattegrond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01314> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        min:adres "Kerkpad 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ried (Rie) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ried" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36361> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15865" ;
        min:soort "inleiding" ;
        min:volgnummer 1314 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0152> ;
        schema:name "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "De Herv. kerk (Kerkpad 1) is een gepleisterde, driezijdig gesloten zaalkerk voorzien van een toren van twee geledingen met ingesnoerde naaldspits. De huidige kerk kwam in 1653 tot stand ter vervanging van een voorganger. De toren is blijkens een stichtingssteen al in 1625 herbouwd door meester Abe Ede. In de toren hangt een door Hans Falck gegoten klok (1634). Een andere gevelsteen herinnert aan het bepleisteren van de kerk en het plaatsen van de gietijzeren spitsboogvensters in 1871. Tot de inventaris behoren een door Poulus Rycles - met snijwerk van Cornelis Cornelisz. - vervaardigde preekstoel (1727) en een door L.J. van Dam gebouwd orgel (1829) in een orgelkast uit circa 1700. Rond de kerk ligt een verhoogd kerkhof, omstreeks 1870 aangelegd door J.B. Roorda, met een gietijzeren toegangshek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01315> a min:Passage,
