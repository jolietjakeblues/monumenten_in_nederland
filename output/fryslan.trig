        schema:name "Hommerts (De Hommerts) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De Geref. kerk (Jeltewei 150) is een recht gesloten zaalkerk uit circa 1880, waarvan de voorgevel in de jaren vijftig van de 20ste eeuw is vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00819> a min:Passage,
