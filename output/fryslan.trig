        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaparochie (Sint Anne) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Annaparochie" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1372 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0161> ;
        schema:name "Sint Annaparochie (Sint Anne) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "269" ;
        schema:pageStart "269" ;
        schema:pagination "269" ;
        schema:text "Wegdorp, aanvankelijk Altoenae genoemd en ontstaan in de 16de eeuw nadat het laatste deel van de Middelzee in 1505 was ingepolderd (Het Bildt). Bij de kruising van de Noordervaart en de Middelweg ontstond langgerekte bebouwing. Na de Tweede Wereldoorlog is het dorp aan de noord- en zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01373> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Annaparochie (Sint Anne) (gemeente Het Bildt)"@nl ;
        min:adres "Van Harenstraat 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaparochie (Sint Anne) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Annaparochie" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40934> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9495" ;
        min:soort "inleiding" ;
        min:volgnummer 1373 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0161> ;
        schema:name "Sint Annaparochie (Sint Anne) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text "De Herv. kerk (Van Harenstraat 1) is een achthoekige centraalbouw met tentdak en achtkantige opengewerkte dakruiter met koepeldakje op een gemetselde onderbouw. Deze kerk in classicistische stijl verrees in 1682 op initiatief van grietman Willem van Haren naar voorbeeld van de rond 1600 gebouwde Herv. kerk van Willemstad en verving een vroeg-16de-eeuwse voorganger. Aan de noordzijde bevinden zich een kleine traptoren en een achtzijdige grafkapel van de familie Van Haren-Hemmema. De ingangen met zandstenen ionische toegangspoortjes zijn verschillende malen verplaatst. Bij de restauratie in 1937-'41 zijn zij teruggeplaatst naar de oorspronkelijke plek en voorzien van portalen. De vensters hebben in 1940 bakstenen montants gekregen. De kerk was eerder in 1846-'47 onder leiding van Th. Romein hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01374> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Annaparochie (Sint Anne) (gemeente Het Bildt)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaparochie (Sint Anne) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Annaparochie" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1374 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0161> ;
        schema:name "Sint Annaparochie (Sint Anne) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text "Inwendig wordt de gemetselde onderbouw van de dakruiter gedragen door vier dorische zuilen, met daartussen een vierzijdig houten gewelf. De deuren van de grafkapel zijn voorzien van koperen gietwerk en doodssymboliek daarboven. De kerk bevat een zwart marmeren epitaaf voor de stichter Willem van Haren († 1708) en zijn echtgenote Elisabeth Hemmema († 1688). Tot de inventaris uit circa 1700 behoren een bijzonder rijke preekstoel in Lodewijk XIV-vormen - met allegorische vrouwenfiguren op de kuippanelen -, een doophek en de herenbank van de familie Van Haren-Hemmema. Het orgel is in 1727 gebouwd door Johannes Radeker."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01375> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Annaparochie (Sint Anne) (gemeente Het Bildt) – Overige kerken"@nl ;
        min:adres "J.J. Costerstraat 1",
            "Middelweg-West 160",
            "Statenlaan 10",
            "Statenlaan 8",
            "Van Harenstraat 47",
            "Van Harenstraat 67",
            "Wassenberghstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaparochie (Sint Anne) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Annaparochie" ;
        min:lemma "Overige kerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44935> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9508" ;
        min:soort "lemma" ;
        min:volgnummer 1375 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0161> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text """Overige kerken. De Doopsgez. kerk (Statenlaan 10) is een recht gesloten neoclassicistische zaalkerk uit circa 1860, die rond 1950 een nieuwe voorgevel kreeg. De bijbehorende pastorie (Statenlaan 8) is een eclectisch middenganghuis. In 1926 gebouwd is de Geref. kerk (Van Harenstraat 67), een kruisvormige kerk met portaal, uitgevoerd naar een ontwerp met expressionistische invloeden. De R.K. Vicarie Verrijzenis des Heren ‘De Skûl’ (J.J. Costerstraat 1) is een moderne blokvormige zaalkerk met bijbehorend zusterhuis, gebouwd in 1958-'59 naar ontwerp van P. Starmans.

De voorm. lagere school (Wassenberghstraat 2) is een sober schoolgebouw in neoclassicistische vormen. Het in 1819 gebouwde pand is in 1830 uitgebreid met een aangebouwde onderwijzerswoning.

Het voorm. gasthuis ‘De Vlaswiek’ (Middelweg-West 160) is een E-vormig eenlaagspand met midden- en hoekrisalieten, gebouwd in 1906 in late neorenaissance-stijl.

Het raadhuis (Van Harenstraat 47) is een eenlaagspand met toegangstrap en gebroken schilddak, gebouwd in 1927 in expressionistisch vormen. De geveltop van de risalerende middenpartij draagt het gemeentewapen van Het Bildt.

De boerderij Middelweg-Oost 157 is een boerderij van het kop-hals-romptype. Het voorhuis met zadeldak tussen topgevels, bekroond door schoorstenen met borden, dateert volgens de gevelankers uit 1768."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01376> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Annaparochie (Sint Anne) (gemeente Het Bildt) – Woonhuizen"@nl ;
        min:adres "Stadhoudersweg 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Annaparochie (Sint Anne) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Annaparochie" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1376 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0161> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text """Woonhuizen. Het neoclassicistische eenlaags herenhuis Van Harenstraat 24 stamt uit circa 1850. Het dwarse woonhuis Van Harenstraat 26 heeft een voorgevel in eclectische vormen uit circa 1860.

Het urinoir (tegenover Stadhoudersweg 1), een sober bakstenen gebouwtje met expressionistische details, is gebouwd rond 1935.

De Alg. begraafplaats (Middelweg-Oost ong.), aangelegd in 1875 en vergroot in 1934, heeft een decoratief ijzeren toegangshek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01377> a min:Passage,
