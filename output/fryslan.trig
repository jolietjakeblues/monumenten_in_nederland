        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "De Geref. kerk (Wommelserweg 46) is een kleine recht gesloten zaalkerk uit 1903 met neogotische en neorenaissance-details. De pastorie (Wommelserweg 48) dateert uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0180.php> .

