        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0058> ;
        schema:name "Ferwert (Ferwerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Het raadhuis (Hogebeintumerweg 2) is een gebouw met souterrain en beletage; een bordestrap leidt naar de omlijste ingang met gecanelleerde ionische pilasters. Het werd in 1840 gebouwd als grietenijhuis en uitgevoerd door R.W.F. Stoett."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00613> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ferwert (Ferwerd) (gemeente Ferwerderadiel)"@nl ;
        min:adres "Vrijhof 5" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ferwert (Ferwerd) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ferwert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49751> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15609" ;
        min:soort "inleiding" ;
        min:volgnummer 613 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0058> ;
        schema:name "Ferwert (Ferwerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Het voorm. prebendarishuis (Vrijhof 5) is een dwars huis met souterrain en bel-etage, voorzien van een hoogopgaande deuromlijsting met pseudo-ionische kapitelen en een fraaie vroeg-19de-eeuwse deur. Het stinsvormige huis werd in de 15de eeuw gebouwd. Van 1580 tot 1723 deed het dienst als pastorie en daarna, tot 1840, als grietenijhuis. Bij de bestemmingsverandering rond 1840 heeft men een nieuwe voorgevel opgetrokken, het keldergewelf verwijderd en een nieuwe kap aangebracht. Het gebouw is in 1973 gerestaureerd. Op het plein voor het huis staat een dorpspomp (circa 1870), gegoten door Van Enthoven & Co., en een verzetsmonument (circa 1950), vervaardigd door J. van Luyn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00614> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ferwert (Ferwerd) (gemeente Ferwerderadiel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ferwert (Ferwerd) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ferwert" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 614 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0058> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Woonhuizen. In het dorp zijn relatief veel oude huizen bewaard gebleven. Het sterk gerestaureerde eenlaagspand Lytse Buorren 9 heeft in de tuitgevel een gevelsteen gedateerd ‘1665’. Vermoedelijk ook 17de-eeuws zijn het vergelijkbare huis Nije Buorren 13 en de dwarse eenlaagspanden Vrijhof 7-9. De klokgevel met segmentvormig fronton van Vrijhof 3 dateert uit 1710. Het voorm. molenaarshuis Molenlaan 1 is een dwars huis met verhoogde middenrisaliet, waarvan de klokgevel onder de aanzetkrullen is gedateerd ‘1764’. Het forse woonhuis Havenstraat 1, met neoclassicistische hoofdvorm, en het diepe huis Nije Buorren 9 stammen uit het eerste kwart van de 19de eeuw. Hoofdstraat 14 is een dwars eenlaags huis met omlijste ingang uit circa 1850. Het diepe eenlaagspand Nije Buorren 17 dateert uit circa 1860; Hoofdstraat 2 uit circa 1880. Goede voorbeelden van middenganghuizen met dakkapellen zijn Marrumerweg 3 (circa 1870) en Marrumerweg 7 (circa 1895). Jugendstil-details en -tegels heeft de mogelijk door J.K. van Dijk ontworpen vrijstaande rentenierswoning Elingawei 15 (circa 1905). Het vergelijkbare woonhuis Vrijhof 1 bezit een dakerker met 18de-eeuwse aanzetkrullen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00615> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ferwert (Ferwerd) (gemeente Ferwerderadiel) – Boerderijen"@nl ;
        min:adres "Kahoolsterlaan 2",
            "Ljouwerterdyk 13" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ferwert (Ferwerd) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ferwert" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17577>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31739> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15579",
            "15582" ;
        min:soort "lemma" ;
        min:volgnummer 615 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0058> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "129" ;
        schema:pagination "129-130" ;
        schema:text "Boerderijen. Het dwarse eenlaagspand Hoofdstraat 33 is het 18de-eeuwse woongedeelte van een boerderij waarvan het stalgedeelte is gesloopt. De gave kop-hals-romp-boerderij Ter Sted (Ljouwerterdyk 13) uit 1817 heeft een langgerekt, in het midden onderkelderd, voorhuis. De kop-hals-rompboerderij Groot Kahool (Kahoolsterlaan 2), gelegen ten noordoosten van Ferwert, heeft een lang voorhuis met omlijste ingang. Deze in 1783 opgetrokken boerderij heeft inwendig een betimmering met schouw en bedstedewand voorzien van palmetkapitelen. Ten zuiden van Ferwert ligt een in 1913 grotendeels afgegraven 11de-eeuwse terp, waarop van 1109 tot 1580 het benedictijnerklooster Foswerd of Bethanië heeft gestaan. Op het terprestant bevinden zich twee kop-hals-rompboerderijen. De boerderij It Kleaster 1 heeft een gedeeltelijk in hergebruikte kloostermoppen opgetrokken schuur met de datering ‘1789’. Van de boerderij It Kleaster 3 is de kop in 1806 gebouwd voor de familie Alberda; het rompgedeelte dateert uit 1887."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00616> a min:Passage,
