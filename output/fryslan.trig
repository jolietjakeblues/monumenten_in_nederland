        min:hoofdstuk "Steden, dorpen, monumenten › Hemrik (De Himrik) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hemrik" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17104> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31856" ;
        min:soort "inleiding" ;
        min:volgnummer 780 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0079> ;
        schema:name "Hemrik (De Himrik) (gemeente Opsterland)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De Herv. kerk (Binnenwei 22) is een gepleisterde, driezijdig gesloten zaalkerk uit 1739. Van de toen vervangen oude, aan St. Andreas gewijde, kerk zijn mogelijk delen van het muurwerk bewaard gebleven. De kerk bevat een 17de-eeuwse preekstoelkuip."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00781> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hemrik (De Himrik) (gemeente Opsterland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hemrik (De Himrik) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hemrik" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 781 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0079> ;
        schema:name "Hemrik (De Himrik) (gemeente Opsterland)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Het verhoogde kerkhof heeft een apart deel met een grote grafkelder voorzien van een ontluchtingspijp, gesticht door vervener J.A. van der Sluis († 1863); op de zerk is een volledige stamboom uitgehouwen. De enkele houten klokkenstoel met schilddak stamt oorspronkelijk uit 1739. Erin hangt een door Geert van Wou gegoten klok (1495)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00782> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hemrik (De Himrik) (gemeente Opsterland)"@nl ;
        min:adres "Binnenwei 19",
            "Binnenwei 8" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
