        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "42171",
            "507111" ;
        min:soort "inleiding" ;
        min:volgnummer 1594 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0195> ;
        schema:name "Wierum (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "311" ;
        schema:pageStart "311" ;
        schema:pagination "311" ;
        schema:text "De Geref. kerk ‘Eben Haëzer’ (Haadstrjitte 17) is een recht gesloten zaalkerk uit 1875 met eclectische details. Het voorm. schippershuis (Tsjerkeplein 2), een fors blokvormig woonhuis met omlijste ingang, werd mogelijk in 1832 gebouwd voor A.D. Vellema. In 1918 kwam het in bezit van het waterschap De Contributie Zeedijken van Oostdongeradeel. De dakerker in ‘Um 1800’-vormen dateert uit 1919."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0195.php> .

