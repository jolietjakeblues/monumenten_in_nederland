        min:hoofdstuk "Steden, dorpen, monumenten › Wijnjewoude (Wynjewâld) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijnjewoude" ;
        min:lemma "Scholen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1611 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text """Scholen. De voorm. openbare lagere school (bij Merkebuorren 100, Duurswoude) is in 1874 gebouwd als tweeklassige middengangschool met onderwijzerswoning (Merkebuorren 100). De voorm. openbare lagere school (Weinterp 26) kwam rond 1905 tot stand als drieklassige gangschool met onderwijzerswoning (Weinterp 24).

De woning Breeberchspaed 3 is een veenarbeiderswoning met krimp, gebouwd in 1920 naar ontwerp van de aannemers Tj. en D. Keuning.

De boerderij Merkebuorren 39 heeft een dwars geplaatst voorhuis in eclectische vormen uit circa 1870."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01612> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Winsum (gemeente Littenseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
