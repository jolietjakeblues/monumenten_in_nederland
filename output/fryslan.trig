            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58271> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "7647",
            "7652" ;
        min:soort "inleiding" ;
        min:volgnummer 306 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill80> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0021> ;
        schema:name "Ballum (gemeente Ameland)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "77" ;
        schema:pagination "77-78" ;
        schema:text "De Herv. kerk (Camminghastraat 14) is een sobere zaalkerk uit 1832, gebouwd ter vervanging van een verderop gelegen middeleeuwse voorganger. Tot de inventaris behoort een bijzonder rijke maniëristische preekstoelkuip met gecanneleerde corintische pilasters en panelen versierd met schelpmotieven en bloemstukken. De in 1604 door Claes Jelles vervaardigde preekstoel is afkomstig uit de Herv. kerk van Harlingen (aangekocht in 1771)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00307> a min:Passage,
