        min:soort "inleiding" ;
        min:volgnummer 449 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "Op het kerkhof bevinden zich onder meer een zerk voor D. Fontein de Jong († 1898) en een door G. Jager vervaardigde grafsteen voor H.G. van der Veen († 1887)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00450> a min:Passage,
