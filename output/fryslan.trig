        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dronrijp (Dronryp) (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dronrijp" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 533 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0048> ;
        schema:name "Dronrijp (Dronryp) (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "117" ;
        schema:pageStart "117" ;
        schema:pagination "117" ;
        schema:text "Het wit gepleisterde, neoclassicistische interieur wordt gedekt door een vlak plafond. Tot de 19de-eeuwse inventaris behoren een neogotisch altaar met schilderstuk en geschilderde kruiswegstaties van O. de Boer, enkele heiligenbeelden van J.P. Maas Loos en een door L. van Dam & Zn. gebouwd orgel (1882) in een rijk versierde orgelkast in Lodewijk XVI-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00534> a min:Passage,
