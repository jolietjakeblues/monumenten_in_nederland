        schema:name "Nes (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De Geref. kerk (Wiesterwei 2) is een kruiskerk met dakruiter, portaal en aanbouwen in de binnenhoeken, opgetrokken in 1925 met expressionistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0118.php> .

