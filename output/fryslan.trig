        min:volgnummer 1271 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0144> ;
        schema:name "Peins (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "Terpdorp, mogelijk rond het begin van de jaartelling ontstaan op een kwelderwal. Over de kwelderwal werd de weg van Franeker naar Menaldum aangelegd. In de directe omgeving van de kerk staan enkele van oorsprong 17de- en 18de-eeuwse eenlaags woonhuizen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01272> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Peins (gemeente Franekeradeel)"@nl ;
        min:adres "Dorpsstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Peins (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Peins" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12678> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15862" ;
        min:soort "inleiding" ;
        min:volgnummer 1272 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill356> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0144> ;
        schema:name "Peins (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "254" ;
        schema:pagination "254-255" ;
        schema:text "De Herv. kerk (Dorpsstraat 2), oorspronkelijk gewijd aan St. Gertrudis, is een eenbeukige kerk met driezijdig gesloten koor en een houten geveltoren. Bij de ingrijpende verbouwing in 1865 zijn van de middeleeuwse kerk enkele delen van de rond 1300 gebouwde noord- en zuidmuur en een gedeelte van de westmuur behouden gebleven. Rond 1910 is de westgevel gewijzigd. In de geveltoren hangt een door Jurriën Balthasar gegoten klok (1654). De kerk bevat een door L. van Dam & Zn. gebouwd orgel (1867)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01273> a min:Passage,
            schema:CreativeWork ;
