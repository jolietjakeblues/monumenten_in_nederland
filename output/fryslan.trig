        min:hoofdstuk "Steden, dorpen, monumenten › Wijnjewoude (Wynjewâld) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijnjewoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1606 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Dun bebouwd streekdorp, ontstaan op een zandrug waar in de late middeleeuwen verspreide bebouwing ontstond met als kernen Duurswoude en Wijnjeterp. Ongeveer midden tussen de beide kerken van dit gecombineerde dorp (de Molenbuurt) ontstond in de 19de eeuw enige verdichting en bouwde men de Geref. kerk. Aan de zuidzijde werd in 1767 voor de Opsterlandse Compagnievaart de vierde of Wijnjeterperverlaat gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01607> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        min:adres "Breeberchspaed 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijnjewoude (Wynjewâld) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijnjewoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42376> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31839" ;
        min:soort "inleiding" ;
        min:volgnummer 1607 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill453> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "De Herv. kerk (Breeberchspaed 1, Duurswoude), oorspronkelijk gewijd aan St. Johannes, is een eenbeukige laat-gotische kerk met steunberen, driezijdig gesloten koor en een houten geveltoren. De mogelijk in oorsprong 13de-eeuwse kerk werd met gebruik van oude kloostermoppen opgetrokken in de 15de eeuw herbouwd en eind 18de eeuw gewijzigd. De in 1885 aangebrachte bepleistering is bij de restauratie in 1990 verwijderd. De kerk bevat een sobere laat-18de-eeuwse preekstoel. Het orgel werd rond 1723 gemaakt door Frans Caspar en Johan Georg Schnitger voor de Evang. Luth. kerk te Zwolle en in 1917 - in veranderde staat - overgebracht. Op het kerkhof bevinden zich enkele hartvorige ijzeren graftekens. De predikantenwoning (Breeberchspaed 1) op het kerkhof is een eenkamerwoning uit 1759."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01608> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        min:adres "Tsjerkereed 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijnjewoude (Wynjewâld) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wijnjewoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58143> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31869" ;
        min:soort "inleiding" ;
        min:volgnummer 1608 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "De Herv. kerk (Tsjerkereed 2, Wijnjeterp) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1778 in opdracht van Daniël de Block-Lycklama à Nijeholt ter vervanging van een kerk uit 1723. De kerk is in 1984 gerestaureerd. Tot de inventaris behoren een fraaie preekstoel (1778) in Lodewijk XVI-stijl, met op de kuip voorstellingen van Mozes en de vier evangelisten. Uit dezelfde tijd zijn het doophek en de herenbank."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01609> a min:Passage,
