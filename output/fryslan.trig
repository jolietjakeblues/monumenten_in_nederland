    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01174> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldeholtpade (gemeente Weststellingwerf)"@nl ;
        min:adres "Kerkweg 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeholtpade (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeholtpade" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1174 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0127> ;
        schema:name "Oldeholtpade (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "De Herv. kerk van Nijeholtpade (Kerkweg 4), gelegen ten noordoosten van Oldeholtpade, is een lage laat-gotische eenbeukige kerk met driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde naaldspits. De oorspronkelijk aan St. Nicolaas gewijde kerk werd begin 16de eeuw gebouwd. De vermoedelijk gelijktijdig gebouwde toren had oorspronkelijk aan de voet drie openingen, maar deze zijn waarschijnlijk in de 17de eeuw gedicht; in de 18de eeuw verrees aan de westzijde een overhoekse steunbeer. In de toren hangen een door Willem Wegewaert gegoten klok (1598) en een klok van Gheraert Koster (1611). Tot de kerkinventaris behoren een doophek (circa 1660) en een door J.F. Kruse gebouwd orgel (1883). Op het kerkhof bevindt zich een zerk met zeis en zandloper voor de gebroeders T.K. Buitinga († 1881) en H.K. Buitinga († 1883)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0127.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01175> a min:Passage,
