        min:hoofdstuk "Steden, dorpen, monumenten › Wierum (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wierum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1592 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0195> ;
        schema:name "Wierum (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "310" ;
        schema:pageStart "310" ;
        schema:pagination "310" ;
        schema:text "Terpdorp, ontstaan in de vroege middeleeuwen. Van de lage, rechthoekige terp is de noordelijke hoek ooit in de Waddenzee verdwenen, waardoor de kerk wat excentrisch is komen te liggen. In de 18de eeuw was het een bloeiend vissersdorp. Ondanks de vestiging van een visserijschool (1917-'33) verdween de visserij na de Tweede Wereldoorlog. In de rond 1970 op Deltahoogte gebrachte zeedijk herinnert een eenvoudig monument aan de stormramp van 1893, waarbij de vissersvloot werd weggevaagd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01593> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wierum (gemeente Dongeradeel)"@nl ;
        min:adres "Tsjerkeplein 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wierum (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wierum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42396> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38739" ;
        min:soort "inleiding" ;
        min:volgnummer 1593 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0195> ;
        schema:name "Wierum (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "310" ;
        schema:pageStart "310" ;
        schema:pagination "310" ;
        schema:text "De Herv. kerk (Tsjerkeplein 4), oorspronkelijk gewijd aan Maria, is een driezijdig gesloten zaalkerk met een ingebouwde zadeldaktoren. Rond 1200 kwam een tufstenen kerk met gereduceerd westwerk tot stand, waarbij de toren en de aangrenzende zijruimten zowel op de begane grond als op de verdieping met de kerk in verbinding stonden. De openingen op de verdieping werden in de 17de en 18de eeuw dichtgemaakt en deels beklampt. In de in 1819 vernieuwde zadeldakbeïndiging hangt een door Gregorius van Hall gegoten klok (1611). Het romaanse schip en koor zijn in 1911-'13 door nieuwbouw vervangen. De toren is in 1984 gerestaureerd naar plannen van R. Kijlstra. Op het kerkhof liggen onder meer enkele fragmenten van 17de eeuwse zerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0195.php> .

