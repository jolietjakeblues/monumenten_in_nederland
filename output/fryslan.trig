        min:volgnummer 648 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0063> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "Woonhuizen. Het dubbele eenlaagspand De Tuije 4 heeft mogelijk een 18de-eeuwse oorsprong. Voorbeelden van middenganghuizen met eclectische details zijn: Greate Buorren 56 (circa 1870), Greate Buorren 64 (circa 1880) en Lytse Buorren 4 (1874). Jugendstildetails hebben het woonhuis Westerein 14 (1908) en de in 1915 gebouwde directeurswoning Eendrachtsweg 7 van zuivelfabriek ‘De Eendracht’. Meer expressieve details vertoont het huis Inialoane 15 (1923)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00649> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Garyp (Garijp) (gemeente Tytsjerksteradiel) – Boerderijen"@nl ;
        min:adres "Easterein 29" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Garyp (Garijp) (gemeente Tytsjerksteradiel)" ;
