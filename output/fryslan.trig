        min:hoofdstuk "Steden, dorpen, monumenten › Blesdijke (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blesdijke" ;
        min:lemma "De Blesse" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14159> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "527616" ;
        min:soort "lemma" ;
        min:volgnummer 349 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0026-01> ;
        schema:name "De Blesse"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De Blesse. Dit dorp ten oosten van Blesdijke is begin 19de eeuw ontstaan aan de weg van Wolvega naar Steenwijk. De Herv. kapel (Steenwijkerweg 66) is een gepleisterd zaalgebouw uit circa 1880. De windmolen ‘De Mars’ (Steenwijkerweg 50) is een met riet gedekte achtkantige stellingmolen met stenen onderbouw. De in 1834 gebouwde korenmolen is in 1927 van zijn wiekenkruis ontdaan en in 2000 gerestaureerd. Hiervoor is een uit Zwarte Haan afkomstig, in 1877 gebouwd achtkant gebruikt. Het blokvormige trafohuisje (Steenwijkerweg 61) dateert uit circa 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00350> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blessum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
