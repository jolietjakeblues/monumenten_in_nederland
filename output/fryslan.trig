        schema:name "Stiens (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "288" ;
        schema:pagination "288-289" ;
        schema:text "De Chr. lagere school ‘Paedwizer’ (Petterhûsterdyk 13) is een school van vier klassen, gebouwd in 1930 ter vervanging van een oudere school uit 1873 (Hynstewead 37)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01448> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stiens (gemeente Leeuwarderadeel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Leeuwarderadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stiens (gemeente Leeuwarderadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Stiens" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1448 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0169> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "Woonhuizen. Het eenlaagspand It Achterbosk 25 is voorzien van de jaartalankers ‘1721’. Sober neoclassicistisch van vorm is het herenhuis Smelbrêge 15 uit 1851. Het rond 1850 gebouwde eenlaags huis Smelbrêge 6 heeft een forse dakkapel met fronton en ionische pilasters. Voorbeelden van middenganghuizen met eclectische details zijn: Uniawei 13 (1864), P. Jellessingel 13 (circa 1870) en Uniawei 29 (circa 1890). Het woonhuis Langebuorren 5 is rond 1900 opgetrokken in neorenaissance-stijl. Jugendstil-vormen hebben Langebuorren 33, gebouwd in 1907 als notariswoning met kantoor, het herenhuis Uniawei 19 (1910) met hoektoren, de winkel Smelbrêge 3 (circa 1910) en de dubbele burgerwoning Uniawei 3-5 (circa 1910). Zakelijk expressionistisch van vorm is het herenhuis Uniawei 43 (circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0169.php> .

