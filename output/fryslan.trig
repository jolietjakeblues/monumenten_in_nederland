        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Terpdorp met een blokvormige verkaveling, ontstaan in de vroege middeleeuwen en oorspronkelijk als Wildinghe aangeduid. De terp is gedeeltelijk afgegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0204.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01660> a min:Passage,
            schema:CreativeWork ;
