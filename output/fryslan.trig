        min:volgnummer 460 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0040> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text """Boerderijen. Een mogelijk 18de-eeuwse oorsprong hebben de kop-rompboerderijen Gerritsma Sathe (Het Meer 138) en Ds. Veenweg 179. De boerderijen Ds. Veenweg 60 (1872) en Ds. Veenweg 50 (1882) zijn voorzien van een voorhuis in eclectische vormen.

De Oude Isr. begraafplaats van Heerenveen (bij Veensluis 23) werd in 1824 gesticht en bevat vijf grafstenen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00461> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Knipe (gemeente Heerenveen) – Bontebok"@nl ;
        min:adres "Eerste Compagnonsweg 11",
            "Eerste Compagnonsweg 16" ;
