        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lemmer (De Lemmer) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Lemmer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60183> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "25748" ;
        min:soort "inleiding" ;
        min:volgnummer 985 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill302> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0101> ;
        schema:name "Lemmer (De Lemmer) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Het voorm. raadhuis annex waag (Nieuwburen 1) werd rond 1770 gebouwd als een tweelaags blokvormig pand met aangebouwd eenlaags waaggedeelte. Vanaf 1810 was in het raadhuis ook het kantongerecht gevestigd. De waag kreeg in 1859 een verdieping. In 1898 verplaatste men de ingang van het raadhuis naar de zijde aan de Gedempte Gracht, waar een nieuwe voorgevel met neoclassicistische vormen werd opgetrokken. De ingang heeft een klein, overdekt natuurstenen bordes met trappen. De overhuiving op corintische zuilen is voorzien van het grietenijwapen van Lemsterland. Inwendig bevindt zich in de voorm. burgemeesterskamer een door J.C.W. Becker geschilderd schoorsteenstuk (1793)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0101.php> .

