        schema:name "Goënga (Goaiïngea) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "De voorm. openbare lagere school (Goaijengeamieden 5) uit 1887 is een tweeklassige school met aangebouwde onderwijzerswoning, voorzien van een sierspant met chalet-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0066.php> .

