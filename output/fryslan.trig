        min:volgnummer 1088 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0115> ;
        schema:name "Munnekeburen (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "234" ;
        schema:pagination "234" ;
        schema:text "Streekdorp, ontstaan langs de Padsloot in het veengebied van de Westhoek. In de 19de eeuw concentreerde de bebouwing zich aan de westelijker gelegen Grintweg, die de verbinding van Wolvega met Schoterzijl vormde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0115.php> .

