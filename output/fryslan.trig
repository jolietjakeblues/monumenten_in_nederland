        schema:name "Marssum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "Rond de kerk ligt een verhoogd kerkhof omgeven door een gietijzeren hekwerk. De pastorie met consistorie (Buorren 18) dateert uit circa 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

