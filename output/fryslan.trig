        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0075> ;
        schema:name "Haulerwijk (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text "Langgerekt veenkoloniaal dorp, ontstaan langs de in 1756 door de Drachtster Compagnie gegraven Haulerwijkstervaart. Het dun bebouwde lint bestaat uit een westelijk deel (Haulerwijk Beneden) een een oostelijk deel (Haulerwijk Boven). Na de Tweede Wereldoorlog is bij de kruising met de weg van Oosterwolde naar Leek een dorpskern ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00749> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haulerwijk (gemeente Ooststellingwerf) – Kerken"@nl ;
        min:adres "Hoofdweg Boven 77",
            "Kerkstraat 13",
            "Leeksterweg 23",
            "Norgerweg 49" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haulerwijk (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Haulerwijk" ;
        min:lemma "Kerken" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 749 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0075> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text """Kerken. Uit 1852 dateert de Herv. kerk (Kerkstraat 13), een sobere recht gesloten zaalkerk met houten geveltoren. De Doopsgez. kerk (Norgerweg 49) is een recht gesloten zaalkerk uit 1925. De in 1929-'30 gebouwde Geref. kerk (Hoofdweg Boven 77) is een kruiskerk met dakruiter, uitgevoerd in zakelijk-expressionistische vormen naar plannen van F. Offringa.

De openbare lagere school (Leeksterweg 23) is een drieklassige gangschool uit circa 1930."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00750> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haulerwijk (gemeente Ooststellingwerf) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 76" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haulerwijk (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Haulerwijk" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 750 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0075> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text """Woonhuizen. De arbeiderswoning Kerkstraat 60 met afgewolfde topgevel stamt uit circa 1890. Expressionistische elementen hebben de woonhuizen Leeksterweg 14-16 (1923) en Leeksterweg 13 (1932).

De Herv. kerk van Haule (Dorpsstraat 76), gelegen ten zuidwesten van Haulerwijk, is een driezijdig gesloten zaalkerk met open dakruiter, gebouwd in 1854 naar plannen van H.J. Noorman."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00751> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeg (Heech) (gemeente Wymbritseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heeg (Heech) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Heeg" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 751 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0076> ;
        schema:name "Heeg (Heech) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text "Dorp, ontstaan in de middeleeuwen aan een knooppunt van doorgaande waterwegen naar Stavoren, Sneek, Woudsend en Lemmer. De nederzetting wordt voor het eerst vermeld in 1132 als Haghekercke. De belangrijkste bronnen van bestaan waren scheepvaart en handel in hooi en paling. De bebouwing aan de Harinxmastrjitte en de stegen aan de noordzijde werd in de loop van de tijd verdicht en heeft een overwegend 18de- en 19de eeuws karakter. Na de aanleg van de weg naar Osingahuizen (en Sneek en Lemmer) in 1846 werd De Skatting bebouwd. Vanaf de tweede helft van de 19de eeuw ontstond er bebouwing op de gedempte Suderhaven en rond 1900 op de nieuw aangelegde Nijewâl. Na de Tweede Wereldoorlog ontwikkelde Heeg zich tot watersportcentrum, met aan de zuid- en oostzijde forse jachthavens en aan de zuidzijde een bungalowpark (1971). Aan de noordzijde van Heeg kwam een nieuwe woonwijk tot stand. Heeg is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00752> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeg (Heech) (gemeente Wymbritseradiel)"@nl ;
        min:adres "Harinxmastrjitte 8",
            "Tsjerkebuorren 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
