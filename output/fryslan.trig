        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text "De Heremastate (Marktweg 75) is een statig gepleisterd landhuis in eclectische vormen met hoger opgaand middendeel afgesloten met een fronton. Het huis werd in 1829 gebouwd voor Fokke Bienema, rond 1910 verbouwd en in 1974 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0140.php> .

