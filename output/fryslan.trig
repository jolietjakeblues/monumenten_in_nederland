        min:volgnummer 439 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van onze jaartelling op een kwelderwal van de Boorneboezem (Middelzee). In de vroege middeleeuwen bouwde men hier een kerk en in de volle middeleeuwen aan de oostzijde van de terp de Martenastate. De terp is aan de noordwestzijde sterk afgegraven. Na de Tweede Wereldoorlog is hier een woonwijk gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00440> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        min:adres "De Wier 7" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
