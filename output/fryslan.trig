        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. Langs de uitvalswegen vond in de 19de en 20ste eeuw enige uitbreiding plaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01001> a min:Passage,
