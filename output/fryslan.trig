        min:soort "inleiding" ;
        min:volgnummer 668 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0067> ;
        schema:name "Gorredijk (De Gordyk) (gemeente Opsterland)"@nl ;
        schema:pageEnd "143" ;
        schema:pageStart "143" ;
        schema:pagination "143" ;
        schema:text "De Herv. kerk (De Leijen 29, Kortezwaag) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1797. De dakruiter en het portaal stammen uit 1896. De kerk bevat een 17de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0067.php> .

