        min:soort "inleiding" ;
        min:volgnummer 241 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0012> ;
        schema:name "Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een zandrug nabij de plaats waar de weg van Leeuwarden naar Dokkum de Murk kruist. In de 17de eeuw werden bij het dorp drie states gebouwd. De Aysmastate bleef - in verbouwde staat - bewaard. De Camminghastate en de Sminiastate zijn respectievelijk eind 18de eeuw en in 1916 gesloopt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)"@nl ;
        min:adres "Van Sminiawei 29" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldtsjerk" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 242 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0012> ;
        schema:name "Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "De Herv. kerk (Van Sminiawei 29), oorspronkelijk gewijd aan St. Paulus, is een gedeeltelijk gepleisterde eenbeukige kerk met driezijdig gesloten koor en zadeldaktoren van twee geledingen. De in het midden van de 12de eeuw opgetrokken bakstenen kerk heeft een tufstenen bekleding en had mogelijk een gereduceerd westwerk. Bij een vergroting en verhoging in de tweede helft van de 16de eeuw kreeg de kerk zijn huidige kapconstructie. De vensters van het schip zijn in de 18de eeuw vernieuwd, de huidige gepleisterde koorsluiting dateert uit de 19de eeuw. De bakstenen toren, voorzien van met tufsteen beklede spaarvelden, stamt uit het begin van de 13de eeuw. De oostelijke topgevel heeft romano-gotische vormen met klimmende rondboognissen en spaarvelden met siermetselwerk. Bij het herstel van de toren in 1721 ontstond de huidige zadeldakbeëindiging met zandstenen voluten. Toen, of bij herstelwerkzaamheden in 1849, is de westelijke top vernieuwd. De toren werd in 1976-'77 gerestaureerd. In de toren hangen twee klokken; de ene gegoten door Gregorius van Hall (1611), de andere door Petrus Overney (1671)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldtsjerk" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 243 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0012> ;
        schema:name "Aldtsjerk (Oudkerk) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Tot de gaaf bewaarde kerkinventaris behoren een rijk gesneden maniëristische preekstoel (1630; gerestaureerd in 1900), een doopbekken (circa 1630), een Tien Gebodenbord (1637), vier 17de-eeuwse herenbanken, waarvan één met de wapens van Aylva en Eysinga, een weelderig gesneden overhuifde herenbank met opzetstuk en hoekvazen (circa 1700), twee beschilderde rouwborden (1734 en 1782) en een door Bakker & Timmenga gebouwd orgel (1883). Verder bevat de kerk 16de- en 17de-eeuwse grafzerken en de grafkelder van de familie Van Sminia."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00244> a min:Passage,
