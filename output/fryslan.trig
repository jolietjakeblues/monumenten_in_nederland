        schema:name "Horeca"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Horeca. Uit 1899 dateert het pension ‘Konditorei’ (Van Heeckerenstraat 1). De herberg ‘Van Heeckerenshuys’ (Van Heeckerenstraat 11) is een eenlaagspand uit circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01113> a min:Passage,
