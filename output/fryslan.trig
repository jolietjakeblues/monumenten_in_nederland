        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudemirdum (Aldemardum) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oudemirdum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1245 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0139> ;
        schema:name "Oudemirdum (Aldemardum) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "251" ;
        schema:pageStart "251" ;
        schema:pagination "251" ;
        schema:text "De Rinia-State (Star Numanswei 7-9) is een gepleisterd neoclassicistisch landhuis, gebouwd in 1843 naar ontwerp van Th.A. Romein voor de weduwe Drieling. Het huis, bestaande uit een hoger opgaand middendeel met fronton en aan weerszijden een lagere vleugel, heeft aan de voorzijde een driezijdige erker met balkon."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01246> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudemirdum (Aldemardum) (gemeente Gaasterlân-Sleat) – Woonhuizen"@nl ;
        min:adres "J. Schotanuswei 40",
            "Kippenburg 4",
            "Kippenburg 5" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudemirdum (Aldemardum) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oudemirdum" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50490> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15929" ;
        min:soort "lemma" ;
        min:volgnummer 1246 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0139> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text """Woonhuizen. Het eenlaagspand Brink 1 is een in 1910 gebouwd woonhuis met voorm. winkelgedeelte. Rond 1920 gebouwd zijn de vrijstaande eenlaags huizen Simmerwille (J. Schotanuswei 40) en J. Schotanuswei 98, de laatste met expressionistische vormen.

De luchtmacht-uitkijktoren (Huningspaed ong.), gelegen op het hoogste punt in Gaasterland, werd in 1953 gebouwd in prefab-beton volgens het Raat-systeem naar een standaardontwerp van architectenbureau M. Zwaagstra. De uitkijktoren is in 1992 gerestaureerd.

De voorm. herberg ‘Kippenburg’ (Kippenburg 5), gelegen ten noordoosten van Oudemirdum in het gelijknamige buurtschap, is een tweebeukig, wit geschilderd pand uit 1850 met aan de achterzijde een houten uitbouw op kolommen. De naastgelegen stelpboerderij (Kippenburg 4) dateert uit circa 1910."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01247> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudemirdum (Aldemardum) (gemeente Gaasterlân-Sleat) – Nijemirdum (Nijemardum)"@nl ;
        min:adres "Lyklamawei 11",
            "Lyklamawei 18",
            "Lyklamawei 34",
            "Lyklamawei 36" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
