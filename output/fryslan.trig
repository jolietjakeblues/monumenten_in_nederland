        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijs (Riis) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Rijs" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1318 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0153> ;
        schema:name "Rijs (Riis) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Dorp, ontstaan in de 12de of 13de eeuw op een zandrug. Ter plaatse van een rond 1500 gestichte uithof van de St.-Odulphusabdij te Hemelum werd eind 17de eeuw het Huis Rijs gebouwd (gesloopt in 1937). Rond 1850 kwam daar een kleine bebouwingskern tot ontwikkeling. Rijs bestaat verder uit verspreide bebouwing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01319> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijs (Riis) (gemeente Gaasterlân-Sleat)"@nl ;
        min:adres "Murnserleane 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijs (Riis) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Rijs" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35125> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15932" ;
        min:soort "inleiding" ;
        min:volgnummer 1319 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill363> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0153> ;
        schema:name "Rijs (Riis) (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Het Rijster Bos (Murnsterleane ong.) behoorde bij het laat-17de-eeuwse landhuis Huis Rijs, dat in 1937 werd gesloopt. Het bos werd in de tweede helft van de 17de eeuw in opdracht van Hiob de Wildt aangelegd en rond 1850 in landschappelijke stijl uitgebreid voor de familie Van Swinderen. In het bos staat een zeszijdig neoclassicistisch Vredestempeltje (Murnserleane 1), oorspronkelijk gebouwd in 1814 ter herinnering aan de bevrijding van de Fransen. Het tempeltje is diverse keren herbouwd, zoals in 1976-'77 naar ontwerp van H. Oud."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01320> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijs (Riis) (gemeente Gaasterlân-Sleat) – Woonhuizen"@nl ;
        min:adres "Enkhuizerlaan 6",
            "Freule van Swinderenlaan 1",
            "Marderleane 1",
            "Marderleane 2",
            "Mientwei 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijs (Riis) (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Rijs" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1320 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0153> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text """Woonhuizen. Het gepleisterde eenlaagspand Marderleane 43 is een voorm. brugwachterswoning uit circa 1875. De forse, deels gepleisterde villa Mooi Gaasterland (Marderleane 1) kwam in 1912 tot stand voor de Maatschappij Gaasterland als woonhuis annex kantoor naar een ontwerp met chaletstijl-invloeden van M.J. van den Schilden. De kapel op het terrein is in 1937 gebouwd voor de toenmalige eigenaar, de Utrechtse Diocesane Bond der Katholieke Arbeiders Beweging. Nu is er een medisch kindertehuis gevestigd. De gepleisterde villa Rijsterbosch (Marderleane 2) met late jugendstil-elementen dateert uit circa 1915. In zakelijk-expressionistische stijl gebouwd is de villa Huize Rys (Freule van Swinderenlaan 1) uit 1937. In het Rijster Bos zijn in de jaren dertig en vijftig van de 20ste eeuw enkele houten recreatiewoningen gebouwd, zoals Nooit-Gedacht (Enkhuizerlaan 6) met expressionistische invloeden.

Het voorm. logement (Mientwei 1), thans ‘Hotel Jans’, is een gepleisterd pand uit 1890."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0153.php> .

