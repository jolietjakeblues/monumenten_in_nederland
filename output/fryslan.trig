        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0167> ;
        schema:name "Sondel (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "Streekdorp, ontstaan in de 12de of 13de eeuw op een zandrug. Via de Sondelervaart en de weg naar Tacozijl kreeg Sondel zowel over land als over water verbinding met de Zuiderzee (nu IJsselmeer). Na 1850 is de bebouwing langs de doorgaande weg (Beuckenswijkstraat) verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0167.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01435> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sondel (gemeente Gaasterlân-Sleat)"@nl ;
        min:adres "Beuckenswijkstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sondel (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sondel" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1435 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0167> ;
        schema:name "Sondel (gemeente Gaasterlân-Sleat)"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "De Herv. kerk (Beuckenswijkstraat 2) is een driezijdig gesloten zaalkerk voorzien van een kleine, met zink beklede, geveltoren met ingesnoerde naaldspits. De kerk werd in 1870 gebouwd op de fundamenten van een voorganger. In de toren hangt een 14de-eeuwse klok. Tot de inventaris behoren een 17de-eeuwse preekstoel, een overhuifde herenbank en een door Bakker & Timmenga gebouwd orgel (1897). Op het kerkhof bevinden zich onder meer dertien 19de- en 20ste-eeuwse grafstenen met wapens van de families De Carpentier en De Rochefort."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0167.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01436> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sondel (gemeente Gaasterlân-Sleat) – Boerderijen"@nl ;
        min:adres "Beuckenswijkstraat 11",
            "Beuckenswijkstraat 26" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sondel (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sondel" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47992> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15934" ;
        min:soort "lemma" ;
        min:volgnummer 1436 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0167> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text """Boerderijen. Uit de 18de eeuw dateren de kop-rompboerderij Beuckenswijkstraat 8 en de kop-halsrompboerderij J. Boomsmastraat 5 met naastgelegen bakhuis. Beide hebben een melkkelder onder het voorhuis. De stelpboerderij Beuckenswijk (Beuckenswijkstraat 11), met dakkapel uit circa 1890, heeft in de voorgevel twee grote gedenkstenen uit 1780 en 1785, afkomstig uit het voormalige huis Beuckenswijk, waarop onder meer het wapen van de familie Hylkama is afgebeeld. Andere voorbeelden van stelpboerderijen zijn J. Boomsmastraat 16 (circa 1860), met forse melkkelder, en de traditionalistische boerderij J. Boomsmastraat 64 (circa 1925).

Het voorm. radarkamp (Beuckenswijkstraat 26) dateert uit de Tweede Wereldoorlog. Het bestaat uit zestien, rond 1942 gebouwde, deels ondergrondse bakstenen schuilplaatsen met platte daken. Het complex is thans als recreatiepark in gebruik."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0167.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01437> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stavoren (Starum) (gemeente Nijefurd)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stavoren (Starum) (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Stavoren" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1437 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill409> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0168> ;
        schema:name "Stavoren (Starum) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "286" ;
        schema:pagination "286-287" ;
        schema:text "Kleine stad, ontstaan in de 9de eeuw aan de Zuiderzeekust. Het vroeg-middeleeuwse gedeelte van de nederzetting is bij een overstroming verloren gegaan. De huidige rechthoekige stadsstructuur, evenwijdig aan de kust, kwam in de 11de en 12de eeuw tot stand langs de Voordelft toen Stavoren zich ontwikkelde tot belangrijke haven- en handelsstad. Stavoren kreeg vóór 1077 stadsrechten en is daarmee de oudste stad van Friesland. De eerst onder Hollands bestuur staande stad werd in 1414 definitief Fries en trad toen toe tot het Hanzeverbond. Nog in de middeleeuwen kwam er een einde aan de bloeitijd van Stavoren. Rond 1585 legde men rondom de stad verdedigingswerken aan met een stadspoort, vijf bastions en ten oosten van de Achtergracht - tot dan toe de buitengracht van de stad - de thans nog aanwezige stadsgracht langs De Schans. Mede door de verdere economische neergang in de loop van de 18de eeuw en 19de eeuw werd een groot deel van de bebouwing in de binnenstad afgebroken. De in 1883-'85 aangelegde spoorlijn van Leeuwarden naar Sneek en Stavoren sloot aan de noordzijde van de stad aan op het spoorveer naar Enkhuizen. Na de Tweede Wereldoorlog is in het dun bebouwde zuidelijke stadsdeel de open ruimte met nieuwbouw opgevuld en is de stad buiten de stadsgracht aan de oostzijde uitgebreid. In de jaren zestig zijn aan de zuidzijde de Johan Frisosluis en het J.L. Hooglandgemaal aangelegd, en voor de belangrijk geworden watersport een jachthaven. Het havengebied aan de noordzijde wordt momenteel heringericht. Stavoren is een beschermd stadsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01438> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Stavoren (Starum) (gemeente Nijefurd)"@nl ;
        min:adres "Voorstraat 69" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Stavoren (Starum) (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Stavoren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55538> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "460742" ;
        min:soort "inleiding" ;
        min:volgnummer 1438 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0168> ;
        schema:name "Stavoren (Starum) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "De Herv. kerk (Voorstraat 69), gelegen achter de bebouwing van de Voorstraat, is een driezijdig gesloten zaalkerk voorzien van een kleine geveltoren en een neoclassicistische ingangsomlijsting. De kerk werd in 1861 gebouwd naar ontwerp van meester-timmerman J.A. Bokma ter vervanging van een 16de-eeuwse voorganger. In de geveltoren hangt een door Hans Falck gegoten klok (1629). De kerk bevat een door Meije en Wiebe Meijes met gebruik van oudere kastdelen en pijpwerk gebouwd orgel (1785)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01439> a min:Passage,
            schema:CreativeWork ;
