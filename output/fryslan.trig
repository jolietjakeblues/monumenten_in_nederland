        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Metslawier (Mitselwier) (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Metslawier" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44252> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31583" ;
        min:soort "inleiding" ;
        min:volgnummer 1055 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0110> ;
        schema:name "Metslawier (Mitselwier) (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "De Herv. kerk (Tsjerkebuorren 7) is een driezijdig gesloten zaalkerk voorzien van een ingebouwde toren met ingesnoerde spits. De kerk werd in 1776 gebouwd ter plaatse van een middeleeuwse voorganger. In de in 1925 herstelde toren hangt een door Petrus Overney gegoten klok (1711). Tot de kerkinventaris behoren een preekstoel (1776), een mogelijk door Yge Rintjes van snijwerk voorziene dubbele herenbank met rococokrul (1777), een rijk gesneden rouwbord in Lodewijk XVI-vormen voor Johannes Casparus Bergsma († 1793) en een door J. Radersma gebouwd orgel (1819), afkomstig uit de kerk te Spannum (geplaatst in 1913). Verder bevat de kerk een door H.G. vervaardigde zerk in vroege renaissance-vormen voor Worp van Ropta († 1551) en Wick van Abinga († 1534) en een portretzerk voor Christoffel van Sternsee († 1560) en Cunera van Ropta († 1555)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0110.php> .

