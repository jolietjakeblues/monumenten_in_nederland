        schema:pageEnd "117" ;
        schema:pageStart "117" ;
        schema:pagination "117" ;
        schema:text "De Geref. kerk (De Sannen 22) is een moderne kerk met vrijstaande toren, gebouwd in 1969 naar plannen van F. de Vries."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0047.php> .

