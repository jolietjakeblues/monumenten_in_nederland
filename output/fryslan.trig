        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 453 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "De voorm. openbare lagere school (Voorweg 92-94) is in 1903 gebouwd als een vierklassige gangschool met aangebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00454> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel) – Woonhuizen"@nl ;
        min:adres "Achterweg 50",
            "Achterweg 52",
            "Doniaweg 73",
            "Hoofdweg 42" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 454 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "103" ;
        schema:pagination "103-104" ;
        schema:text """Woonhuizen. In het dorp staan verschillende middenganghuizen met verhoogd middenrisaliet. In rijke eclectische vormen uitgevoerd is Doniaweg 33, dat in 1891 werd gebouwd als dokterswoning. Neoclassicistische vormen hebben Hoofdweg 41 (circa 1895) en Hoofdweg 33 (1901). Doniaweg 89 (1900) vertoont neorenaissance-details. Chaletstijl-vormen bezitten Hoofdweg 21 (1906), met sierspant, en Doniaweg 75 (circa 1895). Op de plaats van de uit 1765 stammende landhuis ‘Plantenhove’, liet notaris Hellema in 1906 in jugendstil-vormen de ruime villa Lina's hoeve (Doniaweg 73) bouwen. De geometrische tuinaanleg is door L.A. Springer ontworpen. Jugendstil-details hebben ook de vergelijkbare, rond 1910 gebouwde woonhuizen Hoofdweg 25 en 29. Van de villa Doniaweg 71 (circa 1915) vertoont vooral de ingang nieuw historiserende vormen. Het woonhuis Hoofdweg 64 is rond 1920 opgetrokken in traditionalistische vormen, waaronder een trapgevel.

Het logement ‘De Kruisweg’ (Hoofdweg 42) dateert uit 1881. Het forse blokvormige pand heeft een middenrisaliet met ingang en bovenliggend venster voorzien van een wenkbrauw. Aan de zuidzijde bevindt zich een loggia met overdekt balkon.

De voorm. zuivelfabriek ‘Dokkumer Wâlden en Omkriten’ (Achterweg 52) werd in 1899 gesticht en was tot 1969 in functie. Bewaard gebleven zijn de fabrieksschoorsteen, enkele gebouwdelen en een uit 1914 stammende directeurswoning (Achterweg 50)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00455> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel) – Broeksterwoude (Broeksterwâld)"@nl ;
        min:adres "Schwartzenbergerlaan 2",
            "Schwartzenberglaan 2",
            "Teneweg 11" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:lemma "Broeksterwoude (Broeksterwâld)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 455 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Broeksterwoude (Broeksterwâld)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Broeksterwoude (Broeksterwâld). Deze nederzetting ten zuiden van Damwoude is ontstaan bij de turfwinning in de 18de- en 19de-eeuw en is sinds 1964 een zelfstandig dorp. Aan de westzijde staan twee poldermolens, beide met riet gedekte achtkantige grondzeilers op veldmuren, voorzien van een vijzel. ‘De Broekmolen’ (bij Schwartzenbergerlaan 2), gebouwd in 1876 door W. Jurjen, bemaalde de voormalige Broekpolder en is in 1975 gerestaureerd. Uit 1887 dateert ‘De Grote Molen’ (Teneweg 11), gebouwd door molenbouwer G.R. van Wieren ter vervanging van een door brand verwoeste voorganger uit 1880. De molen is in 1994 voor het laatst gerestaureerd. Het door J. Bosklopper in 1936 vervaardigde gedenkmonument (bij Schwartzenberglaan 2) herinnert aan de eerste doop van bekeerlingen van de kerk van Jezus Christus van de Heiligen der Laatste Dagen in 1861."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00456> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Knipe (gemeente Heerenveen)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
