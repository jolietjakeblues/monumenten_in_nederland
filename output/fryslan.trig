        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "Woonhuizen. Uit circa 1860 dateert de éénkamerwoning Buorren 11. Voor een notabele gebouwd is het middenganghuis Buorren 13-15 uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00355> a min:Passage,
