        min:adres "De Hellingstraat 11",
            "Stationswei 40",
            "Tsjerkestrjitte 14",
            "Tsjerkestrjitte 7" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
