        min:volgnummer 1136 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0122> ;
        schema:name "Nijland (Nijlân) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "De eenlaags pastorie (Tsjerkegreft 1), met 16de-eeuwse elementen, dateert in de huidige vorm uit 1787, is in 1883 ingerijpend verbouwd naar ontwerp van A. Beunissen Troost en in 1937 verkleind."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01137> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijland (Nijlân) (gemeente Wymbritseradiel) – Scholen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijland (Nijlân) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nijland" ;
        min:lemma "Scholen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1137 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0122> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Scholen. De voorm. school Eile Polle 16 is een eenlaags gebouw dat mogelijk al in de 16de eeuw als school annex kosterswoning functioneerde. Het oudste gedeelte van de voorm. openbare lagere school Tsjerkegreft 5 dateert uit 1859. Deze werd in 1875 met een naai- en breischool uitgebreid. De huidige vorm met topgevels dateert uit 1953. De voorm. openbare lagere school met onderwijzerswoning Tsjerkegreft 15-17 dateert uit 1884. De Chr. lagere school Tramstrjitte 45 kwam in 1909 tot stand op een L-vormige plattegrond naar ontwerp van W.C. de Groot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01138> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijland (Nijlân) (gemeente Wymbritseradiel) – Woonhuizen"@nl ;
        min:adres "Ingenawei 1",
            "Tramstrjitte 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijland (Nijlân) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nijland" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1138 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0122> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Woonhuizen. De woningen, winkels en bedrijven aan de zuidzijde van de Tramstrjitte hebben een 19de-eeuws karakter, zoals Tramstrjitte 10, een woning met timmermansbedrijf uit 1874. Aan de overzijde staan de woonhuizen Tramstrjitte 35-39 uit 1908. Buxus Zathe (Tramstrjitte 6) is een rentenierswoning met dwars geplaatst voorhuis en een schuurgedeelte uit 1867 naar ontwerp van A. Breunissen Troost. De voorm. herberg en stalling (Ingenawei 1) uit 1872 naar ontwerp van A. Breunissen Troost is een geschilderd, sober neoclassicistisch pand met achteraanbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01139> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nijland (Nijlân) (gemeente Wymbritseradiel) – Boerderijen"@nl ;
        min:adres "Huniadijk 9",
            "Skiepeleane 1",
            "Tsjaerddyk 5" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nijland (Nijlân) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nijland" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1139 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0122> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "239" ;
        schema:pagination "239-240" ;
        schema:text """Boerderijen. Van de boerderij Hiddemawei 1 resteert het voorhuis met de jaartalankers ‘1785’. Interessante boerderijen aan de kerkring zijn de kophals-rompboerderij Tsjerkegreft 17, met onderkelderd voorhuis uit 1832 en een schuur uit 1868, en de vroeg-19de-eeuwse stelpboerderij Tsjerkegreft 7. In de omgeving van het dorp liggen enkele interessante boerderijen, waaronder de kop-hals-rompboerderij Huniasathe (Huniadijk 9) uit circa 1895, met een melkkelder onder het voorhuis en in de voorgevel een gevelsteen van het Weeshuis te Bolsward. Andere voorbeelden zijn de stelpboerderijen Olgastate (Skiepeleane 1; 1865), met melkkelder onder het voorhuis, en Trije Dyken 1 (1916), met hoger opgetrokken middengedeelte.

De twee kleine gemalen in de Tsjaerddyk (bij Tsjaerddyk 5 en 17), gelegen ten zuidoosten van Nijland, dateren uit circa 1930 en vertonen expressionistische invloeden."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01140> a min:Passage,
            schema:CreativeWork ;
