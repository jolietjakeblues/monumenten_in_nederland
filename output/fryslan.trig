        min:soort "lemma" ;
        min:volgnummer 1003 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0103> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Woonhuizen. Rond 1890 gebouwd is het eenlaags huis Elshoutbuurt 8 met forse dakkapel. It Fabryk 1 is in 1899 gebouwd als directeurswoning van de in 1897 opgerichte zuivelfabriek (in 1924 gesloten). Dwarse eenlaags huizen zijn: Noordereind 2 (circa 1900), Noordereind 1 (1911), met portiek en tot topgevel opgetrokken geveldeel, en Waaxenserweg 32 (1926), met portiek, erker en hoger opgetrokken geveldeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01004> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lollum (gemeente Wûnseradiel) – Boerderijen"@nl ;
        min:adres "Berghuizerweg 1",
            "Berghuizerweg 3",
            "Elshoutbuurt 7",
            "Hizzaarderlaan 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lollum (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Lollum" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48736> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39364" ;
        min:soort "lemma" ;
        min:volgnummer 1004 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0103> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text """Boerderijen. De in 1875 gebouwde kop-hals-rompboerderij Hizzaarderlaan 12 heeft een onderkelderd voorhuis en bouwdelen uit 1901. Klein Saxenoord (Hizzaarderlaan 3) is een stelpboerderij uit 1891.

De voorm. bakkerij (Elshoutbuurt 7) is een dwars eenlaagspand uit 1884.

De poldermolen ‘Meerswal’ (Berghuizerweg 1) is een achtkantige grondzeiler met bakstenen voet en een met riet gedekte houten romp en kap. De molen werd in 1903 gebouwd door I.H. Westra ter vervanging van een uit 1818 daterende voorganger. De molen bemaalt het gebied Rûgelollum en is in 1994 gerestaureerd. De molenaarswoning (Berghuizerweg 3) dateert uit 1910."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01005> a min:Passage,
