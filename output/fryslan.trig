        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kollum (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Kollum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14481> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "23739" ;
        min:soort "inleiding" ;
        min:volgnummer 899 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill254> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0096> ;
        schema:name "Kollum (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "185" ;
        schema:pageStart "185" ;
        schema:pagination "185" ;
        schema:text "De voorm. waag (Westerdiepswal 4) werd oorspronkelijk in 1614 aan de Diepswal gevestigd. In 1661 kreeg de Herv. kerk de waagrechten in bezit. Het huidige dwarse pand met achteraanbouw kwam tot stand bij de herbouw in 1779. Het met Lodewijk XV- en XVI-decoraties gevulde fronton draagt de wapens en namen van de bouwheren/kerkvoogden: Focke Hylkes Eskes, Martinus van Scheltinga, Albert Luitjes. Het pand is in 1895 verbouwd tot woonhuis en is in 1989 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00900> a min:Passage,
