        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0207> ;
        schema:name "Wyns (Wijns) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen en gelegen aan de Dokkumer Ee. In de loop van de tijd is de dorpsbebouwing enigszins verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0207.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01697> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wyns (Wijns) (gemeente Tytsjerksteradiel)"@nl ;
        min:adres "Wijns 31" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wyns (Wijns) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wyns" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1697 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill482>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill483> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0207> ;
        schema:name "Wyns (Wijns) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "328" ;
        schema:pageStart "327" ;
        schema:pagination "327-328" ;
        schema:text "De Herv. kerk (Wijns 31), oorspronkelijk gewijd aan St. Vitus, is een eenbeukige kerk met een zadeldaktoren van twee geledingen. Deze laat-romaanse kerk werd rond 1200 gebouwd. Het ten opzichte van het schip iets inspringende en hogere koor is inwendig halfrond en uitwendig vijfzijdig gesloten en heeft op de hoeken een kraalprofiel. De iets jongere toren is later aan drie zijden beklampt. De kerk is in 1974-'76 gerestaureerd en in 1999 heringericht. Het interieur wordt gedekt door een houten tongewelf uit het tweede kwart van de 16de eeuw. Tot de inventaris behoren een preekstoel (circa 1625) en een door Bakker & Timmenga gebouwd orgel (1899). Op het verhoogde kerkhof staat een baarhuisje uit circa 1890 tegen de noordzijde van de toren. Opvallend is een houten grafteken voor T.S. Andringa († 1911)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0207.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01698> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wyns (Wijns) (gemeente Tytsjerksteradiel) – Boerderijen"@nl ;
        min:adres "Wyns 14" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wyns (Wijns) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wyns" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62377> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35691" ;
        min:soort "lemma" ;
        min:volgnummer 1698 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0207> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "328" ;
        schema:pageStart "328" ;
        schema:pagination "328" ;
        schema:text """Boerderijen. De forse, aan de Dokkumer Ee gelegen, kop-hals-rompboerderij Wyns 28 stamt uit het midden van de 18de eeuw en is rond 1860 verbouwd. De boerderij Wyns 5 uit circa 1910 is een goed voorbeeld van een boerderij met dwars geplaatst voorhuis. De voorm. winkel annex woonhuis Wyns 39 is in 1911 gebouwd in sobere neorenaissance-stijl.

De poldermolen ‘Wynsermolen’ (Wyns 14), gelegen ten noordoosten van Wyns, is een met riet gedekte achtkantige grondzeiler op veldmuren. De in 1871 gebouwde molen, die voorheen de Wynserpolder bemaalde, is in 1994-'95 gerestaureerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0207.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01699> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wyns (Wijns) (gemeente Tytsjerksteradiel) – Bartlehiem"@nl ;
        min:adres "Bartlehiem 2",
            "Bartlehiem 35-37" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wyns (Wijns) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wyns" ;
        min:lemma "Bartlehiem" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1699 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0207> ;
        schema:name "Bartlehiem"@nl ;
        schema:pageEnd "328" ;
        schema:pageStart "328" ;
        schema:pagination "328" ;
        schema:text "Bartlehiem. Dit gehucht ten noorden van Wyns ontstond op de plaats waar de Finkumervaart in de Dokkumer Ee uitmondt. De naam is een verbastering van de naam van het nabij gelegen nonnenklooster Bethlehem (gesticht in 1175 en gesloopt in 1580). Het gehucht raakte bekend als doorgangsplaats in de Friese Elfstedentocht. De in 1893 gebouwde zuivelfabriek (Bartlehiem 35-37), met schoorsteen, is in 1977 verbouwd tot aannemerswerkplaats. De statige stelpboerderij ‘Ny Rhala’ (Bartlehiem 2) dateert uit 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0207.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01700> a min:Passage,
