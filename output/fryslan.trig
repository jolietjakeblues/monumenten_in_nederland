        min:volgnummer 696 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0071> ;
        schema:name "Hallum (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "147" ;
        schema:pageStart "147" ;
        schema:pagination "147" ;
        schema:text "Terpdorp met een radiale structuur, ontstaan enkele eeuwen voor het begin van onze jaartelling op een kwelderwal. Aansluitend hierop werd in de 11de of 12de eeuw een dijk aangelegd, waarover de wegen naar Marrum en Stiens lopen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00697> a min:Passage,
            schema:CreativeWork ;
