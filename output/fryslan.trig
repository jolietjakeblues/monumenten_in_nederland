        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Het raadhuis (Arumerweg 53) is een blokvormig pand uit 1879 met kroonlijst en middenrisaliet met portiek en balkon. Het gebouw is in 1980 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0201.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01631> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Witmarsum (Wytmarsum) (gemeente Wûnseradiel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Witmarsum (Wytmarsum) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Witmarsum" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1631 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0201> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "Woonhuizen. Het diepe eenlaags huis Kaatsplein 5 heeft een gebeeldhouwde klokgevel uit 1739. In de tweede helft van de 19de eeuw gebouwd zijn de arbeiderswoningen Arumerweg 61-81 (circa 1860) en het blokvormige eenlaagspand Van Aylvaweg 33 (circa 1870). Uit het begin van de 20ste eeuw dateren de diepe huizen Verlengde Oostend 2-28 (circa 1900), met overstekende zadeldaken, en de rond 1905 gebouwde diepe eenlaagspanden Arumerweg 89-91 en Arumerweg 51; de laatste met neorenaissance-details. Een hoger opgetrokken geveldeel met erker hebben het deels gepleisterde eenlaags huis Schoolstraat 21 (circa 1910) en het eenlaagspand Van Aylvaweg 18 (circa 1915). Ook de deels gepleisterde eenlaags woning Van Aylvaweg 42 (1919) heeft een uitspringend, verhoogd geveldeel. In 1921 als dokterswoning met praktijkruimte gebouwd is Arumerweg 15-17, een fors eenlaags huis met uitgebouwde veranda en loggia. Uit circa 1930 dateren de dubbele woning Van Aylvaweg 20-22, het huis Van Aylvaweg 26 en het dubbele eenlaagspand Schoolstraat 2-4."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0201.php> .

