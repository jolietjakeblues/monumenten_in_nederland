        min:soort "inleiding" ;
        min:volgnummer 602 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0057> ;
        schema:name "Exmorra (Eksmoarre) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "De voorm. Geref. kerk (Dorpsstraat 13) is een driezijdig gesloten zaalkerk uit 1890 met een half ingebouwde geveltoren voorzien van een met zink beklede ingesnoerde spits. De kerk heeft een jongere aanbouw aan de rechter zijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00603> a min:Passage,
