        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "Het voorm. postkantoor (Lageweg 17-19) dateert uit 1906 en is gebouwd naar plannen van rijksbouwmeester C.H. Peters, in simpele, op de neogotiek geënte vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00428> a min:Passage,
