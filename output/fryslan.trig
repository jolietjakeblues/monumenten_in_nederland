        min:adres "Martenawei 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Leeuwarderadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Cornjum (Koarnjum) (gemeente Leeuwarderadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Cornjum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77309> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "524386" ;
        min:soort "inleiding" ;
        min:volgnummer 442 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "De Martenastate (Martenawei 1) is een L-vormig eenlaags huis, waarvan de ingangstoren in de binnenhoek wordt bekroond door een ui-vormige spits. D.M. van Burmania Vegelin van Claerbergen liet de oorspronkelijke state in 1899 slopen en vervangen door het huidige huis in neorenaissance-vormen naar plannen van W.C. de Groot. Als toegangspoort dient de in 1955 gereconstrueerde poort van het in 1849 gesloopte Landschapshuis te Leeuwarden. Deze in maniëristische vormen uitgevoerde zandstenen poort uit 1620 heeft dorische halfzuilen voorzien van scharnierornamenten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00443> a min:Passage,
