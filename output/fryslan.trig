        schema:name "Workum (Warkum) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "De Baptistenkerk Beth El (Sud 52) [3] is een wit geschilderde zaalkerk met middenrisaliet, gebouwd rond 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0205.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01672> a min:Passage,
