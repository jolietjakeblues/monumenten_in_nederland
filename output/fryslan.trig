        min:volgnummer 577 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0053> ;
        schema:name "Easterwierrum (Oosterwierum) (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "124" ;
        schema:pagination "124-125" ;
        schema:text "Terpdorp, ontstaan in de vroege middeleeuwen bij de huidige Tsjerkebuorren. Mogelijk in de vroege 18de eeuw heeft de dorpskern zich in zuidelijke richting verplaatst naar de kruising van de Oosterwierumer Oudvaart en de Slachtedijk. Na 1850 is het dorp enigszins in noordwestelijke en zuidwestelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0053.php> .

