        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Het Herv. evangelisatielokaal (Rijksstraatweg 127) is een eenvoudig zaalgebouw met zakelijk-expressionistische details uit 1935."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00831> a min:Passage,
