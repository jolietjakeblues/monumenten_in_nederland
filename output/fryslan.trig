        min:volgnummer 216 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill61> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0009> ;
        schema:name "Akkrum (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "66" ;
        schema:pageStart "66" ;
        schema:pagination "66" ;
        schema:text "De klokkenstoel (Kleasterwei ong., Nes) op het verhoogd gelegen kerkhof van de in de 17de eeuw gesloopte kerk van Nes is een wit geschilderde houten klokkenstoel met helmdak. Erin hangt een door de gebroeders Van Bergen gegoten klok (1950)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00217> a min:Passage,
