        min:soort "inleiding" ;
        min:volgnummer 1123 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0119> ;
        schema:name "Nieuwehorne (Nijhoarne) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "De Herv. kerk (Schoterlandseweg 38) is een driezijdig gesloten zaalkerk met houten geveltoren en gepleisterde westgevel, gebouwd in 1778 in opdracht van grietman Daniël de Block van Scheltinga en hersteld rond 1850. In de geveltoren hangt een mogelijk 15de-eeuwse klok, gegoten door Johannes van Bomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01124> a min:Passage,
