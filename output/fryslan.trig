        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Streekdorp, ontstaan in de 18de eeuw langs de Aengwirderweg, die als ontginningsas voor het omringende land diende."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01484> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tjalleberd (Tsjalbert) (gemeente Heerenveen)"@nl ;
        min:adres "Pastoriesingel 1",
            "Pastoriesingel 6" ;
