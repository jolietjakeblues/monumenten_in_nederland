            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28710> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "515182",
            "527254" ;
        min:soort "lemma" ;
        min:volgnummer 839 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill238> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0088> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "176" ;
        schema:pagination "176-177" ;
        schema:text "Bedrijfsgebouwen. De voorm. zuivelfabriek ‘De Hem’ (Nyesyl 25-27) is opgericht in 1901. De directeurswoning uit die tijd vertoont chaletstijl-elementen. Van de voorm. schaatsenfabriek ‘Nooitgedagt’ (Eegracht 12) - gesticht in 1865 door J.J. Nooitgedagt en uitgegroeid tot gereedschapsfabriek - resteren enkele fabrieksgebouwen met vroege betonconstructies uit circa 1910. De voorm. schaatsenfabriek ‘Frisia’ (Uilenburg 1) is rond 1925 door de firma K.E. de Vries & Zn. gevestigd in een laat-19de-eeuwse pand, dat toen een nieuwe voorgevel met expressionistische elementen kreeg. De fabriek is tot 1993 in bedrijf geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00840> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJlst (Drylts) (gemeente Wymbritseradiel) – Windmolen"@nl ;
        min:adres "Sneekerpad 16" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJlst (Drylts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "IJlst" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41976> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39880" ;
        min:soort "lemma" ;
        min:volgnummer 840 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill239> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0088> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text """Windmolen ‘De Rat’ (Sneekerpad 16), gelegen aan de Geeuw, is een achtkantige, met riet beklede, stellingmolen. De rechthoekige onderbouw gaat aan weerszijden over in een langwerpige dubbele houten zaagloods op bakstenen poeren. De loodsen zijn voorzien van drie zaagramen en een sleephelling. De vóór 1680 gebouwde houtzaagmolen is in 1828 vanuit de Zaanstreek naar IJlst verplaatst. Na een periode van verval heeft men de molen tussen 1960 en 1978 weer bedrijfsvaardig gemaakt.

De Alg. begraafplaats (Kerkhofsteeg ong.) is ontstaan als kerkhof en na de verplaatsing van de kerk in 1830 in gebruik gebleven. De begraafplaats bevat een aantal interessante oude grafzerken, waaronder een vermoedelijk uit 1576 stemmende zerk met vroege-renaissancemotieven, twee grote wapenzerken uit 1670 en 1673 en een bijbelzerk voor ds. K. van der Beek († 1918)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00841> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "IJlst (Drylts) (gemeente Wymbritseradiel) – Oosthem (Easthim)"@nl ;
        min:adres "Cingel 1",
            "De Cingel 3",
            "Nessenwei 28" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › IJlst (Drylts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "IJlst" ;
        min:lemma "Oosthem (Easthim)" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23622>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62149> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39806",
            "515181" ;
        min:soort "lemma" ;
        min:volgnummer 841 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0088> ;
        schema:name "Oosthem (Easthim)"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "Oosthem (Easthim). Dit terpdorp ten westen van IJlst is ontstaan in de middeleeuwen en ligt aan de Bolswardervaart. De (Herv.) Johanneskerk (Cingel 1) is een zaalkerk met smallere, driezijdige koorsluiting en een ingebouwde, gepleisterde toren van drie geledingen met ingesnoerde spits. De in 1860 naar ontwerp van A. Breunissen Troost in neoclassicistische vormen gebouwde kerk verving een middeleeuwse voorganger. Tot de inventaris behoren een grafzerk voor de familie Bangama (1611) en een door W. van Gruisen gebouwd orgel (1838; gerestaureerd in 1958). De neoclassicistische pastorie (De Cingel 3) dateert is in 1866 gebouwd naar ontwerp van H.J. Jaarsma. De Geref. kerk (Nessenwei 28) is een driezijdig gesloten zaalkerk uit 1897, voorzien van een kleine houten geveltoren met ingesnoerde spits. Het door L. van Dam & Zn, gebouwde orgel (1840) is afkomstig uit de Doopsgez. kerk te Heerenveen (overgebracht in 1900). Het woonhuis De Clingel 5 is een waarschijnlijk rond 1880 als renteniershuis gebouwd eenlaags middenganghuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00842> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Jannum (Janum) (gemeente Ferwerderadiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
