        min:kern "Sumar" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1452 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill411> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0170> ;
        schema:name "Sumar (Suameer) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen als een verzameling verspreid gelegen boerderijen met een kleine kern bij de kerk. Aan de zuidzijde vonden in de 19de eeuw heideontginningen plaats. Na de Tweede Wereldoorlog is aan de noordzijde, langs het Prinses Margrietkanaal, een groot industrieterrein aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0170.php> .

