        min:hoofdstuk "Steden, dorpen, monumenten › Oranjewoud (Oranjewâld) (gemeente Heerenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oranjewoud" ;
