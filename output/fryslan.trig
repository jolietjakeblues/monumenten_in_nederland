        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "De Geref. kerk (Wynserdyk 35) is een recht gesloten zaalkerk met een half ingebouwde toren voorzien van een spits met frontalen. De met neogotische kenmerken uitgevoerde kerk is in 1902 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00554> a min:Passage,
            schema:CreativeWork ;
