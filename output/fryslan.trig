    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01561> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warns (gemeente Nijefurd)"@nl ;
        min:adres "Buorren 10" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
