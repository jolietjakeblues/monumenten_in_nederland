        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Recreatiewoningen. Aardige zomerwoningen uit circa 1930, voorzien van licht expressionistische details, zijn Bellevue (Badweg 45), met paraboolvormig dak, en Onder 't Stroodak (Oranjeweg 38)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00806> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hollum (gemeente Ameland) – Boerderijen"@nl ;
        min:adres "Oranjeweg 40" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ameland" ;
        min:gemeenteInBoek "Ameland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ameland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hollum (gemeente Ameland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hollum" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 806 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0083> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Boerderijen. De oudste van de veelal in het dorp gelegen boerderijen stammen uit de 19de eeuw. Deze boerderijen hebben een voorhuis en een schuur met dwarsdeel. De deuren van de dwarsdeel kunnen terugliggen, zoals bij Zuiderlaan 12 (1850) en Burenlaan 16 (circa 1900), uitsteken, zoals bij Oosterlaan 14, of een dakvormige beeïndiging (‘schúntsje’) hebben, zoals bij De Blieke (Oranjeweg 40). Voorbeelden van modernere boerderijen zijn de stelpboerderij Burenlaan 25 (circa 1925) en Plantsoenstraat 1 (circa 1930)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00807> a min:Passage,
