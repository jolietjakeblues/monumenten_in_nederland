        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Minnertsga (Minnertsgea) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Minnertsga" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1073 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0113> ;
        schema:name "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Terpdorp, ontstaan in de 8ste eeuw op een kwelderwal. In de omgeving van het dorp lagen enkele adellijke stinzen. Eind 19de en begin 20ste eeuw is het dorp met name langs de uitvalswegen gegroeid en ook in de omgeving van het station (1902) aan de lijn Leeuwarden-Stiens-Harlingen (opgeheven in 1936). Na de Tweede Wereldoorlog is Minnertsga aan de zuid- en oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01074> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        min:adres "Meinardswei 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Minnertsga (Minnertsgea) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Minnertsga" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28280> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8634" ;
        min:soort "inleiding" ;
        min:volgnummer 1074 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0113> ;
        schema:name "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De Herv. kerk (Meinardswei 3), oorspronkelijk gewijd aan St. Martinus, is een eenbeukige kerk met steunberen, vijfzijdig gesloten koor en een zadeldaktoren van twee geledingen. De huidige laat-gotische kerk van afwisselend lagen rode en gele baksteen kwam in de 16de eeuw tot stand. Van een 13de-eeuws gedeelte zijn resten zichtbaar aan de noordzijde, ter plaats van een later afgebroken consistorie. Tegen de noordgevel bevindt zich een laat-middeleeuws ingangsportaal met metselmozaïek in een rechthoekige omlijsting met getordeerde kralen. De toren verrees in 1505 en kreeg in 1818 een nieuw zadeldak. Na een brand in 1947 is de kerk in 1951-'55 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01075> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Minnertsga (Minnertsgea) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Minnertsga" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1075 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0113> ;
        schema:name "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Tot de inventaris behoren vier psalmborden (1781) door Jan Willem Smitsen, een vroeg 19de-eeuwse preekstoel, afkomstig uit de Doopsgez. kerk van Blija, en een oorspronkelijk uit Vreren (B) afkomstig orgel (1785), dat via Welsrijp uiteindelijk in 1955 naar Minnertsga is overgeplaatst. In de kerk liggen verschillende oude grafzerken, zoals die voor Hobbe Hermana († 1521), gemerkt GHHF, en voor Frowck Beyama († 1547), in 1552 gemaakt door Benedictus Gerbrandtsz. Verder zijn er enkele zerken afkomstig uit de gesloopte Galileërkerk te Leeuwarden, waaronder één uit 1601 door Paulus Andriesz."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0113.php> .

