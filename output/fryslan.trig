        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Exmorra (Eksmoarre) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Exmorra" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 604 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0057> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Boerderijen. De rond 1900 gebouwde boerderij Bonjeterperweg 19 is een stelpboerderij met aan de linkerzijde een melkkelder. De kop-rompboerderij Bolswarderweg 2, gebouwd rond 1935, heeft een villa-achtig voorhuis met expressionistische invloeden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00605> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Exmorra (Eksmoarre) (gemeente Wûnseradiel) – Allingawier"@nl ;
        min:adres "Kerkbuurt 19",
            "Kerkbuurt 23" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Exmorra (Eksmoarre) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Exmorra" ;
        min:lemma "Allingawier" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22531>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36942> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39319",
            "39320" ;
        min:soort "lemma" ;
        min:volgnummer 605 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0057> ;
        schema:name "Allingawier"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Allingawier. Dit terpdorp ten zuidwesten van Exmorra is ontstaan in de middeleeuwen. De Herv. kerk (Kerkbuurt 23) is een driezijdig gesloten zaalkerk met een zadeldaktoren van drie geledingen. De huidige toren en kerk kwamen in 1635 tot stand ter vervanging van een middeleeuwse voorganger. In 1783 heeft men de kerk ingekort en van een nieuwe koorsluiting voorzien. In de toren hangt een door Hendrik Wegewaert gegoten klok (1599). De 18de-eeuwse kop-rompboerderij ‘De Izeren Kou’ (Kerkbuurt 19) heeft een onderkelderd voorhuis met een gepleisterde voorgevel waarin een gebeeldhouwd maskerkopje is aangebracht. De voorm. Geref. kerk (Meerweg ong.) is een kleine zaalkerk uit 1893 met driezijdig gesloten koor en een houten geveltoren met ingesnoerde spits. De kerk, waaraan een houten kassagebouwtje is toegevoegd, heeft thans een museumfunctie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00606> a min:Passage,
