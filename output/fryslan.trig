        min:volgnummer 1183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0128> ;
        schema:name "Oldetrijne (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "De klokkenstoel van Sonnega (bij Sonnegaweg 14), gelegen ten noordoosten van Oldetrijne, is een rond 1640 opgerichte en rond 1920 herstelde enkele klokkenstoel met helmdak. Op de bijbehorende begraafplaats ligt het restant van de zerk voor Anna Lugtiens († 1640)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01184> a min:Passage,
