        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0069> ;
        schema:name "Grou (Grouw) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "146" ;
        schema:pageStart "146" ;
        schema:pagination "146" ;
        schema:text "De Doopsgez. kerk (Hoofdstraat 44) is een driezijdig gesloten zaalkerk, gebouwd in 1829 als schuilkerk en daarbij aan de straatzijde verborgen achter een tweelaags lijstgevel met rondboogdoorgang. De kerk bevat een door de gebroeders Adema gebouwd orgel (1872; gewijzigd in 1920)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0069.php> .

