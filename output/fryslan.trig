        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37443> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15616" ;
        min:soort "inleiding" ;
        min:volgnummer 658 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0065> ;
        schema:name "Ginnum (Genum) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "De boerderij ‘Roorda-State’ (Roordastrjitte 7) is een forse boerderij met dwars geplaatst voorhuis en omlijste ingang, gebouwd rond 1860 op het omgrachte terrein van de gesloopte Roordastate."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00659> a min:Passage,
            schema:CreativeWork ;
