        min:kern "Joure" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41969> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "18207" ;
        min:soort "inleiding" ;
        min:volgnummer 866 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0093> ;
        schema:name "Joure (De Jouwer) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De toren van de begin 18de eeuw gesloopte kerk van Westermeer (Geert Knolweg 4) heeft drie geledingen en een tentdak. De mogelijk 14de-eeuwse toren is bij de sloop van de kerk verlaagd en voorzien van de huidige kapvorm. Voor de toren ligt een grafzerk uit 1717. Op de omringende Alg. begraafplaats bevinden zich onder meer een marmeren obelisk voor burgemeester F.R. Douma († 1872) en een obelisk voor A.G. Brouwer († 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00867> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Joure (De Jouwer) (gemeente Skarsterlân)"@nl ;
        min:adres "Midstraat 67" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Skarsterlân" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Joure (De Jouwer) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Joure" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 867 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0093> ;
        schema:name "Joure (De Jouwer) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De Herv. kerk (Midstraat 67) is een tweebeukige kerk met driezijdig gesloten koor en een toren van drie geledingen met achtkantige lantaarn, omloop en opengewerkt koepeltorentje met spits. In de toren, die dateert uit 1628, waren cachotten en een vierschaar ondergebracht. Delen van de balkenbeschilderingen met acanthusblad- en bloemmotieven in de vierschaar zijn nog zichtbaar. Het drielichtvenster aan de straatzijde was voor afkondigingen bedoeld. In de toren hangen klokken gegoten door Gregorius van Hall (1603), Jacob Noteman (1636) en L. Haverkamp (1790). Het carillon is in 1955 geleverd door Petit & Fritsen. De huidige kerk met classicistische elementen kwam in 1644 tot stand ter vervanging van een laat-16de-eeuwse voorganger. Het classicistische ingangspoortje aan de westzijde heeft een fronton met daarop de tekst ‘De heer Gritman Hobbe van Baerdt 1644’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00868> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Joure (De Jouwer) (gemeente Skarsterlân)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
