        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "512553" ;
        min:soort "inleiding" ;
        min:volgnummer 573 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill159> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0052> ;
        schema:name "Eastermar (Oostermeer) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De Herv. kerk (Torenlaan 14, It Heechsân) is een forse zaalkerk met apsisvormige consistoriekamer en een geveltoren met ingesnoerde naaldspits, gebouwd in 1868 in eclectische vormen naar plannen van R. Kijlstra. De bovenbouw van de toren is in 1894 vernieuwd. De kerk bevat een door J.F. Kruse gebouwd orgel (1888)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00574> a min:Passage,
