        min:soort "inleiding" ;
        min:volgnummer 1323 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill364>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill365> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0154> ;
        schema:name "Rinsumageest (Rinsumageast) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "260" ;
        schema:pagination "260-261" ;
        schema:text "De Herv. kerk (Juckemaweg 3), oorspronkelijk gewijd aan St. Alexander, is een tweebeukige kerk met halfrond gesloten koor en een forse zadeldaktoren van twee geledingen. Rond 1100 verrees het tufstenen koor met spaarvelden, gesloten door gekoppelde rondboogvensters. Het driedelige venster aan de zuidzijde - waarschijnlijk een hagioscoop - is in de 13de eeuw aangebracht. In de 12de eeuw werd het koor verhoogd en kwam een driebeukig tufstenen schip tot stand met kleine rondboogvensters in de lichtbeuk. Rond 1525 heeft men de smalle zijbeuken gesloopt, de doorgangen aan de noordzijde dichtgezet en aan de zuidzijde een bredere, laat-gotische zijbeuk opgetrokken. Het classicistische poortje (1647) van de noordingang is in 1805 geplaatst en is afkomstig van de gesloopte Eijsingastate. De oorspronkelijk 13de-eeuwse toren werd, getuige een door Maria van Tyarda geplaatste maniëristische gevelsteen, in 1610 grotendeels vernieuwd en voorzien van een nieuwe traptoren tussen de schipbeuken. De toren heeft op de verdieping een opvallend rijk stergewelf. In 1805 zijn de noord- en de westgevel beklampt. In de toren hangt een door Hans Falck gegoten klok (1620). De kerk is in 1943-'45 hersteld en in 1987-'88 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01324> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rinsumageest (Rinsumageast) (gemeente Dantumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rinsumageest (Rinsumageast) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Rinsumageest" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1324 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0154> ;
        schema:name "Rinsumageest (Rinsumageast) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Inwendig is het belangrijkste onderdeel van de kerk de kleine, opvallende crypte, waarschijnlijk tegen het midden van de 16de eeuw aangebracht. De graatgewelven rusten op kraagstenen en op twee middenzuilen. Deze vroeg-13de-eeuwse zuilen zijn mogelijk afkomstig uit het nabijgelegen, in 1580 opgeheven klooster Klaarkamp. Bijzonder zijn de uit Caensteen vervaardigde kapitelen met een aan corintische kapitelen refererende decoratie. De abaci en zuilschachten bestaan uit kalksinter, een materiaal afkomstig uit de Romeinse waterleiding van de Eiffel naar Keulen, waarin het als een soort ‘ketelsteen’ is gevormd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01325> a min:Passage,
            schema:CreativeWork ;
