        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeberkoop (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeberkoop" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1161 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0126> ;
        schema:name "Oldeberkoop (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "Streekdorp, voor het eerst genoemd in 1228 als Brocope. De bebouwing concentreerde zich rond de dorpsbrink met kerk en aan de Binnenweg (nu Oosterwoldseweg), die was aangelegd op de rug tussen de Tjongervallei en de Lindevallei. Aan de oostkant werd hier in 1593 de Bekhofschans aangelegd. Haaks op de Binnenweg lag de Doldersumse heerbaan (nu Heerenveenseweg). Tot 1848 was Oldeberkoop hoofdplaats van Ooststellingwerf. In 1887-'88 kreeg het dorp een verbinding met de gekanaliseerde Tjonger. Na de Tweede Wereldoorlog kwamen vooral aan de zuidoostzijde enige uitbreidingen tot stand. Oldeberkoop is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01162> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldeberkoop (gemeente Ooststellingwerf)"@nl ;
        min:adres "Willinge Prinsstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeberkoop (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeberkoop" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52740> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "524295" ;
        min:soort "inleiding" ;
        min:volgnummer 1162 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0126> ;
        schema:name "Oldeberkoop (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De Herv. kerk (Willinge Prinsstraat 2), oorspronkelijk gewijd aan St. Vitus, is een ruime eenbeukige kerk met driezijdig gesloten koor en een ongelede zadeldaktoren. Het met tufsteen beklede romaanse schip dateert uit de tweede helft van de 12de eeuw en heeft aan de bovenzijde een zone spaarvelden met afwisselend twee en drie rondbogen, met daarin enkele kleine rondboogvensters. Ook inwendig is een dergelijk geleding met spaarvelden zichtbaar. In de 14de eeuw is de kerk verlengd in gotische vormen, waarna het begin 16de eeuw een nieuw, oorspronkelijk in steen overwelfd, laatgotisch koor kreeg. De in 1585 ingestorte toren werd rond 1608 in zijn huidige vorm herbouwd. Bij de restauratie in 1927-'30, naar plannen van H.M. Hulsbergen, zijn de herstellingen uit 1845 grotendeels verwijderd; een tweede restauratie volgde in 1964. Het bij de eerste restauratie ontpleisterde interieur wordt in zijn geheel gedekt door een mogelijk 17de-eeuws houten tongewelf met trekbalken. Uit de 14de eeuw stamt het achtkantige zandstenen doopvont op schacht en rond voetstuk; de nieuwe bovenrand is in 1964 toegevoegd. De preekstoel en herenbank stammen uit de 17de eeuw. Het orgel heeft een door J.C. Scheuer vervaardigd front (1858). In het door L.J. van Dam & Zn. vernieuwde orgel (1919) is pijpwerk hergebruikt van een door Van Gruisen voor de kerk van Warga gebouwd orgel (1787). In het koor liggen zerken voor Suffridas Lycklama († 1645), Eyso van Terwischa († 1623) en Arent Barels († 1702). Op het ommuurde kerkhof liggen twee 17de-eeuwse zerken en bevindt zich een grafkelder van de familie Prins."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

