        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Dorp, ontstaan in de 18de eeuw aan de Schoterlandseweg op een plaats waar de Tjonger kon worden overgestoken. Na de Tweede Wereldoorlog is het uitgegroeid tot een forensendorp van Heerenveen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0112.php> .

