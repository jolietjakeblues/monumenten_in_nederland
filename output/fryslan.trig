        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldeboarn" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 234 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0011> ;
        schema:name "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De voorm. pastorie (Lycklema S. Leantsje 1) is een gepleisterd eenlaagspand pand met eclectische elementen en een hoger opgetrokken middenrisaliet, gebouwd in 1894 ter vervanging van de toen grotendeels afgebroken Andringa State, waarvan de westvleugel bewaard is gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00235> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        min:adres "Weaze 25" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Heerenveen" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerenveen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Aldeboarn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32148> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35957" ;
        min:soort "inleiding" ;
        min:volgnummer 235 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0011> ;
        schema:name "Aldeboarn (Oldeboorn) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De voorm. Geref. kerk (Weaze 25) is een zaalkerk met tuitgevel, omlijste ingang en hoog zadeldak. De kerk werd in 1738 gebouwd als Doopsgez. kerk en in 1887 als Geref. kerk in gebruik genomen; thans heeft het gebouw een nietreligieuze bestemming."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0011.php> .

