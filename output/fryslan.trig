        min:kern "Jirnsum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 852 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0091> ;
        schema:name "Jirnsum (Irnsum) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen als een terpdorp op een kwelderrug langs de Boorne. Jirnsum ontwikkelde zich al vroeg tot wegdorp. In de 20ste eeuw zijn uitbreidingen aan de westzijde tot stand gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0091.php> .

