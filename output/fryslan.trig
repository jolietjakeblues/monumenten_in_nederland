        min:gemeenteInBoek "Leeuwarderadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Cornjum (Koarnjum) (gemeente Leeuwarderadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Cornjum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72634>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72635>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72636> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "515445",
            "515446",
            "515447" ;
        min:soort "inleiding" ;
        min:volgnummer 440 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "De Herv. kerk (De Wier 7) is een vijfzijdig gesloten zaalkerk met zijgeveltoppen en een geveltoren van drie geledingen met ingesnoerde naaldspits. De kerk werd in 1873 gebouwd naar ontwerp van F. Brouwer ter vervanging van een oudere, aan St. Nicolaas gewijde kerk. De vensters hebben neogotische gietijzeren traceringen. Tot de inventaris behoren een Tien-gebodenbord (1602, vernieuwd 1853), twee rouwborden (1603 en 1608) en een vroeg-18de-eeuwse preekstoel. De vloer bevat een gotisch kinderzerkje (1557), een zerk uit 1572 en een zerk voor ds. Melchior Hanechroot († 1751)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00441> a min:Passage,
