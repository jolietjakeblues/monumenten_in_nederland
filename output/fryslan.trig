        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0002.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00018> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorwoord"@nl ;
