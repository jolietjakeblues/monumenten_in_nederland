        min:adres "Marwei 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Jistrum (Eestrum) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jistrum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 863 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0092> ;
        schema:name "Jistrum (Eestrum) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De Geref. kerk (Marwei 2) is een eenvoudige, recht gesloten, gepleisterde zaalkerk uit 1897. De kerk bevat een belangwekkend orgel van Hollandse makelij uit circa 1700, dat rond 1850 is omgebouwd door H. Knipscheer en rond 1930 van Delft naar Jistrum is verplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00864> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Jistrum (Eestrum) (gemeente Tytsjerksteradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
