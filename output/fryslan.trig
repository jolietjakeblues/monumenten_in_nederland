        min:soort "lemma" ;
        min:volgnummer 1601 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0196> ;
        schema:name "Bargebek"@nl ;
        schema:pageEnd "311" ;
        schema:pageStart "311" ;
        schema:pagination "311" ;
        schema:text "Bargebek. Gehucht ten noordwesten van Wyckel. De voorm. Geref. kerk (Jachtlustweg 21) is een recht gesloten zaalkerk uit 1907 met een pastorie (Jachtlustweg 23) uit 1908. Twee eenlaags blokvormige woonhuizen zijn het eclectische Jachtlustweg 24 (circa 1870), met verhoogd middenrisaliet, en Jachtlustweg 14 (circa 1906) met neorenaissance-details en een tot kleine trapgevel opgetrokken middeldeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0196.php> .

