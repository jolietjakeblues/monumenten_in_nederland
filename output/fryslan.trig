        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Het raadhuis (Brink 1) is een fors pand, dat zijn huidige uiterlijk in traditionalistische vormen kreeg in 1929 bij een ingrijpende verbouwing van een voorganger uit 1886. De aanbouwen dateren uit 1979-'81."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0130.php> .

