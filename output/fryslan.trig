        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Knipe (gemeente Heerenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "De Knipe" ;
        min:lemma "Bontebok" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30265>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41027> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21185",
            "510497" ;
        min:soort "lemma" ;
        min:volgnummer 461 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill125> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0040> ;
        schema:name "Bontebok"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Bontebok. Dit gehucht ten oosten van De Knipe is ontstaan bij het rond 1665 gebouwde verlaat (vernieuwd 1931) in de Schoterlandse Compagnonsvaart. De voorm. sluiswachterswoning (Eerste Compagnonsweg 16) stamt volgens het topanker uit 1725. De boerderij Eerste Compagnonsweg 1, met blokvormig voorhuis in eclectische stijl, werd in 1876 gebouwd voor M.R. Hogeveen. De kop-hals-romp-boerderij Oud-Hogeveen (Eerste Compagnonsweg 11) kreeg na brand in 1931 een nieuw voorhuis met expressionistische details naar plannen van J. Bosma."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00462> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deinum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Menameradiel" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Menameradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Deinum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Deinum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 462 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0041> ;
        schema:name "Deinum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Terpdorp met een radiale structuur, ontstaan enkele eeuwen voor het begin van de jaartelling. De terpstructuur is goed bewaard gebleven met de St. Janswei als ringweg. De kerk op de terp fungeerde in de middeleeuwen als baken voor het scheepvaartverkeer op de voormalige Middelzee. In de 19de eeuw heeft men de terp gedeeltelijk afgegraven. Na de Tweede Wereldoorlog is Deinum aan de zuid- en oostzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00463> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deinum (gemeente Menaldumadeel)"@nl ;
        min:adres "Tsjerkepaed 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Menameradiel" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Menameradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Deinum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Deinum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 463 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0041> ;
        schema:name "Deinum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "De Herv. kerk (Tsjerkepaed 3), oorspronkelijk gewijd aan St. Johannes de Doper, is een eenbeukige kerk met vijfzijdig gesloten koor en een forse toren van drie geledingen met ui-vormige spits. Het in oorsprong 13de-eeuwse romaanse schip is herhaaldelijk vergroot en gewijzigd. De toren kwam in 1550-'67 tot stand en is in 1868 gerestaureerd; de uit 1589 daterende spits met vier hoekpinakels is in 1989 vernieuwd. In de toren hangt een door Johan ter Steghe gegoten klok (1544)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00464> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deinum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Menameradiel" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Menameradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Deinum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Deinum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 464 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill127> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0041> ;
        schema:name "Deinum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "105" ;
        schema:pageStart "104" ;
        schema:pagination "104-105" ;
        schema:text "Tot de kerkinventaris behoren een 17de-eeuwse preekstoel, afkomstig uit de Herv. kerk van Hem, en een door W. Hardorff gebouwd orgel (1867). Verder zijn er vier in vroege-renaissance vormen gebeeldhouwde zerken. De oudste wordt toegeschreven aan Vincent Lucas (1547). Pieter Dirxs vervaardigde de grafzerk (1561) voor Hessel van Feytsma († 1557) en van de hand van Claes Jelles is een zerk voor Ofko van Feytsma († 1613) uit 1605. De vierde zerk is die voor Jelger van Feytsma († 1620). Op het door een gietijzeren hekwerk omgeven kerkhof bevinden zich onder meer de grafkelder van de familie Van Glinstra en een opvallend grafteken in de vorm van een afgeknotte zuil met grafkrans voor Douwe Andries Smeding († 1907)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00465> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deinum (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Menameradiel" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Menameradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Deinum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Deinum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 465 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0041> ;
        schema:name "Deinum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "105" ;
        schema:pageStart "105" ;
        schema:pagination "105" ;
        schema:text "Het woonhuis St. Janswei 48 is een neoclassicistisch pand uit circa 1850. Opvallend is de kaaszolder met rondom halfronde vensters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00466> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deinum (gemeente Menaldumadeel)"@nl ;
        min:adres "St. Janswei 5",
            "St. Janswei 7a" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Menameradiel" ;
