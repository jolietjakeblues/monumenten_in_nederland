        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "De Geref. kerk (Merkebuorren 34) is een L-vormige gebouw uit 1908 met overhoekse dakruiter en rationalistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01611> a min:Passage,
