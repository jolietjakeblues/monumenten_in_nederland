        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Pakhuizen. Het voorm. pakhuis Rijksweg 117 is een dwars pand uit circa 1880. Het voorm. pakhuis Rijksweg 107 heeft een voorgevel met expressionistische invloeden uit circa 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00860> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Jirnsum (Irnsum) (gemeente Boarnsterhim) – Friens"@nl ;
        min:adres "Van Sytzamawei 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Jirnsum (Irnsum) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jirnsum" ;
        min:lemma "Friens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44106> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "22881" ;
        min:soort "lemma" ;
        min:volgnummer 860 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0091> ;
        schema:name "Friens"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Friens. Terpdorp ten noorden van Jirnsum. De Herv. kerk (Van Sytzamawei 1) is een driezijdig gesloten zaalkerk voorzien van een geveltoren met ingesnoerde spits. De huidige kerk kwam in 1795 tot stand ter plaatse van een middeleeuwse voorganger. In de in 1906 naar ontwerp van H.H. Kramer toegevoegde geveltoren hangt een 13de-eeuwse klok. De kerk is in 1987-'89 gerestaureerd. Het meubilair in de kerk dateert uit 1886. Verder bevat de kerk dertien rouwborden (1637-1843) en diverse gebeeldhouwde grafzerken (1607-1759) van de familie Van Sytzama. De bekroning in Lodewijk XV-stijl van de overhuifde herenbank (1764) van deze familie is in de galerijbalustrade verwerkt. Op het kerkhof bevinden zich diverse laat-19de- en 20ste-eeuwse zerken van de familie Van Sytzama. De in 1868 gebouwde stelpboerderij Beslingadijk 15 heeft een gedeeltelijk uitgebouwde melkkelder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00861> a min:Passage,
