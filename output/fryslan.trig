        min:hoofdstuk "Steden, dorpen, monumenten › Buitenpost (Bûtenpost) (gemeente Achtkarspelen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Buitenpost" ;
