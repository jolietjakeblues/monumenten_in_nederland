        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ameland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nes" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1116 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0118> ;
        schema:name "Nes (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Terpdorp, ontstaan in de vroege middeleeuwen. De lage terp heeft een rechthoekige structuur met drie kerkpaden. Aan de zuidwestzijde bevindt zich het uiteinde van de Nesser Opvaart."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01117> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nes (gemeente Dongeradeel)"@nl ;
        min:adres "Wâlddyk 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ameland" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ameland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nes" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1117 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0118> ;
        schema:name "Nes (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De Herv. kerk (Wâlddyk 9), oorspronkelijk gewijd aan St. Johannes de Evangelist, is een eenbeukige kerk met iets inspringend, vierzijdig gesloten koor en een ongelede zadeldaktoren. De midden-12de-eeuwse oostmuur van de toren is mogelijk een restant van een gereduceerd westwerk. Hiertegen werd eind 12de eeuw een toren gebouwd, gevolgd door een schip en in het midden van de 13de eeuw een met lisenen, rondboogfries en tandlijst versierd koor. In de 16de eeuw kreeg de kerk spitsboogvensters. De in 1604 deels beklampte toren bevat een door Gert gegoten klok (1477) en een klok van Petrus Overney (1686). De kerk is in 1974 gerestaureerd. Het interieur van het schip wordt gedekt door een houten tongewelf uit 1604. Tot de inventaris behoren een aan Yge Rintjes toegeschreven preekstoel in rococovormen (1775), een herenbank met opzetstuk (1775) en een orgel uit 1906."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01118> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nes (gemeente Dongeradeel)"@nl ;
        min:adres "Wiesterwei 2" ;
