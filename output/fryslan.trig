        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0081> ;
        schema:name "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. In de tweede helft van de 19de eeuw heeft de bebouwing op de terp zich verdicht. In de 20ste eeuw is het dorp op kleine schaal in westelijke richting langs de Hoptilsterdyk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00788> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        min:adres "Skilpaed 1",
            "Smidsstraat 2",
            "Van Aylvaleane 18" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilaard (Hijlaard) (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hilaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50853> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8486" ;
        min:soort "inleiding" ;
        min:volgnummer 788 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0081> ;
        schema:name "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De Herv. kerk (Skilpaed 1), oorspronkelijk gewijd aan St. Johannes de Doper, is een vijfzijdig gesloten eenbeukige kerk met een zadeldaktoren van drie geledingen. De toren verrees begin 13de eeuw en kreeg in de 18de eeuw aan de westzijde een in- en uitgezwenkte geveltop. In de toren hangen een door Hermanus gegoten klok (1392) en een klok van Hans Falck (1618). De huidige gotische kerk kwam in de 15de of 16de eeuw tot stand. Het interieur wordt gedekt door een houten tongewelf. Tot de inventaris behoren diverse 16de- en 17de-eeuwse grafzerken, een gemarmerde zandstenen epitaaf (1656) voor Hobbe van Aylva († 1645) en Frouck van Aylva († 1617) en een door L. van Dam & Zn. gebouwd orgel (circa 1880). De voorm. kosterij (Smidsstraat 2) is een eenlaagspand met een gevelsteen uit 1780. De blokvormige pastorie (Van Aylvaleane 18) dateert uit 1863 en heeft een hoger opgetrokken middenrisaliet met portiek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00789> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        min:adres "Van Aylvaleane 10",
            "Van Aylvaleane 12" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilaard (Hijlaard) (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hilaard" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 789 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0081> ;
        schema:name "Hilaard (Hijlaard) (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De Geref. kerk (Van Aylvaleane 12) is een recht gesloten zaalkerk, gebouwd in 1888 naar een bestek van timmerman B. Nauta. De kerk bevat een orgel uit 1894. De naastgelegen pastorie (Van Aylvaleane 10) is een middenganghuis uit 1889."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00790> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilaard (Hijlaard) (gemeente Littenseradiel) – Boerderijen"@nl ;
        min:adres "Hilaarderdyk 3",
            "Hoptille 10",
            "Smidsstrjitte 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilaard (Hijlaard) (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hilaard" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27359> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8489" ;
        min:soort "lemma" ;
        min:volgnummer 790 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0081> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text """Boerderijen. De stelpboerderij Van Aylvaleane 25 dateert uit circa 1855 en heeft een ingebouwd dwarshuis dat aan de linker- en rechter zijde buiten het schuurgedeelte is uitgebouwd. Interessante kop-hals-rompboerderijen zijn: Westerhuis (Hilaarderdyk 3; 1850), met onderkelderd voorhuis, een fragment middeleeuws beeldhouwwerk en een hergebruikte gevelsteen uit 1625, en Van Aylvaleane 2 (1869). De in 1884 gebouwde kop-rompboerderij Van Aylvaleane 13 heeft een dwars geplaatst voorhuis met hoger opgetrokken middenrisaliet.

De voorm. smederij en rijwielhandel (bij Smidsstrjitte 1), bestaande uit een eenlaags bouwdeel en een tweelaags deel met hijsluik, dateert uit 1907 en vertoont jugendstil-details

Het voorm. Bolswarder Tolhuis (Hoptille 10), gelegen ten westen van Hilaard bij de brug over de Bolswardertrekvaart, is een langgerekt, wit geschilderd eenlaagspand voorzien van een gevelsteen uit 1652 met het wapen van Bolsward."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00791> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilaard (Hijlaard) (gemeente Littenseradiel) – Jellum"@nl ;
        min:adres "Hegedijk 21",
            "Hegedijk 58",
            "Hegedyk 15" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilaard (Hijlaard) (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hilaard" ;
        min:lemma "Jellum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28299> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8492" ;
        min:soort "lemma" ;
        min:volgnummer 791 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill223> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0081> ;
        schema:name "Jellum"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "168" ;
        schema:pagination "168-169" ;
        schema:text "Jellum. Dit terpdorp, gelegen ten oosten van Hilaard, is ontstaan in de vroege middeleeuwen. Boerderijen. De uit de eerste helft van de 19de eeuw daterende kop-hals-rompboerderij Smidshoeke 4 is een hoekplaatsboerderij met onderkelderd woongedeelte. Ook de kop-hals-rompboerderij Hegedijk 34 (circa 1865) en de stelpboerderij ‘Camstra Zathe’ (Hegedijk 58; circa 1870) hebben een onderkelderd woongedeelte. De in 1881 gebouwde boerderij Hegedyk 32 bezit een in eclectische vormen uitgevoerd dwars voorhuis met hoger opgetrokken middenrisaliet. Ook het in 1884 opgetrokken blokvormige eenlaags woonhuis ‘Veldzicht’ (Hegedijk 21) heeft een hoger opgetrokken middenrisaliet en eclectische vormen. De Herv. kerk (Hegedyk 15) is een vijfzijdig gesloten zaalkerk uit circa 1895, voorzien van een toren van drie geledingen met ingezwenkte spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00792> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hindeloopen (Hylpen) (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hindeloopen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 792 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0082> ;
        schema:name "Hindeloopen (Hylpen) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Stad, waarschijnlijk ontstaan op een terp en in de 8ste eeuw voor het eerst vermeld. De nederzetting groeide dankzij de ligging aan de Zuiderzee (thans IJsselmeer) en de Fliestroom (thans Indijk) uit tot een belangrijke havenstad en kreeg in de 13de eeuw stadsrechten. Hindeloopen had een kleine vissershaven en fungeerde in de 17de en 18de eeuw als voorhaven van Amsterdam. Aan de noordwestzijde ging een deel van de middeleeuwse stad in zee verloren; sindsdien is de stad aan drie zijden door de Zuiderzee (IJsselmeer) omgeven. Het oudste gedeelte van de stad bevindt zich bij de Buren. Door de aanleg van de Oude Weide in 1614 en de Nieuwe Weide en de Nieuwestad in 1638 kwam een structuur van evenwijdig lopende straten en waterwegen tot stand. In de tweede helft van de 17de eeuw legde men aan de oostzijde van de stad een stadswal met bolwerk aan (geslecht in de 19de eeuw). Als gevolg van de economische neergang na circa 1750 werd een gedeelte van de panden afgebroken en ook tussen 1850 en 1940 heeft men een deel van de oude bebouwing gesloopt. Na de Tweede Wereldoorlog is Hindeloopen aan de zuidzijde uitgebreid en is aan de noordzijde een jachthaven aangelegd. Hindeloopen is een beschermd stadsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00793> a min:Passage,
