            schema:CreativeWork ;
        rdfs:label "Driesum (Driezum) (gemeente Dantumadeel)"@nl ;
        min:adres "Kerkstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
