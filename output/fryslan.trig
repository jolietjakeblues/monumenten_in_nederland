        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0119> ;
        schema:name "Nieuwehorne (Nijhoarne) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Streekdorp, ontstaan in de 18de eeuw aan de Schoterlandseweg nabij de plaats waar deze verbindingsweg met Drenthe zich splitst in een Binnenweg (Schoterlandseweg) en een Buitenweg. Na de Tweede Wereldoorlog is tussen deze wegen aan de westzijde enige kernvorming opgetreden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0119.php> .

