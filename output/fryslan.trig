        min:soort "inleiding" ;
        min:volgnummer 640 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill181> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0062> ;
        schema:name "Gaast (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "140" ;
        schema:pageStart "140" ;
        schema:pagination "140" ;
        schema:text "Dorp, ontstaan op een natuurlijke hoogte bij de Zuiderzeekust. Omdat de kustlijn wijzigingen heeft ondergaan is de oorspronkelijke situatie moeilijk na te gaan. Sinds het verleggen van de Gaaster Oudvaart naar het oosten (vóór 1930) ligt de dorpsbebouwing tussen deze vaart en de huidige IJsselmeerdijk ingeklemd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00641> a min:Passage,
