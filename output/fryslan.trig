        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Achtkarspelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Surhuisterveen (Surhusterfean) (gemeente Achtkarspelen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Surhuisterveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13978> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "7050" ;
        min:soort "inleiding" ;
        min:volgnummer 1459 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0171> ;
        schema:name "Surhuisterveen (Surhusterfean) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "De Herv. kerk (Gedempte Vaart 8) is een driezijdig gesloten zaalkerk met houten geveltoren, volgens de wapensteen boven de ingang gesticht in 1685 door grietman De Schepper. De kerk bevat een laat-17de-eeuwse preekstoel. Op het kerkhof bevindt zich onder meer een obeliskvormig grafteken voor S.O. van Kammen († 1837)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01460> a min:Passage,
