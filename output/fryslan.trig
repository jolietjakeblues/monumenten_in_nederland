        schema:name "Villa Nova"@nl ;
        schema:pageEnd "299" ;
        schema:pageStart "299" ;
        schema:pagination "299" ;
        schema:text "Villa Nova (Kleasterwei 7), een gepleisterd fors pand in neoclassicistische vormen, werd in 1870 in opdracht van H.L. van Heemstra gebouwd voor zijn moeder naar plannen van J.I. Douma. De tuin is in 1871 aangelegd door G. Vlaskamp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0184.php> .

