        schema:name "Arum (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "73" ;
        schema:pagination "73" ;
        schema:text "De Geref. kerk (Van Camminghaweg 13) is een recht gesloten zaalkerk uit 1910, voorzien van een geveltoren met open houten opbouw en spits met frontalen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0016.php> .

