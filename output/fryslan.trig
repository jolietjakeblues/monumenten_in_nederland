        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ameland" ;
        min:gemeenteInBoek "Ameland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ameland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes (gemeente Ameland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nes" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1114 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0117> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Begraafplaatsen. De Alg. begraafplaats (Bramerduinenpad ong.) was oorspronkelijk het kerkhof van de in 1752 gesloopte middeleeuwse kerk. Interessante, ranke grafstenen zijn onder meer die voor Pieter Jacobs Schots († 1797) en Grietke Leenderts († 1808). Sober is de grafsteen voor burgemeester D.W.C. baron van Heeckeren († 1888). Een afbeelding met schepen heeft de steen voor D. de Vries († 1919). De midden 19de eeuw gestichte oude R.K. begraafplaats (Schoolstraat ong.) bevat diverse ranke grafstenen, waaronder die voor F.C. Molenaar († 1890), gemaakt door G. Jager."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01115> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nes (gemeente Ameland) – Buren (Bueren)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ameland" ;
        min:gemeenteInBoek "Ameland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ameland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes (gemeente Ameland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Nes" ;
        min:lemma "Buren (Bueren)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1115 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0117> ;
        schema:name "Buren (Bueren)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Buren (Bueren). Deze buurtschap ten oosten van Nes is - later dan de andere Amelander dorpen - ontstaan in de late middeleeuwen rondom een brink. Het dorp heeft enkele interessante boerderijen. Met een dwarsdeel uitgevoerd zijn de 19de-eeuwse boerderijen Strandweg 33 (circa 1890), Strandweg 36 en Meester Oudweg 1 (1899). Een combinatie van een boerderij met schuur en dwarsdeel en een stelpboerderij is T. Boelensweg 1 (circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01116> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nes (gemeente Dongeradeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
