        schema:name "Raard (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van onze jaartelling. De enigszins ovaalvormige terp is eind 19de eeuw voor een belangrijk deel afgegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01293> a min:Passage,
            schema:CreativeWork ;
