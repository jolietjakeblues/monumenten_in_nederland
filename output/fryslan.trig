        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "De Knipe" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50929> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21174" ;
        min:soort "inleiding" ;
        min:volgnummer 457 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0040> ;
        schema:name "De Knipe (gemeente Heerenveen)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "De Herv. kerk (Meyerweg 74) is een gepleisterde eenbeukige kerk uit 1661 met dakruiter en driezijdig gesloten koor. De kerk bevat een door Bakker & Timmenga gebouwd orgel (1918)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0040.php> .

