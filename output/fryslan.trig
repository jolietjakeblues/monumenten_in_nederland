        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0141> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "Boerderijen. De kop-rompboerderij Foarwei 32 stamt uit 1763; vergelijkbaar maar met zijkamer is de rond 1860 gebouwde boerderij Foarwei 30. Uit die tijd dateert ook de kop-halsrompboerderij Foarwei 48. De moderne stelpboerderij Simmerwei 6 is uit 1927."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01261> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Paesens-Moddergat (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Paesens-Moddergat" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1261 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0142> ;
        schema:name "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "Dorp met twee kernen. Het dijkdorp Paesens ontstond kort na de aanleg van de eerste zeedijk in de 11de eeuw bij een zijl in de monding van het stroompje de Paesens, de scheiding tussen Oost- en Westdongeradeel. Tot de tweede helft van de 18de eeuw concentreerde de bebouwing zich rond de kerk van Paesens. Daarna volgde er een uitbreiding op het gebied van Westdongeradeel. Deze uitbreiding, Moddergat genoemd, bestaat uit de gehuchten De Kamp en De Oere (de oever). Het bij een wadgeul gelegen De Oere is een gaaf bewaarde vissersnederzetting. In de rond 1970 op Deltahoogte gebrachte zeedijk herinnert een monument uit 1958 aan de stormramp van 1883, waarbij de vissersvloot van De Oere grotendeels werd weggevaagd en waarna de visserij verliep. Moddergat is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01262> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        min:adres "De Buorren 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Paesens-Moddergat (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Paesens-Moddergat" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43684> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31593" ;
        min:soort "inleiding" ;
        min:volgnummer 1262 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0142> ;
        schema:name "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "De Herv. kerk van Paesens (De Buorren 9), oorspronkelijk gewijd aan St. Antonius, is een licht taps toelopende eenbeukige kerk met even inspringende halfronde koorsluiting en een houten geveltoren met ingesnoerde spits. De laat-romaanse bakstenen kerk werd rond 1200 gebouwd. Na de sloop van de oude toren heeft men in 1792 het schip westwaarts verlengd en een nieuwe geveltoren met vleugelmuren opgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01263> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Paesens-Moddergat (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Paesens-Moddergat" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1263 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0142> ;
        schema:name "Paesens-Moddergat (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "Daarin hangt een door Johannes gegoten klok (1507). Het interieur wordt gedekt door een houten tongewelf, mogelijk uit 1792. De kerk bevat een door J.Th. Gilmann gebouwd orgel (1758), afkomstig uit de R.K. St.-Laurentiuskerk te Haarlem (geplaatst in 1908). Op het kerkhof ligt onder meer een zerk uit 1776 als stoepsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0142.php> .

