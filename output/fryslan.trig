        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Het oude schoolhuis (Kerkstraat 2) is een dwars eenlaagspand met een smalle klokgevel. Nadat de voorganger was afgebrand kwam het huidige pand in 1787 tot stand in opdracht van Anna van Sytzama. Het gebouw is in 1854 vergroot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0046.php> .

