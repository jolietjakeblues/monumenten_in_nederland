        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46451> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31822" ;
        min:soort "lemma" ;
        min:volgnummer 325 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0023> ;
        schema:name "Armenhuizen"@nl ;
        schema:pageEnd "81" ;
        schema:pageStart "81" ;
        schema:pagination "81" ;
        schema:text "Armenhuizen. Het voorm. diaconie armenhuis (Hoofdstraat 79) is een langgerekt diep pand uit het begin van de 19de eeuw. In 1854 werd het verbouwd en verhoogd in opdracht van mr. Joh. Luden Anthz. Uit deze tijd stamt de tweelaags voorbouw in neoclassicistische vormen. Het voorm. armenhuis Van Teijens Fundatie (Kerkpad Oost 18) is een breed neoclassicistisch tweelaags pand met verhoogd middendeel, gebouwd in 1858 voor Oene van Teijens en Etta Arnolda en verbouwd in 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00326> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetsterzwaag (Beetstersweach) (gemeente Opsterland) – Boerderijen"@nl ;
        min:adres "Beetsterweg 2",
            "Van Harinxmaweg 7" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetsterzwaag (Beetstersweach) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
