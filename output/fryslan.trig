        min:adres "Vaart NZ 18" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Appelscha (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Appelscha" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 268 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0015> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Boerderijen. De hallenhuisboerderij De Bult 7 werd in 1846 gebouwd. De boerderij Tjoemboeloeit (Vaart NZ 18) bestaat uit een eclectisch voorhuis uit 1857 en daarnaast een schuur. De modelboerderij Bruggelaan 62 heeft een villa-achtig voorhuis met jugendstil-elementen en is gebouwd in 1914 naar plannen van O.M. Meek voor J. van den Bosch."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00269> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Appelscha (gemeente Ooststellingwerf) – Sluizen"@nl ;
        min:adres "Industrieweg 2",
            "Vaart NZ 90",
            "Vaart ZZ 149" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
