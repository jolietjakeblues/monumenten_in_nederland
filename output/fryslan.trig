        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Hommerts (De Hommerts) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Vaartdorp, ontstaan in de middeleeuwen. De lintbebouwing kwam hoofdzakelijk aan de westzijde van de vaart, het Var, tot ontwikkeling en, na de aanleg van de weg Sneek-Lemmer (1843-'44), tussen deze weg en de vaart. Rond 1850 waren Jutrijp en Hommerts aan elkaar gegroeid tot een lang bebouwingslint."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00817> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hommerts (De Hommerts) (gemeente Wymbritseradiel)"@nl ;
        min:adres "Jeltewei 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hommerts (De Hommerts) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hommerts" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42794> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39787" ;
        min:soort "inleiding" ;
        min:volgnummer 817 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0085> ;
        schema:name "Hommerts (De Hommerts) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De Herv. kerk (Jeltewei 3) is een driezijdig gesloten zaalkerk met een half ingebouwde toren van vier geledingen voorzien van een ingesnoerde spits met frontalen. De kerk verrees in 1876 naar een ontwerp met eclectische elementen van P. de Jong. In de toren hangt een door Franciscus Simon en Andreas Obertin gegoten klok (1624). De kerk bevat een door L. van Dam & Zn. gebouwd orgel (1869; uitgebreid in 1925)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00818> a min:Passage,
