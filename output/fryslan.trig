        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reduzum (Roordahuizum) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Reduzum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1304 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0150> ;
        schema:name "Reduzum (Roordahuizum) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Terpdorp, ontstaan in de vroege middeleeuwen. In de 19de eeuw kreeg het dorp een uitbreiding met een lintbebouwing langs de Haedstrjitte. Na de Tweede Wereldoorlog is aan de noordzijde een nieuwe wijk gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01305> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reduzum (Roordahuizum) (gemeente Boarnsterhim)"@nl ;
        min:adres "Haedstrjitte 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reduzum (Roordahuizum) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Reduzum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16397> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "22921" ;
        min:soort "inleiding" ;
        min:volgnummer 1305 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0150> ;
        schema:name "Reduzum (Roordahuizum) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De Herv. kerk (Haedstrjitte 2), oorspronkelijk gewijd aan St. Vincentius, is een vierzijdig gesloten zaalkerk voorzien van een toren van drie geledingen met ingesnoerde naaldspits. De middeleeuwse kerk (mogelijk uit de 15de eeuw) werd in 1726 aan de zuidzijde beklampt en kreeg een natuurstenen ingangspoortje met het gebeeldhouwde wapen van jhr. Tjalling Homme van Kamstra. De in 1878 naar ontwerp van de architect-aannemer J.R. Nijdam in eclectische vormen opgetrokken toren heeft een opvallende neogotische ingangspartij. In de toren hangt een door Andries en Nicolaas Rogier Obertin gegoten klok (1628). Het kerkinterieur heeft midden-19de-eeuws stucwerk als afwerking. Tot de inventaris behoren een kinderzerkje (1627), een preekstoel (midden 17de eeuw) en een door A. van Gruisen gebouwd orgel (1784-'85; gewijzigd 1859-'60 en gerestaureerd 1995-'96)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01306> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reduzum (Roordahuizum) (gemeente Boarnsterhim) – Woonhuizen"@nl ;
        min:adres "Ayttawei 73",
            "Haedstrjitte 14" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reduzum (Roordahuizum) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Reduzum" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1306 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0150> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "258" ;
        schema:pagination "258-259" ;
        schema:text """Woonhuizen. Het dorp heeft voornamelijk eenlaags woonhuizen. Uit de 18de eeuw dateert het diepe huis Hoofdstraat 24, voorzien van een topgevel met vlechtingen en de jaartalankers ‘1743’. Mogelijk rond 1850 is Buorren 15 gebouwd als een koemelkers- of arbeiderswoning. Het circa 1870 gebouwde pand Ayttawei 7 heeft een aangebouwd pakhuis. Uit circa 1880 dateren de huizen Haven 2, 4 en 9. Vroeg-20ste-eeuwse blokvormige huizen met (afgeplat) schilddak zijn het dubbele huis De Trije Romers 8-10 (circa 1900) en De Trije Romers 12 en 14 (beide circa 1910); het laatste pand heeft een hoger opgetrokken middenrisaliet. De Trije Romers 13 is een notariskantoor met woonhuis gebouwd rond 1900 met een hoger opgetrokken middendeel. Andere huizen uit het begin van de 20ste eeuw zijn: Haedstrjitte 48-50 (circa 1910), het in kalkzandsteen opgetrokken huis Ayttawei 77 (circa 1915) en het van een uitbouw voorziene huis De Trije Romers 2 (circa 1915). Het dubbele woonhuis De Trije Romers 1-3 uit 1921 heeft erkers en twee hoger opgetrokken geveldelen. Aan de Haedstrjitte dateert een aantal huizen uit de jaren twintig, zoals Haedstrjitte 39 met gebroken tentdak, het dubbele huis Haedstrjitte 74-76 en Haedstrjitte 45, 47 en 49. Het dorpscafé (Haedstrjitte 14), mogelijk vroeger een herberg, is een blokvormig wit geschilderd pand uit 1855.

De voorm. coöperatieve zuivelfabriek ‘De Eendracht’ (Ayttawei 73) dateert uit 1890 en bestaat uit twee haakse bouwdelen met directeurswoning. De rond 1900 gebouwde arbeiderswoningen Ayttawei 47-69 behoorden mogelijk ook bij de fabriek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01307> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reduzum (Roordahuizum) (gemeente Boarnsterhim) – Boerderijen"@nl ;
