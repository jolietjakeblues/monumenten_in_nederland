        min:volgnummer 1503 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill421> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0179> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Woonhuizen. Uit 1850 dateert Tsjerkebuorren 26, een breed eenlaagspand met hoger opgaand middenrisaliet. Het Simke Kloostermanhûs (Tsjerkebuorren 27) is een rentenierswoning met aangebouwd koetshuis, gebouwd rond 1860 in sobere neoclassicistische vormen. Een opvallend rijk sierspant heeft het rond 1910 in chaletstijl gebouwde huis Tsjerkebuorren 44, dat vermoedelijk is ontworpen door J.C. Velding. Jugendstil-details hebben de huizen Wedzebuorren 28 (1905) en Tsjerkebuorren 21 (1915). De in zakelijk-expressionistische vormen uitgevoerde villa Optwijzel 93 is uit 1935."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01504> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twijzel (Twizel) (gemeente Achtkarspelen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Achtkarspelen" ;
        min:gemeenteInBoek "Achtkarspelen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Achtkarspelen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Twijzel (Twizel) (gemeente Achtkarspelen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Twijzel" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0179> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Boerderijen. Een mogelijk 18de-eeuwse oorsprong heeft de kleine boerderij Rykswei 2. Kenmerkend voor de streek zijn de kop-hals-rompboerderijen waarvan het voorhuis is voorzien van een omlopende bakgoot. De boerderij Wedzebuorren 27 heeft in de nokanker de datering 1818. Het voorhuis bevat een tegelkamer. Andere karakteristieke kophals-rompboerderijen zijn: Rykswei 4 (1850), Wedzebuorren 23 (1846) en Wedzebuorren 25 (circa 1850). Tsjerkebuorren 49 is een krimpenboerderij (of Oldambster boerderij) uit 1899 met wolfdak en lage vensters op de verdieping. Een dwars geplaatst voorhuis hebben de opvallende boerderijen Optwizel 96 (1898) en Optwizel 34 (1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0179.php> .

