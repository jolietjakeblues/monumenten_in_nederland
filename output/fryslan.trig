        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0188> ;
        schema:name "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "Het kerkhof wordt omringd door een gietijzeren hek uit 1879. Het kerklokaal (Tsjerkepaed 2) is een zaalgebouw in expressionistische vormen uit 1928."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0188.php> .

