    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00037> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ten geleide"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
