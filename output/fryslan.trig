        min:hoofdstuk "Steden, dorpen, monumenten › Goënga (Goaiïngea) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Goënga" ;
        min:lemma "Gauw (Gau)" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29053> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39767" ;
        min:soort "lemma" ;
        min:volgnummer 665 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0066> ;
        schema:name "Gauw (Gau)"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "Gauw (Gau). Wegdorp ten oosten van Goënga. De Herv. kerk (Boeijengastrjitte 43) is een driezijdig gesloten zaalkerk met een zadeldaktoren van twee geledingen. De toren stamt vermoedelijk uit de 13de eeuw en ook de kerk is van middeleeuwse oorsprong, maar is in de 19de eeuw ingrijpend verbouwd. Hierbij is mogelijk ouder muurwerk bewaard gebleven. De koorsluiting en de ommetseling van de toren dateren vermoedelijk uit de 19de eeuw. Tot de inventaris behoren een 17de-eeuwse preekstoel en een door W. Hardorff gebouwd orgel (1861). De Geref. kerk (Boeijengastrjitte 73) is een recht gesloten zaalkerk uit 1896, voorzien van een topgevel met pinakel. De arbeiderswoning De Clegauwe 11 dateert uit circa 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00666> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gorredijk (De Gordyk) (gemeente Opsterland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
