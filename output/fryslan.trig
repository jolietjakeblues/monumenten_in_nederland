        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. Via de Sneeker Oudvaart staat Goënga met Sneek in verbinding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0066.php> .

