        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 582 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill160> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0054> ;
        schema:name "Echten (Ychten) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen. De bebouwing concentreerde zich aanvankelijk aan de noordzijde langs de weg Heerenveen-Lemmer. Vanaf de 18de eeuw werd vanuit Echten en Oosterzee de zuidelijk gelegen Veenpolder van Echten eerst verveend en nadien in cultuur gebracht. Dit proces werd in de tweede helft van de 19de eeuw voltooid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0054.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00583> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Echten (Ychten) (gemeente Lemsterland)"@nl ;
        min:adres "Hoofdweg 30" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Lemsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Echten (Ychten) (gemeente Lemsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Echten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15710> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "25776" ;
        min:soort "inleiding" ;
        min:volgnummer 583 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0054> ;
        schema:name "Echten (Ychten) (gemeente Lemsterland)"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "De Herv. kerk (Hoofdweg 30) is een driezijdig gesloten zaalkerk voorzien van een ongelede toren met een achtkantige, met leien beklede, opbouw en spits. De oorspronkelijk in het midden van de 13de eeuw gebouwde kerk kreeg bij een ommetseling in de tweede helft van de 17de eeuw het huidige uiterlijk met pilasterstelling. De vensterdetaillering is vroeg-19de-eeuws. De huidige westgevel en toren met zandstenen decoraties rond de ingang en de galmgaten kwamen tot stand bij een verbouwing in 1879. De kerk is in 1977 gerestaureerd onder leiding van F. Kroes. Het interieur wordt gedekt door een houten tongewelf. Tot de inventaris uit circa 1830 behoren de preekstoel, de kerkbanken en de orgelgalerij. Verder bevat de kerk enkele oude grafzerken en een door L. van Dam & Zn. gebouwd orgel (1871) met rijk gesneden kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0054.php> .

