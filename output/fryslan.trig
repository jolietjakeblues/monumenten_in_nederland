        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "De Geref. kerk (Noard 75) [5] is een zaalkerk uit 1887 met open koepeltorentje. De kerk is in 1920 met een dwarsarm uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0205.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01675> a min:Passage,
