        rdfs:label "Gorredijk (De Gordyk) (gemeente Opsterland)"@nl ;
        min:adres "Kerkewal 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gorredijk (De Gordyk) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Gorredijk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14275> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31848" ;
        min:soort "inleiding" ;
        min:volgnummer 667 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0067> ;
        schema:name "Gorredijk (De Gordyk) (gemeente Opsterland)"@nl ;
        schema:pageEnd "143" ;
        schema:pageStart "143" ;
        schema:pagination "143" ;
        schema:text "Van de voorm. Herv. kerk (Kerkewal 9), gesticht in 1683 en verbouwd in 1735 en 1877, resteren na de sloop in 1985 nog enig muurwerk met gevelstenen en een kerkvloer met diverse 18de-eeuwse zerken. Verder bevinden zich enkele oude grafstenen op het bijbehorende kerkhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0067.php> .

