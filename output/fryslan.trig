        min:hoofdstuk "Steden, dorpen, monumenten › Surhuisterveen (Surhusterfean) (gemeente Achtkarspelen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Surhuisterveen" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1458 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0171> ;
        schema:name "Surhuisterveen (Surhusterfean) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "Dorp met stedelijk karakter (vlekke), ontstaan als veenkolonie toen in 1648-'49 vanaf het Kolonelsdiep de Nije Vaert werd gegraven naar de venen in de omgeving. De oostwaarts gerichte tak hiervan werd in 1934 gedempt. Na de Tweede Wereldoorlog kreeg Surhuisterveen een winkelfunctie voor de omgeving. Het dorp is vooral aan de westzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01459> a min:Passage,
            schema:CreativeWork ;
