        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0137> ;
        schema:name "Oudega (aldegea) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "Dorp, ontstaan in de middeleeuwen langs de vaart tussen het Oudegaasterbrekken en de Schuttelpoel. De dorpskern ligt in het westen bij de kerk. Na de aanleg van het spoor in 1885 en na de Tweede Wereldoorlog is Oudega in noordelijke richting enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01232> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudega (aldegea) (gemeente Wymbritseradiel)"@nl ;
        min:adres "Pastorijstrjitte 23" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Smallingerland" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Smallingerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudega (aldegea) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oudega" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1232 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0137> ;
        schema:name "Oudega (aldegea) (gemeente Wymbritseradiel)"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De Herv. kerk (Pastorijstrjitte 23) is een driezijdig gesloten zaalkerk met een houten geveltoren voorzien van een spits met frontalen. De kerk werd in 1755 naar plannen van Jelte Eeltjes gebouwd, gedeeltelijk op de fundamenten van een middeleeuwse voorganger. Rond 1870 heeft men de kerk aan de oostzijde vergroot en is de geveltoren geplaatst. In de toren hangt een door Franciscus Simon en Andreas Obertin gegoten klok (1623). Tot de kerkinventaris behoren een mogelijk door Eite Tjebbes vervaardigde preekstoel (1755) en een door L. van Dam & Zn. gebouwd orgel (1873). In de kerk liggen diverse 15de- 16de- en 17de-eeuwse zerken, waaronder die voor leden van de familie Hoytema. Twee van de oorspronkelijk in 1756 door Ype Staak vervaardigde gebrandschilderde ramen zijn in 1989 herplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0137.php> .

