        min:adres "Hoofdweg 53",
            "Hoofdweg 63" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldetrijne (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldetrijne" ;
        min:lemma "Oldelamer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16761> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38869" ;
        min:soort "lemma" ;
        min:volgnummer 1184 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill338>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill339> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0128> ;
        schema:name "Oldelamer"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Oldelamer. Dit streekdorp ten noorden van Oldetrijne wordt voor het eerst genoemd in 1165 en is ontstaan aan de Weerdijk (nu Hoofdweg), die later onderdeel vormde van de weg van Schoterzijl naar Wolvega. De Herv. kerk (Hoofdweg 63) is een driezijdig gesloten zaalkerk uit 1794 met een van rolvoluten voorziene westgevel. In de in 1869 toegevoegde geveltoren hangt een door Nicolaas Rogier Obertin gegoten klok (1629). De in 1992 gerestaureerde kerk bevat een preekstoel uit circa 1700. Uit 1880 is de in eclectische vormen uitgevoerde pastorie (Hoofdweg 53). De stelpboerderij Kerkeweg 12 dateert uit 1865."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01185> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldetrijne (gemeente Weststellingwerf) – Nijelamer"@nl ;
        min:adres "Kooiweg 32",
            "Schipslootweg 17" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldetrijne (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldetrijne" ;
        min:lemma "Nijelamer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30313> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "508656" ;
        min:soort "lemma" ;
        min:volgnummer 1185 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0128> ;
        schema:name "Nijelamer"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Nijelamer. Gehucht ten noordoosten van Oldetrijne. De enkele houten klokkenstoel met helmdak (bij Schipslootweg 17) dateert oorspronkelijk uit 1795 maar is later diverse malen vernieuwd. Erin hangt een door Willem Wegewaert gegoten klok (1599). Op het bijbehorende verhoogde kerkhof ligt een grafzerk voor Wemme Carstedochter († 1651). Het voorm. elektrische gemaal (Kooiweg 32) is in 1929 gebouwd in functionalistische stijl, naar plannen van G.B. Bergsma en/of R. Zwage, ter ontwatering van de polder ‘De Ontginning’. Momenteel dient het als verenigingsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01186> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosternijkerk" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1186 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0129> ;
        schema:name "Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Dorp, ontstaan na de indijking van het gebied in de 11de-12de eeuw. Langs De Buorren kwam een lintbebouwing tot ontwikkeling, later aangevuld met dorpsuitbreidingen in oostelijke en westelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01187> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)"@nl ;
        min:adres "De Buorren 14" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oosternijkerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48550> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31588" ;
        min:soort "inleiding" ;
        min:volgnummer 1187 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0129> ;
        schema:name "Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "De Herv. kerk (De Buorren 14), oorspronkelijk gewijd aan St. Cecilia, is een eenbeukige kerk met driezijdig gesloten koor en een forse zadeldaktoren van twee geledingen. De 13de-eeuwse toren - met overwelfde benedenruimte - is in 1825-'33 hersteld en in 1969-'70 gerestaureerd. In de toren hangt een door de gebroeders Van Bergen in 1909 hergoten klok van Jurien Balthasar (1668), waarvan het oorspronkelijke opschrift en de wapens behouden zijn. Het laat-gotische koor kwam eind 15de eeuw tot stand, kort daarop gevolgd door een nieuw schip. Tot de inventaris behoren twee midden-18de-eeuwse herenbanken, waarvan één met opzetstuk in rococo-vormen, een mogelijk door Yge Rintjes in rococo-vormen gesneden preekstoel met doophek (1775) en een door J.A. Hillebrand gebouwd orgel (1813), uitgebreid door W. van Gruisen (1831)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01188> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosternijkerk (Easternijtsjerk) (gemeente Dongeradeel)"@nl ;
        min:adres "F. Sjoerdsstritte 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Dongeradeel" ;
