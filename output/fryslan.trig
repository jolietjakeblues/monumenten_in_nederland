        min:hoofdstuk "Steden, dorpen, monumenten › Makkinga (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Makkinga" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1005 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0104> ;
        schema:name "Makkinga (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Dorp met een brinkvormig plein, ontstaan in de 15de eeuw als ontginning vanuit Oosterwolde. De laat-middeleeuwse Lycklamastins werd in 1829 afgebroken. Van 1848 tot 1886 was Makkinga hoofdplaats van Ooststellingwerf, waarna het nog slechts een bescheiden ontwikkeling doormaakte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01006> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Makkinga (gemeente Ooststellingwerf)"@nl ;
        min:adres "Brink 10" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Makkinga (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Makkinga" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13465> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31724" ;
        min:soort "inleiding" ;
        min:volgnummer 1006 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill307> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0104> ;
        schema:name "Makkinga (gemeente Ooststellingwerf)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "De Herv. kerk (Brink 10) is een driezijdig gesloten kerk voorzien van een ingebouwde toren met ingesnoerde naaldspits. Een rococo-cartouche boven de ingang vermeldt het jaar 1777, toen de huidige kerk verrees ter vervanging van een oudere, aan St. Bonifatius gewijde, kerk. In de toren hangt nog een klok uit 1466. Volgens een bord in de kerk geschiedde de herbouw naar plannen van meester-timmerman Theunis Thomasz. uit Burgum, die ook de preekstoel (1776) maakte. Verder zijn er enkele zerken met de wapens van Lycklama à Nijeholt (1619, 1670 en 1731). De nabij geplaatste gietijzeren dorpspomp dateert uit circa 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01007> a min:Passage,
