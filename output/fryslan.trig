        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Metslawier" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1058 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0110> ;
        schema:name "Metslawier (Mitselwier) (gemeente Dongeradeel)"@nl ;
        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "Het voorm. raadhuis annex herberg (B. Bekkerstrjitte 15), een neoclassicistisch pand met gepleisterde hoeklisenen, werd in 1876 gebouwd naar plannen van E. Helder, met D.W. Booyinga als opzichter. In 1883 werd de deur tussen raadhuis en herberg dichtgemetseld. Van 1909 tot 1984 was het hele gebouw in gebruik als raadhuis van Westdongeradeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0110.php> .

