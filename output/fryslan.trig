        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 450 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "De Herv. kerk van Akkerwoude (Hereweg 1) is een driezijdig gesloten zaalkerk, voorzien van een geveltoren met opengewerkte achtkantige bekroning. De op een verhoogd kerkhof gelegen kerk werd in 1850 gebouwd ter plaatse van een middeleeuwse voorganger. De kerk bevat een preekstoel uit de bouwtijd en een door L.J. en L. van Dam gebouwd orgel (1818), afkomstig uit 's-Gravesande (overgeplaatst in 1899)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00451> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:adres "Doniaweg 34" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 451 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "De Doopsgez. kerk (Doniaweg 34) is een recht gesloten zaalkerk uit 1767. Het jaartal ‘1858’ in de windvaan heeft waarschijnlijk betrekking op de vernieuwing van het dak, dat is belegd met opvallende ruitvormige Friese pannen. De zuidelijke aanbouw dateert van 1910. Het interieur wordt gedekt door een houten tongewelf. Tot de inventaris behoren een rococo-opzetstuk van een herenbank (circa 1770) en een door Bakker & Timmenga gebouwd orgel (1885)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00452> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:adres "Hoofdweg 46" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Damwoude (Damwâld) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Damwoude" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 452 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0039> ;
        schema:name "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "103" ;
        schema:pageStart "103" ;
        schema:pagination "103" ;
        schema:text "Het voorm. raadhuis van Dantumadeel (Hoofdweg 46) is een fors blokvormig pand, voorzien van een gepleisterde middenrisaliet met portiek, balkon en opzetstuk. Het gebouw met eclectische details kwam in 1881 tot stand naar plannen van gemeentearchitect J.W. Duijff."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00453> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Damwoude (Damwâld) (gemeente Dantumadeel)"@nl ;
        min:adres "Voorweg 92-94" ;
