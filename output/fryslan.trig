        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0178> ;
        schema:name "Tjerkwerd (Tsjerkwert) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Terpdorp met een radiale structuur, ontstaan in de middeleeuwen. Vanaf circa 1850 kwam een lintvormige uitbreiding in zuidelijke richting tot stand langs de oostzijde van de Workumertrekvaart."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tjerkwerd (Tsjerkwert) (gemeente Wûnseradiel)"@nl ;
        min:adres "Kerkstraat 8" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tjerkwerd (Tsjerkwert) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Tjerkwerd" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30107> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39432" ;
        min:soort "inleiding" ;
        min:volgnummer 1494 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0178> ;
        schema:name "Tjerkwerd (Tsjerkwert) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "De Herv. kerk (Kerkstraat 8) is een vijfzijdig gesloten zaalkerk met een half ingebouwde toren van drie geledingen met ingesnoerde spits. De kerk werd mogelijk in de 14de eeuw gebouwd. Het schip is - mogelijk in de 17de eeuw - beklampt en het koor is later gepleisterd. De huidige toren en de westgevel zijn in 1888 gebouwd naar ontwerp van J. van Reenen. In de toren hangt een door Gregorius van Hall gegoten klok (1604). Het kerkinterieur wordt gedekt door een houten tongewelf (derde kwart 16de eeuw) en heeft een betimmering in Lodewijk XIV-stijl (1725). Tot de inventaris behoren een overhuifde herenbank van de familie Cammingha (17de eeuw), een preekstoel (1725) en diverse 17de- en 18de-eeuwse grafzerken. Verder zijn er fragmenten van enkele aan het eind van de 18de eeuw vernielde graftomben; de portretbusten van Valerius Franciscus Cammingha († 1668) en zijn vrouw Rixt van Donia († 1681) zijn tot één monument samengevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0178.php> .

