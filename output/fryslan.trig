        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hallum (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Hallum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 700 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0071> ;
        schema:name "Hallum (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "148" ;
        schema:pageStart "148" ;
        schema:pagination "148" ;
        schema:text "Het kerkhof heeft een fraai, door J. Douma ontworpen, gietijzeren hekwerk (1876) en bevat diverse interessante 19de-eeuwse zerken, waaronder die van de grafkelder voor de familie Martin en een omhekte zerk voor G.M. baron du Tour van Bellinchave († 1870). Aan de noordrand staat het kerkelijke vergaderlokaal ‘it noegend sté’, gebouwd in 1912 met jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00701> a min:Passage,
