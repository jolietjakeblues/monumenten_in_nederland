        min:volgnummer 883 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0094> ;
        schema:name "Jubbega-Schurega (Jobbegea-Schuregea) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "Dorp, ontstaan in de 18de eeuw en bestaande uit twee kernen, Jubbega-Schurega aan de Schoterlandse weg en Jubbega Derde Sluis bij de in 1774 gebouwde sluis in de Schoterlandse Compagnonsvaart. Dit laatste deel groeide na de Tweede Wereldoorlog verder uit."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00884> a min:Passage,
