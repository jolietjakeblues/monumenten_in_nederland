        schema:pageStart "303" ;
        schema:pagination "303-304" ;
        schema:text "De voorm. openbare lagere school (Buorren 1) is een tweeklassige middengangschool met portiek, gebouwd in 1887 in neoclassicistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01555> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        min:adres "Tsjerkepaed 8" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wânswert (Wanswerd) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wânswert" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1555 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0188> ;
        schema:name "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De poldermolen ‘Victor’ (Tsjerkepaed 8) is een met riet gedekte achtkantige grondzeiler op veldmuren, voorzien van een vijzel. De molen werd in 1867 gebouwd ter bemaling van de polder Ald Piip en verving zes kleine watermolens en drie tjaskers. Bij de in 1977 gerestaureerde molen staat een klein molenaarsverblijf met stookgelegenheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01556> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warns (gemeente Nijefurd)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warns (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Warns" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1556 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0189> ;
        schema:name "Warns (gemeente Nijefurd)"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "Langgerekt dorp, ontstaan in de middeleeuwen op de hoger gelegen keileemgronden van Gaasterland. Via de Warnservaart stond Warns in verbinding met de Zuiderzee. Warns heeft twee gescheiden dorpskernen (Warnser Noordburen en Warnser Zuidburen)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0189.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01557> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warns (gemeente Nijefurd)"@nl ;
        min:adres "Buorren 26",
            "Buorren 37" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warns (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Warns" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54298>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61280> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21492",
            "21493" ;
        min:soort "inleiding" ;
        min:volgnummer 1557 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0189> ;
        schema:name "Warns (gemeente Nijefurd)"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De Herv. kerk (Buorren 37), oorspronkelijk gewijd aan St. Martinus, is een driezijdig gesloten zaalkerk met een ongelede toren van twee geledingen met ingesnoerde spits. De tufstenen toren verrees in de 12de eeuw en kreeg in 1729 de huidige spits. In de toren hangen een klok uit 1523 en een door Claes Noorden en Jan Albert de Grave gegoten klok (1710). De huidige kerk kwam in 1682 tot stand, met aan de zuidzijde een classicistische ingangsomlijsting. Tot de inventaris behoren een preekstoel met doophek (17de eeuw), vier herenbanken met hoge rugschotten (circa 1700), waarvan twee met gesneden wapens, en een door de firma Dekker gebouwd orgel (circa 1920). De pastorie (Buorren 26) dateert grotendeels uit circa 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0189.php> .

