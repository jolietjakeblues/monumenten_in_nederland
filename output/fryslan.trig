        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "De Herv. kerk (Fûgelsangleane 9) is een recht gesloten zaalkerk uit circa 1895 voorzien van een toren uit 1911 van twee geledingen met ingesnoerde spits. De eclectische pastorie (Fûgelsangleane 11) dateert uit 1876."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0053.php> .

