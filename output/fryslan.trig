        min:kern "Oldetrijne" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1182 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0128> ;
        schema:name "Oldetrijne (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "De klokkenstoel van Nijeholtwolde (tegenover Weerdijk 10), gelegen ten noordoosten van Oldetrijne, is een in 1973 herstelde enkele houten klokkenstoel met helmdak. Erin hangt een door Christiaan en Jan Seest gegoten klok (1788)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01183> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldetrijne (gemeente Weststellingwerf)"@nl ;
        min:adres "Sonnegaweg 14" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
