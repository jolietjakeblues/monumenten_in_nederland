        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0198> ;
        schema:name "Wijnjewoude (Wynjewâld) (gemeente Opsterland)"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Op het verhoogde kerkhof staat een driedubbele houten klokkenstoel met schilddak, met daarin klokken uit 1948. Verder bevindt zich hier een smeedijzeren grafteken van meestersmid E.J. Linstra († 1865). De pastorie (Weinterp 46) uit 1878 vertoont eclectische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0198.php> .

