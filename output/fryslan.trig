        min:kern "Wergea" ;
        min:lemma "Warstiens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57813>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76135>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76136> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "460744",
            "514850",
            "514851" ;
        min:soort "lemma" ;
        min:volgnummer 1581 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0192> ;
        schema:name "Warstiens"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Warstiens. Terpdorp ten noordoosten van Wergea. De Herv. kerk (Buorren 5) is een zaalkerk met een vijfzijdige koorsluiting en een toren van twee geledingen met ingesnoerde spits. De kerk werd in 1892 gebouwd in neorenaissance-stijl naar ontwerp van H.H. Kramer. In de toren hangt een door Gregorius van Hall gegoten klok (1607). De kerk bevat een door Bakker & Timmenga gebouwd orgel (1883). Het baarhuisje op het kerkhof dateert uit dezelfde tijd als de kerk. De stelpboerderij ‘Gerkema Zathe’ (Oeble Omwei 3) is opgetrokken in 1899."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0192.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01582> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "West-Terschelling (West-Skylge) (gemeente Terschelling)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Terschelling" ;
        min:gemeenteInBoek "Terschelling" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terschelling_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › West-Terschelling (West-Skylge) (gemeente Terschelling)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "West-Terschelling" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1582 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0193> ;
        schema:name "West-Terschelling (West-Skylge) (gemeente Terschelling)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Dorp op het eiland Terschelling, ontstaan in de 13de eeuw nabij de huidige vuurtoren Brandaris en de als vissershaven gebruikte natuurlijke baai aan de zuidzijde van het eiland. Het door de vestiging van zeelieden, schippers en loodsen welvarende dorp werd in 1666 door de Engelsen in brand gestoken, waarna tussen 1666 en 1673 wederopbouw volgde. Er ontstond een ei-vormige dorpsplattegrond met een tamelijk gesloten bebouwing langs een netwerk van straten en steegjes. Pas begin 20ste eeuw vond er ten noordwesten van de Brandaris enige uitbreiding plaats. De bunkers van de rond 1943 gebouwde Duitse Marineflakbatterie Terschelling-West op het Seinpaalduin zijn na de oorlog voor een deel gesloopt en voor een deel onder het duinzand verdwenen. Na de Tweede Wereldoorlog kwam aan de noordzijde, rondom de nieuwe begraafplaats, nieuwbouw tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0193.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01583> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "West-Terschelling (West-Skylge) (gemeente Terschelling)"@nl ;
        min:adres "Brandarisstraat 2",
            "Westerbuurtstraat 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Terschelling" ;
        min:gemeenteInBoek "Terschelling" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terschelling_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › West-Terschelling (West-Skylge) (gemeente Terschelling)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "West-Terschelling" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19022>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21480> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35032",
            "35074" ;
        min:soort "inleiding" ;
        min:volgnummer 1583 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0193> ;
        schema:name "West-Terschelling (West-Skylge) (gemeente Terschelling)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De Brandaris (Brandarisstraat 2) is een in gele baksteen uitgevoerde, forse vuurtoren van vier geledingen (zes bouwlagen), voorzien van een lichthuis met koepel en draailicht. Een voorloper van de vuurtoren, waarvan de naam ontleend is aan de Ierse monnik St. Brendan, ontstond in 1323, toen de stad Kampen op Terschelling ten behoeve van de eigen scheepvaart een vuurbaak liet bouwen. In 1593-'94 bouwden de Staten van Holland een nieuwe baak, op de plaats van een door de zee verzwolgen (kerk)toren. Naar plannen van D. van den Bosch werd de vuurtoren in 1834-'35 ingrijpend verbouwd en ommetseld, waardoor het onduidelijk is hoeveel er van de 16de-eeuwse toren bewaard is gebleven. De streng neoclassicistische hardstenen ingang is ook uit 1835. In de toren bevinden zich gedenkstenen uit 1594 en 1666. De toren is gerestaureerd in 1979 waarbij naast het lichthuis een uitkijkpost is geplaatst - en in 1991. De Herv./Geref. kerk (Westerbuurtstraat 4) is een recht gesloten zaalkerk met dakruiter, gebouwd in 1663 door Jan Jacobsz. Groot, en later - mogelijk rond 1950 - geheel ommetseld. Inwendig is de 17de-eeuwse kap met trekbalken en korbeelstellen zichtbaar. Tot de inventaris behoren een preekstoel met doophek, een doopboog uit de bouwtijd en een door J.Fr. Witte gebouwd orgel (1892), afkomstig uit de Zuiderkerk te 's-Gravenhage. Verder bevat de kerk enkele grafzerken, waaronder die voor de eerste predikant, Johannes Grevenstein († 1669)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0193.php> .

