        schema:name "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "De openbare lagere school en voorm. onderwijzerswoning (Hoofdstraat 4-4a) dateren uit circa 1880. Het tweeklassige schoolgebouw met sobere neorenaissance detaillering en de onderwijzerswoning zijn samengetrokken en aan de achterzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01316> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
