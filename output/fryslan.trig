        min:volgnummer 347 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0026-01> ;
        schema:name "Blesdijke (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text "De Herv. kerk (Markeweg 89) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1843 ter vervanging van een in 1836 ingestorte middeleeuwse voorganger. De geveltoren heeft neogotische details. De kerk is in 1933-'34 verbouwd. Het interieur bevat enkele 17de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00348> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blesdijke (gemeente Weststellingwerf) – Boerderijen"@nl ;
        min:adres "Markeweg 25" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blesdijke (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Blesdijke" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39901> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "508663" ;
        min:soort "lemma" ;
        min:volgnummer 348 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0026-01> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "84" ;
        schema:pageStart "84" ;
        schema:pagination "84" ;
        schema:text """Boerderijen. De boerderij Oldehof (Markeweg 25) is een stelpboerderij met aanbouwen in expressionistische vormen, gebouwd in 1931 voor de familie Berkenbosch naar plannen van J. van Ommen. Hij ontwierp ook in 1933 de boerderij Markeweg 62 is van het type timpe voor G. Reiners.

De Lindesas (Sasweg ong.), gelegen ten noorden van Blesdijke, is een zeewerende keersluis in de Linde, waar deze de in 1828 aangelegde Nieuwe Lindedijk kruist. De sluis werd in 1870 tot schutsluis omgebouwd, in 1927 herbouwd en in 1991 gerenoveerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00349> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blesdijke (gemeente Weststellingwerf) – De Blesse"@nl ;
        min:adres "Steenwijkerweg 50",
