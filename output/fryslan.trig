        schema:name "Windmolens"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Windmolens. De poldermolen Ulesprong 24, gelegen ten noordwestren van Tijnje, is een met riet gedekte, achtkantige grondzeiler op veldmuren (nu zonder wieken), gebouwd in 1854 ter bemaling van het 6e en 7e veendistrict. Door R.W. Dijkstra gebouwd is de houten paaltjasker uit 1973 gelegen ten westen van Tijnje bij het natuurreservaat De Deelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0175.php> .

