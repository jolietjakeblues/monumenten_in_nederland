        schema:name "Ried (Rie) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Het woonhuis Hoofdstraat 17 uit circa 1910 vertoont een jugendstil-detaillering. De bijbehorende werkplaats was mogelijk oorspronkelijk een smederij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01317> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ried (Rie) (gemeente Franekeradeel) – Boerderijen"@nl ;
        min:adres "Dongjummerweg 10",
            "Hoofdstraat 7" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ried (Rie) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ried" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1317 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill361> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0152> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "259" ;
        schema:pagination "259-260" ;
        schema:text """Boerderijen. De boerderij Hoofdstraat 2 heeft als woonhuis een eclectisch middenganghuis uit 1861, voorzien van een fraaie inpandige ingangspartij met corintische pilasters en vensters met korte houten buitenjaloezieën van verticale planken. Naast het huis staan een oudere, met riet gedekte schuur en een houten koetshuisje in chaletstijl (circa 1900). De kop-hals-rompboerderij Andlastate (Dongjummerweg 10) heeft een dwars geplaatst voorhuis in eclectische vormen uit 1873. Vlakbij ligt over de Riedstroom een betonnen brug uit circa 1920. De kop-hals-rompboerderij Berlikumerweg 16 heeft een villa met jugendstil-detaillering als woonhuis.

De voorm. zuivelfabriek (Hoofdstraat 7) is een tweelaags, deels wit geschilderd, gebouw met plat dak, opgetrokken in 1909 met jugendstil-detaillering.

Het trafohuisje (bij Hoofdstraat 7), een bakstenen gebouwtje met schilddak en twee houten ventilatiekanalen, is rond 1925 gebouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01318> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijs (Riis) (gemeente Gaasterlân-Sleat)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
