        schema:text "De Geref. kerk (Kievitstraat 3) is een recht gesloten zaalkerk uit circa 1940 met traditionalistische kenmerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0069.php> .

