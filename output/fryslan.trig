        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0111> ;
        schema:name "Recreatiewoningen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Recreatiewoningen. Ten noorden van Midsland bij Midsland aan Zee bevinden zich een aantal voorbeelden van sobere, aardige zomerwoningen met traditionalistische details: De Eersteling (West aan Zee 101; 1932), Kijkduin (Duinweg 75; 1932), Punkaharju-Takharju (Midsland aan Zee 338-340; 1932), Branding (Midsland aan Zee 311; 1934) en Skylge (West aan Zee 120; 1939)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01067> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Midsland (Midslân) (gemeente Terschelling) – Boerderijen"@nl ;
