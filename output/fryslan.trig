        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "De voorm. Geref. kerk (Hellingsteech 1) is een zaalkerk met steekkappen, aangebouwde consistorie en een half ingebouwde toren van drie geledingen met ingesnoerde spits. De in 1912 opgetrokken kerk heeft thans geschilderde gevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0206.php> .

