        min:hoofdstuk "Steden, dorpen, monumenten › Jannum (Janum) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jannum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 842 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0089> ;
        schema:name "Jannum (Janum) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van onze jaartelling. Het is één van de vier zogeheten Vlieterpen, met een kerk en slechts enkele huizen. De terp is eind 19de eeuw voor een belangrijk deel afgegraven. Het dorp behoorde tot 1984 tot Dantumadeel. Jannum is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0089.php> .

