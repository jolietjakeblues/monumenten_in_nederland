        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39461" ;
        min:soort "inleiding" ;
        min:volgnummer 1677 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill475> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0205> ;
        schema:name "Workum (Warkum) (gemeente Nijefurd)"@nl ;
        schema:pageEnd "324" ;
        schema:pageStart "324" ;
        schema:pagination "324" ;
        schema:text "De waag (Merk 4) [9] is een maniëristisch gebouw met schilddak en Vlaamse gevels. Tegen één zijde staat een galerij met lessenaarsdak op dorische zuilen. De waag werd in 1650 gebouwd door timmerman Jentje Jouckes en metselaar Tjepke Piebes. In de westgevel zit een steen met het gemeentewapen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0205.php> .

