        min:soort "inleiding" ;
        min:volgnummer 562 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0051> ;
        schema:name "Easterlittens (Oosterlittens) (Gemeente Littenseradiel)"@nl ;
        schema:pageEnd "122" ;
        schema:pageStart "122" ;
        schema:pagination "122" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen en voor het eerst in 1275 vermeld (Lechenghe). Het dorp heeft zich evenwijdig aan de Franekervaart enigszins uitgebreid. Eind 19de eeuw is de terp gedeeltelijk afgegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00563> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Easterlittens (Oosterlittens) (Gemeente Littenseradiel)"@nl ;
        min:adres "Huylckensteinstrjitte 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Easterlittens (Oosterlittens) (Gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Easterlittens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43672> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8506" ;
        min:soort "inleiding" ;
        min:volgnummer 563 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0051> ;
        schema:name "Easterlittens (Oosterlittens) (Gemeente Littenseradiel)"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "122" ;
        schema:pagination "122-123" ;
        schema:text "De Herv. kerk (Huylckensteinstrjitte 4), oorspronkelijk gewijd aan St. Margaretha, is een eenbeukige kerk met halfrond gesloten koor en een toren van drie geledingen met ingesnoerde spits. De sterk gerestaureerde kerk heeft een in opzet 12de-eeuws schip, dat gedeeltelijk in tufsteen is uitgevoerd. Het bakstenen koor dateert uit de 13de eeuw. In de 15de eeuw heeft men de spitsboogvensters vernieuwd en is aan de noordzijde een onderkelderde sacristie aangebouwd. De zuidgevel heeft een laat-maniëristisch poortje uit 1655. Gelijktijdig met de inwendige vernieuwing van de sacristie verrees in 1854 de huidige toren naar ontwerp van F. Stoett. In de toren hangt een door Willem Wegewaert gegoten klok (1576) en een klok van Hans Falck (1620)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00564> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Easterlittens (Oosterlittens) (Gemeente Littenseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Easterlittens (Oosterlittens) (Gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Easterlittens" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0051> ;
        schema:name "Easterlittens (Oosterlittens) (Gemeente Littenseradiel)"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "Het kerkinterieur wordt gedekt door een vroeg-16de-eeuws houten tongewelf met trekbalken voorzien van korbeelstellen. Tot de 17de-eeuwse inventaris behoren een overhuifde herenbank (1604) en rouwborden voor Nicolaas van Hettinga († 1664) en Idzert Albada van Hettinga († 1695). Van de interieurvernieuwing rond 1754 dateren onder meer de lambrisering, de banken, het doophek en de vermoedelijk door Wiebe Harmens vervaardigde, rijk gesneden preekstoel (1755). Verder bevat de kerk een door W. Hardorff gebouwd orgel (1867) met een orgelbalustrade op gemarmerde en gietijzeren zuiltjes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00565> a min:Passage,
