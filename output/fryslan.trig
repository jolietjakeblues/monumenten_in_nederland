        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0112> ;
        schema:name "Mildam (Mildaam) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "232" ;
        schema:pagination "232-233" ;
        schema:text "De voorm. Herv. kerk (Schoterlandseweg 37) is een zaalkerk met driezijdig gesloten koor, herbouwd in 1726 door Sijben Roels. Op het kerkhof staat een enkele klokkenstoel met zadeldak. Daarin hangt een door Petrus Overney gegoten klok (1688), afkomstig van de in 1972 gesloopte klokkenstoel van Hoornsterzwaag."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01070> a min:Passage,
            schema:CreativeWork ;
