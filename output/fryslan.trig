        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ureterp (Oerterp) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ureterp" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1525 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0183> ;
        schema:name "Ureterp (Oerterp) (gemeente Opsterland)"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "Dorp, ontstaan op een zandrug waar in de late middeleeuwen langs de hierop aangelegde Binnenweg (Selmien/Weibuorren) enkele streekjes boerderijen werden gebouwd. Vanaf de 17de eeuw kwam ten noorden hiervan, bij de sluis in de Drachtster Compagnonsvaart, een tweede bebouwingskern tot ontwikkeling (Ureterp aan de Vaart)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0183.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01526> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ureterp (Oerterp) (gemeente Opsterland)"@nl ;
        min:adres "Selmien 47" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ureterp (Oerterp) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ureterp" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1526 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0183> ;
        schema:name "Ureterp (Oerterp) (gemeente Opsterland)"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "De Herv. kerk (Selmien 47), oorspronkelijk gewijd aan St. Petrus, is een eenbeukige recht gesloten kerk met ongelede zadeldaktoren. De toren en delen van de noordmuur stammen uit de 13de eeuw. Rond 1800 werd het koor gesloopt en heeft men de vensters vernieuwd. De kerk is in 1913 gerestaureerd, de toren in 1956. Inwendig heeft de noordwand twee series nissen boven elkaar. De kerk bevat een 17de-eeuwse preekstoelkuip. Op het kerkhof staat een dubbele houten klokkenstoel met schilddak, oorspronkelijk gebouwd in 1766 maar herbouwd in 1873 en 1992. Erin hangen twee klokken uit 1948. Bij de ingang van de kerk ligt een 18de-eeuwse grafsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0183.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01527> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ureterp (Oerterp) (gemeente Opsterland) – Woonhuizen"@nl ;
        min:adres "De Feart 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ureterp (Oerterp) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ureterp" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1527 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0183> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "Woonhuizen. Het woonhuis de Paapse Leere (De Feart 2) is een eenlaagspand met in de nokanker de datering ‘1766’. De twee kopjes uit 1630 en de gevelsteen zijn van elders afkomstig. Het huis is gerestaureerd in 1962. Het woonhuis Selmien 49 bevat enkele details uit 1787. Het dubbele eenlaagspand Weibuorren 60-62 is in de nokanker gedateerd ‘1801’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0183.php> .

