        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongjum (Doanjum) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dongjum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 489 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0043> ;
        schema:name "Dongjum (Doanjum) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Terpdorp, ontstaan rond het begin van de jaartelling op een kwelderwal. Het dorp ligt aan de kruising van de weg van Franeker naar Tzummarum en de weg naar Berlikum. In 1902 kreeg Dongjum een station aan de spoorlijn Leeuwarden-Stiens-Harlingen (opgeheven in 1936)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00490> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongjum (Doanjum) (gemeente Franekeradeel)"@nl ;
        min:adres "Dorpsstraat 8" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongjum (Doanjum) (gemeente Franekeradeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dongjum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47554> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15851" ;
        min:soort "inleiding" ;
        min:volgnummer 490 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0043> ;
        schema:name "Dongjum (Doanjum) (gemeente Franekeradeel)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "De Herv. kerk (Dorpsstraat 8) is een driezijdig gesloten zaalkerk voorzien van een half ingebouwde, ongelede toren met ingesnoerde spits. De huidige kerk werd in 1777 gebouwd ter vervanging van een oudere voorganger. Het muurwerk wordt door spaarvelden tussen lisenen geleed. In de toren hangt een klok uit 1553. Tot de inventaris behoren een preekstoel en doophek (circa 1777), een door Jan Baptist Xavéry vervaardigd grafmonument voor Sicco van Goslinga (1737; beschadigd in 1777 en 1795) en een door L. van Dam & Zn. gebouwd orgel (1849). Het verhoogde kerkhof rond de kerk heeft een gietijzeren toegangshek uit 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00491> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongjum (Doanjum) (gemeente Franekeradeel)"@nl ;
        min:adres "Hovensreed 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Franekeradeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongjum (Doanjum) (gemeente Franekeradeel)" ;
