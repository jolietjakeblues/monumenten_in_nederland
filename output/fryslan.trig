        min:hoofdstuk "Steden, dorpen, monumenten › Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Zwaagwesteinde" ;
