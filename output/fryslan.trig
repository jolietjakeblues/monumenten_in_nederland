        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "Woonhuizen. Het deels onderkelderde eenlaags huis Aldhiem 2 heeft een zadeldak tussen topgevels met vlechtingen en is voorzien van de jaartalankers ‘1700’. Hellingpaed 3-5 is het voorm. armhuis met drie woningen uit 1893. De arbeiderswoningen Hoofdstraat 38-56 dateren uit circa 1900 en hebben een jongere uitbreiding aan de achterzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01566> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warten (Wartena) (gemeente Boarnsterhim) – Boerderijen"@nl ;
        min:adres "Hellingpaed 9",
            "Hoofdstraat 58-60" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warten (Wartena) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Warten" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47407> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "22935" ;
        min:soort "lemma" ;
        min:volgnummer 1566 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill437> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0190> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text """Boerderijen. De Oud Friese Greidboerderij (Hellingpaed 9) is een Oud Fries langhuis. Het is het enige goed bewaarde voorbeeld van dit oudste Friese boerderijtype. Het is een langgerekt, laag gebouw met iets hoger woongedeelte. Onder het doorgetrokken dakvlak bevindt zich een ondiepe melkkelder. De boerderij is waarschijnlijk rond 1728 gebouwd op een verhoogde huisterp. De in 1902 gewijzigde en in 1994 gerestaureerde boerderij dient nu als museumboerderij. De naastgelegen open zesroedige hooiberg met rieten kap dateert in de huidige vorm uit circa 1834. Midsbuorren 12 is een moderne koprompboerderij uit circa 1930 met breed, gedeeltelijk onderkelderd voorhuis. Nijpaed 11 is een boerderij met twee arbeiderswoningen uit 1893.

De voorm. coöperatieve zuivelfabriek ‘Helpt Elkander’ (Hoofdstraat 58-60) dateert uit 1898. De directeurswoning heeft een hoger opgetrokken middenrisaliet."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01567> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warten (Wartena) (gemeente Boarnsterhim) – Poldermolens"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warten (Wartena) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Warten" ;
        min:lemma "Poldermolens" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1567 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0190> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "Poldermolens. Ten zuidoosten van Warten bevinden zich twee houten spinnenkopmolens. Ten westen van de Lange Sloot bij de Saiter staat de 18de-eeuwse molen De Ikkers, met een met pannen gedekte ondertoren en een houten bovenhuis. De molen staat sinds 1970 op de huidige plaats en is in 1986 voor het laatst gerestaureerd. Verder in zuidelijke richting staat aan de Folkertsloot De Princehofmolen. Deze poldermolen met vijzel en een gedeeltelijk met dakleer bekleed bovenhuis stond oorspronkelijk bij Tzum en is in 1958 overgebracht naar de huidige plaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01568> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weidum (gemeente Littenseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weidum (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Weidum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1568 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill438> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0191> ;
        schema:name "Weidum (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. De terp is rond 1900 voor een groot deel afgegraven. Ten oosten van de kerk bevindt zich op de terp vanouds een rechthoekig open terrein met aan de noord- en zuidzijde niet-agrarische bebouwing. In de jaren dertig van de 20ste eeuw is bebouwing ontstaan aan het Sânpaed en na de Tweede Wereldoorlog aan de Skildyk, gevolgd door een uitbreiding aan de zuidoostzijde van het dorp. Weidum is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01569> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weidum (gemeente Littenseradiel)"@nl ;
        min:adres "Lytse Buorren 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weidum (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Weidum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16230> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "8518" ;
        min:soort "inleiding" ;
        min:volgnummer 1569 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0191> ;
        schema:name "Weidum (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "De Herv. kerk (Lytse Buorren 3), oorspronkelijk gewijd aan St. Johannes de Evangelist, is een eenbeukige, rond gesloten kerk voorzien van een toren van drie geledingen met ingesnoerde naaldspits. De romaanse tufstenen toren verrees begin 12de eeuw en werd later verhoogd. In de toren hangen een door Geert van Wou II en Johan ter Steghe gegoten klok (1531) en een klok van Hans Falck (1626). De romano-gotische bakstenen kerk kwam in het tweede kwart van de 13de eeuw tot stand. De met kraalprofielen uitgevoerde vensters worden geflankeerd door nissen met siermetselwerk. Aan de zuidzijde bevindt zich een gotisch ingangspoortje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01570> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weidum (gemeente Littenseradiel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Littenseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weidum (gemeente Littenseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Weidum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1570 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill439> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0191> ;
        schema:name "Weidum (gemeente Littenseradiel)"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "305" ;
        schema:pagination "305-306" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf uit de eerste helft van de 16de eeuw. Tot de inventaris behoren een in rode zandsteen uitgevoerd twaalfzijdig basement met beeldhouwwerk van een romaans doopvont (mogelijk 12de eeuw), vier overhuifde herenbanken, waarvan één voor de familie Burmania (1708), een door Gerrit Payaar vervaardigde preekstoel met doophek (1712) en een door L. van Dam & Zn. gebouwd orgel (1889). Verder bevat de kerk enkele grafzerken, waaronder een door Vincent Lucas gebeeldhouwde grote zerk voor Kinsck van Ropta († 1581) en drie door Pieter Claesz. vervaardigde vroeg-17de-eeuwse zerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01571> a min:Passage,
