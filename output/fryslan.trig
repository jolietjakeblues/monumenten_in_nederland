        min:adres "Dûbelestreek 16",
            "Dübelestreek 12" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dronrijp (Dronryp) (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Dronrijp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73125> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "508678" ;
        min:soort "inleiding" ;
        min:volgnummer 534 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0048> ;
        schema:name "Dronrijp (Dronryp) (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "Achter de kerk ligt het kerkhof met een 19de-eeuws hekwerk, een kruisigingbeeld en enkele pastoorsgraven. De huidige pastorie (Dûbelestreek 16) is in 1939 gebouwd naar ontwerp van J.M. van Hardeveld in de stijl van het traditionalisme. Het parochiehuis (Dübelestreek 12) is rond 1900 gebouwd met neorenaissance-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00535> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dronrijp (Dronryp) (gemeente Menaldumadeel) – Geref. kerken"@nl ;
        min:adres "Dûbelestreek 19-29",
