        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wolvega (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wolvega" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35681> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38881" ;
        min:soort "inleiding" ;
        min:volgnummer 1639 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill461> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0202> ;
        schema:name "Wolvega (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "De Herv. kerk (Kerkstraat 7), oorspronkelijk gewijd aan St. Maria Magdalena, is een lage eenbeukige kerk met driezijdig gesloten koor en een ongelede toren met houten bovenbouw en ingesnoerde spits. De kerk werd in 1646 in gotiserende stijl herbouwd, waarbij enig opgaand muurwerk van de voorganger werd hergebruikt. De houten bovenbouw van de toren dateert van de herbouw na brand in 1894. Opvallend zijn de in open lattenwerk uitgevoerde luiken voor de kerkvensters. De op een hoge kerkheuvel gelegen kerk is in 1940-'41 gerestaureerd. Het interieur wordt gedekt door een segmentvormig houten tongewelf. Tot de inventaris behoren een midden 17de-eeuwse preekstoel met gekorniste panelen, een doophek, twee 17de-eeuwse herenbanken - voor de families Van Haren en Heloma -, rouwborden voor Willem van Haren († 1728) en Duco van Haren († 1742) en een door J.M. Schwartsburg gebouwd orgel (1733) met weelderig versierde orgelkast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0202.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01640> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wolvega (gemeente Weststellingwerf)"@nl ;
        min:adres "Lyckemaweg 8-10" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wolvega (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wolvega" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1640 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0202> ;
        schema:name "Wolvega (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "De R.K. kerk St.-Franciscus van Assisi (Lyckemaweg 8-10) is een driebeukige neogotische kruiskerk met vijfzijdig gesloten koor en een terzijde staande toren met achtkantige, ingezwenkte spits. De huidige kerk is in 1938-'39 gebouwd naar plannen van P. Cuypers jr., maar de toren verrees bij de voorganger uit 1913-'14. Die kerk op centraliserende plattegrond, naar plannen van W. te Riele, verving weer een kerk uit 1860. De toren is in 1977 en 1990 gerestaureerd. De kerkinventaris stamt grotendeels uit 1938-'39; uit de voorgaande kerk afkomstig zijn de beglazing van H.L.D. Kocken (aangevuld door W. Mengelberg) en het Ademaorgel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0202.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01641> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wolvega (gemeente Weststellingwerf)"@nl ;
        min:adres "Lycklamaweg 12",
            "Lycklamaweg 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wolvega (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wolvega" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1641 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0202> ;
        schema:name "Wolvega (gemeente Weststellingwerf)"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Het kerkhof heeft een rijke neogotische kapel, vermoedelijk ontworpen door W. te Riele, met aan de oostzijde priestergraven en voor de kapel de grafzerk voor jhr. T.M.F.M. Lycklama à Nijeholt († 1900). De pastorie (Lycklamaweg 6) en het parochiehuis (Lycklamaweg 12) dateren beide uit 1939."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0202.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01642> a min:Passage,
