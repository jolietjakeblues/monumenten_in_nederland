            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill203> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0074> ;
        schema:name "Harlingen (Harns)"@nl ;
        schema:pageEnd "156" ;
        schema:pageStart "155" ;
        schema:pagination "155-156" ;
        schema:text "Het postkantoor (Grote Bredeplaats 6) [13] is in 1897 gebouwd naar ontwerp van rijksbouwmeester C.H. Peters in de voor zijn werk kenmerkende, op de neogotiek geënte vormen. De voorgevel van het dwarse pand wordt geleed door kolossale pilasters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0074.php> .

