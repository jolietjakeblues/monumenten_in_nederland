        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De voorm. lagere landbouwschool (Wolvegasterweg 16) is gebouwd in 1922 als een middengangschool met rationalistische details naar plannen van G. van der Broek. Hij ontwierp ook de bijbehorende directeurswoning ‘Stellinga’ (Wolvegasterweg 14)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01166> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldeberkoop (gemeente Ooststellingwerf) – Woonhuizen"@nl ;
        min:adres "Molenhoek 2",
            "Willinge Prinsstraat 19",
            "Willinge Prinsstraat 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeberkoop (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeberkoop" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28379>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69495>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69496> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31736",
            "520225",
            "520243" ;
        min:soort "lemma" ;
        min:volgnummer 1166 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0126> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "Woonhuizen. Het wit vertinde voorm. molenaarshuis Molenhoek 13 draagt in de topgevel de datering ‘1759’ en bevat inwendig vermoedelijk enkele 18de-eeuwse interieuronderdelen. De voorm. pastorie Willinge Prinsstraat 12 is een deftig pand met omlijste ingang en stoeppalen, gebouwd in 1838 voor mr. J.A. Willinge. Het wit gepleisterde, forse herenhuis Lunia (Molenhoek 2) vertoont eclectische details. P.L. Willinge Prins liet het pand in 1895 bouwen naar ontwerp van H.H. Kramer. In het tegenover gelegen weiland bevindt zich een duivenslag in huisvorm met schaliedakje (circa 1870; gerestaureerd in 1971). Het herenhuis Vredewoud (Willinge Prinsstraat 4), met rijke neorenaissance- en chaletelementen, werd in 1899 voor E. Willinge Prins gebouwd naar plannen van M.O. Meek ter plaatse van een oudere voorganger. De rentmeesters- en tuinmanswoning Klein Vredewoud (Willinge Prinsstraat 19) is ook van zijn hand. De eenlaagspanden Willinge Prinsstraat 13-17 hebben een 19de-eeuws uiterlijk, maar mogelijk een oudere kern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01167> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldeberkoop (gemeente Ooststellingwerf) – Boerderijen"@nl ;
        min:adres "Bekhof 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeberkoop (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeberkoop" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28119> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31737" ;
        min:soort "lemma" ;
        min:volgnummer 1167 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0126> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "Boerderijen. De boerderij De Bekhof (Bekhof 1) is een kleine hallenhuisboerderij met een mogelijke 18de-eeuwse oorsprong, waarvan het bedrijfsgedeelte in de 19de eeuw is vervangen door een friese schuur. De boerderij Willinge Prinsstraat 6 is een voor dit gebied karakteristieke kop-romp-boerderij uit 1866. Wolvegasterweg 43 uit circa 1850 is vergelijkbaar. De gelede boerderij Heerenveenseweg 12 kreeg in opdracht van J.A. Willinge Prins in 1910 een nieuw voorhuis met zadeldak tussen trapgevels. De boerderij Wolvegasterweg 64 is van het type slak en werd rond 1930 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01168> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldeberkoop (gemeente Ooststellingwerf) – Horeca"@nl ;
        min:adres "Oosterwoldseweg 10",
            "Oosterwoldseweg 5",
            "Willinge Prinsstraat 10" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Ooststellingwerf" ;
        min:gemeenteInBoek "Ooststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ooststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldeberkoop (gemeente Ooststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oldeberkoop" ;
        min:lemma "Horeca" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27694> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "31733" ;
        min:soort "lemma" ;
        min:volgnummer 1168 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill336>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill337> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0126> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "242" ;
        schema:pagination "242-243" ;
        schema:text """Horeca. De herberg De Zwaan (Oosterwoldseweg 10) is een onderkelderd pand met bordestrap, omlijste ingang en dakerker. De empiredetails van deur en omlijsting wijzen op een datering rond 1800. Tot 1836 was de herberg deels in gebruik als bestuurskamer voor de grietenij Ooststellingwerf. Het met stalling uitgevoerde hotel-restaurant Het wapen van Ooststellingwerf (Oosterwoldseweg 5) is oorspronkelijk gebouwd in 1867 en later voorzien van een verdieping.

De winkel Oosterwoldseweg 11 is een kenmerkende dorpswinkel uit 1915. De voorm. Coöperatieve Voorschot- en Spaarbank (Willinge Prinsstraat 10), opgericht in 1902, is een gedeeltelijk tweelaags pand uit 1928, met elementen in zakelijk-expressionistische vormen uit 1938.

De Alg. begraafplaats (Pastoorslaan ong.), gesticht in 1908, heeft een rond 1915 gebouwde grafkelder met gebogen afrit voor de familie E. Willinge Prins."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0126.php> .

