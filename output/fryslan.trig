        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0209> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Woonhuizen. Het met riet gedekte woudhuisje Voorstraat 75 dateert uit circa 1880 en herinnert aan de hier vroeger veel voorkomende dagloners- of veenarbeiderswoningen. De rond 1900 gebouwde burgermanswoning Voorstraat 31 is uitgevoerd in neorenaissance-vormen. Het woonhuis Jeremi (Voorstraat 46) uit 1911 vertoont jugendstil-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01712> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwaagwesteinde (De Westerein) (gemeente Dantumadeel) – Textielnijverheid"@nl ;
        min:adres "Voorstraat 23",
            "Voorstraat 37",
            "Voorstraat 46" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Zwaagwesteinde" ;
        min:lemma "Textielnijverheid" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1712 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0209> ;
        schema:name "Textielnijverheid"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Textielnijverheid. De voorm. textielgroothandel ‘Texo Baarsma’ (Voorstraat 46) is een fors pand uit 1911 met gedeeltelijk gepleisterde gevel en een winkelpui. De voorm. confectiefabriek ‘NV Handelsvereeniging v/h R. Baarsma’ (Voorstraat 37) bestaat uit een woonhuis (1926) en een confectieatelier (1927), beide uitgevoerd met expressionistische details naar plannen van A. Pijkstra. De voorm. textielgroothandel annex woonhuis van de firma H. Elzinga (Voorstraat 23) is een blokvormig pand in zakelijk-expressionistische vormen uit circa 1928."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01713> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beknopte literatuuropgave"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Beknopte literatuuropgave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:provincie "Fryslân" ;
        min:soort "alinea" ;
        min:volgnummer 1713 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0210> ;
        schema:name "Beknopte literatuuropgave"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Van alle voor dit boek geraadpleegde literatuur kan hier slechts een gering deel genoemd worden. De literatuuropgave is eerder een hulpmiddel voor de lezer die zich verder in de materie wil verdiepen, dan een verantwoording van de inhoud van dit boek. In de onderstaande lijst is de gebruikte algemene literatuur opgenomen, aangevuld met de voor de provincie belangrijkste publicaties op architectuurgebied. Enkel indien noodzakelijk zijn de ondertitels van de publicaties toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0210.php> .

