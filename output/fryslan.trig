        schema:pageEnd "269" ;
        schema:pageStart "269" ;
        schema:pagination "269" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. In de 19de-eeuws vond een lintvormige uitbreiding plaats langs de Aesgewei en It Lange Ein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01369> a min:Passage,
