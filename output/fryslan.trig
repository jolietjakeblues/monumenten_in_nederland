        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tjalleberd (Tsjalbert) (gemeente Heerenveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Tjalleberd" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31612> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "21199" ;
        min:soort "inleiding" ;
        min:volgnummer 1484 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0176> ;
        schema:name "Tjalleberd (Tsjalbert) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De Herv. kerk (Pastoriesingel 1) is een driezijdig gesloten zaalkerk met houten geveltoren, gebouwd in 1742 in opdracht van grietman Martinus Bouricius. In 1825 werd de kerk uitgebreid met een driezijdig gesloten dwarspand, voorzien van een neoclassicistisch toskaans ingangspoortje. In de geveltoren hangt een door Petrus Overney gegoten klok (1670). Tot de kerkinventaris behoren een 17de-eeuwse preekstoel en een door L. van Dam & Zn. gebouwd orgel (1869). Op het kerkhof, gesticht in 1909, staat een rechtop gezette zerk uit 1691. De uit 1940 daterende pastorie (Pastoriesingel 6) is ontworpen door C.J. Wierda."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0176.php> .

