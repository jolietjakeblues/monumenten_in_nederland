        schema:name "Oudehaske (Aldehaske) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "251" ;
        schema:pageStart "251" ;
        schema:pagination "251" ;
        schema:text "De Herv. kerk (Badweg ong.) is een recht gesloten zaalkerk voorzien van een houten geveltoren met ingesnoerde spits. De in 1906 gebouwde kerk heeft rondboogvensters in verdiepte velden en aan de achterzijde meer recente aanbouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01238> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudehaske (Aldehaske) (gemeente Skarsterlân) – Woonhuizen"@nl ;
