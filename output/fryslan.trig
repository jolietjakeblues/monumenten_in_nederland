        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0024> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Poldermolen ‘De Kievit’ (Sânwei 21), gelegen ten zuiden van Berlikum, is een met riet gedekte achtkantige grondzeiler, voorzien van een vijzel. De in 1802 gebouwde molen bemaalde de Berlikumerpolder en is voor het laatst in 1995 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0024.php> .

