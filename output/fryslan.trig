        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 916 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0098> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Boerderijen. Uit de eerste helft van de 19de eeuw stamt Ooste 61, een koprompboerderij met onderkelderd voorhuis. De stelpboerderij Symkewâl 1 met bakstenen dakkapel is rond 1900 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00917> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koudum (gemeente Nijefurd) – Horeca"@nl ;
        min:adres "Hoofdstraat 69",
            "Hoogstraat 2-4/Hoofdstraat 1",
            "Molenbuurt bij 14",
            "Symkewâl 15" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Nijefurd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koudum (gemeente Nijefurd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Koudum" ;
        min:lemma "Horeca" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 917 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0098> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text """Horeca. De voorm. herberg Het Wapen van Friesland (Hoogstraat 2-4/Hoofdstraat 1) is een fors, langgerekt pand uit 1850. Het gepleisterde pand Spoorzicht (Hoofdstraat 69) met een mogelijk 18de-eeuwse kern is thans café.

De voorm. coöperatieve zuivelfabriek ‘Concordia’ met directeurswoning (Symkewâl 15) dateert uit 1898 en is in 1916 uitgebreid. Het complex bestaat uit diverse bouwdelen met platte daken en zadeldaken en een schoorsteen.

De windmolen ‘De Vlijt’ (Molenbuurt bij 14) is een houten spinnenkopmolen op een houten onderbouw met stelling. De als poldermolen van de Oppenhuisterpolder gebouwde molen is in 1986 overgebracht naar de huidige plaats en ingericht als korenmolen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00918> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Skarsterlân" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Langweer (Langwar) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Langweer" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 918 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill258> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0099> ;
        schema:name "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Dorp, waarschijnlijk rond 1100 ontstaan op een hoger gelegen zandrug die als ontginningsbasis fungeerde (Buorren). De langgerekte agrarische nederzetting groeide rond 1600, dankzij de gunstige ligging aan waterwegen en de Langweerderwielen, uit tot een haven- en marktplaats. Anders dan het open karakter van de buurt bij de kerk heeft de meer oostelijk aan de Buorren gelegen haven- en handelsbuurt een meer compacte bebouwing. Na de Tweede Wereldoorlog is Langweer aan de west- en noordzijde uitgebreid. Bij de Langweerderwielen is een jachthaven gerealiseerd. Langweer is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00919> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        min:adres "Oasingaleane 9" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Skarsterlân" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Langweer (Langwar) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Langweer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45164> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "13238" ;
        min:soort "inleiding" ;
        min:volgnummer 919 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0099> ;
        schema:name "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De Herv. kerk (Oasingaleane 9) is een driezijdig gesloten zaalkerk voorzien van een toren van drie geledingen met ingesnoerde spits. De kerk kwam in 1777 tot stand ter vervanging van een voorganger uit 1663. Het snijraam in Lodewijk XVI-stijl boven de ingang toont hoornen des overvloeds. De torengeledingen hebben van onder naar boven dorische-, ionische- en corintische hoekpilasters. In de toren hangt een door Johannes van Bomen gegoten klok (1438) en een klok van Petrus Overney (1683). De kerk is in 1923 gerestaureerd onder leiding van G.J. Veenstra."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00920> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Skarsterlân" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Langweer (Langwar) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Langweer" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 920 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0099> ;
        schema:name "Langweer (Langwar) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Tot de 17de-eeuwse inventaris behoren een preekstoel met symbolische voorstellingen (1684), vervaardigd door Benedictus Jans, een doophek, enkele herenbanken, waaronder die van de familie Eysinga, en twaalf banken met gesneden wangstukken. Verder bevat de kerk een zerk uit 1740 en een door Lambertus van Dam gebouwd orgel (1784), met borstwering en orgelkast door Lubbartus Bekenkamp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0099.php> .

