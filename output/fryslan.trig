        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0010> ;
        schema:name "Akmarijp (Eagmaryp) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Vaartdorp, ontstaan in de 12de eeuw op een meer oostelijk gelegen ontginningsas en nadien verplaatst in westelijke richting naar een ontginningsas op de huidige plek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00227> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Akmarijp (Eagmaryp) (gemeente Skarsterlân)"@nl ;
        min:adres "Fjildwei 21" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Skarsterlân" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Akmarijp (Eagmaryp) (gemeente Skarsterlân)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Akmarijp" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 227 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0010> ;
        schema:name "Akmarijp (Eagmaryp) (gemeente Skarsterlân)"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De klokkenstoel op het kerkhof (Fjildwei 21) is een wit geschilderde houten klokkenstoel met helmdak. De eerste klokkenstoel werd in 1844 opgericht ter vervanging van de toen afgebroken toren. In de klokkenstoel hangt een door Johan ter Steghe gegoten klok (1545). Het kerkhof heeft een gietijzeren toegangshek uit circa 1880 waarin diverse doodssymbolen zijn verwerkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00228> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Akmarijp (Eagmaryp) (gemeente Skarsterlân) – Boerderijen"@nl ;
