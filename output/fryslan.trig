        min:volgnummer 441 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "Op het kerkhof staat een zuil op postament voor D.H.F. van Setten († 1911). De pastorie (Martenawei 7) uit circa 1890 heeft neorenaissance-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00442> a min:Passage,
