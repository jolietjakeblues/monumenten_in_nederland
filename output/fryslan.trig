        schema:text "De voorm. lagere school (Nieuwbuursterweg 2) is in 1830 gebouwd als een tweeklassige school met een zadeldak tussen topgevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0180.php> .

