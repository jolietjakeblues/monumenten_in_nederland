        min:hoofdstuk "Steden, dorpen, monumenten › Jistrum (Eestrum) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jistrum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 861 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0092> ;
        schema:name "Jistrum (Eestrum) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een zandrug. Langs de oude postroute van Leeuwarden naar Groningen kwam een langgerekt esdorp met brinkachtige ruimte tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00862> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Jistrum (Eestrum) (gemeente Tytsjerksteradiel)"@nl ;
        min:adres "Schoolstraat 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Tytsjerksteradiel" ;
        min:gemeenteInBoek "Tytsjerksteradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tytsjerksteradiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Jistrum (Eestrum) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Jistrum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43787> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35645" ;
        min:soort "inleiding" ;
        min:volgnummer 862 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0092> ;
        schema:name "Jistrum (Eestrum) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De Herv. kerk (Schoolstraat 2), oorspronkelijk gewijd aan St. Petrus, is een eenbeukige kerk met halfrond gesloten koor en een ongelede toren met zadeldak. De kerk is in het midden van de 13de eeuw op een hoogte gebouwd en wordt omringd door een kerkhof. Het is één van de best bewaarde, geheel bakstenen romano-gotische kerken van Friesland en doet door de kleine rondboogvensters en de versiering met keperfries aan de bovenzijde nog sterk romaans aan. De mogelijk iets oudere toren (circa 1230) heeft spaarvelden met rondboogfriezen. Aan de noordzijde van de kerk bevindt zich een dichtgemetselde, laat-15de-eeuwse gotische ingang. In 1607 (d) werden de trekbalken en de kapconstructie vernieuwd. De spitsboogvensters aan de noordzijde zullen in de 18de eeuw zijn aangebracht. De kerk is in 1947-'49 gerestaureerd. Het interieur wordt gedekt door romano-gotische koepelgewelven, elk met acht ronde ribben die in een rozet samenkomen. Het westelijke gewelf heeft vierkante ribben. Tot de inventaris behoren een preekstoel uit de derde kwart van 17de eeuw en een orgelgalerij uit 1677."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00863> a min:Passage,
            schema:CreativeWork ;
