        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sumar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27134> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35680" ;
        min:soort "inleiding" ;
        min:volgnummer 1453 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0170> ;
        schema:name "Sumar (Suameer) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "De Herv. kerk (Greate Buorren 14) is een zaalkerk met driezijdig gesloten koor en een ingebouwde toren met ingesnoerde spits, gebouwd in 1769 in opdracht van de familie Van Altena ter vervanging van een oudere kerk. Tot de inventaris behoren een door Kornelis Meenes vervaardigde preekstoel (1746), een herenbank (18de eeuw) en een door Bakker & Timmenga gebouwd orgel (1906). Verder zijn er zes (bijgewerkte) gebrandschilderde ramen van Ype Staak (1771). Het in 1915 gebouwde voorm. Herv. verenigingsgebouw annex kosterswoning (Greate Buorren 16) vertoont neorenaissance-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0170.php> .

