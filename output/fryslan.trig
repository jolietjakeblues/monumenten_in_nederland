        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "524386" ;
        min:soort "inleiding" ;
        min:volgnummer 443 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0038> ;
        schema:name "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "In het bouwhuis (Martenawei 3) zijn verscheidene 17de-eeuwse bouwfragmenten ingemetseld, waaronder een steen ter nagedachtenis van Laes van Burmania en Julia Augusta van Aylva (1687) en een deel van een 18de-eeuwse vensteromlijsting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00444> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Cornjum (Koarnjum) (gemeente Leeuwarderadeel)"@nl ;
        min:adres "Aldlânsdyk 1" ;
