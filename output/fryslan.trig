        min:soort "inleiding" ;
        min:volgnummer 278 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill74> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0017> ;
        schema:name "Augustinusga (Stiensgea) (gemeente Achtkarspelen)"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "73" ;
        schema:pagination "73-74" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen op de splitsing van de wegen van Buitenpost naar Drachten, respectievelijk Surhuizum. Met de bouw van een zuivelfabriek in 1897 - in 1968 gesloten - kwam het dorp verder tot ontwikkeling. In 1917 werd een Geref. kerk gebouwd. Na de Tweede Wereldoorlog is Augustinusga aan de zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0017.php> .

