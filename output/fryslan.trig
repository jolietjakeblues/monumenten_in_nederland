        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boksum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Boksum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16153> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28584" ;
        min:soort "inleiding" ;
        min:volgnummer 368 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0030> ;
        schema:name "Boksum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "86" ;
        schema:pageStart "86" ;
        schema:pagination "86" ;
        schema:text "De Herv. kerk (Sint Margrietwei 1), oorspronkelijk gewijd aan St. Margaretha, is een eenbeukige kerk met vijfzijdig gesloten koor en een toren van vier geledingen met ingesnoerde spits. Het schip met steunberen bevat 12de-eeuws tufsteenwerk. In de vroege 14de eeuw, en ook in de 15de en 16de eeuw is de kerk vergroot en verhoogd. De voormalige noordingang heeft een vroeg-16de-eeuwse spitsboogomlijsting met halfronde colonetten, waarbinnen later een halfrond venster is geplaatst. De toren is volgens een gedenksteen in 1843 herbouwd met gebruik van oude stenen en vervolgens in 1879 ommetseld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00369> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boksum (gemeente Menaldumadeel)"@nl ;
        min:adres "Heechpad 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boksum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Boksum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 369 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill96> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0030> ;
        schema:name "Boksum (gemeente Menaldumadeel)"@nl ;
        schema:pageEnd "86" ;
        schema:pageStart "86" ;
        schema:pagination "86" ;
        schema:text "Tot de kerkinventaris behoren twee overhuifde herenbanken (1661 en 1826), een 17de-eeuws memoriebord voor de gevallenen in de slag bij Boksum in 1586 en een door Jan Harmens Camp gebouwd orgel (1675; gewijzigd door L. van Dam in 1798). Opvallend zijn de geschilderde draperieën in de orgelnis. Onder de houten vloer ligt een door Pieter Dirxsz. gebeeldhouwde grafzerk in vroege renaissance-stijl (1561) voor Worp van Juckema († 1560) en Anna van Mockema. Op het kerkhof staat een baarhuisje uit circa 1860. De pastorie (Heechpad 1) is een neoclassicistisch, middenganghuis uit circa 1850 met bijbehorend koetshuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00370> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boksum (gemeente Menaldumadeel)"@nl ;
        min:adres "Oedsmawei 17" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
