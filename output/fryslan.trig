        schema:name "Minnertsga (Minnertsgea) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Het kerklokaal van de Nederlands Herv. Gemeente (Meinardswei 6) - een zaalgebouw met uitgebouwd ingangsportaal - is opgetrokken rond 1930 in zakelijk-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0113.php> .

