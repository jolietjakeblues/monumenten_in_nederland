        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goutum (gemeente Leeuwarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Goutum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0068> ;
        schema:name "Goutum (gemeente Leeuwarden)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "Dorp, ontstaan in de volle middeleeuwen op enkele terpen, op een noord-zuid gerichte kwelderrug opgeworpen. Ten zuidwesten van de kerk lag de Wiarda State, die in 1882 is gesloopt. In de 19de eeuw vond enige verdichting van de dorpsbebouwing plaats en aan het eind van die eeuw ontstond aan de westzijde een lintvormige uitbreiding, richting Overijsselseweg. De kerkterp is rond 1900 deels afgegraven. Na de Tweede Wereldoorlog is Goutum verder uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00676> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goutum (gemeente Leeuwarden)"@nl ;
        min:adres "Buorren 23" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Leeuwarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goutum (gemeente Leeuwarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Goutum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15845> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "24509" ;
        min:soort "inleiding" ;
        min:volgnummer 676 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0068> ;
        schema:name "Goutum (gemeente Leeuwarden)"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "144" ;
        schema:pagination "144-145" ;
        schema:text "De Herv. kerk (Buorren 23), oorspronkelijk gewijd aan St. Agnes, is een eenbeukige kerk met vijfzijdig gesloten koor en een zadeldaktoren van drie geledingen. Van de oorspronkelijke romaanse kerk uit de 11de of 12de eeuw resteert tufsteenwerk in de noordmuur van het schip. Het koor en de zuidmuur van het schip zijn in de 15de eeuw nieuw opgetrokken en vertonen veel sporen van latere herstellingen. De huidige ramen zijn in de 19de eeuw aangebracht, waarbij de vensters zijn verkleind. De forse toren met nissengeleding uit de 15de eeuw is eveneens verschillende keren hersteld, blijkens jaartalstenen in de westgevel onder meer in 1631 en 1737. De wijzerplaat draagt ook het jaartal 1737. In de toren hangt een door Geert van Wou en Johan Schonenborch gegoten klok (1511)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00677> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goutum (gemeente Leeuwarden)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Leeuwarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goutum (gemeente Leeuwarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Goutum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 677 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0068> ;
        schema:name "Goutum (gemeente Leeuwarden)"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text "Tot de kerkinventaris behoren twee wapenborden van de familie Cammingha (circa 1743 en 1858), een preekstoel, een doophek (eerste helft 19de eeuw), enige zerken en acht loden platen van lijkkisten uit de grafkelder van de familie Cammingha (18de eeuw) en een door de firma L. van Dam & Zn. gebouwd orgel (1864)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00678> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goutum (gemeente Leeuwarden) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Leeuwarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Goutum (gemeente Leeuwarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Goutum" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 678 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0068> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "145" ;
        schema:pageStart "145" ;
        schema:pagination "145" ;
        schema:text "Woonhuizen. Het gepleisterde middenganghuis Buorren 6 is rond 1870 gebouwd naar een ontwerp in eclectische vormen van H.R. Stoett. Het naastgelegen (verbouwde) koetshuis is uit dezelfde tijd. Bij de kerk staan enkele 19de-eeuwse dorpshuizen en het in neorenaissance-vormen uitgevoerde eenlaagspand Buorren 19 (1894), dat ook als kosterij heeft dienst gedaan. Achter het huis staat een laat-19de-eeuwse paardenstal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00679> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Goutum (gemeente Leeuwarden) – Boerderijen"@nl ;
        min:adres "Techumerdyk 10",
            "Wergeasterdyk 66" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
