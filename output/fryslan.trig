        min:hoofdstuk "Steden, dorpen, monumenten › Woudsend (Waldsein) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Woudsend" ;
        min:lemma "Winkels" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1692 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill481> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0206> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Winkels. Het pand Midstrjitte 63 heeft een winkelpui uit 1805 met omlijste ingang en etalage-vensters en tekst: brood-beschuit-koek-banket. De in 1904 gebouwde bakkerij Op e Romte 20 is ontworpen door Visser. Uit circa 1910 dateren de voorm. kaaswinkel Midstrjitte 81, opgetrokken in kalkzandsteen met decoraties in rode baksteen, en het woon- en winkelpand Midstrjitte 18 met neorenaissance-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0206.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01693> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woudsend (Waldsein) (gemeente Wymbritseradiel) – Windmolens"@nl ;
        min:adres "Ald Wyk 16",
            "Alde Wyk 18",
            "Molestrjitte 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wymbritseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woudsend (Waldsein) (gemeente Wymbritseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Woudsend" ;
        min:lemma "Windmolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32832>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36075> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39827",
            "39846" ;
        min:soort "lemma" ;
        min:volgnummer 1693 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0206> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Windmolens. De achtkantige stellingmolen Het Lam (Molestrjitte 4) is vóór 1698 gebouwd als koren- en pelmolen. De voor het laatst in 2000 gerestaureerde molen bestaat uit een gepleisterde bakstenen onderbouw en een met riet bekleed houten achtkant en kap. De Jager (Alde Wyk 18) is een achtkantige, met riet beklede stellingmolen. De rechthoekige onderbouw gaat aan weerszijden over in een langwerpige houten zaagschuur op bakstenen poeren. De molen is voorzien van drie zaagramen en een sleephelling. De houtzaagmolen is vermoedelijk in 1719 gebouwd en onder meer in 1994 gerestaureerd. Vlakbij ligt een molenkolk voor het wateren van het hout. Het Molenhuis (Ald Wyk 16) is een eenlaags molenaarshuis met neoclassicistische vormen uit de tweede helft van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0206.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01694> a min:Passage,
