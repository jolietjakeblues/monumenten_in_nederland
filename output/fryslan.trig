        schema:name "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "Terpdorp, ontstaan enkele eeuwen voor het begin van onze jaartelling. De hoge terp is aan het eind van de 19de eeuw vooral aan de zuidzijde voor een belangrijk deel afgegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01552> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        min:adres "Tsjerkepaed 6" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wânswert (Wanswerd) (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wânswert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38587> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15643" ;
        min:soort "inleiding" ;
        min:volgnummer 1552 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0188> ;
        schema:name "Wânswert (Wanswerd) (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "De Herv. kerk (Tsjerkepaed 6), oorspronkelijk gewijd aan St. Petrus, is een eenbeukige kerk met smaller, vijfzijdig gesloten koor en een forse zadeldaktoren van vier geledingen. Van het koor is de wijding in 1335 bekend. Tegen het koor verrees in de 16de eeuw het huidige laatgotische schip, gevolgd door de bouw van de zadeldaktoren (met klok uit 1402). In 1778 werd het noordelijke deel van het koor beklampt, in 1794 heeft men een nieuwe kap met tongewelf aangebracht. In 1882 werd de rest van het koor ommetseld. De kerk bevat een fraaie hardstenen zerk voor Sipt van Goslingha († 1561) en Paerck Zyaerda, vervaardigd door Pieter Dirxsz in vroege renaissance-vormen (1562), en voorts een door W. Hardorff gebouwd orgel (1877)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01553> a min:Passage,
