        min:hoofdstuk "Steden, dorpen, monumenten › Oentsjerk (Oenkerk) (gemeente Tytsjerksteradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oentsjerk" ;
