        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "De Geref. kerk (Hogebeintumerweg 5) is een T-vormige kerk met portiek uit circa 1920; het Rehobothlokaal is later aangebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00612> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ferwert (Ferwerd) (gemeente Ferwerderadiel)"@nl ;
        min:adres "Hogebeintumerweg 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
