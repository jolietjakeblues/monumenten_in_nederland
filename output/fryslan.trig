        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sneek (Snits)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sneek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16834> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "34067" ;
        min:soort "inleiding" ;
        min:volgnummer 1418 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill397> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0166> ;
        schema:name "Sneek (Snits)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "279" ;
        schema:pagination "279-280" ;
        schema:text "De Doopsgez. kerk (Singel 28) [2] is een zaalkerk met halfronde sluiting, gebouwd in 1842 naar plannen van P.J. Rollema. De streng neoclassicistische voorgevel heeft vier dorische hardstenen pilasters en een houten fronton. Het interieur wordt gedekt door een stucwerkplafond op korintische stucwerkpilasters. Het door J.C. Scheuer gebouwde orgel (1847) bevat ouder pijpwerk (1786) van A. van Gruisen. De door H.H. Kramer ontworpen forse pastorie (Singel 30) vertoont neorenaissance-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01419> a min:Passage,
            schema:CreativeWork ;
