        min:kern "Sint Jacobiparochie" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1380 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Wegdorp, aanvankelijk Wijngaarden geheten en ontstaan in de 16de eeuw aan de Middelweg, die in oost-west richting het kort na 1505 ingepolderde deel van Het Bildt doorsnijdt. De bebouwing heeft zich met name rond de kerk nabij de kruising van Oosteinde-Westeinde (Middelweg) en Zuideinde ontwikkeld. Na de Tweede Wereldoorlog is het dorp aan de noord- en zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        min:adres "Oosteinde 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36618> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9511" ;
        min:soort "inleiding" ;
        min:volgnummer 1381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "De Herv. kerk (Oosteinde 1) is een brede, dwars geplaatste zaalkerk voorzien van een voorhal met klokkentoren. De neoclassicistische kerk werd in 1843 gebouwd naar ontwerp van Th.A. Romein, ter vervanging van een vroeg-16de-eeuwse, in de 17de eeuw tot kruiskerk vergrote voorganger. Boven de hal met dorisch zuilenportiek en fronton verrijst de klokkentoren met vierkante onderbouw en een open ronde lantaarn met zes zuilen. De gepleisterde voor- en zijgevels zijn voorzien van een decoratieve kroonlijst met metopen- en trigliefenfries. In de sobere, gesausde achtergevel bevindt zich een stichtingssteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01382> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1382 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Het interieur met gestucte pilasters en vensteromlijstingen wordt gedekt door een gestuct gewelf. De preekstoel uit de bouwtijd is weliswaar bewaard gebleven, maar is in bruikleen afgestaan aan het museum van Schokland. Het orgel is gebouwd door L. van Dam & Zn. (1844), met gebruik van elders afkomstige onderdelen van een door Johan Spoorman vervaardigd orgel (1788). Onder de houten vloer in de kerk en op het kerkhof ligt een aantal 17de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01383> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        min:adres "Georg van Saksenstraat 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22074> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9521" ;
        min:soort "inleiding" ;
        min:volgnummer 1383 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Achter de kerk staat de pastorie (Georg van Saksenstraat 3), een eenlaags herenhuis met omgaand zadeldak voorzien van hoekschoorstenen en boven de ingang een smalle halsgevel in Lodewijk XV-stijl met het jaartal 1760."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01384> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1384 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text """Woonhuizen. Volgens de jaartalankers is Oosteinde 20, een diep pand met zadeldak tussen tuitgevels, gebouwd in 1765. Oorspronkelijk bestond het huis uit meerdere eenkamerwoningen. Bij het rond 1790 gebouwde diepe huis Oosteinde 11 is de trapgevel nieuw opgetrokken. Oosteinde 57 is een middenganghuis uit circa 1910. De serre tegen de rechterzijgevel bevat de oorspronkelijke, geometrisch verdeelde vensters en kleurige jugendstil-tegels. De in 1914 naar ontwerp van A. Bijlsma gebouwde villa Oosteinde 106 vertoont decoratieve jugendstil- en chaletstijl-elementen. Oosteinde 38 is een villa in nieuw historiserende stijl, gebouwd in 1915 naar ontwerp van G.J. Veenstra voor de arts Tj. Wassenaar. Het forse eenlaags huis heeft een hoge zolderverdieping onder het afgewolfde zadeldak, waarop een zeszijdige lantaarn is geplaatst. Het interieur is grotendeels oorspronkelijk met op de begane grond de wachtkamer, behandelkamer en apotheek. De glas-in-loodvensters van het trappenhuis hebben figuratieve voorstellingen. Het gelijktijdig gebouwde koetshuis is verbouwd tot garage.

Van de voorm. boerderij Kadal 2 resteert het dwars geplaatste, brede voorhuis met op de topgevel de jaartalankers ‘1849’. In het verlengde bevindt zich een smal bouwdeel, dat dienst heeft gedaan als cichorei-eest, gelet op de vuurplaats en doorboorde tegels op de balklaag."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01385> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt) – Pakhuizen"@nl ;
        min:adres "G. van Swietenstraat 23",
            "Middelweg-Oost 225",
            "Oudebildtdijk 1093",
            "Oudebildtdijk 1096",
            "Oudebildtdijk 1222",
            "Zuideinde 64",
            "Zuideinde 78" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:lemma "Pakhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57436> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9520" ;
        min:soort "lemma" ;
        min:volgnummer 1385 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill385> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Pakhuizen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "271" ;
        schema:pagination "271-272" ;
        schema:text """Pakhuizen. Het rond 1860 gebouwde graanpakhuis Zuideinde 44 is in 1920 vergroot. Het pakhuis Zuideinde 28, met zadeldak tussen tuitgevels, is gebouwd rond 1870. De gevels zijn opgetrokken van gele steen met boven de vensters wenkbrauwen in rode baksteen.

Het molenaarshuis (bij Middelweg-Oost 225) is een herenhuis in eclectische stijl, gebouwd in 1881 als onderdeel van een complex, bestaande uit een woonhuis, de korenmolen ‘De Welkomst’ en een boerderij met schuur. De molen is na brand in 1975 niet weer opgebouwd. De boerderij is vernieuwd.

Het café ‘De aardappelbeurs’ (Zuideinde 64) is een blokvormig gebouw met plat dak. Bij een verbouwing in 1922, naar ontwerp van P. de Vries, kreeg het van oorsprong 19de-eeuwse café met bijbehorende schuur het huidige aanzicht. Daarbij is de bovenzaal toegevoegd en zijn de gevels bekleed en voorzien van steunberen in zakelijk-expressionistische vormen.

De watertoren (G. van Swietenstraat 23) is een slanke toren van gewapend beton met fors betonnen vlakbodemreservoir, gebouwd in 1957 naar ontwerp van jhr. A.P. Wesselman van Helmond.

De Alg. begraafplaats (Zuideinde 78), aangelegd in 1875, heeft bij de toegang een decoratief gietijzeren hekwerk.

De openbare lagere school (Oudebildtdijk 1093), gelegen ten noorden van Sint Jacobiparochie, is in 1899 gebouwd ter vervanging van een schoolgebouw uit 1836. De vierklassige gangschool in neorenaissance-stijl draagt op de kopse gevel het wapenschild van de gemeente Het Bildt. Aan de noordzijde van de dijk ligt de bijbehorende onderwijzerswoning (Oudebildtdijk 1096), een blokvormig pand met gepleisterde gevelomlijsting.

De dijkwoning Oudebildtdijk 770, gelegen ten noorden van Sint Jacobiparochie, is rond 1850 gebouwd en was oorspronkelijk eigendom van het Waterschap Oude Bildt. Het eenlaagspand met schilddak is een goed voorbeeld van de vele 19de-eeuwse dijkwoningen langs de Nieuwe- en Oudebildtdijk.

Het strandhuis van het zeewerend Waterschap Het Oude Bildt (Oudebildtdijk 1222), gelegen ten noordwesten van Sint Jacobiparochie is een rond 1880 opgetrokken blokvormig tweelaags pand met schilddak en twee hoekschoorstenen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01386> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt) – Boerderijen"@nl ;
        min:adres "Oudebildtdijk 1056",
            "Oudebildtdijk 627" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Het Bildt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Jacobiparochie (Sint Jabik) (gemeente Het Bildt)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Sint Jacobiparochie" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18641> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "9514" ;
        min:soort "lemma" ;
        min:volgnummer 1386 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0162> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Boerderijen. In de omgeving van Sint Jacobiparochie liggen interessante boerderijen van verschillende typen. De kop-hals-rompboerderij Oudebildtdijk 1115 is één van de oudste boerderijen langs de dijk. Het voorhuis met zadeldak tussen topgevels, waarbij de voorste van waterslagen en vlechtingen is voorzien, draagt de jaartalankers ‘1699’. Oudebildtdijk 833 en Oudebildtdijk 835 zijn laat-18de-eeuwse kop-hals-rompboerderijen; de laatste heeft een omlijste ingang midden in de lange gevel. Een vroeg-19de-eeuws voorbeeld van hetzelfde type is de boerderij Oudebildtdijk 976, die als één van de weinige buiten de oude (zee)dijk ligt. Het in het midden onderkelderde voorhuis heeft een voorgevel met schouderstukken en een (onleesbare) gevelsteen. Koudeweg 36 is een kop-hals-rompboerderij uit 1879. De omlijste voorgevel bevat een zoldervenster met accoladeboog. 't Weeskind' (Oudebildtdijk 627) is een vroeg-19de-eeuwse boerderij van het hoekplaatstype met een wit gepleisterd woonhuis met zadeldak tussen topgevels. De ingang bevindt zich achter in het voorhuis, de kelder ligt onder de linker buitenhoek. Van hetzelfde boerderijtype is Koudeweg 40, dat een kort voorhuis heeft en een schuur met de jaartalankers ‘1815’. Boerderij Itaca (Oudebildtdijk 1056) heeft een blokvormig onderkelderd eclectisch woonhuis uit 1876 voorzien van verhoogd middenrisaliet met balkon. De in 1906 in late neorenaissance-stijl gebouwde stelpboerderij Oude Bildtdijk 1016 heeft een onderkelderd middenrisaliet met boven de ingangspartij een dakkapel met fronton en klauwstukken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01387> a min:Passage,
