        schema:name "Noardburgum (Noordbergum) (gemeente Tytsjerksteradiel)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Dorp, ontstaan in de 19de eeuw door aaneengroeiing van verspreide bebouwing op de heide, die op initiatief van N. Ypey werd ontgonnen. In 1930 werd Noardburgum een zelfstandig dorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0123.php> .

