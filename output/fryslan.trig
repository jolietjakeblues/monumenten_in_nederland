        min:soort "lemma" ;
        min:volgnummer 993 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill305> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0101> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "Begraafplaatsen. De midden 19de eeuw gestichte Alg. begraafplaats (bij Straatweg 13) heeft een baarhuis met expressionistische details uit circa 1930. Voor de Isr. begraafplaats (bij Plattedijk 32) te Tacozijl, gelegen ten noordwesten van Lemmer aan de voet van de voorm. Zuiderzeedijk, werd de grond in 1802 aangekocht. De begraafplaats kon in 1876 worden uitgebreid dankzij de schenking van een hoger gelegen stuk grond door jhr. Van Swinderen. De begraafplaats, met eenvoudige grafstenen, is in 1994 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00994> a min:Passage,
            schema:CreativeWork ;
