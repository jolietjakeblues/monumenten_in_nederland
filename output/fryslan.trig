        min:kern "Ysbrechtum" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1706 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0208> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Woonhuizen. Karakteristieke eenlaags middenganghuizen in het dorp zijn de voorm. onderwijzerswoning Epemawei 23 (circa 1860) en Kleasterwei 19 (circa 1870)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0208.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01707> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ysbrechtum (gemeente Sneek) – Boerderijen"@nl ;
        min:adres "Hascarstrjitte 1",
            "Tolhek 2" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Sneek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ysbrechtum (gemeente Sneek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Ysbrechtum" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1707 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0208> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text """Boerderijen. De forse kop-halsrompboerderij Hascarsathe (Hascarstrjitte 1) kwam in 1859 tot stand en kreeg recent opvallende nieuwe dakkapellen. De stelpboerderij De Finne 7 stamt uit 1912.

Het voorm. tolhuis (Tolhek 2) is een diep eenlaagspand uit 1833 met attiekverdieping en neoclassicistische elementen.

Van de voorm. kerk van Tjalhuizum (Tsjalhuzum) (gemeente Wymbritseradiel), gelegen ten westen van Ysbrechtum, resteert de toren (Tjalhuizum ong.) van drie geledingen met ingesnoerde spits. De middeleeuwse kerk is in 1823 afgebroken. De kerktoren werd in 1871 gesloopt en door de huidige vervangen (gerestaureerd in 1992)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0208.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01708> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Dantumadiel" ;
        min:gemeenteInBoek "Dantumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dantumadiel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Zwaagwesteinde" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1708 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill485> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0209> ;
        schema:name "Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Streekdorp, gelegen op het westelijke uiteinde van de (Kollumer)zwaag, een keileemrug aan de rand van de hoger gelegen pleistocene gronden. In de 18de eeuw ontstond een lintbebouwing met spitketen en aan het eind van die eeuw stichtte Salomon Levy hier een kledingindustrie. In 1902 kreeg het dorp een halte aan de zuidelijker gelegen spoorlijn Leeuwarden-Groningen. Na de Tweede Wereldoorlog is Zwaagwesteinde flink naar het zuiden uitgebreid. De Herv. kerk uit 1836 is in 1972 gesloopt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0209.php> .

