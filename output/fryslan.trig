        schema:text "De belangrijkste nederzettingen op het eiland zijn: West-Terschelling, Formerum, Hoorn en Midsland. Zie hiervoor elders in het boek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0174.php> .

