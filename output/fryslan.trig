        schema:name "Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "Dorp, bestaande uit twee kernen met lintbebouwing aan een vermoedelijk laatmiddeleeuwse ontginningsas (Foarwei). Recenter is de bebouwing aan de haaks daarop staande weg (Jan Binneswei) naar Wijgeest. De kernen zijn in het begin van de 20ste eeuw aaneengegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01257> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        min:adres "Foarwei 46" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Kollumerland en Nieuw Kruisland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Oudwoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67141> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "23756" ;
        min:soort "inleiding" ;
        min:volgnummer 1257 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0141> ;
        schema:name "Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "De Herv. kerk (Foarwei 46) is een eenbeukige kerk met driezijdige sluiting en een kleine houten geveltoren. De huidige laat-gotische kerk werd in de 15de eeuw gebouwd met gebruik van materiaal van een voorganger. De westelijke beëindiging kwam in de periode 1689-'94 tot stand. Rond 1880 heeft men de kerk gepleisterd en voorzien van een nieuwe geveltoren. Bij de restauratie in 1965, naar plannen van A. Baart jr., is de kerk ontpleisterd. De kerk bevat zes gesneden en twee ruitvormige geschilderde rouwborden voor de heren van Veenklooster (Fogelsangh state) uit de periode 1675-1783; drie hiervan zijn afkomstig uit de kerk van Kollum. Tot de inventaris behoren verder een 18de-eeuwse preekstoel en overhuifde herenbank en een door L.J. van Dam & Zn. gebouwd orgel (1856)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0141.php> .

