    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01095> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Munnekeburen (gemeente Weststellingwerf) – Scherpenzeel"@nl ;
        min:adres "Grindweg 139" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Munnekeburen (gemeente Weststellingwerf)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Munnekeburen" ;
        min:lemma "Scherpenzeel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51034> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "38873" ;
        min:soort "lemma" ;
        min:volgnummer 1095 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0115> ;
        schema:name "Scherpenzeel"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "234" ;
        schema:pagination "234-235" ;
        schema:text "Scherpenzeel. Dit dorp ten zuiden van Munnekeburen wordt voor het eerst genoemd in 1245. De Herv. kerk (Grindweg 139), nu SOW-kerk, is een driezijdig gesloten zaalkerk voorzien van een toren van drie geledingen met ingesnoerde naaldspits. De in 1788 gebouwde kerk kreeg in 1860 aan de noordzijde een dwarsarm. De toren met neoclassicistische en neogotische details verrees in 1879. Erin hangt een door Jacob Noteman gegoten klok (1638). De kerk bevat vier door Ype Staak vervaardigde gebrandschilderde ramen (1788) en een door L. van Dam & Zn. gebouwd orgel (1881). De gedenkzuil (Grindweg ong.) voor de in Scherpenzeel geboren Pieter Stuyvesant is een slanke ionische zuil met bronzen schip, gemaakt in 1955 door de N.V. betonbouw v/h firma Koot & Wildeboer naar ontwerp van de kunstenaar J. Popma."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01096> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Munnekeburen (gemeente Weststellingwerf) – Spanga"@nl ;
        min:adres "Spangahoekweg 32",
            "Spangahoekweg 52" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Weststellingwerf" ;
        min:gemeenteInBoek "Weststellingwerf" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Weststellingwerf> ;
