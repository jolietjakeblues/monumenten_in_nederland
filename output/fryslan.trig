        min:soort "inleiding" ;
        min:volgnummer 996 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0102> ;
        schema:name "Lippenhuizen (Lippenhuzen) (gemeente Opsterland)"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "Streekdorp, ontstaan in de late middeleeuwen op een zandrug tussen heide en veen. De Opsterlandse Compagnonsvaart, gegraven door het zuidelijk gelegen veen, is in 1718 ter hoogte van de kerk doorgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00997> a min:Passage,
