        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Het woonhuis Slachtersrige 6 is een eenvoudig pand uit 1726 met zadeldak tussen topgevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00313> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetgum (Bitgum) (gemeente Menaldumadeel) – Beetgumermolen (Bitgummole)"@nl ;
        min:adres "J.H. van Aismawei 11",
            "J.H. van Aismawei 52",
            "J.H. van Aismawei 9",
            "J.H. van Aismawei 93" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetgum (Bitgum) (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetgum" ;
        min:lemma "Beetgumermolen (Bitgummole)" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 313 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0022> ;
        schema:name "Beetgumermolen (Bitgummole)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "78" ;
        schema:pagination "78-79" ;
        schema:text "Beetgumermolen (Bitgummole). Dit dorp ten oosten van Beetgum is ontstaan uit het buurtschap ‘Bij de Molen’ of ‘Dijksterhuizen’, dat rond een molen bij de voormalige zeedijk tot ontwikkeling kwam en in de 18de en 19de eeuw uitgroeide tot een streekdorp met de naam Beetgumermolen. De woonhuizen J.H. van Aismawei 18 en 58 en ‘Nieuw Aisma’ (J.H. van Aismawei 93) zijn karakteristieke middenganghuizen in eclectische stijl, gebouwd rond 1870 met een hoger opgetrokken middenpartij, versierd met pilasters of paneellisenen. De kop-hals-rompboerderij Dyksterhuzen 32 dateert in oorsprong uit circa 1870. Het lage voorhuis heeft een omlijste ingang met ionische pilasters. De omstreeks 1830 gebouwde herberg ‘Groot Terhorne’ (J.H. van Aismawei 52) - genoemd naar een in 1876 afgebroken state tussen Beetgum en Beetgumermolen - is een neoclassicistisch pand met decoratieve kroonlijst en bij de begane grond een geleding met toskaanse pilasters. In 1924 naar ontwerp van A. Nauta in expressionistische stijl gebouwd is de Geref. kerk (J.H. van Aismawei 11), een kruiskerk met aan de zuidoostzijde een toren met wimbergen en een tentdak. Kenmerkend is het gebruik van gekleurd glas voor decoratieve elementen. De kerk bevat een door Bakker & Timmenga gebouwd orgel (1899). De pastorie (J.H. van Aismawei 9) dateert eveneens uit 1924."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00314> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetgum (Bitgum) (gemeente Menaldumadeel) – Engelum (Ingelum)"@nl ;
        min:adres "Tsjerkeleane 1",
            "Tsjerkeleane 4" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetgum (Bitgum) (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetgum" ;
        min:lemma "Engelum (Ingelum)" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25134> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28613" ;
        min:soort "lemma" ;
        min:volgnummer 314 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0022> ;
        schema:name "Engelum (Ingelum)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Engelum (Ingelum). Terpdorp ten zuidoosten van Beetgum. De Herv. kerk (Tsjerkeleane 4) is een driezijdig gesloten zaalkerk voorzien van een toren van drie geledingen met ingesnoerde spits. De toren heeft mogelijk een middeleeuwse kern en is herbouwd in 1887. De in 1773 herbouwde kerk is in 1975 door brand verwoest en na restauratie in 1980 weer in gebruik genomen. De kerk bevat een 17de-eeuwse preekstoel en onder de huidige vloer een 17de-eeuwse grafzerk voor de familie Grovestins-Asscheberg. De pastorie (Tsjerkeleane 1) is een eclectisch middenganghuis met hoger opgetrokken middenrisaliet, gebouwd in 1879 naar plannen van H.S. Reisma."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00315> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetsterzwaag (Beetstersweach) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetsterzwaag" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 315 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill82> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0023> ;
        schema:name "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Streekdorp, ontstaan op een zandrug vanuit het westelijker gelegen Oud-Beets. Al in de 17de eeuw roemde men het dorp om zijn fraaie buitenhuizen waarvan er in 1684 ten minste vier waren. Vooral in de 19de eeuw groeide deze hoofdplaats van Opsterland uit tot een deftig dorp met ‘een kilometer adellijke huizen’ omringd door parken en bossen. Tot 1940 hielden de huiseigenaren en grootgrondbezitters eventuele grootschalige uitbreidingen tegen. Daarna werd Beetsterzwaag een forensendorp van Drachten, met woonwijken haaks op de oude bewoningsas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00316> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        min:adres "Hoofdstraat 15" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetsterzwaag (Beetstersweach) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetsterzwaag" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 316 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0023> ;
        schema:name "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "De Herv. kerk (Hoofdstraat 15), nu SOW-kerk, is een driezijdig gesloten zaalkerk voorzien van een ongelede toren met achtkantige spits. De in 1803-'04 gebouwde kerk kreeg in de 20ste eeuw een dwars aangebouwde consistorie. In de toren hangt een door Cornelis Crans gegoten klok (1739). Tot de kerkinventaris behoren een midden-17de-eeuwse preekstoel, herenbanken voor de families Van Lijnden en Van Teijens, en een door L. van Dam & Zn. gebouwd orgel (1856). Verder zijn er gebeeldhouwde grafzerken met de wapens van de familie Fockens (1614 en 1635). Op het kerkhof bevinden zich onder meer de omhekte zerk van O. van Teijens († 1866) en een omhekt veld met voornamelijk 19de-eeuwse zerken van de familie Harinxma thoe Slooten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00317> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        min:adres "Beetsterweg 22" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Opsterland" ;
        min:gemeenteInBoek "Opsterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Opsterland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beetsterzwaag (Beetstersweach) (gemeente Opsterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Beetsterzwaag" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 317 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0023> ;
        schema:name "Beetsterzwaag (Beetstersweach) (gemeente Opsterland)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Van de voorm. Herv. kerk van Oud-Beets (bij Beetsterweg 22), gebouwd in 1889, resteren na de sloop in 1984 nog slechts de fundamenten. Op de voormalige kerkvloer zijn enkele gebeeldhouwde grafzerken schuin tegen elkaar opgesteld. Aan de ene zijde de zerk in Lodewijk XIV-vormen van Augustinus Lycklama à Nijeholt († 1744) en zijn vrouw Dijdo van Andringen († 1719) en aan de andere zijde twee zerken in Lodewijk XV-vormen van de familie Scheltinga (1765 en 1773). Op het kerkhof bevinden zich de grafkelder van de familie Van Lijnden (1878) en een omhekt veld met treurende engel en zeven laat-19de-eeuwse zerken van de familie Lycklama à Nijeholt. De nieuwe houten klokkenstoel en de klok dateren uit 1988."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0023.php> .

