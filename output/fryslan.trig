        schema:name "Tjalleberd (Tsjalbert) (gemeente Heerenveen)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Het woonhuis Aengwirderweg 294 is een middengangshuis uit 1906 met jugendstil-details, gebouwd naar plannen van S.H. Zwarts."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01487> a min:Passage,
