        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0209> ;
        schema:name "Zwaagwesteinde (De Westerein) (gemeente Dantumadeel)"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "De voorm. openbare lagere school (Zuider Stationsstraat 1) is een langgerekt schoolgebouw uit 1896 met een onderwijzerswoning uit 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01711> a min:Passage,
