        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0141> ;
        schema:name "Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "De openbare lagere school (Foarwei 34) is een tweeklassige middengangschool met naastgelegen onderwijzerswoning (Foarwei 36), gebouwd in 1898 en verbouwd in 1953 en 1986. In de gevel bevindt zich een gevelsteen in rococo-vormen van een voorganger uit 1775, gesticht door grietman Hendrik van Hiemstra (Heemstra)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01260> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudwoude (Aldwâld) (gemeente Kollumerland en Nieuw Kruisland) – Boerderijen"@nl ;
