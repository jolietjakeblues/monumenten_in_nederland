        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De pastorie (Greate Buorren 18-20) is een sober neoclassicistisch eenlaagspand uit circa 1900. De voorm. pastorie (Efter de Wâl 12) heeft een oudere kern, maar kreeg rond 1905 een nieuw uiterlijk met jugendstil-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0033.php> .

