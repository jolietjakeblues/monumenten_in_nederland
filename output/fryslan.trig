        min:kern "Marssum" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54835> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "28618" ;
        min:soort "lemma" ;
        min:volgnummer 1045 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "229" ;
        schema:pageStart "229" ;
        schema:pagination "229" ;
        schema:text "Boerderijen. De kop-hals-rompboerderij Luniastate (Bitgumerdyk 87) heeft in de voorgevel tussen twee kloostervensters een wapensteen met het jaartal 1726 en de naam Jan Teekes Lunia. Andere kop-hals-rompboerderijen zijn Hegedyk 1, waarvan het houtskelet van de schuur uit de 18de eeuw dateert, en Haven 8 uit de eerste helft van de 19de eeuw. De laatste ligt aan de rand van de dorpsterp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01046> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marssum (gemeente Menaldumadeel) – Poldermolens"@nl ;
        min:adres "Franjumbuorsterpaed 29",
            "Hegedyk 44" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Waadhoeke" ;
        min:gemeenteInBoek "Menaldumadeel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waadhoeke> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marssum (gemeente Menaldumadeel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marssum" ;
        min:lemma "Poldermolens" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1046 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0108> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "229" ;
        schema:pageStart "229" ;
        schema:pagination "229" ;
        schema:text "Poldermolens. De kleinste spinnenkopmolen in Friesland is de molen Terpzigt (bij Hegedyk 44), een houten molen met vijzel uit 1888. De laatste restauratie is in 1981 uitgevoerd. De Marsummermolen (Franjumbuorsterpaed 29) is een met riet gedekte achtkantige grondzeiler op veldmuren, voorzien van twee vijzels. De in 1903 door J.H. Westra gebouwde molen bemaalde de voormalige Marsummerpolder. Bij de molen, die in 2000 is gerestaureerd, staat een molenaarshuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01047> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Menaldum (Menaam) (gemeente Menaldumadeel)"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
