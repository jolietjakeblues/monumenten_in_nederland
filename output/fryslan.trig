        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Parrega (Parregea) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Parrega" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1266 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0143> ;
        schema:name "Parrega (Parregea) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "Terpdorp, ontstaan in de middeleeuwen. Vooral tussen 1875 en 1925 vond lintvormige uitbreiding plaats in zuidelijke richting langs de westzijde van de Workumertrekvaart (Trekweg) en in oostelijke richting langs Hortsweg naar Hieslum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01267> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Parrega (Parregea) (gemeente Wûnseradiel)"@nl ;
        min:adres "Kerkbuurt 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Parrega (Parregea) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Parrega" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31544>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33952> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39421",
            "516530" ;
        min:soort "inleiding" ;
        min:volgnummer 1267 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0143> ;
        schema:name "Parrega (Parregea) (gemeente Wûnseradiel)"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "De Herv. kerk (Kerkbuurt 3) is een eenbeukige kerk met vijfzijdig gesloten koor en ongelede forse zadeldaktoren. Kerk en toren zijn van oorsprong waarschijnlijk vroeg-gotisch 13de-eeuws. De bovenbouw van de toren is, mogelijk in de 16de eeuw, vernieuwd. Het koor van het schip is mogelijk is de 17de eeuw vernieuwd waarbij de noordgevel is ommetseld. De torenklok is in 1402 gegoten door Hermanus. Het schip heeft een 16de-eeuwse kap waarin het beschot voor het tongewelf nooit is aangebracht. Het kerkhof wordt omringd door een smeedijzeren hek (circa 1880) met funeraire symbolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01268> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Parrega (Parregea) (gemeente Wûnseradiel) – Woonhuizen"@nl ;
        min:adres "Trekweg 58",
            "Trekweg 64" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Parrega (Parregea) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Parrega" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33912> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "39422" ;
        min:soort "lemma" ;
        min:volgnummer 1268 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0143> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text """Woonhuizen. Voorbeelden van eenlaags woonhuizen zijn Trekweg 32 (circa 1910), een dwars pand met verhoogd middenrisaliet, Trekweg 56 (circa 1910), Hortsweg 41 (1915), met haaks uitgebouwd gedeelte, en Hortsweg 49 (1917) met portiek.

De voorm. dorpsherberg (Trekweg 58), thans café ‘De Harmonie’, is een tweelaags dwars pand met schilddak uit de eerste helft van de 19de eeuw. Links tegen de herberg staat de stal en achter de herberg een houten schuur met zadeldak.

De schrobplaatsen of boenstappen in de walkant van de Workumertrekvaart (bij Trekweg 64) zijn in beton uitgevoerde vlakke plateaus met trede en zitplaats, aangelegd rond 1920."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01269> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Parrega (Parregea) (gemeente Wûnseradiel) – Boerderijen"@nl ;
        min:adres "Sierdsmaweg 4",
            "Trekweg 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Súdwest-Fryslân" ;
        min:gemeenteInBoek "Wûnseradiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sudwest_Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Parrega (Parregea) (gemeente Wûnseradiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Parrega" ;
        min:lemma "Boerderijen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1269 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0143> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text """Boerderijen. De stelpboerderijen Waubert Zathe (Trekweg 1; 1906) en Trekweg 64 (1909) hebben beide een terugliggend gedeelte met melkkelder en opkamer. Ten zuiden van Parrega ligt de stelpboerderij Trekweg 152 (circa 1935) die zakelijk-expressionistische vormen vertoont.

De Herv. kerk van Hieslum (bij Sierdsmaweg 4), gelegen ten zuiden van Parrega, is een driezijdig gesloten zaalkerk voorzien van een houten geveltoren met ingesnoerde spits. De kerk werd in 1874 gebouwd naar ontwerp van T.D. de Vries. In de geveltoren hangt een door Petrus Overney gegoten klok (1673). De kerk bevat een 17de-eeuwse preekstoel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01270> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Parrega (Parregea) (gemeente Wûnseradiel) – Dedgum (Dedzjum)"@nl ;
        min:adres "Arkumerlaan 4",
            "Buren 16" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
