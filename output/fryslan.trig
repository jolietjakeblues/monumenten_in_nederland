        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0172> ;
        schema:name "'t Oersettershûs"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "'t Oersettershûs (Suderein 30) is een voormalig veerhuis in de vorm van een eenlaagspand met zadeldak tussen topgevels, gedateerd ‘1727’ en gerestaureerd in 1961."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0172.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01469> a min:Passage,
