        min:volgnummer 1333 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0155> ;
        schema:name "Rottevalle (De Rottefalle) (gemeente Smallingerland)"@nl ;
        schema:pageEnd "262" ;
        schema:pageStart "262" ;
        schema:pagination "262" ;
        schema:text "De Geref. kerk (Buorren 44) is een zaalkerk met sobere expressionistische elementen, gebouwd in 1937 naar plannen van T. van der Kooi ter vervanging van een voorganger uit 1874. De kerk is in 1950 en 1971 aan de achterzijde gewijzigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01334> a min:Passage,
