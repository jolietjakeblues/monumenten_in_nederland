        min:adres "Lage Herenweg 62",
            "Lytsebuorren 1" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marrum (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marrum" ;
        min:provincie "Fryslân" ;
        min:soort "inleiding" ;
        min:volgnummer 1030 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0107> ;
        schema:name "Marrum (gemeente Ferwerderadiel)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De Geref. kerk (Lage Herenweg 62) is een T-vormige kerk met een in een binnenhoek geplaatste ongelede toren met paraboolvormig dak. De kerk werd in 1923 gebouwd ter vervanging van een kerk uit circa 1880 (Lytsebuorren 1)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01031> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marrum (gemeente Ferwerderadiel) – Woonhuizen"@nl ;
        min:adres "Ringweg 96" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Noardeast-Fryslân" ;
        min:gemeenteInBoek "Ferwerderadiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noardeast-Fryslan> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marrum (gemeente Ferwerderadiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Marrum" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60884> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15638" ;
        min:soort "lemma" ;
        min:volgnummer 1031 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill311> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0107> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text """Woonhuizen. Het deftige blokvormige herenhuis Langebuorren 8 werd in 1832 in sobere neoclassicistische vormen gebouwd voor grietman J. Alberda. Langebuorren 7 is een deels onderkelderd huis met omlijste ingang, waarschijnlijk gebouwd rond 1840. Goede voorbeelden van eclectische middenganghuizen zijn de in 1884-'85 gebouwde huizen Lage Herenweg 10, 12 en 16-18. Opmerkelijk zijn Lage Herenweg 6 (1911) en Lage Herenweg 60 (1912). Deze witte huizen met jugendstil-vormen en een balustrade met opstaande dakstukken werden door J. Mellema ontworpen en uitgevoerd in gewapend beton, respectievelijk als eigen woning en notariswoning. Jugendstil-details hebben ook de woonhuizen Lage Herenweg 4 (circa 1910) en Langebuorren 6 (1914). Het opvallende blokvormige huis Ringweg 24 stamt uit circa 1915.

De boerderij ‘Ponga State’ (Ringweg 96) is een fraai op de dorpsterp gelegen kop-rompboerderij van midden-18de-eeuwse oorsprong. Het rompgedeelte werd in 1868 herbouwd, de naastgelegen schuur is in opzet 18de-eeuws. Bij de verbouw van de boerderij tot woningen in 1984-'85 zijn van het rompgedeelte enkel de spanten hergebruikt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01032> a min:Passage,
            schema:CreativeWork ;
