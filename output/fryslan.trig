        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/De_Fryske_Marren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harich (gemeente Gaasterlân-Sleat)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Harich" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54759> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "15923" ;
        min:soort "lemma" ;
        min:volgnummer 714 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0073> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Boerderijen. De wit geschilderde kop-rompboerderij Stinsenwei 13 heeft een deels onderkelderd woongedeelte en de jaartalankers ‘1805’. De kop-hals-rompboerderij Idske Poppes Sathe (Lorbuorren 3) heeft een melkkelder onder het voorhuis en een gevel met natuurstenen aanzetkrullen voorzien van het jaartal ‘1811’. Het voorhuis bevat betimmeringen in Lodewijk XVI-stijl. Uit de tweede helft van de 19de eeuw dateert de kop-rompboerderij Lorbuorren 4, eveneens met een melkkelder onder het voorhuis. De boerderij Welgelegen (Welgelegen 15) is in 1870 gebouwd naar ontwerp van H. Luiking. Het dwars geplaatste voorhuis met hoger opgetrokken middengedeelte en een balkon op gietijzeren zuilen vertoont neoclassisistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00715> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harich (gemeente Gaasterlân-Sleat) – Oudega (Aldegea)"@nl ;
        min:adres "Aldewei 4",
            "Aldewei 6",
            "I. Galamawei 27" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "De Fryske Marren" ;
        min:gemeenteInBoek "Gaasterlân-Sleat" ;
