        schema:name "Wergea (Warga) (gemeente Boarnsterhim)"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Het weduwenhofje (Kleine Buorren 19), gesticht in 1664 door Vrouck van Popma, is in 1864 herbouwd. Het U-vormige eenlaagspand heeft een hoger opgetrokken middenrisaliet voorzien van de wapens van de familie Popma-Jaersma."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0192.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01578> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wergea (Warga) (gemeente Boarnsterhim) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wergea (Warga) (gemeente Boarnsterhim)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Wergea" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Fryslân" ;
        min:soort "lemma" ;
        min:volgnummer 1578 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill440> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0192> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Woonhuizen. Het dorp heeft voornamelijk eenlaags woonhuizen. Een gevelsteen met het jaartal ‘1633’ siert het huis Gele Eker 2, dat bestaat uit een gedeelte met hoog zadeldak tussen topgevels met waterlijsten en een lagere, haakse aanbouw. Het ondiepe, onderkelderde huis Ald Slotwei 1 stamt uit circa 1780 en heeft een Vlaamse gevel in de vorm van een klokgevel. Tegen de rechter zijgevel bevindt zich een lagere dienstwoning en aan de achterzijde een meer recente haakse aanbouw. Uit circa 1850 dateren het huis Grote Buren 19, met verhoogd middenrisaliet, en het blokvormige huis Leeuwarderweg 61 met neoclassicistische vormen. Neorenaissance-invloeden vertonen Leeuwarderweg 4 (circa 1895), een huis met verhoogd middenrisaliet en het dwarse huis Kleine Buren 18 (circa 1905) en Leeuwarderweg 11 (circa 1910), een huis met bakstenen dakkapel. Voor de arbeiders van de zuivelfabriek kwamen in 1902 de woningen Leeuwarderweg 13-25 en 37-45 tot stand, opgezet met een hofjesachtige structuur. Bij een scheepswerf behoort het huis Nieuwe Hoek 17 uit circa 1910. De rond 1912 gebouwde huizen Leeuwarderweg 55-59 hebben chaletstijl-elementen. Nieuwe Weg 8 is een woonhuis in zakelijk-expressionistische stijl uit circa 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0192.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/01579> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wergea (Warga) (gemeente Boarnsterhim) – Boerderijen"@nl ;
        min:adres "Kerkbuurt 1",
            "Kerkbuurt 22",
            "Nieuwe Hoek 2-4",
            "Warstienserdyk 3",
            "Wartensterdyk 5",
            "Wergeasterdyk 3" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Leeuwarden" ;
        min:gemeenteInBoek "Boarnsterhim" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Leeuwarden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wergea (Warga) (gemeente Boarnsterhim)" ;
