        min:volgnummer 621 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0060> ;
        schema:name "Formerum (Formearum) (gemeente Terschelling)"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "Buurtschap op het eiland Terschelling, ontstaan op een strandwal waar zich vanaf de 17de eeuw verspreide bebouwing met boerderijen ontwikkelde. De buurtschappen Lies ten oosten en Landerum ten westen van Formerum, hebben dezelfde ontstaansgeschiedenis. Het in Formerum gelegen geboortehuis van Willem Barentsz werd in 1960 afgebroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00622> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Formerum (Formearum) (gemeente Terschelling) – Boerderijen"@nl ;
        min:adres "Formerum Zuid 3",
            "Formerum Zuid 7",
            "Lies 27" ;
        min:deel "Monumenten in Nederland. Fryslân" ;
        min:gemeente "Terschelling" ;
        min:gemeenteInBoek "Terschelling" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Terschelling_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Fryslan> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Formerum (Formearum) (gemeente Terschelling)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01> ;
        min:kern "Formerum" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16901>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54108>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57344> ;
        min:provincie "Fryslân" ;
        min:rijksmonumentnummer "35100",
            "35103",
            "35112" ;
        min:soort "lemma" ;
        min:volgnummer 622 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/afbeelding/sten009monu06ill165> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/hoofdstuk/0060> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "Boerderijen. De karakteristieke langgerekte boerderijen van Formerum, Landerum en Lies hebben een woongedeelte en een schuur met dwarsdeel. Het woongedeelte of ‘foarein’ (voorste deel) bestaat uit een voorhuis en een binnenkamer met bedsteden. Het voorhuis loopt door langs de binnenkamer. Dit doorlopende deel vormt de gang naar het schuurdeel (met grondtas). Het oudste voorbeeld, de boerderij Admir (Lies 27) uit 1662, is in 1953 ingekort en verbouwd tot zomerwoning. Het best bewaard gebleven is 't Spylske Huus (Formerum Zuid 3) uit 1759, waarvan de binnenkamer en het voorhuis een puntgevel hebben met vlechtingen en siermetselwerk. Het lange schuurdeel heeft een ‘schúntsje’ (dakvormige beeïndiging van de dwarsdeeldeuren) en daarachter een tweede grondtas. Een vergelijkbare opzet hebben Lies 42 (1721), Lies 13 (1738; verbouwd 1999) en Formerum 77 (1791). De boerderij 't Jit (Formerum Zuid 7) uit 1740 heeft twee achter elkaar geplaatste binnenkamers en een ‘laagwand’ met zijkamer (uitbreiding aan de gangzijde onder doorlopend dak). De in 1952 door G. Feenstra gerestaureerde boerderij bezit 18de-eeuwse schouwpartijen en wandtegels. Gave 19de-eeuwse voorbeelden zijn Formerum Zuid 8 (1854), 10 (1854), 13 (1859, met schuur uit 1906) en Lieser Zuidweg 4 (circa 1855). De boerderijen Formerum 73 en 81 (1882) hebben beide een ‘laagwand’. Tegen de boerderij Lies 14 uit 1887 is een huisje voor de rentenierende ouders gebouwd. Het voorhuis van Hoofdweg 23 (Landerum) kreeg in 1913 een klokgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu06_01/passage/00623> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Formerum (Formearum) (gemeente Terschelling) – Windmolen"@nl ;
