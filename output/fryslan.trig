        schema:pageEnd "76" ;
        schema:pageStart "76" ;
        schema:pagination "76" ;
        schema:text "Het voorm. postkantoor (Dubbelstraat 1) is een hoekpand met afgeronde hoek, gebouwd in 1877-'78 naar een ontwerp met neoclassicistische invloeden van J.I. Douma. Het in 1989 gerestaureerde gebouw maakt sinds 1994 deel uit van het gemeentehuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu06_01/sten009monu06_01_0020.php> .

