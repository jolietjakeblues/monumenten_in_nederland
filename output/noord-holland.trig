        min:hoofdstuk "Steden, dorpen, monumenten › Nibbixwoud (gemeente Wognum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nibbixwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1633 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill636> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0120> ;
        schema:name "Nibbixwoud (gemeente Wognum)"@nl ;
        schema:pageEnd "458" ;
        schema:pageStart "457" ;
        schema:pagination "457-458" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning. Samen met Wognum, Wadway en Hauwert kreeg het in 1414 van graaf Willem VI - louter bestuurstechnische - stadsrechten. Er vormde zich een lintbebouwing langs de Dorpsstraat. Na de Tweede Wereldoorlog is het dorp ten noorden daarvan uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01634> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nibbixwoud (gemeente Wognum)"@nl ;
        min:adres "Dorpsstraat 60" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Wognum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nibbixwoud (gemeente Wognum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nibbixwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1634 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0120> ;
        schema:name "Nibbixwoud (gemeente Wognum)"@nl ;
        schema:pageEnd "458" ;
        schema:pageStart "458" ;
        schema:pagination "458" ;
        schema:text "De voorm. Herv. kerk (bij Dorpsstraat 60), ook wel ‘Bessie’ genoemd, is een zaalkerk met houten geveltoren, die in 1834 een 14de-eeuwse tufstenen kerk verving. In 1980 heeft men de kerk verbouwd tot cultureel centrum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01635> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nibbixwoud (gemeente Wognum)"@nl ;
        min:adres "Dorpsstraat 60" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Wognum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nibbixwoud (gemeente Wognum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nibbixwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1635 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0120> ;
        schema:name "Nibbixwoud (gemeente Wognum)"@nl ;
        schema:pageEnd "458" ;
        schema:pageStart "458" ;
        schema:pagination "458" ;
        schema:text "Haaks vóór de kerk verrees in 1860 het als middenganghuis uitgevoerde eenlaagse raadhuis (Dorpsstraat 60) met sobere neoclassicistische deuromlijsting. Na de opheffing van de gemeente (1979) is dit gebouw bij het cultureel centrum gevoegd (1982)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01636> a min:Passage,
