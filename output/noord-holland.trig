        min:volgnummer 726 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0036> ;
        schema:name "Gedenktekens"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text """Gedenktekens. In een kleine vijver op het Moensplein is een fontein opgesteld ter ere van dr. J.W. Schuit († 1904). Voor J. de Wind († 1924) is een gemetselde bank geplaatst bij de Herv. kerk aan de Kerkstraat.

De Alg. begraafplaats ‘Duinrust’ (Bankenlaan 174) werd aangelegd in 1920 naar ontwerp van L.A. Springer. Bij een uitbreiding in 1965 zijn een nieuwe aula en ingang tot stand gekomen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00727> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blaricum"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Blaricum" ;
