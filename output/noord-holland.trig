        min:volgnummer 1180 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0076-01> ;
        schema:name "Heerhugowaard"@nl ;
        schema:pageEnd "358" ;
        schema:pageStart "358" ;
        schema:pagination "358" ;
        schema:text "De R.K. H. Hart van Jezuskerk (Middenweg 541) is een driebeukige basilicale kerk met een terzijde geplaatste toren voorzien van een ronde lantaarn met koepel. Deze kerk met neoromaanse elementen verrees in 1910 naar plannen van C.P.W. Dessing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01181> a min:Passage,
