        min:gemeenteInBoek "Velsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Velsen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Driehuis (gemeente Velsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Driehuis" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 906 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0057> ;
        schema:name "Driehuis (gemeente Velsen)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Het voorm. missiehuis van de missionarissen van het H. Hart van Jezus (Driehuizerkerkweg 123) kwam in 1924-'25 tot stand naar een ontwerp met expressionistische details van F.C. de Beer. Dit langgerekte gebouw met hoekpaviljoens kreeg in 1928 een haaks aangebouwde kapel. In terracotta uitgevoerde beelden van Petrus en Paulus en een reliëfvoorstelling van Christus markeren de hoofdingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00907> a min:Passage,
            schema:CreativeWork ;
