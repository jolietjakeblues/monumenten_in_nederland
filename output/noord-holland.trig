        min:gemeenteInBoek "Wervershoof" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wervershoof" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wervershoof" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72854> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38671" ;
        min:soort "inleiding" ;
        min:volgnummer 2054 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0174> ;
        schema:name "Wervershoof"@nl ;
        schema:pageEnd "521" ;
        schema:pageStart "521" ;
        schema:pagination "521" ;
        schema:text "De R.K. St.-Werenfriduskerk (Dorpsstraat 73) is een driebeukige basilicale kruiskerk met driezijdig gesloten koor en een forse toren van drie geledingen met achtzijdige lantaarn, frontalen en een naaldspits met hoektorentjes. Deze op de vroege Franse gotiek geïnspireerde neogotische kerk verrees in 1874-'75 naar ontwerp van Th. Asseler ter vervanging van een kerk uit 1805. De kerk is gerestaureerd in 1948-'49 en in 1985."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02055> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wervershoof"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Wervershoof" ;
