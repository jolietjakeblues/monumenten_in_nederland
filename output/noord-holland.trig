        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0183> ;
        schema:name "Kreileroord"@nl ;
        schema:pageEnd "530" ;
        schema:pageStart "530" ;
        schema:pagination "530" ;
        schema:text "Kreileroord. Dit ten oosten van Wieringerwerf gelegen kleine dorp zonder kerk werd in 1957 gesticht naar plannen van W. Bruin. Een dorpshuis en enkele voorm. winkels (Klaverstraat) bepalen de structuur. Rond 1960 gebouwd zijn de drieklassige openbare lagere school (Bollenstraat 54) en de voorm. woon- en winkelpanden Klaverstraat 1-3."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0183.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02122> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijdenes (gemeente Drechterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
