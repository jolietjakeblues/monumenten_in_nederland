        min:gemeenteInBoek "Enkhuizen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enkhuizen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enkhuizen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Enkhuizen" ;
        min:lemma "Bedrijfsgebouwen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1006 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill398> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0064> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "300" ;
        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Bedrijfsgebouwen. Uit 1875 dateert de bierschuur Handvastwater 2 [47], een diep pand met kleine stalvensters. Een opmerkelijk gebouwtje in pseudo-vakwerk met chaletstijl-elementen is de voorm. mineraalwaterfabriek Zuiderkerkplein 3 (1885) [48]. Chaletstijl-details vertoont ook de wit gepleisterde voorm. touwslagerij Snouckstraat 14 (circa 1900). Het gebouw van de Luxe Brood- en Koekbakkerij Algemeen Belang (Vissersdijk 36; circa 1925) [49] is ontworpen met functionalistische details. Uitgevoerd met gesloten gevels en expressionistische details is de voorm. Coöperatieve IJsfabriek West-Friesland (Vette Knol 9; circa 1930) [50]. Ten westen van de oude stad staat het forse tweelaagse kantoorgebouw Westeinde 62 (circa 1890; nu ‘Syngenta’) met een aangebouwd, wit gepleisterd bedrijfsgedeelte (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01007> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enkhuizen – Sluizen en bruggen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Enkhuizen" ;
        min:gemeenteInBoek "Enkhuizen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enkhuizen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enkhuizen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Enkhuizen" ;
        min:lemma "Sluizen en bruggen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1007 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0064> ;
        schema:name "Sluizen en bruggen"@nl ;
        schema:pageEnd "300" ;
        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Sluizen en bruggen. Het mechaniek voor de bediening van de sluisdeuren tussen de Zuiderhaven en de Buitenhaven bevindt zich in het laat-17de-eeuwse dwarse pand Zuiderspui 1 [51]. Dit gebouw heeft vijf wapenstenen (Hoorn, Oranje, Westfriesland, Enkhuizen en Medemblik). De bij de Dromedaris gelegen sluis [52] tussen Paktuinen en Eiland kwam in 1819 tot stand ter afsluiting van de oude havens. Bij de Dromedaris bevindt zich verder een houten dubbele ophaalbrug, die net als de ophaalbrug tussen Bocht en Wierdijk, is vernieuwd met behoud van de oude (17de-eeuwse) vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01008> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enkhuizen – Accijnshuizen"@nl ;
        min:adres "Havenweg 1",
            "Havenweg 3",
            "Stationsplein 1-2",
            "Stationsplein 3",
            "Tussen Twee Havens 1",
            "Tussen Twee Havens 3",
            "Wierdijk 13" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Enkhuizen" ;
        min:gemeenteInBoek "Enkhuizen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Enkhuizen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Enkhuizen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
