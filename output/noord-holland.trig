        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Pancras (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Sint Pancras" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1874 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0153> ;
        schema:name "Sint Pancras (gemeente Langedijk)"@nl ;
        schema:pageEnd "492" ;
        schema:pageStart "492" ;
        schema:pagination "492" ;
        schema:text "Het voorm. raadhuis (Kerkplein 2) is een gepleisterd eenlaagspand uit 1864, ingrijpend verbouwd rond 1955. Het heeft tot 1990 als raadhuis gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01875> a min:Passage,
