        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "505910" ;
        min:soort "inleiding" ;
        min:volgnummer 499 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0015> ;
        schema:name "Amsterdam buiten de singelgracht"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De R.K. St.-Agneskerk (Amstelveenseweg 163, Oud-Zuid) [244] is een driebeukige basilicale kruiskerk voorzien van een ranke vrijstaande toren met tentdak. Het schip van deze neoromaanse kerk werd in 1920-'21 gebouwd, het transept met koor en de toren volgden in 1931-'32. Het ontwerp van J. Stuyt is geïnspireerd op de vroeg-christelijke architectuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00500> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam buiten de singelgracht"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam buiten de singelgracht" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam buiten de singelgracht" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam buiten de singelgracht" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 500 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0015> ;
        schema:name "Amsterdam buiten de singelgracht"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "Opvallend in het wit gepleisterde interieur is de veelkleurige mozaïek-bekleding met geglazuurde tegels in de koorapsis (1942), ontworpen door J. Mammen en uitgevoerd door M. Weiss. De gebrandschilderde ramen zijn van J. Nicolas (1934) en de wandschilderingen van J. Mammen (1941-'42). Tot de inventaris behoren een door J.E. en L. Brom gemaakt hoofdaltaar met ciborium (1932), kruiswegstaties van W. Schermer (1936) en een Maria-altaar van J. Mammen (1941-'42)"@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0015.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00501> a min:Passage,
