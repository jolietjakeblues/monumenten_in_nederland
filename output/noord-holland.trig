            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill540> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0087> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "393" ;
        schema:pageStart "393" ;
        schema:pagination "393" ;
        schema:text "Woonhuizen. Gebouwd voor een opzichter van het Loodswezen is Kijkduinlaan 22 (circa 1890). Uit circa 1925 dateren het met paraboolvormig dak gedekte huis Badhuisstraat 3 en het woonhuis annex politiepost en postkantoor Badhuisstraat 5-9. De houten noodwoningen Badhuisstraat 66-100 zijn in 1948 door de Zweedse regering geschonken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0087.php> .

