        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:lemma "Pakhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1787 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Pakhuizen"@nl ;
        schema:pageEnd "480" ;
        schema:pageStart "480" ;
        schema:pagination "480" ;
        schema:text "Pakhuizen. Het diepe pand Weerwal 5 verrees in 1636 voor Claes Fredericks Beets als woonhuis annex kaaspakhuis ‘De Clock’ en kreeg in 1697 de naam ‘De Drie Duifjes’. Van 1825 tot 1910 was hier een tabakskerverij en tabaksgroothandel gevestigd. De inwendige houtconstructies dateren uit de bouwtijd. De onderpui van de hoge tuitgevel onderging wijzigingen in 1921 en 1937. Voorbeelden van latere en grotere kaaspakhuizen zijn Gedempte Singelgracht 18 (circa 1860), nu een politie- en wijkbureau, en Weerwal 8 (circa 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

