        min:volgnummer 1545 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0113> ;
        schema:name "Midwoud (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "434" ;
        schema:pageStart "434" ;
        schema:pagination "434" ;
        schema:text "Dorp, ontstaan in de hoge middeleeuwen als veenontginning. Met Twisk en Lambertschaag maakte het een bescheiden onderdeel uit van de ‘Stede Abbekerk’. De lintbebouwing heeft na de Tweede Wereldoorlog aan de noordzijde een aanzienlijke uitbreiding gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01546> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Midwoud (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Midwouder Dorpsstraat 15",
            "Midwouder Dorpsstraat 17" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Midwoud (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Midwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1546 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0113> ;
        schema:name "Midwoud (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "434" ;
        schema:pageStart "434" ;
        schema:pagination "434" ;
        schema:text "De Herv. kerk (Midwouder Dorpsstraat 15) is een moderne kerk uit 1987, gebouwd ter plaatse van een in 1984 afgebrande kerk. Van die kerk is de rijzige neoclassicistische klokkentoren van drie geledingen met houten lantaarn en ingesnoerde spits uit 1867 naar plannen van A.T. van Wijngaarden behouden. Het voorm. raadhuis (Midwouder Dorpsstraat 17) is een gepleisterd tweelaags pand met middenrisaliet en klokkentorentje, gebouwd in 1848 als raadhuis annex openbare lagere school. Bij een verbouwing rond 1865 is het gebouw verhoogd, gepleisterd en voorzien van eclectische details. Sinds 1979 wordt het particulier bewoond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01547> a min:Passage,
