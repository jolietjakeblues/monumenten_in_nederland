        schema:name "Opperdoes (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text "De Geref. kerk (Noorderpad 21), een sobere L-vormige kerk met ingang in de binnenhoek, werd in 1939 in traditionalistische vormen gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01706> a min:Passage,
