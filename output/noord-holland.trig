        schema:pageEnd "532" ;
        schema:pageStart "532" ;
        schema:pagination "532" ;
        schema:text "De pastorie (Raadhuisstraat 12) is een tweelaags middenganghuis uit 1870 in eclectische stijl (wenkbrauwen) met een serre (circa 1905)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02146> a min:Passage,
