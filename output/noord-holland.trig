        min:hoofdstuk "Steden, dorpen, monumenten › Texel (gemeente Texel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Texel" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1919 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0159> ;
        schema:name "Texel (gemeente Texel)"@nl ;
        schema:pageEnd "498" ;
        schema:pageStart "498" ;
        schema:pagination "498" ;
        schema:text "De belangrijkste nederzettingen op Texel zijn: De Cocksdorp, De Koog, Den Burg, Den Hoorn, Oostereind en Oudeschild. Zie hiervoor elders in dit boek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0159.php> .

