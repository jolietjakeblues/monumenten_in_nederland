        schema:name "Twisk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "500" ;
        schema:pageStart "500" ;
        schema:pagination "500" ;
        schema:text "De Doopsgez. vermaning (Dorpsweg 149) is een zaalkerk met dakruiter, gebouwd in 1867 met hoekpilasters en eclectische details (wenkbrauwen)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01929> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twisk (gemeente Noorder-Koggenland)"@nl ;
