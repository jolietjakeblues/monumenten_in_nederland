            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32388>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59547>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67543> ;
