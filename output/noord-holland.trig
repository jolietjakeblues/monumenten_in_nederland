        schema:pageStart "494" ;
        schema:pagination "494" ;
        schema:text "Poldermolen ‘De Slokop’ (Lagedijk 13), gelegen ten zuiden van Spaarndam aan de Mooie Nel, is een met riet gedekte achtkantige grondzeiler met bakstenen voet. Deze molen uit 1877 verzorgde de afwatering van een deel van de Verenigde Binnenpolder onder Haarlemmerliede en Spaarnwoude."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01890> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Spaarndam (gemeente Haarlem/Haarlemmerliede en Spaarnwoude) – Boerderijen"@nl ;
        min:adres "Noorderweg 17",
            "Noorderweg 18",
            "Noordzeekanaalweg 3" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Haarlemmermeer" ;
        min:gemeenteInBoek "Haarlem/Haarlemmerliede en Spaarnwoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haarlemmermeer_(gemeente)> ;
