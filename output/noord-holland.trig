        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes aan de Amstel (gemeente Amstelveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nes aan de Amstel" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1627 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0119> ;
        schema:name "Nes aan de Amstel (gemeente Amstelveen)"@nl ;
        schema:pageEnd "457" ;
        schema:pageStart "457" ;
        schema:pagination "457" ;
        schema:text "Dorp, vermoedelijk in de 12de eeuw ontstaan op een landtong aan de oostoever van de Amstel. Deze landtong werd later een eiland en slibde vervolgens vast aan de westoever. Langs de Amstel werden buitenplaatsen gesticht. Bij de kerk vormde zich een kleine dorpskern. Aan de zuidzijde daarvan is het dorp rond 1970 enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01628> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nes aan de Amstel (gemeente Amstelveen)"@nl ;
        min:adres "Amsteldijk Zuid 144" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Ouder-Amstel" ;
        min:gemeenteInBoek "Amstelveen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ouder-Amstel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nes aan de Amstel (gemeente Amstelveen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nes aan de Amstel" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1628 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill634> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0119> ;
        schema:name "Nes aan de Amstel (gemeente Amstelveen)"@nl ;
        schema:pageEnd "457" ;
        schema:pageStart "457" ;
        schema:pagination "457" ;
        schema:text "De R.K. St.-Urbanuskerk (Amsteldijk Zuid 144) is een forse driebeukige basilicale kruiskerk met driezijdig gesloten koor en een zware vieringtoren met balustrade, hoektorentjes en achtkantige spits. Deze neogotische kerk verrees in 1889-'91 naar plannen van J.Th.J. Cuypers (eerste zelfstandige werk) ter vervanging van een schuurkerk. De kerk is gerestaureerd in 1984-'85. Het interieur wordt gedekt door houten tongewelven (middenschip en transept) en stenen kruisribgewelven op zandstenen pijlers. De communiebank (1860) is afkomstig uit de schuurkerk. Tot de door atelier Cuypers in neogotische vormen uitgevoerde inventaris behoren een hoofdaltaar (1894), preekstoel (1904), doopvont en de als tegeltableaus uitgevoerde kruiswegstaties (1905). Het orgel is gebouwd door P.J. Adema (1893)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0119.php> .

