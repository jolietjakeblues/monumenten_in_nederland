        min:kern "Sint Maarten" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1860 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0151> ;
        schema:name "Sint Maarten (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "490" ;
        schema:pageStart "490" ;
        schema:pagination "490" ;
        schema:text "Dorp, ontstaan in de 13de eeuw bij de toen opgeworpen Westfriese Zeedijk. Van 1478 tot de opheffing van de gemeente in 1990 vormden Sint Maarten, Eenigenburg en Valkkoog één rechtsgebied: de Valkkogerkogge. Ter plaatse van een kerk uit 1462 (verwoest 1799) werd in 1875 een nieuwe kerk gebouwd (gesloopt 1960)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0151.php> .

