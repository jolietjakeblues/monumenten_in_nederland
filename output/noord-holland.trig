        min:volgnummer 1863 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0151> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "Poldermolen ‘De Groenvelder’ (Groenveldsdijk 12), gelegen ten zuidoosten van Sint Maarten, is een midden-16de-eeuwse met riet gedekte achtkantige binnenkruier op een met hout beklede voet die de polder Valkkoog bemaalde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01864> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Maarten (gemeente Harenkarspel) – Valkkoog"@nl ;
        min:adres "Valkkogerweg 37",
            "Valkkogerweg 38",
            "Valkkogerweg 39" ;
