        min:gemeente "Haarlemmermeer" ;
        min:gemeenteInBoek "Haarlem/Haarlemmerliede en Spaarnwoude" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haarlemmermeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Spaarndam (gemeente Haarlem/Haarlemmerliede en Spaarnwoude)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Spaarndam" ;
