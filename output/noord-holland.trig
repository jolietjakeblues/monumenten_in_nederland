        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0035> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Woonhuizen. De rentenierswoning Troostwijk (Westeinde 314; circa 1880), een middenganghuis, heeft een hoger opgetrokken middenrisaliet met driehoekig fronton. Vergelijkbaar in hoofdvorm is het middenganghuis Kerkebuurt 188 (circa 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00711> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berkhout (gemeente Wester-Koggenland) – Boerderijen"@nl ;
        min:adres "Oosteinde 107",
            "Oosteinde 86" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Koggenland" ;
        min:gemeenteInBoek "Wester-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Koggenland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berkhout (gemeente Wester-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Berkhout" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37279> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "502486" ;
        min:soort "lemma" ;
        min:volgnummer 711 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0035> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Boerderijen. De Annahoeve (Oosteinde 107) heeft een dwars geplaatst eclectisch voorhuis met erker uit circa 1875 voor een mogelijk oudere stolpschuur. De stolpboerderij Westeinde 312 is voorzien van een dakerker, een spiegel en een versierde schoorsteen gedateerd ‘1877’. Uitgevoerd met een middenerker en daarboven een dakerker met sierspant is de stolpboerderij Westeinde 276 uit 1910. De Ridderhoeve (Oosteinde 86) is een moderne boerderij uit 1926 met een villa-achtig woongedeelte naast het hooihuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00712> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beverwijk"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Beverwijk" ;
        min:gemeenteInBoek "Beverwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beverwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beverwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Beverwijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 712 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0036> ;
        schema:name "Beverwijk"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Dorp, ontstaan op een strandwal en voor het eerst vermeld in 1063 (vanaf 1276 onder de huidige naam). Het aan een belangrijke noord-zuidroute nabij het Wijkermeer gelegen dorp kreeg in 1298 stadsrechten van graaf Jan I (opnieuw verleend 1346). Dit leidde echter niet tot een stedelijke ontwikkeling. Beverwijk vervulde wel een regionale marktfunctie. Nadat de Spaanse troepen in 1576 waren weggetrokken, stonden nog maar weinig huizen overeind. In de 17de eeuw beleefde Beverwijk dankzij de tuinbouw een economische bloeiperiode en verrezen er diverse buitenhuizen in de omgeving. Na achteruitgang in de 18de eeuw volgde nieuwe bloei door de aanleg van het Noordzee Kanaal (1865-'76) en de spoorlijn Haarlem-Uitgeest (1867)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00713> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beverwijk"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Beverwijk" ;
        min:gemeenteInBoek "Beverwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beverwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beverwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Beverwijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 713 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0036> ;
        schema:name "Beverwijk"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Door de vestiging van de Hoogovens in Velsen (1918) raakte Beverwijk meer en meer bij deze industrie betrokken. Begin 20ste eeuw breidde het zich naar het zuidwesten uit en in 1936 werd de gemeente Wijk aan Zee en Duin geannexeerd. De uitbreiding kreeg een tuinwijkachtige vorm met gebogen straten en veel openbaar groen. Na de Tweede Wereldoorlog is Beverwijk aan noord- en oostzijde uitgebreid, vooral voor werknemers van de Hoogovens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00714> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beverwijk"@nl ;
        min:adres "Kerkstraat 37a" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Beverwijk" ;
        min:gemeenteInBoek "Beverwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beverwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
