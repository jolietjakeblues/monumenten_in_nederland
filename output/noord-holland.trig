        min:gemeenteInBoek "Wormerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wormerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wormer (gemeente Wormerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wormer" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2152 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0188> ;
        schema:name "Wormer (gemeente Wormerland)"@nl ;
        schema:pageEnd "533" ;
        schema:pageStart "533" ;
        schema:pagination "533" ;
        schema:text "De Herv. kerk (bij Kerkstraat 4) is een deels gepleisterde zaalkerk met gietijzeren rondboogvensters en een houten klokkentoren, gebouwd in 1807 ter vervanging van een gotische kerk. Aan de noordzijde staat een in neorenaissancestijl uitgevoerde consistoriekamer (circa 1880). Het interieur met zerkenvloer bevat een inventaris met preekstoel, doophek, kerkbanken en twee herenbanken uit het derde kwart van de 17de eeuw. Verder zijn er een scheepsmodel (begin 18de eeuw) en een door P. Flaes gebouwd orgel (1865)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02153> a min:Passage,
