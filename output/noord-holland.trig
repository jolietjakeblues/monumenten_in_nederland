        min:gemeenteInBoek "Hoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hoorn" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1286 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill523> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0086> ;
        schema:name "Hoorn"@nl ;
        schema:pageEnd "383" ;
        schema:pageStart "383" ;
        schema:pagination "383" ;
        schema:text "De voorm. (Herv.) Grote Kerk (Kerkplein 33) [4] is een kruiskerk met dienstruimten in de oostelijke arm, en met een toren van twee geledingen met achtkantige lantaarn en ingesnoerde naaldspits. Deze neorenaissance-kerk verrees in 1881-'83 naar plannen van C. Muysken, nadat de oude neoclassicistische kerk (1844) in 1878 was afgebrand. Die kerk was al een vervanger voor de middeleeuwse kerk (gewijd aan Cyriacus) die in 1838 vlam vatte. Voor de nieuwe toren gebruikte Muysken de romp van de toren uit 1844. De door hem ontworpen torenspits heeft men in 1938-'39 vereenvoudigd herbouwd en in 1950 is hierin een nieuw carillon gehangen (firma Van Bergen). De kerk is in 1968 buiten gebruik gesteld en daarna in 1985-'86 verbouwd tot winkels en appartementen. In de winkel op de verdieping is het houten tongewelf nog goed zichtbaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0086.php> .

