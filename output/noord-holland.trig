        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Barsingerhorn (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Barsingerhorn" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 657 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0029-01> ;
        schema:name "Barsingerhorn (gemeente Niedorp)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "Dorp, ontstaan in de 12de eeuw langs de zeedijk (Heerenweg). In 1415 kregen de banne Barsingerhorn en de banne Haringhuizen samen stadsrechten, maar deze waren louter bestuurstechnisch van aard. De tram van Schagen naar Wognum (1898 tot 1935) had hier een aftakking naar de Van Ewijcksluis (vanaf 1912). Het bescheiden lintdorp is een provinciaal beschermd gezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00658> a min:Passage,
            schema:CreativeWork ;
