        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "De voorm. openbare lagere school (Dorpsstraat 60) is een deels gepleisterd tweeklassig schoolgebouw met zijgang en onderwijzerswoning, gebouwd in 1876 naar ontwerp van T.C. van der Sterr."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01015> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Graft (gemeente Graft-De Rijp) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 58" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
