        min:gemeente "Wormerland" ;
        min:gemeenteInBoek "Wormerland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wormerland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Jisp (gemeente Wormerland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Jisp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18319> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "22943" ;
        min:soort "inleiding" ;
        min:volgnummer 1353 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0091> ;
        schema:name "Jisp (gemeente Wormerland)"@nl ;
        schema:pageEnd "402" ;
        schema:pageStart "402" ;
        schema:pagination "402" ;
        schema:text "De Herv. kerk (Dorpsstraat 46) is een sobere zaalkerk met houten geveltoren, gebouwd in 1822 naar plannen van A. Latenstein ter plaatse van een oorspronkelijk 15de-eeuwse kerk. Deze kerk met zerkenvloer heeft een 17de-eeuwse inventaris met preekstoel, doophek (1667), doopbanken, gesneden lezenaar en drie herenbanken. De samen met het raadhuis op een omgracht terrein gelegen kerk is toegankelijk via een brug met smeedijzeren brughek (1867)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01354> a min:Passage,
