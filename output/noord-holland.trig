        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overveen (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Overveen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1755 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0139> ;
        schema:name "Overveen (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "Dorp, ontstaan in het binnenduingebied van de Kennemerduinen nabij de kruising van de Bloemendaalseweg en de Zijlweg. Dit overwegend met buitenplaatsen ingerichte gebied kreeg in 1881 een station aan de spoorlijn Haarlem-Zandvoort, waarna zich een bescheiden dorpskern vormde. Rond 1900 werd aan de westzijde een waterleidingcomplex ingericht en bij het station ontstond een villapark. De gemeente Haarlem heeft in 1927 een deel van het grondgebied geannexeerd. Na de Tweede Wereldoorlog is Overveen als forensendorp vastgegroeid aan Haarlem."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01756> a min:Passage,
