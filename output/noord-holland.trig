        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Het voorm. raadhuis (Rijksstraatweg 43) werd in 1894 gebouwd in de vorm van een villa in neorenaissance-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0031.php> .

