        schema:pageEnd "490" ;
        schema:pageStart "490" ;
        schema:pagination "490" ;
        schema:text "Het voorm. raadhuis (Westerstraat 95) is een tweelaags pand met middenrisaliet, balkon en neoclassicistische details, dat rond 1860 een ‘stedehuis’ uit 1731 verving."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0150.php> .

