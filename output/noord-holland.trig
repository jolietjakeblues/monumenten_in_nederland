        schema:name "Ursem (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "504" ;
        schema:pageStart "504" ;
        schema:pagination "504" ;
        schema:text "De pastorie (Kerkpad 1; 1859, H. Linse) heeft een hoger opgetrokken middenrisaliet en een met Oegstgeester pannen belegd dak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01955> a min:Passage,
