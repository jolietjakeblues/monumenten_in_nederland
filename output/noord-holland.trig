        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "De voorm. openbare leeszaal (Torenlaan 19a) is een langgerekt eenlaagspand uit 1928, ontworpen in expressionistische stijl door W. Hamdorff. Sinds 1983 heeft het een kantoorfunctie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

