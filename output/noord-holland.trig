        min:gemeenteInBoek "Laren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Laren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Laren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Laren" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1455 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. klooster van St. Johannes de Doper (Eemnesserweg 19) van de broeders van St. Louis van de congregatie van Oudenbosch werd gebouwd in 1913 in ‘Um 1800’-stijl. Sinds 1966 is in het complex het raadhuis gevestigd. De aanbouw verrees in 1983."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01456> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
