        schema:text "Het interieur wordt gedekt door een houten lichtkap en heeft galerijen op gietijzeren zuilen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00421> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam"@nl ;
