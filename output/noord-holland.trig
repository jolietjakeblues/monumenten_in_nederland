        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wijdemeren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › 's-Graveland (gemeente Wijdemeren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "'s-Graveland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47826>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62155> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "17358",
            "17359" ;
        min:soort "inleiding" ;
        min:volgnummer 1019 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0066> ;
        schema:name "'s-Graveland (gemeente Wijdemeren)"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "De Herv. kerk (Noordereinde 14), een sobere classicistische kerk in de vorm van een Grieks kruis, kwam in 1657-'58 tot stand naar ontwerp van Daniël Stalpaert. In de dakruiter hangt een door François en Pieter Hemony gegoten klok (1655). Het ingangsportaal aan de voorkant is voorzien van blindnissen en een fronton. De gevels hebben rondboogvensters en - aan de onderzijde uitzwenkende - hoekpilasters. De kerk bevat een door J. en J.H.H. Bätz gebouwd orgel (1824). De pastorie (Noordereinde 12) is een tweebeukig tweelaags dwars huis uit circa 1775."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01020> a min:Passage,
