            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42658> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "14595",
            "14600" ;
        min:soort "inleiding" ;
        min:volgnummer 947 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0061> ;
        schema:name "Egmond aan den Hoef (gemeente Bergen)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "De Herv. kerk (Slotweg 19) is een eenbeukige kerk met een vijfzijdig gesloten koor, enkele kapellen en een houten vieringtoren. Deze kerk, die als slotkapel diende, verrees vermoedelijk in 1430 ter plaatse van een afgebrande 13de-eeuwse kapel en werd in 1480 vergroot. Na de verwoesting in 1574 volgde herbouw in 1633-'34 met gebruik van het oude koor. De zijkapellen bevatten dienstruimten en in de vieringtoren hangt een door Jan Verbruggen gegoten klok (1750). De kerk is gerestaureerd in 1912-'13 (P.N. Leguit) en in 1966."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00948> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Egmond aan den Hoef (gemeente Bergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
