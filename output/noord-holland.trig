        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1797 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "Woonhuizen. De oudere huizen in Ransdorp zijn overwegend diepe eenlaagspanden met (later vernieuwde) puntvormige houten voorschotten voorzien van windveren en in de top een afweerteken. Het tweebeukige huis Dorpsweg 64 heeft mogelijk nog een 18de-eeuwse constructie, de andere huizen zijn 19de-eeuws, zoals Dorpsweg 45-47, 56-58, 76, 117-119 en het dwarse huis Dorpsweg 23."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01798> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam) – Boerderijen"@nl ;
        min:adres "Dorpsweg 111" ;
