        min:hoofdstuk "Steden, dorpen, monumenten › Monnickendam (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Monnickendam" ;
        min:lemma "Bedrijfsgebouwen" ;
