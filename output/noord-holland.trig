        min:volgnummer 1504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0108> ;
        schema:name "Markenbinnen (gemeente Graft-De Rijp)"@nl ;
        schema:pageEnd "423" ;
        schema:pageStart "423" ;
        schema:pagination "423" ;
        schema:text "Dorp ontstaan in de late middeleeuwen als veenontginning vanuit Uitgeest in een omdijkte polder, de Marker- en Oostwouderpolder, in de Starnmeer. Rond 1644 werd de Markervaart, de westelijke ringvaart van de kort daarop drooggelegde Starnmeer gegraven, waardoor de Markerpolder van de Oostwouderpolder gescheiden raakten. Markenbinnen kwam aan de oostzijde van deze ringvaart te liggen, in de zuidpunt van de Starnmeerpolder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0108.php> .

