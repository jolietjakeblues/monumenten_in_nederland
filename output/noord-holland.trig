        schema:name "Driehuizen (gemeente Schermer)"@nl ;
        schema:pageEnd "273" ;
        schema:pageStart "273" ;
        schema:pagination "273" ;
        schema:text "Dorp op het Schermereiland, volgens overlevering genoemd naar de drie huizen die hier in 1603 tegen de dijk werden gebouwd. Na de droogmaking van de Schermer (1635) kreeg Driehuizen een verbindingsweg met Zuidschermer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0058.php> .

