        min:soort "lemma" ;
        min:volgnummer 1377 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0094> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "405" ;
        schema:pageStart "405" ;
        schema:pagination "405" ;
        schema:text """Horeca. Volgens een opschrift gaat café De Roode Leeuw (Westfriesedijk 72) terug tot 1620, maar in de huidige vorm is het een dwars dijkhuis uit de tweede helft van de 19de eeuw met middengang en brede houten dakerker (gerestaureerd 1989). Café Schippers Welvaren (Nieuwe Streek 64) is een tweelaags dwars pand uit circa 1860.

De turfschuren tegen de Westfriesedijk (bij nr. 66) zijn zwart geteerde houten schuren uit de 19de eeuw voor de opslag van turf afkomstig uit Overijssel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01378> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kolhorn (gemeente Niedorp) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kolhorn (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Kolhorn" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1378 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0094> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "405" ;
        schema:pageStart "405" ;
        schema:pagination "405" ;
        schema:text "Boerderijen. De fraaie stolpboerderij Westfriesedijk 166 (circa 1840) heeft een symmetrische ingedeelde voorgevel met houten halsgevel en twee omlijste voordeuren. In 1860 gebouwd is de stolpboerderij Kreil 30 met spiegel en versierde schoorsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01379> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kolhorn (gemeente Niedorp) – Gemalen"@nl ;
        min:adres "Hemmerweg 5",
            "Westfriesdijk 68",
            "Westfriesedijk 18a" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kolhorn (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Kolhorn" ;
        min:lemma "Gemalen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1379 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0094> ;
        schema:name "Gemalen"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "405" ;
        schema:pagination "405-406" ;
        schema:text "Gemalen. Van het voorm. gemaal Molenkade 31 ten zuiden van Kolhorn resteert slechts het machinehuis (circa 1900). Uit 1908 dateert het voorm. gemaal Kaag (Hemmerweg 5) ten westen van Kolhorn. Het gemaal Schagerkogge (Westfriesdijk 68) werd in 1927 gebouwd met bovengelegen dienstwoning. Dit gemaal heeft twee horizontale elektrische schroefpompen (firma Pannevis). In het kanaal Alkmaar-Kolhorn ligt het moderne gemaal De Waakzaamheid (Westfriesedijk 18a; circa 1960) met schutsluis (Braaksluis)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01380> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1380 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "Dorp, ontstaan begin 16de eeuw toen inwoners uit Westzaan zich op de westoever van de Zaan vestigden. Langs de Lagedijk (Raadhuisstraat e.v.) vormde zich een tweezijdige lintbebouwing. Vanaf circa 1870 vestigden zich diverse fabrieken en bedrijven in het buitendijkse gebied langs de Zaan en werd Koog aan de Zaan een industriedorp. Haaks op de dijk lagen enkele dwarspaden die landinwaarts naar industriemolens leidden. Omstreeks 1870 werd de Stationsstraat aangelegd naar het station (1867). Sindsdien is het gebied tussen de Zaan en spoorlijn Amsterdam-Alkmaar volgebouwd. Na de Tweede Wereldoorlog volgden uitbreidingen ten westen daarvan (Westerkoog)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:adres "Zuiderkerkstraat 14" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "De Herv. kerk (Zuiderkerkstraat 14) is een kruiskerk, die is ontstaan uit een in 1685 naar ontwerp van Jacob Reijersz (stichtingssteen) gebouwde zaalkerk met (aan de onderzijde uitzwenkende) steunberen, ingangsportaal (westzijde) en consistorie (oostzijde). Naar plannen van A. Latenstein kreeg deze kerk in 1824-'25 dwarsarmen, spitsboogvensters en een vieringtoren met uurwerk. Na een brand in 1920, waarbij de vieringtoren verloren ging, heeft men de kerk hersteld in 1920-'22 (J. de Meijer)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01382> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1382 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill559> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven met trekbalken (hersteld 1922) en is voorzien van galerijen (1825). Tot de inventaris behoren 17de-eeuwse kerkbanken, een preekstoel (1686), een scheepsmodel (circa 1685), een doophek (1826) en drie herenbanken (circa 1826). Afkomstig uit de R.K. St.-Antonius van Paduakerk te Haarlem is het door M. van den Brink gebouwde orgel (1853; overgebracht 1913, hersteld 1922)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01383> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:adres "Zuiderkerkstraat 12" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
