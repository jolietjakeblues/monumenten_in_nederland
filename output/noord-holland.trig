        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. dominicanessenklooster (Brink 29) is een tweelaags neogotisch pand uit 1881 met middenrisaliet en trapgevel. Haaks aan de achterzijde bevindt zich een kapel. Sinds circa 1968 doet het gebouw dienst als cultureel centrum. Vergelijkbaar van opzet en stijl is de bijbehorende voorm. R.K. lagere meisjesschool (Brink 27) uit circa 1881, die in 1911 is uitgebreid met een kleuterschool (G. van Bronkhorst)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01455> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
        min:adres "Eemnesserweg 19" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
