            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61787> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "33086",
            "33090" ;
        min:soort "lemma" ;
        min:volgnummer 1057 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0069> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Poldermolens. In de omgeving van Grootschermer staan twee met riet gedekte achtkantige grondzeilers, te weten De Havik (Haviksdijkje 10; 1576, verplaatst 1861) aan de noordzijde van de Eilandspolder en de Menningweermolen (Menningweerdijk 2; 1888) in de Menningweerpolder ten westen van Grootschermer. De laatstgenoemde molen was tot 1931 in gebruik en werd in 1988 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01058> a min:Passage,
