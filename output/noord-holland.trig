        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Venhuizen (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Venhuizen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1978 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0166> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "508" ;
        schema:pageStart "508" ;
        schema:pagination "508" ;
        schema:text "Woonhuizen. Uit circa 1800 dateert het dwarse houten huis Kerkeveld 3 met ingangsomlijsting. Midden-19de-eeuws is het oorspronkelijk dubbele houten huis Westerkerkweg 9. De burgemeesterswoning De Buurt 82 (circa 1885) is een middenganghuis met hoger opgetrokken middengedeelte en zinken dakkapellen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01979> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venhuizen (gemeente Drechterland) – Boerderijen"@nl ;
        min:adres "De Buurt 11" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Venhuizen (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Venhuizen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46599> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "508444" ;
        min:soort "lemma" ;
        min:volgnummer 1979 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0166> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "508" ;
        schema:pageStart "508" ;
        schema:pagination "508" ;
        schema:text """Boerderijen. De in 1773 gebouwde stolpboerderij De Buurt 1 heeft een asymmetrisch geplaatst houten voorschot, een pronkdeur met snijlicht en een schoorsteen met siermetselwerk. De 19de-eeuwse boerderij Zuiderdijk 14 bestaat uit een hooihuis en een ver uitgebouwd houten woongedeelte. Uit circa 1870 dateren de stolpboerderijen Swanenplaats (De Buurt 11) en De Buurt 62, beide met middenrisaliet en gesneden windveren. De in 1905 gebouwde stolpboerderij Westeinde 11-13 heeft een staartstuk, een spiegel en fraai gesneden windveren.

De overhaal bij Westerbuurt 34 bestaat uit twee aan weerszijden van de weg geplaatste houten windassen met bijbehorend bakstenen straatje en planken glijvloeren die uitkomen in de evenwijdig met de weg lopende sloten. Deze in zijn huidige vorm vroeg-20ste-eeuwse overhaal is gebruikt tot circa 1960."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0166.php> .

