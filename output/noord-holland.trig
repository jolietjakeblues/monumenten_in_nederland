            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56159> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "46532",
            "46533",
            "46535",
            "46538",
            "46539",
            "46540",
            "46541",
