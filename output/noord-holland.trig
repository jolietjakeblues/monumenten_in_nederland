        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Nieuwendam (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Nieuwendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51694> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "508536" ;
        min:soort "inleiding" ;
        min:volgnummer 576 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill258> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0019> ;
        schema:name "Amsterdam-Nieuwendam (gemeente Amsterdam)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "210" ;
        schema:pagination "210-211" ;
        schema:text "De Herv. kerk (Brede Kerkepad 8) is een zaalkerk voorzien van een toren van twee geledingen met een iets smallere bovenbouw met naaldspits. Deze sobere neoclassicistische kerk met rondbogen in rode en gele baksteen kwam in 1847 tot stand naar plannen van G. Bronke en L.J. Immink ter plaatse van een oudere kerk. In de toren hangt een door Henricus Westrinck gegoten klok (1644)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00577> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Nieuwendam (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Nieuwendam (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Nieuwendam" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 577 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0019> ;
        schema:name "Amsterdam-Nieuwendam (gemeente Amsterdam)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Het inteieur wordt gedekt door een houtconstructie verwant aan de Engelse ‘Hammerbeam’-kappen. De 18de-eeuwse grafzerken komen uit de oude kerk. Verder bevat de kerk een 17de-eeuwse preekstoel en een door J. Hoffmeijer gebouwd orgel (1849, gerestaureerd 1980)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00578> a min:Passage,
