        min:kern "Zaandam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66513> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "518043" ;
        min:soort "inleiding" ;
        min:volgnummer 2189 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0190> ;
        schema:name "Zaandam (gemeente Zaanstad)"@nl ;
        schema:pageEnd "541" ;
        schema:pageStart "541" ;
        schema:pagination "541" ;
        schema:text "De R.K. St.-Bonifatiuskerk (Oostzijde 14) [8] is een driebeukige basilicale kruiskerk met hoofdkoor (vijfzijdig gesloten), zuiderzijkoor (driezijdig gesloten) en een door een U-vorm omsloten noorderzijkoor. Deze neogotische kerk verrees in 1898-1900 naar plannen van A.A.J. Margry en J.M. Snickers ter vervanging van een kerk uit 1785. De door veelhoekige traptorens met spitsen geflankeerde westpartij heeft in het midden een forse klokkentoren met hoge naaldspits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02190> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zaandam (gemeente Zaanstad)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
