        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill319> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0043> ;
        schema:name "Burgerbrug (gemeente Zijpe)"@nl ;
        schema:pageEnd "249" ;
        schema:pageStart "249" ;
        schema:pagination "249" ;
        schema:text "De R.K. O.L. Vrouwe Geboortekerk (Grote Sloot 114) is een driezijdig gesloten zaalkerk met een half-ingebouwde geveltoren voorzien van lantaarngeleding en ingesnoerde spits. Deze kerk met neoromaanse elementen verrees in 1866 naar ontwerp van Th. Molkenboer en verving een in 1864 afgebrande schuilkerk. Het orgel met tribune stamt uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0043.php> .

