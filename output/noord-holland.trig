        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. postkantoor (Schoutenbosje 5) is een gebouw in zakelijke vormen, opgetrokken in 1936-'37 naar plannen van J.G. Robbers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01463> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren – Scholen"@nl ;
        min:adres "De Leemkuil 4",
            "Eemnesserweg 17",
            "Kerklaan 29",
            "Oud Blaricummerweg 21a" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Laren" ;
        min:gemeenteInBoek "Laren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Laren_(gemeente)> ;
