        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Abbekerk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Abbekerk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 265 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0008> ;
        schema:name "Abbekerk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning. De kerk wordt in 1395 voor het eerst vermeld. Abbekerk werd het centrum van het plattelandsgebied dat als ‘Stede Abbekerk’ (Abbekerk, Twisk, Midwoud en Lambertschaag) in 1414 - louter bestuurstechnische - stadsrechten kreeg. Het lintdorp is na de Tweede Wereldoorlog ter hoogte van de kerk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00266> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Abbekerk (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Dorpsstraat 42" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Abbekerk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Abbekerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14008>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16215> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30655",
            "30656" ;
        min:soort "inleiding" ;
        min:volgnummer 266 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0008> ;
        schema:name "Abbekerk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De Herv. kerk (Dorpsstraat 42) is een eenbeukige kerk met een vijfzijdig gesloten koor en een toren van drie geledingen met balustrade en achtzijdige bakstenen spits. Het schip werd rond 1500 uit hergebruikt materiaal opgetrokken en vermoedelijk na schade in 1517 verhoogd. Uit het tweede kwart van de 16de eeuw dateert het koor. De toren verrees in 1656 (gevelsteen) en bevat een door Claude Fremy gegoten klok (1684). De bakstenen spits heeft men in 1859 vernieuwd. Bij een restauratie in 1949-'52 (D. Fledderus) is de toren ontpleisterd en de kerk opnieuw bepleisterd. Het interieur wordt gedekt door een houten tongewelf - vernieuwd in 1698 en 1756 (koor) - met trekbalken op omtimmerde korbeelstellen. Tot de inventaris behoren een herenbank (1728) en een door H. Knipscheer gebouwd orgel (1865). Tegen de buitenmuur hangt een door Van Emden gemaakte barometer (1878)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00267> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Abbekerk (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Dorpsstraat 40" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Abbekerk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Abbekerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59668> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "510896" ;
        min:soort "inleiding" ;
        min:volgnummer 267 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0008> ;
        schema:name "Abbekerk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Rond 1880 verrees op het kerkhof een neoclassicistische consistoriekamer met zondagsschool (Dorpsstraat 40). Op het kerkhof staat onder meer een stèle met gebroken fronton voor burgemeester J. Zijp († 1897)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00268> a min:Passage,
