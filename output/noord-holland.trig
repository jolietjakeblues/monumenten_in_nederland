        schema:name "Boerderijen"@nl ;
        schema:pageEnd "414" ;
        schema:pageStart "414" ;
        schema:pagination "414" ;
        schema:text "Boerderijen. Interessante stolpboerderijen uit de tweede helft van de 19de eeuw zijn De Klaverhof (Noordeinde 145) en Zuideinde 21 met aangebouwd hooihuis, en de keuterboerderijen Zuideinde 26 en Noordeinde 125."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01445> a min:Passage,
