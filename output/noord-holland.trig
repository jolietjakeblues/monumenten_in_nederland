        rdfs:label "De Kwakel (gemeente Uithoorn) – Boerderijen"@nl ;
        min:adres "Boterdijk 77",
            "Boterdijk 91",
            "Drechtdijk 49",
            "Drechtdijk 89-91" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Uithoorn" ;
        min:gemeenteInBoek "Uithoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Uithoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
