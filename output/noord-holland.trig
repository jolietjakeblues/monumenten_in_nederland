        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "De Herv. kerk (Hoofdweg-Oostzijde 1764) is een sobere neoclassicistische zaalkerk uit 1868 met houten geveltoren en aangebouwde consistoriekamer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0009.php> .

