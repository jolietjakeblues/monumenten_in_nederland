        min:adres "De Ruyterstraat 128",
            "De Ruyterstraat 129" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Texel" ;
        min:gemeenteInBoek "Texel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Texel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudeschild (gemeente Texel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudeschild" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1737 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0136> ;
        schema:name "Oudeschild (gemeente Texel)"@nl ;
        schema:pageEnd "470" ;
        schema:pageStart "470" ;
        schema:pagination "470" ;
        schema:text "De R.K. St.-Martinuskerk (De Ruyterstraat 129) is een eenbeukige kerk met driezijdig gesloten koor, dakruiter en een toren van drie geledingen. Het gepleisterde schipgedeelte stamt uit 1835. In 1894 werd het koor uitgebreid naar plannen van J.H. Tonnaer en in 1904 kreeg het schip een extra westtravee met ingebouwde toren naar ontwerp van C.L.M. Robbers. De in 1935 en in 1958 gerestaureerde kerk bevat een orgel uit 1912 en een hoofdaltaar met communiebank (1929, P. Cuypers jr.). De forse pastorie (De Ruyterstraat 128) dateert van 1890."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01738> a min:Passage,
            schema:CreativeWork ;
