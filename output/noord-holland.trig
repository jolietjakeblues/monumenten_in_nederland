        schema:name "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning. Samen met het aansluitende Sijbekarspel kreeg het in 1414 als de ‘Stede Sijbekarspel’ - louter bestuurstechnische - stadsrechten. De bebouwing van het lintdorp is later enigszins verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00677> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Kerkelaan 10" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Benningbroek (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Benningbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18708>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45045> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30680",
            "30681" ;
        min:soort "inleiding" ;
        min:volgnummer 677 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0032> ;
        schema:name "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De Herv. kerk (Kerkelaan 10), oorspronkelijk gewijd aan St. Petrus Banden, is een gepleisterde eenbeukige kerk voorzien van een forse houten dakruiter met ingesnoerde spits aan de westzijde. Deze 16de-eeuwse kerk kreeg mogelijk in de 17de eeuw aan de westzijde een beklamping. Het koor heeft men vermoedelijk eind 18de eeuw gesloopt. Uit die tijd dateert de dakruiter (bekleding vernieuwd 19de eeuw) met daarin een door Geert van Wou gegoten klok (1525). Aan de oostzijde staat een consistoriekamer (circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00678> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Benningbroek (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Benningbroek" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 678 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0032> ;
        schema:name "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf, dat in de sluitstukken is gedateerd ‘1505’ en ‘1548’. Tot de inventaris behoren een preekstoel (1661), een voorzangerslessenaar (1661), een koperen predikantslessenaar (1724) en een door L. van Dam & Zn. gebouwd orgel (1908)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00679> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
