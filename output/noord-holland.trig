        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26845>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54138> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "39923",
            "518067" ;
