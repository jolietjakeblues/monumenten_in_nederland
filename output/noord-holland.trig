        min:kern "Driehuis" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 904 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0057> ;
        schema:name "Driehuis (gemeente Velsen)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Dorp, ontstaan in de 19de eeuw bij een kruising van wegen. Tussen 1915 en 1940 groeide het dorp sterk. Met de aanleg van de Velser(spoor)tunnel heeft men de spoorlijn Haarlem-Alkmaar in 1957 verlegd en kreeg Driehuis een station. Na de Tweede Wereldoorlog is Driehuis een ruim opgezet forensendorp geworden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0057.php> .

