        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. sanatorium ‘Julianaoord’ (Leemzeulder 35), nu een neurologisch-orthopedische kliniek, is een complex van vier eenlaagspanden in expressionistische stijl. Na de bouw van het hoofdgebouw (1920-'25) volgden de paviljoens ‘Lieberg’ (1930), ‘Aalberg’ (1934) en ‘Braamberg’ (1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01458> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
        min:adres "Eemnesserweg 1" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Laren" ;
        min:gemeenteInBoek "Laren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Laren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Laren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Laren" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1458 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. raadhuis (Eemnesserweg 1) kwam in 1888 tot stand als raadhuis annex veldwachterwoning naar een neorenaissance-ontwerp van J.C. Jurriëns. Dit dwarse pand met souterrain en beletage heeft een dubbele gebogen bordestrap en een middenrisaliet met omlijste ingang, trapgevel en luidklok. Het rond 1993 gerestaureerde gebouw heeft tot 1966 als raadhuis gediend en herbergt nu een restaurant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01459> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
        min:adres "Driftlaan 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
