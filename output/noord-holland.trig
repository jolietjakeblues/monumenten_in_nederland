        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "508" ;
        schema:pageStart "508" ;
        schema:pagination "508" ;
        schema:text "Raadhuizen. Het voorm. raadhuis Westeinde 3 is een tweelaags pand met een dakkapel geflankeerd door classicistische klauwstukken en schilddragende leeuwen. Het werd in 1662 (cartouche) gebouwd als koggehuis, met binnen een waag en cachot. Er volgden verbouwingen in de 18de eeuw (mogelijk 1764) en de 19de eeuw. Het voorm. raadhuis Kerkweg 68 is een eenlaagspand uit 1868 (gevelsteen), verbouwd rond 1955."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01978> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Venhuizen (gemeente Drechterland) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
