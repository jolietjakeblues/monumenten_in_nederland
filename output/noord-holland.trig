        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0175> ;
        schema:name "Westbeemster (gemeente Beemster)"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Het woonhuis Jisperweg 70 is een rond 1880 als rentenierswoning gebouwd middenganghuis met hoger opgetrokken middenpartij en geblokte hoekpilasters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02069> a min:Passage,
