        min:volgnummer 2031 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0173> ;
        schema:name "Weesp"@nl ;
        schema:pageEnd "516" ;
        schema:pageStart "516" ;
        schema:pagination "516" ;
        schema:text "De kosterij (Kerkstraat 19) bestaat uit twee diepe panden die in de 18de eeuw achter een lijstgevel zijn samengevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02032> a min:Passage,
