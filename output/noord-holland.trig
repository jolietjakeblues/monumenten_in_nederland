        min:volgnummer 2244 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0195> ;
        schema:name "Zuiderwoude (gemeente Waterland)"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "554" ;
        schema:pagination "554" ;
        schema:text "De voorm. openbare lagere school (Dorpsstraat 34-36), bestaande uit een onderwijzerswoning en dwars daarachter enkele lokalen, werd in 1869 gebouwd en rond 1920 ingrijpend verbouwd. De school heeft tot 1980 dienst gedaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02245> a min:Passage,
