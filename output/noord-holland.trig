        rdfs:label "Haarlemmerliede (gemeente Haarlemmerliede en Spaarnwoude)"@nl ;
        min:adres "Liedeweg 38",
            "Liedeweg 79" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
