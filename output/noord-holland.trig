        min:gemeente "Beverwijk" ;
        min:gemeenteInBoek "Beverwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beverwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijk aan Zee (gemeente Beverwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wijk aan Zee" ;
