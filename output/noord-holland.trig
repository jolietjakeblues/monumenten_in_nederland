        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "23950" ;
        min:soort "lemma" ;
        min:volgnummer 1469 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "418" ;
        schema:pageStart "418" ;
        schema:pagination "418" ;
        schema:text "Horeca. Café 't Bonte Paard (Naarderstraat 1) is een in oorsprong 18de-eeuwse boerderij annex herberg, die rond 1915 ingrijpend is verbouwd en gepleisterd. Restaurant De Gouden Leeuw (Brinklaan 18-20), een midden-19de-eeuws dwars pand met brede topgevel, heeft rond 1900 een luifel op ranke kolommen gekregen. Voorm. pensions zijn het met een serre uitgevoerde pand Torenlaan 34 (circa 1910) en het in traditionalistische vormen ontworpen pand Zonnehoek (Tafelbergweg 32; circa 1935)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

