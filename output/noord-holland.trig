        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "De R.K. O.L. Vrouwe Hemelvaartskerk (Brederodestraat 14) is een driebeukige kerk met monumentale voorgevel, gebouwd in 1950-'51 naar plannen van Th.C. Nix."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0028.php> .

