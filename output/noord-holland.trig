        min:volgnummer 1478 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill578> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0103> ;
        schema:name "Lijnden (gemeente Haarlemmermeer)"@nl ;
        schema:pageEnd "419" ;
        schema:pageStart "419" ;
        schema:pagination "419" ;
        schema:text "De Herv. kerk (Hoofdweg-Oostzijde 118) is een zaalkerk met dakruiter en boven de rondboogingang van het voorportaal het opschrift ‘Geloof is Liefde’. Een tussenlid verbindt de kerk met de pastorie. Het geheel werd in 1936 gebouwd naar ontwerp van L. Kraak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01479> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lijnden (gemeente Haarlemmermeer) – Boerderijen"@nl ;
        min:adres "Akerdijk 12",
            "Hoofdweg-Westzijde 105",
            "Hoofdweg-Westzijde 205" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Haarlemmermeer" ;
        min:gemeenteInBoek "Haarlemmermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haarlemmermeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lijnden (gemeente Haarlemmermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Lijnden" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53556> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "19917" ;
        min:soort "lemma" ;
        min:volgnummer 1479 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0103> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "419" ;
        schema:pageStart "419" ;
        schema:pagination "419" ;
        schema:text """Boerderijen. Rond 1880 verrees de stolpboerderij Westburg (Hoofdweg-Westzijde 105) met voorgebouwd woonhuis. De Henricus Hoeve (Hoofdweg-Westzijde 205) uit 1912 heeft een villa-achtig woonhuis met erkers.

Het gemaal ‘De Lijnden’ (Akerdijk 12) werd in 1843-'49 aan het noordeinde van de Hoofdvaart gebouwd als een van de drie stoomgemalen voor de drooglegging van de Haarlemmermeer. Het bestaat uit een torenvormige ronde machinekamer met gepleisterde kantelen, twee forse zijvleugels en een ketelruimte met gietijzeren vensters en schoorsteen, alles uitgevoerd in Willem II-gotiek naar ontwerp van J.A. Beijerinck. De stoommachine werd in 1930 vervangen door twee elektrisch aangedreven centrifugaalpompen.

Het trafohuisje (bij Akerdijk 12) werd rond 1920 gebouwd naar ontwerp van J.B. van Loghem."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01480> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Limmen (gemeente Castricum)"@nl ;
        min:adres "Zuidkerkenlaan 23a" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Castricum" ;
        min:gemeenteInBoek "Castricum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Castricum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Limmen (gemeente Castricum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Limmen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1480 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0104> ;
        schema:name "Limmen (gemeente Castricum)"@nl ;
        schema:pageEnd "419" ;
        schema:pageStart "419" ;
        schema:pagination "419" ;
        schema:text "Dorp, ontstaan als geestnederzetting op een strandwal en voor het eerst vermeld in 740. Rond de kerk vormde zich de Kerkbuurt. In de 18de eeuw kwam verder noordelijk een tweede bebouwingskern, Dusseldorp, tot ontwikkeling met een katholieke kerk. Jacobus du Peyrou kocht de heerlijkheid in 1732. De ambachtsheren woonden op huis Dampegeest (gesloopt 1846). Na 1850 werd Limmen een belangrijk centrum voor de bloembollenteelt. Schoolmeester P. Boschman stichtte in 1928 de ‘Hortus Bulborum’ (Zuidkerkenlaan 23a). Na de Tweede Wereldoorlog is de verspreide bebouwing tussen de twee dorpskernen verder verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01481> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Limmen (gemeente Castricum)"@nl ;
        min:adres "Zuidkerkenlaan 25" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Castricum" ;
        min:gemeenteInBoek "Castricum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Castricum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Limmen (gemeente Castricum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Limmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15552> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "25890" ;
        min:soort "inleiding" ;
        min:volgnummer 1481 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill579> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0104> ;
        schema:name "Limmen (gemeente Castricum)"@nl ;
        schema:pageEnd "420" ;
        schema:pageStart "419" ;
        schema:pagination "419-420" ;
        schema:text "De Herv. kerk (Zuidkerkenlaan 25), oorspronkelijk gewijd aan St. Cornelius, is een eenbeukige kerk voorzien van een ingebouwde slanke toren met ingesnoerde spits. Van de kleine tufstenen kerk uit circa 1100 resteert een muurfragment aan de zijde waar rond 1200 een laat-romaanse toren verrees. Bij de bouw van de huidige kerk rond 1300 raakte de toren ingebouwd. De in 1743 grotendeels vernieuwde toren bevat een door François en Pieter Hemony gegoten klok (1650). Het in de 15de eeuw vernieuwde koor werd in 1573 verwoest en daarna met een gedeelte van het schip gesloopt (laatste koorresten opgeruimd in 1806). De rechte koorsluiting dateert uit 1743. De kerk is gerestaureerd en ontpleisterd in 1904-'06, 1968 (ontpleistering; R.H. Fledderus) en 1999."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01482> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Limmen (gemeente Castricum)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Castricum" ;
        min:gemeenteInBoek "Castricum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Castricum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Limmen (gemeente Castricum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Limmen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1482 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0104> ;
        schema:name "Limmen (gemeente Castricum)"@nl ;
        schema:pageEnd "420" ;
        schema:pageStart "420" ;
        schema:pagination "420" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf (begin 17de eeuw) met oudere trekbalken voorzien van gotische sleutelstukken. Tot de inventaris behoren een laat-17de-eeuwse preekstoel en doophek (doopboog 1729), 18de-eeuwse overhuifde (heren)banken en een door P. Flaes gebouwd orgel (1877). De grafkelder van de familie Du Peyrou is tegen de oostmuur aangebouwd. In de kerk bevinden zich rouwborden voor Jacobus du Peyrou († 1756) en zijn zoon Jacob Jan du Peyrou († 1777), en het gemarmerde houten grafmonument met urn voor Anna Maria du Peyrou († 1785)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01483> a min:Passage,
            schema:CreativeWork ;
