        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66694>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66695>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66696> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "498844",
            "498850",
            "498856" ;
        min:soort "lemma" ;
        min:volgnummer 1864 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0151> ;
        schema:name "Valkkoog"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "Valkkoog. Dit kleine dorp ten oosten van Sint Maarten werd in 1627 kerkelijk onafhankelijk van Sint Maarten. De Herv. kerk (Valkkogerweg 39) is een eenbeukige vroeg-16de-eeuwse kerk, waarvan de toren en het koor in 1839 zijn gesloopt. De huidige half-ingebouwde toren met balustrade en ingesnoerde spits verrees in 1865 en bevat een door Jacob Noteman gegoten klok (1635). De consistoriekamer (noordzijde) heeft men rond 1900 toegevoegd. Bij een restauratie in 1984-'85 is de kerkbepleistering uit 1865 verwijderd. Het tongewelf en het kerkmeubilair dateren uit 1839. Verder bevat de kerk een preekstoel (tweede kwart 18de eeuw) en een door P.J. Adema gebouwd orgel (1871). De onderwijzerswoning (Valkkogerweg 38; 1871) en de pastorie (Valkkogerweg 37; 1874) zijn neoclassicistisch van vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01865> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Maarten (gemeente Harenkarspel) – Eenigenburg"@nl ;
        min:adres "Surmerhuizerweg 11",
