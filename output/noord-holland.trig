        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. belastingkantoor (Driftlaan 2) werd rond 1910 gebouwd als villa en heeft twee chaletstijl-topgevels en een centrale loggia op de verdieping."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

