        min:volgnummer 1976 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0166> ;
        schema:name "Venhuizen (gemeente Drechterland)"@nl ;
        schema:pageEnd "508" ;
        schema:pageStart "508" ;
        schema:pagination "508" ;
        schema:text "De R.K. St.-Lucaskerk (Westeinde 6) is een sobere traditionalistische kerk met toren en aanbouw, verwezenlijkt in 1954-'56 naar ontwerp van H.A. van Oerle en J.J. Schrama ter vervanging van een kerk uit 1847."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01977> a min:Passage,
