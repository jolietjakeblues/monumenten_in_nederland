        min:volgnummer 2015 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "513" ;
        schema:pagination "513" ;
        schema:text "Woonhuizen. Uit de late 19de eeuw dateren de eenvoudige dubbele landarbeiderswoning Dorpsstraat 247-247a (1871), het als rentenierswoning gebouwde eclectische middenganghuis Nooit Gedacht (Dorpsstraat 66; 1879) en de forse neoclassicistische dokterswoning Dorpsstraat 108 (1889). Neorenaissance-details vertoont het huis Dorpsstraat 219 (1902). Voorbeelden van vroeg-20ste-eeuwse rentenierswoningen zijn Oostwal 86-88 (circa 1915) en Dorpsstraat 22 (1916, K. Westra). Door J. Stuyt ontworpen zijn de huizen Fabrieksstraat 29-39 (circa 1920)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02016> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel) – Boerderijen"@nl ;
        min:adres "De Baan 1" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
