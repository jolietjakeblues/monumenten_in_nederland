        min:volgnummer 2250 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0196> ;
        schema:name "Zuidschermer (gemeente Schermer)"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "554" ;
        schema:pagination "554" ;
        schema:text "Een tussenlid verbindt de kerk met 't Schooltje (Zuidervaart 22), een voorm. schoolgebouw uit 1831 (gevelsteen) met ingezwenkte tuitgevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02251> a min:Passage,
