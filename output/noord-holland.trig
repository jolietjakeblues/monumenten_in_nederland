        schema:name "Scholen"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "513" ;
        schema:pagination "513" ;
        schema:text "Scholen. Rond 1880 verrees de neoclassicistische onderwijzerswoning Dorpsstraat 104. Zakelijk-expressionistisch van vorm is de openbare lagere school (Dorpsstraat 34), een drieklassige gangschool uit 1925. De R.K. lagere St.-Theresiaschool met zusterhuis (Dorpsstraat 171-175) kwam in 1924 tot stand in ‘Um 1800’-vormen naar plannen van J. Duyneter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02015> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 66" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
