        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01500> a min:Passage,
            schema:CreativeWork ;
