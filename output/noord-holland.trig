        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0193> ;
        schema:name "Zandvoort"@nl ;
        schema:pageEnd "551" ;
        schema:pageStart "551" ;
        schema:pagination "551" ;
        schema:text "De Geref. kerk (Julianaweg 15), een zaalkerk met overhoeks geplaatste dakruiter en aangebouwde pastorie (Julianaweg 17), kwam in 1926 tot stand naar een zakelijk-expressionistisch ontwerp van N.G. ten Broeke."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0193.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02227> a min:Passage,
