        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "Het voorm. diaconiehuis ‘De Kogge’ (Zuideinde 83) verrees in 1860 als wees- en bejaardenhuis naar ontwerp van A.G. Verschoor en L.J. Immink. Dit neoclassicistische tweelaagse gebouw met mezzanino en middenrisaliet is voorzien van geblokte pilasters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01387> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:adres "Lagedijk 41" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1387 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "Het voorm. Doopsgez. weeshuis (Lagedijk 41) kwam in 1910 tot stand naar plannen van D. Stam uit een legaat van de Zaandijkse bakker D. Sweepe ter nagedachtenis aan diens dochter Johanna Elisabeth Sweepe. Het blokvormige gebouw met dwarsvleugel vertoont neorenaissance-, jugendstil- en rationalistische details. Boven de ingang zit een gedenksteen met gotisch schrift."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01388> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        min:adres "Raadhuisstraat 86" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Koog aan de Zaan (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Koog aan de Zaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
