        min:hoofdstuk "Steden, dorpen, monumenten › Warmenhuizen (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warmenhuizen" ;
        min:lemma "Woonhuizen" ;
