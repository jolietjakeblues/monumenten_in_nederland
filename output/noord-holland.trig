        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill751>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill752> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0177> ;
        schema:name "Westerland (gemeente Wieringen)"@nl ;
        schema:pageEnd "524" ;
        schema:pageStart "523" ;
        schema:pagination "523-524" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen op het voormalige eiland Wieringen. In de loop van de 19de eeuw verdichtte de bebouwing zich. Aan de zuidzijde bij De Haukes ontstond enige bebouwing na de aanleg van een postbootsteiger (1874) en een haven (1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0177.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02077> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerland (gemeente Wieringen)"@nl ;
        min:adres "Westerlanderweg 65" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Wieringen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerland (gemeente Wieringen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westerland" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2077 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0177> ;
        schema:name "Westerland (gemeente Wieringen)"@nl ;
        schema:pageEnd "524" ;
        schema:pageStart "524" ;
        schema:pagination "524" ;
        schema:text "De Herv. kerk (Westerlanderweg 65), oorspronkelijk gewijd aan St. Nicolaas, is een driezijdig gesloten, eenbeukige kerk voorzien van een toren van drie geledingen met tentdak. De kort na 1500 opgetrokken toren, met gotische nissen in de twee bovenste geledingen, bevat een door Johannes Godefridus gegoten klok (1509). Het huidige torendak hoort waarschijnlijk bij een herstelling in 1913. Het romaanse schip en koor werden in 1828 vervangen door een schip met rondboogvensters. Op het kerkhof bevindt zich onder meer een grafsteen met terebinthboom voor C. Kuut († 1891)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0177.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02078> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerland (gemeente Wieringen)"@nl ;
        min:adres "Westerlanderweg 61" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Wieringen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerland (gemeente Wieringen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westerland" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2078 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0177> ;
        schema:name "Westerland (gemeente Wieringen)"@nl ;
        schema:pageEnd "524" ;
        schema:pageStart "524" ;
        schema:pagination "524" ;
        schema:text "De voorm. openbare lagere school (Westerlanderweg 61) is een tweeklassige school uit 1886 met een haakse achterbouw uit 1903."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0177.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02079> a min:Passage,
