        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Horeca. Het in de kern 17de-eeuwse diepe pand Schepenmakersdijk 1 is de voorm. herberg Amsterdam; de huidige lijstgevel dateert uit circa 1850. Het voorm. café Oost-Indie (Jan Nieuwenhuizenplein 7) heeft een houten gevel met pilasters en balustrade (circa 1880)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0060.php> .

