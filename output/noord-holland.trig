        rdfs:label "Bergen aan Zee (gemeente Bergen) – Recreatiewoningen"@nl ;
        min:adres "Paulineweg 15",
            "Paulineweg 19" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen aan Zee (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen aan Zee" ;
        min:lemma "Recreatiewoningen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 704 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0034> ;
        schema:name "Recreatiewoningen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Recreatiewoningen. Uitgevoerd met rieten daken zijn de rond 1920 opgetrokken zomerhuizen 't Roefje (Paulineweg 19) en 't Strootje (Paulineweg 15). Een plat dak heeft Elzenlaan 8 (1935), ontworpen door B. Merkelbach en Ch.J.F. Karsten. Naoorlogse voorbeelden zijn de kleine villa Parkweg 17 (circa 1960) en de dominante Alexanderflat met vakantieappartementen (Van der Wijckplein; 1960, G. Boon)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00705> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen aan Zee (gemeente Bergen) – Koloniehuizen"@nl ;
        min:adres "Verspijckweg 3",
            "Verspijckweg 5",
            "Verspijckweg 7" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen aan Zee (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen aan Zee" ;
        min:lemma "Koloniehuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 705 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0034> ;
        schema:name "Koloniehuizen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Koloniehuizen. Het voorm. koloniehuis Het Zeehuis (Verspijckweg 5) werd in 1908 naar ontwerp van P. Heyn gebouwd voor het Amsterdams Burgerweeshuis als een I-vormig pand met lager ingangsgedeelte en veranda's. Het tweelaagse voorm. koloniehuis Jong Nederland (Verspijckweg 7) kwam in 1910 tot stand naar ontwerp van A.D.N. en J.G. van Gendt voor de ‘Vereniging tot Bevordering van het Tijdelijk Verblijf van Kinderen in Gezonde Streken’. Tussen de midden- en hoekuitbouwen zijn veranda's aangebracht en aan de achterzijde bevindt zich een later toegevoegde cirkelvormige betonnen lighal (1937, G. Arendzen). Het voorm. koloniehuis Deutsche Ferienkolonie (Verspijckweg 3) is een eenlaagspand met hoog schilddak, gebouwd in 1912 naar plannen van P. Vorkink en J.P. Wormser voor de Deutsche Hilfsverein (uitgebreid 1921 en 1931)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

