        min:kern "Hilversum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73014> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "522697" ;
        min:soort "inleiding" ;
        min:volgnummer 1216 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0080> ;
        schema:name "Hilversum"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De voorm. pastorie (Emmastraat 7), nu parochiehuis, is een tegen de kerk aangebouwd herenhuis uit 1892, ontworpen door P.J.H. en J.Th.J. Cuypers in dezelfde stijl als de kerk, maar met een geveltop in chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01217> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilversum"@nl ;
        min:adres "Koninginneweg 40" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hilversum" ;
        min:gemeenteInBoek "Hilversum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilversum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilversum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hilversum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1217 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0080> ;
        schema:name "Hilversum"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De R.K. kerk O.L.-Vrouwe Onbevlekt Ontvangen (Koninginneweg 40) [4] is een driebeukige basilicale kruiskerk met vijfzijdig gesloten koor, dakruiter en een voorgevel met ingangsportaal en twee ranke traptorens. Deze neogotische kerk verrees in 1909-'10 naar ontwerp van W. te Riele en is geïnspireerd op de Amsterdamse Vondelkerk. Restauraties zijn uitgevoerd in 1990 en in 2005 (P.D. van Vliet)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01218> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilversum"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hilversum" ;
        min:gemeenteInBoek "Hilversum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilversum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilversum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hilversum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1218 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0080> ;
        schema:name "Hilversum"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "Het interieur heeft een centraliserende plattegrond dankzij het zich ter plaatse van de viering tot een zeshoek verwijdende middenschip. Tot de inventaris behoren een door B. Pels gebouwd orgel (1926) en kruiswegstaties van J. Dunselman (1926). De gebrandschilderde ramen zijn vervaardigd door atelier F. Nicolas (1911) en M. Weiss (circa 1960)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01219> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilversum"@nl ;
        min:adres "Bosdrift 55" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hilversum" ;
        min:gemeenteInBoek "Hilversum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilversum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilversum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hilversum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1219 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0080> ;
        schema:name "Hilversum"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De R.K. St.-Clemens Maria Hofbauerkerk (Bosdrift 55) is een driebeukige pseudo-basilicale kruiskerk met recht gesloten koor en een dakruiter. Deze kerk in neoromaans-Byzantijnse stijl werd in 1913-'14 gebouwd naar ontwerp van Jac. van Gils en in 1921-'22 aan de voorzijde met twee traveeën uitgebreid (J.Th.J. Cuypers). Boven de ingang zit een timpaan met muraalglasschildering van M. Weiss (circa 1960). Het interieur in neoromaanse vormen is uitgevoerd met brede scheibogen en een afwisseling van schoonmetselwerklagen met witte banden. Het orgel is gebouwd door G.F. Steinmeyer (1923)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01220> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hilversum"@nl ;
        min:adres "P.J.H. Cuypersplein 5" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hilversum" ;
        min:gemeenteInBoek "Hilversum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilversum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hilversum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hilversum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1220 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0080> ;
        schema:name "Hilversum"@nl ;
        schema:pageEnd "364" ;
        schema:pageStart "364" ;
        schema:pagination "364" ;
        schema:text "De R.K. H. Hart van Jezuskerk (P.J.H. Cuypersplein 5) [5] is een driebeukige basilicale kerk voorzien van een achtzijdig vieringgedeelte met lagere transeptarmen. De zware toren van twee geledingen met forse vierzijdige spits wordt geflankeerd door breed uitgebouwde kapellen. De kerk kwam in 1927-'28 tot stand naar een ontwerp in traditionalistische vormen van H.W. Valk. Afkomstig uit de Amsterdamse Catharinakerk is het Van Dam-orgel (1826, geplaatst 1934) met orgelkast naar ontwerp van N. Andriessen (1934)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01221> a min:Passage,
