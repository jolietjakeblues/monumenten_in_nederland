        min:gemeenteInBoek "Stede Broec" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bovenkarspel (gemeente Stede Broec)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bovenkarspel" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 767 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0039> ;
        schema:name "Bovenkarspel (gemeente Stede Broec)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "De R.K. St.-Martinuskerk (Hoofdstraat 205) is een moderne zaalkerk voorzien van een forse vrijstaande klokkentoren met betonnen bovenstuk. Ter vervanging van een kerk uit 1872 heeft men deze kerk in 1964-'66 naar plannen van J.A. Lelieveldt gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00768> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bovenkarspel (gemeente Stede Broec) – Raadhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
