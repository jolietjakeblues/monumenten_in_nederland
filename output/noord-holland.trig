        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Dorp in de Haarlemmermeerpolder, ontstaan kort na 1852 langs de Hoofdvaart bij een brug (Dr. Heyebrug). Na de Tweede Wereldoorlog heeft aan de noordzijde een bescheiden uitbreiding plaatsgevonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0009.php> .

