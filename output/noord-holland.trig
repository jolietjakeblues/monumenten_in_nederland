        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Woonhuizen. Rond 1870 gebouwd is het diepe huis Livorno (Hoofdweg-Oostzijde 1234). Vroeg-20ste-eeuws zijn Nieuwstraat 2 (1908), Hoofdweg-Westzijde 5 (circa 1910), met siermetselwerk in gele baksteen, en het nu wit gepleisterde spoorwachtershuis Venneperweg 683 (1912)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01645> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-Vennep (gemeente Haarlemmermeer) – Boerderijen"@nl ;
        min:adres "Bosstraat 19",
            "Hoofdweg-Oostzijde 1162",
            "Hoofdweg-Westzijde 1041",
            "Hoofdweg-Westzijde 1325-1327",
            "Rijnlanderweg 1144",
            "Rijnlanderweg 1185",
            "Rijnlanderweg 1396",
            "Rijnlanderweg 1489",
            "Rijnlanderweg 1663: 1906" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Haarlemmermeer" ;
        min:gemeenteInBoek "Haarlemmermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haarlemmermeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-Vennep (gemeente Haarlemmermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuw-Vennep" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1645 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0121> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text """Boerderijen. Van kort na de drooglegging dateert de langhuisboerderij Reintjeshoeve (Rijnlanderweg 1489; 1856) met serliana-venster in de geveltop. Een villa-achtig neorenaissancewoonhuis heeft de boerderij Venneperweg 1069 (circa 1895). Interessante stolpboerderijen, met verhoogd middengedeelte zijn Graswijk (Rijnlanderweg 1144; 1861), de Margaretha Hoeve (Hoofdweg-Westzijde 1325-1327; 1862, met prieel) en de met houten voorschot uitgevoerde boerderij Hoofdweg-Westzijde 983-985 (circa 1895). Kenmerkend zijn de boerderijen met een hogere en bredere schuur (zijlangsdeel) achter het woonhuis, zoals Weltevreden (Rijnlanderweg 1185; circa 1900, met sierspant) en Rijnlanderweg 1261-1263 (circa 1900). Jongere voorbeelden zijn de boerderijen Hoop en Vlijt-De Landman (Rijnlanderweg 1663: 1906), Nooitgedacht (Hoofdweg-Oostzijde 1162; 1915) en Kleine Vennep (Hoofdweg-Westzijde 1041; circa 1928). Een forse vrijstaande schuur heeft de boerderij Vredenburgh (Rijnlanderweg 1396; circa 1930).

De Alg. begraafplaats (Bosstraat 19), aangelegd rond 1880, heeft een ijzeren toegangshek voorzien van een boog met doodssymbolen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01646> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1646 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Dorp, ontstaan in de middeleeuwen als veenontginning. In 1415 kregen Oude en Nieuwe Niedorp samen met Winkel als ‘Stede Niedorp’ stadsrechten, maar deze waren louter bestuurstechnisch van aard. Er vormde zich een tweezijdige lintbebouwing, die gaandeweg verder is verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01647> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:adres "Dorpsstraat 179" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40232>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59181> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30384",
            "30385" ;
        min:soort "inleiding" ;
        min:volgnummer 1647 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "De Herv. kerk (bij Dorpsstraat 179) is een moderne kerk (1965-'66, A.N. Schippers), gebouwd ter plaatse van voorganger uit 1876 die weer een middeleeuwse kerk verving. Van de oude kerk resteert de laat-15de-eeuwse toren met een 17de-eeuwse derde geleding. De toren heeft haakse steunberen met pinakel-achtige bekroningen en is voorzien van speklagen en nissen met laat-gotische traceringen. Erin hangt een door François en Pieter Hemony gegoten klok (1653)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01648> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:adres "Dorpsstraat 120" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35342> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511062" ;
        min:soort "inleiding" ;
        min:volgnummer 1648 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Op het kerkhof liggen nog enkele, voornamelijk 17de-eeuwse, grafzerken uit oude kerk. De voorm. pastorie (Dorpsstraat 120) is een eclectisch middenganghuis uit 1876 met flauw hellend dak en gesneden windveren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01649> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:adres "Dorpsstraat 149",
            "Dorpsstraat 82" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1649 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "De Doopsgez. kerk (Dorpsstraat 149) is een zaalkerk uit 1878, waarvan de geveltoren in 1925 is afgebroken. Het voorm. raadhuis (Dorpsstraat 82) is een in 1868-'69 opgetrokken tweelaags pand voorzien van eclectische details, gepleisterde hoekpilasters en een middenrisaliet met balkon, fronton en kleine klokkentoren. Het gebouw is in 1964 gemoderniseerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01650> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:adres "Dorpsstraat 265" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1650 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Het voorm. rusthuis ‘De Vijverhof’ (Dorpsstraat 265) kwam in 1910 tot stand naar plannen van S. Krijnen als een langgerekt tehuis voor ouden van dagen. De haaks geplaatste puntgevel bevat twee 17de-eeuwse leeuwenkopmaskers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01651> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        min:adres "Dorpsstraat 146-148" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1651 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Nieuwe Niedorp (gemeente Niedorp)"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "De openbare lagere school (Dorpsstraat 146-148) werd in 1931-'32 gebouwd naar ontwerp van C.D. en J. van Reijendam als een langgerekt L-vormig pand in zakelijk-expressionistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01652> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1652 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill638> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Woonhuizen. De met houten voorschot uitgevoerde diepe huizen Dorpsstraat 116 en 121 zijn in hun huidige vorm 19de-eeuws (gerestaureerd), maar hebben mogelijk een oudere kern. Een oude kern (mogelijk 1530) heeft ook het deels onderkelderde dwarse huis Dorpsstraat 173 met houten halsgevel. Het gepleisterde dwarse eenlaagspand Dorpsstraat 197 (circa 1830) vertoont sobere late empire-details, en eclectisch van vorm is het diepe huis Dorpsstraat 169 (circa 1880). Met rode kalkzandsteen gebouwd is het middenganghuis Dorpsstraat 125 (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01653> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1653 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text "Boerderijen. Uit circa 1870 dateert de stolpboerderij Dorpsstraat 237 met spiegel en versierde schoorsteen. De in 1877 gebouwde stolpboerderij Dorpsstraat 62 (1877) heeft een uitgebouwd middenrisaliet met gesneden windveren. De stolpboerderij Dorpsstraat 78 uit 1865 werd in 1882 verbouwd tot een kop-rompboerderij door toevoeging van een woongedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01654> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwe Niedorp (gemeente Niedorp) – Poldermolen"@nl ;
        min:adres "Ooievaarsweg 6",
            "Oosterweg 6",
            "Oude Provincialeweg 22",
            "Oude Provincialeweg 24" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Niedorp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwe Niedorp (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nieuwe Niedorp" ;
        min:lemma "Poldermolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37343> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30387" ;
        min:soort "lemma" ;
        min:volgnummer 1654 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0122> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "459" ;
        schema:pageStart "459" ;
        schema:pagination "459" ;
        schema:text """Poldermolen ‘De Westermolen’ (Oosterweg 6) is een met riet gedekte achtkantige binnenkruier op een met hout beklede voet. Deze molen uit 1854 bemaalde de Oosterpolder.

De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (Oude Provincialeweg 24) ligt ten noordoosten van Nieuwe Niedorp. Deze rijzige eenbeukige neogotische kapel met dakruiter en driezijdig gesloten koor verrees in 1905-'06 naar plannen van P.J. Bekkers. Het vormde de kern van het erop aansluitende U-vormige franciscanenklooster (Oude Provincialeweg 22). Nadat het klooster in 1960 aan de zusters Clarissen was gekomen, heeft men aan de oostkant een tweede klooster met St.-Antoniusschool (Ooievaarsweg 6) gebouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01655> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noord-Scharwoude (gemeente Langedijk)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Langedijk" ;
        min:gemeenteInBoek "Langedijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noord-Scharwoude (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Noord-Scharwoude" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1655 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0123> ;
        schema:name "Noord-Scharwoude (gemeente Langedijk)"@nl ;
        schema:pageEnd "460" ;
        schema:pageStart "460" ;
        schema:pagination "460" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als een van de vier langgerekte dorpen aan de Langedijk. De middeleeuwse kerk brandde in 1934 af. De op de vele kleine eilanden in de omringende polder Geestmerambacht geteelde kool werd vanaf 1915 - na aansluiting op de tramlijn naar Alkmaar - in een groenteveiling verkocht. Het tramtracé heeft men in 1934 veranderd in een provinciale weg. Na de ruilverkaveling (1965-'74) is Noord-Scharwoude aan weerszijden van de oude lintbebouwing aanzienlijk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01656> a min:Passage,
