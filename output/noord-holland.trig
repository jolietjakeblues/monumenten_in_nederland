        min:soort "inleiding" ;
        min:volgnummer 1927 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill714> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0161> ;
        schema:name "Twisk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "500" ;
        schema:pageStart "500" ;
        schema:pagination "500" ;
        schema:text "De voorm. pastorie (Dorpsweg 120) is een rijk eclectisch middenganghuis uit 1878 met een hoger opgaand middenrisaliet voorzien van een balkon op zuiltjes."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0161.php> .

