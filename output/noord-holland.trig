        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Maarten (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Sint Maarten" ;
        min:lemma "Eenigenburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38845>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57351>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72749>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72750> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "33623",
            "33624",
            "498827",
            "498834" ;
        min:soort "lemma" ;
        min:volgnummer 1865 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0151> ;
        schema:name "Eenigenburg"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "Eenigenburg. Dit kleine dorp ten zuiden van Sint Maarten bestaat uit bebouwing op enkele vroeg-middeleeuwse huisterpen. De eveneens op een terp gelegen eenbeukige Herv. kerk (Surmerhuizerweg 29) verving in 1792 een mogelijk 15de-eeuwse kerk. In de houten geveltoren hangt een door Goebel Zael gegoten klok (1535). Het dak kreeg kort na 1875 Oegstgeester pannen. Tot de kerkinventaris behoren een preekstoel met het wapen van Eenigenburg (1698) en een door Scholgens & Van den Haspel gebouwd orgel (1876). De in 1858 gebouwde pastorie (Surmerhuizerweg 37) is een neoclassicistisch middenganghuis met hoger opgetrokken middenrisaliet. De voorm. openbare lagere school annex onderwijzerswoning (Surmerhuizerweg 11) dateert uit 1877. Voorbeelden van kleine op een terp gelegen landarbeiderswoningen zijn Surmerhuizerweg 13 en 15 (midden 19de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01866> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Maartensbrug (gemeente Zijpe)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Zijpe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Maartensbrug (gemeente Zijpe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Sint Maartensbrug" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1866 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0152> ;
        schema:name "Sint Maartensbrug (gemeente Zijpe)"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "Kruisvormig dorp, gesticht kort na de definitieve bedijking van de Zijpe- en Hazepolder in 1596-'97. De bebouwing concentreerde zich aan de Grote Sloot en de haaks daarop staande Sint-Maartensweg. Na de Tweede Wereldoorlog is het dorp enigszins uitgebreid in het noorderkwadrant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01867> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Maartensbrug (gemeente Zijpe)"@nl ;
        min:adres "Grote Sloot 233" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Zijpe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Maartensbrug (gemeente Zijpe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Sint Maartensbrug" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54292> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "41938" ;
        min:soort "inleiding" ;
        min:volgnummer 1867 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill697> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0152> ;
        schema:name "Sint Maartensbrug (gemeente Zijpe)"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "De Herv. kerk (Grote Sloot 233) is een brede zaalkerk met aangebouwde woning en houten geveltorentje. Deze in 1696 gebouwde kerk werd rond 1860 bepleisterd en voorzien van een torentje. Daarin hangt een door Mammes en Claude Fremy gegoten klok (1683). De kerk is in 1985-'88 gerestaureerd. Het interieur wordt gedekt door een houten spiegelgewelf en heeft twee rijen ionische zuilen. Tot de inventaris behoren een preekstoel, een doophek en twee overhuifde gestoelten (alle eind 17de eeuw). De kerk bevat een grafzerk voor hoofdingeland Pieter van Rijswijck († 1725) en op het kerkhof staat een grafsteen met schip voor W. 't Hart († 1830)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01868> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Maartensbrug (gemeente Zijpe) – Woonhuizen"@nl ;
        min:adres "Grote Sloot 201",
            "Grote Sloot 239" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
