        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0138> ;
        schema:name "Oudorp (gemeente Alkmaar)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "Het voorm. raadhuis (Kerklaan 9) is een L-vormig eenlaagspand met topgevels en een dak met overstek op gesneden schoren. Het werd in 1865 naar plannen van F.J. Krieger gebouwd ter plaatse van een rechthuis uit 1635 en in 1928-'29 vergroot (P.N. Leguit). Ernaast staan de voorm. openbare lagere school ‘Wijkplaats’ (Herenweg 12) en een dienstwoning (Kerklaan 11) uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01752> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudorp (gemeente Alkmaar)"@nl ;
        min:adres "Munnikenweg 18-20" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Alkmaar" ;
        min:gemeenteInBoek "Alkmaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alkmaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudorp (gemeente Alkmaar)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1752 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0138> ;
        schema:name "Oudorp (gemeente Alkmaar)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "De openbare lagere school ‘De Zes Wielen’ (Munnikenweg 18-20), een L-vormig schoolgebouw met onderwijzerswoning, werd rond 1925 gebouwd naar een ontwerp in traditionalistische vormen van C.D. van Reijendam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01753> a min:Passage,
