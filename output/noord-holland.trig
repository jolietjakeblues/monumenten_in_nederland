        min:volgnummer 2012 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Warmenhuizen (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "513" ;
        schema:pagination "513" ;
        schema:text "Het voorm. raadhuis annex secretariswoning (Dorpsstraat 106) is een fors tweelaags pand uit 1872, gebouwd in eclectische vormen met gepleisterde (hoek)pilasters en een middenrisaliet met balkon. Bij een verbouwing in 1893 kreeg het een neorenaissance-dakkapel (W. Vlaming)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

