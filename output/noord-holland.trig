        schema:name "Poldermolens"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Poldermolens. Ten noorden van Groet staan twee met riet gedekte achtkantige binnenkruiers op een met hout beklede voet. De Hargermolen (Mosterdweg 9; 1804) bemaalde de Vereenigde Harger- en Pettemerpolder, De Groetermolen (Hargerweg 12; 1890) de Groeterpolder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01044> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grootebroek (gemeente Stede Broec)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Stede Broec" ;
        min:gemeenteInBoek "Stede Broec" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grootebroek (gemeente Stede Broec)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grootebroek" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1044 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill411> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0068> ;
        schema:name "Grootebroek (gemeente Stede Broec)"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Dorp, ontstaan in de 12de eeuw als veenontginning langs de Streek, de ontginningsas tussen Hoorn en Enkhuizen. In 1364 gingen de vrijheid van Groote-Broec en die van Boeven-Kerspel samen tot de Stede van Broec en later kwamen daar Lutjebroek (1402) en Hoogkarspel (1403) nog bij. Dit ‘steden’-verband werd pas opgeheven in 1807. De in 1581 aangelegde straatweg over de ontginningsas werd in 1671 verhard (Zesstedenweg). Grootebroek had te lijden van dorpsbranden in 1651, 1665 en 1750. Vanaf de 19de eeuw vond er veel grove tuinbouw plaats, waartoe in 1892 een veiling werd gesticht. De sluiting daarvan in 1976 was het gevolg van een ruilverkaveling (1973-'79), die de vaarpolder Het Grootslag met veel sloten veranderde in een rijpolder. Na de Tweede Wereldoorlog is het dorp vooral aan de zuidzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01045> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grootebroek (gemeente Stede Broec)"@nl ;
        min:adres "Zesstedenweg 187",
            "Zesstedenweg 189" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Stede Broec" ;
        min:gemeenteInBoek "Stede Broec" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grootebroek (gemeente Stede Broec)" ;
