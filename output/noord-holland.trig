        min:volgnummer 955 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill376>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill377> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0062> ;
        schema:name "Egmond aan Zee (gemeente Bergen)"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "285" ;
        schema:pagination "285-286" ;
        schema:text "De Herv. kerk (Trompstraat 2) is een driezijdig gesloten zaalkerk met houten geveltorentje, gebouwd in 1746 door aannemer Jan Stuyt ter vervanging van een in 1741 ingestorte voorganger. De in 1897 verlengde en in 1974 gerestaureerde kerk bevat een preekstoel en doophek uit circa 1746 en een door L. van Dam & Zn. gebouwd orgel (1898)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00956> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Egmond aan Zee (gemeente Bergen)"@nl ;
        min:adres "Voorstraat 112" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
