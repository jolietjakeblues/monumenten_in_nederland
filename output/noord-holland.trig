        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1790 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "480" ;
        schema:pageStart "480" ;
        schema:pagination "480" ;
        schema:text "Begraafplaatsen. De rond 1860 gestichte R.K. begraafplaats (tegenover Overweersepolderdijk 9) is bereikbaar via een gemetselde brug en een toegangshek. Op de begraafplaats staat een neoromaanse kapel met onderdelen van kunstzandsteen (1878). De Oude Alg. begraafplaats (Plantsoengracht ong.) werd omstreeks 1880 aangelegd op het zuidoostelijke bastion. Het toegangshek heeft hardstenen pijlers bekroond met vazen. Opvallende graftekens zijn de zuil met omfloerste urn op verhoogd postament voor O. de Jong († 1905) en de grafsteen met treurende vrouw voor H.G. van den Berg († 1934)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01791> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Purmerend – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1791 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "480" ;
        schema:pageStart "480" ;
        schema:pagination "480" ;
        schema:text "Boerderijen. De stolpboerderijen in het buitengebied zijn vaak toegankelijk via bruggetjes en mooie hekwerken. De laat-19de-eeuwse voorbeelden hebben veelal een dakerker met gesneden windveren, zoals Westerweg 39, 30-32 en 18 (houten topgevel). Wit gepleisterde boerderijen zijn Westerweg 21 en 28 (beide circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01792> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1792 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill679> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Ransdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "480" ;
        schema:pagination "480-481" ;
        schema:text "Dorp, ontstaan in de 14de eeuw als veenontginning in de Bloemendaler Weeren en voor het eerst genoemd in 1324. Aanvankelijk waren er twee parallel lopende lintbebouwingen (Bloemendalergouw en Liergouw) waartussen haaks het huidige (tweede) dorp ontstond. De in de 15de en 16de eeuw bereikte welvaart kwijnde weg na 1588. De in 1619 gestichte Unie van Waterland, met Ransdorp als hoofdplaats, kon daarin geen verandering brengen. Rond 1700 was de zeevaart van het dorp geheel verdwenen en vervangen door landbouw. Dat leidde ook tot een afname van het aantal huizen. De bebouwing concentreerde zich langs de Dorpsweg, met een kleine dorpskern om de kerk. In 1921 werd de gemeente Ransdorp door Amsterdam geannexeerd, maar dit leidde niet tot verdere uitbreiding. Ransdorp is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01793> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam)"@nl ;
        min:adres "Dorpsweg 57" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1793 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Ransdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "De Herv. kerk (Dorpsweg 57) is een zaalkerk met een forse toren van drie geledingen zonder spits. De met haakse steunberen uitgevoerde toren verrees rond 1525 (tussen 1502 en 1549) naar plannen van Jan Poyt, aan wie men ook de toren van Loenen (U) toeschrijft. Deze rijk gedetailleerde laat-gotische toren heeft een omlopende balustrade op de overgang van de tweede naar de derde geleding. Tot een afsluitende balustrade met spits is het niet gekomen. In deze in 1937 door H.P. Messer gerestaureerde toren hangt een door Henricus Meurs gegoten klok (1620). De bijbehorende kerk stortte in de 17de eeuw in en van de opvolger uit 1719-'20 resteert slechts het muurwerk met de onder uitzwenkende lisenen. De in 1833 verbeterde en in 1936 naar plannen van J.C. Hoogendorp grotendeels vernieuwde kerk bevat een laat-17de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01794> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam)"@nl ;
        min:adres "Dorpsweg 59" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1794 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Ransdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "Het voorm. raadhuis (Dorpsweg 59) werd in 1652 gebouwd naar een classicistisch ontwerp van Pieter Pietersz van Saendam als een dwars pand met souterrain en een door dorische pilasters gelede bel-etage. Boven de ingang zit een gevelsteen met zwaan. De dubbele bordestrap en de huidige ingang zijn vermoedelijk van een verbouwing in 1734. Het gebouw is gerestaureerd in 1923-'24 (N.H.W. Scholte)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam)"@nl ;
        min:adres "Dorpsweg 35-37" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Ransdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "De voorm. openbare lagere school (Dorpsweg 35-37) is een eenklassige school met haaks aangebouwde onderwijzerswoning die werd gebouwd in 1869, mogelijk naar ontwerp van T.C. van der Sterr."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01796> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam)"@nl ;
        min:adres "Dorpsweg 19",
            "Dorpsweg 21" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ransdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ransdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1796 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0142> ;
        schema:name "Ransdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "481" ;
        schema:pageStart "481" ;
        schema:pagination "481" ;
        schema:text "De Chr. lagere school ‘De Wegwijzer’ (Dorpsweg 19) begon in 1897 als een houten onderwijzerswoning met daarachter twee lokalen. Tegen die lokalen werden in 1921-'22 enkele nieuwe lokalen geplaatst naar plannen van D. Honingh en D.G. Kruse. Verder werd de woning verbouwd. Ernaast verrees een nieuwe onderwijzerswoning (Dorpsweg 21). In 1985-'86 zijn de lokalen uit 1897 vervangen en heeft men de rest gerenoveerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01797> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ransdorp (gemeente Amsterdam) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
