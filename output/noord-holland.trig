        schema:name "Opperdoes (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text "Het voorm. raadhuis (Gouw 9-15) is een rijzig pand uit 1928 met slank torenvormig element, raadzaal op de verdieping en een aangebouwde dienstwoning. Het ontwerp met expressionistische details is van C. Trappenburg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01707> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opperdoes (gemeente Noorder-Koggenland) – Boerderijen"@nl ;
        min:adres "Almsdorperweg 8" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opperdoes (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Opperdoes" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1707 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0131> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text """Boerderijen. Een mogelijk 18de-eeuwse oorsprong heeft de sobere stolpboerderij Tempel 1. Interessante stolpboerderijen met spiegel zijn Oosteinde 10 (circa 1850), met houten middentopgevel en aangebouwde ouderkamer, en Zuiderpad 5 (circa 1870) met uitgebouwd zomerhuis en binnen een betegelde schouw met smuiger.

Het voorm. station (Almsdorperweg 8) werd in 1886 gebouwd voor de Locaalspoorwegmaatschappij ‘Hollands Noorderkwartier’ aan de lijn Hoorn-Medemblik. Het langwerpige eenlaagspand is ontworpen door A.J. Krieger en heeft een vrijstaand toiletgebouwtje."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0131.php> .

