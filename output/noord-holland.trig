        min:soort "inleiding" ;
        min:volgnummer 2252 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0196> ;
        schema:name "Zuidschermer (gemeente Schermer)"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "554" ;
        schema:pagination "554" ;
        schema:text "De R.K. lagere St.-Michaëlschool (Zuidervaart 59) werd in 1929 gebouwd en later uitgebreid. De bijbehorende onderwijzerswoning heeft een opvallende driezijdige erker met balkon."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02253> a min:Passage,
