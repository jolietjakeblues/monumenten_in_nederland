        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29650> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "32192" ;
        min:soort "inleiding" ;
        min:volgnummer 1779 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Purmerend"@nl ;
        schema:pageEnd "477" ;
        schema:pageStart "477" ;
        schema:pagination "477" ;
        schema:text "De voorm. Herv. kerk (Kaasmarkt 15), nu R.K. H.H. Nicolaas- en Catharinakerk, is een achtzijdige centraalbouw met dakruiter, ingangsportaal, consistoriekamer en op vier hoeken een vijfzijdige kapel. Deze kerk met gietijzeren rondboogvensters, eclectische en terracotta-details kwam in 1851-'53 tot stand naar ontwerp van W.A. Scholten en verving een laat-gotische kerk. Na de sluiting in 1972 is het gebouw na verbouwing in 1988 in gebruik genomen als rooms-katholieke kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01780> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Purmerend"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1780 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Purmerend"@nl ;
        schema:pageEnd "477" ;
        schema:pageStart "477" ;
        schema:pagination "477" ;
        schema:text "Het interieur wordt gedekt door een ziende kap en heeft gestucte wanddecoraties in late empire-vormen (1863). Tot de inventaris behoren een zeskantige eiken preekstoel (1643) en een koperen doopboog en lessenaar met stadswapen (derde kwart 17de eeuw). De zerkenvloer is afkomstig uit de in 1850 afgebroken middeleeuwse kerk. Het marmeren epitaaf voor Frederik Riccen († 1652), Catharina Muylwijck († 1631) en hun zoon Ventidius († 1659) wordt toegeschreven aan Bartholomeus Eggers. De kerk bevat een door Rudolf Garrels gebouwd orgel (1739-'42) en een door C.G.F. Witte voor de Doopsgez. vermaning vervaardigd orgel (1865; overgeplaatst 1989)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01781> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Purmerend"@nl ;
        min:adres "Hoogstraat 18" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Purmerend" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36243> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "512164" ;
        min:soort "inleiding" ;
        min:volgnummer 1781 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0141> ;
        schema:name "Purmerend"@nl ;
        schema:pageEnd "477" ;
        schema:pageStart "477" ;
        schema:pagination "477" ;
        schema:text "De Evang. Luth. kerk (Hoogstraat 18), een eclectische zaalkerk met voorplein, kwam in 1878-'80 tot stand naar plannen van P. Mager en verving een kerk uit 1712. Het in 1994 deels gerestaureerde gebouw bevat een Van Dam-orgel (1892). Uit 1932 dateert het gemeenschapsgebouw achter de kerk (Westersteeg)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01782> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Purmerend – Overige kerken"@nl ;
        min:adres "Emmakade 4",
