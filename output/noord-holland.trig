        min:soort "lemma" ;
        min:volgnummer 666 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill280> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0030> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "225" ;
        schema:pageStart "224" ;
        schema:pagination "224-225" ;
        schema:text "Boerderijen. De 18de-eeuwse stolpboerderij Beets 15 heeft houten wanden, terugliggende dorsdeuren en een tuitgevel (links). Een houten middentopgevel bezit de stolpboerderij Beets 86 (1847), en met siermetselwerk, pilasters en een spiegel uitgevoerd is de stolpboerderij De Zoete Inval (Beets 131; circa 1875). Vóór de stolp van de boerderij Ora et Labora (Beets 31; circa 1910) staat een villa-achtig voorhuis voorzien van een dakerker met serliana en gesneden windveren in chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00667> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beets (gemeente Zeevang) – Woonhuizen"@nl ;
