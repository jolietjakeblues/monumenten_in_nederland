        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De openbare lagere school (Dorpsstraat 11) is een drieklassige gangschool uit 1880 (verbouwd circa 1920) met aangebouwde onderwijzerswoning (Dorpsstraat 13)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0008.php> .

