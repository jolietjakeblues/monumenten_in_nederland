        min:hoofdstuk "Steden, dorpen, monumenten › Warmenhuizen (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warmenhuizen" ;
        min:lemma "Krabbendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49850> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38280" ;
        min:soort "lemma" ;
        min:volgnummer 2019 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Krabbendam"@nl ;
        schema:pageEnd "514" ;
        schema:pageStart "514" ;
        schema:pagination "514" ;
        schema:text "Krabbendam. Dit gehucht ten noordwesten van Warmenhuizen kwam in de 19de eeuw tot ontwikkeling. In 1846 gebouwd en in 1875 vergroot is de eenvoudige Geref. kerk met aangebouwde woning (Kerkpad 15). Deze kerk bevat sinds 1911 een door Hendrik Blötz gebouwd orgel (1765), afkomstig uit de R.K. kerk St. Petrus Banden te Diemen. De rond 1910 gebouwde pastorie (Westfriesedijk 94) heeft jugendstiltegels boven de vensters. Uit die tijd dateert ook de stolpboerderij Paarl-Hoeve (Westfriesedijk 92) met breed uitgebouwd woongedeelte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02020> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Watergang (gemeente Waterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
