        min:soort "inleiding" ;
        min:volgnummer 1519 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0110> ;
        schema:name "Middelie (gemeente Zeevang)"@nl ;
        schema:pageEnd "430" ;
        schema:pageStart "430" ;
        schema:pagination "430" ;
        schema:text "Dorp, ontstaan eind 12de eeuw als veenontginning in de Polder Zeevang en voor het eerst vermeld in 1277. Dit langgerekte, later wat dichter bebouwde, lintdorp kreeg na de Tweede Wereldoorlog aan de zuidzijde langs de Zijvend enige bebouwing, waardoor de bebouwing zich tot het gehucht Axwijk uitstrekt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0110.php> .

