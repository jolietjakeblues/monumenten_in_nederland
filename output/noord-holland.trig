        schema:name "Egmond-Binnen (gemeente Bergen)"@nl ;
        schema:pageEnd "287" ;
        schema:pageStart "287" ;
        schema:pagination "287" ;
        schema:text "Tot het complex behoren een ingangspoort en een U-vormige kloosterboerderij (Vennewatersweg 27), waarvan de oorspronkelijk open hof later is overkapt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0063.php> .

