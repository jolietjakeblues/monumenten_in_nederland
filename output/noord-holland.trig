        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Sloten (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Sloten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24780> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "526706" ;
        min:soort "inleiding" ;
        min:volgnummer 590 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0020> ;
        schema:name "Amsterdam-Sloten (gemeente Amsterdam)"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "De R.K. St.-Pancratiuskerk (Sloterweg 1186) is een driebeukige basilicale kerk met recht gesloten koor en een robuuste ongelede toren met traptoren en naaldspits. Deze met neoromaanse elementen uitgevoerde kerk verrees in 1900-'01 naar plannen van J. Stuyt - zijn eerste grote kerk - ter vervanging van een 18de-eeuwse schuurkerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00591> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Sloten (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Sloten (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Sloten" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 591 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0020> ;
        schema:name "Amsterdam-Sloten (gemeente Amsterdam)"@nl ;
        schema:pageEnd "213" ;
        schema:pageStart "213" ;
        schema:pagination "213" ;
        schema:text "Het interieur wordt gedekt door gepolychromeerde blauwe houten tongewelven. Uit de schuurkerk afkomstig is het Ypma-orgel (1883). Tot de inventaris uit de bouwtijd behoren een hoofdaltaar van atelier Cuypers (1901) en kruiswegstaties."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00592> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Sloten (gemeente Amsterdam) – Naoorlogse kerken"@nl ;
        min:adres "A. Waldorpstraat 90",
            "Akerpolderstraat 9-47",
            "Derkinderenstraat 90",
            "Osdorper Ban 130",
            "P. Calandlaan 196",
            "Postjesweg 150-152",
            "Sloterweg 1190",
            "Sloterweg 1226",
            "Tussen Meer 70",
            "Van Ollefenstraat 9" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Sloten (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Sloten" ;
        min:lemma "Naoorlogse kerken" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 592 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0020> ;
        schema:name "Naoorlogse kerken"@nl ;
        schema:pageEnd "213" ;
        schema:pageStart "213" ;
        schema:pagination "213" ;
        schema:text """Naoorlogse kerken. Een traditionalistische zaalkerk met hoge vensters in de langsgevel is de voorm. kerk van het Apost. genootschap in Overtoomseveld (Derkinderenstraat 90; 1956-'57, M.E. Hartman). Ontworpen in de traditionalistische stijl van de Bossche school is de R.K. H. Pius X-kerk in Slotervaart (J. Geelstraat 44; 1959-'60, J.A. van der Laan, L. Hermans, Th.M. van der Eerden en H.M. Kirch.) [367]. Deze forse zaalkerk met robuuste hoektoren is voorzien van een glasmozaïek (F. Janssen). Om twee kleine binnenplaatsen liggen dienst- en vergaderruimten. Traditionalistisch van vorm is verder de Vrije Evang. kerk in Overtoomseveld (A. Waldorpstraat 90; 1963, B.B. Westerhuis). De Herv. kerk De Ark in Slotervaart (Van Ollefenstraat 9; 1960, P. Zanstra) en de (Bapt.) Herdenkingskerk in Overtoomseveld (Postjesweg 150-152; 1963, H. Geels) zijn moderne zaalkerken met aangebouwde bijruimten. Een vrijstaande opengewerkte klokkentoren heeft de forse R.K. St.-Lucaskerk in Osdorp (Osdorper Ban 130; 1964-'65, Th.J. Taen en Th.C. Nix). De gebrandschilderde glazen (1906) zijn hier in 1990 overgebracht uit het ursulinenklooster te Bergen. In Osdorp staan verder nog de R.K. St.-Pauluskerk (P. Calandlaan 196; 1966-'67, J.J. van Leeuwen), een koepelkerk met vrijstaande betonnen klokkentoren, en de (Geref.) Opgangkerk (Tussen Meer 70; 1968, J. Kruger) met vrijstaande bakstenen klokkentoren.

Het voorm. wees- en armenhuis (Akerpolderstraat 9-47) is een drielaags pand met neorenaissance-elementen, in zijn huidige vorm daterend van circa 1910.

Het voorm. raadhuis (Sloterweg 1190), dat tot 1921 als zodanig dienst heeft gedaan, is een tweelaags pand met omlijste ingang, gebouwd in 1850 en verhoogd rond 1910.

De politiepost (Sloterweg 1226) is een klein eenlaagspand uit circa 1900 met wachtlokaal en cachot. Ernaast staan een gietijzeren brandmelder."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00593> a min:Passage,
            schema:CreativeWork ;
