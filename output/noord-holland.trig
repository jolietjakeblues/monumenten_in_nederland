        schema:name "Wijk aan Zee (gemeente Beverwijk)"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "De voorm. openbare lagere school (Relweg 4) werd rond 1900 gebouwd als drieklassige gangschool. Het voorm. politiebureau met woonhuis (St.-Odulfstraat 23-23a) kwam rond 1915 tot stand in traditionalistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0185.php> .

