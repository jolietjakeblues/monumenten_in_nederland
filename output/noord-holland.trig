        min:hoofdstuk "Steden, dorpen, monumenten › Enkhuizen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Enkhuizen" ;
        min:lemma "Royal Sluis" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1004 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0064> ;
        schema:name "Royal Sluis"@nl ;
        schema:pageEnd "299" ;
        schema:pageStart "299" ;
        schema:pagination "299" ;
        schema:text "Royal Sluis. Een in 1867 door N. Sluis en N. Groot te Andijk opgerichte zaadhandel werd in 1872 te Enkhuizen gevestigd. Rond 1890 kwam in neorenaissance-stijl het woon- en winkelpand Westerstraat 153 tot stand (sinds 1927 café met vergaderzaal) en in 1900 verrees voor A. Sluis het pakhuis Westerstraat 206. Bij het rond 1910 betrokken gebouw Westeinde 161 bouwde men in 1927 aan de straatzijde in gele baksteen het functionalistische kantoorgebouw ‘Royal Sluis’ (nu ‘Seminis vegetable seeds’)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01005> a min:Passage,
            schema:CreativeWork ;
