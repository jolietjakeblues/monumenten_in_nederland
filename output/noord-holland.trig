        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "Het postkantoor met directeurswoning (Bloemendaalseweg 236-238) is een tweelaags pand met overhoekse dakruiter, gebouwd in 1906 naar een ontwerp in chaletstijl met neogotische details van C.H. Peters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0139.php> .

