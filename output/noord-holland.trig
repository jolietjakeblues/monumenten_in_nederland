        schema:name "Alkmaar"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text "Het in 1856 bij de kerk ontstane voorplein wordt afgesloten door een hekwerk en geflankeerd door de kosterswoning Koningsweg 10 (1856) en de domineeswoning Koningsweg 14 (1871)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00307> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Alkmaar"@nl ;
        min:adres "Verdronkenoord 68" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
