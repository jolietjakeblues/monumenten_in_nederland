        min:gemeenteInBoek "Bloemendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vogelenzang (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Vogelenzang" ;
        min:lemma "Vinkenduin" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72674>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72675> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511110",
            "511111" ;
        min:soort "lemma" ;
        min:volgnummer 1990 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0168> ;
        schema:name "Vinkenduin"@nl ;
        schema:pageEnd "510" ;
        schema:pageStart "510" ;
        schema:pagination "510" ;
        schema:text "Vinkenduin (Vogelenzangseweg 39). Dit van Leyduin afgescheiden buiten heeft een naar ontwerp van A. de Maaker in 1924-'25 opgetrokken huis in Nieuw Historiserende stijl. In de door L.A. Springer landschappelijk ontworpen parkaanleg zijn restanten van 18de-eeuwse vinkenbanen behouden. De Maaker ontwierp verder het theehuis of bospaviljoen (Tweede Leyweg 8; 1919-'20), de vrijstaande dienstwoning Vogelenzangseweg 37 (1924-'25) - met inpandige dubbele garage - en een smeedijzeren toegangshek (1926)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01991> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vogelenzang (gemeente Bloemendaal) – Woestduin"@nl ;
        min:adres "Manpadslaan 2",
            "Manpadslaan 8" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bloemendaal" ;
        min:gemeenteInBoek "Bloemendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vogelenzang (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Vogelenzang" ;
        min:lemma "Woestduin" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33733> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511147" ;
        min:soort "lemma" ;
        min:volgnummer 1991 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0168> ;
        schema:name "Woestduin"@nl ;
        schema:pageEnd "510" ;
        schema:pageStart "510" ;
        schema:pagination "510" ;
        schema:text "Woestduin (bij Manpadslaan 2). Deze 17de-eeuwse buitenplaats werd tussen 1766 en 1784 vergroot en verfraaid in opdracht van David ten Hove. Rond 1800 ontstond naar plannen van J.D. Zocher sr. een landschappelijke aanleg met een heuvel als uitzichtspunt. Het 18de-eeuwse huis is in 1955 gesloopt, na het voltooien van een nieuw huis (Manpadslaan 2) in 1954 met een tuinaanleg van H. Warnau. Behouden is een 18de-eeuws toegangshek. Het oude huis was rond 1900 verbouwd tot hotelcafé-restaurant bij een door L.A. Springer ontworpen paardenrenbaan (in gebruik van 1901 tot 1909). Van de door D.E.L. van den Arend bij de renbaan ontworpen opstallen is slechts de renstal (Manpadslaan 8; 1905) behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01992> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vogelenzang (gemeente Bloemendaal) – Woonhuizen"@nl ;
