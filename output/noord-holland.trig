        min:hoofdstuk "Steden, dorpen, monumenten › Aalsmeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Aalsmeer" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 251 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0007-01> ;
        schema:name "Aalsmeer"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "De R.K. kerk O.L. Vrouwe van de Berg Carmel (Stommeerweg 13), een zaalkerk met roosvenster en terzijde geplaatste zadeldaktoren, werd in 1931 gebouwd naar een traditionalistisch ontwerp van J.P.L. Hendriks. De interieurschilderingen zijn van G. van Geffen (1956)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00252> a min:Passage,
