        schema:pageEnd "402" ;
        schema:pageStart "402" ;
        schema:pagination "402" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 20), een wit gepleisterd eenlaags pand met eclectische wenkbrauwen, werd in 1868 tegen de kerk gebouwd en later bij de kerk getrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01349> a min:Passage,
