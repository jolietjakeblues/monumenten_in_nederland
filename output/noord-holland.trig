        min:soort "inleiding" ;
        min:volgnummer 1690 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0129> ;
        schema:name "Oostwoud (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "Dorp, ontstaan in de hoge middeleeuwen als veenontginning. In 1519 is er sprake van de bouw van een nieuwe kerk. De lintbebouwing heeft zich in de 19de eeuw verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01691> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostwoud (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Oosteinde 44" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostwoud (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostwoud" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31165>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56617> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30667",
            "30668" ;
        min:soort "inleiding" ;
        min:volgnummer 1691 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0129> ;
        schema:name "Oostwoud (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "De Herv. kerk (Oosteinde 44) is een eenbeukige kerk met vijfzijdig gesloten koor en boven de westgevel een houten dakruiter met achtzijdige spits. Volgens een gedenksteen stamt deze kerk uit 1753. In de dakruiter hangt een door Henricus Nieman gegoten klok (1616). Rond 1875 kwam de vijfzijdig gesloten noordelijke uitbouw met consistoriekamer en zondagsschool tot stand. Verder kreeg de kerk toen gietijzeren rondboogvensters en een houten lattenplafond. Tot de inventaris behoren een preekstoel (tweede helft 17de eeuw), een psalmbord (1769) en een door L. van Dam & Zn. gebouwd orgel (1874)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01692> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostwoud (gemeente Noorder-Koggenland) – Woonhuizen"@nl ;
        min:adres "Oostwoud Dorpsstraat 36" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostwoud (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostwoud" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1692 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill649> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0129> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text """Woonhuizen. Het forse eclectische herenhuis Oosteinde 57, met pilasters en wenkbrauwen, dateert uit 1870. Iets jonger is het eclectische middenganghuis Oosteinde 32 (circa 1880).

De boerderij Oostwoud Dorpsstraat 69 heeft een 19de-eeuwse stolpschuur. Naar ontwerp van D. Saal kwam in 1926 het met riet gedekt villa-achtige woonhuis met erker en expressionistische details tot stand.

De voorm. stoomzuivelfabriek ‘Oostwoud’ (Oostwoud Dorpsstraat 36) is een diep pand uit 1907 met een bescheiden sierspant."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0129.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01693> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostzaan"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Oostzaan" ;
        min:gemeenteInBoek "Oostzaan" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oostzaan_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostzaan" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostzaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1693 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0130> ;
        schema:name "Oostzaan"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "Dorp, ontstaan in de 12de eeuw als veenontginning met een min of meer evenwijdig aan de Zaan lopende ontginningsas. Het zuidelijke dorpsdeel leefde in de 17de eeuw van op Amsterdam gerichte handel en nijverheid, het noordelijk deel had een agrarisch karakter. Bij het noordelijke buurtschap De Haal opende men in 1884 het station Oostzaan aan de spoorlijn Zaandam-Purmerend. Na de Tweede Wereldoorlog is het zuidelijke deel van Oostzaan aanmerkelijk uitgebreid als forensendorp van Amsterdam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01694> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostzaan"@nl ;
        min:adres "Kerkbuurt 12" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Oostzaan" ;
        min:gemeenteInBoek "Oostzaan" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oostzaan_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostzaan" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostzaan" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53746> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "31739" ;
        min:soort "inleiding" ;
        min:volgnummer 1694 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0130> ;
        schema:name "Oostzaan"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "De Herv. kerk (Kerkbuurt 12) is een kruiskerk met recht gesloten koor en een houten geveltoren met spits. Deze kerk met rondboogvensters en ornamenten in Lodewijk XV-stijl verving in 1760 een in 1573 verwoeste laat-middeleeuwse kerk. Bij de restauratie in 1938-'39 (J. de Meijer) is een consistoriekamer toegevoegd en recent heeft de kerk een moderne aanbouw gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01695> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostzaan"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Oostzaan" ;
        min:gemeenteInBoek "Oostzaan" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oostzaan_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostzaan" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostzaan" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1695 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0130> ;
        schema:name "Oostzaan"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven met trekbalken. De vloer is belegd met zerken uit de oude kerk. Tot de inventaris uit de bouwtijd behoren een preekstoel en doophek in Lodewijk XV-stijl, alsmede herenbanken, een tochtportaal en twee scheepsmodellen. Het orgel is gebouwd door H. Knipscheer (1858)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01696> a min:Passage,
