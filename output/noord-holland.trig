        min:volgnummer 1698 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0130> ;
        schema:name "Oostzaan"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text "Het raadhuis (Kerkbuurt 14) werd in 1860 gebouwd in combinatie met een café met woonhuis, een stalling en een cachot. In 1922 heeft men de stalling verbouwd tot brandweerkazerne en het café tot secretarie. Het gebouw is verder gerestaureerd in 1953 en uitgebreid in 1973 en 1986."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0130.php> .

