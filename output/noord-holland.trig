        min:volgnummer 557 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill250> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0017> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Poldermolen ‘De Riekermolen’ (De Borcht 10) [365], gelegen aan de oostzijde van Buitenveldert, is een met riet gedekte achtkantige grondzeiler uit 1636, die vanwege de vergroting van het Nieuwe Meer bij Sloten in 1961 naar de huidige plek is overgebracht. Voor de molen staat een bronzen beeld van Rembrandt als tekenaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00558> a min:Passage,
