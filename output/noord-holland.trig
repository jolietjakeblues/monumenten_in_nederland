        min:gemeenteInBoek "Stede Broec" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grootebroek (gemeente Stede Broec)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grootebroek" ;
        min:lemma "Scholen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1050 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0068> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text """Scholen. Voorm. openbare lagere scholen met onderwijzerswoning zijn het tweeklassige neoclassicistische schoolgebouw Zesstedenweg 195 uit 1881 en de drieklassige gangschool Zesstedenweg 259 (circa 1925). De R.K. lagere school ‘De Uilenburcht’ (Zesstedenweg 182) is een L-vormige school uit 1925.

Het voorm. raadhuis (Zesstedenweg 205) is een traditionalistisch pand, gebouwd in 1931-'32 naar plannen van C. Weel ter vervanging van het oude raadhuis uit 1758."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01051> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grootebroek (gemeente Stede Broec) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Stede Broec" ;
        min:gemeenteInBoek "Stede Broec" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grootebroek (gemeente Stede Broec)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grootebroek" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1051 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0068> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text """Woonhuizen. Het volgens een gevelsteen in 1643 gebouwde diepe huis Zesstedenweg 233 met trapgevels diende lange tijd als bakkerij, kreeg eind 18de eeuw een nieuwe pui en werd na een restauratie (2001) ingericht als woonhuis. Begin 20ste eeuw bouwde men het woon- en winkelpand Zesstedenweg 229 (circa 1900), het wit gepleisterde herenhuis Zesstedenweg 176 (circa 1915) en het met expressionistische details uitgevoerde kleine woningbouwcomplex Zesstedenweg 335-341 (circa 1920).

De boerderij Zesstedenweg 214 is een midden-19de-eeuwse stolpboerderij met ingezwenkte houten middentopgevel. Een hergebruikte 17de-eeuwse gevelsteen toont St. Maarten."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0068.php> .

