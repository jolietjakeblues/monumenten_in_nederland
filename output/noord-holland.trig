        min:volgnummer 1409 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0097> ;
        schema:name "Krommenie (gemeente Zaanstad)"@nl ;
        schema:pageEnd "409" ;
        schema:pageStart "409" ;
        schema:pagination "409" ;
        schema:text "De Oud-Kath. kerk (bij Noorderhoofdstraat 131) is een recht gesloten schuilkerk achter een woonhuis (pastorie). Een verbouwde boerderij ter plaatse kwam in 1612 in gebruik als schuilkerk, werd vergroot in 1633 en kreeg in 1826 bakstenen zijgevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0097.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01410> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Krommenie (gemeente Zaanstad)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Krommenie (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Krommenie" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1410 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0097> ;
        schema:name "Krommenie (gemeente Zaanstad)"@nl ;
        schema:pageEnd "409" ;
        schema:pageStart "409" ;
        schema:pagination "409" ;
        schema:text "Het driebeukige interieur heeft houten zuilen, een houten tongewelf boven de middenbeuk en vlakgedekte zijbeuken. Tot de inventaris behoren een marmeren doopvont en een gebeeldhouwd marmeren nisje (beide circa 1650), een preekstoel op een voet met gesneden adelaar (circa 1690) en een doophek (circa 1690). Het altaar (circa 1710) is afkomstig uit de gesloopte schuilkerk ‘De Pauw’ te Amsterdam en heeft een altaarschildering van Willebrordus Boogaerts (1635) en een tabernakel (circa 1750). Verder zijn er een rijk gesneden communiebank en lavabotafel (circa 1710), en kerkbanken in Lodewijk XV-stijl (circa 1760). Uit Langeraar (ZH) komt het kabinetorgel (1719; geplaatst 1827)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0097.php> .

