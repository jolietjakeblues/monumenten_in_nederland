        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Monnickendam (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Monnickendam" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1559 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0114> ;
        schema:name "Monnickendam (gemeente Waterland)"@nl ;
        schema:pageEnd "436" ;
        schema:pageStart "436" ;
        schema:pagination "436" ;
        schema:text "De voorm. Geref. kerk (Schoolstraat 2) [6], een eclectische zaalkerk uit 1894, is nu als woning met praktijkruimte in gebruik. De voorgevel is gedecoreerd met gepleisterde boogfriezen en pilasters en heeft een betegeld open portaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01560> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Monnickendam (gemeente Waterland)"@nl ;
