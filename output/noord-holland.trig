        min:hoofdstuk "Steden, dorpen, monumenten › West-Graftdijk (gemeente Graft-De Rijp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "West-Graftdijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2081 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0178> ;
        schema:name "West-Graftdijk (gemeente Graft-De Rijp)"@nl ;
        schema:pageEnd "524" ;
        schema:pageStart "524" ;
        schema:pagination "524" ;
        schema:text "Dorp op het Schermereiland, ontstaan in de tweede helft van de 16de eeuw aan de dijk, toen de schorren ten zuiden van het Schermereiand waren ingedijkt en daarmee een dijk tegen de Starnmeer was gelegd. Bij de kerk, gebouwd op een terp nabij een knik in de dijk bij de sluis, vormde zich een kleine dorpskern. Achter de dijk van het Noordhollands Kanaal ligt een kleine haven, waar in 1921 een jachtwerf werd ingericht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02082> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "West-Graftdijk (gemeente Graft-De Rijp)"@nl ;
        min:adres "Graftdijkplein 3" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Alkmaar" ;
        min:gemeenteInBoek "Graft-De Rijp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alkmaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › West-Graftdijk (gemeente Graft-De Rijp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "West-Graftdijk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32908> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "17070" ;
        min:soort "inleiding" ;
        min:volgnummer 2082 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0178> ;
        schema:name "West-Graftdijk (gemeente Graft-De Rijp)"@nl ;
        schema:pageEnd "524" ;
        schema:pageStart "524" ;
        schema:pagination "524" ;
        schema:text "De Herv. kerk (Graftdijkplein 3) is een zaalkerk met vijfzijdige sluiting, steunberen, spitsboogvensters en een houten klokkentorentje. Daarin hangt een door François en Pieter Hemony gegoten klok (1651). De kerk stamt uit 1651, maar werd ingrijpend vernieuwd in 1792. Er volgde herstel in 1855-'56 en in 1902 heeft men de meest westelijke travee met het torentje vernieuwd. Deze in 1992 gerestaureerde kerk bevat een laat-17de-eeuwse preekstoel met doophek en een door Bakker & Timmenga voor de Geref. kerk te Sint Annaparochie gebouwd orgel (1906, overgebracht 1927)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02083> a min:Passage,
