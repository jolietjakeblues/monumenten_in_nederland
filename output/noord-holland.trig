        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50098> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "516031" ;
        min:soort "lemma" ;
        min:volgnummer 1890 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0155> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "495" ;
        schema:pageStart "494" ;
        schema:pagination "494-495" ;
        schema:text "Boerderijen. In de door drooglegging van het IJ (1865-'73) ontstane Houtrakpolder ten noordoosten van Spaarndam liggen enkele interessante boerderijen, zoals de stolpboerderijen Ringweg 8-10 (circa 1880), met gepleisterde pilasters, en de Johanna Hoeve (Noorderweg 18; circa 1890) met vooruitstekend middengedeelte. Kenmerkend zijn ook enkele forse vrijstaande landbouwschuren, zoals die bij boerderij Nieuw Maurick (Noorderweg 17; circa 1920) en bij de Roons Hoeve (Noordzeekanaalweg 3) uit 1929."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01891> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Spanbroek (gemeente Opmeer)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
