        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Schellinkhout" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35999> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "37141" ;
        min:soort "lemma" ;
        min:volgnummer 1839 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0147> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "488" ;
        schema:pageStart "487" ;
        schema:pagination "487-488" ;
        schema:text "Woonhuizen. Het in de kern moge-lijk 18de-eeuwse dwarse huis De Steenen Camer (Dorpsweg 61) heeft een groot venster geflankeerd door twee lancetvensters. Vroeg-19de-eeuws is het diepe houten huis Dorpsweg 160 met afluiving. Het rond 1850 gebouwde dwarse houten huis Dorpsweg 106 is voorzien van een dakkapel met gesneden windveren en wangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01840> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schellinkhout (gemeente Drechterland) – Boerderijen"@nl ;
        min:adres "Dorpsweg 75" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schellinkhout (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Schellinkhout" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52692> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "508440" ;
        min:soort "lemma" ;
        min:volgnummer 1840 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0147> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "488" ;
        schema:pageStart "488" ;
        schema:pagination "488" ;
        schema:text "Boerderijen. De in de kern mogelijk nog 18de-eeuwse stolpboerderij Dorpsweg 20 heeft een asymmetrisch houten voorschot en een pronkdeur. Uitgevoerd met houten geveltop en terugliggende darsdeuren is de stolpboerderij Dorpsweg 98 (circa 1880). Terugliggende darsdeuren heeft ook de stolpboerderij Dorpsweg 74 (circa 1885). In het muurwerk is een gevelsteen uit 1612 (Geloof, Hoop en Liefde) opgenomen. Een spiegel en dakerker bezitten de stolpboerderijen Dorpsweg 107 (circa 1875), Nooit Gedacht (Dorpsweg 75; 1890) en Dorpsweg 66 (circa 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01841> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schellinkhout (gemeente Drechterland) – Poldermolen"@nl ;
        min:adres "Zuiderdijk 56",
            "Zuiderdijk 57" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
