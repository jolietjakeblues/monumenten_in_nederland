        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58479> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38273" ;
        min:soort "lemma" ;
        min:volgnummer 2016 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill735> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "514" ;
        schema:pageStart "513" ;
        schema:pagination "513-514" ;
        schema:text "Boerderijen. De 18de-eeuwse boerderij Baanhuis (De Baan 1) bestaat uit een met planken beschoten stolpvormige schuur met rieten dak en uitgebouwd laag woongedeelte. Een houten halsgevel heeft het middenrisaliet van het woongedeelte van de stolpboerderij Dorpsstraat 52-54, die in de kern mogelijk 18de-eeuws is. Voorbeelden van stolpboerderijen met spiegel zijn Dorpsstraat 33-35 (circa 1850), Stationsstraat 14 (1868), De Fuik 27 (1869) en Dorpsstraat 207 (1871). Bij de boerderij Dorpsstraat 185 (circa 1875) heeft men rond 1920 een winkel ingebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02017> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel) – Koolschuren"@nl ;
        min:adres "Stationsstraat 28" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Harenkarspel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warmenhuizen (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warmenhuizen" ;
        min:lemma "Koolschuren" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 2017 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Koolschuren"@nl ;
        schema:pageEnd "514" ;
        schema:pageStart "514" ;
        schema:pagination "514" ;
        schema:text """Koolschuren. Voorbeelden van karakteristieke koolschuren met mansardedak zijn Molenaarweg 54, De Fuik 19 (beide uit circa 1910) en 't Eiland 2 (circa 1920).

De zaadhandel Dorpsstraat 213 kwam rond 1933 tot stand in zakelijk-expressionistische vormen.

Het voorm. tramstation (Stationsstraat 28) werd in 1913 gebouwd voor de stoomtram Alkmaar-Schagen (tot 1933). Op het oude bedieningsgebouw staat nog de haltenaam."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02018> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel) – Poldermolen"@nl ;
        min:adres "Burchtweg 3",
            "Molenweg 1" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Harenkarspel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warmenhuizen (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warmenhuizen" ;
        min:lemma "Poldermolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55988> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38281" ;
        min:soort "lemma" ;
        min:volgnummer 2018 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "514" ;
        schema:pageStart "514" ;
        schema:pagination "514" ;
        schema:text """Poldermolen ‘De Grebmolen’ (bij Molenweg 1), ten zuiden van Warmenhuizen, bemaalde de Grebpolder. Deze met riet gedekte achtkantige grondzeiler op een met hout beklede voet dateert uit 1875.

De ruïne van kasteel Nuwendoorn (bij Burchtweg 3), gelegen ten noordwesten van Warmenhuizen, is het restant van een rond 1290 door Floris V gebouwde dwangburcht die eind 14de eeuw door overstromingen te gronde ging. Bij opgraving (1960-'63) bleek de burcht te bestaan uit een vierkante hoofdburcht met vooruitstekende poorttoren, een zware en een kleine hoektoren, alsmede een voorburcht. De restanten zijn in 1964 hoger opgetrokken."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

