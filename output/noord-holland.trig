        min:volgnummer 2264 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0198> ;
        schema:name "Zwaag (gemeente Hoorn)"@nl ;
        schema:pageEnd "555" ;
        schema:pageStart "555" ;
        schema:pagination "555" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 131-133) is een eclectisch pand met gepleisterd middenrisaliet en hoekpilasters, gebouwd in 1869-'70 naar ontwerp van P. Mager. Het had een raadzaal op de verdieping en bood tevens plaats aan een tweeklassige school, een onderwijzerswoning en een gymlokaal (achterzijde)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02265> a min:Passage,
