        min:volgnummer 1429 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0099> ;
        schema:name "Kwadijk (gemeente Zeevang)"@nl ;
        schema:pageEnd "412" ;
        schema:pageStart "412" ;
        schema:pagination "412" ;
        schema:text "De Herv. kerk (Kwadijk 87), een zaalkerk met spitsboogvensters en een houten geveltoren, werd in 1835 gebouwd ter vervanging van een kerk uit 1674. De in 1986 gerestaureerde kerk bevat een 17de-eeuwse preekstoel, een doophek met koperen doopboog in Lodewijk XIV-stijl (1741), en een door P. Flaes gebouwd orgel (1866). De pastorie (Kwadijk 84; circa 1885) is een middenganghuis met eclectische wenkbrauwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0099.php> .

