        min:hoofdstuk "Steden, dorpen, monumenten › Den Burg (gemeente Texel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Den Burg" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 860 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill340> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0051> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "263" ;
        schema:pageStart "263" ;
        schema:pagination "263" ;
        schema:text "Begraafplaatsen. De rond 1880 gestichte Alg. begraafplaats (Kogerstraat 74) heeft een interessant grafteken met vlinder voor H.C. Dijt († 1906) en een oorlogsgedeelte voor geallieerde vliegers; hier staat een Cross of Sacrifice. Opmerkelijk is het monument in de vorm van een levensboom, geschonken in 1975 ter herinnering aan de opstand van Georgische krijgsgevangenen (1945) en ontworpen door G. Otchiauri, T. Drapardize en Z. Sakvarelidze. Op de rond 1900 gestichte R.K. begraafplaats (bij Hollewal 40) bevindt zich onder meer een zerk met gietijzeren grafkruis voor H.W. Keesom († 1929)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00861> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Burg (gemeente Texel) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
