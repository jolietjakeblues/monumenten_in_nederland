        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haarlemmermeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Badhoevedorp (gemeente Haarlemmermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Badhoevedorp" ;
        min:lemma "Scholen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 650 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0027> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Scholen. In functionalistische stijl uitgevoerd is de Chr. lagere Oranje Nassauschool (Roerdompstraat 14; circa 1930, J.H. van der Veen). Meer traditionalistisch van vorm zijn de Chr. lagere school Burg. Van Amersfoordtlaan 61 (1931) en de voorm. openbare lagere school Roerdompstraat 10 (1939-'40)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00651> a min:Passage,
