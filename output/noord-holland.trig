        schema:pageStart "532" ;
        schema:pagination "532" ;
        schema:text "Het voorm. postkantoor (Bosstraat 30), een eclectisch pand geflankeerd door eenlaagse aanbouwen, werd in 1879 gebouwd naar plannen van J. Rezelman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0186.php> .

