        min:adres "Jisperweg 52-53" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Beemster" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westbeemster (gemeente Beemster)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westbeemster" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70602>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70603> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511339",
            "511340" ;
        min:soort "inleiding" ;
        min:volgnummer 2067 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0175> ;
        schema:name "Westbeemster (gemeente Beemster)"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Het voorm. O.L. Vrouwe van Lourdesklooster (Jisperweg 52-53), ontworpen door S.B. van Sante in 1910, is een gepleisterd L-vormig gebouw. De korte poot vormde het zusterklooster met op de verdieping de kloosterkapel en in de lange poot bevond zich een school. Boven de hoofdingang in het middenrisaliet zit een jugendstiltegeltableau (firma ‘De Porceleyne Fles’) met een voorstelling van de H. Maagd. Het terrein is toegankelijk via een boogbrug van gewapend beton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02068> a min:Passage,
            schema:CreativeWork ;
