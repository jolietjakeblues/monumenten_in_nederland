        schema:name "Zwaag (gemeente Hoorn)"@nl ;
        schema:pageEnd "555" ;
        schema:pageStart "555" ;
        schema:pagination "555" ;
        schema:text "De R.K. Lourdeskapel (Past. Nuijenstraat 2) is een zeszijdige kapel met dakruiter en ingangsportaal, gesticht door pastoor Masker in 1882 en waarschijnlijk ontworpen door J. Kooter. De kapel bevat een Lourdesgrot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02263> a min:Passage,
