        schema:pageStart "463" ;
        schema:pagination "463" ;
        schema:text "Het kerkhof wordt afgesloten door een smeedijzeren hek tussen natuurstenen posten met frontons en tuinvazen (circa 1860)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0128.php> .

