        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0024> ;
        schema:name "Ankeveen (gemeente Wijdemeren)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "Langgerekt ontginningsdorp, ontstaan in de 12de eeuw als cope-ontginning. De ontginningsas wordt gevormd door het Stichts-Hollands End. Door natte vervening ontstond vanaf circa 1450 het nabije plassengebied. Na de Tweede Wereldoorlog is het dorp enigszins uitgebreid bij de R.K. kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0024.php> .

