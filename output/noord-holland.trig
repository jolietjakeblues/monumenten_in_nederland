        min:hoofdstuk "Steden, dorpen, monumenten › Westwoud (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westwoud" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62359> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "495653" ;
        min:soort "inleiding" ;
        min:volgnummer 2087 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0179> ;
        schema:name "Westwoud (gemeente Drechterland)"@nl ;
        schema:pageEnd "525" ;
        schema:pageStart "525" ;
        schema:pagination "525" ;
        schema:text "De Herv. kerk (Dr. Nuijensstraat 24) is een zaalkerk met aangebouwde consistorie en een half-ingebouwde toren met achtkantige lantaarn en naaldspits. In de toren hangt een door Claude Fremy gegoten klok (1684). Deze eclectische kerk met gietijzeren rondboogvensters kwam in 1875 tot stand naar plannen van A.T. van Wijngaarden en bevat een Van Dam-orgel (1883)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02088> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westwoud (gemeente Drechterland)"@nl ;
        min:adres "Dr. Nuijensstraat 80" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westwoud (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2088 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill754> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0179> ;
        schema:name "Westwoud (gemeente Drechterland)"@nl ;
        schema:pageEnd "525" ;
        schema:pageStart "525" ;
        schema:pagination "525" ;
        schema:text "De R.K. St.-Martinuskerk (bij Dr. Nuijensstraat 80) is een driebeukige kruiskerk met halfronde apsis en een toren van drie geledingen met houten lantaarn en ingesnoerde naaldspits. Ter vervanging van een schuurkerk uit 1773 werd deze neoclassicistische kerk in 1849-'51 gebouwd naar ontwerp van Th. Molkenboer. In rondboognissen van de voorgevel staan door P.J. de Cuyper vervaardigde beelden. De kerk is gerestaureerd in 1983-'84."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02089> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westwoud (gemeente Drechterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westwoud (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2089 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0179> ;
        schema:name "Westwoud (gemeente Drechterland)"@nl ;
        schema:pageEnd "525" ;
        schema:pageStart "525" ;
        schema:pagination "525" ;
        schema:text "Het interieur wordt gedekt door gestucte kruisribgewelven op ionische zuilen en pilasters met entablementen. Tot de rijke neobarokke inventaris uit de bouwtijd behoren biechtstoelen, een communiebank, een neobarok hoofdaltaar (L. Veneman) en zijaltaren, enkele heiligenbeelden, koperen kronen en een gebeeldhouwde preekstoel (1865). Verder zijn er een door L. Ypma gebouwd orgel (1863-'64) en een koperen gedenkplaat voor in 1894 in Westwoud overleden arts en historicus W.J.F. Nuijens (1898, J.H. Brom)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02090> a min:Passage,
