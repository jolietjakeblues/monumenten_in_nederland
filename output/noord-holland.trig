        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Hoorn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31913> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "22548" ;
        min:soort "inleiding" ;
        min:volgnummer 1283 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill522> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0086> ;
        schema:name "Hoorn"@nl ;
        schema:pageEnd "383" ;
        schema:pageStart "382" ;
        schema:pagination "382-383" ;
        schema:text "De Evang. Luth. kerk (Ramen 4) [3] is een zaalkerk voorzien van een ingezwenkte voorgevel met geblokte hoeklisenen en een pronkrisaliet in Lodewijk XV-stijl. Ter vervanging van een kerk aan de Tempelsteeg (1631) kwam deze kerk na een langdurige discussie in 1768-'69 tot stand, mogelijk naar ontwerp van Jacob Hart of meestertimmerman Barent Brouwer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01284> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoorn"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
