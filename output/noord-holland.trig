        min:gemeenteInBoek "Wijdemeren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wijdemeren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ankeveen (gemeente Wijdemeren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ankeveen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 627 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill273> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0024> ;
        schema:name "Ankeveen (gemeente Wijdemeren)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De R.K. St.-Martinuskerk (Stichts End 21-23) is een driebeukige basilicale kruiskerk met een pastorie en een terzijde geplaatste robuuste toren met hoog tentdak. Deze traditionalistische kerk verrees in 1927-'28 naar ontwerp van Th. van Elsberg en verving een schuurkerk uit 1758. Het interieur uit 1928 bevat ook nog enkele 19de-eeuwse neogotische beelden. In de pastorietuin ligt een gebeeldhouwde wapensteen afkomstig van gesloopte armenwoningen (tweede kwart 18de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0024.php> .

