        min:hoofdstuk "Steden, dorpen, monumenten › Beverwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Beverwijk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37882> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "492352" ;
        min:soort "inleiding" ;
        min:volgnummer 718 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill296> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0036> ;
        schema:name "Beverwijk"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "233" ;
        schema:pagination "233-234" ;
        schema:text "De R.K. St.-Agathakerk (Breestraat 93) is een achtzijdige centraalbouw met koepeldak omringd door een kapellenkrans met koepels. Deze kerk verrees in 1921-'24 naar een op de Byzantijnse en vroeg-christelijke bouwkunst geïnspireerd ontwerp van J.Th.J. en P. Cuypers. In 1958 heeft men de hoofdkoepel voorzien van een torentje met carillon. Zowel in- als uitwendig is veel decoratief metselwerk toegepast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00719> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beverwijk"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Beverwijk" ;
        min:gemeenteInBoek "Beverwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beverwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beverwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Beverwijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 719 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0036> ;
        schema:name "Beverwijk"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "234" ;
        schema:pagination "234" ;
        schema:text "Het interieur wordt gedekt door een 24-delig meloengewelf en de kapellen hebben hyperbolische kruisgewelven. De inventaris is grotendeels ontworpen door L.T.C. Lourijsen. Het hoofdaltaar, de mozaïeken, de kruisweg en de gebrandschilderde ramen dateren uit 1925, de preekstoel uit 1931. Verder is er een uit de oude St.-Agathakerk (nu Herv. kerk) afkomstig vroeg-16de-eeuws reliëf in vroege renaissancestijl, voorstellende Maria met kind op de maansikkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00720> a min:Passage,
