        schema:pageStart "383" ;
        schema:pagination "383" ;
        schema:text "De kerk wordt geflankeerd door een pastorie (Ramen 2) met omlijste ingang en een kosterswoning (Ramen 6) uit 1769."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01286> a min:Passage,
