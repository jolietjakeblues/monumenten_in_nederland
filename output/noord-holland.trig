        min:volgnummer 1831 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0146> ;
        schema:name "Schardam (gemeente Zeevang)"@nl ;
        schema:pageEnd "487" ;
        schema:pageStart "487" ;
        schema:pagination "487" ;
        schema:text "De voorm. Herv. kerk (Schardam 27) is een eenbeukige kerk met vijfzijdige sluiting. Deze kerk in gotiserende stijl verving in 1662 (gevelsteen) een laatmiddeleeuwse kerk. Rond 1860 werden de westgevel en de dakruiter vernieuwd. In de dakruiter hangt een door Geert van Wou gegoten klok (1497)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01832> a min:Passage,
