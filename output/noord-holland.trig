        min:hoofdstuk "Steden, dorpen, monumenten › Aalsmeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Aalsmeer" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 252 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0007-01> ;
        schema:name "Aalsmeer"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "Het bijbehorende karmelietenklooster (Stommeerweg 15) is een drielaags gebouw met midden- en hoekrisalieten, gebouwd in 1920 met sobere expressionistische elementen naar plannen van P.J. Pieters. Verder is er de L-vormige R.K. lagere St.-Josephschool (Stommeerweg 11; circa 1930)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0007.php#7> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00253> a min:Passage,
