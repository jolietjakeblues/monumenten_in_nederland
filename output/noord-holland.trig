        min:soort "inleiding" ;
        min:volgnummer 2072 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0176> ;
        schema:name "Westerblokker (gemeente Hoorn)"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "De voorm. R.K. St.-Michaëlkerk (Westerblokker 44-46) is een driebeukige neoclassicistische kerk, gebouwd in 1852-'53 naar ontwerp van Th. Molkenboer. Na 1972 heeft men de kerk tot meubelzaal ingericht en het bovenste gedeelte van de geveltoren afgebroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0176.php> .

