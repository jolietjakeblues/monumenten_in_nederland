        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Holysloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Holysloot" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1243 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0082> ;
        schema:name "Holysloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "374" ;
        schema:pageStart "374" ;
        schema:pagination "374" ;
        schema:text "Dorp aan de Holysloter Die, ontstaan in de 13de eeuw als veenontginning. De dorpsbebouwing ontwikkelde zich aan weerszijden van een bochtig pad op de zuidoever van de Die. Dit aan de westzijde doodlopende pad liep aan de oostzijde door tot aan de Zuiderzee. In 1825 kreeg Holysloot een ontsluitingsweg richting Ransdorp, waartoe het vanaf 1811 behoorde. Die weg liep langs het in 1821 door A.F. Goudriaan ontworpen - maar in 1828 als idee verlaten - Kanaal door Waterland. Het dorp had te lijden van de watersnood van 1916. Holysloot is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0082.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01244> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Holysloot (gemeente Amsterdam)"@nl ;
        min:adres "Dorpsstraat 30",
            "Dorpsstraat 32" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Holysloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Holysloot" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1244 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill508> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0082> ;
        schema:name "Holysloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "375" ;
        schema:pageStart "374" ;
        schema:pagination "374-375" ;
        schema:text "De Herv. kerk (Dorpsstraat 30) ligt op een geringe verhoging en is een wit gepleisterde zaalkerk met geveltoren en ingangsportaal, gebouwd in 1846-'47 naar plannen van G. Bronke ter plaatse van een kerk uit 1613 (vervangen 1791). Bij een restauratie in 1995 is het in 1910 toegevoegde ingangsportaal vernieuwd. De kerk bevat een laat-18de-eeuwse preekstoel. Het orgel (1730) werd door H. van Giessen gebouwd voor de Waalse kerk te Haarlem en is via de Geref. kerk van Holysloot hierheen gekomen. De pastorie (Dorpsstraat 32) verrees in 1878 naar plannen van T.C. van der Sterr."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0082.php> .

