        schema:name "Gedenktekens"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Gedenktekens. In 1926 onthulde men het door T. Visser vervaardigde borstbeeld van mevr. M.A.D. van Reenen-Völter (Parkweg ong.). Ter ere van het 25-jarig bestaan van de badplaats kwam in 1931 het monument met lantaarn (Jac. Kalffweg ong.) tot stand naar ontwerp van M. Cijffers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

