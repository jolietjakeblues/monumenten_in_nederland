        schema:pageStart "319" ;
        schema:pagination "319" ;
        schema:text "Bij de kerk horen de met een ronde hoektoren uitgevoerde plebanie (Leidsevaart 146; 1895-'04), de via een gang met de plebanie verbonden sacristie (nu Schatkamer) en aan het uiteinde daarvan de halfrond gesloten voorm. doopkapel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0071.php> .

