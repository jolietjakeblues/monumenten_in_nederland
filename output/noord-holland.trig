        min:kern "Monnickendam" ;
        min:lemma "Sluizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16412> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30037" ;
        min:soort "lemma" ;
        min:volgnummer 1568 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0114> ;
        schema:name "Sluizen"@nl ;
        schema:pageEnd "440" ;
        schema:pageStart "440" ;
        schema:pagination "440" ;
        schema:text "Sluizen. De Middeldammersluis (Middendam ong.) [18] heeft een smalle doorlaat met hoge overkluizing. Een eerste houten sluis uit 1425 werd in 1620 in steen vervangen (gerenoveerd 1969). Midden 18de eeuw verrees het bijbehorende sluiswachtershuis (Zuideinde 2) met klokgevel en vaasvormige bekroning. De Grafelijkheidssluis of Kloosterdijksluis (bij Noordeinde 125) [19] bestaat uit een kleine schutsluis (1611), een schutsluis met ovale kolk (1884, gemoderniseerd 1932) en een spuisluis (circa 1932). Uit circa 1880 dateert de sluiswachterswoning (Noordeinde 117); de gietijzeren ophaalbrug (1884) werd gemaakt door ijzergieterij ‘De Prins van Oranje’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01569> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Monnickendam (gemeente Waterland) – Bruggen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Waterland" ;
        min:gemeenteInBoek "Waterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Monnickendam (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Monnickendam" ;
        min:lemma "Bruggen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1569 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0114> ;
        schema:name "Bruggen"@nl ;
        schema:pageEnd "440" ;
        schema:pageStart "440" ;
        schema:pagination "440" ;
        schema:text """Bruggen. Karakteristiek zijn de smalle houten ophaalbruggen met een enkele priem bij de Beestenmarkt, Nieuwe Zijds Burgwal-Herengracht en Schoolstraat-Weezenland en die met twee priemen bij de Haven-Brugstraat. De hefbrug over de trekvaart (Singel-Bernardlaan; circa 1930) is voorzien van vier staanders met katrolhuizen voor de stalen hefkabels.

De afwateringsgoten aan weerszijden van het Noordeinde en het Zuideinde zijn in de loop van de tijd ontstaan door de ophoging van de straat, voor het laatst in 1903-'04."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01570> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Monnickendam (gemeente Waterland) – Begraafplaatsen"@nl ;
        min:adres "Niesenoortsburgwal 38" ;
