        schema:pageEnd "502" ;
        schema:pageStart "502" ;
        schema:pagination "502" ;
        schema:text "De voorm. pastorie (Castricummerweg 2-4) stamt uit 1659 en is een U-vormig gebouw voorzien van houten topgevels met geschulpte windveren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01935> a min:Passage,
