        schema:name "Obdam"@nl ;
        schema:pageEnd "460" ;
        schema:pageStart "460" ;
        schema:pagination "460" ;
        schema:text "De Herv. kerk (Dorpsstraat 38), een zaalkerk met houten geveltoren en eclectische details, werd gebouwd in 1881-'82 ter plaatse van een kerk uit 1803."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01662> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Obdam"@nl ;
        min:adres "Dorpsstraat 151" ;
