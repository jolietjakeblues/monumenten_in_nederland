        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0164> ;
        schema:name "Ursem (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "504" ;
        schema:pageStart "504" ;
        schema:pagination "504" ;
        schema:text "De stolpboerderij Noorddijkerweg 11 werd mogelijk gebouwd rond 1800 en heeft middenvoor een houten klokgevel. De buitenmuren zijn in de tweede helft van de 19de eeuw vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0164.php> .

