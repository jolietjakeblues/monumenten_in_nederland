        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerblokker (gemeente Hoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westerblokker" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2070 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0176> ;
        schema:name "Westerblokker (gemeente Hoorn)"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning. Het hier in de 14de eeuw gestichte regulierenklooster Nieuwlicht werd in 1572-'73 afgebroken. Na de opheffing van de gemeente Blokker (1979) is het langgerekte lintdorp opgeslokt door de uitbreidingswijken van Hoorn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02071> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerblokker (gemeente Hoorn)"@nl ;
        min:adres "Westerblokker 105" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
