        min:kern "Amsterdam-Nieuwendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35204> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "6695" ;
        min:soort "inleiding" ;
        min:volgnummer 575 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0019> ;
        schema:name "Amsterdam-Nieuwendam (gemeente Amsterdam)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "De Doopsgez. vermaning (Meerpad 9) is een kleine houten zaalkerk met boogramen, omlijste ingang en een frontonvormige gevelbekroning. Deze kerk uit 1843 is bij een restauratie in 1970 (H.F. Rappange) een travee dieper herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00576> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Nieuwendam (gemeente Amsterdam)"@nl ;
        min:adres "Brede Kerkepad 8" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
