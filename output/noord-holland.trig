        min:adres "Barentszstraat 13" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Texel" ;
        min:gemeenteInBoek "Texel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Texel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudeschild (gemeente Texel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudeschild" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16001> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "35173" ;
        min:soort "lemma" ;
        min:volgnummer 1738 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill660> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0136> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "470" ;
        schema:pageStart "470" ;
        schema:pagination "470" ;
        schema:text """Woonhuizen. Voorbeelden van eenlaagse loodswoningen met een houten voorschot zijn De Ruyterstraat 45, 46, 101, 110 en 135; in opzet zouden ze uit de 18de eeuw kunnen dateren. De Ruyterstraat 85 bezit een 19de-eeuws ingezwenkt houten voorschot. Van een ingezwenkte stenen lijstgevel voorzien is Het Buurtje 5 (derde kwart 19de eeuw). De notabelenwoning De Ruyterstraat 63 werd rond 1910 gebouwd en de woonhuizen Loodssingel 1-11 zijn een voorbeeld van volkshuisvesting uit 1935.

De voorm. wierschuur (Barentszstraat 13) is een langgerekte, vermoedelijk vroeg-20ste-eeuwse, houten schuur met inwendig een uit scheepshout samengestelde draagconstructie.

Het forse pakhuis Haven 8 kwam in 1903 tot stand als drielaags graanpakhuis voor de firma C.R. Keijser & Co., met hergebruik van midden-18de-eeuwse balken en standvinken. Bij de verbouwing tot restaurant in 1995 is de kapverdieping iets verhoogd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01739> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudeschild (gemeente Texel) – Windmolen"@nl ;
        min:adres "Barentszstraat 19",
            "Barentszstraat 21",
            "Barentszstraat 23" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Texel" ;
        min:gemeenteInBoek "Texel" ;
