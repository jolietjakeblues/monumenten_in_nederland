        schema:name "Wijdenes (gemeente Drechterland)"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "530" ;
        schema:pagination "530-531" ;
        schema:text "Het voorm. raadhuis (Kerkbuurt 68) is een blokvormig tweelaags pand uit circa 1880 met balkon, dakkapel en eclectische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0184.php> .

