        schema:pageEnd "375" ;
        schema:pageStart "375" ;
        schema:pagination "375" ;
        schema:text "De voorm. Geref. kerk (Dorpsstraat 37) is een eenvoudige zaalkerk met rationalistische details, gebouwd in 1916 naar ontwerp van P. Slagmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0082.php> .

