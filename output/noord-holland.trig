        min:kern "Overveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76707>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76708> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "405078",
            "9745" ;
        min:soort "inleiding" ;
        min:volgnummer 1756 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0139> ;
        schema:name "Overveen (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekt Ontvangen (Korte Zijlweg 5) is een driebeukige pseudobasilicale kruiskerk met vijfzijdig gesloten koor. De toren van drie geledingen wordt bekroond door een smallere klokkenverdieping met ingezwenkte steunberen en een ingesnoerde naaldspits. Deze neogotische kerk verrees in 1855-'56 ter vervanging van een 17de-eeuwse schuurkerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01757> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overveen (gemeente Bloemendaal)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bloemendaal" ;
        min:gemeenteInBoek "Bloemendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overveen (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Overveen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1757 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0139> ;
        schema:name "Overveen (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "Het interieur wordt gedekt door gestucte houten kruisgewelven en is voorzien van bundelpijlers met stucwerkkapitelen. Tot de inventaris behoren een door L. Veneman vervaardigd zandstenen hoofdaltaar (1856), een Ypma-orgel (1866-'67), enkele marmeren beelden van atelier Mengelberg en een door J.H. Brom geleverde koperen doopvont (1887-'88)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01758> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Overveen (gemeente Bloemendaal)"@nl ;
        min:adres "Korte Zijlweg 7",
            "Korte Zijlweg 9" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bloemendaal" ;
        min:gemeenteInBoek "Bloemendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Overveen (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Overveen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17376> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511143" ;
        min:soort "inleiding" ;
        min:volgnummer 1758 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0139> ;
        schema:name "Overveen (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "472" ;
        schema:pageStart "472" ;
        schema:pagination "472" ;
        schema:text "Op het kerkhof bevindt zich een neogotische bisschoppelijke grafkapel van het bisdom Haarlem (1864), postuum uitgevoerd naar een ontwerp van Th. Molkenboer. De kapel is voorzien van overhoekse steunberen en een kanteel-achtige bekroning. Bij de kerk staan verder een eclectische pastorie (Korte Zijlweg 7; circa 1860) en het voorm. Mariagesticht (Korte Zijlweg 9). Dit neogotische zusterhuis met school uit circa 1890 is rond 1925 uitgebreid met een tweelaags schoolgebouw, en is nu in gebruik als muziekschool."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01759> a min:Passage,
