        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kolhorn (gemeente Niedorp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Kolhorn" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1376 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill558> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0094> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "405" ;
        schema:pageStart "405" ;
        schema:pagination "405" ;
        schema:text "Woonhuizen. Aan de Oude Streek staan overwegend laat-18de-eeuwse of 19de-eeuwse visserswoningen met gepleisterde begane grond en een houten voorschot met luik, zoals Oude Streek 30, 42, 46 en 48. Vergelijkbare visserswoningen zijn Keern 1 en Westfriesedijk 72a (circa 1840). De huizen aan de Nieuwe Streek hebben alle een overtuin aan de waterkant. Voorbeelden van diepe huizen met een houten voorschot zijn hier Nieuwe Streek 8 (circa 1800), 28, 32 en 58. Midden-19de-eeuws zijn de dwarse eenlaagspanden Nieuwe Streek 20-24. De aan een voortuin terugliggende eclectische notabelenwoning Nieuwe Streek 54 met flauw hellend dak werd rond 1870 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0094.php> .

