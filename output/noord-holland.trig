        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "515154",
            "515155",
            "515157" ;
        min:soort "lemma" ;
        min:volgnummer 558 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0017> ;
        schema:name "Amstelrust"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Amstelrust (Amsteldijk 319) [366], gelegen nabij de Rozenoordbrug aan de Amstel, is een nagenoeg vierkant buitenhuis met omlopend schilddak en hoekschoorstenen. Het werd rond 1740 gebouwd en vervolgens verbouwd in 1830 en gerestaureerd omstreeks 1930. Het rijke smeedijzeren toegangshek stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00559> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 559 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Stadsdeel van Amsterdam, ontstaan in de 15de eeuw als dorp op de Waterlandse Zeedijk en nu het westelijke deel van Amsterdam-Noord. In de polder achter de zeedijk verrees een eerste kerk en aan de dijk bouwde men houten huizen. Van een smalle landtong in het IJ - de Volewijkslanden - vertrok de veerpont naar Amsterdam (sinds 1842 stoompont). Over deze landtong werd in 1622 een weg naar Purmerend aangelegd en parallel hieraan groef men in 1660 een trekvaart, die bij Buiksloot de zeedijk passeerde. In 1825 volgde de verbreding van deze trekvaart tot het Noordhollands Kanaal. De Buiksloterham, ten westen van de Volewijkslanden, werd in 1848-'50 drooggelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00560> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 560 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Ten behoeve van de uitbreiding van Amsterdam stelde A. Keppler in 1914 een plan voor 3500 woningen in dit gebied op. In 1921 werd de gemeente Buiksloot door Amsterdam geannexeerd. De Buiksloterham verdeelde men in een oostelijke strook (Florapark, 1920), een middendeel met geconcentreerde woningbouw (Van der Pekbuurt, 1918-'20 en 1922-'26) en een westelijk gedeelte met havens en industrie. Al in 1919-'24 was verder noordwestelijk het tuindorp Oostzaan ontstaan bij de daar gevestigde N.D.S.M.-werf. Na 1921 groeide Buiksloot aan Nieuwendam vast en door forse uitbreidingen na de Tweede Wereldoorlog vormden deze kernen uiteindelijk Amsterdam-Noord."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00561> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:adres "Buiksloterkerkpad 10" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30952> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "6607" ;
        min:soort "inleiding" ;
        min:volgnummer 561 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill251> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "207" ;
        schema:pagination "207-208" ;
        schema:text "De Herv. kerk (Buiksloterkerkpad 10) is een eenbeukige kerk met vijfzijdig gesloten koor, kleine uitbouwen en bij de voorgevel een houten dakruiter. Deze kerk met naar onder uitzwenkende steunberen kwam in 1709-'10 tot stand met restanten van een kerk uit 1609, die de laat-middeleeuwse kerk ter plaatse had vervangen. De kerk onderging herstel in 1840 en een restauratie in 1961-'65."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00562> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 562 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf met trekbalken en in de uitbouwen twee rijk gesneden korbeelstellen (circa 1609). Tot de inventaris behoren een preekstoel (midden 17de eeuw), een doophek (1728) en doopboog (1788), en een door H. ter Hart gebouwd orgel (1858)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00563> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:adres "Hagedoornplein 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75089> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "498725" ;
        min:soort "inleiding" ;
        min:volgnummer 563 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "De voorm. R.K. St.-Ritakerk (Hagedoornplein 2), een brede basilicale kerk met apsis en toren, werd in 1921-'22 gebouwd naar een traditionalistisch ontwerp met rationalistische details van A.J. Kropholler. Bij het herstel van de oorlogsschade (1943) in 1946-'47 (C.M. van Moorsel) heeft men het schip verlengd en de bestaande toren vervangen door de huidige, niet afgebouwde, zware toren. In 1973 is de westelijke helft van de kerk verbouwd tot openbare bibliotheek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00564> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        min:adres "Buiksloterweg 95",
            "Wingerdweg 4" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75085>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75087>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75088> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "498726",
            "498727",
            "498729" ;
        min:soort "inleiding" ;
        min:volgnummer 564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Amsterdam-Buiksloot (gemeente Amsterdam)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Eveneens ontworpen door Kropholler zijn de pastorie (Buiksloterweg 95; 1921-'22) en het ten behoeve van de dominicanessen van Voorschoten toegevoegde St.-Rosaklooster (Wingerdweg 4; 1926-'27). Zij verzorgden het onderwijs in de bijbehorende bewaarschool en lagere school (jongens en meisjes). Het zusterhuis met kapel en de kloosterhof zijn na beschadiging in 1943 eveneens hersteld (C.M. van Moorsel)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00565> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam) – Overige kerken"@nl ;
        min:adres "Buiksloterweg 9b",
            "Kamperfoelieweg 211",
            "Kometensingel 150",
            "Kometensingel 56",
            "Melkweg 16",
            "Mosplein 40",
            "Plejadenplein 42" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Buiksloot (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Buiksloot" ;
        min:lemma "Overige kerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27701> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "508529" ;
        min:soort "lemma" ;
        min:volgnummer 565 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill252>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill253> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0018> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text """Overige kerken. Zaalkerken in traditionalistische vormen zijn de R.K. St.-Stephanuskerk (Kamperfoelieweg 211; 1932-'33, K.P. Tholens), de kerk van de Geref. Gemeente (Melkweg 16; 1950-'51, J. Verkerk) en de sobere (Geref.) Maranathakerk (Mosplein 40; 1952, B.W. Plooy en N. Lansdorp); de laatste dient nu als Koptische kerk van de Moeder Gods. Naoorlogs is ook de met romaanse elementen uitgevoerde driebeukige basilicale R.K. Allerheiligst Sacramentskerk (Kometensingel 150; 1951-'52, A. Evers en G.J.M. Sarlemijn). Een moderne zaalkerk met onderbouw en glas-in-betonvensters is de (Herv.) Bethelkerk (Plejadenplein 42; 1957-'59, S. van Woerden en D. Slebos). De voorm. (Geref.) Regenboogkerk (Kometensingel 56; 1963, D. Egberts) wordt nu gebruikt door de Pinkstergemeente.

De voorm. politiepost (Buiksloterweg 9b), een vierkant houten pand met tentdak, verrees in 1915-'16 naar plannen van de Dienst Publieke Werken en bevatte oorspronkelijk een agentenkamer, een kamer voor de postcommandant, een fietsenbergplaats en twee cachotten."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00566> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Buiksloot (gemeente Amsterdam) – Scholen"@nl ;
        min:adres "Meteorensingel 38" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
