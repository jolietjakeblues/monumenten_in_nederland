        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "Tolhuizen. Bij het dorp staan de voormalige 19de-eeuwse tolhuisjes Stichtse Kade 48 (gepleisterd) en Noordereinde 64 (circa 1890). Het laatste is tot circa 1930 in bedrijf gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0066.php> .

