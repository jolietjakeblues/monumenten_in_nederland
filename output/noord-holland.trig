        schema:name "Westerblokker (gemeente Hoorn)"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Op het kerkhof bevinden zich onder meer het graf van pastoor L.J. Wisse († 1888), een priestergraf met kruis (1919) en een H. Hartbeeld (1922; J.P. Maas). Op enige afstand staat de moderne R.K. St.-Michaelkerk (Plantage 29; 1972, J.G. de Groot) met vrijstaande stalen klokkentoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0176.php> .

