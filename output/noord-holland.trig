            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33634>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42840> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38644",
            "38645",
            "38659" ;
        min:soort "lemma" ;
        min:volgnummer 2047 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill745> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0173> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "520" ;
        schema:pageStart "520" ;
        schema:pagination "520" ;
        schema:text "Windmolens. De met riet gedekte molen 't Haantje (Korte Stammerdijk 17) heeft een hoog houten onderhuis, een brede stelling en aan weerszijden aangebouwde woningen met schilddaken. Deze wipkorenmolen is in 1820 gebouwd met onderdelen van een oudere wipmolen. Aan de Utrechtseweg staan twee met riet gedekte achtkante stellingmolens op veldmuren. Korenmolen De Vriendschap (Utrechtseweg 11a) stamt uit 1694, maar werd na brand (1899) herbouwd in 1900 met onderdelen van een Amsterdamse molen. De uit circa 1690 daterende molen De Eendracht (Utrechtseweg 13) heeft men in 1815 verbouwd tot houtzaagmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02048> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weesp – Van Houtenfabriek"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
