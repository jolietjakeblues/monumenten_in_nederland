        min:hoofdstuk "Steden, dorpen, monumenten › Aalsmeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Aalsmeer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51004> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "528468" ;
        min:soort "inleiding" ;
        min:volgnummer 249 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0007-01> ;
        schema:name "Aalsmeer"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "De Oud-Kath. kerk (Oosteinderweg 394), een neoclassicistische zaalkerk voorzien van een geveltoren met houten lantaarn en spits, werd gebouwd in 1860-'61. Achter de kerk ligt het enige Oud-Kath. kerkhof van Nederland. De pastorie (Oosteinderweg 392) is een blokvormig herenhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0007.php#7> .

