        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0056> ;
        schema:name "Dirkshorn (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De Geref. kerk (Raadhuisstraat 80) is een zaalkerk met terzijde geplaatste toren, gebouwd in 1919-'20 naar een ontwerp met rationalistische details van J. Groot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0056.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00901> a min:Passage,
