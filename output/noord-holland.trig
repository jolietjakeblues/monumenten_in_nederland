        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Benningbroek (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Benningbroek" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 679 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0032> ;
        schema:name "Benningbroek (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Het kerkhof bevat onder meer een priesterzerk met gotisch schrift (1555), een zerk met aalmoezen schenkende ruiterfiguur (1628) en een gebroken zuil op postament voor C. Donker († 1891) en H.A. Donker-Boon († 1888)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0032.php> .

