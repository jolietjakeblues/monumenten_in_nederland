        schema:name "Hoogwoud (gemeente Opmeer)"@nl ;
        schema:pageEnd "378" ;
        schema:pageStart "378" ;
        schema:pagination "378" ;
        schema:text "De voorm. openbare lagere school (Burg. Hoogenboomlaan 9) is een tweeklassige middengangschool uit circa 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01268> a min:Passage,
            schema:CreativeWork ;
