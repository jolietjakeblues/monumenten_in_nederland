        min:kern "Westbeemster" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2064 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0175> ;
        schema:name "Westbeemster (gemeente Beemster)"@nl ;
        schema:pageEnd "522" ;
        schema:pageStart "522" ;
        schema:pagination "522" ;
        schema:text "Dorp, ontstaan na de droogmaking van de Beemster in 1612 langs de Jisperweg. In de 19de eeuw werd het een katholieke enclave."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02065> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westbeemster (gemeente Beemster)"@nl ;
        min:adres "Jisperweg 55" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Beemster" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westbeemster (gemeente Beemster)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Westbeemster" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68035> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511342" ;
        min:soort "inleiding" ;
        min:volgnummer 2065 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0175> ;
        schema:name "Westbeemster (gemeente Beemster)"@nl ;
        schema:pageEnd "522" ;
        schema:pageStart "522" ;
        schema:pagination "522" ;
        schema:text "De R.K. St.-Johannes de Doperkerk (Jisperweg 55), een basilicale kruiskerk, heeft een driezijdig gesloten koor en een toren van vier geledingen met frontalen en naaldspits. Deze neogotische kerk verrees in 1878-'79 naar ontwerp van Y. Bijvoets en heeft een opvallende gedrukte lichtbeuk met kleine vensters. Het met bundelpijlers en stenen kruisribgewelven uitgevoerde interieur bevat een rijk gesneden neogotisch hoofdaltaar en zijaltaren uit de bouwtijd en een door de Gebr. Franssen gebouwd orgel (1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02066> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westbeemster (gemeente Beemster)"@nl ;
        min:adres "Jisperweg 56",
            "Jisperweg 57" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Beemster" ;
