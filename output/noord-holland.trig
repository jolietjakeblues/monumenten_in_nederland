        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill650> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0131> ;
        schema:name "Opperdoes (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf met trekbalken. In de sluiting bevindt zich een piscina-nis. Tot de inventaris behoren een rijk gesneden preekstoel (1688, P. van Petten), een tekstbord (1701), een doophek (1752) met koperen doopboog (1753) en een door K.P. van Ingen gebouwd orgel (1874)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0131.php> .

