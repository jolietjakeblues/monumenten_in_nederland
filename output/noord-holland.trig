        min:soort "inleiding" ;
        min:volgnummer 1060 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0070> ;
        schema:name "Grosthuizen (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Het voorm. raadhuis van de in 1979 opgeheven gemeente Avenhorn (Grosthuizen 68), een tweelaags pand met middenrisaliet en gebosseerde onderbouw, kwam in 1878 tot stand naar ontwerp van A.C. Bleijs. Op de verdieping met balkon bevindt zich de raadzaal. Het gebouw is in 1964 inwendig gemoderniseerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01061> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grosthuizen (gemeente Wester-Koggenland) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Koggenland" ;
        min:gemeenteInBoek "Wester-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Koggenland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grosthuizen (gemeente Wester-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grosthuizen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1061 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill414> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0070> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "308" ;
        schema:pagination "308-309" ;
        schema:text "Boerderijen. Een waarschijnlijk 17de-eeuwse oorsprong heeft de met een houten voorschot uitgevoerde stolpboerderij Grosthuizen 52. Bij een verbouwing in 1820 is waarschijnlijk de koehuisstaart aangebouwd. Binnen dateert de betegelde schouw met smuiger uit die tijd. Bij de stolpboerderij Grosthuizen 53 is het jaartal 1820 aangebracht op enkele balken van de draagconstructie. Een verbouwing en gevelbepleistering volgden rond 1870. Eclectische details en gepleisterde gebosseerde hoeklisenen bezit de kop-rompboerderij Grosthuizen 54 (circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01062> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grosthuizen (gemeente Wester-Koggenland) – Scharwoude"@nl ;
        min:adres "Scharwoude 13",
            "Scharwoude 9",
            "Stationsweg 4" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Koggenland" ;
        min:gemeenteInBoek "Wester-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Koggenland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grosthuizen (gemeente Wester-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grosthuizen" ;
        min:lemma "Scharwoude" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76723>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76724> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "502474",
            "502480" ;
        min:soort "lemma" ;
        min:volgnummer 1062 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0070> ;
        schema:name "Scharwoude"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "309" ;
        schema:pagination "309" ;
        schema:text "Scharwoude. Dit dorp ligt aan het oosteinde van de veenontginning van Grosthuizen. Aan de spoorlijn Zaandam-Hoorn kwam in 1882-'83 voor de Staatsspoorwegen het voorm. station Avenhorn (Stationsweg 4) tot stand, waarschijnlijk naar ontwerp van M.A. van Wadenoyen. Dit gepleisterde gebouw met neorenaissance-details bestaat uit een tweelaags hoofdblok geflankeerd door lagere zijvleugels van verschillende lengte. De voorm. Herv. kerk (Scharwoude 9) is een driezijdig gesloten zaalkerk uit 1890-'92 naar ontwerp van A. Stoutjesdijk. In de geveltoren met ingesnoerde spits hangt een door Cornelis Ammeroy gegoten klok (1601). De voorm. openbare lagere school (Scharwoude 13) is een drieklassige school uit 1883 met naastgelegen onderwijzerswoning naar ontwerp van T.C. van der Sterr. Met de bouw van een garage kwam het rond 1925 in gebruik bij ‘J. Ooms & Zn. Wegenbouw’, een in 1913 gesticht bedrijf dat zich na 1922 op de wegenbouw toelegde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01063> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haarlem"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
