        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landsmeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Landsmeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Landsmeer" ;
        min:lemma "Overige kerken" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1441 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0101> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "413" ;
        schema:pageStart "413" ;
        schema:pagination "413" ;
        schema:text "Overige kerken. De voorm. Geref. kerk Noordeinde 124 (circa 1880), een houten zaalkerk met spitsboogvensters, huisvest nu een winkel. In 1927 werd de Geref. kerk Calkoenstraat 12a in gebruik genomen. Deze zaalkerk met toren vertoont expressionistische details. Aan de achterzijde staat een verenigingsgebouw (1967). Uitgevoerd in de vorm van een stolpboerderij is de R.K. De Goede Herderkerk (Zuideinde 34; 1972-'73, H.J. van den Bogaard)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01442> a min:Passage,
