        min:kern "Ursem" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27286>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55180> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38776",
            "502535" ;
        min:soort "inleiding" ;
        min:volgnummer 1953 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0164> ;
        schema:name "Ursem (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "504" ;
        schema:pageStart "504" ;
        schema:pagination "504" ;
        schema:text "De Herv. kerk (Kerkpad 4) is een zaalkerk met blokbepleistering, lisenen en rondboogvensters. In de houten dakruiter boven de voorgevel hangt een door Johan Nicolaas Derck gegoten klok (1733). Deze neoclassicistische kerk kwam in 1846-'47 tot stand naar ontwerp van E. de Kruyff ter vervanging van een kerk uit 1659. Het interieur bevat een door M. Maarschalkerweerd gebouwd orgel (1894) met neo-Lodewijk XVI-kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01954> a min:Passage,
