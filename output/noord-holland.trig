        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijdenes (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wijdenes" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2122 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0184> ;
        schema:name "Wijdenes (gemeente Drechterland)"@nl ;
        schema:pageEnd "530" ;
        schema:pageStart "530" ;
        schema:pagination "530" ;
        schema:text "Dorp, ontstaan in de 12de eeuw als veenontginning. Nabij de huidige zuidpunt van de noord-zuid gerichte ontginningsas (Zuideruitweg) verrees in 1282 een burcht die in 1296 al weer werd gesloopt. Bij de Kerkbuurt vormde zich een bebouwingsconcentratie. Na de Tweede Wereldoorlog is daar een kleine woonbuurt ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02123> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wijdenes (gemeente Drechterland)"@nl ;
        min:adres "Kerkbuurt 72" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wijdenes (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wijdenes" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28190>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30637> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "37146",
            "37147" ;
        min:soort "inleiding" ;
        min:volgnummer 2123 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0184> ;
        schema:name "Wijdenes (gemeente Drechterland)"@nl ;
        schema:pageEnd "530" ;
        schema:pageStart "530" ;
        schema:pagination "530" ;
        schema:text "De voorm. Herv. kerk (Kerkbuurt 72) is een eenbeukige kerk met een toren van drie geledingen met balustrade en achtzijdige spits. De laat-gotische toren verrees rond 1500; spits en balustrade dateren van een verbouwing in 1893. In de toren hangt een door Henricus Nieman gegoten klok (1617). De bijbehorende kerk werd na brand (1616) herbouwd in 1619. Vervolgens heeft men in 1839 het schip herbouwd en na een verdere verbouwing in 1857 volgde in 1863 de toevoeging van een zuidelijke dwarsarm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02124> a min:Passage,
