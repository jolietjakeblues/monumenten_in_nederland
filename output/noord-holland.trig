        schema:name "Ankeveen (gemeente Wijdemeren)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Herv. kerk (Stichts End 57), een zaalkerk met aangebouwde consistorie, kwam in 1911-'12 tot stand naar een ontwerp met rationalistische details van J. van Dillewijn. In de overhoekse dakruiter hangt een door de Gebr. Van Bergen gegoten klok (1938)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0024.php> .

