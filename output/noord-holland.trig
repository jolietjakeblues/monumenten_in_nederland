        min:soort "inleiding" ;
        min:volgnummer 1058 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0070> ;
        schema:name "Grosthuizen (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Dorp, ontstaan in de 13de eeuw bij de ontginning van wat toen de Veenhoop werd genoemd. Tussen Avenhorn en Scharwoude ontwikkelde zich een langgerekte lintbebouwing, die in de loop van de tijd enigszins is verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01059> a min:Passage,
