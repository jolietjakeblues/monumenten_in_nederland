        min:volgnummer 2095 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0180> ;
        schema:name "Westzaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "526" ;
        schema:pageStart "526" ;
        schema:pagination "526" ;
        schema:text "Het interieur wordt gedekt door wit gepleisterde houten tongewelven. Tot de inventaris behoren een preekstoel op gebeeldhouwd voetstuk (pelikaan met jongen; circa 1740) en een door de firma Flaes en Brünjes gebouwd orgel (1866, gerestaureerd 2002)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0180.php> .

