        min:gemeenteInBoek "Wieringermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middenmeer (gemeente Wieringermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Middenmeer" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1541 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill601> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0112> ;
        schema:name "Middenmeer (gemeente Wieringermeer)"@nl ;
        schema:pageEnd "433" ;
        schema:pageStart "433" ;
        schema:pagination "433" ;
        schema:text "Dorp in de Wieringermeer, gesticht in 1933 aan de oostzijde van de Westfriesche Vaart en de Wieringerwerfvaart. Dit door M.J. Granpré Molière ontworpen dorp ontving in 1941 zijn huidige naam. De rechthoekige dorpskern tussen Westfriesche Vaart en Brugstraat kreeg een centraal gelegen sportterrein, een kerk aan de westpunt en winkels aan de Brugstraat (westzijde). Langs de Wieringerwerfvaart werd een industrieterrein ingericht. Na de inundatie in 1945 volgde herbouw en een bescheiden dorpsuitbreiding in oostelijke en zuidelijke richting. Alle architectuur is traditionalistisch van vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01542> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middenmeer (gemeente Wieringermeer) – Kerken"@nl ;
        min:adres "Brugstraat 30",
            "Kerkring 1",
            "Prof. Ter Veenweg 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Wieringermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middenmeer (gemeente Wieringermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Middenmeer" ;
        min:lemma "Kerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50547> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "516093" ;
        min:soort "lemma" ;
        min:volgnummer 1542 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0112> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "433" ;
        schema:pageStart "433" ;
        schema:pagination "433" ;
        schema:text "Kerken. De nu door de Volle Evang. gemeente gebruikte Herv. kerk (Kerkring 1) is een zaalkerk met haaks aangebouwd vergaderlokaal en in de binnenhoek een rijzige toren met ingesnoerde spits. G. van Hoogevest leidde de bouw in 1933-'34 en het herstel na de oorlog. Ter vervanging van hun door de inundatie verwoeste voorgangers verrezen de huidige Geref. kerk (Prof. Ter Veenweg 2; 1949, H. Eldering) - een brede zaalkerk met portaal, kleine geveltoren en glas-in-betonramen - en de in vorm aan een stolpboerderij verwante vierkante R.K.H. Maria Sterre der Zeekerk (Brugstraat 30; 1953-'54, A.W.P. Thunissen) met lantaarn en hoekpilonen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01543> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middenmeer (gemeente Wieringermeer) – Scholen"@nl ;
        min:adres "Breestraat 22",
            "Kerkhoflaan 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Wieringermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middenmeer (gemeente Wieringermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Middenmeer" ;
        min:lemma "Scholen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1543 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0112> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "433" ;
        schema:pageStart "433" ;
        schema:pagination "433" ;
        schema:text "Scholen. De R.K. lagere school (Kerkhoflaan 2), nu ‘Titus Brandsma school’, werd in 1933 gebouwd naar ontwerp van P.W. Vlaming als een drieklassige school met aangebouwd portiek. De openbare lagere school (Breestraat 22) is een sobere gangschool uit 1947. Woonhuizen. Uit de jaren dertig dateren de eenvoudige eengezinswoningen Torenstraat 7-9 (1933) en Havenstraat 1-26 (1935), de dubbele middenstandswoningen Breestraat 5-23 (1936), met aangebouwde schuurtjes, en de vrijstaande woning Sportweg 1 (circa 1935). Naoorlogs is de villa Brugstraat 40 (1946)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01544> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middenmeer (gemeente Wieringermeer) – Bruggen"@nl ;
        min:adres "Breestraat 20",
            "Brugstraat 2",
            "Groetweg 2",
            "Kerkhoflaan 4",
            "Torenstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Wieringermeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middenmeer (gemeente Wieringermeer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Middenmeer" ;
        min:lemma "Bruggen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1544 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill602> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0112> ;
        schema:name "Bruggen"@nl ;
        schema:pageEnd "434" ;
        schema:pageStart "433" ;
        schema:pagination "433-434" ;
        schema:text """Bruggen. Uit 1931 dateren de brug over de Wieringerwerfvaart (bij Brugstraat 2) en de Schagerbrug over de Slotervaart (Schagerweg ong.). Beide zijn stalen ophaalbruggen in vakwerk met klinknagels.

Het trafohuisje (Torenstraat 2), een klein rechthoekig gebouw met zadeldak, is in 1941 gebouwd naar ontwerp van J.B. van Loghem.

De garage met werkplaats Prof. Ter Veenweg 63 dateert uit 1946 en bestaat uit een woonhuis met naastgelegen kantoor en werkplaats.

De telefooncentrale (Breestraat 20) is in 1950 tot stand gekomen met een hoofdgebouw en een aangebouwd lager dienstgedeelte.

De Alg. begraafplaats (Kerkhoflaan 4), gesticht rond 1935, heeft een - later vergrote - aula met traditionalistische en functionalistische elementen (circa 1950).

De Westfriese Sluis (bij Groetweg 2), gelegen ten westen van Middenmeer in de Westfriesche Vaart, is een enkele sluis uit 1931 met basculebrug en slagbomen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01545> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Midwoud (gemeente Noorder-Koggenland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
