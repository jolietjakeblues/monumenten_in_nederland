        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen aan Zee (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen aan Zee" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 701 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill292> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0034> ;
        schema:name "Bergen aan Zee (gemeente Bergen)"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Badplaats in de duinen, ontstaan in 1906 als particuliere stichting van het echtpaar J. van Reenen en M.A.D. van Reenen-Völter, die daartoe in 1908 de Bouw-Exploitatie-Maatschappij oprichtten (onteigend 1945). De Zeeweg kwam in 1905-'06 tot stand naar plannen van L.A. Springer. Het hotel ‘Nassau-Bergen’ (1908) en de villa ‘Ulysses’ van mevrouw Van Reenen werden in 1943 met de andere boulevardbebouwing gesloopt op last van de Duitsers. De wederopbouw is uitgevoerd naar plannen van W. Bruin en J.H. Groenewegen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00702> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen aan Zee (gemeente Bergen)"@nl ;
        min:adres "Kerkstraat 20" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen aan Zee (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen aan Zee" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 702 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0034> ;
        schema:name "Bergen aan Zee (gemeente Bergen)"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Het Vredeskerkje (Kerkstraat 20), een met riet gedekte zaalkerk voorzien van een half-ingebouwde toren met tentdak, verrees in 1917-'18 als algemeenchristelijke kerk naar plannen van H.L. baron Taets van Amerongen en P. Elders. De naam houdt verband met de geïnterneerden in Bergen gedurende de Eerste Wereldoorlog. In de toren hangt een door Gerrit Bakker gegoten klok (1783). De preekstoel is versierd met werk van de Belg A. Termote, de Duitse L. Benter, de Engelsman S. Ward en de Nederlander E. Jacobs. De gebrandschilderde ramen zijn van W. Bogtman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00703> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen aan Zee (gemeente Bergen)"@nl ;
        min:adres "Elzenlaan 2",
            "Elzenlaan 4" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen aan Zee (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen aan Zee" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20256> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "520742" ;
        min:soort "inleiding" ;
        min:volgnummer 703 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0034> ;
        schema:name "Bergen aan Zee (gemeente Bergen)"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "231" ;
        schema:pagination "231-232" ;
        schema:text "De villa ‘Russenduin’ (Elzenlaan 2) werd in 1916-'17 gebouwd naar een ontwerp met rationalistische elementen van A.D.N. van Gendt voor de Baarnse theeimporteur A. Janssen. Het kasteelachtige gebouw heeft een veelhoekige toren en een vierkante uitzichttoren, die door de Duitsers werd verhoogd (circa 1943). Van 1930 tot 1972 diende het als ‘Bio-vakantieoord’ en beschikte het over een eigen zwembad. Van Gendt ontwierp ook de U-vormige garage (Elzenlaan 4)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00704> a min:Passage,
