        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Edam-Volendam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warder (gemeente Zeevang)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warder" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2006 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0170> ;
        schema:name "Warder (gemeente Zeevang)"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "512" ;
        schema:pagination "512-513" ;
        schema:text "De openbare lagere school (Warder 127) werd in 1885 gebouwd als een L-vormige school met torenachtig volume in de binnenhoek. Het wit gepleisterde pand is rond 1920 verbouwd. Boerderijen. Een houten middengeveltop hebben de stolpboerderijen Warder 63 (circa 1850) en Warder 112 (1872). De laatste heeft ook een markante, rond gemetselde schoorsteen, net als de stolpboerderij Warder 134 (1884)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02007> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warder (gemeente Zeevang) – Woonhuizen"@nl ;
        min:adres "IJsselmeerdijk 4" ;
