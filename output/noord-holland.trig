        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stede_Broec_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grootebroek (gemeente Stede Broec)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grootebroek" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1047 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0068> ;
        schema:name "Grootebroek (gemeente Stede Broec)"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Op het kerkhof bevindt zich een kruisweggroep (1915) met priestergraf. De pastorie (Zesstedenweg 158) is uit 1923."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01048> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grootebroek (gemeente Stede Broec)"@nl ;
        min:adres "Zesstedenweg 159" ;
