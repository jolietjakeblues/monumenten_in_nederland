        min:kern "Zunderdorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2255 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0197> ;
        schema:name "Zunderdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "554" ;
        schema:pagination "554" ;
        schema:text "Dorp, ontstaan in de 14de eeuw als veenontginning. Ten westen van de kerk ontwikkelde zich een kleine dorpskern met haakse straten, die de oorspronkelijke verkaveling volgen. Aan de noordzijde vormde zich het bescheiden lintgehucht 't Nopeind. Zunderdorp is net buiten de bebouwing van Amsterdam-Noord gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02256> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zunderdorp (gemeente Amsterdam)"@nl ;
        min:adres "Achterlaan 10",
            "Achterlaan 12" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zunderdorp (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Zunderdorp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49885>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55564> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "6789",
            "6790" ;
        min:soort "inleiding" ;
        min:volgnummer 2256 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0197> ;
        schema:name "Zunderdorp (gemeente Amsterdam)"@nl ;
        schema:pageEnd "555" ;
        schema:pageStart "554" ;
        schema:pagination "554-555" ;
        schema:text "De Herv. kerk (Achterlaan 12) is een gepleisterde zaalkerk, voorzien van een toren van drie geledingen met balustrade en tentdak. De met natuurstenen hoekblokken uitgevoerde laat-gotische toren verrees in de tweede helft van de 15de eeuw. De huidige kerk kwam in 1711 tot stand na een brand (1710) en werd verbouwd in 1824. Rond 1860 heeft men een haaks geplaatste consistoriekamer toegevoegd en mogelijk is de kerk toen ook gepleisterd. Het interieur wordt gedekt door een houten tongewelf met trekbalken en bevat een 17de-eeuwse preekstoel en doophek. Na 1711 is het niet herbouwde koorgedeelte als kerkhof in gebruik genomen. De eenlaagse neoclassicistische pastorie (Achterlaan 10) uit 1877 is ontworpen door T.C. van der Sterr."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02257> a min:Passage,
