        min:volgnummer 1870 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0152> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "491" ;
        schema:pageStart "491" ;
        schema:pagination "491" ;
        schema:text "Poldermolens. Van de tien resterende poldermolens in de Zijpe- en Hazepolder staan er twee in de omgeving van Sint Maartensbrug. Het zijn achtkante binnenkruiers met een met riet gedekte kap en romp op een met hout beklede voet. De molen Noorder-M (Rijksweg 36) stamt waarschijnlijk uit 1657 (gerestaureerd 1968) en de molen Noorder-G (Grote Sloot 153) met bijbehorende molenaarswoning uit 1826."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01871> a min:Passage,
            schema:CreativeWork ;
