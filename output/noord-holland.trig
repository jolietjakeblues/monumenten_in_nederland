        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nibbixwoud (gemeente Wognum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Nibbixwoud" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1636 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0120> ;
        schema:name "Nibbixwoud (gemeente Wognum)"@nl ;
        schema:pageEnd "458" ;
        schema:pageStart "458" ;
        schema:pagination "458" ;
        schema:text "De R.K. St.-Cunerakerk (Dorpsstraat 53) is een forse basilicale kruiskerk met driezijdig gesloten koor en een hoge toren van vier geledingen met balustrade (met hoekpinakels) en achtzijdige naaldspits. Deze neogotische kerk verrees in 1875-'77 naar ontwerp van A.C. Bleijs ter vervanging van een kerk uit 1840. In de op het werk van Tepe geïnspireerde toren hangt een door Petit & Fritsen gegoten klok (1876). De in 1996 gerestaureerde kerk bevat een neogotisch Smits-orgel (1886) en een modern hoofdaltaar (1956)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01637> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nibbixwoud (gemeente Wognum)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
