        min:kern "Sint Pancras" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1872 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0153> ;
        schema:name "Sint Pancras (gemeente Langedijk)"@nl ;
        schema:pageEnd "492" ;
        schema:pageStart "492" ;
        schema:pagination "492" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een oude geest in het verder moerassige Geestmerambacht. De in de 14de eeuw gebouwde kapel werd in 1497 tot parochiekerk verheven. Na de Tweede Wereldoorlog is het dorp vooral aan de zuidzijde gegroeid ten behoeve van forensen uit Alkmaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01873> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Pancras (gemeente Langedijk)"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Langedijk" ;
        min:gemeenteInBoek "Langedijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Pancras (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Sint Pancras" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1873 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0153> ;
        schema:name "Sint Pancras (gemeente Langedijk)"@nl ;
        schema:pageEnd "492" ;
        schema:pageStart "492" ;
        schema:pagination "492" ;
        schema:text "De Herv. kerk (Kerkplein 1), oorspronkelijk gewijd aan St. Pancras, is een eenbeukige kruiskerk met vieringtoren en driezijdig gesloten koor. De kerk werd in de eerste helft van de 16de eeuw gebouwd. Nadat de bijbehorende toren in 1604 was afgebrand, bouwde men in 1605 de vieringtoren (hersteld 1906). De overgebleven travee van het toen ingekorte schip ging dienst doen als consistorie. In 1841 is herstel uitgevoerd en bij een ingrijpende restauratie in 1950-'51 (B.T. Boeyinga en W.J. Dirkmaat) werd de kerk ontpleisterd. Tot de inventaris behoren een zeskantige preekstoel (1740) en een Maarschalkerweerd-orgel (1909)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01874> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Pancras (gemeente Langedijk)"@nl ;
        min:adres "Kerkplein 2" ;
