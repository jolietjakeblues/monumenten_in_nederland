        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0027> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Woonhuizen. Kenmerkend voor Badhoevedorp zijn de ruime eengezinswoningen met tuinen in een plantsoenrijke omgeving, zoals Badhoevelaan 10-16 (circa 1920). Functionalistisch van vorm is het dubbele huis Snipstraat 8-10 (circa 1930)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00652> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bakkum (gemeente Castricum)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Castricum" ;
        min:gemeenteInBoek "Castricum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Castricum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bakkum (gemeente Castricum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bakkum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 652 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0028> ;
        schema:name "Bakkum (gemeente Castricum)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Dorp, ontstaan als geestnederzetting op een strandwal aan de duinrand en voor het eerst vermeld omstreeks 980. De heerlijkheid, die in 1613 aan Johan van Oldebarnevelt toebehoorde, werd in 1749 gekocht door Nicolaas Geelvinck, heer van Castricum. De bebouwing concentreerde zich langs de Bakkumerstraat en de Heereweg (Bakkum-Noord). In het duingebied aan de westzijde werd de psychiatrische inrichting ‘Duin en Bosch’ gevestigd (1909). In 1925 legde men de Zeeweg naar Castricum aan Zee aan. Hoewel het toerisme toenam (jeugdherberg, koloniehuis), kwam aan zee geen badplaats tot ontwikkeling. Na de Tweede Wereldoorlog is Bakkum aan Castricum vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00653> a min:Passage,
