        schema:name "Amsterdam"@nl ;
        schema:pageEnd "122" ;
        schema:pageStart "122" ;
        schema:pagination "122" ;
        schema:text "De voorm. R.K. kapel De Voorzienigheid (achter Lauriergracht 39-41) [31], een driebeukige neogotische kerk met driezijdig gesloten koor, werd in 1882 gebouwd naar ontwerp van A.C. Bleijs op het binnenterrein van het voorm. kloostercomplex met internaat van de Zusters van de Voorzienigheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00430> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam"@nl ;
