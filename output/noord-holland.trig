        schema:name "Halfweg (gemeente Haarlemmerliede en Spaarnwoude)"@nl ;
        schema:pageEnd "350" ;
        schema:pageStart "350" ;
        schema:pagination "350" ;
        schema:text "Het trafohuisje (Schoolstraat 20), een gepleisterd pand met torenvormig gedeelte in zakelijk-expressionistische stijl, werd rond 1915 gebouwd naar een ontwerp van J.B. van Loghem voor de Kennemer Electriciteits Maatschappij (K.E.M.)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0073.php> .

