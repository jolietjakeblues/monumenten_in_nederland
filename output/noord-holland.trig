            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75430> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "502457",
            "502464" ;
        min:soort "inleiding" ;
        min:volgnummer 708 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0035> ;
        schema:name "Berkhout (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "De Herv. kerk (Kerkebuurt 172) is een T-vormige kerk voorzien van een toren van twee geledingen met frontalen en achtkantige spits. Deze neorenaissance-kerk werd in 1884 gebouwd naar ontwerp van A. Stoutjesdijk. De toren volgde in 1886."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00709> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berkhout (gemeente Wester-Koggenland)"@nl ;
        min:adres "Kerkebuurt 170" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
