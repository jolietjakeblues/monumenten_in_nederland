            "Hoofdweg-Oostzijde 470",
            "Hoofdweg-Oostzijde 516",
            "Hoofdweg-Oostzijde 836",
            "Hoofdweg-Westzijde 743",
            "IJweg 1013",
            "IJweg 1071",
            "IJweg 923-925",
            "Kruisweg 1405",
            "Rijnlanderweg 916" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
