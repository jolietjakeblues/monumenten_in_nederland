        min:rijksmonumentnummer "37068" ;
        min:soort "lemma" ;
        min:volgnummer 1965 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0165> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "506" ;
        schema:pageStart "506" ;
        schema:pagination "506" ;
        schema:text "Scholen. De voorm. bewaarschool (Kerkplein 5) is een T-vormig neoclassicistisch pand uit 1860, gebouwd op initiatief van jkr. W. Boreel van Hogelanden en W.H.C. Bohlen. In sobere expressionistische stijl verrees het gymnasium ‘Felisenum’ (Van Hogendorplaan 2) uit circa 1925. Aan deze school met gymnastieklokaal is omstreeks 1955 een tweelaagse vleugel in traditionalistische vormen toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01966> a min:Passage,
