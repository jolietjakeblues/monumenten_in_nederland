        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schellinkhout (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Schellinkhout" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1837 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0147> ;
        schema:name "Schellinkhout (gemeente Drechterland)"@nl ;
        schema:pageEnd "487" ;
        schema:pageStart "487" ;
        schema:pagination "487" ;
        schema:text "Het voorm. raadhuis (Dorpsweg 108) is een dwars pand met souterrain en bordestrap, gebouwd in 1765 (gevelsteen) door Jan Roos en Remmert Schuijt. Het souterrain bevatte de waag en een cachot. De voorm. raadzaal op de beletage heeft betegelde wanden met daarin tegeltableaus met voorstellingen van Gerechtigheid, Hoop en Liefde (1782)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0147.php> .

