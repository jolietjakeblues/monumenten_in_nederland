        schema:name "Halfweg (gemeente Haarlemmerliede en Spaarnwoude)"@nl ;
        schema:pageEnd "349" ;
        schema:pageStart "349" ;
        schema:pagination "349" ;
        schema:text "De Geref. kerk (Amsterdamsestraatweg 18), een recht gesloten kruiskerk met terzijde geplaatste toren en aangebouwde consistoriekamer, kwam in 1924 tot stand naar ontwerp van Tj. Kuipers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01146> a min:Passage,
