        schema:name "Amsterdam-Sloterdijk (gemeente Amsterdam)"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "De pastorie (Spaarndammerdijk 677) is een in de kern mogelijk 18de-eeuws dwars huis. De consistoriekamer (Spaarndammerdijk 675), een houten gebouw met afgeschuinde hoeken, dateert uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00600> a min:Passage,
            schema:CreativeWork ;
