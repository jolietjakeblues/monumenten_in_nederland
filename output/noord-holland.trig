        min:hoofdstuk "Steden, dorpen, monumenten › Grosthuizen (gemeente Wester-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Grosthuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13121> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38769" ;
        min:soort "inleiding" ;
        min:volgnummer 1059 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0070> ;
        schema:name "Grosthuizen (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De Herv. kerk (bij Grosthuizen 68) uit 1874 heeft men in 1965 afgebroken. In een stalen klokkenstoel op het kerkhof hangt een door François en Pieter Hemony gegoten klok (1664). De forse voorm. pastorie Grosthuizen 69 dateert uit 1865."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01060> a min:Passage,
