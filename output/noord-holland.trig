        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opperdoes (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Opperdoes" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1702 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0131> ;
        schema:name "Opperdoes (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "465" ;
        schema:pageStart "465" ;
        schema:pagination "465" ;
        schema:text "Dorp, ontstaan in de 13de eeuw op een oude kreekrug waar men enkele terpen op aanlegde. In 1517 werd het dorp geplunderd door de Zwarte Hoop (Grote Pier). Het gebied bleek geschikt voor de grove tuinbouw, waartoe in 1903 de veiling ‘Ons Belang’ werd opgericht. Tuinder J. Sluis ontwikkelde in 1865 de ‘Opperdoezer ronde’, een vroege diepogige aardappelsoort. Parallel aan de lintbebouwing kwam in 1887 de spoorlijn Hoorn-Medemblik te lopen. Na de Tweede Wereldoorlog is de bebouwing enigszins verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0131.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01703> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opperdoes (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Kerkebuurt 16" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opperdoes (gemeente Noorder-Koggenland)" ;
