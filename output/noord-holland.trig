        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0044> ;
        schema:name "Bussum"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De R.K. kerk O.L.-Vrouwe van Altijddurende Bijstand (Brinklaan 40a) is een centraalbouw met koepel, opgetrokken in 1920-'21 naar een sober neoromaans ontwerp van J.Th.J. Cuypers (gerestaureerd 1999-2000). Tot de inventaris behoren polychrome beelden en kruiswegstaties. De schilderingen in het priesterkoor zijn van broeder Mes (1950)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0044.php> .

