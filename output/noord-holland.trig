        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0043> ;
        schema:name "Burgerbrug (gemeente Zijpe)"@nl ;
        schema:pageEnd "249" ;
        schema:pageStart "249" ;
        schema:pagination "249" ;
        schema:text "Kruisvormig dorp, gesticht kort na de definitieve bedijking van de Zijpe- en Hazepolder in 1596-'97. De bebouwing concentreerde zich aan de Grote Sloot en de haaks daarop staande Burgerweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00794> a min:Passage,
