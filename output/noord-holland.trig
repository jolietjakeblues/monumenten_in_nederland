        schema:pageEnd "383" ;
        schema:pageStart "383" ;
        schema:pagination "383" ;
        schema:text "De voorm. pastorie (Grote Noord 13; 1879-'81), in dezelfde stijl als de kerk ontworpen door Bleijs, werd in 1910 verruild voor een met rationalistische elementen uitgevoerde nieuwe pastorie (Grote Noord 17)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0086.php> .

