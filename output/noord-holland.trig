        min:lemma "Postkantoren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18219>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58692>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61600> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "195",
