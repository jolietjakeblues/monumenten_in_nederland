        schema:name "Kudelstaart (gemeente Aalsmeer)"@nl ;
        schema:pageEnd "412" ;
        schema:pageStart "412" ;
        schema:pagination "412" ;
        schema:text "De eerste jachthaven met botenverhuur aan de Westeinderplassen werd in 1915 ontwikkeld door pionier R. Dragt. Het bijbehorende restaurant (Kudelstaartseweg 226-228) kwam in 1938 tot stand naar een ontwerp in traditionalistische vormen van J.F. Berghoef."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0098.php> .

