        schema:name "Grenspalen"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Grenspalen. Op de grens met de gemeenten Schoorl, Alkmaar en Wimmenum (na 1857 Egmond-Binnen) staan in totaal acht tussen 1754 en 1770 in opdracht van ambachtsheer Willem Lodewijk graaf van Nassau-Bergen geplaatste hardstenen grenspalen (Bergerweg, Duinweg, Groeneweg, Heerenweg)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00700> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen – Poldermolens"@nl ;
        min:adres "Groeneweg 10",
            "Meerweg 26",
            "Sluislaan 3",
            "Voert 5" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Bergen" ;
        min:lemma "Poldermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33724>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42402> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "9039",
            "9045" ;
        min:soort "lemma" ;
        min:volgnummer 700 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0033> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text """Poldermolens. Ten zuidwesten van Bergen staan twee met riet gedekte achtkantige binnenkruiers op een met hout beklede voet; De Damlandermolen (Meerweg 26) uit circa 1700 bemaalde de Damlander Polder, De Philisteinse Molen (Voert 5) uit 1897 de Philisteinse Polder.

Het voorm. militair vliegveld Bergen (Groeneweg 10), ten zuiden van Bergen, werd aangelegd in 1937-'39. Na een bombardement op 10 mei 1940 resteerde een deel van de zes hangars en de opstelplatforms. Het werd vervolgens ingericht voor Duitse jachtvliegtuigen, waartoe men een Ausweichgefechtstand en een Einjäger Warmehalle bouwde, evenals diverse bunkergroepen rondom het vliegveld. Tot de kleinere verdedigingswerken behoren een Tobruk (Nesdijk ong.) en stalen asperges (Groeneweg ong.). Opmerkelijk is ook het in 1947 tot woning verbouwde badhuis (Sluislaan 3) uit 1942."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00701> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergen aan Zee (gemeente Bergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
