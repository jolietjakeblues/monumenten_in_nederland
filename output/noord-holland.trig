        schema:pageEnd "404" ;
        schema:pageStart "404" ;
        schema:pagination "404" ;
        schema:text "Het voorm. raadhuis (Kanaaldijk 211; 1929-'30, L. Visser) is ontworpen in zakelijk-expressionistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01371> a min:Passage,
