        schema:name "Krommenie (gemeente Zaanstad)"@nl ;
        schema:pageEnd "409" ;
        schema:pageStart "409" ;
        schema:pagination "409" ;
        schema:text "De pastorie (Noorderhoofdstraat 131) heeft boven een in 1939 gerestaureerde bakstenen onderpui een houten voorschot met rijke versiering in Lodewijk XVI-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0097.php> .

