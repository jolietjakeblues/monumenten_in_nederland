        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0111> ;
        schema:name "Middenbeemster (gemeente Beemster)"@nl ;
        schema:pageEnd "430" ;
        schema:pageStart "430" ;
        schema:pagination "430" ;
        schema:text "Het kerkterrein is toegankelijk via een gemetselde boogbrug en een 18de-eeuws toegangshek tussen 18de-eeuwse, geblokt gepleisterde hekpijlers met natuurstenen vaasbekroningen, afkomstig van boerderij Vredeveld aan de Volgerweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01527> a min:Passage,
