        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiloo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heiloo" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1188 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0077> ;
        schema:name "Heiloo"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf (1843) met trekbalken. Tot de inventaris behoren een preekstoel en doophek (beide tweede helft 17de eeuw) en een gesneden bekroning met het wapen van Heiloo (begin 18de eeuw). Een sarcofaagdeksel van rode zandsteen is opnieuw gebruikt als grafzerk (gotische letters)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01189> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiloo"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Heiloo" ;
        min:gemeenteInBoek "Heiloo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heiloo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiloo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heiloo" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1189 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0077> ;
        schema:name "Heiloo"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "Bij de toren staat de Willibrordusput, die in zijn huidige vorm teruggaat tot de 15de of 16de eeuw (gerestaureerd 1951). Op het kerkhof staat onder meer een obelisk op postament voor J. Brink († 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01190> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiloo"@nl ;
        min:adres "Westerweg 265",
            "Westerweg 267" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Heiloo" ;
        min:gemeenteInBoek "Heiloo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heiloo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiloo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heiloo" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1190 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0077> ;
        schema:name "Heiloo"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "De R.K. St.-Willibrorduskerk (Westerweg 265) is een driebeukige basilicale kerk met doopkapel, ingangsportaal en een terzijde geplaatste toren met steile spits. Deze door J. Stuyt met traditionalistische elementen en romaanse details ontworpen kerk verrees in 1925-'27 ter vervanging van de kerk uit 1868. Het Pels-orgel dateert uit 1927. De uit 1868 daterende eclectische pastorie (Westerweg 267) is ontworpen door H.J. van den Brink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01191> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiloo"@nl ;
        min:adres "Kennemerstraatweg 464",
            "Kennemerstraatweg 466" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Heiloo" ;
        min:gemeenteInBoek "Heiloo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heiloo_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiloo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heiloo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71679>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71681>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71684>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71685> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "515982",
            "515983",
            "515986",
            "515988" ;
        min:soort "inleiding" ;
        min:volgnummer 1191 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0077> ;
        schema:name "Heiloo"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "De R.K. Willibrordusstichting (Kennemerstraatweg 464) werd in 1928-'40 verwezenlijkt op het landgoed Ypestein, waarvan het huis in 1880 was gesloopt. Opdrachtgever van deze psychiatrische inrichting was de in 1928 gestichte Congregatie van de Broeders van O.L. Vrouwe van Lourdes, met broeder-overste Junianus Traag als ‘bouwpastor’. In traditionalistische vormen ontwierpen H.J.W. Thunnissen en J.H. Hendricks acht paviljoens, een hoofdgebouw en diverse dienstgebouwen en dienstwoningen. Begonnen werd met drie paviljoens (1928-'29), waaronder het St.-Pauluspaviljoen (voor psychopaten). Aan de straatzijde bouwde men het sanatoriumpaviljoen S.M. Glorieux en het paviljoen Aloysius (beide 1932). Daartussen verrees in 1938-'40 het hoofdgebouw met broederklooster (gesloten 1994), kloosterhof en de op de koepelkerken van J.Th.J. Cuypers en J. Stuyt geïnspireerde O.L. Vrouwe van Lourdeskapel. Deze kapel bevat beelden van P. Biesiot, smeedijzeren ambo's en communiebanken van N. Witteman, gebrandschilderde ramen van K. Trautwein en een Pels-orgel (1949). Biesiot maakte ook de beelden aan het hoofdgebouw. De symmetrische tuinaanleg naar ontwerp van K.C. van Nes omvat een hertenkamp en een hoenderpark. Aan de zuidzijde verrezen dienstwoningen, zoals de directeurswoning ‘Klein Ypestein’ (Kennemerstraatweg 466; 1929), de rectorswoning Ypesteinerlaan 2 (1931) en de dokterswoning Kennemerstraatweg 462 (1937)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01192> a min:Passage,
