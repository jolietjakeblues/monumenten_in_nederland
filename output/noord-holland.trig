        min:adres "Lingerzijde 36",
            "Lingerzijde 63",
            "Spuistraat 19",
            "Zeevangszeedijk 9" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Edam-Volendam" ;
        min:gemeenteInBoek "Edam-Volendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Edam-Volendam> ;
