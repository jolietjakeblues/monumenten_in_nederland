        min:hoofdstuk "Steden, dorpen, monumenten › Wervershoof" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wervershoof" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42775> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38672" ;
        min:soort "lemma" ;
        min:volgnummer 2061 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill748> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0174> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "522" ;
        schema:pageStart "522" ;
        schema:pagination "522" ;
        schema:text """Windmolen ‘De Hoop’ (Zijdwerk 15) is een met riet gedekte achtkantige stellingmolen. Deze in 1972-'74 gerestaureerde korenmolen werd in 1889 gebouwd, waarbij mogelijk gebruik is gemaakt van materiaal van een poldermolen uit de omgeving van Amsterdam.

De boerderij Dorpsstraat 120 (circa 1900) is een forse stolpboerderij met darsdeuren en een hoger opgetrokken smal middenrisaliet met gesneden windveren. Iets terugliggend is er een zomerhuis aangebouwd.

Het café (De Hoek 1) is een eenlaagspand uit circa 1900 met dakkapel en spiegel."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02062> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wervershoof – Onderdijk"@nl ;
        min:adres "Nes 134",
            "Nes 15",
            "Nes 30" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Wervershoof" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wervershoof" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wervershoof" ;
        min:lemma "Onderdijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 2062 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0174> ;
        schema:name "Onderdijk"@nl ;
        schema:pageEnd "522" ;
        schema:pageStart "522" ;
        schema:pagination "522" ;
        schema:text "Onderdijk. Dit in de 19de eeuw ontstane lintdorp ten noordwesten van Wervershoof ligt ingeklemd tussen de Westfriese Omringdijk en de Grote Vliet. De voorm. R.K. lagere school (Nes 30) werd rond 1890 gebouwd en toont een beeld van St. Gerardus Majella. Lange tijd diende het gebouw als confectiebedrijf. In traditionalistische stijl ontwierp H.P.J. de Vries de in 1928-'29 gebouwde R.K. St.-Gerardus Majellakerk (Nes 134). In de naast deze kruiskerk geplaatste slanke toren met zadeldak hangt een door Mabilon & Co. gegoten klok (1929). De kerk bevat zijaltaren uit de bouwtijd en een hoofdaltaar uit 1948. De voorm. Toeristenkerk (Nes 15) is een kleine traditionalistische kerk uit circa 1960."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02063> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wervershoof – Zwaagdijk-Oost"@nl ;
        min:adres "Zwaagdijk 186",
            "Zwaagdijk 194" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Wervershoof" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wervershoof" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wervershoof" ;
        min:lemma "Zwaagdijk-Oost" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58752> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "501540" ;
        min:soort "lemma" ;
        min:volgnummer 2063 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0174> ;
        schema:name "Zwaagdijk-Oost"@nl ;
        schema:pageEnd "522" ;
        schema:pageStart "522" ;
        schema:pagination "522" ;
        schema:text "Zwaagdijk-Oost. Dit lintdorp ten zuidwesten van Wervershoof ontstond als laat-middeleeuwse veenontginning. Vanaf de 19de eeuw verrezen hier enkele grote stolpboerderijen, zoals ‘Land en Veelust’ (Zwaagdijk 194; 1881) met hoger opgetrokken middenrisaliet en eclectische details. Iets jonger is de stolpboerderij Zwaagdijk 153 (circa 1910) met dakerker en spiegel. De R.K. St.-Jozefkerk (Zwaagdijk 186) is een brede driebeukige kerk met een slanke klokkentoren bij het koor. Naar plannen van H.P.J. de Vries is deze traditionalistische kerk in 1952-'54 gebouwd ter vervanging van een kerk uit 1876."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02064> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westbeemster (gemeente Beemster)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
