        schema:name "Castricum"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "255" ;
        schema:pagination "255" ;
        schema:text "De (Geref.) Maranathakerk (Kon. Willemstraat 1) is een achtzijdige centraalbouw met tentdak en glas-inbetonvensters, gebouwd in 1955 naar ontwerp van H. Eldering (uitgebreid 1977)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00823> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Castricum"@nl ;
        min:adres "Dorpsstraat 65" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
