        schema:name "Koloniehuizen"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "Koloniehuizen. Het voorm. Joodse kinderkoloniehuis (Relweg 57; circa 1915), een wit gesausd pand met serres en veranda, en het koloniehuis Maris Stella (Voorstraat 42; 1926) zijn beide gemoderniseerd en aangepast aan hun huidige bestemming."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0185.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02136> a min:Passage,
