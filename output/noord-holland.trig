        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0071> ;
        schema:name "Haarlem"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "De kerk van de Evang. Luth. Broedergemeenschap (Parklaan 34) [10], gebouwd in 1876-'77 naar ontwerp van D.E.L. van den Arend, is een eclectische zaalkerk met wit gepleisterde onderdelen. Het interieur bevat een galerij en een door K.P. van Ingen gebouwd orgel (1923). Gelijktijdig gebouwd is de naastgelegen pastorie (Parklaan 32)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01096> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haarlem"@nl ;
        min:adres "Wilhelminastraat 20" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
