        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Monnickendam (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Monnickendam" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1560 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill605>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill606> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0114> ;
        schema:name "Monnickendam (gemeente Waterland)"@nl ;
        schema:pageEnd "437" ;
        schema:pageStart "436" ;
        schema:pagination "436-437" ;
        schema:text "De voorm. synagoge (Nieuwe Steeg ong.) [7] is een blokvormig pand met plat dak, waarvan de gevels zijn gedecoreerd met natuurstenen speklagen en strekken. Deze synagoge werd in 1894 (5654) achter het huis Havenstraat 1 gebouwd naar plannen van E.M. Rood, ter plaatse van een in 1818 opgerichte synagoge. Het gebouw heeft zijn functie behouden tot 1932."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01561> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Monnickendam (gemeente Waterland)"@nl ;
        min:adres "Weezenland 16" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Waterland" ;
        min:gemeenteInBoek "Waterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Monnickendam (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Monnickendam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28625> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30021" ;
        min:soort "inleiding" ;
        min:volgnummer 1561 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0114> ;
        schema:name "Monnickendam (gemeente Waterland)"@nl ;
        schema:pageEnd "437" ;
        schema:pageStart "437" ;
        schema:pagination "437" ;
        schema:text "Het voorm. burgerweeshuis (Weezenland 16) [8] werd na verbouwing in 1638 (jaartalankers) gevestigd in het 16de-eeuwse pesthuis. Daarbij zijn de oude balklagen met gotische sleutelstukken en maskerconsoles behouden. Naast dit dwarse pand met hoog zadeldak en vensters met glas-in-lood (gereconstrueerd rond 1920) staat een diepe vleugel met tuitgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01562> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Monnickendam (gemeente Waterland)"@nl ;
        min:adres "Noordeinde 20" ;
