        schema:pageEnd "363" ;
        schema:pageStart "363" ;
        schema:pagination "363" ;
        schema:text "Bij de kerk staat het voorm. catechisatielokaal (Oude Torenstraat ong.), een gepleisterd neoclassicistisch gebouwtje uit circa 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01211> a min:Passage,
