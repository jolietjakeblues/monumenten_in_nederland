        min:soort "lemma" ;
        min:volgnummer 2007 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0170> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "513" ;
        schema:pagination "513" ;
        schema:text """Woonhuizen. Voorbeelden van als middenganghuis met hoger opgetrokken middenrisaliet uitgevoerde rentenierswoningen zijn Warder 135 (circa 1890) en Warder 138 (circa 1910).

De grenspaal (bij IJsselmeerdijk 4) dateert uit 1777 en heeft de vorm van een obelisk."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02008> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Harenkarspel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warmenhuizen (gemeente Harenkarspel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Warmenhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2008 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0171> ;
        schema:name "Warmenhuizen (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "513" ;
        schema:pageStart "513" ;
        schema:pagination "513" ;
        schema:text "Dorp, ontstaan in de 9de eeuw op een reeks huisterpen die tot een langgerekte rug van terpen - ook wallen genoemd - samengroeiden. Hierdoor kreeg de Dorpsstraat een L-vorm. Warmenhuizen wordt in 1288 voor het eerst vermeld. Tot 1607 was het een heerlijkheid van de heer van Egmond. Eind 19de eeuw ontwikkelde Warmenhuizen zich tot tuindersdorp. Na de aansluiting op de tramlijn Alkmaar-Schagen (1913) bouwde men een fabriek voor gezouten groenten (1914) en een veiling (1928, gesloopt circa 1970). Na de Tweede Wereldoorlog is het lintdorp aan weerszijden uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02009> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warmenhuizen (gemeente Harenkarspel)"@nl ;
        min:adres "Dorpsstraat 93" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
