        schema:pageStart "430" ;
        schema:pagination "430" ;
        schema:text "Het voorm. postkantoor met directeurswoning (Leeghwaterstraat 9) werd in 1916 gebouwd naar een ontwerp met rationalistische elementen van J. Molenaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0111.php> .

