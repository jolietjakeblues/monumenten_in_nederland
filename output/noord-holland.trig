        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0067> ;
        schema:name "Recreatiewoningen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Recreatiewoningen. De gepleisterde villa Oase (Hargerzeeweg 9) werd in 1935 gebouwd naar een functionalistisch ontwerp van H. Elte met plat dak en een gebogen trappenhuisgedeelte. Een kleine houten recreatiewoning is Achterweg 10 (circa 1935). Een uit Oostenrijk ingevoerd bouwpakket vormde in 1950 de basis voor de houten recreatiewoning 't Kraaienest (Achterweg 9)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01042> a min:Passage,
            schema:CreativeWork ;
