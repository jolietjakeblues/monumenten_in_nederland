        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0160> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "499" ;
        schema:pageStart "499" ;
        schema:pagination "499" ;
        schema:text "Scholen. De voorm. openbare lagere school (Kerkbuurt 24) is een later ingrijpend verbouwde drieklassige gangschool uit 1868. De voorm. R.K. lagere school Dorpsstraat 37, een vierklassige middengangschool uit 1910, dient nu als dorpshuis en is in 1940 vervangen door de traditionalistische R.K. lagere St.-Barbaraschool (Dorpsstraat 35)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01923> a min:Passage,
            schema:CreativeWork ;
