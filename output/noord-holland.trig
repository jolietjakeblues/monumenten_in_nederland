        schema:pageEnd "526" ;
        schema:pageStart "526" ;
        schema:pagination "526" ;
        schema:text "De voorm. pastorie (Kerkbuurt 30) is een 18de-eeuws dwars huis met een rond 1910 verhoogde middenpartij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0180.php> .

