        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0125> ;
        schema:name "Oosterblokker (gemeente Drechterland)"@nl ;
        schema:pageEnd "461" ;
        schema:pageStart "461" ;
        schema:pagination "461" ;
        schema:text "De Herv. kerk (Oosterblokker 98), oorspronkelijk gewijd aan St. Pancratius, is een verhoogd gelegen eenbeukige kruiskerk met vijfzijdig gesloten koor en een toren van drie geledingen met ingesnoerde naaldspits. Tegen een (verdwenen) 14de-eeuwse kerk verrees rond 1450 de huidige toren met smalle spitsboognissen en afsluitend rondboogfries. In de toren hangt een door Hendrick Wegewaert gegoten klok (1601). Het laat-gotische schip kwam in de tweede helft van de 15de eeuw tot stand, begin 16de eeuw gevolgd door dwarsschip en koor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01668> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterblokker (gemeente Drechterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterblokker (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oosterblokker" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1668 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0125> ;
        schema:name "Oosterblokker (gemeente Drechterland)"@nl ;
        schema:pageEnd "461" ;
        schema:pageStart "461" ;
        schema:pagination "461" ;
        schema:text "Het interieur wordt gedekt door houten tongewelven, op de hoeken van de viering voorzien van schalken met beelden van de vier Evangelisten. De kerkvloer bevat enkele 12de-eeuwse grafstenen van rode Bremer zandsteen. Tot de inventaris behoren een dooptuin met koperen doopboog (1645), een rijk gesneden preekstoel met de wapens van Holland, Oranje, Blokker, West-Friesland en Drechterland (1661), en een door E. Leichel gebouwd orgel (eind 19de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01669> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterblokker (gemeente Drechterland)"@nl ;
        min:adres "Oosterblokker 68" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterblokker (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oosterblokker" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1669 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0125> ;
        schema:name "Oosterblokker (gemeente Drechterland)"@nl ;
        schema:pageEnd "461" ;
        schema:pageStart "461" ;
        schema:pagination "461" ;
        schema:text "De R.K. O.L. Vrouwe Visitatiekerk (Oosterblokker 68) is een eenbeukige kerk met een driezijdig gesloten koor en een geveltoren met houten lantaarn. Deze neoclassicistische kerk werd in 1845-'46 gebouwd naar ontwerp van Th. Molkenboer. Tot de inventaris behoren een communiebank (circa 1846), een hoofdaltaar (1902) en opvallende grote gebeeldhouwde neogotische kruiswegstaties (eind 19de eeuw). De laatstgenoemde zijn waarschijnlijk vervaardigd door H. van der Geld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01670> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterblokker (gemeente Drechterland)"@nl ;
        min:adres "Noorderdracht 15",
            "Noorderdracht 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterblokker (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oosterblokker" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0125> ;
        schema:name "Oosterblokker (gemeente Drechterland)"@nl ;
        schema:pageEnd "461" ;
        schema:pageStart "461" ;
        schema:pagination "461" ;
        schema:text "Het voorm. raadhuis (Noorderdracht 2) is een tweelaags pand uit 1925 met kleine dakruiter, middenrisaliet en aangebouwde dienstwoning. Het traditionalistische ontwerp is van J. van Santen. Woonhuizen. Uit het begin van de 20ste eeuw dateren het eenlaagspand Boekert 14 (circa 1915), met inpandig portiek en opschrift ‘Blokker’, en de met mansardedak uitgevoerde dokterswoning Sunny Home (Noorderdracht 15; circa 1920)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterblokker (gemeente Drechterland) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Drechterland" ;
        min:gemeenteInBoek "Drechterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drechterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterblokker (gemeente Drechterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oosterblokker" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1671 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0125> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "461" ;
        schema:pageStart "461" ;
        schema:pagination "461" ;
        schema:text "Boerderijen. De 18de-eeuwse stolpboerderijen Oosterblokker 71 en 103 hebben een uitgebouwd woongedeelte met houten voorschot en terugliggende darsdeuren. De met spiegel uitgevoerde stolpboerderij Oosterblokker 39 (1836) is voorzien van een klokvormige houten middentopgevel met doorbroken fronton en siervazen. Een erker en een dakkapel met gesneden windveren bezit de stolpboerderij Oosterblokker 57 (circa 1870). Het middenganghuis van de boerderij Oosterblokker 125 (1863) is vóór een stolpschuur gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01672> a min:Passage,
