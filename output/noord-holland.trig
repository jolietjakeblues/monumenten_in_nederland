        min:volgnummer 1597 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0116> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "447" ;
        schema:pageStart "447" ;
        schema:pagination "447" ;
        schema:text "Poldermolen ‘De Onrust’ (Boezemkade 1), gelegen ten zuidwesten van Muiderberg, is een met riet gedekte achtkantige grondzeiler met bakstenen onderbouw. Deze molen, gebouwd in 1806 bij de tweede (mislukte) poging het Naardermeer droog te leggen, is nog steeds in gebruik ter regulering van het waterpeil van het meer. Het nabijgelegen gemaal ‘De Machine’ (Boezemkade 5) kwam in 1883 tot stand bij de derde poging, maar raakte al in 1886 buiten gebruik wegens kwelwaterproblemen en slechte landbouwopbrengsten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01598> a min:Passage,
            schema:CreativeWork ;
