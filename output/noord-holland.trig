        schema:pageStart "350" ;
        schema:pagination "350" ;
        schema:text "Het voorm. badhuis (Schoolstraat 14-16) werd in 1926 voor ‘Het Witte Kruis’ gebouwd naar een zakelijk-expressionistisch ontwerp van J. op 't Land."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01158> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heemskerk"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Heemskerk" ;
        min:gemeenteInBoek "Heemskerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heemskerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heemskerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heemskerk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1158 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0074> ;
        schema:name "Heemskerk"@nl ;
        schema:pageEnd "350" ;
        schema:pageStart "350" ;
        schema:pagination "350" ;
        schema:text "Dorp, ontstaan op een strandwal en voor het eerst vermeld in 1063. De kerk staat op de noordpunt van de geest, met ten noorden daarvan kasteel Marquette en ten zuidoosten het kasteel Assumburg. Even buiten de oude kern verrees in de 19de eeuw een nieuwe katholieke kerk. Op de geest, tussen de dorpskern en de duinrand, kwam vanaf de 19de eeuw tuinbouw tot ontwikkeling. Delen van deze tuinbouwgronden zijn na de Tweede Wereldoorlog met woonwijken bebouwd, waaronder de voor medewerkers van de Hoogovens in 1958 gestichte wijk Oosterzij (Bachplein e.o; W.M. de Haas). De oude dorpskern is vrijwel geheel vernieuwd en Heemskerk is aan Beverwijk vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01159> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heemskerk – Assumburg"@nl ;
        min:adres "Tolweg 9" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Heemskerk" ;
        min:gemeenteInBoek "Heemskerk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heemskerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heemskerk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Heemskerk" ;
        min:lemma "Assumburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10034> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "21210" ;
        min:soort "lemma" ;
        min:volgnummer 1159 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0074> ;
        schema:name "Assumburg"@nl ;
        schema:pageEnd "350" ;
        schema:pageStart "350" ;
        schema:pagination "350" ;
        schema:text "Assumburg (Tolweg 9). Dit omgrachte kasteel met vier vleugels om een kleine binnenplaats ligt aan de Tolweg van Uitgeest naar Beverwijk. Al in de 14de eeuw wordt een versterkt huis vermeld, maar het huidige kasteel met twee vierkante hoektorens is laat-15de-eeuws. Van een ingrijpende verbouwing rond 1546 in opdracht van Gerrit IV van Assendelft dateren de kantelen, de achtzijdige hoektoren en de woonvleugels om de binnenplaats. Hier bevindt zich de in laat-gotische en vroege renaissance-vormen uitgevoerde vierschaar: een arcade van Naamse steen op zuilen met kussenkapitelen voorzien van een rankenornament. Er volgde een verbouwing in 1610. Na de aankoop in 1694 door de Amsterdamse bankier Jean Deutz zijn rond 1700 de noordelijke en oostelijke vleugel verbouwd. De voorburcht aan de zuidoostzijde werd vervangen door een voorplein aan de westzijde met een nieuwe classicistische ingangspartij. Uit de 18de eeuw dateren de bouwhuizen aan weerszijden van het voorplein (zuidzijde nu ruïne). Tot 1867 bleef het kasteel in de familie Deutz van Assendelft, waarna het in 1911 in handen van het rijk kwam. Daarna volgde herstel (J.A. van Lokhorst) en sinds 1934 is het kasteel een jeugdherberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0074.php> .

