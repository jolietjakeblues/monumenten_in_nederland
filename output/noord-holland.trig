        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Velsen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19090> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "520716" ;
        min:soort "inleiding" ;
        min:volgnummer 1964 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0165> ;
        schema:name "Velsen"@nl ;
        schema:pageEnd "506" ;
        schema:pageStart "506" ;
        schema:pagination "506" ;
        schema:text "Het voorm. raadhuis (Torenstraat 5-7) werd rond 1640 gebouwd als rechthuis en later verschillende keren verbouwd. Uit 1907 dateert de huidige voorgevel in rijke neorenaissance-stijl met vooruitstekende ingangspartij en balkon. Aan de oostzijde heeft men in 1926 een vleugel in dezelfde stijl toegevoegd. Vlakbij staat het voorm. cachot (Middendorpstraat 8), een klein bakstenen gebouwtje uit 1926."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01965> a min:Passage,
