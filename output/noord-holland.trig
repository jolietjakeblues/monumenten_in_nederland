        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34311>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41097> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "17131",
            "17132" ;
        min:soort "inleiding" ;
        min:volgnummer 843 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0050> ;
        schema:name "De Rijp (gemeente Graft-De Rijp)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De voorm. Evang. Luth. kerk (Rechtestraat 14) is een kort na 1790 gebouwde zaalkerk waarvan de in 1880 wit gepleisterde puntgevel is voorzien van pinakels en een windwijzer met zwaan. De kerk wordt geflankeerd door de eveneens wit gepleisterde voorm. pastorie en kosterij (Rechtestraat 12 en 16)"@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00844> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Rijp (gemeente Graft-De Rijp)"@nl ;
        min:adres "Rechtestraat 164" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Alkmaar" ;
        min:gemeenteInBoek "Graft-De Rijp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alkmaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Rijp (gemeente Graft-De Rijp)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "De Rijp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53407> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "17162" ;
        min:soort "inleiding" ;
        min:volgnummer 844 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0050> ;
        schema:name "De Rijp (gemeente Graft-De Rijp)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De R.K. St.-Bonifatiuskerk (Rechtestraat 164) is een eenbeukige kerk met driezijdig gesloten koor en een topgevel met door pleisterwerk versierde pinakels en een geveltoren. Deze neogotische kerk verrees in 1860-'63 naar het ontwerp van W.J.J. Offenberg en J. van Straaten ter vervanging van een schuurkerk uit 1804. In de geveltoren hangt een door Pieter Hemony gegoten klok (1667). Het interieur van de in 1983 en 1991 gerestaureerde kerk wordt gedekt door een houten tongewelf, dat in 1894 ijzeren trekstangen heeft gekregen. Tot de neogotische inventaris uit de bouwtijd behoren het hoofdaltaar, de preekstoel, de orgelkast en de kruiswegstaties, alle gemaakt door atelier Cuypers-Stoltzenberg. Het Pels-orgel werd geplaatst in 1910 in de oude kast. De gebrandschilderde ramen zijn vervaardigd door atelier Nicolas (1919) en door L. Asperslagh (1927)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0050.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00845> a min:Passage,
