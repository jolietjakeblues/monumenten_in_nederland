        min:volgnummer 2253 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0196> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "554" ;
        schema:pagination "554" ;
        schema:text "Bedrijfsgebouwen. De voorm. kaasfabriek ‘De Eendracht’ (Zuidervaart 26) is een L-vormig pand uit circa 1880. Uit die tijd dateert ook het middenganghuis Zuidervaart 29 met dwars aangebouwde werkplaats. Decoratief houtsnijwerk siert de dakkapel van het woonhuis en het zadeldak van de werkplaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02254> a min:Passage,
            schema:CreativeWork ;
