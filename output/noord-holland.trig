        min:hoofdstuk "Steden, dorpen, monumenten › Driehuis (gemeente Velsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Driehuis" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 907 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0057> ;
        schema:name "Driehuis (gemeente Velsen)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De boerderij Driehuizerkerkweg 117-119 stamt uit de 17de eeuw en maakte in de 18de eeuw deel uit van de buitenplaats Westerveld. Het lage gepleisterde huis met opkamer heeft drie U-vormig op elkaar aansluitende zadeldaken met een zakgoot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0057.php> .

