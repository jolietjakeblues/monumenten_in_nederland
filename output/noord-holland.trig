        schema:pageEnd "460" ;
        schema:pageStart "460" ;
        schema:pagination "460" ;
        schema:text "Hotel ‘Concordia’ (Dorpsstraat 578) is een sober en robuust gebouw uit 1918. Het voorm. betaalkantoor (Veilingweg 3), een blokvormig pand in zakelijk-expressionistische stijl, werd gebouwd in 1931 bij de (verdwenen) veiling uit 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01660> a min:Passage,
            schema:CreativeWork ;
