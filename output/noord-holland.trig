        min:volgnummer 1375 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0094> ;
        schema:name "Kolhorn (gemeente Niedorp)"@nl ;
        schema:pageEnd "405" ;
        schema:pageStart "405" ;
        schema:pagination "405" ;
        schema:text "De Doopsgez. kerk ‘Eben Haezer’ (Westfriesedijk 110) is een sobere, wit gepleisterde zaalkerk uit 1887 met portaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01376> a min:Passage,
