        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alkmaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Rijp (gemeente Graft-De Rijp)" ;
