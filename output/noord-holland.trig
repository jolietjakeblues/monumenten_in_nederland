        min:volgnummer 1385 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0095> ;
        schema:name "Koog aan de Zaan (gemeente Zaanstad)"@nl ;
        schema:pageEnd "406" ;
        schema:pageStart "406" ;
        schema:pagination "406" ;
        schema:text "De R.K. kerk H.H. Martelaren van Gorcum (Boschjestraat 115) is een driebeukige kruiskerk met hoger vieringgedeelte en een terzijde geplaatste toren met achtzijdige koperen spits. Deze kerk werd in 1931-'32 naar een expressionistisch ontwerp van N. Molenaar jr. gebouwd. De pastorie (Boschjesstraat 113) dateert eveneens uit 1932."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01386> a min:Passage,
