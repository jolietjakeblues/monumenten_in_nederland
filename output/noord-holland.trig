        min:kern "Tuitjenhorn" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1923 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill712> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0160> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "499" ;
        schema:pageStart "499" ;
        schema:pagination "499" ;
        schema:text "Boerderijen. De boerderij Dorpsstraat 18 (circa 1900) bestaat uit een stolpschuur met een ervoor gebouwd middenganghuis. Naast de tuinderswoning Dorpsstraat 6 staat een koolschuur met mansardedak (beide circa 1925)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01924> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twisk (gemeente Noorder-Koggenland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Twisk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Twisk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1924 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0161> ;
        schema:name "Twisk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "499" ;
        schema:pageStart "499" ;
        schema:pagination "499" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning op de kreekrug die van Abbekerk naar Medemblik loopt. Het dorp wordt in 1311 voor het eerst vermeld en kreeg in 1414 als onderdeel van de ‘Stede Abbekerk’ (Abbekerk, Twisk, Midwoud en Lambertschaag) - louter bestuurstechnische - stadsrechten. Het Bennemeer aan de zuidwestzijde werd in 1633-'43 drooggemalen. Door de goede weidegronden ontstonden rijke boerderijen. Omdat de verkaveling niet loodrecht op de ontginningsas staat, zijn ook boerderijen en de woonhuizen schuin geplaatst ten opzichte van de weg. Op een kleine naoorlogse woonwijk na, heeft er zich geen komvorming voorgedaan in dit lintdorp. Twisk is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01925> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twisk (gemeente Noorder-Koggenland)"@nl ;
        min:adres "Dorpsweg 121" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Twisk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Twisk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20709>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51487> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30714",
            "30715" ;
        min:soort "inleiding" ;
        min:volgnummer 1925 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0161> ;
        schema:name "Twisk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "499" ;
        schema:pageStart "499" ;
        schema:pagination "499" ;
        schema:text "De Herv. kerk (Dorpsweg 121) is een langgerekte eenbeukige kerk met vijfzijdig gesloten koor en een toren van drie geledingen met balustrade en achtkantige gemetselde spits. Het vermoedelijk laat-14de-eeuwse gotische schip is deels opgetrokken met gele kloostermoppen (noordzijde). De laat-gotische toren met slanke geprofileerde spitsboognissen verrees in de tweede helft van de 15de eeuw en bevat een door Geert van Wou en Johannes Schonenborch gegoten klok (1521). Begin 16de eeuw werd de oostelijke helft van het schip verhoogd en verlengd met een nieuw koor onder één doorlopende kap met houten tongewelf. Het westelijke deel van het schip heeft men in de 18de eeuw tot consistoriekamer verbouwd. Een reparatie en bepleistering volgden in 1850. De toren is gerestaureerd in 1934-'36 (D. Saal) en bij een restauratie in 1976-'81 (J. Schipper) is de kerk ontpleisterd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01926> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twisk (gemeente Noorder-Koggenland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Medemblik" ;
        min:gemeenteInBoek "Noorder-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Medemblik_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Twisk (gemeente Noorder-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Twisk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1926 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0161> ;
        schema:name "Twisk (gemeente Noorder-Koggenland)"@nl ;
        schema:pageEnd "500" ;
        schema:pageStart "500" ;
        schema:pagination "500" ;
        schema:text "Het interieur wordt gedekt door een 16de-eeuws houten tongewelf met trekbalken, waarvan de in 1850 omtimmerde korbeelstellen zijn verwijderd bij de restauratie rond 1980. Verder heeft men toen acht - lange tijd in het Rijksmuseum ondergebrachte - gebrandschilderde vensters met cartouches in kwabornamentvormen (1696) herplaatst. Tot de inventaris behoren een preekstoel (1731) met gesneden voorstellingen van de vier evangelisten, een doophek met een houten en een koperen lessenaar (1731 en 1763) en een door E. Leichel gebouwd orgel (1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01927> a min:Passage,
            schema:CreativeWork ;
