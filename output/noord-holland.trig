        min:soort "inleiding" ;
        min:volgnummer 707 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill293> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0035> ;
        schema:name "Berkhout (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Dorp, ontstaan in de 13de eeuw bij de ontginning van wat toen de Veenhoop werd genoemd. Vooral in de 19de eeuw heeft zich een langgerekte lintbebouwing gevormd. Bij de Slagterslaan is in 1973 de uitbreidingswijk Berkenweide aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0035.php> .

