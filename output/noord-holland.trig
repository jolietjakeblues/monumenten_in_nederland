        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Woonhuizen. Uit het begin van de 20ste eeuw dateren de huizen Westerblokker 112 (circa 1906), met chaletstijl-elementen en erker, en Westerblokker 93 (circa 1933) met expressionistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0176.php> .

