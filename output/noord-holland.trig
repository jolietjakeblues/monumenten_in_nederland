        min:kern "Marken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25568> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "28213" ;
        min:soort "inleiding" ;
        min:volgnummer 1497 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0107> ;
        schema:name "Marken (gemeente Waterland)"@nl ;
        schema:pageEnd "422" ;
        schema:pageStart "422" ;
        schema:pagination "422" ;
        schema:text "De Herv. kerk (tegenover Kerkbuurt 8) is een driebeukige pseudobasilicale kerk met een driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De kerk verrees in 1903-'04 in late neorenaissance-stijl naar een ontwerp uit 1896 van A.H.L. Kups. In de toren hangt een door Joannes van Trier gegoten klok (1647)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01498> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Marken (gemeente Waterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Waterland" ;
        min:gemeenteInBoek "Waterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Marken (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Marken" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1498 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0107> ;
        schema:name "Marken (gemeente Waterland)"@nl ;
        schema:pageEnd "422" ;
        schema:pageStart "422" ;
        schema:pagination "422" ;
        schema:text "Het interieur wordt gedekt door een houten tongewelf op vier gietijzeren zuilen (firma G. Wispelwey & Co.); de zijbeuken hebben een vlak plafond. Tot de inventaris behoren een preekstoel en lessenaar (beide derde kwart 17de eeuw), drie koperen kronen (17de eeuw) en een koperen doopboog met zwaan (18de eeuw). Er zijn scheepsmodellen van twee haringbuizen (circa 1600 en 1890), een stoomlogger (circa 1943), een botter (1957) en een ansjovisvlet (1959)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01499> a min:Passage,
