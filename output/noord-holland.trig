        min:lemma "Zuid-Eierland" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51974> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "525487" ;
        min:soort "lemma" ;
        min:volgnummer 830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0047> ;
        schema:name "Zuid-Eierland"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "256" ;
        schema:pagination "256" ;
        schema:text "Zuid-Eierland. Gehucht ten zuidwesten van De Cocksdorp. De voorm. openbare lagere school (Postweg 72) is een drieklassige school uit 1912 met losse onderwijzerswoning (Postweg 70). De voorm. (Herv.) Bethelkerk (Muijweg 38), een laag zaalgebouw met dakruiter uit circa 1940, dient nu als buurthuis. De bunker (bij Postweg 115), die rond 1942 gebouwd werd bij het in 1937 aangelegde vliegveld vertoont nog sporen van de Russenopstand (1945)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00831> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Koog (gemeente Texel)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
