        schema:name "Windmolen"@nl ;
        schema:pageEnd "374" ;
        schema:pageStart "374" ;
        schema:pagination "374" ;
        schema:text "Windmolen ‘De Onderneming’ (Koningsweg 75) is een met riet gedekte achtkante grondzeiler op veldmuren, gebouwd in 1851 als korenmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Holysloot (gemeente Amsterdam)"@nl ;
