        min:kern "Blaricum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58857> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "9625" ;
        min:soort "inleiding" ;
        min:volgnummer 730 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill298> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0037> ;
        schema:name "Blaricum"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "235" ;
        schema:pagination "235-236" ;
        schema:text "Op het omringende kerkhof bevindt zich een monument voor T. Faber († 1943). Bij de door Th. Rueter ontworpen pastorie (Torenlaan 14; 1915) staat een theekoepel (circa 1830) met neogotische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00731> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blaricum"@nl ;
        min:adres "Kerklaan 17" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Blaricum" ;
        min:gemeenteInBoek "Blaricum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Blaricum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Blaricum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Blaricum" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 731 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0037> ;
        schema:name "Blaricum"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De R.K. St.-Vituskerk (Kerklaan 17) is een driebeukige kruiskerk met driezijdig gesloten koor en een toren van twee geledingen met frontalen, hoektorentjes en naaldspits. Deze neogotische kerk verrees in 1870-'71 naar ontwerp van P.J.H. Cuypers ter vervanging van een kerk uit 1825. Bij een ingrijpende verbouwing in 1936-'37 (C.A. Hardeman) heeft men het schip breder herbouwd. Tot de inventaris behoren een Piëta (eind 15de eeuw), een Maarschalkerweerd-orgel (1874) en een hoofdaltaar (1937). De gebrandschilderde vensters en kruiswegstaties zijn vervaardigd door J. Oosterman en de vensters in de Mariakapel door J. Nicolas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00732> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Blaricum"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
