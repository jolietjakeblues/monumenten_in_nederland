        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0124> ;
        schema:name "Obdam"@nl ;
        schema:pageEnd "460" ;
        schema:pageStart "460" ;
        schema:pagination "460" ;
        schema:text "De R.K. St.-Victorkerk (Dorpsstraat 151) is een driebeukige basilicale kruiskerk met vijfzijdig gesloten koor en een toren van drie geledingen met balustrade en naaldspits. Deze neogotische kerk met neoromaanse elementen verrees in 1890-'92 naar plannen van A.C. Bleijs ter vervanging van de in 1803 aan de katholieken teruggeven middeleeuwse kerk (gesloopt 1893). In de toren hangt een door Johan Nicolaas Derck gegoten klok (1752). De kerk is in 1991-'93 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01663> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Obdam"@nl ;
        min:adres "Dorpsstraat 106" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
