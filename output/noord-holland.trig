        min:kern "Groet" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14405>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43129> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "33834",
            "33835" ;
        min:soort "inleiding" ;
        min:volgnummer 1038 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0067> ;
        schema:name "Groet (gemeente Bergen)"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "De Herv. kerk (Kerkbrink 1), een gepleisterde eenbeukige kerk voorzien van een houten geveltoren met ingesnoerde spits, kwam tot stand in 1639 en werd verbouwd in 1738. In de geveltoren hangt een klok uit 1594. Het in 1830 ingestorte koor is kort daarna vervangen door een rechte sluiting. De kerk is in 1948 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01039> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Groet (gemeente Bergen)"@nl ;
        min:adres "Kerkbrink 18-19" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bergen (NH)" ;
        min:gemeenteInBoek "Bergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergen_(NH)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Groet (gemeente Bergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Groet" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37949> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "33836" ;
        min:soort "inleiding" ;
        min:volgnummer 1039 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0067> ;
        schema:name "Groet (gemeente Bergen)"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "Het voorm. raadhuis (Kerkbrink 18-19) is een klein onderkelderd pand met cachot en raadkamer (betegelde schouw 18de eeuw). De schoudergevel draagt het jaartal 1639, maar verdwenen jaartalankers zouden 1622 als bouwjaar hebben aangegeven. Na 1825 diende het gebouw onder meer als pastorie en toen is mogelijk de gepleisterde aanbouw toegevoegd. Het pand is gerestaureerd in 1947 (J. de Meijer)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01040> a min:Passage,
            schema:CreativeWork ;
