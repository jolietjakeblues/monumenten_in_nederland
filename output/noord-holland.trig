        min:kern "'s-Graveland" ;
        min:lemma "Winkels" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1031 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill409> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0066> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "305" ;
        schema:pagination "305-306" ;
        schema:text "Winkels. Een winkelpui met neorenaissance-details bezit het met mansardedak uitgevoerde winkelpand Noordereinde 95 (circa 1905). Een vergelijkbare opbouw hebben Noordereinde 97 en 149 (circa 1900). De voorm. vleeshouwerij Noordereinde 17-19 (circa 1900) toont boven de neoclassicistische winkelpui een gebeeldhouwde koeienkop. Voorbeelden van hoekwinkels zijn Stadwijk (Leeuwenlaan 2-4, circa 1890), gebouwd in neorenaissance-stijl, en Noordereinde 251-253 (circa 1910) met kleurig metselwerk en jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01032> a min:Passage,
