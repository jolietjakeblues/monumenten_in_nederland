        min:gemeenteInBoek "Anna Paulowna" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wieringerwaard (gemeente Anna Paulowna)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wieringerwaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59946> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "512097" ;
        min:soort "inleiding" ;
        min:volgnummer 2112 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0182> ;
        schema:name "Wieringerwaard (gemeente Anna Paulowna)"@nl ;
        schema:pageEnd "529" ;
        schema:pageStart "529" ;
        schema:pagination "529" ;
        schema:text "De Herv. kerk (Noord Zijperweg 29), een gepleisterde zaalkerk met portaal en geveltoren, werd in 1865 gebouwd ter plaatse van een voorganger uit 1693. In de geveltoren hangt een door Gisbertus van den Ende gegoten klok (1693)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02113> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wieringerwaard (gemeente Anna Paulowna)"@nl ;
        min:adres "Noord Zijperweg 35" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hollands Kroon" ;
        min:gemeenteInBoek "Anna Paulowna" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hollands_Kroon> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wieringerwaard (gemeente Anna Paulowna)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Wieringerwaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58010> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "8700" ;
        min:soort "inleiding" ;
        min:volgnummer 2113 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0182> ;
        schema:name "Wieringerwaard (gemeente Anna Paulowna)"@nl ;
        schema:pageEnd "529" ;
        schema:pageStart "529" ;
        schema:pagination "529" ;
        schema:text "Het polderhuis Wieringerwaard (Noord Zijperweg 35) is een stolpboerderij voorzien van een hoge onderkelderde hoekuitbouw met sierspant. Dit in 1611-'12 gebouwde en door een ‘casteleyn’ bewoonde pand werd verbouwd in 1681 (voorgevel) en rond 1750 (omlijste ingangspartij). Uit die tijd zijn ook de kastenwand met Lodewijk XV-details en de betegelde schouw met smuiger in de opkamer van de uitbouw. Die kamer diende als vergaderplaats voor het gemeente- en polderbestuur. Het gebouw is gerestaureerd in 1951-'52 (C.W. Royaards) en dient sinds 1990 als woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0182.php> .

