        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vogelenzang (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Vogelenzang" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19920> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "9744" ;
        min:soort "inleiding" ;
        min:volgnummer 1985 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill728> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0168> ;
        schema:name "Vogelenzang (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "510" ;
        schema:pageStart "509" ;
        schema:pagination "509-510" ;
        schema:text "De R.K. kerk O.L. Vrouwe ten Hemelopneming (Kerkweg 1) is een kruiskerk voorzien van een driezijdig gesloten koor met sacristie en een toren van twee geledingen met achtzijdige lantaarn en spits. Deze neogotische kerk verrees in 1858-'61 naar ontwerp van Th. Molkenboer. In de toren hangt een door François en Petrus Hemony gegoten klok (1664). De pinakels rond de lantaarn heeft men in 1928 verwijderd. Het kerkinterieur wordt gedekt door gestukadoorde houten kruisgewelven. De wanden zijn versierd met mozaïekwerk van A. Elsner (1859). Uit de bouwtijd dateren het neogotische hoofdaltaar, het rijke koorgestoelte en de orgeltribune."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01986> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vogelenzang (gemeente Bloemendaal)"@nl ;
        min:adres "Zilkerduinweg 375" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Bloemendaal" ;
        min:gemeenteInBoek "Bloemendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bloemendaal_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vogelenzang (gemeente Bloemendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Vogelenzang" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1986 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0168> ;
        schema:name "Vogelenzang (gemeente Bloemendaal)"@nl ;
        schema:pageEnd "510" ;
        schema:pageStart "510" ;
        schema:pagination "510" ;
        schema:text "Het voorm. gebouw van het Gezelschap der Vrouwen van Nazareth (Zilkerduinweg 375), ook wel ‘De Tiltenberg’ genoemd naar het gelijknamige duin, kwam in 1931 naar ontwerp van J. Stuyt tot stand voor de Graalbeweging, een R.K. vrouwelijke jeugdbeweging (opgericht 1929). Het sobere L-vormige tweelaagse gebouw heeft een hoger opgetrokken, torenvormig, trappenhuis met tentdak. De rond 1952 toegevoegde achtzijdige kapel met vierkante ombouw en aansluitende poortmuur is ontworpen door N. van der Laan en W.A.J. Hansen in de traditionalistische stijl van de Bossche school."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0168.php> .

