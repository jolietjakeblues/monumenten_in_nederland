        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0194> ;
        schema:name "Café"@nl ;
        schema:pageEnd "553" ;
        schema:pageStart "553" ;
        schema:pagination "553" ;
        schema:text """Café ‘De Rode Leeuw’ (Dorpsstraat 440), een diep pand met een pilastergeveltop in siermetselwerk, werd in 1911 gebouwd en kreeg in 1925 een aangebouwde kolfbaan.

Van de conservenfabriek ‘Kramer's Zuurkool’ (Voorburggracht 141), gesticht in 1890, resteert het tweelaagse kantoorgebouw (circa 1905)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0194.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiderwoude (gemeente Waterland)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Waterland" ;
        min:gemeenteInBoek "Waterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiderwoude (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Zuiderwoude" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2242 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0195> ;
        schema:name "Zuiderwoude (gemeente Waterland)"@nl ;
        schema:pageEnd "553" ;
        schema:pageStart "553" ;
        schema:pagination "553" ;
        schema:text "Dorp, ontstaan als veenontginning vanaf een kreekrug van de getijdegeul de Zwet. Eind 12de eeuw was hier een tufstenen kerkje. Er vormde zich een lintbebouwing aan de Dorpsstraat langs de Zwet. Het dorp had te lijden van een dorpsbrand (1712) en overstromingen (1825 en 1916). Zuiderwoude is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiderwoude (gemeente Waterland)"@nl ;
        min:adres "Dorpsstraat 1",
            "Dorpsstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Waterland" ;
        min:gemeenteInBoek "Waterland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waterland_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuiderwoude (gemeente Waterland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Zuiderwoude" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 2243 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill800> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0195> ;
        schema:name "Zuiderwoude (gemeente Waterland)"@nl ;
        schema:pageEnd "554" ;
        schema:pageStart "553" ;
        schema:pagination "553-554" ;
        schema:text "De Herv. kerk (Dorpsstraat 1) is een zaalkerk voorzien van een houten geveltoren met ingesnoerde spits. Deze neogotische kerk kwam in 1877 tot stand naar plannen van T.C. van der Sterr ter plaatse van een oudere kerk. De in 2004 gerestaureerde kerk bevat een preekstoel met houten lessenaar (circa 1660). Het uit de Herv. kerk te Beuningen afkomstige Gradussen-orgel (1863) is in 2000 geplaatst in een bestaande orgelkast (1877, H. Knipscheer). De pastorie (Dorpsstraat 2) is een gepleisterd dwars huis uit 1912."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02244> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuiderwoude (gemeente Waterland)"@nl ;
        min:adres "Dorpsstraat 34-36" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
