        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "555" ;
        schema:pageStart "555" ;
        schema:pagination "555" ;
        schema:text "Woonhuizen. Het vroeg-19de-eeuwse houten huis Kerklaan 16 is voorzien van een uit- en ingezwenkt voorschot. Een puntvormig voorschot heeft het 19de-eeuwse houten huis Middenweg 19."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02258> a min:Passage,
            schema:CreativeWork ;
