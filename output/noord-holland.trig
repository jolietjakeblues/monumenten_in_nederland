        schema:pageEnd "413" ;
        schema:pageStart "413" ;
        schema:pagination "413" ;
        schema:text "Dorp, gelegen aan het noordelijke uiteinde van de in de 11de eeuw ontstane veenontginning van Abbekerk. Tot de inpoldering van de Wieringermeer (1927-'30) had het een bescheiden vissershaven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0100.php> .

