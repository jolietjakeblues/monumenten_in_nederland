        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0191> ;
        schema:name "Zaandijk (gemeente Zaanstad)"@nl ;
        schema:pageEnd "546" ;
        schema:pageStart "546" ;
        schema:pagination "546" ;
        schema:text "De voorm. (Herv.) Zaandijkerkerk (bij Kerkstraat 1) is een zaalkerk met zuiderdwarsarm en een toren van drie geledingen met naaldspits. Deze deels wit gesausde kerk met vroege neorenaissance-details verrees in 1879, nadat de oude kerk door brand was verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02210> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zaandijk (gemeente Zaanstad) – Overige kerken"@nl ;
        min:adres "Lagedijk 24",
            "Parklaan 1",
            "Tuinstraat 27" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Zaanstad" ;
        min:gemeenteInBoek "Zaanstad" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaanstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zaandijk (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
