        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0185> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "531" ;
        schema:pageStart "531" ;
        schema:pagination "531" ;
        schema:text "Woonhuizen. Een voorbeeld van een eenvoudige 19de-eeuwse visserswoning is het gepleisterde pand Fransepad 1. Karakteristieke vroeg-20ste-eeuwse woningen zijn het met houten geveltopversiering en sierspant uitgevoerde huis Rustoord (Gasthuisstraat 1), het forse dubbelpand Gertrude (Julianaweg 15-17; 1904), de gepleisterde villa La Viola (Julianaweg 59) met torentje, en het aan een duinvoet gelegen blokvormige gepleisterde huis Santiago (Van Ogtropweg 16)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0185.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02134> a min:Passage,
            schema:CreativeWork ;
