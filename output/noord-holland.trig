        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Het voorm. R.K. St.-Jansziekenhuis (Eemnesserweg 14) is een groot gebouw uit circa 1910 met mansardedak en dakruiter. In ‘Um 1800’-stijl uitgevoerd zijn de ingangsportico en daarboven de dakerker met loggia. Het ziekenhuis is in 1993 verbouwd tot appartementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01457> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
        min:adres "Leemzeulder 35" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
