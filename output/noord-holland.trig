            "38472" ;
        min:soort "inleiding" ;
        min:volgnummer 2032 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0173> ;
        schema:name "Weesp"@nl ;
        schema:pageEnd "516" ;
        schema:pageStart "516" ;
        schema:pagination "516" ;
        schema:text "De voorm. R.K. schuilkerk (Achtergracht 13) heeft een voorgevel met blinde boogvensters. In 1687 werd een bestaand woonhuis voor de kerkdienst ingericht en in 1758 uitgebreid met een buurhuis (sacristie). Na de verkoop (1793) aan een letterkundig genootschap kwam het pand in 1893 in bezit van de gemeente als zaal ‘Eensgezindheid’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02033> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weesp"@nl ;
        min:adres "Nieuwstad 36",
            "Oudegracht 13" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Weesp" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weesp" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Weesp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10107> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "38580" ;
        min:soort "inleiding" ;
        min:volgnummer 2033 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0173> ;
        schema:name "Weesp"@nl ;
        schema:pageEnd "516" ;
        schema:pageStart "516" ;
        schema:pagination "516" ;
        schema:text "De Evang. Luth. kerk (Nieuwstad 36) is een zaalkerk uit 1818-'29, voorzien van spitsboogvensters en een voorgevel met Lodewijk XVI-elementen, balustrade en kleine houten klokkentoren. De inventaris dateert uit circa 1820, maar bevat ook enkele stukken uit de voorgaande Luth. kerk (1657), zoals een door Johannes Stephanus Strümphler gebouwd orgel (1769). De voorm. pastorie (Oudegracht 13), een herenhuis uit 1889, heeft een oudere gevelsteen met een zwaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0173.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02034> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weesp"@nl ;
        min:adres "Nieuwstraat 5" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
