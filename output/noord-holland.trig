            "Westerweg 50",
            "Willem Eggertstraat 7",
            "Wolthuissingel 1" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Purmerend" ;
        min:gemeenteInBoek "Purmerend" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Purmerend_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Purmerend" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
