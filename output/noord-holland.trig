        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79461>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79462>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79463> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511348",
            "511349",
            "511350" ;
        min:soort "lemma" ;
        min:volgnummer 2069 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0175> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "523" ;
        schema:pageStart "523" ;
        schema:pagination "523" ;
        schema:text "Boerderijen. De boerderij Boschrijk (Jisperweg 29; circa 1875) heeft als woongedeelte een wit gepleisterde eclectische villa met fraai snijwerk rond de geveltop. Op het erf staan verder een eenvoudige schuur en een wagenschuur of koetshuis uit de bouwtijd. De karakteristieke stolpboerderij Jisperweg 74 (circa 1870) heeft een eclectisch gedetailleerde voorgevel, voorzien van een hoger opgetrokken middenpartij met twee deuren. Achter bevindt zich een verlengde stalruimte."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02070> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerblokker (gemeente Hoorn)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hoorn" ;
