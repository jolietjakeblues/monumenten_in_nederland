        schema:name "Schagerbrug (gemeente Zijpe)"@nl ;
        schema:pageEnd "486" ;
        schema:pageStart "486" ;
        schema:pagination "486" ;
        schema:text "Het voorm. raadhuis (Grote Sloot 336), een tweelaags neorenaissancegebouw met een tot trapgevel opgetrokken middenrisaliet, werd in 1908 gebouwd naar ontwerp van P.N. Leguit en verbouwd in 1937 en 1960. Sinds 1995 dient het als woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0145.php> .

