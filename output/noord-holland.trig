        schema:pagination "413" ;
        schema:text "De voorm. pastorie (Dorpsstraat 44) is een wit gepleisterd dwars huis uit circa 1850 met acroteriën op de dakhoeken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0101.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01441> a min:Passage,
            schema:CreativeWork ;
