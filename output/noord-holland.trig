        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Boerderijen. Voorbeelden van stolpboerderijen zijn de met geblokte hoeklisenen uitgevoerde Maria Hoeve (Sluisweg 11; 1883) en de boerderij Koningsweg 76 (circa 1885) met neorenaissance-details en pilasters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00289> a min:Passage,
