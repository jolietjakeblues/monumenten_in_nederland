        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0137> ;
        schema:name "Oudkarspel (gemeente Langedijk)"@nl ;
        schema:pageEnd "471" ;
        schema:pageStart "471" ;
        schema:pagination "471" ;
        schema:text "De Herv. kerk (Dorpsstraat 878) is een driebeukige pseudobasilicale kerk met vijfzijdig gesloten koor en een toren zonder spits. De vrijwel onversierde toren is in de kern 13de-eeuws. Het schip kwam waarschijnlijk in de 14de eeuw tot stand en het koor rond 1500. Bij een ingrijpende verbouwing in 1868 pleisterde men het schip. De in 1969 geheel uitgebrande kerk is vervolgens sober herbouwd (J.A. Peters)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01744> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudkarspel (gemeente Langedijk)"@nl ;
        min:adres "Dorpsstraat 861" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Langedijk" ;
        min:gemeenteInBoek "Langedijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudkarspel (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudkarspel" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1744 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0137> ;
        schema:name "Oudkarspel (gemeente Langedijk)"@nl ;
        schema:pageEnd "471" ;
        schema:pageStart "471" ;
        schema:pagination "471" ;
        schema:text "Het voorm. rechthuis (Dorpsstraat 861) gaat terug tot 1618, werd in 1714 vernieuwd en in 1799 beschadigd. Het huidige gepleisterde diepe pand met bordes dateert uit 1808 (wapenstenen). Bij een restauratie in 1871 (geblokte lisenen) verrees links een brandspuithuisje. Na tot 1941 als raadhuis te hebben gediend is het gebouw in 1989 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01745> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudkarspel (gemeente Langedijk) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 857" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Langedijk" ;
        min:gemeenteInBoek "Langedijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudkarspel (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudkarspel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1745 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0137> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "471" ;
        schema:pageStart "471" ;
        schema:pagination "471" ;
        schema:text """Woonhuizen. Uitgevoerd in eclectische vormen is de voorm. onderwijzerswoning Dorpsstraat 882 (circa 1880). De tuinderswoning Dorpsstraat 980 (circa 1905) heeft een aangebouwde koolschuur. Jugendstil-details vertonen de huizen Voorburggracht 491 (circa 1910) en Dorpsstraat 917-919 (1913); het laatste is versierd met bricorna-steentjes.

De voorm. kolfbaan (Dorpsstraat 857), een langgerekt gebouw uit circa 1900, dient nu als garage."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01746> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudkarspel (gemeente Langedijk) – Waarland (gemeente Harenkarspel)"@nl ;
        min:adres "Kerkstraat 55",
            "Slootgaardweg 10a" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Langedijk" ;
        min:gemeenteInBoek "Langedijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Langedijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudkarspel (gemeente Langedijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudkarspel" ;
        min:lemma "Waarland (gemeente Harenkarspel)" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 1746 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0137> ;
        schema:name "Waarland (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "471" ;
        schema:pageStart "471" ;
        schema:pagination "471" ;
        schema:text "Waarland (gemeente Harenkarspel). Dit dorp ten noordoosten van Oudkarspel ontwikkelde zich vanaf 1910 als tuindersdorp. De R.K. St.-Wulframkerk (Kerkstraat 55) is een driebeukige basilicale kerk met dakruiter en portaal, gebouwd in 1921-'22 naar een traditionalistisch ontwerp van J.Th.J. Cuypers en P. Cuypers jr. De boerderij Veluweweg 2 (circa 1910) is een langhuisboerderij met siermetselwerk en sierspant. Poldermolens. In het dorp staat de poldermolen Hoebelaan 9, die tot 1951 de polder Waarland bemaalde. Deze met riet gedekte achtkantige binnenkruier op een met hout beklede voet stamt uit 1571 (verbouwd 1853). Ten noorden van het dorp staat de ‘Slootgaardmolen’ (Slootgaardweg 10a), een vergelijkbare poldermolen uit circa 1590 van de Slootgaardpolder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01747> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudorp (gemeente Alkmaar)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Alkmaar" ;
        min:gemeenteInBoek "Alkmaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alkmaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudorp (gemeente Alkmaar)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oudorp" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1747 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0138> ;
        schema:name "Oudorp (gemeente Alkmaar)"@nl ;
        schema:pageEnd "471" ;
        schema:pageStart "471" ;
        schema:pagination "471" ;
        schema:text "Dorp, ontstaan op een strandwal. Graaf Floris V stichtte hier vanaf 1278-'88 de dwangburchten de Middelburg met een rechthoekige toren en de Nieuwburg, bestaande uit een hoofdburcht met een hoofdtoren en een ommuurd voorhof, met ernaast een voorburcht. Beide kastelen werden in 1517 verwoest. Sinds 1972 behoort Oudorp tot de gemeente Alkmaar en is het aanzienlijk uitgebreid en aan Alkmaar vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0138.php> .

