        schema:name "Grootschermer (gemeente Schermer)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De voorm. openbare lagere school (Zuideinde 9) dateert uit circa 1870 en is een deels gepleisterd pand met ingebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01056> a min:Passage,
