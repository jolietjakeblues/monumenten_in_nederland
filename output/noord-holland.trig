        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0091> ;
        schema:name "Jisp (gemeente Wormerland)"@nl ;
        schema:pageEnd "402" ;
        schema:pageStart "402" ;
        schema:pagination "402" ;
        schema:text "De voorm. pastorie (Dorpsstraat 75), genaamd ‘Ghispesteijn’, werd in 1881 in eclectische stijl gebouwd naar plannen van P. Mager."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01355> a min:Passage,
            schema:CreativeWork ;
