        schema:name "Oostzaan"@nl ;
        schema:pageEnd "464" ;
        schema:pageStart "464" ;
        schema:pagination "464" ;
        schema:text "De Geref. kerk (Kerkbuurt 64), een kleine wit gepleisterde zaalkerk uit 1886, is gerestaureerd in 1961 en bevat een aan Hendrik Herman Hess toegeschreven kabinetorgel (1785, geplaatst 1923 gerestaureerd 1982)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01697> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostzaan"@nl ;
        min:adres "Zuideinde 36" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Oostzaan" ;
        min:gemeenteInBoek "Oostzaan" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oostzaan_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostzaan" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Oostzaan" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42947> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "31744" ;
