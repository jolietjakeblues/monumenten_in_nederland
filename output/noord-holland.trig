        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam" ;
        min:lemma "Overige kerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10580>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11743>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29359>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31247>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50051>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60902> ;
        min:provincie "Noord-Holland" ;
