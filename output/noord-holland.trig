        min:hoofdstuk "Steden, dorpen, monumenten › Ursem (gemeente Wester-Koggenland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Ursem" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1952 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0164> ;
        schema:name "Ursem (gemeente Wester-Koggenland)"@nl ;
        schema:pageEnd "504" ;
        schema:pageStart "504" ;
        schema:pagination "504" ;
        schema:text "Dorp, ontstaan in de 11de eeuw als veenontginning. De oorspronkelijk bij de kerk gelegen nederzetting verplaatste zich later zuidwaarts naar de Westfriese Omringdijk (Walingsdijk). Na de Tweede Wereldoorlog is het tussenliggende gebied bebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01953> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ursem (gemeente Wester-Koggenland)"@nl ;
        min:adres "Kerkpad 4" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Koggenland" ;
        min:gemeenteInBoek "Wester-Koggenland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Koggenland> ;
