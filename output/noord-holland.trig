        min:hoofdstuk "Steden, dorpen, monumenten › Zaandam (gemeente Zaanstad)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Zaandam" ;
        min:lemma "Horeca" ;
        min:provincie "Noord-Holland" ;
        min:soort "lemma" ;
        min:volgnummer 2198 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill786> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0190> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "544" ;
        schema:pageStart "544" ;
        schema:pagination "544" ;
        schema:text "Horeca. Het huidige café Het Wapen van Friesland (Dam 28) [26] werd na brand in 1909 herbouwd in neorenaissance-stijl met rationalistische details en was oorspronkelijk de levensmiddelenzaak van de firma C. Keg (opgericht 1832). Het met bovenwoningen uitgevoerde café Het Wapen van Amsterdam (Dam 8) [27] heeft men in 1911 herbouwd, nadat het oude - van oorsprong 17de-eeuwse - gebouw door brand was verwoest. Een tegeltableau in de geveltop vermeldt de cafénaam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02199> a min:Passage,
            schema:CreativeWork ;
