        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16700> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "515975" ;
        min:soort "lemma" ;
        min:volgnummer 950 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill373> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0061> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "284" ;
        schema:pagination "284-285" ;
        schema:text """Raadhuizen. Het 17de-eeuwse dwarse eenlaagspand Slotweg 42 heeft mogelijk als rechthuis gediend. In 1871 bouwde men als raadhuis van de gemeente Egmond-Binnen het diepe eenlaagspand bij Slotweg 46 met kleine klokkentoren. Het rond 1959 opgetrokken raadhuis Herenweg 181, mogelijk ontworpen door B. Blokker, heeft tot 1978 dienst gedaan.

De voorm. openbare lagere school (Slotweg 46) is een tweeklassige middengangschool, gebouwd in 1959 naar ontwerp van B. Blokker."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0061.php> .

