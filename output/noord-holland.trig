        min:kern "Schardam" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 1830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0146> ;
        schema:name "Schardam (gemeente Zeevang)"@nl ;
        schema:pageEnd "487" ;
        schema:pageStart "487" ;
        schema:pagination "487" ;
        schema:text "Dijkdorp, ontstaan bij de in de eerste helft van de 14de eeuw aangelegde Schardam. Deze dam met sluis lag aan het einde van de Korssloot, die als uitwatering diende van Kennemerland, via de onbedijkte Beemster. De bedijkte Beemster (1612) kreeg een aparte uitwatering noordelijker langs de Oudendijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01831> a min:Passage,
