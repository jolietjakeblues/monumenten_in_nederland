        min:kern "Laren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16443>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59917> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511270",
            "511274" ;
        min:soort "inleiding" ;
        min:volgnummer 1452 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "De R.K. St.-Jansbasiliek (Brink 31) is een driebeukige basilicale kruiskerk met een driezijdig gesloten koor met omgang, een forse achtzijdige vieringkoepel en een imposant tweetorenfront met vooruitspringende ingangspartij. Deze neogotische kerk met expressionistische elementen kwam in 1924-'25 tot stand naar ontwerp van W. te Riele en verving een kerk uit 1844 (uitgebreid 1882). In 1937 is de kerk verheven tot ‘basilica minor’, vanwege het H. Sacrament dat - officieel sinds 1886 - jaarlijks in de St.-Jansprocessie naar het St.-Janskerkhof wordt gevoerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01453> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Laren"@nl ;
        min:adres "Brink 29",
            "Brink 33" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Laren" ;
        min:gemeenteInBoek "Laren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Laren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Laren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Laren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16255>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37043>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40847> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "511272",
            "511273",
            "511275" ;
        min:soort "inleiding" ;
        min:volgnummer 1453 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0102> ;
        schema:name "Laren"@nl ;
        schema:pageEnd "415" ;
        schema:pageStart "415" ;
        schema:pagination "415" ;
        schema:text "Tot de inventaris behoren een hoofdaltaar uit de bouwtijd, kruiswegstaties van P.C. de Moor (1923-'28) en een door L. Brom vervaardigd bronzen beeld van St. Johannes de Doper (1933). De gebrandschilderde vensters zijn van H. Bijvoet. De pastorie (Brink 33; circa 1924) is een sober expressionistisch ontwerp van H.F. Smit. Op de plaats waar de oude R.K. St.-Janskerk uit 1844 stond heeft men rond 1925 een bakstenen muur met gedenkstenen opgetrokken (bij Brink 29)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01454> a min:Passage,
            schema:CreativeWork ;
