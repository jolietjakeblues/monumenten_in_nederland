        min:soort "inleiding" ;
        min:volgnummer 2004 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0170> ;
        schema:name "Warder (gemeente Zeevang)"@nl ;
        schema:pageEnd "512" ;
        schema:pageStart "512" ;
        schema:pagination "512" ;
        schema:text "Dorp, ontstaan eind 12de eeuw als veenontginning in de Polder Zeevang. De bebouwing van dit langgerekte lintdorp is later wat dichter geworden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02005> a min:Passage,
