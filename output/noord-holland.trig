        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill551> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0090> ;
        schema:name "Ilpendam (gemeente Waterland)"@nl ;
        schema:pageEnd "402" ;
        schema:pageStart "401" ;
        schema:pagination "401-402" ;
        schema:text "De R.K. St.-Sebastianuskerk (bij Dorpsstraat 58) is een eenbeukige kerk met driezijdig gesloten koor en een half-ingebouwde toren met achtzijdige spits. Deze door Th. Asseler met neogotische en neoromaanse elementen ontworpen kerk verving in 1871 een kerk uit 1824. De pastorie (Dorpsstraat 58) is eveneens uit 1871."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0090.php> .

