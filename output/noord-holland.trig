        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0077> ;
        schema:name "Heiloo"@nl ;
        schema:pageEnd "359" ;
        schema:pageStart "359" ;
        schema:pagination "359" ;
        schema:text "Het raadhuis (Raadhuisweg 4), een robuust pand met middenrisaliet en tentdak met dakruiter, werd gebouwd in 1927 naar ontwerp van D. Saal. De raadzaal heeft men in 1998 vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01193> a min:Passage,
