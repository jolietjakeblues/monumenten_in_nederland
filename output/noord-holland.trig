        schema:name "Lijnden (gemeente Haarlemmermeer)"@nl ;
        schema:pageEnd "419" ;
        schema:pageStart "419" ;
        schema:pagination "419" ;
        schema:text "Dorp in de Haarlemmermeerpolder, ontstaan kort na 1852 bij de kruising van de Hoofdvaart met de Ringdijk. Een tweede bebouwingskern verrees bij de kruising met de Spaarnwoudertocht (Schipholweg)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01477> a min:Passage,
            schema:CreativeWork ;
