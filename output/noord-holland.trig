        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66269> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "510003" ;
        min:soort "lemma" ;
        min:volgnummer 1828 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0145> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "486" ;
        schema:pageStart "486" ;
        schema:pagination "486" ;
        schema:text "Boerderijen. De stolpboerderij Dorpzicht (Grote Sloot 359), met spiegel en dakerker, dateert uit 1893. De stolpboerderij Uit den Haak (Grote Sloot 254), met spiegel en festoenvormige versieringen boven de vensters, werd in 1898-'99 gebouwd ter vervanging van een afgebrande voorganger. Vlakbij staat de bijbehorende landarbeiderswoning Grote Sloot 256 (circa 1910)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01829> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schagerbrug (gemeente Zijpe) – Poldermolens"@nl ;
        min:adres "Grote Sloot 252",
            "Grote Sloot 414",
            "Ruigeweg 101" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Schagen" ;
        min:gemeenteInBoek "Zijpe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Schagen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schagerbrug (gemeente Zijpe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Schagerbrug" ;
        min:lemma "Poldermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45074>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61178>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66270>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66271>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66272> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "41928",
            "41930",
            "509993",
            "509994",
            "510002" ;
        min:soort "lemma" ;
        min:volgnummer 1829 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill689>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill690> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0145> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "487" ;
        schema:pageStart "486" ;
        schema:pagination "486-487" ;
        schema:text """Poldermolens. Van de tien resterende poldermolens in de Zijpe- en Hazepolder staan er twee in de omgeving van Schagerbrug. Het zijn achtkante binnenkruiers met een met riet gedekte kap en romp op een met hout beklede voet. De molen Ooster-N (Ruigeweg 101) stamt waarschijnlijk uit 1740 en de molen D (Grote Sloot 414) uit 1839-'40.

Het weeshuis ‘Huize van Strijen’ (Grote Sloot 252), gelegen ten zuidwesten van Schagerbrug, werd gesticht rond 1730 toen de weduwe Van Strijen een uit 1628 daterende boerderij aan het polderbestuur schonk om als weeshuis te dienen. Na een boerderijbrand in 1895 verrees in 1896-'97 het huidige tweelaagse gebouw met neorenaissance-elementen naar plannen van K. Bakker. De hekpaalbekroningen met putti en wapenschilden zijn midden-18de-eeuws."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01830> a min:Passage,
