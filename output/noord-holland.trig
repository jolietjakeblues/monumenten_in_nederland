        schema:pageEnd "555" ;
        schema:pageStart "555" ;
        schema:pagination "555" ;
        schema:text "Woonhuizen. Een voorbeeld van een sober middenganghuis uit circa 1870 is Dorpsstraat 186. Een chaletstijlsierspant en een erker bezit het huis Beau Regard (Dorpsstraat 111) uit 1917."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02266> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zwaag (gemeente Hoorn) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 14",
            "Dorpsstraat 148",
            "Dorpsstraat 7",
            "Dorpsstraat 85",
            "Zwaagdijk-West 404" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Hoorn" ;
        min:gemeenteInBoek "Hoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zwaag (gemeente Hoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Zwaag" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13951> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "22619" ;
        min:soort "lemma" ;
        min:volgnummer 2266 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0198> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "555" ;
        schema:pageStart "555" ;
        schema:pagination "555" ;
        schema:text """Boerderijen. De laat-18de-eeuwse Geertjehoeve (Dorpsstraat 7) is een stolphoeve met terugliggende darsdeur. In het midden van het overige deel van de voorgevel bevindt zich een pronkdeur in Lodewijk XVI-stijl met daarboven een (niet oorspronkelijke) houten klokgevel. Uit de 19de eeuw dateren de stolpboerderijen Wulframhoeve (Dorpsstraat 14; circa 1840), met dwarseind en een houten middentop boven het woongedeelte, en Mariahoeve (Dorpsstraat 148; circa 1860) met laat-18de-eeuws aandoende (niet oorspronkelijke) middenklokgevel.

Het voorm. station (Dorpsstraat 85) werd in 1886 gebouwd voor de Locaalspoorwegmaatschappij ‘Hollands Noorderkwartier’ aan de lijn Hoorn-Medemblik. Dit door A.J. Krieger ontworpen langwerpige eenlaagspand heeft een uitgebouwd wisselwachterslokaal.

De R.K. St.-Jacobus de Meerderekerk van Zwaagdijk-West (Zwaagdijk-West 404), gelegen ten noordwesten van Zwaag, is een sobere driebeukige kerk in traditionalistische stijl, gebouwd in 1929 naar plannen van Jos. Bekkers. Wegens geldgebrek is de geplande toren niet gebouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/02267> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beknopte literatuuropgave"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Beknopte literatuuropgave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:provincie "Noord-Holland" ;
        min:soort "alinea" ;
        min:volgnummer 2267 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0199> ;
        schema:name "Beknopte literatuuropgave"@nl ;
        schema:pageEnd "556" ;
        schema:pageStart "556" ;
        schema:pagination "556" ;
        schema:text "Van alle voor dit boek geraadpleegde literatuur kan hier slechts een gering deel genoemd worden. De literatuuropgave is eerder een hulpmiddel voor de lezer die zich verder in de materie wil verdiepen, dan een verantwoording van de inhoud van dit boek. In de onderstaande lijst is de gebruikte algemene literatuur opgenomen, aangevuld met de voor de provincie belangrijkste publicaties op architectuurgebied."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0199.php> .

