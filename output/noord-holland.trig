        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill554>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill555> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0092> ;
        schema:name "Kleine Sluis (gemeente Anna Paulowna)"@nl ;
        schema:pageEnd "404" ;
        schema:pageStart "403" ;
        schema:pagination "403-404" ;
        schema:text "De R.K. kerk H. Maria Presentatie (Nieuweweg 15) werd in 1870-'71 gebouwd naar een ontwerp met eclectische details van Th. Asseler als een eenbeukige kerk met kleine ranke houten geveltoren. Transept en koor kwamen in 1919 tot stand naar ontwerp van A.J. Joling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01364> a min:Passage,
            schema:CreativeWork ;
