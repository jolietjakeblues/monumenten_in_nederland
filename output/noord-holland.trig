        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gooise_Meren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Muiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Muiden" ;
        min:lemma "Winkels" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16160> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30127" ;
        min:soort "lemma" ;
        min:volgnummer 1584 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0115> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "444" ;
        schema:pageStart "444" ;
        schema:pagination "444" ;
        schema:text "Winkels. Het oorspronkelijk vroeg-17de-eeuwse en met een opkamer uitgevoerde pand De Hoek (Weesperstraat 1) diende vanaf 1659 als herberg en vanaf 1774 als bakkerij. Na 1822 waren hier andere winkels gevestigd. Het midden-19de-eeuwse pand Herengracht 60 is voorzien van een etalagekast. De winkels Herengracht 64 en 73-74 hebben winkelpuien in neorenaissance-stijl (beide circa 1890)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/01585> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Muiden – Horeca"@nl ;
        min:adres "Herengracht 71",
            "Herengracht 72",
            "Sluisstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Gooise Meren" ;
        min:gemeenteInBoek "Muiden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gooise_Meren> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Muiden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Muiden" ;
        min:lemma "Horeca" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17802>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18041>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38476> ;
        min:provincie "Noord-Holland" ;
        min:rijksmonumentnummer "30116",
            "30117",
            "30125" ;
        min:soort "lemma" ;
        min:volgnummer 1585 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0115> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "444" ;
        schema:pageStart "444" ;
        schema:pagination "444" ;
        schema:text """Horeca. Bij de sluis stonden vanouds diverse herbergen en logementen. De Gooise Boer (Herengracht 71) [13], een diep pand met afgetopte lijstgevel, werd verbouwd in 1756 (gevelbeeld) en was vanaf 1810 in gebruik als café. Een 18de-eeuws uiterlijk heeft het na een brand in 1994 herbouwde restaurant Graaf Floris V van Muiden (Herengracht 72) [14], vroeger ‘Het Hof van Holland’. Het restaurant De Doelen (Sluisstraat 2) [15] ontstond in 1668 als woonhuis en huisvestte vanaf 1729 de herberg ‘De Nieuwe Doelen’. In 1812 werd het pand in zijn huidige vorm herbouwd met geblokte hoekrisalieten en middenrisaliet.

De voorm. smederij Naarderstraat 6 is een eind 20ste eeuw ingrijpend vernieuwd, maar in de kern mogelijk 17de-eeuws gebouw met woning, smederij en houten travalje met opschrift ‘zolang er paarden bestaan, zal ik er hoefijzers onder slaan - Jan Melis’."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0115.php> .

