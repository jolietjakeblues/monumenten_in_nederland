        min:soort "inleiding" ;
        min:volgnummer 1995 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill731>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill732> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0169> ;
        schema:name "Volendam (gemeente Edam-Volendam)"@nl ;
        schema:pageEnd "512" ;
        schema:pageStart "511" ;
        schema:pagination "511-512" ;
        schema:text "De Herv. kerk (Zuideinde 54), een op een stolpboerderij lijkende vierkante houten kerk met tentdak en dakruiter, werd in 1658 gebouwd door de Hoornse molenmaker Adriaen Jansz Nieng. Het middengedeelte heeft een geschilderd houten gewelf. In een van de vier buitenstijlruimten bevinden zich een portaal en de consistoriekamer. Tot de inventaris behoort een vroeg-17de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0169.php> .

