        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0056> ;
        schema:name "Dirkshorn (gemeente Harenkarspel)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Het voorm. raadhuis van Harenkarspel (Raadhuisstraat 1) werd in 1870 naar plannen van J.H. Vlaming gebouwd als een neoclassicistisch pand met souterrain en bordestrap. Het souterrain diende aanvankelijk als secretariswoning. In 1930 heeft men de raadzaal op de beletage vergroot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0056.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00902> a min:Passage,
            schema:CreativeWork ;
