        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerblokker (gemeente Hoorn)" ;
