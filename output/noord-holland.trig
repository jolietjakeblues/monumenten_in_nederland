        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/afbeelding/sten009monu11ill262> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0021> ;
        schema:name "Amsterdam-Sloterdijk (gemeente Amsterdam)"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "De (Herv.) Petruskerk (Spaarndammerdijk 681) [368] is een eenbeukige, recht gesloten, kerk voorzien van een ingebouwde toren van twee geledingen met houten lantaarn en spits. De laat-gotische toren is, evenals de zware steunberen bij het schip, een restant van een kerk uit circa 1479, die in 1664 plaats maakte voor de huidige kerk naar plannen van Gerrit Jacobse. In de toren hangt een door Wilhelmus en Jasper Moer gegoten klok (1516). De kerk is gerestaureerd in 1990-'92."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/passage/00598> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Amsterdam-Sloterdijk (gemeente Amsterdam)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Holland" ;
        min:gemeente "Amsterdam" ;
        min:gemeenteInBoek "Amsterdam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Amsterdam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Holland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Amsterdam-Sloterdijk (gemeente Amsterdam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01> ;
        min:kern "Amsterdam-Sloterdijk" ;
        min:provincie "Noord-Holland" ;
        min:soort "inleiding" ;
        min:volgnummer 598 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu11_01/hoofdstuk/0021> ;
        schema:name "Amsterdam-Sloterdijk (gemeente Amsterdam)"@nl ;
        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "Tussen de steunberen aan de buitenzijde bevinden zich enkele graftomben, waaronder die voor Engeltje Westerborgh († 1792). Het bijbehorende kerkhof bevat onder meer een zuil op postament voor W. Hogenes-Van Staveren († 1940) en een neoclassicistisch mausoleum met op het fronton een omfloerste urn. Dit mausoleum werd in 1888 opgericht voor L. Jonker, directeur van de Fabriek voor Stoom- en Andere Werktuigen op Bickerseiland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu11_01/sten009monu11_01_0021.php> .

