    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01285> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reusel (gemeente Reusel-De Mierden)"@nl ;
        min:adres "Kerkstraat 1",
            "Markt 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Reusel-De Mierden" ;
        min:gemeenteInBoek "Reusel-De Mierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Reusel-De_Mierden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reusel (gemeente Reusel-De Mierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Reusel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1285 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0143> ;
        schema:name "Reusel (gemeente Reusel-De Mierden)"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "282" ;
        schema:pagination "282-283" ;
        schema:text "De R.K. kerk H. Maria Hemelvaart (Markt 2) is een driebeukige neogotische kruiskerk uit 1895-'96, gebouwd naar ontwerp van P.J. Bekkers en A. Bruning. In de Tweede Wereldoorlog werd de kerk beschadigd. Bij het herstel heeft men de toren in gewijzigde vorm herbouwd. De kerk bevat een omstreeks 1800 gebouwd koororgel van F.B. Loret, afkomstig uit de Waalse kerk te Dordrecht. De pasto-rie (Kerkstraat 1), bestaande uit twee haaks geplaatste vleugels, dateert uit omstreeks 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01286> a min:Passage,
