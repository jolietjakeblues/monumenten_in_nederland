        min:gemeenteInBoek "Roosendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roosendaal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roosendaal" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Roosendaal" ;
        min:lemma "Nispen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1323 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0149> ;
        schema:name "Nispen"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "Nispen. Dit dorp ten zuiden van Roosendaal wordt in 1157 voor het eerst vermeld. In 1944 werd het grotendeels verwoest. De R.K. Maria Hemelvaartkerk (Kerkplein 1) is een driebeukige basilicale kerk met tripletvensters, in 1930 gebouwd naar ontwerp van J.Th.J. Cuypers in late gotiserende trant. De van de voorganger gehandhaafde 17de-eeuwse westtoren werd in 1944 opgeblazen. De huidige toren dateert uit 1958 en is een ontwerp van J. van Elst. De windmolen Dorpsstraat 26 is een ronde bakstenen beltkorenmolen uit 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01324> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rosmalen (gemeente 's-Hertogenbosch)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "'s-Hertogenbosch" ;
        min:gemeenteInBoek "'s-Hertogenbosch" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/'s-Hertogenbosch> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rosmalen (gemeente 's-Hertogenbosch)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Rosmalen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1324 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0150> ;
        schema:name "Rosmalen (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "289" ;
        schema:pageStart "289" ;
        schema:pagination "289" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen op een dekzandrug ten zuiden van de Maas. Omstreeks 815 wordt het voor het eerst genoemd en in 1293 was er sprake van een zelfstandige parochie. Vanuit de buurtschappen Kerkenhoek, Molenhoek en Varkenshoek ontwikkelde zich rondom de kerk een dorpskern. Ten zuiden hiervan werd in 1823-'25 de steenweg Den Bosch-Grave aangelegd, in 1881 gevolgd door de spoorlijn 's-Hertogenbosch-Nijmegen. Overstromingen van de Maas en de jaarlijkse wateroverlast van de Beerse Overlaat beperkten de ontwikkelingsmogelijkheden. Na de Tweede Wereldoorlog ontwikkelde Rosmalen zich als forenzendorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0150.php> .

