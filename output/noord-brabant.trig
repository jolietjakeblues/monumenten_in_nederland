        min:kern "Woensdrecht-Hoogerheide" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1655 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0195> ;
        schema:name "Woensdrecht-Hoogerheide"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De R.K. kerk O.L. Vrouwe Hemelvaart (Raadhuisstraat 134, Hoogerheide) is een neogotische kruiskerk met hoge toren voorzien van spits, gebouwd in 1882 naar ontwerp van J.J. van Langelaar en in 1910 uitgebreid naar plannen van J. van Gils. De pastorie (Raadhuisstraat 132) dateert uit omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01656> a min:Passage,
            schema:CreativeWork ;
