        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 13-15) is een neoclassicistisch blokvormig pand met middenrisaliet en fronton uit 1875. Iets terugspringend is het burgemeestershuis aangebouwd in dezelfde trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

