        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterhout" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oosterhout" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59513> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "31680" ;
        min:soort "inleiding" ;
        min:volgnummer 1199 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill404> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0132> ;
        schema:name "Oosterhout"@nl ;
        schema:pageEnd "269" ;
        schema:pageStart "268" ;
        schema:pagination "268-269" ;
        schema:text "De Herv. kerk (Rulstraat 6) is een centraalbouw in de vorm van een Grieks kruis, gebouwd in 1810-'11 naar ontwerp van Herman Huysers. Het interieur heeft houten tongewelven. De kerk bezit enkele belangrijke inventarisstukken. De rijk gesneden eikenhouten preekstoel, die sterke overeenkomst vertoont met de preekstoel in de Luth. kerk te 's-Hertogenbosch, dateert uit het eerste kwart van de 17de eeuw. Deze preekstoel en de drie gegoten koperen kaarsenkronen (1629, 1637 en 1642) bevonden zich oorspronkelijk in de St.-Janskerk. Het orgel is in 1753 gebouwd door Jean Moreau; de kast met weelderig rococo snijwerk is van de hand van Willem Dübblens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01200> a min:Passage,
