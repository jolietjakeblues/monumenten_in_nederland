        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De voorm. pastorieën bij de opgeblazen kerken bleven bewaard; Kerkpad 3 te Kessel dateert uit 1873 en Oude Pastoriestraat 5 te Maren uit 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0111.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01061> a min:Passage,
            schema:CreativeWork ;
