        min:kern "Breda" ;
        min:lemma "Brug" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 446 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0030> ;
        schema:name "Brug"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "Brug (Marksingel/van de Hamsingel ong.) Om de bereikbaarheid van zijn fabriek voor voetgangers en fietsers te verbeteren, liet fabrikant L.A. Hirdes door F.A. Seegeren in 1905 een betonbrug over de Mark ontwerpen. De leuningen zijn uitgevoerd in gewapend beton en dienen tegelijk als hoofdliggers waarop de vloerplaten hangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00447> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Breda – Watertorens"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Breda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Breda" ;
        min:lemma "Watertorens" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 447 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0030> ;
        schema:name "Watertorens"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "Watertorens. De voorm. watertoren Wilhelminasingel 19 [31] met uitgekraagd reservoirgedeelte is in 1894-'96 naar ontwerp van J. Schotel opgetrokken in neorenaissance-stijl met natuurstenen sierdelen. In de verbouwde toren is sinds 1977 een kantoor gevestigd. De watertoren Speelhuislaan 158 uit 1934 is een ontwerp van stadsbouwmeester P.A.H. Hornix en een kenmerkend voorbeeld van het functionalisme. De twee cirkelvormige betonnen vlakbodemreservoirs rusten op een betonnen draagconstructie, het geheel omhuld door een sober vormgegeven bakstenen schild. Het aangebouwde trappenhuis heeft de vorm van een afgeplatte cilinder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0030.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00448> a min:Passage,
