        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1370 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0157> ;
        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Het voorm. klein-seminarie Beekvliet (Beekvlietstraat 5), nu bejaardentehuis, is een langgerekt gebouw met kapel en slanke toren uit 1905-'07, opgetrokken naar ontwerp van W.Th. van Aalst. In 1918 werd het gebouw aan de zuidzijde verlengd. Het al uit 1865 stammende landschappelijke park van het (afgebroken) landhuis Beekvliet is inmiddels voor een groot gedeelte bebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01371> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Michielsgestel"@nl ;
        min:adres "Theerstraat 42" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint-Michielsgestel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint-Michielsgestel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1371 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0157> ;
        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Het doveninstituut (Theerstraat 42) is een imposant U-vormig complex met hoek- en middenpaviljoens, gebouwd in 1908-'10 naar ontwerp van J. van Groenendael in een laat-neogotische stijl met jugendstil-elementen. Het is een goed voorbeeld van een monumentaal katholiek gestichtsgebouw. De symmetrische bouw weerspiegelt de oorspronkelijke scheiding in een jongens- en een meisjesgedeelte. De rijk versierde ingang wordt geflankeerd door stenen leeuwen met de wapens van Sint-Michielsgestel en aan de bovenzijde bekroond door twee engelen. Het complex ligt in een landschappelijk aangelegd park met voor de ingang een door M. van Bokhoven gemaakt beeld van ter ere van de stichter Marinus van Beek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01372> a min:Passage,
