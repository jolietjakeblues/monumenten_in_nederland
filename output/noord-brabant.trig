        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01549> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierlingsbeek"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxmeer" ;
        min:gemeenteInBoek "Vierlingsbeek" ;
