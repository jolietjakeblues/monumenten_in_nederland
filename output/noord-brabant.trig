        schema:name "Vrijhoeve-capelle (gemeente Waalwijk)"@nl ;
        schema:pageEnd "322" ;
        schema:pageStart "322" ;
        schema:pagination "322" ;
        schema:text "De Herv. kerk (Zuidhollandsedijk 63, Lage Zandschel) is een sober zaalgebouw uit 1804, waarvan de voorgevel in 1951 is vernieuwd. Het interieur bevat een neobarok orgel van P.J. Tadema (tweede helft 19de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0185.php> .

