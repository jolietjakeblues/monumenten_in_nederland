            "Stationsstraat 4" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "'s-Hertogenbosch" ;
        min:gemeenteInBoek "'s-Hertogenbosch" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/'s-Hertogenbosch> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rosmalen (gemeente 's-Hertogenbosch)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Rosmalen" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60182> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32719" ;
        min:soort "lemma" ;
        min:volgnummer 1327 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0150> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text """Woonhuizen. In het dorp staan enkele neoclassicistische blokvormige landhuizen uit de tweede helft van de 19de eeuw, zoals Sparrenburg (Sparrenburgstraat 5) en Vreeburg (Dorpsstraat 66) uit omstreeks 1890. Villa Hoog Oord (Stationsstraat 2) en Driesprong 11, beide uit omstreeks 1870, hebben een rijkere eclectische decoratie.

De windmolen (Molenstraat 17), een gesloten standerdkorenmolen, werd mogelijk gebouwd in 1732. De in 1996 gerestaureerde molen heeft inwendig inscripties uit 1774 en 1801.

Het voorm. station (Stationsstraat 4) van de Nederlandsche Zuid-Ooster Spoorweg-Maatschappij werd in 1880 in neoclassicistische stijl gebouwd en later verhoogd. In de zijgevel staat nog de stationsnaam ‘Rosmalen’ vermeld."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01328> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rosmalen (gemeente 's-Hertogenbosch) – Boerderijen"@nl ;
        min:adres "Berlicumseweg 10",
            "Berlicumseweg 4",
            "Berlicumseweg 8",
            "Berlicumseweg 9-11",
            "Vliertwijksestraat 63" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "'s-Hertogenbosch" ;
        min:gemeenteInBoek "'s-Hertogenbosch" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/'s-Hertogenbosch> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rosmalen (gemeente 's-Hertogenbosch)" ;
