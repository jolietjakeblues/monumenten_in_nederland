        min:hoofdstuk "Steden, dorpen, monumenten › Budel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 455 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Budel"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen als een samenstel van agrarische nederzettingen in het beekdal van de Buulder Aa. In 1421 werd Budel bij de Meijerij van Den Bosch ingelijfd. Vanouds vormde de Markt met omgeving het centrum. Hier vestigden zich in de 18de eeuw reizende kooplieden, de zogeheten teuten. Aan het eind van de 19de eeuw en vooral na de Tweede Wereldoorlog is dit centrum sterk uitgegroeid. Bij de spoorlijn Mol-Weert kwam in de 19de eeuw het dorp Budel-Schoot tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00456> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel"@nl ;
        min:adres "Dr. A. Mathijsenstraat 7" ;
