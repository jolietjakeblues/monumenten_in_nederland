        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0110> ;
        schema:name "Made"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De R.K. St.-Bernarduskerk (Kerkstraat 8) is een driebeukige kruisbasiliek, gebouwd in 1870 naar ontwerp van J. Verheyen. De lichtbeuk is voorzien van roosvensters. De pastorie (Kerkstraat 6) verrees gelijktijdig en naar plannen van dezelfde architect."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0110.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01056> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Made"@nl ;
        min:adres "Zuideindsestraat 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Drimmelen" ;
