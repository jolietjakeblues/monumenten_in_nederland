        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "22248" ;
        min:soort "lemma" ;
        min:volgnummer 969 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0092> ;
        schema:name "Casteren"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Casteren. Dit lintvormig akkergehucht ten westen van Hoogeloon ontstond in de middeleeuwen. De R.K. St.-Willibrordkerk (Kerkstraat 31) is een neoromaanse kruiskerk met toren, gebouwd in 1907-'08 naar ontwerp van C. Franssen. In 1935 kreeg het schip zeer lage zijbeuken naar plannen van J. Franssen. De pastorie (Kerkeneind 29) dateert eveneens uit 1908."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00970> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huijbergen (gemeente Woensdrecht)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
