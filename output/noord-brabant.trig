        min:kern "De Heen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79087> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "30610" ;
        min:soort "inleiding" ;
        min:volgnummer 492 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0036> ;
        schema:name "De Heen (gemeente Steenbergen)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "De Heensche molen of ‘De Vos’ (Rijksweg 51), gelegen ten westen van het dorp, is een ronde bakstenen grondzeiler uit 1714. Het molenaarshuis, een gepleisterd eenlaagspand met zadeldak, draagt de jaartalankers ‘1709’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00493> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "De Heen (gemeente Steenbergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › De Heen (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "De Heen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 493 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0036> ;
        schema:name "De Heen (gemeente Steenbergen)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "128" ;
        schema:pagination "128-129" ;
        schema:text "De sluis (Beneden Sasweg ong.) in de Roosendaalse en Steenbergse Vliet, gelegen ten noordwesten van het dorp, is een uit omstreeks 1825 daterend complex van schut- en uitwateringssluizen. Het complex heeft gemetselde sluishoofden met houten waaierdeuren. Aan de rivierzijde van het benedensluishoofd bevinden zich houten puntdeuren. Een hardstenen gedenksteen uit 1833 van het Hoogheemraadschap van de Roosendaalse en Steenbergse Vliet memoreert de toevoeging van het bovensluishoofd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Dungen (gemeente Sint-Michielsgestel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Den Dungen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 494 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0037> ;
        schema:name "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Dorp ontstaan in de middeleeuwen als beekdalnederzetting op een drietal zandopduikingen in het stroomgebied van de Aa. Ter bescherming tegen de voortdurende wateroverlast kwam aan het begin van de 17de eeuw een ringdijk gereed: de Poeldonkse- en Hooidonksedijk. Op de samenkomst van Litserstraat, Bosscheweg en Maaskantje verrees in 1451 een kapel. De daaromheen ontstane bebouwing verdichtte zich na 1900, waardoor de buurtschap Maaskantje één geheel ging vormen met Den Dungen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00495> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        min:adres "H. Hartplein 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Dungen (gemeente Sint-Michielsgestel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Den Dungen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51950> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "14191" ;
        min:soort "inleiding" ;
        min:volgnummer 495 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill165>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill166> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0037> ;
        schema:name "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "De R.K. kerk St.-Jacobus de Meerdere (H. Hartplein 1) is een driebeukige kruisbasiliek met een vroeg-16de-eeuws, driezijdig gesloten koor en een schip dat, getuige een sluitsteen met jaartal in de zuiderzijbeuk, in 1533 moet zijn voltooid. In 1821 werd het 16de-eeuwse transept vervangen. In plaats van een in 1733 gesloopte traptoren ontwierp C. Franssen de in 1899 opgetrokken westtoren van vier geledingen met achtzijdige naaldspits en flankerende torentjes. Naar plannen van J.Th.J. Cuypers werd de kerk in 1927 uitgebreid met nieuwe, driezijdig gesloten dwarsarmen en zijkapellen aan weerszijden van het koor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00496> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Dungen (gemeente Sint-Michielsgestel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Den Dungen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 496 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0037> ;
        schema:name "Den Dungen (gemeente Sint-Michielsgestel)"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "Inwendig worden de beuken van het schip gescheiden door achtkante pijlers met spitse scheibogen. De netgewelven van het koor lopen in het muurwerk te niet; die van het schip rusten op neoclassicistische consoles uit 1821. De barokke preekstoel uit omstreeks 1800, met een kuip gedragen door een beeld van Johannes de Doper, werd gemaakt door P. Dieltjes en van beeldhouwwerk voorzien van J.B. van Hool. De neoclassicistische biechtstoelen werden in 1842 gesneden door J.F. Buijssen. Voorts bevat de kerk diverse beelden, waaronder een sierlijk vormgegeven St.-Barbarabeeld uit 1780, en diverse schilderijen, waaronder een laat-16de-eeuws Laatste Avondmaal door Carel van Mander. De kruisweg uit omstreeks 1900 is van de hand van H. van der Geld. Het orgel werd tussen 1830 en 1855 door F.C. Smits gebouwd en in 1899 omgebouwd. Het is afkomstig van voormalige groot-seminarie Haarendael te Haaren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00497> a min:Passage,
