        schema:text "Het voorm. raadhuis (Dorpsstraat 16) dateert uit 1937 en is gebouwd in traditionele trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0135.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01236> a min:Passage,
