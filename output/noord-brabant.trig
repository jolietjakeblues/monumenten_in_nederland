        min:soort "inleiding" ;
        min:volgnummer 570 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0049> ;
        schema:name "Eersel"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "De Herv. kerk (Markt 38) is een eenvoudig bakstenen zaalkerkje met dakruiter en driezijdig gesloten kopse gevels. De kerk stamt oorspronkelijk uit 1812, maar werd in 1861 herbouwd. De preekstoel met koperen lezenaar en zandloperhouder is 18de-eeuws."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00571> a min:Passage,
