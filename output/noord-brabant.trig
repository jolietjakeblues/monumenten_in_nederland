        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ravenstein" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ravenstein" ;
        min:lemma "Vestingwerken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35745> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32325" ;
        min:soort "lemma" ;
        min:volgnummer 1274 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill431> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0141> ;
        schema:name "Vestingwerken"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "281" ;
        schema:pagination "281-282" ;
        schema:text "Vestingwerken. De Kasteelse poort (Kasteelse plaats 1) is de westelijke toegang naar de voorburcht van het in 1818 gesloopte kasteel van de heren van Ravenstein. De kern van de poort gaat terug tot 1522-'26. Aan het begin van 17de eeuw kwam er een woning bij, die in de 18de eeuw aan de burchtzijde eerst met een trappenhuis en daarna met een poortoverbouwing werd uitgebreid. In 1874 volgde een verbouwing en bepleistering. Van de Maaspoort (Kolonel Wilsstraat 1-3) uit 1522-'26 zijn nog resten aanwezig in de vorm van een onderdoorgang. De gebosseerde gepleisterde gevel en het gietijzeren hek stammen uit 1839. Van de oude hoofdgracht die hoorde bij de in 1672 gesloopte vesting, zijn nog grote delen als singel bewaard gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01275> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ravenstein – Windmolen"@nl ;
        min:adres "Molensingel 6" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Ravenstein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ravenstein" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ravenstein" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10611> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32362" ;
        min:soort "lemma" ;
        min:volgnummer 1275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0141> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text """Windmolen ‘De Nijverheid’ (Molensingel 6), een hoge ronde, bakstenen stellingkorenmolen uit 1857, staat op de overblijfselen van bastion Utrecht.

De Edithbrug (Maasdijk ong.) is een spoorwegbrug over de Maas uit 1872-'75, genoemd naar de dochter van A. Brodgen, de Engelse concessiehouder van de lijn Nijmegen-Tilburg. In 1937 verving men de vakwerkbrug door de huidige stalen staafboogbrug. In de Tweede Wereldoorlog werd de brug twee maal (gedeeltelijk) verwoest; het herstel werd in 1948 voltooid.

De R.K. begraafplaats (Molensingel ong.) heeft een pijlerhek met in de bakstenen pilonen uitgespaarde kruisen uit omstreeks 1890, een calvariegroep uit dezelfde tijd, gesigneerd A. van Asseldonk, en twee gietijzeren grafkruisen uit omstreeks 1900."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ravenstein – Huisseling"@nl ;
        min:adres "Grotestraat 58",
            "Hamstraat 1" ;
