        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0079> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "185" ;
        schema:pageStart "184" ;
        schema:pagination "184-185" ;
        schema:text "Raadhuizen. Het voorm. raadhuis van Heeswijk (Mgr. Van Oorschotstraat 1) is een fors pand met hoektoren uit 1915, opgetrokken in een mengeling van sobere neorenaissance- en jugendstil-vormen. Het voorm. raadhuis van Dinther (Raadhuisplein 9) is een traditioneel vormgegeven dorpsraadhuis uit 1939."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00795> a min:Passage,
