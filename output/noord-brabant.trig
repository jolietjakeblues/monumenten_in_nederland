        min:volgnummer 1463 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0171> ;
        schema:name "Textielscholen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "307" ;
        schema:pagination "307" ;
        schema:text "Textielscholen. Kenmerkend voor Tilburg zijn de Textielschool (Korte Schijfstraat 17) [21], met parallel aan de straat een vleugel uit 1878 en haaks erop een vleugel uit 1930, en de nabije Hogere Textielschool (Noordhoekring 182) [22] uit 1930, in sobere, licht expressionistische vormgeving."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01464> a min:Passage,
