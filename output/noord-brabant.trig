        schema:name "Drunen (gemeente Heusden)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Dorp in de Langstraat met een na de Tweede Wereldoorlog herbouwde kern. Belangrijk voor Drunen was de vestiging in 1939 van Lips, de machinefabriek van sloten en scheepschroeven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0046.php> .

