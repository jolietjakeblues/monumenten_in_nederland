        min:gemeente "Geertruidenberg" ;
        min:gemeenteInBoek "Raamsdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Geertruidenberg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geertruidenberg (gemeente Raamsdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geertruidenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54766> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "15959" ;
        min:soort "inleiding" ;
        min:volgnummer 672 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "Het Oudemannen- en vrouwenhuis (Gasthuisstraat 10-34) [4] heeft een nagenoeg vierkant middengedeelte uit 1775-'78 en twee lagere, langgerekte zijvleugels met de jaartalankers ‘1888’. Het middengedeelte werd gebouwd naar ontwerp van Philip Willem Schonck en met beeldhouwwerk van Guilliam Carrier. Van zijn hand zijn waarschijnlijk ook de in nissen geplaatste beelden van een oude man en een oude vrouw in de achtergevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00673> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        min:adres "Markt 32-34" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Geertruidenberg" ;
        min:gemeenteInBoek "Raamsdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Geertruidenberg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geertruidenberg (gemeente Raamsdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geertruidenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10448>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30266> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "15988",
            "15989" ;
        min:soort "inleiding" ;
        min:volgnummer 673 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill224> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "Het stadhuis (Markt 32-34) [5] kreeg zijn huidige omvang door de ingrijpende verbouwing tussen 1520 en 1532 van een laat-14de-eeuws gebouw, waarvan de overwelfde kelder en het opgaand muurwerk tot aan de verdieping bewaard bleven. Bij een verbouwing in 1767-'69 kreeg het gebouw een nieuwe voorgevel in Lodewijk XV-stijl naar plannen van Philip Willem Schonck en met beeldhouwwerk van Guilliam Carrier. De bakstenen gevel heeft hardstenen deur- en vensteromlijstingen en een attiek met een beeld van Vrouwe Justitia. Aan weerszijden van het middenvenster werden de gebeeldhouwde wapens aangebracht; dat van de stad Geertruidenberg bleef behouden, maar dat van de graven van Nassau is later weggehakt. Het smeedijzeren balkonhek draagt het jaartal 1769. De smeedijzeren balustrade langs de bordestrappen dateert uit 1791 en werd gemaakt door Jan Veth. De zeskante dakruiter heeft men in 1879 vernieuwd naar voorbeeld van het oorspronkelijke 16de-eeuwse origineel. In de trouwzaal, de voormalige vierschaar, bevinden zich stucversieringen uit 1791 van de hand van Pieter Carati, met onder meer boven de schoorsteen de Gerechtigheid en het stadswapen. Verder is er een schilderij door Aart van Tongeren uit 1685, voorstellende vrouwe Justitia en een gezicht op Geertruidenberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00674> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Geertruidenberg" ;
        min:gemeenteInBoek "Raamsdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Geertruidenberg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geertruidenberg (gemeente Raamsdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geertruidenberg" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 674 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "De vishal (Vismarktstraat ong.) [6] is een open vierkant gebouwtje met mansardedak op twaalf hardstenen zuilen, gebouwd in 1772 naar ontwerp van Philip Willem Schonck en met steenhouwerswerk van Guilliam Carrier."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        min:adres "Haven 54" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Geertruidenberg" ;
        min:gemeenteInBoek "Raamsdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Geertruidenberg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geertruidenberg (gemeente Raamsdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geertruidenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54806> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "15961" ;
        min:soort "inleiding" ;
        min:volgnummer 675 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "Het voorm. arsenaal (Haven 54) [7], bestaande uit vier vleugels rond een vierkante binnenplaats, werd in 1771-'77 opgetrokken in Lodewijk XVI-vormen naar ontwerp van Philip Willem Schonck en voorzien van beeldhouwwerk door Guilliam Carrier. De middenrisaliet van zowel de zuid- als de noordgevel (aan de Haven) is bekleed met hardsteen en versierd met het wapen van het gewest Holland en krijgstrofeeën."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

