        min:soort "inleiding" ;
        min:volgnummer 755 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0072> ;
        schema:name "Haaren"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "Dorp ontstaan als beekdalnederzetting, voor het eerst vermeld in 1147. Het is te beschouwen als een tiendakkerdorp met drie kernen: Kerkeind, 't Eind en de omgeving van de St.-Lambertuskerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00756> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaren"@nl ;
        min:adres "Kerkeind 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Haaren" ;
        min:gemeenteInBoek "Haaren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Haaren" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 756 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill254> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0072> ;
        schema:name "Haaren"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "178" ;
        schema:pagination "178-179" ;
        schema:text "De kerktoren (Kerkeind 2) van de uit 1472 stammende, maar aan het begin van de 18de eeuw ingestorte St.-Lambertuskerk is een 15de-eeuws bouwwerk met overhoekse steunberen. De toren heeft tufsteenlagen in de eerste geleding, een versiering van spitsboognissen en - friezen, en aan de zuidzijde een driezijdige traptoren. Het traptorentje aan de oostzijde dateert van de restauratie in 1968-'69. De plattegrond van de kerk is met baksteenmuurtjes aangegeven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00757> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Haaren"@nl ;
        min:adres "Kerkstraat 39" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Haaren" ;
        min:gemeenteInBoek "Haaren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Haaren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Haaren" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 757 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0072> ;
        schema:name "Haaren"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "De R.K. St.-Lambertuskerk (Kerkstraat 39) is een driebeukige neogotische kruisbasiliek uit 1913-'14, naar plannen van W.Th. van Aalst. De kerk heeft een dakruiter en een rijzige westtoren van vier geledingen met ingesnoerde naaldspits. In het interieur zijn de stergewelven in 1939-'40 beschilderd door J. ten Horn. A.H. Haan uit Antwerpen maakte het hoogaltaar (1917) en andere interieurstukken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00758> a min:Passage,
            schema:CreativeWork ;
