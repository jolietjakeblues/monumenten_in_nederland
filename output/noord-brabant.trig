        schema:name "Made"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "De R.K. St.-Blasiuskerk (Zuideindsestraat 3) werd in 1929-'30 gebouwd naar plannen van J. en W. Oomen. Het gebouw bestaat uit een hoofdruimte met transept- en koorvormige aanbouwsels, en een toren met paraboolvormig dak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0110.php> .

