        min:soort "inleiding" ;
        min:volgnummer 972 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0093> ;
        schema:name "Huijbergen (gemeente Woensdrecht)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "De R.K.H. Maria-Hemelvaartkerk (Canadaplein 1) is een basilicale kerk uit 1952, gebouwd in de trant van de Delftse School. W.J. Bunnik putte voor zijn ontwerp inspiratie uit de vroeg-christelijke basilica."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0093.php> .

