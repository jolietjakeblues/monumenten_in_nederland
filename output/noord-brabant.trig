        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Teteringen (gemeente Breda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Teteringen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39613>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40729> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "35139",
            "519047" ;
        min:soort "inleiding" ;
        min:volgnummer 1441 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0170> ;
        schema:name "Teteringen (gemeente Breda)"@nl ;
        schema:pageEnd "302" ;
        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "De R.K. St.-Willibrorduskerk (Hoolstraat 13) is een centraliserende kruiskerk met terzijde geplaatste toren en een grote vierkante viering, bekroond met lantaarn. De kerk verrees in 1926-'27 naar ontwerp van J. van Groenendael in een mengvorm van neoromaanse en expressionistische elementen. De oude kerk lag aan de overzijde van de straat op het nog bestaande kerkhof. De voorm. pastorie (Hoeveneind 3) is een eenlaagspand uit 1843 met empire-vensters en -deuromlijsting en een aangebouwd koetshuis. In later tijd is het pand nog in gebruik geweest als raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01442> a min:Passage,
