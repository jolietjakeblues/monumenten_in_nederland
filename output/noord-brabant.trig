        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De voorm. kazerne Het Noorderblok (Ruyterstraat 2) [9], gelegen in de keel van bastion Bekaf, stamt uit 1825. Het werd in 1895 in gebruik genomen als missionarissenopleiding en is recent verbouwd tot appartementen en bedrijfsruimten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00744> a min:Passage,
