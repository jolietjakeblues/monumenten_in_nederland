        schema:name "Windmolens"@nl ;
        schema:pageEnd "249" ;
        schema:pageStart "249" ;
        schema:pagination "249" ;
        schema:text "Windmolens. Aan de noordrand van de dorpskern staat de ronde bakstenen beltkorenmolen De Deen (Rijt 32) uit 1839 en tussen kerk en kapel de ronde bakstenen beltkorenmolen De Grenswachter (Kapellerweg 15) uit 1891."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01049> a min:Passage,
