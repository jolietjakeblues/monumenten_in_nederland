        min:hoofdstuk "Steden, dorpen, monumenten › Fijnaart (gemeente Zevenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Fijnaart" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40550> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "521723" ;
        min:soort "inleiding" ;
        min:volgnummer 653 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0058> ;
        schema:name "Fijnaart (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "De R.K.H. Jacobuskerk (Molenstraat 26) is een basilicale kerk uit 1952, gebouwd naar ontwerp van J. Hurks met neoromaanse vormen. Tot de inventaris behoren enkele midden-19de-eeuwse houten beelden, afkomstig uit de voorgangster van deze kerk, waarvan de uit 1846 daterende pastorie (Molenstraat 24), in eclectische stijl, bewaard is gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00654> a min:Passage,
            schema:CreativeWork ;
