        min:hoofdstuk "Steden, dorpen, monumenten › Andel (gemeente Woudrichem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Andel" ;
        min:lemma "Grenspalen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 178 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0010> ;
        schema:name "Grenspalen"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Grenspalen. Aan de Hoge Maasdijk tussen Andel en Veen staan twee hardstenen grenspalen uit 1786, de ene met het wapen van Altena (twee zalmen), de andere met het wapen van Heusden (een rad). Deze palen gaven vroeger de scheiding aan tussen de heemraadschappen ‘Oudland van Altena’ en ‘Den Hoogen Maasdijk van de Stad en Land van Heusden’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00179> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 179 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Asten"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Dorp ontstaan op een zandrug tussen de Astensche Aa en de Aa, waar de oude weg die Helmond met de Peel verbond de weg van Someren naar Deurne kruist. Het dorp, voor het eerst vermeld in 1212, ontwikkelde zich tot een baandorp, plaatselijk verbreed bij Koningsplein en Markt. Het Koningsplein kreeg zijn huidige grootte aan het einde van de 19de eeuw als gevolg van de afbraak van de middeleeuwse kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00180> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten"@nl ;
        min:adres "Lindestraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 180 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Asten"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "De Herv. kerk (Lindestraat 1) is een eenvoudige zaalkerk uit 1810 met gepleisterde topgevel, dakruiter en vensters met gietijzeren traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00181> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten"@nl ;
        min:adres "Wilhelminastraat 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 181 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill67>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill68> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Asten"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "62" ;
        schema:pagination "62-63" ;
        schema:text "De R.K. kerk O.L. Vrouwe Presentatie (Wilhelminastraat 3) is een hoogopgaande driebeukige, neogotische kruisbasiliek uit 1896-'98. Het ontwerp van C. Franssen is geïnspireerd door de 13de-eeuwse Franse gotiek. De kerk heeft een kooromgang met straalkapellen, luchtbogen, een dakruiter en een rijzige toren met achtkante naaldspits en flankerende hoektorentjes. Inwendig bevinden zich kruisribgewelven in schoon metselwerk en bundelpijlers met natuurstenen koolbladkapitelen. De neobarokke preekstoel uit 1859 werd gemaakt door de Gebr. Goossens; de voet bestaat uit een beeldengroep die de verblinding van Saulus voorstelt. Het moderne astronomische uurwerk is vervaardigd door de aan de overkant gelegen klokken- en torenuurwerkenfabriek Koninklijke Eijsbouts. Op het kerkhof met calvarieberg zijn een aantal belangrijke graven te vinden, waaronder die van Bluijssen († 1901), naar ontwerp van J. Bolsius, en Franken († 1902) door D.J. Hanique."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00182> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten"@nl ;
        min:adres "Wilhelminastraat 27" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61507> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "516716" ;
        min:soort "inleiding" ;
        min:volgnummer 182 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Asten"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Het klooster van de Filles de Notre Dame (Wilhelminastraat 27) werd in 1910 gevestigd in het rond 1870 voor de fabrikantenfamilie Bluijssen gebouwde neoclassicistische herenhuis ‘Semper Virens’. In 1910 kwam ook de kamer met straatkapel met beeld van St.-Franciscus tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00183> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten"@nl ;
        min:adres "Wilhelminastraat 24" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Asten"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Het klooster van de Paters van het H. Hart (Wilhelminastraat 24) verrees in 1928-'29 in traditionele stijl op een U-vormige plattegrond. Boven de ingang staat een H. Hartbeeld onder baldakijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00184> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten – Huize Bartholomeus"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:lemma "Huize Bartholomeus" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 184 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Huize Bartholomeus"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Huize Bartholomeus (Koningsplein ong.) is een verpleegtehuis, ontstaan uit een in 1841 in bestaande gebouwen gestichte vestiging van de Zusters van Liefde uit Tilburg. In 1867 kwam een nieuwe klooster tot stand en in 1933 volgde de bouw van een vleugel naar een ontwerp met expressionistische elementen van G.L. de Vries."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00185> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten – Postkantoren"@nl ;
        min:adres "Markt 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:lemma "Postkantoren" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 185 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Postkantoren"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Postkantoren. Het voorm. postkantoor Koningsplein 10 werd omstreeks 1880 in neoclassicistische vormen gebouwd. Het huidige postkantoor met dienstwoning Markt 16 kwam in 1919-'21 tot stand in ‘Um 1800’-vormen naar plannen van M.Th. Elout van het bureau Rijksbouwmeester. Boven het ingangsportiek zit een gestileerd, in natuurstenen uitgevoerd Rijkswapen. Het raadhuis (Markt 1) werd in 1930 gebouwd in traditionele, door Kropholler beïnvloede, vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00186> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten – Woonhuizen"@nl ;
        min:adres "Julianastraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21059> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "516710" ;
        min:soort "lemma" ;
        min:volgnummer 186 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Woonhuizen. Lindestraat 7 heeft aan de zijkant de jaartalankers ‘175.’ en verder een voordeur met empire-bovenlicht en vensters met zwikken. De dwarse huizen Burg. Frenckenstraat 45-47 hebben de jaartalankers ‘A.O. 1788 F.F.’ en een geprofileerde stenen kroonlijst. Burg. Wijnenstraat 25-27 is een uit omstreeks 1890 stammend neoclassicistisch woonhuis met koetshuis. De omstreeks 1850 door de familie Bluijssen - eigenaar van een keten van kruidenierswinkels - gebouwde villa St.-Jozef (Julianastraat 2) kreeg in 1904 een aanbouw in neorenaissance-stijl, voorzien van fraaie tegels in jugendstil-vormen. De in 1919-'20 voor woningbouwvereniging St.-Jozef gebouwde woonhuizen St.-Jozefplein 1-20 hebben expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00187> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten – Windmolen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Asten" ;
        min:gemeenteInBoek "Asten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Asten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Asten" ;
        min:lemma "Windmolen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 187 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill69> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0011> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text """Windmolen. De gesloten-standerd-korenmolen (Molenstraat ong.) is een voormalige heerlijke molen. De spil draagt de inscriptie 1506, maar de molenkast stamt uit de 18de eeuw. Na een brand in 1970 werd de molen hersteld en op een belt geplaatst.

Het kasteel van Asten (Kasteellaan ong.), gelegen ten zuiden van het dorp, was de zetel van de heren van Asten. Het oorspronkelijk uit de 16de eeuw daterende kasteel - dat in 1938-'41 nog was gerestaureerd - werd in 1944 door oorlogshandelingen vrijwel volledig verwoest. Bewaard bleef alleen de voorpoort. Dit torenvormige gebouw heeft een ingezwenkt tentdak en een korfboogvormige doorgang. Aan weerszijden staan lage aanbouwen, die met de haaks daarop aansluitende vleugels een binnenplein omsluiten."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

