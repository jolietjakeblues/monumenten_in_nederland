        min:soort "lemma" ;
        min:volgnummer 1461 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0171> ;
        schema:name "Kazernes"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "Kazernes. De voorm. Lancierskazerne (St.-Josephstraat 126) [18] is een sober, langgerekt bakstenen gebouw in eenvoudige neoclassicistische vormen met de ingang in een door een fronton bekroond risaliet. Het werd gebouwd in 1842, uitgebreid in 1844-'46, en in 1858 opgenomen in de inmiddels weer gesloopte Wollenstoffenfabriek BeKa. Van de voorm. Kromhoutkazerne (Korenbloemstraat 1-5) resteert nog het hoofdgebouw met wachttoren uit 1913, uitgevoerd in chalet- en jugendstilvormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01462> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tilburg – Scholen"@nl ;
        min:adres "Capucijnerstraat 76",
            "Dr. Ahausstraat 1",
            "Nazarethstraat 46",
            "Oude Dijk 9" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Tilburg" ;
        min:gemeenteInBoek "Tilburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tilburg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tilburg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Tilburg" ;
        min:lemma "Scholen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78217> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "521093" ;
        min:soort "lemma" ;
        min:volgnummer 1462 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0171> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "307" ;
        schema:pageStart "306" ;
        schema:pagination "306-307" ;
        schema:text "Scholen. Het jongensinternaat St.-Antonius van Padua (Capucijnerstraat 76) werd evenals het bijbehorende fraterhuis in 1894 in neogotische vormen gebouwd naar plannen van J.H. van den Abeelen. In 1927 volgde een uitbreiding door Ed. Cuypers en in 1993 door C. Panis, van wiens hand ook de kapel in laat-expressionistische vormen is. Het St.-Josephstudiehuis (Dr. Ahausstraat 1), met internaat en seminarie, staat bekend als de ‘Rooi Pannen’. Het is een groot, maar sober uitgevoerd complex naar plannen van J. van der Valk, met accenten in de vorm van hoger opgetrokken traptorens. Het voogdijgesticht voor jongens van de Fraters van Tilburg, Huize Nazareth (Nazarethstraat 46) [19], is eveneens een groot, maar meer in jugendstil-vormen uitge-voerd complex uit 1916. Dichtbij staat de uit 1931 stammende St.-Jozefmulo (Oude Dijk 9) [20]. Deze door J. Donders en H. van den Biggelaar sterk expressionistisch vorm gegeven school stond onder beheer van de Zusters van Liefde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01463> a min:Passage,
