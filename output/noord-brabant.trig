        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "514897",
            "514898" ;
        min:soort "lemma" ;
        min:volgnummer 337 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0024> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Boerderijen. Rond het dorp ligt een aantal waardevolle 19de- en 20ste-eeuwse boerderijen. Latestraat 11 is een langgevelboerderij met karschop uit omstreeks 1875. De kortgevelboerderij De Gelderse Hoeve (Akkerweg 4) dateert van omstreeks 1910. Neterselseweg 15 is een langgevelboerderij uit 1925 en Bredasebaan 20 een koprompboerderij uit 1937 naar ontwerp van J.W. Dielis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0024.php> .

