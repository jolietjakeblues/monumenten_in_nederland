        min:soort "lemma" ;
        min:volgnummer 788 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0078> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "Boerderijen. Nabij de kerk staan twee 17de-eeuwse boerderijen: Grotestraat 31, met tweelaags woongedeelte, dient tevens als consistorie, en Grotestraat 20 is een T-vormige boerderij met aangebouwd bakhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0078.php> .

