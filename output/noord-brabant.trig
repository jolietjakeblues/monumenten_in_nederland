        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill379> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0119> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "256" ;
        schema:pagination "256-257" ;
        schema:text "Windmolen. Op de Vinkenberg ten zuiden van het dorp staat sinds 1852 een gesloten-standerdmolen (Schoolstraat 65). De molen, waarvan de kast vóór 1600 zal zijn gebouwd en de standerd mogelijk uit 1832 stamt, verhuisde in 1852 hierheen van de Molenakkers. In 1992-'93 onderging de molen een ingrijpende restauratie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01116> a min:Passage,
