        min:volgnummer 465 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0032> ;
        schema:name "Budel Dorplein (gemeente Budel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De R.K. St.-Jozefkerk (Hoofdstraat 201) is een basiliek met vieringstoren; twee gedrongen torens met achtzijdige lantaarns flankeren de ingangspartij. De kerk werd in 1951-'52 opgetrokken in neoromaanse vormen naar plannen van H. Pontzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00466> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel Dorplein (gemeente Budel)"@nl ;
        min:adres "Hoofdstraat 79-80" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
