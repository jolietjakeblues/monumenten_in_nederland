        schema:name "Kaarsenfabriek"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Kaarsenfabriek Bolsius (Kerkendijk 126). Het oudste deel stamt uit 1911, maar de fabriek is nadien regelmatig uitgebreid en kreeg in 1941 een nieuwe voorgevel naar plannen van C.J. van Liempd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01353> a min:Passage,
