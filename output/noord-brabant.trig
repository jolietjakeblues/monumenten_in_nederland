        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text "Het voorm. raadhuis (Torenstraat 6) is een sober en robuust gebouw uit 1940. Bij het ontwerp liet J. Roffelsen zich inspireren door de vormgeving van de nabij gelegen gevangenpoort."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01075> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
