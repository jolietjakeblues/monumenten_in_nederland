        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Kerkdorp, voor het eerst genoemd in 1278. Na aanleg van de steenweg Den Bosch-Grave in 1823-'25 groeide het uit tot een langgerekt lintdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0088.php> .

