        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0134> ;
        schema:name "Oss"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Het voorm. Nicolaasgesticht (Bagijnenstraat 3) dateert uit 1883 en is een neogotisch fraterhuis annex pensionaatsgebouw van de Fraters van Tilburg. In de topgevel staat een beeld van St. Nicolaas van Poppel, een van de Martelaren van Gorkum."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01227> a min:Passage,
            schema:CreativeWork ;
