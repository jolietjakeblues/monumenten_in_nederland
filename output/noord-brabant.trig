        schema:name "Terheijden (gemeente Made)"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "De Herv. kerk (Hoofdstraat 1) is een eenvoudig neoclassicistische zaalkerk uit 1809, met rondboogvensters en wit gepleisterd front, bekroond met klokkentorentje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0169.php> .

