        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwkuijk (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nieuwkuijk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1130 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0123> ;
        schema:name "Nieuwkuijk (gemeente Heusden)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Langgerekt dorp, ontstaan op de grens van zand- en kleigrond. De heren van de heerlijkheden Nieuwkuijk en Onsenoort hadden sinds 1382 hun domicilie op kasteel Onsenoort (nu cisterciënzer abdij Mariënkroon). In 1810 werden beide heerlijkheden samengevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01131> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwkuijk (gemeente Heusden)"@nl ;
        min:adres "Nieuwkuijkseweg 94" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwkuijk (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nieuwkuijk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1131 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0123> ;
        schema:name "Nieuwkuijk (gemeente Heusden)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De R.K. kerk St.-Johannes de Doper (Nieuwkuijkseweg 94) is een rechthoekig centraliserend kerkgebouw met uitspringende entree en terzijde staande toren. De kerk verrees in 1953-'55 naar plannen van N. van der Laan en W.A.J. Hansen in Bossche School-stijl. Ze verving de in 1944 verwoeste neogotische kerk uit 1864-'66."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01132> a min:Passage,
            schema:CreativeWork ;
