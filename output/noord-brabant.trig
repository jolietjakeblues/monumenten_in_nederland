        min:hoofdstuk "Steden, dorpen, monumenten › Lierop (gemeente Someren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Lierop" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11800>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44570> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "34115",
            "34119" ;
        min:soort "inleiding" ;
        min:volgnummer 1018 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill358> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0102> ;
        schema:name "Lierop (gemeente Someren)"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "244" ;
        schema:pagination "244-245" ;
        schema:text "De R.K. kerk H. Naam van Jezus (Offermansstraat 1) is een driebeukige kruisbasiliek met veelzijdig gesloten oostpartij, gedomineerd door een massale koepeltoren boven de achthoekige viering. De kerk verrees in 1890-'92 naar een op de 13de-eeuwse romano-gotiek gebaseerd ontwerp van C. Weber. Na oorlogsschade in 1944 zijn van de vier flankerende vieringstorens alleen de twee zuidelijke hersteld, naar plannen van J. de Jong. Het voornamelijk in rode baksteen uitgevoerde interieur heeft een alternerend stelsel van pijlers en zuilen en een stervormig koepelgewelf boven de viering. De pastorie (Offermansstraat 3) stamt uit omstreeks 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0102.php> .

