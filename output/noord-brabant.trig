        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Groeningen. Dit oeverwaldorp ten noorden van Vierlingsbeek is van middeleeuwse oorsprong. De R.K. kapel van H.H. Antonius Abt en Nicolaas (Groeningestraat 30) is een eenvoudige zaalkerk met smaller en lager, driezijdig gesloten koor. Het 15de-eeuwse gebouw is gewijzigd in de 18de eeuw en hersteld in 1822. In het interieur bevindt zich een laat-18de-eeuws rococo altaar en heiligenbeelden van Antonius Abt en Nicolaas."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01555> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierlingsbeek – Maashees"@nl ;
        min:adres "De Goeystraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxmeer" ;
        min:gemeenteInBoek "Vierlingsbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxmeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierlingsbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vierlingsbeek" ;
        min:lemma "Maashees" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1555 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0182> ;
        schema:name "Maashees"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Maashees. Dit oeverwaldorp ten zuiden van Vierlingsbeek werd in 1944 grotendeels verwoest. De R.K. kerk St.-Anthonius Abt (De Goeystraat 2) is een zware neoromaanse zaalkerk uit 1950 naar ontwerp van C. de Bever."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01556> a min:Passage,
