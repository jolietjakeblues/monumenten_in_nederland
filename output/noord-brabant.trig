        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De R.K. kerk O.L. Vrouwe van de Rozenkrans (Boschweg 118), in het gehucht Boschweg, is een driebeukige basiliek met terzijde staande toren, gebouwd in 1928-'29 naar plannen van C. van Liempd en P. Donders in ‘Dom. Bellot’-expressionisme."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0154.php> .

