        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Langgerekt dorp ontstaan in de late middeleeuwen op de overgang van zeeklei en zandgrond. De R.K. kerk bepaalt van verre het dorpssilhouet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01239> a min:Passage,
