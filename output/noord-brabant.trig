        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0053> ;
        schema:name "Engelen (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "Het voorm. raadhuis (De Kerkhof 4-5) werd gebouwd in 1844 en heeft een bel-etage en een souterrain, waarin vroeger de veldwachterswoning was gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00623> a min:Passage,
