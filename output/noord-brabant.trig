        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "Het raadhuis (Raadhuisstraat 78, Hoogerheide) dateert uit 1918 en is opgetrokken in historiserende stijl met trapgevels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01657> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woensdrecht-Hoogerheide"@nl ;
        min:adres "Antwerpsestraat 185",
            "Hildernisse 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeenteInBoek "Woensdrecht-Hoogerheide" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woensdrecht-Hoogerheide" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Woensdrecht-Hoogerheide" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1657 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0195> ;
        schema:name "Woensdrecht-Hoogerheide"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De Mattenburgh (Antwerpsestraat 185) is een buitenplaats gelegen ten noorden van Woensdrecht en aan weerszijden van de weg tussen Bergen op Zoom en Woensdrecht. Het wit gepleisterde, eclectische landhuis met souterrain dateert uit 1851-'54. Bij het huis staat een waarschijnlijk gelijktijdig gebouwde monumentale oranjerie, met hoger middendeel en twee gebogen zijvleugels, het geheel uitgevoerd in baksteen met pilasters. Verder zijn er nog een koetshuis en een gepleisterd achthoekig theekoepeltje met houten bekroning. De romantische parkaanleg, deels in gemengde stijl, stamt uit omstreeks 1878. Op het landgoed ligt de langgevelboerderij ‘Hildernisse’ (Hildernisse 1), in oorsprong 17de-eeuws maar in haar huidige gedaante daterend uit het midden van de 18de eeuw. In de westgevel zit een nis met Mariabeeld. Bij de boerderij horen een schuur en een bakhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01658> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woensdrecht-Hoogerheide – Vestingwerken"@nl ;
