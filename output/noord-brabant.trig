        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0084> ;
        schema:name "Herpen (gemeente Ravenstein)"@nl ;
        schema:pageEnd "196" ;
        schema:pageStart "196" ;
        schema:pagination "196" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen op de overgang van zandgrond naar rivierklei, nabij het nu verdwenen kasteel van de heren van Herpen, die omstreeks 1360 hun domicilie verplaatsten naar Ravenstein. Daarbij ging de heerlijkheid Herpen deel uitmaken van het Land van Ravenstein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0084.php> .

