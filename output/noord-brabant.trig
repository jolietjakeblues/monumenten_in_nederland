        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34033>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50064> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "41941",
            "9579" ;
        min:soort "lemma" ;
        min:volgnummer 338 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0024> ;
        schema:name "Netersel"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Netersel. In dit akkerdorp ten noorden van Bladel staat de R.K. kerk van H.H. Antonius en Brigida (De Hoeve 4), een basilicale kerk uit 1951. De kerkinventaris is afkomstig uit de in 1932 gesloopte laat-gotische St.-Brigidakapel, de oorspronkelijke slotkapel bij het kasteel van Netersel. Tot die inventaris behoren een 15de-eeuws houten kruisbeeld, een hardstenen doopvont (15de eeuw), beelden van Petrus en Paulus (late 18de eeuw) en geschilderde kruiswegstaties (vermoedelijk late 18de eeuw). In de toren hangen twee klokken van Jaspar Moer uit 1529 en 1530. De Oude Pastorie (De Hoeve 32) is een eenlaags (Kempisch) dorpshuis uit het eerste kwart van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00339> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boekel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
