        schema:name "Hooge Mierde (gemeente Reusel-De Mierden)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Randakkerdorp, ontstaan in de middeleeuwen op de Kempische zandgrond en bestaande uit enkele gehuchten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00955> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hooge Mierde (gemeente Reusel-De Mierden)"@nl ;
        min:adres "Schoolstraat 9",
            "Torendreef 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Reusel-De Mierden" ;
        min:gemeenteInBoek "Reusel-De Mierden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Reusel-De_Mierden> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hooge Mierde (gemeente Reusel-De Mierden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hooge Mierde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41422>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49845>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61247> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "22240",
            "22242",
            "518683" ;
        min:soort "inleiding" ;
        min:volgnummer 955 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0090-01> ;
        schema:name "Hooge Mierde (gemeente Reusel-De Mierden)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "De R.K. kerk St.-Jan Evangelist (Schoolstraat 9) is een eenbeukige kerk op centraliserende plattegrond, gebouwd in 1922-'23 naar ontwerp in expressionistische trant van H.C. Bonsel. Van de laat-middeleeuwse en in 1820 grotendeels herbouwde kerk bleef de 15de-eeuwse toren behouden. Deze toren van drie geledingen heeft aan de westzijde overhoekse en aan de oostzijde haakse steunberen, waarvan de noordelijke tot traptoren is uitgebouwd. Tot de kerkinventaris behoren een houten kruisbeeld uit omstreeks 1500 en een midden-17de-eeuws houten Mariabeeld. De pastorie (Torendreef 1) dateert uit omstreeks 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0090.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00956> a min:Passage,
            schema:CreativeWork ;
