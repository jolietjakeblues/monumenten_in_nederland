        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Lierop" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1017 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0102> ;
        schema:name "Lierop (gemeente Someren)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Dorp ontstaan uit een aantal gehuchten in het stroomgebied van de Kleine Aa. Ten oosten van de huidige dorpskern is een van deze gehuchten - Boomen - nog als zodanig te herkennen. Lierop kreeg in 1569 een eigen kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0102.php> .

