        min:adres "St.-Jansstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Ravenstein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dieden (gemeente Ravenstein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dieden" ;
        min:lemma "Neerlangel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56878> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32399" ;
        min:soort "lemma" ;
        min:volgnummer 524 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0041> ;
        schema:name "Neerlangel"@nl ;
        schema:pageEnd "134" ;
        schema:pageStart "134" ;
        schema:pagination "134" ;
        schema:text "Neerlangel. Dit oeverwaldorp ten zuidoosten van Dieden ontstond in de vroege middeleeuwen. Ter vervanging van een 11de-eeuwse tufstenen kerk bouwde men in 1869 de eenbeukige neogotische R.K. kerk St. Jan de Doper (St.-Jansstraat 2). De toen met een derde geleding verhoogde tufstenen toren - met dichtgemaakte galmgaten en zonder westingang - en een deel van de tufstenen westgevel bleven bewaard. Inwendig heeft de toren nog aanzetten van een koepelgewelf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00525> a min:Passage,
