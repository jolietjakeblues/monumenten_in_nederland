        schema:name "Handel (gemeente Gemert-Bakel)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Dorp ontstaan bij een hoeve van de Duitse Orde; het wordt voor het eerst vermeld in 1368. De in 1459 tot rectoraatskerk verheven kapel werd bekend als Mariabedevaartplaats. Omdat het gebied behoorde tot de Commanderij van de Duitse Orde en dus buiten het gezag van de Generaliteit viel, kon deze bedevaart ononderbroken doorgaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00773> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Handel (gemeente Gemert-Bakel)"@nl ;
        min:adres "O.L. Vrouwestraat 61" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Gemert-Bakel" ;
        min:gemeenteInBoek "Gemert-Bakel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Gemert-Bakel> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Handel (gemeente Gemert-Bakel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
