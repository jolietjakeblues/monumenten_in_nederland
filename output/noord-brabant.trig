        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Langgerekt akkerdorp, in de middeleeuwen ontstaan op de Kempische zandgrond. In de buurt van het dorp is een Romeinse villa opgegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0092.php> .

