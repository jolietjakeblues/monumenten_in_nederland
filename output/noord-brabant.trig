        schema:name "Windmolen"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Windmolen ‘De Volksvriend’ (Hoofdstraat 30) is een ronde, aan de zuidwestzijde gecementeerde, bakstenen beltkorenmolen uit 1903."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01028> a min:Passage,
