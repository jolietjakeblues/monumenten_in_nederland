        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 736 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De voorm. synagoge (Oliestraat 18-20) [3] is een eenvoudig diep pand uit 1871. De voorgevel is voorzien van overhoekse pinakels en een klimmend boogfries. Aan de rechterzijde is de mikwa uitgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00737> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grave"@nl ;
        min:adres "Brugstraat 13" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 737 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Het voorm. St.-Catharinagasthuis (Brugstraat 13) [4] werd in 1290 gesticht en in 1835 geheel afgebroken en herbouwd in neoclassicistische vormen. Het doet nu dienst als gemeenschapshuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00738> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grave"@nl ;
        min:adres "Oliestraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 738 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Het voorm. Hospitium Christianae Bene Ficentias Sacrum (Oliestraat 1) [5] werd in 1931 in traditionele vormen gebouwd. Het is het enige overblijfsel van een in 1848 door de Zusters van Liefde uit Tilburg gesticht klooster (gesloopt in 1970). In dat klooster werden vanaf 1882 blinde meisjes opgenomen en het stond daarom beter bekend als ‘Blindeninstituut De Wijnberg’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00739> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grave"@nl ;
        min:adres "St.-Elisabethstraat 35" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 739 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill248> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De voorm. Rijks Psychiatrische Inrichting (St.-Elisabethstraat 35) [6] werd in 1898 gebouwd naar plannen van rijksbouwmeester J. van Lokhorst. Daarbij maakte men gebruik van resten van het in 1674 door de Fransen verwoeste kasteel van de heren van Cuijk, dat omstreeks 1140 was gebouwd en in 1534 was verbouwd naar plannen van Alessandro Pasqualini. Op de plaats van het eigenlijke kasteel werd in 1679-'92 een bank aangelegd met vijf kazematten. De gebouwen rond het voorhof, de ‘Marstal’ (gebouwd vóór 1521), het ‘Lange Huis’ (1534) en het wagenhuis (omstreeks 1534) bleven behouden als militair arsenaal. In 1766 voegde men aan de westzijde een kruithuis toe. Als compensatie voor het verlies van de vestingstatus in 1874 werd in Grave deze rijksinrichting gevestigd. De bank herschiep men in een tuin in Engelse landschapsstijl. In 1898 werd het kruithuis tot kapel omgebouwd; het 16de-eeuwse arsenaal werd ingrijpend gewijzigd en opgenomen in een groter gebouw met kenmerken van de chaletstijl. De zolders werden ingericht als slaapzalen en kregen nieuwe, in 1950 vernieuwde, dakkapellen. In 1905 kwam er aan de noordzijde nog een ziekenvleugel met serre tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00740> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grave"@nl ;
        min:adres "Hoofdwagt 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 740 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Het stadhuis (Hoofdwagt 2) [7] is een in de loop der tijd sterk verbouwd en gerestaureerd complex. Het oudste deel dateert waarschijnlijk van kort na de stadsbrand van 1416, die het oude stadhuis verwoestte. De rechtervleugel werd omstreeks 1615 gebouwd en in 1798 bracht men het bordes aan. Na verbouwingen in 1820 en 1862, verdween de gevel in 1870 onder een pleisterlaag. In 1966-'69 werd het stadhuis ingrijpend gerestaureerd naar plannen van C. Pouderoyen en sindsdien maakt het deel uit van een modern gemeentehuiscomplex. Na ontpleistering werd het gebouw op grond van bouwsporen en een prent uit 1732 zoveel mogelijk in de oorspronkelijke staat teruggebracht. Men reconstrueerde de aan drie zijden van de dakvoet omlopende weergang met arkels uitkragend op een fries van spitsbogen, en de kruiskozijnen met de - niet geheel correcte - maniëristische bekroningen. Het interieur bevat nog vier vroeg-17de-eeuwse gebeeldhouwde zandstenen balkconsoles en enkele, in een wandbetimmering verwerkte, restanten van een eikenhouten schepenbank uit 1650."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00741> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grave"@nl ;
        min:adres "Hoofdwagt 5" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Grave_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grave" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Grave" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 741 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0070> ;
        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De voorm. Hoofdwacht (Hoofdwagt 5) [8] van de vesting Grave werd omstreeks 1730 gevestigd in een ouder pand, dat in 1699 al was verbouwd tot Vleeshal. Zijn huidige uiterlijk kreeg het gebouw omstreeks 1730, maar na de opheffing van de vesting werd de begane grond omstreeks 1885 verbouwd tot winkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00742> a min:Passage,
            schema:CreativeWork ;
