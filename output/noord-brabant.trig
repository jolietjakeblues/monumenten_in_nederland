        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0046> ;
        schema:name "Giersbergen"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "138" ;
        schema:pagination "138-139" ;
        schema:text "Giersbergen. Gehucht ten zuiden van Drunen, ontstaan als een hoeve-ontginning op zand. Het heeft een gave groep 19de-eeuwse langgevelboerderijen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0046.php> .

