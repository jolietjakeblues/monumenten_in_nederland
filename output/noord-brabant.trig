        min:volgnummer 670 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "De voorm. synagoge (Elfhuizen 1) [2], gelegen op een representatieve plek aan de Markt, is een rechthoekig gebouw uit 1874 met rondboogvensters tussen lisenen. Het heeft een topgevel met hardstenen lijst en torenvormige versieringen; in de top zit een voorstelling van de Stenen Tafelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00671> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        min:adres "Markt 52" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Geertruidenberg" ;
        min:gemeenteInBoek "Raamsdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Geertruidenberg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geertruidenberg (gemeente Raamsdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geertruidenberg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55940> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "15995" ;
        min:soort "inleiding" ;
        min:volgnummer 671 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0061> ;
        schema:name "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        schema:pageEnd "162" ;
        schema:pageStart "162" ;
        schema:pagination "162" ;
        schema:text "Het voorm. weeshuis (Markt 52) [3] gaat terug op een uit 1483 daterende gasthuiskapel. Bij de verbouwing tot weeshuis in 1681 bleef daarvan alleen het tweebeukige schip bewaard. Philip Willem Schonck verbouwde in 1771-'72 de voorgevel en Guilliam Carrier voerde daarbij het natuursteenwerk uit. Op het steile dak staat een dakruiter met hoge spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0061.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00672> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geertruidenberg (gemeente Raamsdonk)"@nl ;
        min:adres "Gasthuisstraat 10-34" ;
