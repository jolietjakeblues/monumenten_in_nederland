        schema:name "Kaatsheuvel (gemeente Loon op Zand)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De R.K. St.-Jozefkerk (Wilhelminastraat 2) is een robuuste basilicale kerk met een detaillering in de vormen van de Delftse School, gebouwd in 1936 naar ontwerp van C.H. de Bever. De pastorie (Wilhelminastraat 3) dateert ook uit 1936."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0094.php> .

