        min:rijksmonumentnummer "522527" ;
        min:soort "lemma" ;
        min:volgnummer 898 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill306> ;
