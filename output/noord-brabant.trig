        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0036> ;
        schema:name "De Heen (gemeente Steenbergen)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "De R.K.H. Maria Hemelvaartkerk (Dorpsweg 134) is een eenbeukige neogotische kerk met traptorentje, gebouwd in 1884 naar ontwerp van P.J van Genk en in 1951 met zeven traveeën uitgebreid. De pastorie (Dorpsweg 132) dateert uit het midden van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00492> a min:Passage,
