        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Chaam" ;
        min:lemma "R.K. kerk van St.-Antonius Abt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34707> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517169" ;
        min:soort "lemma" ;
        min:volgnummer 476 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill159>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill160> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0034> ;
        schema:name "R.K. kerk van St.-Antonius Abt"@nl ;
        schema:pageEnd "126" ;
        schema:pageStart "125" ;
        schema:pagination "125-126" ;
        schema:text """R.K. kerk van St.-Antonius Abt (Dorpsstraat 46) is een bakstenen kruiskerk uit 1925-'26, ontworpen door J. van Groenendael. De oorspronkelijke toren werd in 1944 opgeblazen. Naar ontwerp van W.J. Bunnik werd de kerk in 1948 hersteld en verlengd; de tevens herbouwde toren kreeg een op de verwoeste toren van de Herv. kerk geïnspireerd silhouet.

Het raadhuis (Raadhuisplein 1) dateert uit 1941 en bestaat uit twee bouwvolumes met zadeldaken tussen topgevels in de trant van de Delftse School."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0034.php> .

