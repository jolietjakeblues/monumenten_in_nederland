        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65810> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517503" ;
        min:soort "lemma" ;
        min:volgnummer 987 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill350> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0095> ;
        schema:name "Linden"@nl ;
        schema:pageEnd "241" ;
        schema:pageStart "240" ;
        schema:pagination "240-241" ;
        schema:text "Linden. Ten westen van Katwijk ligt het langgerekte oeverwaldorp (Groot) Linden. De R.K. St.-Lambertuskerk (Kerkstraat 34) is een eenbeukige kerk met een westtoren uit de tweede helft van de 15de eeuw en een iets jonger schip met smaller en lager, driezijdig gesloten koor. De toren heeft drie geledingen, waarvan de bovenste twee met spitsboognissen, en een zeskantige traptoren. Bij de restauratie aan het eind van de 19de eeuw, waarschijnlijk naar plannen van C. Franssen, werden de venstertraceringen vernieuwd. Het interieur heeft beschilderde kruisribgewelven op eenvoudige kraagstenen. Tot de inventaris behoren beelden van St. Anna en St. Antonius Abt (15de eeuw), een St.-Barbarabeeld (vroeg-16de-eeuws) en een altaarkruis (vroeg-17de-eeuws). Op het kerkhof staat een grafkruis uit 1645 en in de nabijheid een H. Hartbeeld uit 1919 door Van Bokhoven en Jonkers. De pastorie (Kerkstraat 32) stamt uit de tijd van de restauratie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00988> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Moerdijk" ;
        min:gemeenteInBoek "Zevenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Moerdijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klundert (gemeente Zevenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Klundert" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 988 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Klundert (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "241" ;
        schema:pageStart "241" ;
        schema:pagination "241" ;
        schema:text "Voorstraatdorp gesticht kort na de inpoldering van het gebied ‘de Clundert’ omstreeks 1558. Haaks op de dijk (Oliemolenstraat-Kaai-Hoogstraat) vormt de Bottekreek de centrale as van het dorp, met aan weerszijden een voorstraat (Molen- en Voorstraat) en parallel daaraan een achterstraat (Ooster- en Westerstraat). Aan de noordzijde komen deze straten uit op twee pleinen, met respectievelijk de Herv. kerk en het stadhuis. Aan het eind van de 16de eeuw legde men versterkingen aan en werd Klundert vestingstad. De vesting werd in 1809 opgeheven. Aan het eind van de 19de eeuw ontstond direct buiten de vestingwerken enige villabebouwing langs de Zevenbergseweg. Het stadje raakte zwaar beschadigd tijdens de Tweede Wereldoorlog. Bij de wederopbouw bleef het oude stratenpatroon gehandhaafd en verrees de nieuwbouw in de trant van de Delftse School. De huizen aan weerszijden van de Bottekreek maakten evenwel plaats voor groenstroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00989> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen)"@nl ;
