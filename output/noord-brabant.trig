        schema:name "Someren"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De R.K.O.L. Vrouwe ten Hemelopnemingskerk (Nieuwendijk 36, Someren Eind) is een lage, brede zaalkerk met aanbouwen en een vrijstaande, traditioneel vormgegeven toren met in beton uitgevoerde details, gebouwd in 1957 naar plannen van J. Strik."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01394> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Someren – Windmolens"@nl ;
        min:adres "Einhoutsestraat 12" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Someren" ;
        min:gemeenteInBoek "Someren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Someren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Someren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Someren" ;
        min:lemma "Windmolens" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1394 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0160> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "Windmolens. Ten westen van de kern ligt Den Evert (Einhoutsestraat 12), een halfgesloten-standerdmolen. Deze vroegere bankorenmolen van de norbertijnerabdij van Postel (België) zou in 1543 zijn gebouwd en verbouwd in 1738, waarna hij het in 1767 in particulier bezit kwam. In 1978 verhuisde hij van zijn oorspronkelijke plek nabij de Zuid-Willemsvaart naar zijn huidige standplaats. De ronde beltkorenmolen in de Kerkstraat (bij nr. 33) dateert uit 1853 en werd herbouwd na een brand in 1868."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01395> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Son en Breugel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Son en Breugel" ;
        min:gemeenteInBoek "Son en Breugel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Son_en_Breugel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Son en Breugel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Son en Breugel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1395 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0161> ;
        schema:name "Son en Breugel"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De twee kleine agrarische nederzettingen Son (vroeger Zon genoemd) en Breugel ontwikkelden zich in de middeleeuwen tot kerkdorpen. In Son, ontstaan op de linkeroever van de Dommel, was de bebouwing geconcentreerd rondom het driehoekige marktplein met raadhuis, waarvan het karakter door de aanleg van de doorgaande weg naar Eindhoven sterk werd aangetast. Na de Tweede Wereldoorlog heeft het dorp Son zich vooral aan de noordzijde uitgebreid en is het, gescheiden door het Dommeldal, één dubbelgemeente met Breugel gaan vormen. Breugel zelf is ontstaan als beekdalnederzetting waarvan de langgerekte hoofdstraat door plaatselijke verbreding het karakter van een plein heeft gekregen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01396> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Son en Breugel"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Son en Breugel" ;
        min:gemeenteInBoek "Son en Breugel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Son_en_Breugel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Son en Breugel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Son en Breugel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1396 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill459> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0161> ;
        schema:name "Son en Breugel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "297" ;
        schema:pagination "297-298" ;
        schema:text "De kerktoren (Kerkplein 1, Son) van de in 1958 door brand verwoeste en in 1962 gesloopte R.K. kerk St.-Petrus' Banden, is een Kempische toren uit omstreeks 1500. Het bouwwerk heeft drie geledingen en aan de westzijde forse overhoekse steunberen, waarvan die aan de noordwestzijde tot traptoren is uitgebouwd. De bovenste geleding is rijk versierd met mergelstenen hoekblokken. Bij de restauratie in 1975 heeft men de ingesnoerde spits vernieuwd. Op enige afstand van de toren is na 1958 een moderne kerk St.-Petrus' Banden gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01397> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Son en Breugel"@nl ;
        min:adres "St.-Genovevastraat 14",
            "St.-Genovevastraat 16" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Son en Breugel" ;
        min:gemeenteInBoek "Son en Breugel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Son_en_Breugel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Son en Breugel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Son en Breugel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1397 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0161> ;
        schema:name "Son en Breugel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "De R.K. St.-Genovevakerk (St.-Genovevastraat 14, Breugel) is een laat-gotische kerk, bestaand uit een eenbeukig schip, een driezijdig gesloten koor en een westtoren. Het koor is het oudst en werd in het midden van de 15de eeuw gebouwd. De toren en het schip, dat een romaanse voorganger verving, verrezen respectievelijk in het derde kwart en aan het eind van die eeuw. De naar het westen overhellende toren heeft drie geledingen en overhoekse steunberen, waarvan de zuidoostelijke tot traptoren is uitgebouwd. De derde geleding heeft spitsboognissen met natuurstenen driepassen en wordt afgesloten door een rondboogfries. De lage ingesnoerde spits verving in 1821 een in 1800 door storm verwoestte spits. Omstreeks 1600 kreeg de kerk een dwarsschip, maar dat werd in 1822 gesloopt. Tijdens de restauratie in 1956-'60, naar plannen van J. Strik, werd het huidige transept opgetrokken en kreeg het schip het huidige houten gewelf. Het eveneens sterk gerestaureerde koor heeft een netgewelf op kraagsteentjes met gebeeldhouwde menselijke figuurtjes en loofwerk. Het orgel, voorzien van sierlijk snijwerk, werd in 1853 gebouwd door J.J. Vollebregt & Zn. De pastorie (St.-Genovevastraat 16), uit het eind van de 19de eeuw, werd mogelijk gebouwd naar plannen van L.C. Hezenmans."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01398> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Son en Breugel"@nl ;
        min:adres "Markt 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Son en Breugel" ;
        min:gemeenteInBoek "Son en Breugel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Son_en_Breugel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Son en Breugel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Son en Breugel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34312> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "34124" ;
        min:soort "inleiding" ;
        min:volgnummer 1398 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0161> ;
        schema:name "Son en Breugel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "Het voorm. raadhuis (Markt 1, Son) is een rechthoekig gebouw uit omstreeks 1780. Het heeft een zadeldak tussen tuitgevels. De door een in- en uitgezwenkte gevel bekroonde middenrisaliet is voorzien van een hardstenen bordes. De gesneden ingangsomlijsting heeft een bovenlicht met het motief van een stralende zon. In 1920 werd het raadhuis gerestaureerd en aan de achterzijde uitgebreid naar plannen van L.J.P. Kooken. Woonhuis. Dommelstraat 12 te Son is een in oorsprong 17de-eeuws pand op L-vormige plattegrond, met een erker naast de ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01399> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Son en Breugel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Son en Breugel" ;
        min:gemeenteInBoek "Son en Breugel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Son_en_Breugel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Son en Breugel" ;
