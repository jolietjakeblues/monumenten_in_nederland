        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0074> ;
        schema:name "Handel (gemeente Gemert-Bakel)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Het kapucijnenklooster (Pater Petrusstraat 21), gelegen ten noorden van Handel, is een eenvoudig neoclassicistisch pand uit 1849-'50. Het interieur bevat een aantal 17de- en 18de-eeuwse meubels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0074.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00776> a min:Passage,
