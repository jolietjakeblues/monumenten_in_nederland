        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "31685" ;
        min:soort "lemma" ;
        min:volgnummer 1208 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0132> ;
        schema:name "Oosteind"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text "Oosteind. In dit dorp ten oosten van Oosterhout staat de R.K. kerk St. Johannes de Doper (Provincialeweg 86), een driebeukige basilicale kerk uit circa 1925 met driezijdig gesloten koor uit 1907. Van de voorganger uit 1852-'53, naar ontwerp van P. Soffers, is de toren van drie geledingen met ingesnoerde spits behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01209> a min:Passage,
