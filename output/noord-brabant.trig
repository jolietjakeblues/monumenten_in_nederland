        min:volgnummer 557 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0047> ;
        schema:name "Duizel (gemeente Eersel)"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text "Tot straatdorp uitgegroeide nederzetting, ontstaan op een dekzandrug in het stroomgebied van de Kleine Beerze. Het dorp had in de 19de eeuw een bloeiende sigarenindustrie, waarvan nu nog de Agio-sigarenfabriek langs de Provinciale weg getuigt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00558> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Duizel (gemeente Eersel)"@nl ;
        min:adres "Oude Kerkstraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eersel" ;
        min:gemeenteInBoek "Eersel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eersel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Duizel (gemeente Eersel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Duizel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 558 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill185> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0047> ;
        schema:name "Duizel (gemeente Eersel)"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text "De kerktoren (Oude Kerkstraat 1) van de in 1822 vervangen en in 1927 gesloopte St.-Johanneskerk dateert uit de tweede helft van de 15de eeuw. De toren heeft drie geledingen, voorzien van haaks op elkaar staande steunberen, en een lage, ingesnoerde spits uit 1800. De eerste geleding is versierd met spitsboognissen; de overige twee geledingen hebben spaarvelden met gekoppelde rondbogen. Het muurwerk is voorzien van metseltekens in de vorm van een kasteeltoren, een kruis en diagonale patronen in gesinterde koppen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00559> a min:Passage,
