        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "De Vervoornepolder-molen (Schenkeldijk ong.) is een vroeg-18de-eeuwse, achtkante poldermolen met bovenkruier in de Vervoornse polder. De molen is in 1969 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01632> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Werkendam – Verdedigingswerken"@nl ;
        min:adres "Bandijk 25" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
