        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Beugen. In dit dorp ten zuiden van Oeffelt staat de in oorsprong uit 1420 stammende R.K. kerk O.L. Vrouwe Hemelvaart (Kerkplein 3), die in 1875-'79 naar plannen van P.J.H. Cuypers werd vergroot, waarbij de 17de-eeuwse koorsluiting behouden bleef. De toren is een reconstructie door H.C. van de Leur uit omstreeks 1950 van de in 1944 vernielde 15de-eeuwse voorganger. De neogotische kapel op het kerkhof is vermoedelijk opgericht naar plannen van Cuypers. De pastorie (Kerkplein 5) stamt uit 1874. De windmolen ‘Maria’ (Molenstraat 26) is een ronde bakstenen beltkorenmolen uit 1866."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01159> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oijen (gemeente Lith)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Lith" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oijen (gemeente Lith)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1159 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0127> ;
        schema:name "Oijen (gemeente Lith)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Langgerekt dorp, ontstaan in de vroege middeleeuwen op een oeverwal langs de Maas. Als heerlijkheid behoorde Oijen tot het land van Cuijk. De uit 1837 stammende oude St.-Servatiuskerk werd in 1965 afgebroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0127.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01160> a min:Passage,
