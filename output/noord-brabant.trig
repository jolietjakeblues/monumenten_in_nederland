        schema:name "Boxmeer"@nl ;
        schema:pageEnd "96" ;
        schema:pageStart "96" ;
        schema:pagination "96" ;
        schema:text "De R.K. St.-Rochuskapel (Beugenseweg 2) is een zeskante kapel met ingezwenkt leien dak, oorspronkelijk gebouwd in 1742, maar in 1887 ingrijpend gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00361> a min:Passage,
