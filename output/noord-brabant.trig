        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Andel (gemeente Woudrichem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Andel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 176 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0010> ;
        schema:name "Andel (gemeente Woudrichem)"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Het woonhuis Julianastraat 1 is een eclectisch eenlaags herenhuis uit omstreeks 1870 met mansardedak en rijk gedecoreerde houten kroonlijst. Bij het huis staat een koetshuis uit dezelfde tijd, met ver overstekend rieten zadeldak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00177> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Andel (gemeente Woudrichem) – Boerderijen"@nl ;
        min:adres "Burg. van der Schansstraat 80" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Altena" ;
        min:gemeenteInBoek "Woudrichem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Andel (gemeente Woudrichem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Andel" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 177 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0010> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "Boerderijen. De boerderij Hoofdgraaf 7 dateert volgens de jaartalankers uit 1603, maar is in zijn huidige verschijningsvorm 19de-eeuws. De in gele baksteen opgetrokken voorm. dwarsdeelboerderij Burg. van der Schansstraat 21 dateert uit 1821. Voorbeelden van midden-19de-eeuwse brede dwarsdeelboerderijen met woon- en bedrijfsgedeelte onder één, hoog dak en met gedeeltelijk gepotdekselde wanden zijn De Korshof (Burg. van der Schansstraat 80), Hoge Maasdijk 62-64 en Kammetweg 2 (1846). De midden-19de-eeuwse boerderij Hoge Maasdijk 8 heeft door het dwars geplaatste woongedeelte een T-vormige plattegrond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00178> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Andel (gemeente Woudrichem) – Grenspalen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Altena" ;
        min:gemeenteInBoek "Woudrichem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
