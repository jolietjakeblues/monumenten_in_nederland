        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Het voorm. raadhuis (Grotestraat 72-74) is een blokvormig pand met bordes en een in het souterrain gelegen veldwachterswoning. Het werd omstreeks 1930 gebouwd in traditionele vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0152.php> .

