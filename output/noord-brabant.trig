        schema:text "Het raadhuis (Markt 1) werd in 1936 in traditionele vormen opgetrokken naar ontwerp van C. Roffelsen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00378> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boxtel – Woonhuizen"@nl ;
        min:adres "Rechterstraat 55" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxtel" ;
        min:gemeenteInBoek "Boxtel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxtel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boxtel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boxtel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 378 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0029> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Woonhuizen. Kruisstraat 5 is een woon- en winkelpand uit 1833 met een mogelijk oudere kern. Aan de Markt staan wellicht ook nog enkele panden met een oude kern. Het vroeg-19de-eeuwse, neoclassicistische herenhuis Clarissenstraat 37, met stoeppalen en jaloeziekasten, heeft tegen het koetshuis twee opmerkelijke aangebouwde hondenhokken uit 1880. Vanaf het midden van de 19de eeuw verrezen een aantal grote herenhuizen, waaronder Clarissenstraat 22 uit omstreeks 1840 en Bosscheweg 1-3 uit 1870. Voorbeelden uit van eclectische panden met stoeppalen uit die tijd zijn Stationsstraat 45 en Stationsstraat 69. Neogotische vormen heeft Clarissenstraat 8, gebouwd in 1896 naar plannen van W.Th. van Aalst. Boxtel heeft goede voorbeelden van jugendstil, zoals de villa Clarissenstraat 20 uit 1903, met dienstwoning en koetshuis (Koppel la), het winkelpand Kruisstraat 7 (omstreeks 1905), Stationsstraat 28 (omstreeks 1908) en villa Pfaff (Rechterstraat 55) uit 1911."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00379> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boxtel – Industriegebouwen"@nl ;
        min:adres "Duinendal 4",
            "Stationsplein 10" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxtel" ;
        min:gemeenteInBoek "Boxtel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxtel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boxtel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boxtel" ;
        min:lemma "Industriegebouwen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 379 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0029> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Industriegebouwen. De voorm. brouwerij ‘Het Anker’ (Duinendal 4) is een onderkelderd pand met puntgevel uit de 17de eeuw. De voorm. damastweverij Zandvliet 1-3 stamt uit 1850. Het station (Stationsplein 10) is een eilandstation met een stationsgebouw vierde klasse, gebouwd in 1863 naar plannen van K.H. van Brederode. In 1872 werd het gedeeltelijk vernieuwd en verlengd tot een station tweede klasse, waarna in 1890 nog een uitbreiding aan de linkerzijde volgde. De luifel uit 1872 rust op gietijzeren kolommen met consoles, die met klaverbladmotieven en fabeldieren zijn versierd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00380> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boxtel – Lennisheuvel"@nl ;
        min:adres "Lennisheuvel 50" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxtel" ;
        min:gemeenteInBoek "Boxtel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxtel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boxtel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boxtel" ;
        min:lemma "Lennisheuvel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 380 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0029> ;
        schema:name "Lennisheuvel"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Lennisheuvel. Dit gehucht ten zuiden van Boxtel ontstond in de middeleeuwen. De R.K. St.-Theresiakerk (Lennisheuvel 50) is een eenbeukige kerk met terzijde staande toren in sober expressionistische vormen, gebouwd in 1925 naar plannen van J. van Groenendael. De grote kortgevelboerderij Lennisheuvel 93 heeft een 17de-eeuws woonhuisgedeelte; de langsdeelschuur, de karschop en het bakhuis dateren uit de 18de- en 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00381> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Breda"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Breda" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Breda" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0030> ;
        schema:name "Breda"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "Stad ontstaan op de rand van de Brabantse zandgronden, nabij de plaats waar de rivieren de Mark en de Aa (of Weerijs) samenkomen. Tot in de 16de eeuw stonden deze nog onder invloed van eb en vloed. De beide stromen en de vele kreekarmen bepaalden tot in de 19de en 20ste eeuw de topografie van de stad. In het begin van de 11de eeuw woonden er al mensen in dit vrij laaggelegen gebied. Onder bescherming van het in 1190 voor het eerst genoemde kasteel van de heren van Breda, groeide de kleine nederzetting uit tot een handelsnederzetting aan de Mark, die tot hier bevaarbaar was. In 1252 kreeg Breda stedelijke rechten. De komst van het geslacht Van Polanen in 1350 zal de ontwikkeling van de stad hebben bevorderd. De nieuwe heer verleende de stad voorrechten als tegenprestatie voor het versterken van de stad, hetgeen overigens pas aan het eind van de 14de eeuw of het begin van de 15de eeuw was voltooid. De stadsmuren omvatten tot 1535 het oude hart van de stad, omsloten door de huidige (gedempte) Haven, Markendaalseweg, Karnemelkstraat, Houtmarkt, Oude Vest, Vlaszak, J.F. Kennedylaan en het kasteelterrein. Deze oude, eivormige kern is nog goed herkenbaar in het huidige stratenpatroon."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0030.php> .

