        min:volgnummer 1034 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0106> ;
        schema:name "Lithoijen (gemeente Lith)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Dorp dat zich kort na de middeleeuwen op een binnendijkse stroomrug ontwikkelde. Het langgerekte dorpsplein (Prelaat Van den Berghplein) bleef gaaf bewaard."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01035> a min:Passage,
