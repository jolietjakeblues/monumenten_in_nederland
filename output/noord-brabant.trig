        schema:pageEnd "189" ;
        schema:pageStart "188" ;
        schema:pagination "188-189" ;
        schema:text "Café De Zwaan (Kapelstraat 23), gebouwd met veranda en in- en uitge-zwenkte gevel, is een goed voorbeeld van een dorpscafe uit omstreeks 1905."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0080.php> .

