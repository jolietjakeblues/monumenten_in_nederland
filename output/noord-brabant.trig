        min:kern "Diessen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61027>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61847> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12896",
            "518929" ;
        min:soort "inleiding" ;
        min:volgnummer 530 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Diessen (gemeente Hilvarenbeek)"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "De pastorie (Heuvelstraat 1) is een herenhuis uit de eerste helft van de 19de eeuw. Links en rechts staat een lagere aanbouw met ingezwenkte topgevel. Het voorm. raadhuis (Willibrordusstraat 12) is een herenhuis uit 1880 in eclectische trant, oorspronkelijk gebouwd als burgemeesterswoning. In 1954 werd het pand verbouwd tot raadhuis, waarbij een klokkentorentje werd toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00531> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diessen (gemeente Hilvarenbeek) – Boerderijen"@nl ;
        min:adres "Beekseweg 24",
            "Julianastraat 29" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Hilvarenbeek" ;
        min:gemeenteInBoek "Hilvarenbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilvarenbeek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diessen (gemeente Hilvarenbeek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Diessen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14326>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24274> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12897",
            "518927" ;
        min:soort "lemma" ;
        min:volgnummer 531 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill177> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text """Boerderijen. Langgevelboerderij Pannenhuis (Julianastraat 29) dateert volgens de jaartalankers uit 1658 en heeft een zadeldak tussen twee topgevels met vlechtingen, duivengaten en een toppilaster. De boerderij is in de loop van de tijd verbouwd en gewijzigd. De langgevelboerderij 't Huiske ten Halve (Beekseweg 24) is gebouwd in 1871 in eclectische stijl. De halverwege de doorgaande weg naar Hilvarenbeek gelegen boerderij diende tot 1933 tevens als café. Beerseweg 1 en 2 zijn wederopbouwboerderijen uit 1941, gebouwd in navolging van de traditionele langgevelboerderijen.

Het sluiscomplex (St.-Josephstraat ong.), ten noordoosten van het dorp in het Wilhelminakanaal, bestaat uit een schutsluis, brug en pomphuis uit 1923 en een sluiskolk uit 1929. Het bijbehorende sluiswachtershuisje is vernieuwd. De stijl van de sluis en brug is puur functioneel, het pomphuis heeft Berlage-elementen en de sluiskolk heeft een zakelijke, functionalistische stijl en lijkt een verkleinde versie van het latere stuwcomplex te Lith."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00532> a min:Passage,
            schema:CreativeWork ;
