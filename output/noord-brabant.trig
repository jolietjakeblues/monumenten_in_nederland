        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill65> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0010> ;
        schema:name "Andel (gemeente Woudrichem)"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "61" ;
        schema:pagination "61-62" ;
        schema:text "De kerktoren en -ruïne (Hoofdgraaf 6) zijn restanten van de voorm. Herv. kerk van Neer-Andel. De toren van drie geledingen heeft spitsboognissen en een slanke, achtkante bakstenen spits. Het bouwwerk dateert uit de tweede helft van de 14de eeuw. De bijbehorende laat-gotische kerk - na 1648 in gebruik als Herv. kerk - is grotendeels gesloopt; bewaard bleven de zuidelijke dwarskapel en enkele muurfragmenten van het schip. Toren en kerkruïne zijn gerestaureerd in 1954."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00175> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Andel (gemeente Woudrichem)"@nl ;
        min:adres "Kerkstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Altena" ;
