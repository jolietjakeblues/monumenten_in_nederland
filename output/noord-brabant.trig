        min:gemeenteInBoek "Etten-leur" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Etten-Leur_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Etten-leur" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Etten-leur" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 650 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0057> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "Boerderijen. Van de 17de-eeuwse langhuisboerderij Lange Brugstraat 87-89 is het woongedeelte nog grotendeels origineel; de oostgevel daarvan heeft kruiskozijnen met geblokte strekken. Boerderij Korte Brugstraat 44 is een voor de streek ongebruikelijk type: het woonhuis met zijn middengang is dwars op de lengteas van de stal gericht. Buiten Etten-Leur liggen ook enkele interessante langgevelboerderijen: Middeldonkweg 5, opgetrokken in gele ijsselsteen en met een rieten zadeldak (1712); Hoge Bremberg 7, met opkamer en kelder (omstreeks 1860); Hoge Bremberg 9 (omstreeks 1850), 11 (begin 20ste eeuw) en 18 (1917)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00651> a min:Passage,
