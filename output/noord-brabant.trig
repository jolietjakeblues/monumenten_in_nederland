        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Boerderijen. Rondom Asten liggen enkele interessante 20ste-eeuwse boerderijen. De Maria Helena Hoeve (Smientweg 1) werd in 1927 gebouwd als ontginningsboerderij. De langgevelboerderijen Bergweg 61, Bergweg 63 en Meijelseweg 88 stammen alle drie uit 1947 en dragen een jaartalsteen met het opschrift ‘Nederland Herrijst’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00189> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asten – Heusden"@nl ;
        min:adres "Vorstermansplein 10-12",
            "Vorstermansplein 14" ;
