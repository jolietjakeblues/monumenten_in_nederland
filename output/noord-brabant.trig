        schema:text "De school met onderwijzerswoning (Kruisstraat 29-31) stamt uit het laatste kwart van de 19de eeuw, maar zou een oudere kern kunnen bevatten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01327> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rosmalen (gemeente 's-Hertogenbosch) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 66",
            "Molenstraat 17",
            "Sparrenburgstraat 5",
