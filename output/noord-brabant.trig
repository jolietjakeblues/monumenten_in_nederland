        schema:name "Boerderij"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Boerderij Strijpdreef 6 is een 19de-eeuws boerderijcomplex bestaande uit een gepleisterd eenlaags woonhuis met zadeldak tussen topgevels en aan de rechterzijde aansluitend een houten schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud Gastel (gemeente Halderberge) – Stampersgat"@nl ;
        min:adres "Brugstraat 2",
            "Dennis Leestraat 25" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oud Gastel (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oud Gastel" ;
        min:lemma "Stampersgat" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1243 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0136> ;
        schema:name "Stampersgat"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Stampersgat. Dit dijkdorp langs de Dintel, gelegen ten noorden van Oud Gastel, is waarschijnlijk ontstaan in de 15de eeuw. Pas sinds 1899 is het een kerkdorp. De R.K. kerk van de H.H. Martelaren van Gorkum (Dennis Leestraat 25) is een neogotische kruiskerk, gebouwd in 1924 naar plannen van W. te Riele. Hij ontwierp ook het in 1927 bij de kerk opgetrokken klooster van de zusters franciscanessen van Oudenbosch. De pastorie (Brugstraat 2) stamt waarschijnlijk uit het midden van de 19de eeuw. In het dorp staat ook een ronde bakstenen watertoren (Brugstraat ong.) uit 1952, gebouwd naar ontwerp van J.M. Hurks."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01244> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudenbosch (gemeente Halderberge)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudenbosch (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oudenbosch" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1244 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill416> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0137> ;
        schema:name "Oudenbosch (gemeente Halderberge)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "274" ;
        schema:pagination "274-275" ;
        schema:text "Het gebied rond het latere Oudenbosch werd vanaf 1275 ontgonnen door de cisterciënzerabdij St.-Bernard bij Antwerpen. Op de lage gronden aan de Barlake, de toenmalige verbinding tussen Mark en Dintel, verscheen de eerste bebouwing. Overstromingen in de eerste decennia van de 15de eeuw verdreven de bewoners naar de zuidelijker gelegen, hogere zandgronden, waar het huidige Oudenbosch ontstond. De ligging op een knooppunt van land- en waterwegen bevorderde handel en verkeer. De stichting van het kloosterinternaat St.-Anna in 1837 gaf een belangrijke impuls aan de ontwikkeling van Oudenbosch tot kerkelijk centrum. Dit meisjesinternaat en het jongensinternaat St.-Louis gaven Oudenbosch verder een grote bekendheid op onderwijsgebied."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01245> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudenbosch (gemeente Halderberge)"@nl ;
        min:adres "Fenkelstraat 24",
            "Fenkelstraat 26" ;
