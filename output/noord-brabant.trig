        min:volgnummer 1292 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0145> ;
        schema:name "Riethoven (gemeente Bergeijk)"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "De R.K. St.-Willibrordusschool (Schoolstraat 15), gebouwd omstreeks 1920 in ‘Um 1800’-vormen, bestaat uit twee haaks op elkaar staande vleugels en een aangebouwde onderwijzerswoning rondom een schoolplein. Het raadhuis (Dorpsplein 5) verrees in 1932 naar plannen van H. Vervest. Het gebouw heeft het karakter van een villa en is uitgevoerd in eenvoudige, licht-expressionistische vormen. In 1979 kreeg het pand aan de achterzijde een uitbreiding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01293> a min:Passage,
