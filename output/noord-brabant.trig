        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "424832" ;
        min:soort "inleiding" ;
        min:volgnummer 1388 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0159> ;
        schema:name "Soerendonk (gemeente Budel)"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "De R.K. kerk St.-Johannes' Onthoofding (Dorpsstraat 25) is een neogotische kruiskerk, die in 1836-'38 verrees naar plannen van J. van de Rijt; het transept en het koor werden echter in 1932 naar ontwerp van J. Franssen vernieuwd. De in 1908-'10 opgetrokken westtoren van drie geledingen met ingesnoerde spits is mogelijk een ontwerp van C. Franssen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01389> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Soerendonk (gemeente Budel)"@nl ;
        min:adres "Cranendonck 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Cranendonck" ;
        min:gemeenteInBoek "Budel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cranendonck> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Soerendonk (gemeente Budel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Soerendonk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1389 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0159> ;
        schema:name "Soerendonk (gemeente Budel)"@nl ;
        schema:pageEnd "297" ;
        schema:pageStart "297" ;
        schema:pagination "297" ;
        schema:text "Het voorm. raadhuis (Cranendonck 1), gelegen ten oosten van het dorp, staat op de plaats van het in 1270 vermelde en in 1673 door de Fransen verwoeste kasteel Cranendonck. In 1899 verrees hier het landhuis Cranendonck, dat in 1939-'40 ingrijpend werd verbouwd en uitgebreid naar plannen van J. Roffelsen. Het wit geschilderde gebouw op L-vormige plattegrond heeft zijn ingang in de zeskante toren - met ingezwenkte leien spits - in de binnenhoek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0159.php> .

