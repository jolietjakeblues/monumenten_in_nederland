        min:volgnummer 777 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0075> ;
        schema:name "Hapert (gemeente Bladel)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "De R.K. St.-Severiuskerk (Kerkstraat 3) is een neoromaanse kruisbasiliek, gebouwd in 1923-'24 naar ontwerp van C. Franssen. Naar plannen van J.C. van Buytenen voegde men in 1938 kapellen en portalen toe. De pastorie (Kerkstraat 1) stamt uit 1926 en is gebouwd in traditionele trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00778> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hapert (gemeente Bladel)"@nl ;
        min:adres "Kerkstraat 23" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Bladel" ;
        min:gemeenteInBoek "Bladel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bladel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hapert (gemeente Bladel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hapert" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 778 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0075> ;
        schema:name "Hapert (gemeente Bladel)"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "182" ;
        schema:pagination "182-183" ;
        schema:text "De voorm. pastorie (Kerkstraat 23) van de in 1924 gesloopte R.K. St.-Severiuskerk (1856-'58) dateert uit omstreeks 1860. Het tweelaags pand met zadeldak tussen topgevels is voorzien van een rijk geornamenteerde voorgevel. De pastorietuin heeft een landschappelijke aanleg. Naast de pastorie ligt nog het oude kerkhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0075.php> .

