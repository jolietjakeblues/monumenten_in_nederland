        min:kern "Bladel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 335 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0024> ;
        schema:name "Bladel"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De R.K. jongensschool St.-Franciscus Xaverius (Sniederslaan 51) is een school met drie klassen, een ingangsrisaliet en een wolfdak, gebouwd in 1913 naar ontwerp van J. Heykants."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00336> a min:Passage,
