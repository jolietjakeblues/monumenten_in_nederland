        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill434> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0145> ;
        schema:name "Riethoven (gemeente Bergeijk)"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "De R.K. St.-Willibrorduskerk (Dorpsplein 6) is een neogotische pseudo-basilicale kruiskerk met westtoren en slanke achtzijdige spits uit 1895-'99, gebouwd naar plannen van C. Franssen. Van de 15de-eeuwse kruiskerk ter plaatse zijn restanten muurwerk opgenomen, zoals de onderste torengeleding. De pastorie (Molenstraat 1) stamt uit omstreeks 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0145.php> .

