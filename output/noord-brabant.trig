        min:volgnummer 619 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0053> ;
        schema:name "Engelen (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "Dorp, ontstaan op een donk langs de Dieze. Omstreeks 815 moet er al een nederzetting zijn geweest en in 1147 is er sprake van een kerkgebouw. Aan het eind van de 14de eeuw was er een blokhuis ter bescherming van de scheepvaart op de Dieze. De toename van het scheepvaartverkeer na 1800 betekende een nieuwe bloei voor Engelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00620> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Engelen (gemeente 's-Hertogenbosch)"@nl ;
        min:adres "De Kerkhof 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "'s-Hertogenbosch" ;
        min:gemeenteInBoek "'s-Hertogenbosch" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/'s-Hertogenbosch> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Engelen (gemeente 's-Hertogenbosch)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Engelen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 620 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0053> ;
        schema:name "Engelen (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De Herv. kerk (De Kerkhof 2) is een driezijdig gesloten zaalkerkje met dakruiter. Het gebouw verrees kort na 1551 als koor van de laat-15de-eeuwse St.-Lambertuskerk. Staatse troepen verwoesten die kerk in 1587, maar het koor bleef gespaard en werd na herstel in 1614-'15 ingericht als Herv. kerk. In het interieur hangt een door Borghart vervaardigde koperen lichtkroon uit 1794."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00621> a min:Passage,
