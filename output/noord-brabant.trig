        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "De kerktoren (Kerkhoef 16) van de in 1898 afgebroken middeleeuwse St.-Lambertuskerk, is een eenvoudig 15de-eeuws bouwwerk van drie geledingen dat in 1938 haar spits verloor. Dakmoeten, balkgaten en doorgang naar de afgebroken kerk zijn nog goed herkenbaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0121.php> .

