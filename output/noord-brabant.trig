        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Het voorm. rechthuis (Beekstraat 11) dateert volgens de jaartalankers uit 1734. In dit dwarshuis zetelden tot 1875 de schout en schepenen van Nuenen-Gerwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0125.php> .

