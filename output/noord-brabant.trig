        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "Dorp ontstaan in de middeleeuwen op een oeverwal van de (Afgedamde) Maas. Het vroegere onderscheid in Op-Andel en Neer-Andel is thans niet meer te herkennen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00174> a min:Passage,
            schema:CreativeWork ;
