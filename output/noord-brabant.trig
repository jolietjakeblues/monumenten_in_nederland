        min:kern "Gilze" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52348> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "16133" ;
        min:soort "inleiding" ;
        min:volgnummer 722 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill240> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0068> ;
        schema:name "Gilze (gemeente Gilze en Rijen)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "De voorm. schuurkerk (Kerkstraat 33) stond oorspronkelijk op het erf van het gesloopte 17de-eeuwse huis ‘De Oude Pastorie’. Het is een grote Vlaamse schuur, waarvan een van de balken het jaartal 1647 draagt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0068.php> .

