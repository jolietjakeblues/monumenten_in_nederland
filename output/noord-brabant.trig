        schema:name "Heesbeen (gemeente Heusden)"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "Langgerekt oeverwalgehucht met verspreide bebouwing, mogelijk ontstaan in de 9de of 10de eeuw. Het aan de westzijde gelegen kasteel werd in 1589 verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00787> a min:Passage,
            schema:CreativeWork ;
