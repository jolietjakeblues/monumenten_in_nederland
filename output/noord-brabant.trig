        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Megen (gemeente Oss)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Megen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1068 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0113> ;
        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "251" ;
        schema:pageStart "251" ;
        schema:pagination "251" ;
        schema:text "Hoofdplaats van het gelijknamige graafschap. Megen wordt voor het eerst in 1134 vermeld. Het werd gesticht ten oosten van het grafelijke slot op een oeverwal van de Maas, die de stad oorspronkelijk aan drie zijden omsloot. Na de stadsrechtverlening in 1357 voorzag men de nederzetting van een omwalling met poorten en torens. Charles de Brimeu, graaf van Megen, speelde in het begin van de Tachtigjarige Oorlog een belangrijke rol aan Spaanse zijde, maar dat kon niet voorkomen dat Spaanse troepen de stad in 1581 verwoestten. Vanaf 1697 behoorde Megen tot het Land van Ravenstein; tot 1800 bleef het een katholieke enclave. Binnen de wallen behield de stad een grotendeels landelijk karakter, met uitzondering van de Torenstraat, en twee haaks daarop naar de Maasdijk lopende splitsende straten, de Dr. Baptiststraat en de Kloosterstaat, die samenkomen in de Koolmarkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01069> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:adres "Kloosterstraat 6" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Oss" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Megen (gemeente Oss)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Megen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59479> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "28520" ;
        min:soort "inleiding" ;
        min:volgnummer 1069 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0113> ;
        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "251" ;
        schema:pageStart "251" ;
        schema:pagination "251" ;
        schema:text "Het franciscanerklooster St.-Antonius van Padua (Kloosterstraat 6) bestaat uit vier vleugels rondom een kloosterhof. De zuid- en de westvleugel dateren uit 1648-'54, de oostvleugel en de kapel uit 1670. In 1709 werd de oostvleugel zuidwaarts uitgebreid en in 1713 kwam het gastenkwartier tot stand. In de kloostergang bevinden zich twintig gebrandschilderde glazen uit de tweede helft van de 17de eeuw, met namen en wapens van schenkers. De kloosterkapel heeft een stucgewelf. Tot het rijk gesneden meubilair behoren drie barokke altaren (omstreeks 1680), met de wapens van de schenkers Reinier van Stepraedt en Maria Johanna van Amstel van Mijnden, verder vier biechtstoelen met wapens (1695) en een eiken preekstoel met evangelistensymbolen (1696). Het laat-17de-eeuwse orgel werd in 1866-'67 ingrijpend gewijzigd door de Gebr. Gradussen en kreeg toen een nieuwe orgelkast, met behoud van de oude vleugelstukken en snijwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01070> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:adres "Clarissenstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Oss" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Megen (gemeente Oss)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Megen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1070 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0113> ;
        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "251" ;
        schema:pageStart "251" ;
        schema:pagination "251" ;
        schema:text "Het clarissenklooster St.-Josephsberg (Clarissenstraat 2) staat op plaats van de voorburcht van het in 1581 door brand verwoeste en in 1610 gesloopte kasteel van de graven van Megen. De omgrachting is intact gebleven. De in 1717 uit Boxtel verdreven clarissen betrokken in 1721 hun nieuwe klooster. Bij de bouw van de drie eenvoudige vleugels rondom een kloosterhof maakte men gebruik van bestaande kelders en muurwerk. De eenvoudige neogotische kapel met dakruiter en het poortgebouw met Christusbeeld stammen uit 1896-'97."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01071> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:adres "Schoolstraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Oss" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Megen (gemeente Oss)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Megen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22940> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "28540" ;
        min:soort "inleiding" ;
        min:volgnummer 1071 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill371> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0113> ;
        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "251" ;
        schema:pagination "251-252" ;
        schema:text "De R.K. St.-Servatiuskerk (Schoolstraat 1) is een driebeukige neogotische basiliek uit 1870-'72, opgetrokken naar ontwerp van H.C. Dobbe-Van Pelt. In de westtoren met ingesnoerde spits hangt een luidklok uit 1399, gegoten door Arnoldus van Grave. De kerk bevat een 15de-eeuws doopvont en een in 1879 door de Gebr. Gradussen gebouwd orgel. Op het schuin ertegenover gelegen kerkhof - op de plek van de in 1581 verwoeste oude St.-Servatiuskerkstaan een grafmonument voor burgemeester R. Libotte uit 1859 en een grafmonument in de vorm van een sokkel uit 1861 voor baron Van Blokland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01072> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Oss" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Megen (gemeente Oss)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Megen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1072 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0113> ;
        schema:name "Megen (gemeente Oss)"@nl ;
        schema:pageEnd "252" ;
        schema:pageStart "252" ;
        schema:pagination "252" ;
        schema:text "De gevangentoren (Maasdijk ong.), een hoog oprijzend vierkant bouwwerk met zadeldak tussen trapgevels met ezelsruggen, is het enige overblijfsel van de 14de-eeuwse stadsmuur. De toren werd grotendeels herbouwd na de verwoesting in 1581 en diende later nog als woning. Bij een restauratie in 1922-'24 heeft men onder meer de eerder dichtgemaakte vensters opnieuw geopend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01073> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Megen (gemeente Oss)"@nl ;
        min:adres "Everardusplein 1" ;
