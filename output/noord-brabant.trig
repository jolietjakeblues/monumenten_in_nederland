        schema:name "Kaatsheuvel (gemeente Loon op Zand)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De steenkolen- en gasfabriek DEMA (Jan de Rooijstraat 36), bestaande uit een tweelaags hoofdgebouw met spaarbogen en zadeldak, en aan weerszijden lagere zijvleugels, dateert uit 1911."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00980> a min:Passage,
            schema:CreativeWork ;
