        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "Boerderijen. In dit gebied liggen overwegend T-boerderijen. Goede voorbeelden zijn de aan de voet van de dijk gelegen boerderijen Kesselsedijk 18 en 29, beide uit omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0111.php> .

