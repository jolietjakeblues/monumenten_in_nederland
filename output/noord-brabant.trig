        schema:name "Langgevelboerderij"@nl ;
        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "Langgevelboerderij ‘Sleutelhoeve’ (Looneind 3b) uit 1632 heeft een kelder en opkamer en een rieten wolfdak. Bij de boerderij horen een bakhuis met uitgebouwde oven en een schuur onder een schilddak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0009.php> .

