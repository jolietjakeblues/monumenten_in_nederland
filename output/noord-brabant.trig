        schema:name "Haaren"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Het voorm. franciscanerklooster (Haarensteijnsestraat 2), uit het begin van de 20ste eeuw, is nu bejaardentehuis. De koorsluiting en het H. Hartbeeld dateren beide uit 1947."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0072.php> .

