        schema:pageEnd "194" ;
        schema:pageStart "194" ;
        schema:pagination "194" ;
        schema:text "Winkels. De voorm. winkel van De Gruyter (Veestraat 2) dateert uit 1917 en heeft art deco-elementen naar ontwerp van W.G. Welsing. Markt 5 is een winkel in historiserende vormen uit 1931, gebouwd in opdracht van D. Kat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0082.php> .

