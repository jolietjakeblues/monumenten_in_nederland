        min:rijksmonumentnummer "517514",
            "526755",
            "526819" ;
        min:soort "lemma" ;
        min:volgnummer 1212 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0133> ;
        schema:name "Bekenstein"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Bekenstein (Grotestraat 1). Van kasteel Bekenstein resteert nog de kasteelboerderij met een 16de-eeuwse kern en vensters uit omstreeks 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01213> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oploo (gemeente Sint Anthonis) – Molens"@nl ;
        min:adres "Vloedweg 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Land van Cuijk" ;
        min:gemeenteInBoek "Sint Anthonis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Land_van_Cuijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oploo (gemeente Sint Anthonis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oploo" ;
        min:lemma "Molens" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1213 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0133> ;
        schema:name "Molens"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Molens. De korenwatermolen Watermolenstraat 2 is een onderslagmolen op de Oploose Molenbeek. Omdat de beek een bescheiden wateraanvoer had, kon er vrijwel alleen in de winter gemalen worden en daarom gaat het hier om een zogeheten wintermolen. Het oudste deel van dit rechthoekige gebouw met zadeldak en ijzeren onderslagrad dateert mogelijk uit omstreeks 1725; het achterste deel met trijshuisje, waar een oliemolen was ondergebracht, zou uit 1780 stammen. Nabij de watermolen ligt de windmolen De Korenbloem (Vloedweg 2). Deze geslotenstanderdmolen werd in 1747 in Den Dungen gebouwd en in 1800 naar zijn huidige plaats overgebracht. Een dergelijke combinatie van water- en windmolen is uniek voor Nederland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0133.php> .

