        min:volgnummer 1154 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill388> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0126> ;
        schema:name "Oeffelt (gemeente Boxmeer)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "260" ;
        schema:pagination "260-261" ;
        schema:text "De R.K. kerk Zoete Naam Jezus (Kerkplein 3) is een driebeukige basiliek met voorhal en terzijde staande ronde toren. Het gebouw verrees in 1954 in mergelsteen op de plaats van de in 1944 verwoeste St.-Salvatorkerk uit 1853 van P.J.H. Cuypers. Het ontwerp van N. van der Laan is geïnspireerd op de vroeg-christelijke architectuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01155> a min:Passage,
