        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1512 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "Dorp ontstaan in de late middeleeuwen bij een doorwaadbare plaats in de Aa en in de nabijheid van het verdwenen kasteel Frisselstein. Haaks op de doorgaande hoofdweg ontstond het huidige marktplein. Het graven van de Zuid-Willemsvaart in 1822-'26 en de aanleg van de spoorlijn Boxtel-Wesel in 1872 zorgden voor een bloeiende handel en nijverheid. Nog steeds vormt Veghel een belangrijk centrum van werkgelegenheid voor de Meierij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01513> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel"@nl ;
        min:adres "Hoofdstraat 53" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19256> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "37036" ;
        min:soort "inleiding" ;
        min:volgnummer 1513 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "De Herv. kerk (Hoofdstraat 53) is een langwerpige achtkante, neoclassicistische zaalkerk uit 1823, gebouwd naar plannen van J. Schoonwater. Het gebouw is voorzien van geblokte pilasters, spitsboogvensters met gietijzeren vensterharnassen en een middenrisaliet met dorische deuromlijsting. Tot de inventaris behoort een doopbekkenhouder uit omstreeks 1650 en een preekstoel met koperen lessenaar uit 1751."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01514> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1514 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "De R.K. St.-Lambertuskerk (Markt ong.) is een driebeukige neogotische kruisbasiliek met hoge westtoren en slanke naaldspits, gebouwd in 1858-'62 naar plannen van P.J.H. Cuypers. Het is de eerste grote kerk waarbij Cuypers zich voor het ontwerp liet inspireren op de 13de-eeuwse Franse gotiek. Het interieur heeft bakstenen kruisribgewelven. Het atelier van Cuypers en Stoltzenberg verzorgde het overgrote deel van de neogotische inventaris, waaronder de vele zandstenen heiligenbeelden. Het sacramentsaltaar werd in 1886 gemaakt door H. van der Geld. Bij een restauratie in 1992-'94 werden de gepolychromeerde heiligenbeelden bij de pijlers hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01515> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel"@nl ;
        min:adres "Burg. De Kuyperlaan 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1515 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill494> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "316" ;
        schema:pagination "316-317" ;
        schema:text "Op het kerkhof bevindt zich een calvarieberg met grafkelders en kruisigingsgroep met gietijzeren kruisbeeld, vervaardigd in 1852 en verplaatst in 1873. J. Goossens maakte omstreeks 1850 de in de berg geplaatste gepolychromeerde terracotta beeldengroep met voorstelling van zielen in het vagevuur. Verder zijn er nog diverse monumentale 19de-eeuwse grafmonumenten in neobarokke en neogotische vormen. De pastorie (Burg. De Kuyperlaan 1) werd in 1902-'03 gebouwd naar plannen van J.Th.J. Cuypers en J. Stuyt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01516> a min:Passage,
