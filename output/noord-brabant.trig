        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10541>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25763> ;
