        min:kern "Galder" ;
        min:lemma "Boerderij" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 658 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0059> ;
        schema:name "Boerderij"@nl ;
        schema:pageEnd "159" ;
        schema:pageStart "159" ;
        schema:pagination "159" ;
        schema:text "Boerderij ‘Daesdonck’ (Daesdonckseweg 3) is een 18de-eeuwse langhuisboerderij, waarvan het woongedeelte is voorzien van schuifvensters. Oorspronkelijk hoorde ze bij het in 1832 afgebrande kasteel Daesdonck, waarvan nog bouwfragmenten zijn hergebruikt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00659> a min:Passage,
