        schema:name "Sint-Oedenrode"@nl ;
        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "Het voorm. St.-Martinushuis (Markt 30) werd in 1904 in neogotische stijl gebouwd als parochiehuis, vermoedelijk naar plannen van W.Th. van Aalst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01381> a min:Passage,
