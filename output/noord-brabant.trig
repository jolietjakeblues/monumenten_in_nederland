        min:volgnummer 1236 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0135> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Woonhuizen. Het mogelijk nog 17de-eeuwse eenlaags huis Aanwas 29 heeft een steil zadeldak tussen topgevels en een interieur van omstreeks 1800. Dorpsstraat 3 dateert uit de eerste helft van de 19de eeuw; het was oorspronkelijk een eenlaags huis maar kreeg omstreeks 1900 een verdieping. Het heeft een in blokverband gepleisterde voorgevel met kroonlijst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0135.php> .

