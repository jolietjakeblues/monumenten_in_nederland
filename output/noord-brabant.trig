        schema:name "Welberg"@nl ;
        schema:pageEnd "300" ;
        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Welberg. In dit dorp ten zuidoosten van Steenbergen staat de R.K. St.-Corneliuskerk (Kapelaan Kockstraat 44), een kruiskerk met toren en halfronde absis, gebouwd in 1928 in expressionistische trant naar ontwerp van J. en W. Oomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0165.php> .

