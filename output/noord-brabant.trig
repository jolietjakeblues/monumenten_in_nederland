        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Het raadhuis (Kerkstraat 30) met dakruiter werd in 1931 in expressionistische stijl gebouwd naar ontwerp van J. Heykants."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0025.php> .

