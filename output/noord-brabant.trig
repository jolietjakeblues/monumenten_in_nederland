        schema:pageEnd "343" ;
        schema:pageStart "343" ;
        schema:pagination "343" ;
        schema:text "De Herv. kerk (Vincent van Goghplein 1) is een eenvoudig zaalgebouw met vierkante dakruiter, gebouwd in 1805 naar ontwerp van H. Huijsers. Het interieur heeft een gestuct koofplafond en bevat een tochtportaal en een eenvoudige preekstoel uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0201.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01702> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zundert"@nl ;
