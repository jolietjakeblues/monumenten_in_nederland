        schema:name "Esch (gemeente Haaren)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 6) stamt uit 1856. Aan de achterzijde van het pand zitten een nis met waterbak en twee getraliede ramen, die de plaats van het oude cachot aangeven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0056.php> .

