        schema:name "Bidkapel"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "Bidkapel. De in de as van de Dorpsstraat gelegen Mariakapel in neogotische stijl dateert uit 1938 en werd gebouwd naar plannen van A. Siebers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01494> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulvenhout (gemeente Breda) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 90-92" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
