        min:volgnummer 930 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0086> ;
        schema:name "Grenspaal"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "234" ;
        schema:pagination "234" ;
        schema:text "Grenspaal. Bij de Wijkse poort bevindt zich een vierkante hardstenen paal met het wapen van Heusden en het jaartal 1785."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0086.php> .

