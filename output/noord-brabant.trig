        schema:name "Hintham (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het woonhuis Hintham 102 is een witgepleisterd dwars huis met zadeldak tussen tuitgevels en aan de achterzijde een bakhuis en aangebouwde kamer. Het pand stamt in oorsprong waarschijnlijk uit de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0088.php> .

