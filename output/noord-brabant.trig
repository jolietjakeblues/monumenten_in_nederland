            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56257> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "23677",
            "38952",
            "521720" ;
        min:soort "inleiding" ;
        min:volgnummer 989 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Klundert (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "241" ;
        schema:pageStart "241" ;
        schema:pagination "241" ;
        schema:text "De Herv. kerk (Kerkring 1) is een sobere, traditionalistisch vormgegeven zaalkerk. Ze verrees in 1952 naar ontwerp van A.P. Smits en verving de in 1944 verwoeste voorgangster. De kerk staat op een vierkant, met een kerksloot omgeven terrein. Het toegangshek heeft natuurstenen pijlers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00990> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen)"@nl ;
        min:adres "Molenstraat 31-33" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Moerdijk" ;
        min:gemeenteInBoek "Zevenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Moerdijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klundert (gemeente Zevenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Klundert" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 990 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Klundert (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "241" ;
        schema:pageStart "241" ;
        schema:pagination "241" ;
        schema:text "De R.K. kerk St.-Johannes de Doper (Molenstraat 31-33) is een driebeukige neogotische kruiskerk, gebouwd in 1889-'90 naar ontwerp van P.J. van Genk. In 1944 leed het gebouw zware oorlogsschade. Bij het herstel in 1946-'47 zag men af van herbouw van de toren en kreeg de kerk een neoromaanse westgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00991> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen)"@nl ;
        min:adres "Stadhuisring 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Moerdijk" ;
        min:gemeenteInBoek "Zevenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Moerdijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klundert (gemeente Zevenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Klundert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50211> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "23675" ;
        min:soort "inleiding" ;
        min:volgnummer 991 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Klundert (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "241" ;
        schema:pagination "241-242" ;
        schema:text "Het stadhuis (Stadhuisring 1) is een dwars geplaatst, vrijstaand gebouw uit 1621 met souterrain, bordes, een zadeldak tussen trapgevels en een topgevel midden boven de voorgevel. Het ontwerp van dit rijk gedetailleerde maniëristische bouwwerk is ontworpen door Melchior van Herbach. De topgevel boven de ingang is versierd met klauwstukken, obelisken en een gebroken fronton waarin een Justitiabeeld staat. In de boogtrommels van de vensters van de bel-etage zijn natuurstenen cartouches aangebracht. Een cartouche boven de natuurstenen ingangsboog toont het stadswapen. Bij een restauratie in 1950-'53 heeft men het bordes in oude vorm gereconstrueerd. Het exterieur bleef ver-der door de eeuwen heen grotendeels in originele staat; inwendig is de oorspronkelijke indeling echter verdwenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00992> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen) – Woonhuizen"@nl ;
        min:adres "Molenberglaan 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Moerdijk" ;
        min:gemeenteInBoek "Zevenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Moerdijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Klundert (gemeente Zevenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Klundert" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 992 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text """Woonhuizen. Veel 18de- en 19de-eeuwse woonhuizen gingen in de Tweede Wereldoorlog verloren. Het eenlaagspand Stadshuisring 4 heeft nog een 18de-eeuwse kern en ook Voorstraat 2-6, een eenlaagspand met 19de-eeuwse gevel heeft mogelijk nog een oudere kern. Het huis Stadhuisring 16 is voorzien van een schilddak; op de gepleisterde empire-gevel, met een kroonlijst op voluutvormige consoles, prijken guirlandes met het jaartal 1804. Het voorm. doktershuis Kerkring 21-22, heeft een brede neoclassicistische gevel met ingezwenkte dakrand en kroonlijst uit omstreeks 1870.

De Verlaatsheul, gelegen op de plaats waar de Bottekreek aan de noordzijde de omwalling doorsnijdt, is een overwelfde sluis uit 1769. Deze sluis heeft ongetwijfeld een voorgangster gehad. De tijdens een restauratie in 1978-'79 vernieuwde sluisdeuren zijn gemaakt naar voorbeeld van een oorspronkelijk exemplaar.

Het Kreekgebouw (Molenberglaan 2) is omstreeks 1953 over de Bottekreek gebouwd als een combinatie van gymzaal en badhuis. Het is opgetrokken in baksteen met betonskelet en heeft sgrafittoversiering van J. Sjollema."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00993> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Klundert (gemeente Zevenbergen) – Verdedigingswerken"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Moerdijk" ;
        min:gemeenteInBoek "Zevenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Moerdijk> ;
