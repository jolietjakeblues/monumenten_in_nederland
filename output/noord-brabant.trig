        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 225 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0018> ;
        schema:name "Bergeijk"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "De Herv. kerk (Hof 56) is een eenvoudig bakstenen zaalkerkje met dakruiter en driezijdig gesloten kopse gevels. De kerk is gebouwd in 1812 naar plannen van Pieter Willems en herbouwd in 1857. De voorm. pastorie (Hof 54), nu hotel ‘Beukenhof’, stamt uit 1838 en werd in het begin van de 20ste eeuw uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00226> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergeijk"@nl ;
        min:adres "Burg. Magneestraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Bergeijk" ;
        min:gemeenteInBoek "Bergeijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bergeijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bergeijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Bergeijk" ;
