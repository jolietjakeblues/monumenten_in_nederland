        schema:name "De Heen (gemeente Steenbergen)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Voorstraatdorp, gesticht in 1614 in de polder ten zuiden van de Roosendaalse en Steenbergse Vliet. Het dorp kreeg pas in de 19de eeuw een kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0036.php> .

