        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Dorp langs de Zuid-Willemsvaart, bestaande uit twee op zandruggen ontstane kernen die na de Tweede Wereldoorlog tot één dorp zijn samengegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00210> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek en Donk (gemeente Laarbeek)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
