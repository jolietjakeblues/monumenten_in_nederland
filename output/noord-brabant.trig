        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eersel" ;
        min:gemeenteInBoek "Eersel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eersel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vessem (gemeente Eersel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vessem" ;
        min:lemma "Knegsel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65617>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65618> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "520272",
            "520273" ;
        min:soort "lemma" ;
        min:volgnummer 1546 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0181> ;
        schema:name "Knegsel"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Knegsel. Dit dorp ten zuidoosten van Vessem ontstond op de hogere gronden in het stroomgebied van de Kleine Beerze en is in 1688 verplaatst. De R.K. kerk H.H. Monulphus en Gondulphus (Steenselseweg 2) is een pseudo-basilicale kruiskerk in laatneogotische vormen met een massieve toren voorzien van ingesnoerde spits. De kerk verrees in 1926 naar plannen van H.W. Valk op de plaats van een kerk uit 1857. De pastorie (Steenselseweg 4) werd gebouwd in 1900-'01 naar een ontwerp met neorenaissance-elementen van J.P. van der Mark. Boven de ingang zit een tegeltableau voorstellende de Goede Herder. Ten zuidoosten van het huidige dorp stond nog tot 1790 een kerk op de plaats van het oude dorp. Op die plek resteert het R.K. kerkhof (Pastoor Eijkenweg ong.) met een H. Hartbeeld uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0181.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01547> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vessem (gemeente Eersel) – Wintelre"@nl ;
        min:adres "Willibrordusstraat 36",
            "Willibrordusstraat 37" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eersel" ;
        min:gemeenteInBoek "Eersel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eersel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vessem (gemeente Eersel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vessem" ;
        min:lemma "Wintelre" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65465>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65466> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "520275",
            "520276" ;
        min:soort "lemma" ;
        min:volgnummer 1547 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0181> ;
        schema:name "Wintelre"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Wintelre. Dit dorp ten noordoosten van Vessem was oorspronkelijk een tiendakkerdorp van het kapittel van Oirschot. De R.K. St.-Willibrorduskerk (Willibrordusstraat 37) is een kruiskerk uit 1930-'31, gebouwd naar plannen van J. Vermeulen. De neogotische toren dateert uit 1859 en verrees naar plannen van H.J. van Tulder bij de uit 1822 stammende voorgangster van de huidige kerk. In de toren, bestaande uit drie geledingen en een ingesnoerde spits, zijn motieven van de Kempische gotiek verwerkt. Bij de kerk staat een bronzen H. Hartbeeld - gecombineerd met stenen leeuwen - van J. Dechlin uit 1925. De pastorie (Willibrordusstraat 36) werd in het begin van de 19de eeuw gebouwd en in 1858 vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0181.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01548> a min:Passage,
