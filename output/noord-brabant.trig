        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sprundel (gemeente Rucphen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sprundel" ;
        min:lemma "Sint Willibrord" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72542>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72543>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72544> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517059",
            "517060",
            "525726" ;
        min:soort "lemma" ;
        min:volgnummer 1413 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0164> ;
        schema:name "Sint Willibrord"@nl ;
        schema:pageEnd "299" ;
        schema:pageStart "299" ;
        schema:pagination "299" ;
        schema:text "Sint Willibrord. In dit dorp ten noorden van Sprundel staat de R.K.O.L. Vrouwekerk (Pastoor Bastiaansensingel 30), een uit 1925 daterende centraalbouw met hoektorentjes en een hoge toren met hoeksteunberen. Pastoor Bastiaansen maakte het ontwerp in vrije navolging van de Notre Dame du Rosaire te Lourdes. J. van Groenendael werkte het ontwerp uit. Tot de inventaris behoort een doopvont uit 1770. Om de kerk ligt een 19de-eeuws, maar in 1925 grotendeels heringericht, processiepark met brede lanen. Voor de kerk staat een Mariabeeld uit 1925 en aan de zuidzijde bevinden zich een Lourdesgrot en een buitenpreekstoel uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01414> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenbergen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
