        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Huize Veebeek (Veedijk 41), gelegen ten noorden van het dorp, verrees in 1842 in neoclassicistische vormen op de plaats van kasteel Veebeek, dat hier van 1638 tot 1840 stond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00322> a min:Passage,
