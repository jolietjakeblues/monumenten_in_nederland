        schema:name "Helmond"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De R.K. St.-Luciakerk (Hoofdstraat 159, Mierlo-Hout) is een driebeukige neogotische kruisbasiliek met toren, gebouwd in 1896 naar ontwerp van C. Franssen. De kerk bevat een hoofdaltaar (1896) gemaakt door de firma Lenaerts en een kruisweg (1906) door E. Perey."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0082.php> .

