        min:volgnummer 547 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0045> ;
        schema:name "Drimmelen (gemeente Made)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De voorm. dorpsschool (Dorpsstraat 14) is een dwars tegen de dijk geplaatst, rechthoekig gebouw met accoladeboogvormige vensters uit 1846. De voorgevel aan de korte zijde heeft een top met natuurstenen voluten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0045.php> .

