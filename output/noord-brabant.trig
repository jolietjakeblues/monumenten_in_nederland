        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De Geref. kerk (Burg. van den Elzenlaan 22) is een zaalgebouw met zware westtoren uit 1950, door B.W. Plooij ontworpen in de traditionele vormen van de Delftse School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01225> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oss"@nl ;
        min:adres "Lijsterlaan 6" ;
