        min:volgnummer 322 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0022> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Boerderijen. In de omgeving van Berlicum liggen enkele oude boerderijen. De kortgevelboerderij Eikenlust (Loofaert 1) heeft tegen de voorgevel een zeskante toren met gekoppelde spitsboognissen uit 1551. Het voorste gedeelte van de boerderij diende als ‘speelhuis’ voor de pachtheer, de eigenaar van het landgoed De Wamberg. Loofaert 25 is een uit 1602 stammende hoekgevelboerderij, Loofaert 47 is een langgevelboerderij met een kern uit 1698."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00323> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berlicum (gemeente Sint-Michielsgestel) – Middelrode"@nl ;
        min:adres "Assendelftseweg 10",
            "Laan van Seldensate 4" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berlicum (gemeente Sint-Michielsgestel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Berlicum" ;
        min:lemma "Middelrode" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34602> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "9434" ;
        min:soort "lemma" ;
        min:volgnummer 323 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill111> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0022> ;
        schema:name "Middelrode"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Middelrode. Dit dorp ten zuidoosten van Berlicum ontstond omstreeks 1400. Van het langs de Aa gelegen, omgrachte landgoed Seldensate (Laan van Seldensate 4) resteert een poortgebouw uit omstreeks 1490. Het bakstenen pand heeft speklagen van mergel en een natuurstenen poortomlijsting. Bij een vernieuwing in 1590 kreeg het een van onder ronde en van boven veelhoekige duiventoren. Het poortgebouw werd verder nog in 1908 hersteld en in 1976-'80 gerestaureerd. Bij die restauratie werden de fundamenten van het in 1893 tot landhuis verbouwde en in 1961 gesloopte kasteel tot even boven het maaiveld opgemetseld. Het geheel ligt in een landschappelijk park met opgestuwde beek. Van het verdwenen landgoed Assendelft (Assendelftseweg 10) resteert alleen een inrijgebouw uit omstreeks 1500, dat in 1969 nagenoeg geheel nieuw werd opgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00324> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Berlicum (gemeente Sint-Michielsgestel) – Kaathoven"@nl ;
        min:adres "Kaathoven 31" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Berlicum (gemeente Sint-Michielsgestel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Berlicum" ;
        min:lemma "Kaathoven" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 324 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0022> ;
        schema:name "Kaathoven"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Kaathoven. Dit gehucht ten noordoosten van Berlicum ontstond in de late middeleeuwen. De voorm. St.-Cunerakapel (Kaathoven 31) werd in 1535 gesticht en in 1629 verwoest, maar vanwege de nog erg populaire Cuneradevotie in 1631 herbouwd. Van 1675 tot 1888 diende het gebouw als school. Het koor kreeg omstreeks 1800 een rechte sluiting. Vanaf 1888 hoorde het gebouw bij een boerderij en sinds een ingrijpende restauratie in 1979-'80 is het een woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0022.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00325> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Best"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Best" ;
