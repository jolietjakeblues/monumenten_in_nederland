        schema:text "Zaadhandel Mommersteeg (Wolput 72-72a), een traditionalistisch vormgegeven gebouwencomplex met karakteristieke lessenaarsdaken, verrees rond 1935 naar plannen van J. Luyben."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01568> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlijmen (gemeente Heusden) – Haarsteeg"@nl ;
        min:adres "Haarsteegsestraat 10",
            "Haarsteegsestraat 11",
            "Haarsteegsestraat 12" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlijmen (gemeente Heusden)" ;
