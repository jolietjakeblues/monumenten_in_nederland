            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34545>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34778> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "11261",
            "11262",
            "11267" ;
        min:soort "lemma" ;
        min:volgnummer 461 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Windmolens. De Nooitgedagt (Meemortel 22-24) verrees in 1846 als ronde bakstenen beltkorenmolen. In 1976 heeft men de molenbelt afgegraven en een stelling aangebracht. De ronde bakstenen beltkorenmolen Zeldenrust (Burg. Van Houtstraat 60) dateert oorspronkelijk uit 1869, maar werd herbouwd na een brand in 1900. De molenberg is later afgegraven ten behoeve van een pakhuis. Op de baard staat het (onjuiste) jaartal 1858. Ten noorden van Budel-Schoot staat de Janzona (Grootschoterweg 17), een achtkante beltkorenmolen uit 1937, waarvan de houten bovenbouw afkomstig is uit Venlo. Van het op de plaats van de belt gelegen pakhuis doet het dak dienst als stelling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00462> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel – Grenspaal"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Cranendonck" ;
        min:gemeenteInBoek "Budel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cranendonck> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel" ;
        min:lemma "Grenspaal" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 462 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Grenspaal"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Grenspaal. Waar de weg van Budel naar Budel-Dorplein het spoor passeert, staat een hardstenen paal met in reliëf het wapen van de Admiraliteit op de Maze te Rotterdam uit 1662. Dergelijke palen werden langs de grenzen van Staats-Brabant met Limburg en België geplaatst. Daar werden de in- en uitvoerbelastingen geïnd door de Admiraliteit op de Maze, die dit recht had gepacht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00463> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel Dorplein (gemeente Budel)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
