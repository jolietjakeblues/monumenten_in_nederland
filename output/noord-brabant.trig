        schema:name "Moerdijk (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "256" ;
        schema:pagination "256" ;
        schema:text "Dorp ontstaan in de 18de eeuw bij het veer over de Maas. Na de Tweede Wereldoorlog werd ten westen van het dorp en de Roode Vaart langs het Hollands Diep een omvangrijk industriegebied aangelegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0118.php> .

