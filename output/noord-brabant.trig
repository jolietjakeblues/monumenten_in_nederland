        min:adres "Rietvelderweg bij nr. 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hedikhuizen (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hedikhuizen" ;
        min:lemma "Fort Hedikhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 785 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill262> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0077> ;
        schema:name "Fort Hedikhuizen"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "Fort Hedikhuizen (Rietvelderweg bij nr. 2), gelegen ten zuiden van het dorp, staat officieel bekend als het ‘Werk achter de Hoge Maasdijk’ en maakte deel uit van de stelling van Heusden. Bij een in 1794 in de Maasdijk gemaakte coupure ontstond in 1860-'63 een klein omgracht aarden fort dat de ook nog bestaande inundatiesluis uit 1862-'63 beschermde. Binnen het fort verrees een versterkt legeringsgebouw met kruitmagazijn, te bereiken via een poterne aan de keelzijde. Na 1886 verviel de verdedigingsfunctie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00786> a min:Passage,
