            schema:CreativeWork ;
        rdfs:label "Chaam (gemeente Chaam/Alphen) – R.K. kerk van St.-Antonius Abt"@nl ;
        min:adres "Dorpsstraat 46",
            "Raadhuisplein 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Alphen-Chaam" ;
        min:gemeenteInBoek "Chaam/Alphen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Alphen-Chaam> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
