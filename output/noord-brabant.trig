        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "330" ;
        schema:pagination "330-331" ;
        schema:text "Bedrijfsgebouwen. De voorm. scheepswerf annex woonhuis (Scharlo 4) dateert uit omstreeks 1910, evenals de voorm. hooiperserij (Vaartje 29) met slagloodsen, weegbrug met meethuis en bijbehorend woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01624> a min:Passage,
            schema:CreativeWork ;
