        min:soort "inleiding" ;
        min:volgnummer 1335 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill445> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0152> ;
        schema:name "Sambeek (gemeente Boxmeer)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Het voorm. kloostergebouw (Grotestraat 69-71) van de zusters monialen redemptoristinnen werd gesticht in 1874. De haaks op de Grotestraat staande kloostervleugel in sobere neorenaissance stamt uit 1873-'74. Aan de noordzijde volgde in 1882 een neogotische vleugel met kapel naar plannen van J. Kayser, die waarschijnlijk ook tekende voor de sobere neogotische L-vormige vleugel aan de zuidzijde uit 1888. In de omheinde kloostertuin staat een grafkapel uit 1894. Het orgel in de kapel werd in 1889 gebouwd door Swinkels uit Boxmeer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0152.php> .

