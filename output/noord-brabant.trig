        schema:pageStart "312" ;
        schema:pagination "312-313" ;
        schema:text "Het voorm. St.-Petrusklooster (Slimstraat 21-23) is een eenvoudig tweelaags kloostergebouw uit circa 1905 in een vormgeving met neogotische en neorenaissancistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0173.php> .

