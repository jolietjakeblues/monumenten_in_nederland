        schema:pageEnd "236" ;
        schema:pageStart "235" ;
        schema:pagination "235-236" ;
        schema:text "Het raadhuis (Vrijthof 10) is een in traditionele trant gebouwd complex uit omstreeks 1950, gesitueerd rond een binnenplaats met galerij. Het ontwerp is van J. Bedaux."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0087.php> .

