        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Best" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Best" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 325 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0023> ;
        schema:name "Best"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Dorp ontstaan uit een aantal middeleeuwse nederzettingen, waarvan er enkele nog als buurtschap te herkennen zijn, zoals Aarle en Vleut. Door de aanleg van de steenweg Den Bosch-Eindhoven rond 1750 en de spoorlijn Eindhoven-Boxtel in 1866-'67 ontstond tussen deze beide buurtschappen een verdichting van de bebouwing. De aanleg van het Wilhelminakanaal (1910-'23) bracht extra bedrijvigheid in de vorm van de Batafabriek. Na de Tweede Wereldoorlog is Best sterk uitgebreid richting Wilhelminakanaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00326> a min:Passage,
