        schema:name "Diessen (gemeente Hilvarenbeek)"@nl ;
        schema:pageEnd "134" ;
        schema:pageStart "134" ;
        schema:pagination "134" ;
        schema:text "Akkerdorp ontstaan in de vroege middeleeuwen op de hoger gelegen zandgronden in het stroomgebied van de Reusel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00526> a min:Passage,
            schema:CreativeWork ;
