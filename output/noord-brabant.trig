        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Het voorm. raadhuis (Markt 1) is een groot pand met sterk vooruitspringende middenpartij, gebouwd in 1874-'77 naar plannen van J.M. Nabbe. Het diende oorspronkelijk als raadhuis, postkantoor, kantongerecht en boterhal. Zware beschadigingen in de Tweede Wereldoorlog leidden tot herbouw en herstel naar ontwerp van F. Schütz en met beeldhouwwerk van J. Uiterwaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01521> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel – Woonhuizen"@nl ;
        min:adres "Burg. De Kuyperlaan 2",
            "Hoogstraat 8" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1521 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Woonhuizen. Veghel bezit nog een aantal rijkere herenhuizen uit de 19de eeuw, in voornamelijk eclectische vormgeving. De twee herenhuizen Hoofdstraat 39-41 stammen uit omstreeks 1840. Villa Louise (Burg. De Kuyperlaan 2) dateert uit omstreeks 1860 en heeft een erker uit omstreeks 1880. Uit 1870 stamt het herenhuis Klondike (Hoogstraat 8) met neobarokke attieklijst. Rijk eclectisch van vormgeving is Hoofdstraat 1 uit omstreeks 1875. De drie fabrikantenwoningen Zuidkade 5, 18 en 24 dateren uit omstreeks 1875. De vier grote eclectische herenhuizen Molenstraat 45-79 verrezen in 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01522> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel – Industriegebouwen"@nl ;
        min:adres "Lelielaan 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:lemma "Industriegebouwen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1522 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Industriegebouwen"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Industriegebouwen. Het uit 1911 daterende pand van Stoomwasscherij De Lelie (Lelielaan 2) heeft een voorvleugel en een achterliggende hal met sheddaken. Het N.C.B.-complex (N.C.B.-Laan) werd in 1915 gevestigd aan de Oude Haven. De oudste kern van het complex bestaat uit een veekoekenfabriek met maalderij en een graansilo in betonskeletbouw, beide naar ontwerp van L.J.P. Kooken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01523> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel – Zijtaart"@nl ;
        min:adres "Pastoor Clerckstraat 52",
            "Pastoor Clerckstraat 69",
