        schema:name "Duizel (gemeente Eersel)"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text "De R.K. Mariakapel (Groenstraat 37a) is een zevenhoekige bouwwerk uit 1950, naar ontwerp van P. Tooten van Ginderen. Het is kwalitatief een van de betere uit een periode dat veel van dergelijke kapellen verrezen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0047.php> .

