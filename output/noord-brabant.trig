        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Mill_en_Sint_Hubert> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mill" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Mill" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1096 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill377> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0117> ;
        schema:name "Mill"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "254" ;
        schema:pagination "254-255" ;
        schema:text "Dorp ontstaan op een zandrug van de Raam. Het dorp wordt voor het eerst genoemd in 1166. Na de sloop van de middeleeuwse kerk in 1824 verrees de nieuwe kerk meer aan de oostzijde van de dorpskom. In 1872 kreeg Mill een station aan de spoorlijn Boxmeer-Wesel. Bij de gevechten op 10 mei 1940 werd een belangrijk deel van het dorp verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01097> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mill"@nl ;
        min:adres "Kerkstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Mill en Sint Hubert" ;
        min:gemeenteInBoek "Mill" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Mill_en_Sint_Hubert> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mill" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Mill" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1097 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0117> ;
        schema:name "Mill"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "255" ;
        schema:pagination "255" ;
        schema:text "De R.K. St.-Willibrorduskerk (Kerkstraat 2) is een driebeukige neogotische basiliek met driezijdig gesloten koor. De kerk werd gebouwd in 1877-'78 naar ontwerp van C. van Dijk. De rijzige westtoren heeft vier geledingen en overhoekse steunberen; het muurwerk is voorzien van een rijke nissenversiering met verwijzingen naar de Kempische gotiek. De lage dwarsarmen in traditionele vormen werden in 1939 toegevoegd naar plannen van M. van Beek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01098> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mill"@nl ;
        min:adres "Kasteelsestraat 2-4" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Mill en Sint Hubert" ;
        min:gemeenteInBoek "Mill" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Mill_en_Sint_Hubert> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mill" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Mill" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1098 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0117> ;
        schema:name "Mill"@nl ;
        schema:pageEnd "255" ;
        schema:pageStart "255" ;
        schema:pagination "255" ;
        schema:text "Het voorm. kasteel Aldendriel (Kasteelsestraat 2-4) wordt voor het eerst vermeld in 1474. Het door grachten omringde gebouwencomplex bestaat uit een voorhof en een nogmaals omgracht hoofdgedeelte. Dat laatste heeft vier vleugels rondom een binnenplaats. De tweelaags westvleugel wordt aan noorden oostzijde geflankeerd door lagere vleugels en de noordvleugel bestaat uit een poortgebouw tussen trapgevels. De kern van het hoofdgebouw was een 16de-eeuws huis met vakwerkwanden gevuld met baksteen. Het huidige aanzien van het complex is grotendeels het resultaat van een ingrijpende verbouwing in 1763. De aaneengesloten bebouwing van de aan drie zijden bebouwde voorhof bevat twee poortdoorgangen, die evenals de staldeuren worden geflankeerd door geblokte bakstenen pilasters met een natuurstenen bekroning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01099> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mill – Woonhuizen"@nl ;
        min:adres "Stationstraat 34" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Mill en Sint Hubert" ;
