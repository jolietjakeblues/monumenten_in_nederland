        min:rijksmonumentnummer "10192" ;
        min:soort "inleiding" ;
        min:volgnummer 434 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0030> ;
        schema:name "Breda"@nl ;
        schema:pageEnd "114" ;
        schema:pageStart "114" ;
        schema:pagination "114" ;
        schema:text "De Hoofdwacht (Halstraat 1) [16] is een rechthoekig gebouw uit omstreeks 1766 met in het midden van de gevel aan de Markt een inpandige galerij met drie bogen. Het gebouw kwam tot stand door een vrijwel totale vernieuwing van de hier gelegen St.-Janskapel, die tevoren als Hoofdwacht diende."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0030.php> .

