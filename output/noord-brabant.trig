        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Baarle-Nassau/Baarle-Hertog" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Baarle-Nassau/Baarle-Hertog" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 190 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill70> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0012> ;
        schema:name "Baarle-Nassau/Baarle-Hertog"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "63" ;
        schema:pagination "63-64" ;
        schema:text "Dorp gevormd door het Nederlandse Baarle-Nassau met daarin een aantal Belgische enclaves, aangeduid als Baarle-Hertog. De grenzen tussen beide gedeelten verlopen zeer grillig, soms dwars door de huizen heen. De tweedeling komt voort uit het feit dat de hertog van Brabant omstreeks 1200 gedeelten van dit gebied in leen gaf aan de heren van Breda (vanaf 1403 graven van Nassau). Bij de vrede van Munster (1648) kwamen de delen van de Baronie van Breda (Nassau) bij de Generaliteitslanden. Het overige gebied, dat tot de Baronie van Turnhout (Hertog) behoorde, werd bij de Zuidelijke Nederlanden gevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00191> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Baarle-Nassau/Baarle-Hertog"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
