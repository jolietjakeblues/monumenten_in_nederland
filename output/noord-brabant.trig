        schema:name "Helmond"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De R.K. St.-Jozefkerk (Tolpost 1), een laat-neogotische kruiskerk met westtoren voorzien van octagonale spits, verrees in 1922-'31 naar ontwerp van W. te Riele. De pastorie (Bakelsedijk 1) en het R.K. klooster St.-Jozefgaarde (Prins Karelstraat 100), beide uit 1923, zijn ook van zijn hand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0082.php> .

