        min:soort "inleiding" ;
        min:volgnummer 1010 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0100> ;
        schema:name "Leenderstrijp (gemeente Heeze-Leende)"@nl ;
        schema:pageEnd "243" ;
        schema:pageStart "243" ;
        schema:pagination "243" ;
        schema:text "De R.K. St.-Janskapel (Strijperpad ong.) is een eenvoudig gebouw met zadeldak tussen tuitgevels. De kapel verving in 1843 een gotische voorganger. Van de tijdens restauratiewerkzaamheden in 1973 gevonden 16de-eeuwse houten schotel met hoofd van Johannes de Doper is een betonnen kopie in de kapel geplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01011> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leenderstrijp (gemeente Heeze-Leende) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heeze-Leende" ;
        min:gemeenteInBoek "Heeze-Leende" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heeze-Leende> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Leenderstrijp (gemeente Heeze-Leende)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Leenderstrijp" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1011 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill355> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0100> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "243" ;
        schema:pagination "243-244" ;
        schema:text "Boerderijen. In het gehucht staan voornamelijk in de 18de of 19de eeuw gebouwde of verbouwde langgevelboerderijen; ze dienen nu doorgaans enkel als woonhuis. Een van de oudste resten is de schuur van vakwerk met baksteenvulling op het erf van Riesten 2, een boerderij die zelf blijkens de ankers uit 1818 dateert. Strijperstraat 58 dateert uit 1671 en is verbouwd in 1926. Enkele 18de-eeuwse boerderijen hebben hartvormige gevelversieringen in gesinterde baksteen, zoals Strijperstraat 42, 44 (1730) en 59. Andere belangrijke boerderijen zijn: Zaalstraat 1 en 6, Strijperstraat 26 (1735 of '38), 23 (1821), 40 (1857) en 41 (1867)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0100.php> .

