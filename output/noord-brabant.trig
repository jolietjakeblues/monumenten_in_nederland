        min:hoofdstuk "Steden, dorpen, monumenten › Werkendam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Werkendam" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1626 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0191> ;
        schema:name "Werkendam"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "Dijkdorp, waarschijnlijk ontstaan in de 18de eeuw langs de Nieuwe Merwede. Het oorspronkelijke bebouwingslint lag langs de Hoogstraat en de Kruisstraat. In de 19de eeuw ontstond lintbebouwing langs een nieuwe rivierdijk (Sasdijk). Na de Tweede Wereldoorlog groeide het dorp verder uit."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0191.php> .

