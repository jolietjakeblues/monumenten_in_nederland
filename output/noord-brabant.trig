        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Dorp ontstaan in de middeleeuwen op de grens van zand en klei. Schaijk behoorde tot het Land van Ravenstein. De dorpskern is nog vrij goed behouden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01341> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schaijk (gemeente Landerd)"@nl ;
        min:adres "Pastoor Van Winkelstraat 1",
            "Pastoor Van Winkelstraat 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Landerd" ;
        min:gemeenteInBoek "Landerd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landerd> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Schaijk (gemeente Landerd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Schaijk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1341 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0153> ;
        schema:name "Schaijk (gemeente Landerd)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "De R.K. kerk St.-Antonius Abt (Pastoor Van Winkelstraat 3) is een driebeukige neogotische kruisbasiliek, die in de plaats is gekomen van een laatmiddeleeuwse kerk. In 1894-'95 verving men naar plannen van P. Stornebrink het oude koor door een nieuw transept en koor. Naar plannen van W.Th. van Aalst volgde in 1901-'02 de vervanging van het schip en de ommetseling van de 15de-eeuwse toren, die tevens werd verhoogd met een vijfde geleding. De kerk bezit een door M. van Deventer gebouwd orgel uit 1754-'55, dat in 1854 door F.C. Smits werd uitgebreid en voorzien van een nieuwe orgelkast. Op het kerkhof staan onder meer een 16de-eeuws grafkruis en een laat-19de-eeuws kindergraf met beeld van een treurend meisje. De kerkhofmuur uit omstreeks 1920 is voorzien van art deco-details. De neoclassicistische pastorie (Pastoor Van Winkelstraat 1) stamt uit 1865."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01342> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schaijk (gemeente Landerd)"@nl ;
        min:adres "Pastoor Van Winkelstraat 5" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Landerd" ;
        min:gemeenteInBoek "Landerd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landerd> ;
