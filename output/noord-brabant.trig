        min:hoofdstuk "Steden, dorpen, monumenten › Waalwijk" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waalwijk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1601 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0188> ;
        schema:name "Waalwijk"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Het interieur is voorzien van zuilen met achtkante basementen en lijstkapitelen. Schip en transept hebben houten tongewelven met trekbalken; in het koor werden tijdens de restauratie nieuwe gewelven geslagen op de oude aanzetten. De kerk bevat een grafzerk uit 1654 boven de grafkelder in het koor van de familie Nuyssenborgh, een preekstoel uit 1658 met koperen lessenaar en een door C. van Oeckelen & zoon gebouwd orgel uit 1823."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0188.php> .

