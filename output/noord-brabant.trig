        min:volgnummer 163 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0008> ;
        schema:name "Almkerk (gemeente Woudrichem)"@nl ;
        schema:pageEnd "60" ;
        schema:pageStart "60" ;
        schema:pagination "60" ;
        schema:text "Donkdorp gelegen op oeverwallen van de Alm en in zijn huidige vorm ontstaan na de St.-Elisabethsvloed van 1421. De langgerekte donk werd aan de oostzijde werd beheerst door het verdwenen kasteel Altena. De Herv. kerk maakte na verwoesting in 1945 plaats voor een moderne kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0008.php> .

