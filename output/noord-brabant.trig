        min:hoofdstuk "Steden, dorpen, monumenten › Wouw (gemeente Roosendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Wouw" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1672 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0197> ;
        schema:name "Wouw (gemeente Roosendaal)"@nl ;
        schema:pageEnd "339" ;
        schema:pageStart "339" ;
        schema:pagination "339" ;
        schema:text "Tiendakkerdorp dat omstreeks 1100 is ontstaan, in de nabijheid van het kasteel Wouw, dat ongetwijfeld tot de ontwikkeling van het dorp heeft bijgedragen. Dit kasteel was aanvankelijk de hoofdresidentie van de heren van Bergen op Zoom, voordat zij de Markiezenhof in die stad bouwden. Na de verovering van het kasteel door prins Maurits in 1606 raakte het in verval; de laatste restanten ervan zijn in het begin van de 20ste eeuw gesloopt. Het centrum van Wouw is het rechthoekige marktplein, dat aan de zuidzijde wordt afgesloten door het voormalige raadhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01673> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wouw (gemeente Roosendaal)"@nl ;
        min:adres "Torenstraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Roosendaal" ;
        min:gemeenteInBoek "Roosendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roosendaal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wouw (gemeente Roosendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Wouw" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1673 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0197> ;
        schema:name "Wouw (gemeente Roosendaal)"@nl ;
        schema:pageEnd "339" ;
        schema:pageStart "339" ;
        schema:pagination "339" ;
        schema:text "De R.K. St.-Lambertuskerk (Torenstraat 1) is een driebeukige kruisbasiliek met een koor en transept uit het begin van de 16de eeuw. Het schip en de toren herrezen in 1945-'51 nadat de kerk in 1944 zware schade opliep bij het opblazen van de toren door Duitse troepen. Ook alle kappen en stenen gewelven zijn vernieuwd. Het koor en het transept hebben een bekleding met Gobertangeen Ledesteen; de topgevel van de zuiderdwarsarm en de steunbeerbekroning zijn tijdens de restauratie aangebracht. Het nieuwe schip verrees in gotische stijl naar ontwerp van A. Siebers. Het beeldhouwwerk van kraagstenen en kapitelen is van de hand van P. Grégoire. De toren werd in enigszins eenvoudiger vorm herbouwd dan de oorspronkelijke toren, die uit omstreeks 1480 dateerde, maar kreeg wel hetzelfde silhouet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01674> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wouw (gemeente Roosendaal)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Roosendaal" ;
        min:gemeenteInBoek "Roosendaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Roosendaal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wouw (gemeente Roosendaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Wouw" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1674 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0197> ;
        schema:name "Wouw (gemeente Roosendaal)"@nl ;
        schema:pageEnd "339" ;
        schema:pageStart "339" ;
        schema:pagination "339" ;
        schema:text "De oorspronkelijke inventaris ging in 1944 nagenoeg geheel verloren. Wat resteert zijn een St.-Sebastiaansbeeld (eerste kwart 16de eeuw) en een aantal beelden van de 17de-eeuwse koorbanken; negentien beelden staan thans op consoles in het koor - ze stellen heilige of zalig verklaarde cisterciënzers voor; twaalf vrouwenfiguren, die deugden verbeelden, staan verspreid door de kerk. In de westgevel van de kerk is een gebrandschilderd raam aangebracht dat J. Nicolas in 1937 vervaardigde voor de Wereldtentoonstelling in Parijs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0197.php> .

