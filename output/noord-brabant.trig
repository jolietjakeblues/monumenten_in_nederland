        min:kern "Rucphen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69856>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69857> ;
