        min:rijksmonumentnummer "25888",
            "25889" ;
        min:soort "lemma" ;
        min:volgnummer 1023 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0103> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Windmolens. Ten noordwesten van het dorp staat de ronde bakstenen beltkorenmolen Vogelensang (Molendreef 6) uit 1819, gerestaureerd in 1976. In het zuiden staat De Leest (Molenstraat 40), een ronde bakstenen beltmolen uit 1862, herbouwd in 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01024> a min:Passage,
