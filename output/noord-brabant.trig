        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "Moerstraten. In dit kerkdorp, gelegen ten noordwesten van Wouw, staat de R.K. kerk H. Theresia van het kind Jesus (Moerstraatseweg 85), een eenbeukige kruiskerk met toren, gebouwd in 1926 naar ontwerp van J. van Groenendael."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0197.php> .

