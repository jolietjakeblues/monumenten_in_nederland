        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill345> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0091> ;
        schema:name "Hooge Zwaluwe (gemeente Made)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "De R.K. St.-Willibrorduskerk (Kerkdijk 1a) is een neogotische zaalkerk uit 1865 met een smaller, veelhoekig gesloten koor en een in 1919-'20 verhoogde toren. De kerk werd in 1880 gewijzigd. Het interieur heeft gestucte kruisgewelven. De 18de-eeuwse eiken preekstoel in rococo-stijl is afkomstig uit de R.K. kerk van Zevenbergschen Hoek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0091.php> .

