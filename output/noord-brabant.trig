        min:soort "inleiding" ;
        min:volgnummer 1041 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0107> ;
        schema:name "Loon op Zand"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "De rijk gedecoreerde neogotische pastorie (Oranjeplein 1) dateert uit 1898 en heeft een grotendeels gaaf neogotisch interieur. Het ommuurde kerkhof werd aangelegd in 1883 en heeft graven met boomstamkruisen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0107.php> .

