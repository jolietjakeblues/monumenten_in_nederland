            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73385> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "521543",
            "521544",
            "525963",
            "525965" ;
        min:soort "inleiding" ;
        min:volgnummer 950 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill342> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0089> ;
        schema:name "Hoeven (gemeente Halderberge)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het grootseminarie De Bovendonk (Hofstraat 8) kwam in 1903-'07 tot stand naar ontwerp van P.J.H. Cuypers als grootseminarie van het bisdom Breda, welke rol het deels nog vervult. Het omvangrijke, rond een rechthoekige binnenplaats opgetrokken complex is gebouwd in een combinatie van neogotiek en neorenaissance. De voorgevel heeft midden- en zijrisalieten met trapgevels voorzien van nissen met beelden. Halverwege de zijgevels staan veelhoekige torens. Langs de binnenplaats lopen galerijen met arcaden. In 1922-'23 verrees aan de westzijde van de binnenplaats een neogotische basilicale kapel met driezijdige sluiting en tweetorenfront, naar ontwerp van J.Th.J. Cuypers. Het complex ligt in een uitgestrekt park, dat wordt omgeven door een monumentaal hek in art deco-trant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00951> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoeven (gemeente Halderberge)"@nl ;
        min:adres "St.-Jansstraat 20" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoeven (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hoeven" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 951 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill343> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0089> ;
        schema:name "Hoeven (gemeente Halderberge)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De voorm. R.K. pastorie (St.-Jansstraat 20) is gebouwd in 1783 in opdracht van de abdij St.-Bernard bij Antwerpen. Het is een gepleisterd classicistisch pand met een doorrit naar het achterterrein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00952> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoeven (gemeente Halderberge) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoeven (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hoeven" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 952 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0089> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text """Woonhuizen. Het 17de-eeuwse diepe huis St.-Jansstraat 3, met topgevel in maniëristische trant, werd omstreeks 1930 ingrijpend gerestaureerd. St.-Jansstraat 11 is een laat-17de-eeuws huis. De zeer brede straatgevel, karakteristiek voor de huizen in Hoeven, is in het begin van de 19de eeuw gepleisterd. Bovenstraat 2 is een eenlaags hoekpand met trapgevel, dat door de bepleistering een 19de-eeuwse indruk maakt, maar een 17de-eeuwse kern kan bezitten. Uit de 18de eeuw dateert Bovenstraat 8, een karakteristiek breed dwarshuis met zadeldak. Het verrees gelijktijdig met het aangrenzende gepleisterde huis Bovenstraat 4-6, waarvan nummer 4 is verbouwd.

De dorpspomp (Bovenstraat ong.) is een hardstenen pomp uit 1855 met vier schamppalen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00953> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoeven (gemeente Halderberge) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoeven (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hoeven" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 953 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0089> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Boerderijen. De boerderij Goudsbloemsedijk 3, blijkens de jaartalankers daterend uit 1667, heeft een in gele baksteen opgetrokken, vrijstaand dwars voorhuis met zijtopgevels en een wit geschilderde voorgevel. Er is een langsdeelschuur met verschillende inritten. Goudsbloemsedijk 7 is een midden-19de-eeuwse boerderij met dezelfde opbouw. Gors 62 is een voorbeeld van het kop-romptype en dateert van omstreeks 1800."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

