        schema:name "Budel Dorplein (gemeente Budel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De voorm. gevangenis (Anton Stevenslaan, hoek Gebr. Looymarslaan) is een omstreeks 1900 daterend gebouwtje met opschrift ‘Prison’. Het bood plaats aan twee cellen en doet nu dienst als schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00468> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel Dorplein (gemeente Budel) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Cranendonck" ;
        min:gemeenteInBoek "Budel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cranendonck> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel Dorplein (gemeente Budel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel Dorplein" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 468 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill157> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0032> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "124" ;
        schema:pagination "124-125" ;
        schema:text "Woonhuizen. De huizen tonen nog goed de sociale stratificatie van dit fabrieksdorp en het Belgische karakter van de architectuur. De fabrikantenvilla Hoofdstraat 104 verrees in 1898 in Italiaanse neorenaissance-stijl voor Emile Dor, misschien wel naar zijn eigen ontwerp. De villa Hoofdstraat 78, ontstond in 1902 in chaletstijl voor neef Maurice Dor. Het grote landhuis Anton Stevenslaan 37 werd in 1926 gebouwd naar ontwerp van de Brusselse architect De Koning. Aan de Hoofdstraat verrezen in 1893-'95 de eerste arbeidershuizen voor de, voornamelijk Waalse, arbeiders. Aan Hoofdstraat 65-68 en Hoofdstraat 72-73 is goed de afnemende hoogte van deze dubbele woonhuizen te zien. Aan de Liedekerkestraat ontstonden in 1907 tien dubbele rug-aan-rug-woningen met een plattegrond van het type ‘Carré Mulhousien’, dat ook in het Agnetapark te Delft is toegepast. In 1918 werden Rector Van Nestestraat 179-198, tien twee-onder-één-kapwoningen met flauw hellende zadeldaken, verwezenlijkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00469> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Capelle (gemeente Waalwijk)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
