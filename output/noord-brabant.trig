        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "De R.K. St.-Petruskerk (Heuvel 2) is een driebeukige kruiskoepelkerk in neoromaanse vormen, gebouwd in 1881-'84 naar plannen van C. Weber. De door de romaanse bouwkunst van het Rijnland beïnvloedde kerk heeft een aan beide zijden klaverblad-vormig gesloten transept, een halfrond gesloten koor en een achtkante vieringskoepel. Inwendig hebben de absiden galerijen en is de in steen gedachte koepel uiteindelijk in hout uitgevoerd. De twee kapellen aan de westzijde werden in 1935 aangebouwd. De pastorie (Heuvel 4) stamt uit 1864."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01578> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vught"@nl ;
        min:adres "Helvoirtseweg 189" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Vught" ;
        min:gemeenteInBoek "Vught" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vught_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
