        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill346> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0092> ;
        schema:name "Hoogeloon (gemeente Bladel)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "238" ;
        schema:pagination "238-239" ;
        schema:text "De R.K. St.-Pancratiuskerk (Hoofdstraat 52) is een neogotische kruisbasiliek met hoog transept, vieringkoepel en vijfzijdig gesloten koor, gebouwd in 1924 naar ontwerp van J. van Groenendael. De achtkante vieringkoepel op pendentieven wordt gedekt door een helmvormig koepeldak. De kerk bevat een orgel met neogotische kast van de gebroeders Gradussen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0092.php> .

