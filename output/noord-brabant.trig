            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70919>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70920>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70921> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "30822",
            "517999",
            "518000",
            "518001",
            "519305",
            "519306",
            "519307" ;
        min:soort "inleiding" ;
        min:volgnummer 1145 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0125> ;
        schema:name "Nuenen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "De R.K. St.-Clemenskerk (Park 53) is een driebeukige kruisbasiliek met driezijdig gesloten koor en een hoge westtoren met achtkantige lantaarn en dito spits. De kerk verrees gebouwd in 1871 achter een (verdwenen) schuurkerk uit 1823. Het ontwerp van C. Weber vertoont een mengeling van neoromaanse en neogotische stijlelementen. De aangebouwde sacristie van rond 1920 is ontworpen door J. Stuyt. Tot de inventaris behoren een hoofdaltaar (1872), een Maria-altaar (1878), een H. Hartaltaar (1878) - alle drie naar ontwerp van Weber en uitgevoerd door J. Oor - zeven houten beelden door J. Custers (1903-'07), geschilderde kruiswegstaties van A. Windhausen (1907) en twee marmeren communiebanken door J. Custers (1927). In de toren hangt een klok uit 1490, gegoten door Jan van Venlo. De pastorie (Park 55) dateert van 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01146> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nuenen"@nl ;
        min:adres "Park 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
