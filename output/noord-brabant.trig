        min:hoofdstuk "Steden, dorpen, monumenten › Sint-Michielsgestel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint-Michielsgestel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53707> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "519935" ;
        min:soort "inleiding" ;
        min:volgnummer 1368 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill450>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill451> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0157> ;
        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "293" ;
        schema:pagination "293-294" ;
        schema:text "De R.K. St.-Michaëlskerk (Nieuwstraat 34) is een driebeukige basiliek met vieringtoren en imposante westtoren voorzien van vier puntgevels en een ruitdak. De kerk werd in 1930-'31 gebouwd naar plannen van H.W. Valk en verving de zuidelijk gelegen oude kerk uit 1839. Kenmerkend voor de zogeheten christocentrische kerken van Valk is de fraaie ruimtewerking. Die bereikte hij hier door de hoge lichtbeuk en de centrale plaatsing van het altaar onder de vieringstoren. Het orgel, in 1876 gebouwd door F.B. Loret uit Mechelen, is afkomstig uit het voorm. klein-seminarie Beekvliet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

