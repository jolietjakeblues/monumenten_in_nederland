        min:rijksmonumentnummer "35712" ;
        min:soort "inleiding" ;
        min:volgnummer 1450 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0171> ;
        schema:name "Tilburg"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De Herv. Pauluskerk (Heuvelstraat 141) [3] is een gepleisterde zaalkerk uit 1822-'23, gebouwd naar plannen van J. Backx. De korte zijden van de kerk zijn driezijdig gesloten. Het middenrisaliet en het ingangsportaal aan de lange zijde hebben een fronton. De klok in de dakruiter is in 1822 gegoten door Petit en Fritsen. J.H.H. Bätz bouwde in 1764-'65 het orgel; het heeft een weelderig en rijk geleed front in rococo-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0171.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01451> a min:Passage,
