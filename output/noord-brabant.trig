        schema:name "Walik"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Walik. Dit akkerdorp ten westen van Riethoven bestaat uit verspreide langgevelboerderijen, waarvan enkele in de buurt van een kleine brink liggen. Van deze boerderijen, ontstaan vanaf het midden van de 19de eeuw, zijn Walikerplein 1, 2 en 3 het meest karakteristiek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0145.php> .

