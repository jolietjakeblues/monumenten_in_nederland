        schema:name "Gassel (gemeente Grave)"@nl ;
        schema:pageEnd "159" ;
        schema:pageStart "159" ;
        schema:pagination "159" ;
        schema:text "Dorp waarschijnlijk in de vroege middeleeuwen ontstaan op een donk. De huidige bebouwingskern dateert uit de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00660> a min:Passage,
            schema:CreativeWork ;
