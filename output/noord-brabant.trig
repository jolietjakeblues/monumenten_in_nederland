        schema:name "Windmolen"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Windmolen ‘De Heimolen’ (Wanroijseweg ong.), gelegen ten zuiden van het dorp, is een ronde bakstenen beltkorenmolen uit 1878."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0156.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01365> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Michielsgestel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint-Michielsgestel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint-Michielsgestel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint-Michielsgestel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1365 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0157> ;
        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Dorp aan de Dommel, ontstaan in de vroege middeleeuwen op een zandrug, aan drie zijden omsloten door een meander van de rivier. Op het hoger gelegen kerkplein legde men een dorpsveste aan, die in 1579 werd verwoest. De nabijheid van 's-Hertogenbosch leidde ertoe dat langs de Dommel diverse kastelen of edelmanswoningen ontstonden, waarvan er inmiddels weer een aantal is verdwenen, waaronder het in 1750 afgebrande kasteel Oud Herlaer. De traditie van vestigingsplaats voor rijkere bewoners, maar ook geestelijke instellingen vanuit 's-Hertogenbosch is nog tot het begin van de 20ste eeuw doorgegaan. Na de Tweede Wereldoorlog breidde het dorp zich onder meer uit aan de overzijde van de Dommel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01366> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Michielsgestel"@nl ;
        min:adres "Petrus Dondersplein 18",
            "Petrus Dondersplein 23-24" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
