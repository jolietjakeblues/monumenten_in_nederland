        schema:name "Maren-Kessel (gemeente Lith)"@nl ;
        schema:pageEnd "250" ;
        schema:pageStart "250" ;
        schema:pagination "250" ;
        schema:text "Het voorm. raadhuis (Marensedijk 22a, Maren) van de opgeheven gemeente Alem, Maren en Kessel dateert uit 1901. Het L-vormige pand met dakruiter heeft een vormgeving met jugendstil-elementen; ernaast staat een rijk gesmeed hek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0111.php> .

