        schema:name "Alphen (gemeente Chaam/Alphen)"@nl ;
        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "De Herv. Kerk (Baarleseweg 1) is een eenbeukig, wit gepleisterd kerkje uit 1820, met rondboogvensters en klokkentorentje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0009.php> .

