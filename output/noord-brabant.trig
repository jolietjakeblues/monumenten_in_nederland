        schema:name "Bakel (gemeente Gemert-Bakel)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "De windmolen ‘St.-Willibrordus’ (Achter de Molen ong.) is een geslotenstanderdmolen uit 1752, die in 1893 vijftig meter naar het westen werd verplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00206> a min:Passage,
