        min:volgnummer 1499 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0176> ;
        schema:name "Valkenswaard"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Dorp ontstaan uit een aantal kleine, vroeg-middeleeuwse agrarische nederzettingen, waarvan de kern Valkenswaard in 1565 een zelfstandige parochie werd. Vanaf de late 16de eeuw stond het dorp bekend als centrum van de valkerij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01500> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenswaard"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Valkenswaard" ;
        min:gemeenteInBoek "Valkenswaard" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenswaard_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenswaard" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Valkenswaard" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1500 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0176> ;
        schema:name "Valkenswaard"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Dankzij de komst van de sigarenindustrie volgde na 1865 een tweede bloeiperiode. In 1934 werden gemeenten Borkel en Schaft en Dommelen geannexeerd. Met de laatstgenoemde plaats vormt Valkenswaard nu een door de Dommel doorsneden geheel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01501> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenswaard"@nl ;
        min:adres "Bergstraat 15",
            "Bergstraat 17" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Valkenswaard" ;
        min:gemeenteInBoek "Valkenswaard" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenswaard_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenswaard" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Valkenswaard" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1501 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0176> ;
        schema:name "Valkenswaard"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "De R.K. St.-Martinuskerk (Bergstraat 15, Dommelen) is een eenbeukige neogotische kruiskerk met een lager transept en koor en een gedeeltelijk ingebouwde toren. De kerk werd in 1882-'83 naar plannen van H.J. van Tulder gebouwd. In 1929-'30 vond een uitbreiding plaats naar plannen van J. Stuyt en P. Staals. De pastorie (Bergstraat 17) met achterliggende processietuin stamt uit de bouwtijd van de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01502> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenswaard"@nl ;
        min:adres "Markt 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Valkenswaard" ;
        min:gemeenteInBoek "Valkenswaard" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenswaard_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenswaard" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Valkenswaard" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1502 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill491> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0176> ;
        schema:name "Valkenswaard"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "314" ;
        schema:pagination "314-315" ;
        schema:text "De voorm. Herv. kerk (Markt 2, Valkenswaard), nu trouwzaal, is een eenbeukige kruiskerk uit 1890 met spitse hoge dakruiter, lager koor en uitgebouwde ingangspartij. J. Grambeek maakte een neogotisch ontwerp, wat bij protestantse kerkgebouwen uitzonderlijk is. De kerk staat op de fundamenten van een voorgangster uit 1809."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01503> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenswaard"@nl ;
        min:adres "Markt 53",
            "Markt 55" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Valkenswaard" ;
        min:gemeenteInBoek "Valkenswaard" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Valkenswaard_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valkenswaard" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Valkenswaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30587>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35208> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "518671",
            "518674" ;
        min:soort "inleiding" ;
        min:volgnummer 1503 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0176> ;
        schema:name "Valkenswaard"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "De R.K. St.-Nicolaaskerk (Markt 53, Valkenswaard) is een driebeukige, pseudobasilicale kruiskerk uit 1932, opgetrokken naar plannen van J. Stuyt in een decoratieve baksteenstijl met verwijzingen naar de gotiek. Van de vervangen kerk uit 1858-'60, naar ontwerp van C. Weber, heeft men de toren gedeeltelijk ommetseld in de nieuwbouw opgenomen. Het beeldhouwwerk in het interieur is van H. van der Geld en P. Verdonk en van elders afkomstig, uitgezonderd het Madonnabeeld (1936) van L. van Hoek. De pastorie (Markt 55) stamt uit 1882."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0176.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01504> a min:Passage,
