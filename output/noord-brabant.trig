        min:soort "lemma" ;
        min:volgnummer 795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0079> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "185" ;
        schema:pageStart "185" ;
        schema:pagination "185" ;
        schema:text "Scholen. Het voorm. St.-Jozefhuis (Hoofdstraat 78) verrees in 1884 naar plannen van P. Stornebrink en C. van Dijk, als school met twee klassen en een onderwijzerswoning. Het pand werd in 1928 verbouwd. De school was al in 1915 verplaatst naar de toen gereedgekomen school van drie klassen, met onderwijzerswoning (Hoofdstraat 100-102)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0079.php> .

