        min:volgnummer 1122 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0121> ;
        schema:name "Nederwetten (gemeente Nuenen c.a.)"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "De R.K. St.-Lambertuskerk (Hoekstraat 46) is een eenbeukige neogotische kruisbasiliek met neoromaanse elementen, in 1894-'95 gebouwd naar plannen van E. Corbey. De toren heeft vier geledingen en een achthoekige spits met vier wimbergen. De kerkinventaris, waaronder het hoogaltaar (1895-1900), werd vervaardigd door J.P. van der Mark. De neogotische gebrandschilderde ramen van Stalins en Janssens tonen onder meer het wonder van Hooidonk. De pastorie (Hoekstraat 44) dateert uit omstreeks 1895."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0121.php> .

