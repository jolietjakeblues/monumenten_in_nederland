        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "Windmolen ‘Laurentia’ (Schutboomsestraat ong.) is een achtkante beltkorenmolen met bakstenen onderbouw en een in 1890 uit Bleskensgraaf (Zuid-Holland) overgebrachte, met riet beklede bovenbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01096> a min:Passage,
