        schema:name "Nistelrode (gemeente Bernheze)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Langgerekt zanddorp, dat in 1291 een zelfstandige parochie werd. Het dorp heeft een aardige driehoekige brink of ‘plaatse’ met daaromheen boerderijen, een school, een raadhuis en woningen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0124.php> .

