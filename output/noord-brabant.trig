        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "518879" ;
        min:soort "inleiding" ;
        min:volgnummer 466 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0032> ;
        schema:name "Budel Dorplein (gemeente Budel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "Het voorm. Hotel St.-Joseph (Hoofdstraat 79-80) ook ‘De Cantine’ genoemd, is een overwegend in neorenaissance-vormen gebouwd carté-vormig gebouwencomplex uit 1896-'98, naar ontwerp van A. Neeskens. Het complex bood plaats aan een hotel, een jongens- en meisjesschool, een bakkerij, een winkel, een ontspanningszaal, een kleine kapel en een klooster met kapel en ziekenzaal, onder beheer van de Franse zusters van de H. Carolus Borromeus. Het geheel stond onder supervisie van de familie Dor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00467> a min:Passage,
            schema:CreativeWork ;
