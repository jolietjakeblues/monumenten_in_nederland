        schema:name "Kerkhof"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Kerkhof. Gehucht ten zuidwesten van Heeze. Het kerkhof van de verdwenen, oorspronkelijk 13de-eeuwse kerk, bevat een omheind graf van baron Tuyll van Serooskerken († 1843). In de nabijheid staan enkele 18de-eeuwse boerderijen, waaronder Kerkhof 13 (1714) en Kerkhof 12 (1765)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00804> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Helenaveen (gemeente Deurne)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Deurne" ;
        min:gemeenteInBoek "Deurne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deurne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Helenaveen (gemeente Deurne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Helenaveen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 804 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0081> ;
        schema:name "Helenaveen (gemeente Deurne)"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Peelontginningsdorp ontstaan vanaf 1853 toen Jan en Nicolaas van der Griendt toestemming kregen om 610 bunder veen te ontginnen en daartoe de Helenavaart aanlegden. De vervening startte in de zuidoosthoek, waar een nederzetting ontstond genoemd naar de vrouw van Jan van der Griendt. De turfwinning stopte in 1915 en daarna concentreerde men zich op de ontginning van landbouwgronden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00805> a min:Passage,
            schema:CreativeWork ;
