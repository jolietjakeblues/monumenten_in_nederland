        schema:name "Windmolen"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Windmolen ‘De Hellemolen’ (Rijksweg 76), gelegen ten zuiden van Reek, wordt nu ‘De Witte Molen’ genoemd. Het is een ronde stenen beltkorenmolen uit 1832."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0142.php> .

