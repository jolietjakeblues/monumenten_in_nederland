        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15615> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "33633" ;
        min:soort "inleiding" ;
        min:volgnummer 1366 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0157> ;
        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De kerktoren (Petrus Dondersplein 18) van de omstreeks 1839 gesloopte middeleeuwse St.-Michaëlskerk dateert uit het midden van de 15de eeuw. De toren van drie geledingen heeft tufstenen speklagen en overhoekse steunberen, die evenals de torenromp versierd zijn met spaarnissen voorzien van driepassen met tufstenen toten. De voorm. pastorie (Petrus Dondersplein 23-24) stamt uit omstreeks 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

