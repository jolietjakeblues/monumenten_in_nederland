        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "Windmolen ‘De Hoop’ (Maasdijk 381) is een ronde bakstenen stellingkorenmolen. De gesneden baard draagt de datering 1838."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0177.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01512> a min:Passage,
            schema:CreativeWork ;
