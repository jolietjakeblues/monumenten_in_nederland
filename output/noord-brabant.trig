        schema:name "Schijndel"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De voorm. Herv. kerk (Hoofdstraat 150) is een langwerpige achtkantige, neoclassicistische zaalkerk uit 1808. Het gebouw heeft grote spitsboogvensters tussen geblokte pilasters en aan de voorzijde een portiek met fronton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0154.php> .

