        schema:name "Helenaveen (gemeente Deurne)"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De R.K. kerk St.-Willibrordus (Oude Peelstraat 1), een eenvoudige zaalkerk in traditionele vormen uit 1950, werd gebouwd naar plannen van J. Deltrap op de plaats van een in 1944 verwoeste kerk uit 1857, een vroeg werk van P.J.H. Cuypers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00807> a min:Passage,
            schema:CreativeWork ;
