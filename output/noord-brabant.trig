    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00657> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Galder (gemeente Chaam/Alphen)"@nl ;
        min:adres "St.-Jacobsstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
