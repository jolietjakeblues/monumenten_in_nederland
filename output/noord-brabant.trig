        min:soort "inleiding" ;
        min:volgnummer 776 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0075> ;
        schema:name "Hapert (gemeente Bladel)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "Akkerdorp ontstaan op de Kempische zandgrond. Mede dankzij de ligging aan de route Eindhoven-Turnhout kon het dorp vanaf de tweede helft van de 19de eeuw tot enige omvang uitgroeien."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00777> a min:Passage,
