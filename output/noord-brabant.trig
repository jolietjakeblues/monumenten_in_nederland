        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0088> ;
        schema:name "Hintham (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De St.-Annakerk (Hintham 41) is een driebeukige neogotische kruisbasiliek; de toren van drie geledingen heeft een ingesnoerde spits met flankerende torentjes en is gebouwd in 1910 naar plannen van W.Th. van Aalst. Op het kerkhof staat een gietijzeren grafkruis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0088.php> .

