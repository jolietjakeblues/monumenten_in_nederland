        min:soort "inleiding" ;
        min:volgnummer 1210 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill409> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0133> ;
        schema:name "Oploo (gemeente Sint Anthonis)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "270" ;
        schema:pagination "270-271" ;
        schema:text "Dorp ontstaan als beekdalnederzetting in de 12de of 13de eeuw. Aan de noordzijde lagen twee, inmiddels verdwenen, kastelen. Vanaf het eind van de 14de eeuw vormde Oploo een heerlijkheid. In 1479 is er sprake van een banwatermolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01211> a min:Passage,
