        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Windmolen. Ten westen van Katwijk staat een achtkante bovenkruier met stelling (Lange Linden 32). De molen met vierkante onderbouw en riet gedekte achtkante bovenbouw stamt uit 1869."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0095.php> .

