        min:kern "Rijsbergen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1303 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0148> ;
        schema:name "Rijsbergen (gemeente Zundert)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "De R.K. kerk St. Bavo (St.-Bavostraat 12) is een driebeukige neogotische kruiskerk met vijfzijdig gesloten koor en een hoge westtoren met balustrade en spits, gebouwd in 1916-'18 naar ontwerp van N.J.H. van Groenendael. Het interieur bevat muurschilderingen van Dom. J. van der Mey O.S.B.; de gebrandschilderde ramen zijn van L. Asperslagh. Het in 1935 naar ontwerp van J.Th.J. Cuypers aangelegde kerkhof heeft aan het eind van de centrale as een calvarieberg met beeldengroep uit 1936. Rondom het kerkhof heeft men in 1939 kruiswegstaties geplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01304> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rijsbergen (gemeente Zundert)"@nl ;
        min:adres "St.-Bavostraat 7" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Zundert" ;
        min:gemeenteInBoek "Zundert" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zundert_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rijsbergen (gemeente Zundert)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Rijsbergen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1304 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill435> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0148> ;
        schema:name "Rijsbergen (gemeente Zundert)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "De aan de overkant van de straat gelegen pastorie (St.-Bavostraat 7), een tweelaags herenhuis in empire-trant, dateert uit omstreeks 1830, evenals het naastgelegen koetshuis. Oorspronkelijk hoorde deze pastorie bij de in 1916 gesloopte voorganger van de huidige kerk. In het park op die plaats staat het uit 1936 daterende, indrukwekkende H. Hartbeeld (St.-Bavostraat ong.) van de Gentenaar R. de Beule van Hecke. De bronzen beeldengroep toont Christus, die staande op een rotspartij een zwoegend boerengezin zegent."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0148.php> .

