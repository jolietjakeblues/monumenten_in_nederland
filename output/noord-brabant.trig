        schema:name "Vessem (gemeente Eersel)"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Het voorm. raadhuis (Jan Smuldersstraat 15) werd in 1898 gebouwd in neorenaissance-vormen en uitgebreid in 1928 en 1973."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0181.php> .

