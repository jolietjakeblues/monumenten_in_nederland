        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Veghel"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "De voorm. synagoge (Deken Van Miertstraat 1) dateert uit 1865. In 1949 werd het pand tot woning verbouwd en voorzien van een nieuwe voorgevel in wederopbouwstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01517> a min:Passage,
