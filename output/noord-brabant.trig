        schema:name "Schaijk (gemeente Landerd)"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Het voorm. raadhuis (Pastoor Van Winkelstraat 5), met een toren voorzien van een koperen ui-spits, verrees in 1950 naar plannen van J. de Jong in de traditionele vormen van de Bossche School."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0153.php> .

