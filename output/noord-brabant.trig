        schema:name "Teteringen (gemeente Breda)"@nl ;
        schema:pageEnd "302" ;
        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "Akkerdorp ontstaan in de middeleeuwen. Het dorp heeft zich verder ontwikkeld uit een lintbebouwing langs de Hoolstraat en het Hoeveneind."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01441> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Teteringen (gemeente Breda)"@nl ;
        min:adres "Hoeveneind 3",
            "Hoolstraat 13" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
