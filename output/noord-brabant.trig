        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierlingsbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vierlingsbeek" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1549 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0182> ;
        schema:name "Vierlingsbeek"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Na een grote dorpsbrand in 1756 ontwikkelde de kern zich langs de weg Venraij - Boxmeer, die omstreeks 1850 werd verhard, en de haaks daarop staande Spoorstraat. Bij de gevechten in 1944 liepen dorp en omgeving grote schade op."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01550> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierlingsbeek"@nl ;
        min:adres "Spoorstraat 17",
            "Spoorstraat 19" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxmeer" ;
        min:gemeenteInBoek "Vierlingsbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxmeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierlingsbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vierlingsbeek" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1550 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0182> ;
        schema:name "Vierlingsbeek"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "De Herv. kerk (Spoorstraat 17) is een eenvoudig zaalkerkje uit 1843, gebouwd nadat de voorganger uit 1804 in 1839 gedeeltelijk was ingestort. Het pand heeft een klokgevel met fronton en een oogvormig venster. De pastorie (Spoorstraat 19) zou gebouwd zijn als jachtverblijf van koning Willem I en werd in 1811 verhoogd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01551> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierlingsbeek"@nl ;
        min:adres "Pastoor Jansenstraat 1A",
            "Pastoor Jansenstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boxmeer" ;
        min:gemeenteInBoek "Vierlingsbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxmeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierlingsbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vierlingsbeek" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1551 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0182> ;
        schema:name "Vierlingsbeek"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "De R.K. St.-Laurentiuskerk (Pastoor Jansenstraat 2) is een recht gesloten pseudo-basilicale kerk met terzijde staande zeskante toren in traditionele vormen. De kerk verrees in 1952-'53 naar plannen van J. Strik ter plaatse van de in 1944 verwoeste kerk uit 1818. De toren stamt uit 1960-'61. De voorgevel heeft granieten heiligenbeelden van F. van der Burcht. De neoclassicistische pastorie (Pastoor Jansenstraat 1A) stamt uit 1872."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01552> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierlingsbeek – Woonhuis"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
