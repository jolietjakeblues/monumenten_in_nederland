        schema:pageEnd "166" ;
        schema:pageStart "166" ;
        schema:pagination "166" ;
        schema:text "Windmolen. Aan de zuidrand van de dorpskern staat een wit gepleisterde, ronde beltkorenmolen (Molenakkers 5) uit 1843."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00699> a min:Passage,
