            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75967>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75968> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "524400",
            "524401",
            "525702",
            "525703" ;
        min:soort "inleiding" ;
        min:volgnummer 977 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0094> ;
        schema:name "Kaatsheuvel (gemeente Loon op Zand)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De R.K. kerk H.H. Martelaren van Gorkum (Erasstraat 8) is een neoromaanse kruiskoepelkerk met dubbeltorenfront en uitgebouwd torenportaal, gebouwd in 1893-'95 naar ontwerp van P. Stornebrink. De kerk bevat een hoogaltaar uit 1902 door J. Custers. De aangebouwde pastorie (Erasstraat 6) werd in 1909-'11 gebouwd naar plannen van Th. Smeele. Op het kerkhof staat een neoromaanse kapel met calvariegroep uit de bouwtijd van de kerk. Aan de overzijde van de straat ligt het St.-Jozefklooster van de zusters van Schijndel (Erasstraat 5) uit 1914-'18."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0094.php> .

