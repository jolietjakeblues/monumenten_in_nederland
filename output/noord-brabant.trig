        schema:name "Hoeven (gemeente Halderberge)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Straatdorp dat na 1282 ontstond in een door de cisterciënzerabdij van St.-Bernhard bij Antwerpen ontgonnen gebied; de abdij had hier een uithof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00949> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoeven (gemeente Halderberge)"@nl ;
        min:adres "St.-Jansstraat 38",
            "St.-Jansstraat 40" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoeven (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hoeven" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 949 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0089> ;
        schema:name "Hoeven (gemeente Halderberge)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De R.K. kerk St.-Johannes de Doper (St.-Jansstraat 40) verrees in 1928-'29 naar ontwerp van J. Berben in expressionistische stijl. De kerk heeft een plattegrond in de vorm van een Grieks kruis met op de viering een dakruiter met achtkante spits. De pastorie (St.-Jansstraat 38) is van dezelfde architect."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00950> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoeven (gemeente Halderberge)"@nl ;
        min:adres "Hofstraat 8" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoeven (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Hoeven" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73382>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73383>,
