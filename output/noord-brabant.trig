        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "35141" ;
        min:soort "lemma" ;
        min:volgnummer 1442 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0170> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "302" ;
        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "Woonhuizen. Het 18de-eeuwse dwarse eenlaagshuis Hoolstraat 10 heeft een lijstgevel, een opkamer boven een kelder en een aangebouwd bedrijfsgedeelte. Hoolstraat 26 is een 19de-eeuws eenlaagspand. Hoolstraat 36 is een 19de-eeuws tweebeukig pand met aan de achterzijde een lage dakvoet. Het neoclassicistische herenhuis De Withof (Hoolstraat 86) dateert uit 1854."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01443> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Teteringen (gemeente Breda) – Boerderijen"@nl ;
        min:adres "Blauwhoefsedreef 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Teteringen (gemeente Breda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Teteringen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44584> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "35128" ;
        min:soort "lemma" ;
        min:volgnummer 1443 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0170> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "302" ;
        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "Boerderijen. Rond Teteringen staat een aantal interessante langgevelboerderijen, waarvan het woongedeelte vaak ouder is dan het bedrijfsgedeelte. Bij Moleneind 12 dateert het woongedeelte blijkens de jaartalankers uit 1612. De Blauwe Hoef (Blauwhoefsedreef 1) dateert in de huidige vorm uit omstreeks 1800, maar heeft een waarschijnlijk 17de-eeuws, onderkelderd woongedeelte met kloostervensters in de zijgevel. Op het erf staan twee langgevelschuren. Andere langgevelboerderijen met een waarschijnlijk 17de-eeuwse kern zijn Hoeveneind 27 en Moleneind 10. De laatste is in zijn huidige vorm midden-19de-eeuws. Op het erf staan een Vlaamse schuur, een karschop en een bakhuis. De uit 1810 stammende langgevelboerderij Hoeveneind 7 heeft een uitgebouwde herenkamer uit 1708. De uitgebouwde herenkamer bij het woongedeelte van Hoeveneind 61 draagt in gemetselde cijfers de datering ‘1732’. Deze langgevelboerderij heeft een vrij hoog bedrijfsgedeelte; op het erf staat een Vlaamse schuur. Interessante langgevelboerderijen uit de tweede helft van de 19de eeuw zijn: Blauwhoefsedreef 5 (1868), Groenstraat 8 (1871) en Groenstraat 21 (1886)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0170.php> .

