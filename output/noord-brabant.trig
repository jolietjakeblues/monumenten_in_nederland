        schema:pagination "65" ;
        schema:text "De voorm. dorpsschool (Dorpsstraat 27) is een in 1920 gebouwde dorpsschool van drie klassen. De vormgeving heeft expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0014.php> .

