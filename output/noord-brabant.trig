        min:rijksmonumentnummer "512427" ;
        min:soort "lemma" ;
        min:volgnummer 1088 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0115> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "Woonhuizen. Het Karelsstein (Hekelstraat 1) werd rond 1870 gebouwd in opdracht van de burgemeester van Mierlo. Het herenhuis Baron van Scherpenzeel Heuschweg 13 is een tweelaags herenhuis met wenkbrauwen. Het dateert in zijn huidige vorm uit 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01089> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mierlo – Boerderijen"@nl ;
