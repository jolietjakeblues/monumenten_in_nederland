        min:adres "Lange Brugstraat 30",
            "Lange Brugstraat 32" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Etten-Leur" ;
        min:gemeenteInBoek "Etten-leur" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Etten-Leur_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
