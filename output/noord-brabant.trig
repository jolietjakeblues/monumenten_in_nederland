        schema:name "Heeswijk-dinther (gemeente Bernheze)"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "De Herv. kerk (Kerkstraat 2, Dinther) is een eenvoudige zaalkerk uit 1822 met schilddak en dakruiter. De pastorie (Kerkstraat 4) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00792> a min:Passage,
