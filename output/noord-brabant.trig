        min:hoofdstuk "Steden, dorpen, monumenten › Uden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Uden" ;
        min:lemma "Odiliapeel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1480 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0172> ;
        schema:name "Odiliapeel"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Odiliapeel. Dit Peelontginningsdorp ten oosten van Uden ontstond na 1908 en werd tot 1920 ‘Terraveen’ genoemd. De R.K.H. Kruisvindingskerk (Oudedijk 43) is een zaalkerk met massieve terzijde staande toren in Bossche schoolstijl, opgetrokken in 1958-'59 naar ontwerp van J. de Jong. De Lagere School (Oudedijk 48) uit omstreeks 1955 is een interessant voorbeeld van wederopbouwarchitectuur en heeft een ingangsportiek met zuilen en fries met spelende kinderen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0172.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01481> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Uden – Volkel"@nl ;
        min:adres "Kloosterstraat 2",
            "Kloosterstraat 4" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Uden" ;
        min:gemeenteInBoek "Uden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Uden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Uden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Uden" ;
        min:lemma "Volkel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1481 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0172> ;
        schema:name "Volkel"@nl ;
        schema:pageEnd "312" ;
        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Volkel. Dit kerkdorp ten zuidoosten van Uden bezat sinds 1455 een kapel, maar kreeg pas in 1855 een eigen kerk. De R.K. kerk St.-Anthonius Abt (Kloosterstraat 2) is een driebeukige basiliek met westtoren van vier geledingen uit 1938, gebouwd in traditionele stijl naar plannen van J. van Halsteren. Het bronzen H. Hartbeeld uit 1926 is een ontwerp van J. Dechlin. De pastorie (Kloosterstraat 4) stamt uit 1890. Ten zuiden van het dorp staat de windmolen Brabantstraat 20, een oorspronkelijk uit 1753 stammende gesloten-standerdmolen die na brand in 1983 geheel nieuw is opgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0172.php> .

