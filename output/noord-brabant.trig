        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nederwetten (gemeente Nuenen c.a.)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nederwetten" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1125 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0121> ;
        schema:name "Nederwetten (gemeente Nuenen c.a.)"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "Nabij de watermolen staat de eenvoudige R.K.H. Kruiskapel uit 1953, waarschijnlijk een ontwerp van H.W. Valk. De kapel staat in het toen aangelegde H. Kruispark op de plaats van het in 1146 gestichte adellijke vrouwenklooster Hooidonk, dat tijdens de Tachtigjarige Oorlog werd verwoest. Onder een bijgebouw van Hooidonk 14 resteert hiervan nog een 14de-eeuwse kelder met tongewelf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01126> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-vossemeer (gemeente Steenbergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-vossemeer (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nieuw-vossemeer" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1126 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0122> ;
        schema:name "Nieuw-vossemeer (gemeente Steenbergen)"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "Het eerste dorp met deze naam werd gesticht in een in 1566 drooggelegde polder, maar ging al verloren in 1583 toen de polderdijken werden doorgestoken om de opmars van Spaanse troepen te verhinderen. Het huidige dorp ontstond omstreeks 1610 met haaks op de dijk de (verbrede) Voorstraat - afgesloten door de Herv. Kerk - en aan de westzijde de Achterstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01127> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw-vossemeer (gemeente Steenbergen)"@nl ;
        min:adres "Voorstraat 48" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw-vossemeer (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nieuw-vossemeer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24671> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "30612" ;
        min:soort "inleiding" ;
        min:volgnummer 1127 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0122> ;
        schema:name "Nieuw-vossemeer (gemeente Steenbergen)"@nl ;
        schema:pageEnd "257" ;
        schema:pageStart "257" ;
        schema:pagination "257" ;
        schema:text "De Herv. kerk (Voorstraat 48) is een eenvoudige zaalkerk uit 1649. In 1849 kreeg het een nieuwe, gepleisterde voorgevel met daarboven een klokkentoren. Deze bouwfase werd in 1969 ongedaan gemaakt, waarbij men de 17de-eeuwse toestand reconstrueerde. In de toren hangt een in 1652 door Johannes Burgerhuys gegoten klok. Midden op het schilddak staat een achtkante dakruiter (1969) met uivormige spits. Het interieur heeft een vlakke zoldering. Het eenvoudig kerkhof wordt afgesloten door een gietijzeren hek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01128> a min:Passage,
