        schema:name "Spoordonk (gemeente Oirschot)"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "De R.K. kerk St.-Bernadette (Bernadettestraat 2-4) is een driebeukig gebouw met terzijde staande toren en achtkantige doopkapel. De kerk is in 1935-'36 gebouwd naar een ontwerp van A.J.M. Rats in gotiserende stijl, vermengd met stijlelementen uit de school van A.J. Kropholler."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01402> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Spoordonk (gemeente Oirschot)"@nl ;
        min:adres "Spoordonkseweg 130" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
