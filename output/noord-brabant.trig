        schema:name "Acht"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Acht. Dit akkerdorp ten noordwesten van Eindhoven kwam tegen het eind van de 19de eeuw tot ontwikkeling. De neogotische R.K. kerk St.-Anthonius Abt (IJsselstraat 4) werd in 1885 gebouwd naar ontwerp van L.C. Hezenmans, in 1928 verbouwd door H. van Doremalen en in 1951 uitgebreid naar plannen van C.G. Geenen. Deze laatste tekende ook voor de pastorie (IJsselstraat 2). Aan de rand van het dorp bevindt zich de ronde bakstenen beltkorenmolen ‘Annemie’ (Boschdijk 1006) uit 1891."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00612> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eindhoven – Bokt"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
