        min:kern "Roosendaal" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1314 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0149> ;
        schema:name "Roosendaal"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "De R.K. kapel (Kapelstraat 5) dateert uit 1897. De achtkantige kapel is uitgevoerd in een combinatie van neoromaanse en neogotische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01315> a min:Passage,
