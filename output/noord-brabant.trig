            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36445> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32384",
            "518216",
            "527000" ;
        min:soort "inleiding" ;
        min:volgnummer 517 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0040> ;
        schema:name "Deursen-Dennenburg (Gemeente Ravenstein)"@nl ;
        schema:pageEnd "133" ;
        schema:pageStart "133" ;
        schema:pagination "133" ;
        schema:text "De R.K. St.-Vincentiuskerk (Laagstraat 16, Deursen) is een driebeukige neogotische, pseudo-basilicale kerk met westtoren, in 1874-'77 gebouwd naar ontwerp van C. van Dijk. De toren van vier geledingen kreeg in 1919 een spits in tentdakvorm, ontworpen door F. de Beer. In de toren hangen een klok uit 1589 en een in 1622 door H. Wegewaert gegoten klok. De pastorie (Kuiperstraat 1) uit 1920, is mogelijk ook een ontwerp van F. de Beer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00518> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deursen-Dennenburg (Gemeente Ravenstein)"@nl ;
        min:adres "Rondestraat 29" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Ravenstein" ;
