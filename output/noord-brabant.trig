        schema:name "Vlierden (gemeente Deurne)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Akkerdorp ontstaan in de vroege middeleeuwen. Lange tijd is het een kleine heerlijkheid geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0183.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01559> a min:Passage,
