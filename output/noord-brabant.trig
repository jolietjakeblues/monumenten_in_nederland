        min:adres "Carmelstraat 55" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:lemma "Waspik-Zuid" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1625 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik-Zuid"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "Waspik-Zuid. Dit dorp ten zuidoosten van Waspik kwam tot ontwikkeling bij het karmelietenklooster (Carmelstraat 55), dat in 1926-'27 werd gebouwd naar plannen van J. Donders. Het bestaat uit een kloostergebouw, een driebeukige, aan St.-Theresia gewijde, kloosterkerk en - tussen beide - een vierkante klokkentoren met naaldspits. De ingang van het klooster is voorzien van neogotische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01626> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Werkendam"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
