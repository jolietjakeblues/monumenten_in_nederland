        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eersel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Eersel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 572 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0049> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "Woonhuizen. Aan de gaaf bewaarde Markt staan diverse (Kempische) dorpswoonhuizen. Markt 17 is de oudste en stamt uit 1669. Naast dit huis met mogelijk houten gebint, komen eenlaagshuizen met balkdragende zijmuren voor, zoals Markt 49-51, en huizen met twee bouwlagen, zoals de voorm. burgemeesterswoning Markt 15 uit omstreeks 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00573> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eersel – Steensel"@nl ;
        min:adres "Eindhovenseweg 30",
            "Kerkdreef 9" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eersel" ;
        min:gemeenteInBoek "Eersel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eersel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Eersel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Eersel" ;
        min:lemma "Steensel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52126> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "14587" ;
        min:soort "lemma" ;
        min:volgnummer 573 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill191> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0049> ;
        schema:name "Steensel"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "Steensel. Dit dorp ten noordoosten van Eersel ontstond in de middeleeuwen in het stroomgebied van Gender en Run. De omstreeks 1400 gebouwde kerktoren (Kerkdreef 9) is een restant van de in 1933 gesloopte middeleeuwse St.-Luciakerk, waarvan het schip al in 1821 was vernieuwd. De eenvoudige, maar indrukwekkende toren heeft drie geledingen zonder steunberen, een traptoren en een toegang in een diepe nis. De tweede geleding is voorzien van spaarvelden met gekoppelde rondbogen, en de derde geleding heeft galmgaten die door een overhoeks geplaatste penant in tweeën worden gedeeld. Wellicht dateert de derde geleding van een verbouwing in 1495, toen Wouter Kaerwas ook de klok goot. De nieuwe R.K. St.-Luciakerk (Eindhovenseweg 30) is een zaalkerk uit 1934, gebouwd naar plannen van F. Vervest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00574> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eethen (gemeente Aalburg)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
