        schema:name "Pompen"@nl ;
        schema:pageEnd "340" ;
        schema:pageStart "340" ;
        schema:pagination "340" ;
        schema:text "Pompen. Op de niet geplaveide Markt staan twee natuurstenen pompen uit 1768, gemaakt door F. Somers. De ene wordt bekroond door een vaas in Lodewijk XV-stijl, de andere draagt het wapen van Carel Theodoor van Paltz-Beieren, markies van Bergen op Zoom."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0197.php> .

