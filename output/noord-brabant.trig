        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62150> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "21292" ;
        min:soort "lemma" ;
        min:volgnummer 801 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0080> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Windmolen ‘St.-Victor’ (Leenderweg 14-16) is een ronde bakstenen beltkorenmolen uit 1856, herbouwd na brandschade in 1905. Het windvaantje met het jaartal 1841 is afkomstig van een andere molen, waarschijnlijk in Nederweert (Limburg)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00802> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeze (gemeente Heeze-Leende) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heeze-Leende" ;
        min:gemeenteInBoek "Heeze-Leende" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heeze-Leende> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heeze (gemeente Heeze-Leende)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Heeze" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 802 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0080> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "Boerderijen. Veel van de boerderijen in dit oorspronkelijk agrarische dorp zijn verdwenen of kregen een andere bestemming. Een interessante groep bevindt zich nog aan de noordzijde van de dorpskern, aan de driehoekige ‘plaats’ van het gehucht Strabrecht. Belangrijke langgevelboerderijen zijn Strabrecht 37 en Strabrecht 46. De kortgevelboerderij Strabrecht 4-4A, heeft de in afwijkende kleur baksteen uitgevoerde datering ‘1695’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0080.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00803> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeze (gemeente Heeze-Leende) – Kerkhof"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heeze-Leende" ;
        min:gemeenteInBoek "Heeze-Leende" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heeze-Leende> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heeze (gemeente Heeze-Leende)" ;
