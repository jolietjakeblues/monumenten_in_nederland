        schema:name "Eersel"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "De dorpspomp (Markt ong.) uit 1864 is uitgevoerd in hardsteen en wordt bekroond door kleine gebeeldhouwde torens met kantelen, overeenkomstig het gemeentewapen van Eersel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0049.php> .

