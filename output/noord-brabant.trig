        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "De windmolen aan de Wilhelminastraat (ong.) is een gesloten-standerdmolen. De constructie, die in 1785 van elders hierheen is verplaatst, zou uit 1703 dateren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0025.php> .

