        min:hoofdstuk "Steden, dorpen, monumenten › Deursen-Dennenburg (Gemeente Ravenstein)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Deursen-Dennenburg" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 513 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0040> ;
        schema:name "Deursen-Dennenburg (Gemeente Ravenstein)"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Twee aan elkaar gegroeide dorpen, die in de vroege middeleeuwen ontstonden op één langgerekte donk in het rivierkleigebied. Vanaf de 16de eeuw werd de ontwikkeling van beide dorpen geremd door het functioneren van de Beerse Overlaat. Ook na het buiten werking stellen daarvan in 1942 bleef de groei voornamelijk beperkt tot het gebied op de donk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0040.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00514> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Deursen-Dennenburg (Gemeente Ravenstein)"@nl ;
        min:adres "Hoogstraat 36" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
