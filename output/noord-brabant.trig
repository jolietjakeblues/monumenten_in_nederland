        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "Woonhuizen. De voorm. notariswoning Dorpsstraat 25-25a (Veldhoven) stamt in opzet uit de 17de eeuw en bevat inwendig moer- en kinderbinten. Notarisfamilie De Wit, die van 1811 tot 1908 het pand bewoonde, gaf omstreeks 1875 opdracht tot de verbouwing in eclectische vormen. Het Hooghuis (Kapelstraat Noord 78, Zeelst) is een molenaarshuis uit 1750, gebouwd in opdracht van molenaar P. Stijmans. Aan de korte zijden heeft het pand trapgevels met ingezwenkte treden. De voorm. domineeswoning Dorpsstraat 120 (Veldhoven) dateert uit 1770. Dorpsstraat 93-95 (Veldhoven), de voorm. pastorie van de St.-Ceciliaparochie, heeft in de voorgevel de jaartalankers ‘1778’. Het pand werd in 1836 hersteld en kreeg omstreeks 1900 de huidige mansardekap. Textielfabrikant W. van Nuenen liet in 1905 de villa Kapelstraat Zuid 3 (Meerveldhoven) bouwen naar plannen van architect Clement. Het ontwerp bevat elementen van de chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01532> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veldhoven – Windmolens"@nl ;
        min:adres "Burg. Van Hoofflaan 10",
            "Hoogeind 37" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Veldhoven" ;
        min:gemeenteInBoek "Veldhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veldhoven_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veldhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veldhoven" ;
        min:lemma "Windmolens" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1532 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0179> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "319" ;
        schema:pageStart "318" ;
        schema:pagination "318-319" ;
        schema:text "Windmolens. De ronde stenen beltkorenmolen Kapelstraat Noord 142b te Zeelst dateert uit 1858. In Meerveldhoven staat de ronde stenen beltkorenmolen De Adriaan (Burg. Van Hoofflaan 10) uit 1906. Te Oerle bevindt zich de in 1987 opgerichte stellingmolen St.-Jan (Hoogeind 37). Voor de onderbouw zijn stenen gebruikt van een gesloopte molen te Vught; als bovenbouw dient een uit 1871 stammende molen uit Leezen bij Lübeck."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01533> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veldhoven – Zandoerle"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
