        min:soort "lemma" ;
        min:volgnummer 564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0048> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "140" ;
        schema:pageStart "140" ;
        schema:pagination "140" ;
        schema:text "Boerderijen. Rond het dorp staan de boerderijen vooral langs de dijk naar Almkerk. Goede voorbeelden zijn Dussendijk 29 uit 1759, Korn 26 uit 1767, de Jannahoeve (Hoek 47) uit 1782, Korn 42 uit de 18de of de eerste helft van de 19de eeuw en Muilkerk 28 uit de eerste helft van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0048.php> .

