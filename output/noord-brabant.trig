        min:hoofdstuk "Steden, dorpen, monumenten › Bladel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Bladel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33906> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "9577" ;
        min:soort "inleiding" ;
        min:volgnummer 333 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0024> ;
        schema:name "Bladel"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "92" ;
        schema:pagination "92" ;
        schema:text "De Herv. kerk (Van Dissellaan 1) dateert uit 1820 en is een bakstenen zaalkerk met gebosseerd gepleisterde voorgevel en driezijdige sluiting. Het interieur is voorzien van een stucplafond. Tot de inventaris behoren een eenvoudige 17de-eeuwse preekstoel en een in 1825 door P.J. Geerkens gebouwd kabinetorgel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00334> a min:Passage,
