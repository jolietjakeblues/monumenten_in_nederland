        min:kern "Helmond" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 813 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0082> ;
        schema:name "Helmond"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De voorm. Herv. kerk (Kerkstraat 19) is een vroeg-neogotische, achtkante centraalbouw met uitgebouwd ingangsportaal, driezijdig gesloten koor en een hoge achtzijdige dakruiter met naaldspits. De kerk werd gebouwd in 1847-'48 naar ontwerp van A. van Veggel. Het interieur heeft gestucadoorde gewelven, gestucte gotische vormen en gietijzeren vensters, alle elementen van de zogeheten Willem II-gotiek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0082.php> .

