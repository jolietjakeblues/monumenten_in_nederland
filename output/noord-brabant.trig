        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roosendaal" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Roosendaal" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76788>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76789>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76790> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517267",
            "526035",
            "526036" ;
        min:soort "inleiding" ;
        min:volgnummer 1313 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0149> ;
        schema:name "Roosendaal"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "De R.K. kerk van O.L. Vrouwe van Altijddurende Bijstand (Kade 21) is een basilicale kruiskerk met dubbeltorenfront, apsis en zijkapellen, gebouwd in 1868 voor de paters redemptoristen. Th. Asseler maakte het ontwerp in een combinatie van romaanse en Byzantijnse vormen. De kerk werd in 1907 naar plannen van A. de Bruin - en onder toezicht van P.J.H. Cuypers - verlengd met drieëneenhalve travee en voorzien van een vieringtoren. Een uit de bouwtijd daterende kooromgang heeft men gesloopt. Een rijk uitgevoerd portaal in het transept geeft toegang tot het naburige, in neoromaanse vormen uitgevoerde klooster (Kade 23), dat in 1877 verrees naar ontwerp van architect Van der Vaart."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01314> a min:Passage,
