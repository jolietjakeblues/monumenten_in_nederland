        min:soort "inleiding" ;
        min:volgnummer 1614 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0189> ;
        schema:name "Wanroij (gemeente Sint Anthonis)"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen op twee zandruggen in het Peelgebied. In 1551 werd het dorp tot zelfstandige parochie verheven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0189.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01615> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wanroij (gemeente Sint Anthonis)"@nl ;
        min:adres "Kerkplein 1",
            "Kerkplein 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint Anthonis" ;
        min:gemeenteInBoek "Sint Anthonis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint_Anthonis> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wanroij (gemeente Sint Anthonis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Wanroij" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1615 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill519> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0189> ;
        schema:name "Wanroij (gemeente Sint Anthonis)"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "De R.K. St.-Corneliuskerk (Kerkplein 2) is een driebeukige neogotische kruisbasiliek met dakruiter; de rijzige toren is voorzien van een achtkantige spits met flankerende torentjes. De kerk werd in 1909-'10 gebouwd naar plannen van C. Franssen. Inwendig zijn de dragende delen uitgevoerd in schoon metselwerk en de wanden en gewelven gepleisterd. Het kerkhof werd omstreeks 1825 aangelegd met aan het eind van het middenpad een calvarieberg met baarhuisje; daarvoor liggen pastoorsgraven. De pastorie (Kerkplein 1) heeft een kern uit 1792. Omstreeks 1885 zijn de gevels vernieuwd in eclectische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0189.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01616> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wanroij (gemeente Sint Anthonis) – Windmolen"@nl ;
        min:adres "Molenstraat 23" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint Anthonis" ;
        min:gemeenteInBoek "Sint Anthonis" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Sint_Anthonis> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wanroij (gemeente Sint Anthonis)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Wanroij" ;
        min:lemma "Windmolen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1616 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0189> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Windmolen ‘De Ster’ of ‘Hamse Molen’ (Molenstraat 23), gelegen ten westen van Wanroij, is een gesloten standerdkorenmolen van drie verdiepingen uit 1811. Nadat de molen in 1974 als gevolg van verwaarlozing was ingestort, volgde in 1978 herbouw aan de overzijde van de weg. Samen met de molen te Usselo (Overijssel) is het de enige overgebleven ‘driezolder’-standerdmolen in Nederland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0189.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01617> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waspik (gemeente Waalwijk)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1617 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill520> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "329" ;
        schema:pagination "329-330" ;
        schema:text "Dorp ontstaan in de 12de eeuw door ontginning van veengronden in het zuiden van de Grote of Zuid-Hollandse Waard. Na de St.-Elisabethsvloed in 1421, waarbij grote delen van het dorp wegspoelden, ontstond meer zuidwaarts nieuwe bebouwing. Aan de Haven en de Kerkvaart concentreerde zich sinds het eind van de 19de eeuw enige industriële bedrijvigheid. In de jaren vijftig van de 20ste eeuw werd de Haven gedempt. Het dorp is via een langgerekte lintbebouwing verbonden met Raamsdonk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01618> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waspik (gemeente Waalwijk)"@nl ;
        min:adres "Raadhuistraat 17" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1618 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De Herv. kerk (Raadhuistraat 17) is een laat-gotisch bouwwerk met driebeukig pseudo-basilicaal schip, lagere dwarsarmen en een driezijdig gesloten koor. De vrij forse kerk heeft nooit een toren gekend; op de oostzijde van het schipdak staat een dakruiter. Het koor dateert uit het midden van de 15de eeuw; schip en dwarsarmen kwamen in dezelfde tijd of iets later tot stand. In de 19de eeuw zijn de vensters van het schip vergroot en van houten ramen in bakstenen omrandingen voorzien; de vensters van het koor kregen bij een restauratie in 1959 nieuwe bakstenen traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01619> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waspik (gemeente Waalwijk)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1619 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Het interieur heeft houten tongewelven met trekbalken en zuilen met lijstkapitelen en achtkante basementen. De gewelven zijn tijdens de restauratie hersteld en opnieuw beschoten. Het koor is door een wand van de rest van de kerk afgescheiden en door een vloer in twee lagen gesplitst. Beneden bevindt zich de consistoriekamer, met een 18de-eeuwse houten schoorsteenmantel, boven een grote zaal. Tot de inventaris behoren een koperen doopbekkenhouder en twee koperen lessenaars (vroeg-18de-eeuws), verder een eikenhouten preekstoel op hardstenen voet en een doophek, die evenals de toegangsdeur naar het koor dateren uit omstreeks 1771 en die voorzien zijn van sierlijk rococo-snijwerk door Petrus Verhoeven. Van zijn hand zijn zeer waarschijnlijk ook de tochtportalen, de psalmborden en de orgelkast met onder meer de wapens Cousebant-Van Wassenaer; het instrument werd in 1767 geplaatst door Matthijs de Crane. Het ommuurde kerkhof heeft aan de westzijde natuurstenen hekpijlers in rococo-stijl, een 19de-eeuws baarhuisje en verschillende 19de-eeuwse natuurstenen grafmonumenten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01620> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waspik (gemeente Waalwijk)"@nl ;
        min:adres "Dorpsplein 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1620 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De R.K. St.-Bartholomeusen Barbarakerk (Dorpsplein 1) is een driebeukige, neoclassicistische hallenkerk, gebouwd in 1840-'41 naar plannen van J. Brands onder toezicht van het Ministerie van Waterstaat. De voorgevel heeft nissen met beelden van de patroonheiligen en een toscaans zuilenportiek met fronton. Het bovenste deel van de gevel is een hoog, trapgevelvormig opzetstuk met blokkenbepleistering, bekroond door een achtkant koepeltorentje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01621> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waspik (gemeente Waalwijk)"@nl ;
        min:adres "Kerkstraat 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalwijk" ;
        min:gemeenteInBoek "Waalwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waspik (gemeente Waalwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waspik" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38686> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "38340" ;
        min:soort "inleiding" ;
        min:volgnummer 1621 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0190> ;
        schema:name "Waspik (gemeente Waalwijk)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Het interieur heeft ton- en kruisribgewelven van stucwerk, die worden gedragen door zuilen met ionische kapitelen en hoge achtkante basementen. Tot het meubilair, dat grotendeels uit de bouwtijd van de kerk dateert, behoren een hoogaltaar met draaibare expositietroon door J.B. Peeters uit Antwerpen, zijaltaren door J. Buijssen met beelden van de hand van M. van Bokhoven en Peeters, een preekstoel, eveneens door Peeters, met onder de kuip een beeldengroep, twee biechtstoelen door Buijssen en Peeters, en een door F.B. Loret in 1848 gebouwd orgel in een kast met snijwerk van Peeters. M. Weiss vervaardigde in 1950-'51 de gebrandschilderde glazen. De voorm. pastorie (Kerkstraat 1) is een 19de-eeuws neoclassicistisch pand. Het kerkhof bezit een aantal monumentale neogotische grafmonumenten uit 1881."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0190.php> .

