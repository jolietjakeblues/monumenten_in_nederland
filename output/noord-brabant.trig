        min:adres "Chaamseweg 14-16" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulvenhout (gemeente Breda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ulvenhout" ;
        min:lemma "Luchtenburg" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1496 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill489> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0175> ;
        schema:name "Luchtenburg"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Luchtenburg (Chaamseweg 14-16), ten zuiden van Ulvenhout, is een buitenplaats met formele aanleg, waarin bijzondere geometrische elementen zijn opgenomen. Een eenvoudig rechthoekig landhuis uit de tweede helft van de 17de eeuw vormt de kern van de buitenplaats. Omstreeks 1850 werd het huis met een verdieping verhoogd. Ter rechterzijde van het voorplein ligt een langgerekte boerderij met een deels houten bedrijfsgedeelte. Links staat een grote houten Vlaamse schuur met rieten dak, met inrijdeur in beide lange wanden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01497> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulvenhout (gemeente Breda) – Hondsdonk"@nl ;
        min:adres "Chaamseweg 28",
            "Hondsdonkseweg 7" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulvenhout (gemeente Breda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ulvenhout" ;
        min:lemma "Hondsdonk" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1497 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0175> ;
        schema:name "Hondsdonk"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Hondsdonk (Chaamseweg 28), ten zuiden van Ulvenhout, is een buitenplaats met als kern een empire-landhuis uit omstreeks 1795. Het huis heeft aan de voorzijde een erker en rechts een naar achteren uitgebouwde vleugel. De balkons en het klokkentorentje (afkomstig van huis Luchtenburg) werden omstreeks 1840 geplaatst. Twee hardstenen siervazen met mythologische figuren flankeren de toegang naar het huis. Voor het huis staat een houten duiventil. De tuinaanleg uit 1842, in Engelse landschapsstijl met slingervijver, wordt toegeschreven aan de toenmalige bewoonster, Henriëtte van der Borch-van der Heim. Zij ontwierp ook het op een ‘cottage’ gelijkende boerderijtje (Hondsdonkseweg 7) op het landgoed."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01498> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulvenhout (gemeente Breda) – Anneville"@nl ;
        min:adres "Annevillelaan 93-101",
            "Annevillelaan 99" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Breda" ;
        min:gemeenteInBoek "Breda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Breda_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulvenhout (gemeente Breda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ulvenhout" ;
        min:lemma "Anneville" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1498 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill490> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0175> ;
        schema:name "Anneville"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Anneville (Annevillelaan 93-101), ten zuidoosten van het dorp, is een buitenplaats met wit gepleisterd landhuis in neoclassicistische trant. Het huis heeft zijrisalieten aan de voorzijde en een middenrisaliet met fronton aan de achterzijde. De Brabantse historicus A.C.F. Prosper Cuypers van Velthoven liet het in 1851-'52 bouwen naar ontwerp van A. Trappeniers. De serre en het terras aan de achterzijde dateren uit 1934. Het koetshuis en het achtkantig hoenderhok stammen uit 1898. De lanenstructuur van de buitenplaats is ouder dan het huis. Naar plannen van L. Rosseels liet de zoon van de bouwheer in 1885 aan de achterzijde van het huis het vrij langgerekte park aanleggen, eindigend in een tegen een bosrand gesitueerde ronde vijver. Op het landgoed staat een langhuisboerderij (Annevillelaan 99) uit 1845, verbouwd in 1908."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01499> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valkenswaard"@nl ;
