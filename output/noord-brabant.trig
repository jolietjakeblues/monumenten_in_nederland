        min:hoofdstuk "Steden, dorpen, monumenten › Heeswijk-dinther (gemeente Bernheze)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Heeswijk-dinther" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 792 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0079> ;
        schema:name "Heeswijk-dinther (gemeente Bernheze)"@nl ;
        schema:pageEnd "184" ;
        schema:pageStart "184" ;
        schema:pagination "184" ;
        schema:text "De R.K. St.-Servatiuskerk (St.-Servatiusstraat 1, Dinther) is een driebeukige neogotische kruiskerk met toren van vier geledingen, gebouwd in 1877-'79 naar plannen van J. Werten, die zich liet inspireren door de kerken van C. van Dijk. De laat-19de-eeuwse kruiswegstaties zijn van F. de Vriendt, de gebrandschilderde ramen van M. de Leeuw (1956-'59)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00793> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heeswijk-dinther (gemeente Bernheze)"@nl ;
        min:adres "Hoofdstraat 80",
            "Hoofdstraat 82" ;
