        schema:name "Esch (gemeente Haaren)"@nl ;
        schema:pageEnd "155" ;
        schema:pageStart "155" ;
        schema:pagination "155" ;
        schema:text "Het klooster Sancta Monica (Gestelseweg 8), nu klooster van de missiezusters van de O.L. Vrouwe van Afrika werd in 1895 gebouwd in eenvoudige neogotische vormen naar plannen van bouwkundige J. de Vries."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0056.php> .

