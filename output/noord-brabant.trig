        schema:name "Werkendam"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "Het gebouw van de Maatschappij tot Nut van het Algemeen (Hoogstraat 32) is een neoclassicistisch pand met zadeldak uit 1880, waarin ouder kern uit 1837. Het later aangebouwde poortje naast het huis heeft een tegeltableau met de tekst ‘badhuis’, hetgeen herinnert aan een verdwenen pand met die functie, dat achter het Nutsgebouw lag."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01631> a min:Passage,
            schema:CreativeWork ;
