        min:kern "Vught" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11113> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "490250" ;
        min:soort "inleiding" ;
        min:volgnummer 1578 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0186> ;
        schema:name "Vught"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "Het voorm. kloosterinternaat Regina Coeli (Helvoirtseweg 189), ook bekend als ‘Eikenheuvel’, dateert uit 1903-'05 en heeft een kapel uit 1908; beide zijn gebouwd naar plannen van J. Dony. Het pand ligt in een landschappelijk park."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01579> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vught"@nl ;
        min:adres "Glorieuxlaan 6" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Vught" ;
        min:gemeenteInBoek "Vught" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vught_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vught" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vught" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1579 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0186> ;
        schema:name "Vught"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "Het voorm. kloosterinternaat Mariaoord (Glorieuxlaan 6) is een groot, hoofdzakelijk L-vormig pand uit 1910, gebouwd naar plannen van J. Dony voor de ursulinen op het landgoed ‘Roucouleur’. Het internaat heeft licht uitstekende hoekpaviljoens en een middenrisaliet met fronton, dubbele trap en overdekt bordes. Met zijn gebogen erkers en klassieke vormen is het een goed voorbeeld van ‘Um 1800’-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01580> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vught"@nl ;
        min:adres "Mariaplein 8",
            "Mariaplein 9",
            "Taalstraat 51" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Vught" ;
        min:gemeenteInBoek "Vught" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vught_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vught" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vught" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68778>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68782>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68783> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "521314",
            "521315",
            "525796" ;
        min:soort "inleiding" ;
        min:volgnummer 1580 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0186> ;
        schema:name "Vught"@nl ;
        schema:pageEnd "323" ;
        schema:pageStart "323" ;
        schema:pagination "323" ;
        schema:text "De R.K. kerk Maria Middelares Aller Genaden (Mariaplein 9) is een eenbeukige kruiskerk met vieringtoren uit 1933-'34, gebouwd in traditionele vormen naar ontwerp van A.J. Kropholler. Het interieur is uitgevoerd in schoon metselwerk en bevat het door de architect zelf ontworpen hoogaltaar en doopvont. De kruiswegstaties (1934) zijn van M. Andriessen. De kerk maakt deel uit van het uit 1933 daterende complex Mariaoord (Mariaplein 8) met klooster, rusthuis en scholen, eveneens naar plannen van Kropholler. De pastorie (Taalstraat 51) stamt uit omstreeks 1950."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0186.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01581> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vught – Raadhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Vught" ;
