        schema:name "Sint Hubert (gemeente Mill)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Dorp ontstaan in de late middeleeuwen rondom een kleine kerk die in 1796 tot parochiekerk werd verheven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0156.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01362> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Hubert (gemeente Mill)"@nl ;
        min:adres "Kerkpad 16" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Land van Cuijk" ;
        min:gemeenteInBoek "Mill" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Land_van_Cuijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Hubert (gemeente Mill)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint Hubert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15965> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "29935" ;
        min:soort "inleiding" ;
        min:volgnummer 1362 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0156> ;
        schema:name "Sint Hubert (gemeente Mill)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De R.K. kerk H.H. Hubertus en Barbara (Kerkpad 16) is een eenbeukige kerk met 15de-eeuwse westtoren en 16de-eeuws schip. De eenvoudige toren heeft drie geledingen voorzien van rechthoekige spaarvelden en spitsboognissen met galmgaten; aan de noordzijde bevindt zich een veelhoekige traptoren. Het schip heeft aan de westzijde een plint van blokken ijzeroer. In 1825 kreeg het schip een gestucadoord tongewelf met trekstangen en men verving het koor door nieuwbouw. Het koor werd in 1934 nogmaals vernieuwd en er verrees een transept."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0156.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01363> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint Hubert (gemeente Mill)"@nl ;
        min:adres "Kerkpad 10-12" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Land van Cuijk" ;
        min:gemeenteInBoek "Mill" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Land_van_Cuijk> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint Hubert (gemeente Mill)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint Hubert" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1363 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0156> ;
        schema:name "Sint Hubert (gemeente Mill)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "In de kerk staat een beeld uit 1520-'30 van St.-Catharina die haar vader en belager, keizer Maxentius, vertrapt. De 18de-eeuwse preekstoel met vierkante kuip - aan de onderzijde uitlopend in een vruchtenkorf - is versierd met reliëfs voorstellende St.-Hubertus, de Goede Herder en de pauselijke tiara, geflankeerd door de evangelistensymbolen. Voorts bezit de kerk nog delen van het 18de-eeuwse hoogaltaar, een orgelbalustrade met onderdelen van een communiebank uit 1857 en enkele laat-18de-eeuwse heiligenbeelden. De pastorie (Kerkpad 10-12) is een U-vormig pand met mogelijk 18de-eeuwse kern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0156.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01364> a min:Passage,
