        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill471>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill472> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0171> ;
        schema:name "Tilburg"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "De R.K. kerk O.L. Vrouwe van de Rozenkrans (Hasseltstraat 194-198, Hasselt) [7] is een driebeukige kruisbasiliek uit 1897, aan de voorzijde voorzien van twee traptorentjes. Het ontwerp is van A.G. de Beer. Naast de kerk staat een Mariaschool in neogotische vormen uit 1900; deze heeft een beeld van Franciscus van Assisi in de geveltop."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0171.php> .

