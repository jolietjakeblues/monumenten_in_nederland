        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cranendonck> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel Dorplein (gemeente Budel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel Dorplein" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 464 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0032> ;
        schema:name "Budel Dorplein (gemeente Budel)"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "124" ;
        schema:pagination "124" ;
        schema:text "De Kempense zinkfabriek (Hoofdstraat 1), gebouwd in 1892, bestond aanvankelijk uit zes zinkovens, een fabriekshal en een kantoor. In 1900 kwam een nieuwe retortenfabriek tot stand en in 1905 en 1908 verrezen nieuwe fabriekshallen. Door de vele latere uitbreidingen is slechts een deel van de oorspronkelijke gebouwen bewaard gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00465> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel Dorplein (gemeente Budel)"@nl ;
        min:adres "Hoofdstraat 201" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
