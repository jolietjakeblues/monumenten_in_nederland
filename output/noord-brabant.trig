        schema:name "Grave"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De voorm. corps du garde (Maaskade 14) is een in opzet 18de-eeuws wachtgebouw, strategisch gelegen tegenover de Maaspoort. Het dient nu als garage."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00743> a min:Passage,
