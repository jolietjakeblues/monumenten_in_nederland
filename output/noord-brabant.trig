        schema:name "Veen (gemeente Aalburg)"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "Oeverwaldorp langs de (Afgedamde) Maas, ontstaan in de middeleeuwen. Bij een dijkdoorbraak in 1880 werd het dorp grotendeels verwoest en vervolgens weer opgebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0177.php> .

