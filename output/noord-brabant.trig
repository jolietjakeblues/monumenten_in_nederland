        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Kerkakkerdorp, centraal gelegen ten opzichte van enkele omliggende gehuchten. Hier verrees in de 15de eeuw een kerk, toen het als zelfstandige parochie van die van Bergeijk werd afgesplitst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0145.php> .

