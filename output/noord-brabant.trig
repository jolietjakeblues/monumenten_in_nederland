        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0188> ;
        schema:name "Waalwijk"@nl ;
        schema:pageEnd "328" ;
        schema:pageStart "328" ;
        schema:pagination "328" ;
        schema:text "De R.K. kerk O.L. Vrouwe Onbevlekte Ontvangenis (Pastoor Van Kesselhof 18, Besoyen) is een grote eenbeukige kerk met ronde toren, gebouwd in 1926-'27 naar ontwerp van Dom. Bellot - in samenwerking met P. Cuypers jr. - in expressionistische stijl. Het interieur wordt overdekt met keperbogen en paraboolvormige velden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0188.php> .

