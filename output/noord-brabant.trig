        min:gemeenteInBoek "Vierlingsbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxmeer_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierlingsbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vierlingsbeek" ;
        min:lemma "Woonhuis" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1552 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill501>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill502> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0182> ;
        schema:name "Woonhuis"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "320" ;
        schema:pagination "320-321" ;
        schema:text """Woonhuis Spoorstraat 9 is een dwars huis uit het begin van de 17de eeuw met aan de kopse zijden in- en uitgezwenkte topgevels. De jaartalankers ‘1756’ duiden op het optrekken van de gevel aan de voorzijde. Van circa 1850 tot 1919 was in het pand een synagoge gevestigd.

De Isr. begraafplaats (Spoorstraat ong.), gelegen ten westen van het dorp, werd omstreeks 1790 aangelegd ten behoeve van de joden uit het Land van Cuijk."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

