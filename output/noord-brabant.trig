        min:volgnummer 1036 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0106> ;
        schema:name "Lithoijen (gemeente Lith)"@nl ;
        schema:pageEnd "247" ;
        schema:pageStart "247" ;
        schema:pagination "247" ;
        schema:text "Het voorm. franciscanessenklooster (Prelaat Van den Berghplein 3) werd omstreeks 1895 in neogotische vormen opgetrokken. Het bood tot 1950 plaats aan een meisjespensionaat, waarvan het schoolgebouw aan de rechterzijde nog bestaat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0106.php> .

