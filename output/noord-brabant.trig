        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Klundert" ;
        min:lemma "Noordhoek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76478> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "521700" ;
        min:soort "lemma" ;
        min:volgnummer 995 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0096> ;
        schema:name "Noordhoek"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "Noordhoek. Dit dorp ten zuiden van Klundert ontstond in de in 1548 bedijkte Oude Fijnaartse Polder en kreeg pas in het begin van de 20ste eeuw een kerk. De R.K. St.-Josefkerk (Bisschop Hopmansstraat 1) werd in 1921 gebouwd naar ontwerp van Dom. Bellot in samenwerking met H.C. van de Leur. Het gebouw heeft bijzonder expressionistisch metselwerk met parabool- en keperbogen, voorzien van kleurige baksteenversieringen. De pastorie (Bisschop Hopmansstraat 3) is van dezelfde architecten en dateert ook van 1921."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0096.php> .

