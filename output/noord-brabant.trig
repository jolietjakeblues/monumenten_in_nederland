        min:soort "inleiding" ;
        min:volgnummer 1234 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0135> ;
        schema:name "Ossendrecht (gemeente Woensdrecht)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De R.K. St.-Gertrudiskerk (Dorpsstraat 1) is een kruisbasiliek met dakruiter en westtoren, gebouwd in 1897 naar ontwerp van P.J. van Genk ter vervanging van een laat-gotische kerk. De rijk gedecoreerde westtoren heeft natuurstenen banden en een ingesnoerde spits. Het interieur heeft gestucte kruisgewelven op zuilen met forse bladkapitelen. De pastorie (Dorpsstraat 7) stamt uit omstreeks 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0135.php> .

