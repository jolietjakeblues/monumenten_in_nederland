            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24664>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32052>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33756> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "21283",
            "21284",
            "520585",
            "520586" ;
        min:soort "lemma" ;
        min:volgnummer 1142 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0124> ;
        schema:name "Vorstenbosch"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Vorstenbosch. Ontginningsdorp ten zuiden van Nistelrode. De R.K. St.-Lambertuskerk (Kerkstraat 2) is een eenbeukig zaalgebouw met terzijde geplaatste slanke toren met zadeldak. De kerk verrees in 1933 naar plannen van H.C. van de Leur in een expressionistische stijl in de trant van Dom. Bellot. De pastorie (Kerkstraat 4) stamt uit dezelfde tijd, evenals de naastgelegen zusterklooster annex school (Kerkstraat 6-8). De wit geschilderde, ronde bakstenen beltkorenmolen Windlust (Kerkstraat 20) dateert van 1820. Bij een verhoging omstreeks 1900 ontstond het ingezwenkte profiel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01143> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nuenen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Nuenen, Gerwen en Nederwetten" ;
        min:gemeenteInBoek "Nuenen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nuenen,_Gerwen_en_Nederwetten> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nuenen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nuenen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1143 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0125> ;
        schema:name "Nuenen"@nl ;
        schema:pageEnd "259" ;
        schema:pageStart "259" ;
        schema:pagination "259" ;
        schema:text "Zanddorp ontstaan uit een aantal nederzettingen en gehuchten, ieder met een eigen brink of plaats, die tot in deze eeuw als zodanig herkenbaar waren. De belangrijkste ‘plaatsen’ waren de Berg (hoek Papenvoort) en het Park. De eerste heeft een fraaie etalagelinde, en de tweede is in 1920 ingericht tot openbaar park in Engelse landschapsstijl en voorzien van een muziekkiosk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01144> a min:Passage,
