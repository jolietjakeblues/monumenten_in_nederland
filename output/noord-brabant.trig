        schema:name "Windmolen"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Windmolen ‘De Korenbloem’ (Molenstraat 34) ligt ten zuiden van de dorpskern. De ronde bakstenen beltkorenmolen dateert uit 1909 en verving een in 1835 uit Strijbeek afkomstige standerdmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01496> a min:Passage,
            schema:CreativeWork ;
