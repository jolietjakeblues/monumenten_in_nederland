        min:kern "Diessen" ;
        min:lemma "Baarschot" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48578> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12899" ;
        min:soort "lemma" ;
        min:volgnummer 532 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Baarschot"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "Baarschot. Akkergehucht ten zuiden van Diessen. Brouwerij ‘Het Witte Kruis’ (Baarschotsestraat 46-48) is een eenlaags gebouw op L-vormige plattegrond, waarvan het rechterdeel een topgevel bezit met duivengaten en de jaartalankers ‘1717’. De grote schuur met schilddak dateert uit 1871. Gijselstraat 4 en 5, de laatste met jaartalankers ‘1833’, zijn langgevelboerderijen met een rieten wolfdak en dakvoet met pannen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00533> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dinteloord (gemeente Steenbergen)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dinteloord (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dinteloord" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 533 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0043> ;
        schema:name "Dinteloord (gemeente Steenbergen)"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "Voorstraatdorp dat werd gesticht na de inpoldering van het omringende gebied in 1605. Aan weerszijden van een bestaande kreek werden een voorstraat (Oost- en Westvoorstraat) en een achterstraat (Ooster- en Westerstraat) aangelegd. Ondanks de gedeeltelijke demping van de kreek, de verwoesting in 1944 en latere dorpsuitbreidingen is de oorspronkelijke planmatige opzet nog duidelijk herkenbaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00534> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dinteloord (gemeente Steenbergen)"@nl ;
        min:adres "Westvoorstraat 1",
            "Westvoorstraat 26" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dinteloord (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dinteloord" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16783>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19379> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12911",
            "12912" ;
        min:soort "inleiding" ;
        min:volgnummer 534 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill178>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill179> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0043> ;
        schema:name "Dinteloord (gemeente Steenbergen)"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "135" ;
        schema:pagination "135-136" ;
        schema:text "De Herv. kerk (Westvoorstraat 26) is een vierkant bouwwerk met achtkantig koepeltorentje, gebouwd in 1693 naar ontwerp van stadhouderlijk architect Johan van Swieten. Na oorlogsschade in 1944 stonden nog slechts de muren overeind. De kerk is nagenoeg in de oude vorm hersteld. Het aanvankelijk houten koepeltorentje werd in baksteen vernieuwd, maar het wordt inwendig nog wel gedragen door vier houten zuilen. Boven de ingang bevindt zich een in Bentheimer zandsteen uitgevoerde wapensteen met cartouche en bouwjaar, gemaakt door Johan van Blommendael. Het oorspronkelijk zandstenen wapen van koning-stadhouder Willem III (heer van Dinteloord) is reeds lang vervangen door een (opnieuw) geschilderde versie. Het raadhuis (Westvoorstraat 1) is een rechthoekig gebouw met neoclassicistische voorgevel en achtkante open dakruiter met koepeldakje. Het voorste gedeelte ontstond in 1830 naar ontwerp van C. Korteweg, door verbouwing van een ouder, wellicht nog 18de-eeuws huis. Na zware schade in de Tweede Wereldoorlog werd het gebouw in 1948-'49 in oude vorm hersteld. In 1976-'77 is het gebouw aan de achterzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00535> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dinteloord (gemeente Steenbergen) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Steenbergen" ;
        min:gemeenteInBoek "Steenbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Steenbergen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dinteloord (gemeente Steenbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dinteloord" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 535 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0043> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text """Boerderijen. Rondom het dorp liggen 18de- en 19de-eeuwse boerderijen bestaande uit een rechthoekig vrijstaand woonhuis met zadeldak en een grote, vrijstaande schuur met wolfdak. Goede voorbeelden zijn: Noordzeedijk 120, Stoofdijk 66 en Bloemdijk 20; van Noordzeedijk 10 is de grote schuur gesloopt.

De Dintelsassluizen (Sasdijk ong.) liggen ten noorden van het dorp op de plaats waar de Dintel uitkomt in het Volkerak. Het complex bestaat uit een schutsluis met rolbrug en een uitwateringssluis, gebouwd in 1828 naar ontwerp van de hoofdingenieur van Waterstaat, A. Goekoop."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00536> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Dongen" ;
        min:gemeenteInBoek "Dongen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dongen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dongen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 536 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0044> ;
        schema:name "Dongen"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen binnen het moerassige stroomgebied van de Dunne Aa (nu de Donge). Het dorp bestond in oorsprong uit een aantal donken, één daarvan met een ‘plaatse’ (de Heuvel) en een andere met de kerk. Langs de Hoge en Lage Ham kwam lintbebouwing tot ontwikkeling. Aan de Donge vestigden zich vanaf de 18de eeuw diverse leerlooierijen. Na de Eerste Wereldoorlog verrezen nieuwe bedrijven langs het pas gegraven Wilhelminakanaal. Na 1945 is het dorp aan de oost- en de westzijde sterk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00537> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongen"@nl ;
        min:adres "Kerkstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Dongen" ;
        min:gemeenteInBoek "Dongen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dongen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dongen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16932> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517212" ;
        min:soort "inleiding" ;
        min:volgnummer 537 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0044> ;
        schema:name "Dongen"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "De Herv. kerk (Kerkstraat 2) is een laat-gotische kruiskerk met een eenvoudige toren, een driebeukig, in ruïneuze staat verkerend schip en een driezijdig gesloten koor. De kerk werd gebouwd ter plaatse van een waarschijnlijk 13de-eeuwse, eenbeukige kerk met ronde koorsluiting, waarvan de funderingsresten in 1985 zijn aangetroffen. Het koor werd waarschijnlijk in het midden van de 15de eeuw voltooid. Bij een verbouwing van het schip in 1640-'44 trok men de muren van de zijbeuken hoger op, zodat een pseudo-basilicaal schip ontstond. De protestantse gemeenschap, die in deze tijd de beschikking over de kerk kreeg, was te klein om het gebouw op de lange duur te kunnen onderhouden. Na eeuwen van verwaarlozing stortte in 1928 het schipdak in. Sindsdien zijn alleen het koor en het dwarspand nog in gebruik. In de kerk bevinden zich onder meer een grafsteen uit omstreeks 1560 voor pastoor Dierik Willemszoon van Engelen, een eenvoudige zeskante preekstoel uit 1646, gemaakt door Adriaen Damisse, en twee laat-17de-eeuwse tekstborden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00538> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongen"@nl ;
        min:adres "Hoge Ham 25" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Dongen" ;
        min:gemeenteInBoek "Dongen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dongen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dongen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25064> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517206" ;
        min:soort "inleiding" ;
        min:volgnummer 538 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0044> ;
        schema:name "Dongen"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "Het franciscanessenklooster (Hoge Ham 25) werd in 1801 gesticht. Het middengedeelte van het hoofdgebouw kwam in 1858 tot stand naar ontwerp van architect Oomen, in een neorenaissance-stijl met neogotische kenmerken. De rest van het gebouw, met twee naar voren verspringende brede zijvleugels, verrees omstreeks 1890 gebouwd in neorenaissance-stijl. De bijbehorende neogotische driebeukige kruiskerk met vieringtoren verrees in 1898 naar ontwerp van C.F. van Genk. Binnen in de kerk zijn er muurschilderingen van J. Collette; de gebrandschilderde ramen zijn van J. Nicolas. Bij het klooster ligt een begraafplaats (Bolkensteeg ong.) met calvarieberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0044.php> .

