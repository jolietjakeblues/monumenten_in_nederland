        min:volgnummer 512 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0039> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "132" ;
        schema:pageStart "132" ;
        schema:pagination "132" ;
        schema:text "Windmolens. De verwaarloosde ronde bakstenen beltkorenmolen Veldstraat 29 dateert uit 1890. Zuidoostelijk van het dorp staat de Maria Antoinette (Zeilbergsestraat 98), een achtkante beltkorenmolen met bakstenen onderbouw en met riet gedekte houten bovenbouw. Deze waarschijnlijk Zuid-Hollandse poldermolen werd in 1893 overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00513> a min:Passage,
