        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Windmolen ‘De Arend’ (Molenstraat 40) is een ronde bakstenen stellingkorenmolen, oorspronkelijk daterend uit 1742, maar herbouwd in 1756 na een brand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01438> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terheijden (gemeente Made) – Verdedigingswerken"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Drimmelen" ;
        min:gemeenteInBoek "Made" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Drimmelen> ;
