        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Spoorbruggen. Ten westen van Drunen bevinden zich twee enkelvoudige ijzeren vakwerkbruggen (Eindstraat ong. en Overlaatweg ong.) uit 1886-'90, restanten van de voorm. Langstraatspoorlijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0046.php> .

