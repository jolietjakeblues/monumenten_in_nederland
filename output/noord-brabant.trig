        min:adres "Kasteellaan 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuwkuijk (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Nieuwkuijk" ;
        min:lemma "Kasteel d'Oultremont" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19896> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "37877" ;
        min:soort "lemma" ;
        min:volgnummer 1133 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0123> ;
        schema:name "Kasteel d'Oultremont"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Kasteel d'Oultremont (Kasteellaan 1), gelegen ten oosten van het dorp, wordt ook wel het kasteel van Drunen genoemd. Het in oorsprong mogelijk 15de-eeuwse kasteel behoorde waarschijnlijk sinds 1670 tot de bezittingen van de heren van Drunen en vanaf 1707 tot die van de graven d'Oultremont. In 1795 brandde het nagenoeg geheel af. De huidige vorm, een gebouwencomplex op T-vormige plattegrond, is grotendeels het resultaat van een in 1875 uitgevoerde verbouwing en uitbreiding naar ontwerp van H.J. van Tulder. Daarbij voorzag men de ingang met flankerende achtkantige torens van een trapgevel en smalle gekoppelde rondboogvensters; de linkervleugel kreeg arkeltorentjes. In 1989 werd het kasteel opgenomen in pretpark ‘Het land van Ooit’, waarbij het roze werd geschilderd en uitgebreid met een grote serre naar plannen van J.A. van Poppel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0123.php> .

