        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "31309",
            "518841",
            "518842",
            "519160",
            "519161" ;
        min:soort "inleiding" ;
        min:volgnummer 1166 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0128> ;
        schema:name "Oirschot"@nl ;
        schema:pageEnd "263" ;
        schema:pageStart "263" ;
        schema:pagination "263" ;
        schema:text "Het karmelietessenklooster Blijendaal (Nieuwstraat 28) is een gebouwencomplex waarvan het oudste gedeelte bestaat uit een eenvoudig vroeg-17de-eeuws woonhuis met aan weerszijden twee lage vleugels. Van 1644 tot 1663 huisde hier de orde der karmelietessen. In 1931 kwam het klooster weer als zodanig in gebruik en werd uitgebreid met nieuwe vleugels en een kapel naar plannen van H.W. Valk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0128.php> .

