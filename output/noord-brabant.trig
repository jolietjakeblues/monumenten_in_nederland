        min:soort "inleiding" ;
        min:volgnummer 685 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0062> ;
        schema:name "Geffen (gemeente Maasdonk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Dorp ontstaan in de middeleeuwen als een krans van gehuchten rondom een centraal gelegen kerk. Deze gehuchten zijn later aaneengegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00686> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geffen (gemeente Maasdonk)"@nl ;
        min:adres "Kerkstraat 10" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Maasdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geffen (gemeente Maasdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geffen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11433> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "16026" ;
        min:soort "inleiding" ;
        min:volgnummer 686 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill226> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0062> ;
        schema:name "Geffen (gemeente Maasdonk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "De R.K. Maria Magdalenakerk (Kerkstraat 10) is een driebeukige gotische kruisbasiliek die wellicht begin 15de eeuw werd gesticht. De midden-15de-eeuwse toren van drie geledingen heeft spaarnissen, overhoekse steunberen, een veelhoekig uitgebouwde traptoren en een laag tentdak uit later tijd. Het schip resteert van de herbouw na brand in 1497 en verwoesting in 1517. In 1597 brandde de kerk opnieuw af. Van het herstel in 1607 dateert de kapconstructie van het schip. Bij de restauratie en uitbreiding in 1892-'93, naar plannen van C. Franssen, werd het oude koor vervangen door een nieuw transept, een driezijdig gesloten koor en een sacristie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00687> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geffen (gemeente Maasdonk)"@nl ;
        min:adres "Kloosterstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Maasdonk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geffen (gemeente Maasdonk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Geffen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65942>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/65943> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "520592",
            "520593" ;
        min:soort "inleiding" ;
        min:volgnummer 687 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0062> ;
        schema:name "Geffen (gemeente Maasdonk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Inwendig heeft het schip dikke ronde zuilen op achtkante basementen en waarvan een segment als schalk langs de lichtbeuk doorloopt. Het houten tongewelf uit 1607 werd in 1892-'93 vervangen door netgewelven. Het interieur is in neogotische stijl beschilderd. De gesneden panelen in het neogotische altaar zijn afkomstig van de vroegere 17de-eeuwse preekstoel. De pastorie (Kloosterstraat 2), stamt uit omstreeks 1850 en is een goed voorbeeld van de overgang van neoclassicisme naar vroege neogotiek, getuige de hoekpilasters met spaarnissen, die van driepassen zijn voorzien."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0062.php> .

