            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44944> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "518872",
            "519191",
            "519192" ;
        min:soort "inleiding" ;
        min:volgnummer 1082 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill374>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill375> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0114> ;
        schema:name "Middelbeers (gemeente Oirschot)"@nl ;
        schema:pageEnd "253" ;
        schema:pageStart "253" ;
        schema:pagination "253" ;
        schema:text "De nieuwe R.K. St.-Willibrorduskerk (Willibrordstraat 16) is een driebeukige kruiskerk uit 1925-'27 met lager aangezet, vijfzijdig gesloten koor en een toren van vier geledingen; L.J.P. Kooken maakte het ontwerp met art deco-elementen. Het sobere interieur is voorzien van graatgewelven en bakstenen pilaren. De pastorie (Willibrordstraat 18) dateert uit 1863 en heeft een gietijzeren tuinpoort uit 1865."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01083> a min:Passage,
            schema:CreativeWork ;
