        rdfs:label "Grave – Herbergen"@nl ;
        min:adres "Brugstraat 8",
            "Hamstraat 1",
            "Hamstraat 28" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
        min:gemeenteInBoek "Grave" ;
