        min:volgnummer 975 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0094> ;
        schema:name "Kaatsheuvel (gemeente Loon op Zand)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Straatdorp ontstaan in de 14de eeuw op de scheiding van zand- en veengrond. Het westelijke deel (Berndorp) kwam in de 15de eeuw tot ontwikkeling in een door de abdij Berne ontgonnen gebied. Na de Tweede Wereldoorlog is het dorp fors uitgebreid naar het oosten en het zuiden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0094.php> .

