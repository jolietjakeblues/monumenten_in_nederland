        schema:name "Liempde (gemeente Boxtel)"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Het voorm. St.-Albertusgesticht (Dorpsstraat 34) is een eenvoudig neogotisch klooster uit 1887 en tevens een intrigerend voorbeeld van herbestemming tot woningen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0101.php> .

