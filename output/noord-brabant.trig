        schema:name "Rucphen"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "Kerkdorp, waarschijnlijk in de 14de eeuw ontstaan op een kruising van twee turfvaarten. Het dorp leed zware schade in 1944."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0151.php> .

