        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Huize de Vliert (Pastoriestraat 26) is een neogotisch kloostergebouw met korte zijvleugels, uit 1906."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0183.php> .

