        schema:text "Windmolen ‘De Doornenboom’ (Doelenstraat 53) is een ronde bakstenen beltkorenmolen uit 1856."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00939> a min:Passage,
