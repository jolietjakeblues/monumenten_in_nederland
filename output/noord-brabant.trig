        schema:name "Nuenen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Het voorm. St.-Elisabethsgesticht (Park 3) van de Zusters van de Sociëteit van Jezus, Maria en Jozef is een congregatieklooster uit 1887, uitgevoerd in neorenaissance-stijl met elementen van de neogotiek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0125.php> .

