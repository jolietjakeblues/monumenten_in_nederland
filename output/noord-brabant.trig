        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0087> ;
        schema:name "Hilvarenbeek"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "De Openbare School (Paardenstraat 6) werd in 1890 gebouwd met drie klaslokalen en een aangrenzende bergplaats. De overdekte speelplaats dateert van omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0087.php> .

