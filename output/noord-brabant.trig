        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boekel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boekel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boekel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 339 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0025> ;
        schema:name "Boekel"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Dorp ontstaan in de middeleeuwen. Het werd pas in 1677 een zelfstandige parochie. Tot 1794 behoorde Boekel tot de (katholieke) heerlijkheid Ravenstein. Het in 1742 hierheen overgebrachte klooster Padua profiteerde van deze godsdienstvrijheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0025.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00340> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boekel"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Boekel" ;
        min:gemeenteInBoek "Boekel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boekel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boekel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boekel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 340 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0025> ;
        schema:name "Boekel"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "De R.K. St.-Agathakerk (Kerkstraat) is een driebeukige kerk uit 1925. De terzijde staande toren heeft een paraboolvormige spits. De kerk is gebouwd in expressionistische trant naar plannen van J. Franssen en verving de aan de overzijde staande (gesloopte) kerk uit 1831. Inwendig heeft de kerk betonnen paraboolspanten. De kerkbanken en de sokkels van de 19de-eeuwse beelden vertonen art deco-details. Altaar en preekstoel stammen uit 1694. De kruiswegstaties zijn in 1851 door N. Wintelrode geschilderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0025.php> .

