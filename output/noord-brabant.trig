        min:gemeenteInBoek "Deurne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deurne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Deurne" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Deurne" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53798> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12369" ;
        min:soort "inleiding" ;
