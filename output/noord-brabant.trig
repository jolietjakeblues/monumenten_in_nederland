        min:soort "lemma" ;
        min:volgnummer 761 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0072> ;
        schema:name "Huize Karmel"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Huize Karmel (Rijksweg 3), gelegen nabij seminarie Haarendael, staat ook bekend als ‘Huize Gerra’. Het onderkelderde villagebouw is in 1853 opgetrokken als bisschoppelijk paleis voor Mgr. Zwijsen. Na zijn dood werd het een klooster van de ongeschoeide karmelietessen. De aangebouwde kapel verrees rond 1957 naar plannen van J. Bedaux."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00762> a min:Passage,
            schema:CreativeWork ;
