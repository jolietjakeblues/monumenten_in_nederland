        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Het klooster St.-Anna (Torenstraat 41) uit omstreeks 1910 ligt in een landschappelijk aangelegd park."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0152.php> .

