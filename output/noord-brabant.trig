        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0126> ;
        schema:name "Oeffelt (gemeente Boxmeer)"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text "Dorp ontstaan in de 12de eeuw op een oeverwal van de Maas. Oorspronkelijk was het in handen van de heren van Cuijk, maar van 1441 tot 1800 was het Kleefs bezit. Het dorp werd in 1944 zwaar getroffen door oorlogsgeweld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0126.php> .

