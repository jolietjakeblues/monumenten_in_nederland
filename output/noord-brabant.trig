        min:kern "Eindhoven" ;
        min:lemma "Watermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15025>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21050> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "14639",
            "14647" ;
        min:soort "lemma" ;
        min:volgnummer 605 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill204>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill205> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0051> ;
        schema:name "Watermolens"@nl ;
        schema:pageEnd "150" ;
        schema:pageStart "150" ;
        schema:pagination "150" ;
        schema:text "Watermolens. De Genneper watermolen (Genneperweg 143) [26] is een onderslagmolen op de Dommel, die voor het eerst in 1249 wordt vermeld. Op verwoesting in 1583 volgde herbouw in 1586-'87. De oorspronkelijk dubbele graan- en oliemolen ging vanaf 1622 ook dienst doen als volmolen. Na verdere aanpassingen in 1715 en 1850, volgde in 1963 een ingrijpende restauratie, waarbij het houten molengebouw en het huidige enkele rad nagenoeg geheel werden herbouwd. De Collse molen (Collseweg 3, Tongelre) is een onderslagmolen op de Kleine Dommel, die voor het eerst in 1337 wordt vermeld als banwatermolen van de heer van Cuijk en Mierlo. Van deze oorspronkelijk dubbele watermolen resteert eveneens nog één rad. De kern van de huidige gebouwen zal dateren van een herbouw in de late 18de eeuw, toen ook het uit 1787 stammende molenaarshuis (Collseweg 1) tot stand kwam. Dit huis heeft een deuromlijsting in simpele Lodewijk XVI-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0051.php> .

