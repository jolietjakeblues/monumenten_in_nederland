        min:volgnummer 501 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0037> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "Windmolen ‘De Pelikaan’ (Hoogstraat 91) staat in de buurtschap Maaskantje. Het is een ronde bakstenen beltkorenmolen uit 1864, herbouwd na een brand in 1922."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00502> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Hout (gemeente Oosterhout)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
