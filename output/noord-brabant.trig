        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0017> ;
        schema:name "Beers (gemeente Cuijk)"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Het woon- en winkelpand Grotestraat 1 is een karakteristieke dorpswinkel uit omstreeks 1880. Het is voorzien van een St.-Willibrordusbeeld en een winkelpui uit omstreeks 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00222> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beers (gemeente Cuijk) – Boerderijen"@nl ;
        min:adres "Heuf 16",
            "Millseweg 13" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Cuijk" ;
        min:gemeenteInBoek "Cuijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cuijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beers (gemeente Cuijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Beers" ;
        min:lemma "Boerderijen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 222 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0017> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Boerderijen. In en om het dorp ligt een aantal interessante boerderijcomplexen. De herenboerderij De Barendonck (Millseweg 13) heeft een T-vormig hoofdgebouw uit de late 18de eeuw met dakruiter en omlijste ingang. Het landhuisachtige boerderijcomplex Ossenbroek (Heuf 16) bestaat uit vroeg-19de-eeuwse gebouwen, geplaatst rondom een hof met duiventoren. De op een kunstmatige verhoging gelegen T-boerderij Broekkant 7 stamt uit 1875 en heeft een schuur heeft steunberen. De voorm. voorname T-boerderij Grotestraat 6-8 stamt uit omstreeks 1880; ze heeft een paneeldeur met vierlobbig bladornament en binnen zijn er stucwerkplafonds."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00223> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergeijk"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
