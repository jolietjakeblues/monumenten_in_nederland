        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0083> ;
        schema:name "Helvoirt (gemeente Haaren)"@nl ;
        schema:pageEnd "195" ;
        schema:pageStart "195" ;
        schema:pagination "195" ;
        schema:text "Het raadhuis (Torenstraat 42) is een rechthoekig gebouw met middenrisaliet voorzien van fronton. De achtkante klokkentoren uit 1792 is ontworpen door A. van Erven. De uitbreiding dateert uit 1963."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0083.php> .

