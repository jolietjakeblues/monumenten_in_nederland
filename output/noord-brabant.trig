        min:gemeenteInBoek "Veldhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veldhoven_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veldhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veldhoven" ;
        min:lemma "Zandoerle" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1533 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0179> ;
        schema:name "Zandoerle"@nl ;
        schema:pageEnd "319" ;
        schema:pageStart "319" ;
        schema:pagination "319" ;
        schema:text "Zandoerle. Dit gehucht ten westen van Veldhoven bestaat uit een kapel en een aantal langgevelboerderijen aan een brink. De R.K. kapel O.L. Vrouwe in 't Zand (Zandoerle ong.) werd in 1807 herbouwd ter plaatse van een in 1648 gesloten kapel. Het woonhuis Zandoerle 15 stamt uit de 18de eeuw. De boerderij Zandoerle 26 bevat mogelijk nog een 17de-eeuwse kern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01534> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Velp (gemeente Grave)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Grave" ;
