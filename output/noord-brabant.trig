        min:adres "Dominicanenstraat 27",
            "Dominicanenstraat 29" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Mill en Sint Hubert" ;
        min:gemeenteInBoek "Mill" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Mill_en_Sint_Hubert> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mill" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Mill" ;
        min:lemma "Langenboom" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1103 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0117> ;
        schema:name "Langenboom"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "255" ;
        schema:pagination "255-256" ;
        schema:text "Langenboom. Dit Peelonginningsdorp ten noordwesten van Mill ontstond aan het eind van de 19de eeuw rondom het voorm. dominicanenklooster (Dominicanenstraat 27), gebouwd in 1867-'74 naar plannen van P.J.H. Cuypers. Het klooster, gelegen in een parkachtige tuin, werd door een cycloon in 1925 zwaar beschadigd. In 1926 herbouwde men de R.K. kerk H. Familie (Dominicanenstraat 29) in kubistisch-expressionistische vormen naar plannen van Ed. Cuypers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01104> a min:Passage,
