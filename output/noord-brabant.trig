        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 458 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Budel"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "De R.K. kerk O.L. Vrouwe Visitatie (Grootscholterweg 88, Budel-Schoot), een eenvoudige zaalkerk met lage zijbeuken en dakruiter, werd in 1929 in traditionele vormen gebouwd naar plannen van J. Franssen. Ernaast staat nog een noodkerk (Grootscholterweg 90) uit 1908."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00459> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel"@nl ;
        min:adres "Markt 1" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Cranendonck" ;
        min:gemeenteInBoek "Budel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Cranendonck> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 459 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Budel"@nl ;
        schema:pageEnd "123" ;
        schema:pageStart "123" ;
        schema:pagination "123" ;
        schema:text "Het schepenhuis (Markt 1) is een eenvoudig gebouw op rechthoekige plattegrond met schilddak en bordes met trappen. Het werd in 1771 gebouwd naar plannen van de Boxtelse landmeter Hendrik Verhees en heeft dienst gedaan als raadhuis met cachot en brandspuitbergplaats, maar ook als garen- en botermarkt. Bij de restauratie in 1981-'82 werd het gebouw, dat door verbouwingen ingrijpend was gewijzigd, in de oorspronkelijke staat gereconstrueerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00460> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel – Woonhuizen"@nl ;
