        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47277>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69742> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517907",
            "517917" ;
