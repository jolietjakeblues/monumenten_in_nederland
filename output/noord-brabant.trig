        schema:name "Geffen (gemeente Maasdonk)"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Het voorm. kloostergebouw Kloosterstraat 7, nu bejaardentehuis, stamt uit omstreeks 1850 en heeft kepervormig gedekte, neoclassicistische vensteromlijstingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00689> a min:Passage,
