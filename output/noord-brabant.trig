        schema:name "Babyloniënbroek (gemeente Aalburg)"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "64" ;
        schema:pagination "64" ;
        schema:text "Langgerekt dorp in een broekontginning, ontstaan op smalle oeverwallen van een natuurlijke - nu verdwenen - waterloop. Het dorp wordt voor het eerst in 1131 vermeld als ‘villa’ Babyloniënbroek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00197> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Babyloniënbroek (gemeente Aalburg)"@nl ;
        min:adres "Broeksestraat 7" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Altena" ;
        min:gemeenteInBoek "Aalburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Babyloniënbroek (gemeente Aalburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Babyloniënbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37763> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "6808" ;
        min:soort "inleiding" ;
        min:volgnummer 197 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0013> ;
        schema:name "Babyloniënbroek (gemeente Aalburg)"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "64" ;
        schema:pagination "64" ;
        schema:text "De Herv. kerk (Broeksestraat 7) is een kleine zaalkerk met een recht gesloten en met riet gedekt koor. Het koor is waarschijnlijk 14de-eeuws. Met gebruikmaking van delen van het middeleeuws muurwerk heeft men het schip in 1664 herbouwd; een gedenksteen boven de ingang herinnert daaraan. De westgevel toont nog de aanzet van een toren. Schip en koor zijn beide overdekt met een houten tongewelf, dat werd vernieuwd tijdens een restauratie omstreeks 1975. De kerk bevat een eiken kansel uit 1631 en een memoriebord uit 1806."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00198> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Babyloniënbroek (gemeente Aalburg)"@nl ;
        min:adres "Broeksestraat 13" ;
