        schema:name "Boxtel"@nl ;
        schema:pageEnd "100" ;
        schema:pageStart "100" ;
        schema:pagination "100" ;
        schema:text "De R.K. landbouwschool (Pastoor Erasstraat 14) uit 1914 is een groot pand in sobere jugendstil-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00377> a min:Passage,
