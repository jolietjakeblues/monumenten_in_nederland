        min:soort "inleiding" ;
        min:volgnummer 1526 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0179> ;
        schema:name "Veldhoven"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "De gemeente Veldhoven omvat vier kerkdorpen. Veldhoven-dorp, Meerveldhoven en Zeelst zijn via Dorpsstraat en Kapelstraat met elkaar verbonden, en Oerle ligt iets apart naar het westen. In recente tijd zijn de dorpen aaneengegroeid tot één forensendorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0179.php> .

