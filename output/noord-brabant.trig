    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01280> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reek (gemeente Landerd)"@nl ;
        min:adres "Mgr. Borretstraat 1",
            "Mgr. Borretstraat 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Landerd" ;
        min:gemeenteInBoek "Landerd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landerd> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reek (gemeente Landerd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Reek" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1280 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0142> ;
        schema:name "Reek (gemeente Landerd)"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "De R.K. kerk St.-Anthonius Abt (Mgr. Borretstraat 1), een driebeukige basilicale kerk met terzijde staande toren, verrees in 1925-'26 en verving een kerk uit 1823. Het ontwerp van C. Franssen is geïnspireerd op de vroegchristelijke en romaanse bouwkunst. De pastorie (Mgr. Borretstraat 3) stamt uit 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01281> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reek (gemeente Landerd)"@nl ;
        min:adres "Mgr. Borretstraat 7-9" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Landerd" ;
        min:gemeenteInBoek "Landerd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landerd> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reek (gemeente Landerd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Reek" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1281 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0142> ;
        schema:name "Reek (gemeente Landerd)"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Het voorm. woonhuis annex orgelbouwerswerkplaats van Smits (Mgr. Borretstraat 7-9) is een groot herenhuis met een zadeldak tussen zijtopgevels van gele steen en een lagere aanbouw aan de rechterzijde. Het pand werd in 1789 gebouwd in opdracht van A. Smits, stamvader van dit orgelmakersgeslacht. Vooral de orgels van F.C. Smits sr. genieten grote bekendheid. Het sierlijke snijlicht in Lodewijk XV-stijl boven de ingang bevat een afbeelding van een orgel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01282> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Reek (gemeente Landerd) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Landerd" ;
        min:gemeenteInBoek "Landerd" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Landerd> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Reek (gemeente Landerd)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Reek" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1282 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0142> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text """Woonhuizen. Het dwarshuis Mgr. Borretstraat 5 is in de kern een 18de-eeuws huis. De voorgevel met empire-vensters met waaierzwikken dateert uit omstreeks 1840. Het vroeg-19de-eeuwse woonhuis Mgr. Borretstraat 12-14 was tevens als bierbrouwerij in gebruik.

De R.K. begraafplaats (Heytmorgen ong.) telt enkele monumentale graven, waaronder een grafkruis uit 1703, het graf van Mgr. Borret uit 1839 en het graf van Dr. C.F. Xavier Smits uit 1876 met een beeld van Christus als Goede Herder naar ontwerp van A. van Bokhoven.

De gietijzeren wegwijzer (Mgr. Borretstraat ong.) met het wapen van Brabant is laat-19de-eeuws en gaf oorspronkelijk de uren gaans aan."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01283> a min:Passage,
