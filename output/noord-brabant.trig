        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0155> ;
        schema:name "Sint Anthonis"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Het klooster St.-Anthonius Abt (Brink 8) is een neogotisch zusterklooster uit 1896, uitgebreid omstreeks 1935. In de topgevel staat een beeld van de patroonheilige."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0155.php> .

