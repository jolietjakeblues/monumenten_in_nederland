        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Andel (gemeente Woudrichem)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Andel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56438> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "39609" ;
        min:soort "inleiding" ;
        min:volgnummer 175 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0010> ;
        schema:name "Andel (gemeente Woudrichem)"@nl ;
        schema:pageEnd "62" ;
        schema:pageStart "62" ;
        schema:pagination "62" ;
        schema:text "De Herv. kerk (Kerkstraat 2) van het vroegere Op-Andel dateert oorspronkelijk uit de 16e eeuw. Het dwars geplaatste, achterste gedeelte is het oudst. Dat gebouw kreeg in 1852 een brede uitbouw aan de voorzijde, waarna nog een uitbreiding plaatsvond omstreeks 1950. Tot de inventaris behoren een 17de-eeuwse preekstoel en een 18de-eeuwse herenbank."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00176> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Andel (gemeente Woudrichem)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
