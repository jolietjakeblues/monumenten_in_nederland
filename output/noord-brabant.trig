        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Spoorbrug (Everdineweerd ong.). Van de in 1879-'83 aangelegde ijzeren spoorbrug over de Maas resteert nog de onderbouw. De brugdelen zelf werden in 1945 en 1958 vernieuwd. Aan de zuidzijde van de brug ligt een brugkazemat uit 1936."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00987> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Katwijk (gemeente Cuijk) – Linden"@nl ;
        min:adres "Kerkstraat 32",
            "Kerkstraat 34" ;
