        min:volgnummer 1562 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0184> ;
        schema:name "Vlijmen (gemeente Heusden)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Langgerekt dorp op de grens van zanden kleigrond in de oostelijke punt van de Langstraat. Het werd in de 11de eeuw door de heren van Heusden gesticht en bleef tot 1814 Hollands gebied."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01563> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlijmen (gemeente Heusden)"@nl ;
        min:adres "Grote Kerk 20",
            "Grote Kerk 22" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlijmen (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vlijmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22076>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52162> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "37868",
            "37869" ;
        min:soort "inleiding" ;
        min:volgnummer 1563 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0184> ;
        schema:name "Vlijmen (gemeente Heusden)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "De Herv. kerk (Grote Kerk 20) is een zaalkerk met westtoren. De 13de-eeuwse, romaanse toren heeft in de tweede geleding spaarvelden en aan de bovenzijde een rondboogfries. De derde geleding werd in de 15de eeuw als klokkenverdieping toegevoegd; een uitkraging op rondboogjes vormt de overgang naar de sterk ingesnoerde naaldspits. Het schip dateert uit de 14de-eeuw en werd na een brand in 1543 hoger opgetrokken. De noordzijbeuk is verdwenen, maar in het schip zijn de scheibogen nog zichtbaar. Koor en transept maakten in 1759 plaats voor een predikantenwoning (Grote Kerk 22). Bij de restauratie in 1949 herstelde men de spitsboogvensters van de kerk. Het interieur bevat een preekstoel en een koperen kroon uit omstreeks 1640, spreukborden van de hand van Dirck van Lith en schilder S. de Lange (1659) en, uit 1763, een koperen lezenaar, een doophek met voorlezersgestoelte en kerkenraadsbanken. Van omstreeks 1762 dateren de herenbank met overhuiving en het wapen van de heren van Vlijmen, de met wapens versierde magistratenbank en het rococo kabinetorgeltje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01564> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlijmen (gemeente Heusden)"@nl ;
        min:adres "Julianastraat 44" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlijmen (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vlijmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38118>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38945> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "37871",
            "517351" ;
        min:soort "inleiding" ;
        min:volgnummer 1564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0184> ;
        schema:name "Vlijmen (gemeente Heusden)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "De R.K. kerk St.-Jans' Geboorte (Julianastraat 44) is een neogotische kruisbasiliek uit 1864-'66, gebouwd naar plannen van H.J. van Tulder. De kerk heeft een hoge westtoren en een vijfzijdige koorsluiting met sacristie en kapellenkrans. Het interieur heeft in stucwerk uitgevoerde kruisribgewelven, niet ongebruikelijk voor de vroege kerken van Van Tulder. De midden-17de-eeuwse preekstoel, met voorstellingen van de heiligen Adrianus, Quirinus, Antonius Abt, Sebastiaan en Victor, komt uit België; het klankbord ontbreekt. A.A. Goossens vervaardigde het hoogaltaar uit 1865 en veel van het overige neogotische meubilair."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0184.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01565> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vlijmen (gemeente Heusden)"@nl ;
        min:adres "Julianastraat 34" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vlijmen (gemeente Heusden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Vlijmen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57273> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "37870" ;
        min:soort "inleiding" ;
        min:volgnummer 1565 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0184> ;
        schema:name "Vlijmen (gemeente Heusden)"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Het raadhuis (Julianastraat 34), een blokvormig pand met hoog souterrain, is in 1870 in neoclassicistische vormen gebouwd naar ontwerp van H.C. Dobbe. Een brede trap leidt naar de ingang op de bel-etage, in een middenrisaliet bekroond door een fronton en geflankeerd door van gepleisterde omlijstingen voorziene vensters. H.C. van Pelt ontwierp de uitbreiding van 1986-'87."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0184.php> .

