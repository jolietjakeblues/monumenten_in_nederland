        schema:name "Schijndel"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Het voorm. St.-Jozefklooster (Pastoor Van Erpstraat 1) van de Congregatie van de Zusters van Liefde werd 1868-'70 gebouwd en in 1898 vergroot met een neogotische kapel naar plannen van J. Kayser. De straatvleugel stamt uit omstreeks 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0154.php> .

