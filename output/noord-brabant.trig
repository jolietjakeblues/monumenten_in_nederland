            "St.-Michielsgestelseweg 3",
            "Stationsstraat 30",
            "Taalstraat 149" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Vught" ;
        min:gemeenteInBoek "Vught" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Vught_(gemeente)> ;
