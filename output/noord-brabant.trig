        min:hoofdstuk "Steden, dorpen, monumenten › Eindhoven" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Eindhoven" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67606>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67607>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67608> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "518710",
            "518711",
            "518712" ;
        min:soort "inleiding" ;
        min:volgnummer 593 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0051> ;
        schema:name "Eindhoven"@nl ;
        schema:pageEnd "146" ;
        schema:pageStart "146" ;
        schema:pagination "146" ;
        schema:text "De voorm. R.K. St.-Antonius van Paduakerk (St.-Antoniusstraat 7) [9], nu streekmuseum, werd in 1917-'18 gebouwd naar plannen van J. van Groenendael. De toepassing van Kunrader steen, een licht gekleurde mergelsteen, bezorgde het gebouw de bijnaam ‘Steentjeskerk’. De vormgeving is gebaseerd op de vroeg-christelijke basiliek St.-Laurentius Buiten de Muren te Rome. Het voorplein wordt geflankeerd door een kostershuis (St.-Antoniusstraat 5) en een pastorie (St.-Antoniusstraat 9), beide uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00594> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eindhoven – Overige kerken"@nl ;
        min:adres "Pastoor Duséeplein 1",
            "Pastoor Van Arsplein 11",
            "Ploegstraat 1",
            "St.-Gerardusplein 25",
            "Stratumseind 32" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eindhoven" ;
        min:gemeenteInBoek "Eindhoven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eindhoven_(gemeente)> ;
