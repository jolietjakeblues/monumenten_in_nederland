        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Best" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Best" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 327 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0023> ;
        schema:name "Best"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De eenvoudiger gedetailleerde kerk zelf heeft een driezijdig gesloten dwarsschip, een vrij lang koor met driezijdige sluiting en een dakruiter op de viering. In de kerk rusten de kruisribgewelven op bundelpijlers met blad- en bloemkapitelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00328> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Best"@nl ;
        min:adres "Hoofdstraat 35",
            "Kerkhofstraat 3-5" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Best" ;
        min:gemeenteInBoek "Best" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Best_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Best" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Best" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71364>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/71365> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "512322",
            "515261" ;
        min:soort "inleiding" ;
        min:volgnummer 328 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill112> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0023> ;
        schema:name "Best"@nl ;
        schema:pageEnd "92" ;
        schema:pageStart "91" ;
        schema:pagination "91-92" ;
        schema:text "De pilaren in de kapellen links en rechts van het koor tonen portretten van bouwpastoor Van de Velde en architect Weber door J.P. van der Mark (1882). Uit de vorige kerk zijn de kruisweg (1850), de preekstoel en de biechtstoel afkomstig. Verder bevat de kerk een hoofdaltaar door J.P. van der Mark (1882), een natuurstenen oksaal (1886), een doopvont (1887) en zijaltaren voor Maria en Odulphus, vervaardigd door H. van der Geld (1889-'90). De transeptschilderingen zijn gemaakt door P. van den Boer (1896) en de gebrandschilderde ramen door L. van Hoek (1948-'49). Het orgel uit 1851-'52 is van J.J. Vollebregt & Zn. De pastorie (Hoofdstraat 35) stamt uit 1856 en werd in 1911 uitgebreid. Het voorm. kostershuis (Kerkhofstraat 3-5) dateert van 1891."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0023.php> .

