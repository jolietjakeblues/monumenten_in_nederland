        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Windmolen ‘De Onderneming’ (Molenaarstraat 1b), ten oosten van het dorp, is een ronde bakstenen beltkorenmolen uit 1888, herbouwd na een brand in 1971."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01345> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schijndel"@nl ;
