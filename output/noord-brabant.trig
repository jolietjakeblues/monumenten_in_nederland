        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0119> ;
        schema:name "Moergestel (gemeente Oisterwijk)"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "256" ;
        schema:pagination "256" ;
        schema:text "Dorp ontstaan op een zandrug ten westen van het riviertje de Reusel en voor het eerst vermeld in 1147. Het kwam mede tot ontwikkeling door de gunstige ligging op het kruispunt van de wegen Tilburg-Eindhoven en Oisterwijk-Hilvarenbeek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01111> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Moergestel (gemeente Oisterwijk)"@nl ;
        min:adres "St.-Jansplein 13" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oisterwijk" ;
        min:gemeenteInBoek "Oisterwijk" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oisterwijk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Moergestel (gemeente Oisterwijk)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Moergestel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1111 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0119> ;
        schema:name "Moergestel (gemeente Oisterwijk)"@nl ;
        schema:pageEnd "256" ;
        schema:pageStart "256" ;
        schema:pagination "256" ;
        schema:text "De R.K. kerk St.-Jan de Doper (St.-Jansplein 13) heeft een toren uit het midden van de 16de eeuw, waartegen een jongere kerk is aangebouwd. De toren, vertegenwoordiger van de Kempische gotiek, vertoont sterke verwantschap met de monumentalere toren van de St.-Petruskerk te Hilvarenbeek. Toren en kerk werden in 1880 door C. Weber gerestaureerd. In 1930-'31 maakte de 16de-eeuwse kerk evenwel plaats voor een kruiskerk met verlaagd dwarsschip naar ontwerp van H.W. Valk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01112> a min:Passage,
