        schema:pageEnd "154" ;
        schema:pageStart "153" ;
        schema:pagination "153-154" ;
        schema:text "Het voorm. raadhuis (Brink 7, Empel-Slot) is een rechthoekig pand met hoog bordes uit omstreeks 1950."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00617> a min:Passage,
