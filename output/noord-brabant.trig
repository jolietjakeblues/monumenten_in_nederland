        min:kern "Eersel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/47511>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/52896> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "14570",
            "14582" ;
        min:soort "inleiding" ;
        min:volgnummer 569 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0049> ;
        schema:name "Eersel"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "De R.K. Lieve Vrouwekapel (Markt 1) is een bakstenen kapel met driezijdige sluiting en dakruiter, in 1464 gesticht door ridder Hendrick van Eyck. De kapel werd in 1654 gerepareerd en in 1660 ingericht tot raadhuis, gevangenis en brandspuithuis. In 1919 vond een ingrijpende restauratie plaats onder leiding van G. Dobbe. Nadat in 1957 het nieuwe raadhuis gereed was, heeft men het gebouw weer als kapel ingericht en opnieuw gerestaureerd. Daarbij herstelde men de oude vensterindeling, maar liet tevens de zandstenen kozijnen uit 1919 in het muurwerk zichtbaar. Het tongewelf, met vijf ribben, stamt uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00570> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Eersel"@nl ;
        min:adres "Markt 38" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Eersel" ;
        min:gemeenteInBoek "Eersel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eersel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
