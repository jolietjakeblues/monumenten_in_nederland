        min:hoofdstuk "Steden, dorpen, monumenten › Waalre" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waalre" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1588 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0187> ;
        schema:name "Waalre"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "Dorp ontstaan in de vroege middeleeuwen op een oeverwal in het stroomgebied van de Dommel. Rondom het driehoekige plein woonden in de 18de eeuw valkeniers en rondreizende kooplieden (teuten). Vanaf 1866 kwam langs de spoorlijn Eindhoven-Hasselt (opgeheven in 1940) lintbebouwing tot ontwikkeling in de richting van het dorp Aalst. Na de Tweede Wereldoorlog groeiden Waalre en Aalst uit tot een tweelingdorp met het karakter van een forensendorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01589> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waalre"@nl ;
        min:adres "Oude Torenstraat 2" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalre" ;
        min:gemeenteInBoek "Waalre" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalre_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waalre" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waalre" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34858> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "38182" ;
        min:soort "inleiding" ;
        min:volgnummer 1589 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0187> ;
        schema:name "Waalre"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "De voorm. R.K. St.-Willibrorduskerk (Oude Torenstraat 2, Waalre), nu gedenkkapel, ontstond in de 11de eeuw als een eenbeukige, tufstenen zaalkerk. In 1425 voegde men een recht gesloten koor toe. Omstreeks 1469 werd het schip verhoogd, van gotische vensters voorzien en met een travee westwaarts verlengd. De toren, met drie geledingen en een ingesnoerde spits, kwam ook in de 15de eeuw tot stand. De toren heeft rijke, van natuursteenblokjes voorziene steunberen en is versierd met spaarvelden en rondboogfriezen. In 1854 verving men het oude koor door een transept en koor in neogotische stijl. Tijdens de restauratie in 1940, onder toezicht van H.W. Valk, werden de resten van het romaanse schip ontdekt en besloot men de romaanse toestand te reconstrueren, met behoud van één 15de-eeuwse, gotische travee. Tevens werden de 19de-eeuwse toevoegingen gesloopt en de fundamenten van het recht gesloten koor tot een meter hoogte opgemetseld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01590> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waalre"@nl ;
        min:adres "Eindhovenseweg 63",
            "Eindhovenseweg 63a" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Waalre" ;
        min:gemeenteInBoek "Waalre" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Waalre_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Waalre" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Waalre" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1590 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill512> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0187> ;
        schema:name "Waalre"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "De R.K. kerk O.L. Vrouwe Presentatie (Eindhovenseweg 63a, Aalst) is een driebeukige neogotische basiliek uit 1905, gebouwd naar plannen van C. Franssen. De toren heeft vier geledingen en een hoge, ingesnoerde naaldspits. In 1934 werd het koor vergroot naar ontwerp van F. Franssen. De pastorie (Eindhovenseweg 63) stamt uit 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01591> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waalre – Kloosters"@nl ;
        min:adres "Dorpsstraat 12-14",
