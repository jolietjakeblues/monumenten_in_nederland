        schema:name "Sint Anthonis"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De voorm. dorpsschool (Brink 11) met drie klassen en onderwijzerswoning werd omstreeks 1883 gebouwd, mogelijk naar ontwerp van J. Buijssen. Het pand is lange tijd als parochiehuis in gebruik geweest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0155.php> .

