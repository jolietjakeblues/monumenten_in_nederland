        min:hoofdstuk "Steden, dorpen, monumenten › Heusden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Heusden" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 922 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0086> ;
        schema:name "Heusden"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "De Geref. kerk. (Gasthuisstraat 3) [2] is een eenvoudige zaalkerk met een gepleisterde voorgevel voorzien van rondboogvensters. Kerkmeester M. van der Mooren legde in 1865 de eerste steen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00923> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heusden"@nl ;
        min:adres "Hertogin Johanna van Brabantstraat 3" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Heusden" ;
        min:gemeenteInBoek "Heusden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heusden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heusden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Heusden" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 923 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0086> ;
        schema:name "Heusden"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "De R.K. St.-Catharinakerk (Hertogin Johanna van Brabantstraat 3) [3] is een basilicale kerk met voorportaal. Een achtkantige toren en een achtkantige doopkapel flankeren haar. De kerk verrees in 1949-'50 in de vormen van de Bossche School, naar plannen van N. van der Laan en W.A.J. Hansen, ter plaatse van een in 1944 verwoeste kerk uit 1840-'41 van H. Swarze."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00924> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heusden"@nl ;
        min:adres "Putterstraat 14-16" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
