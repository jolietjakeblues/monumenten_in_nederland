        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "Windmolen. De gesloten standerdkorenmolen aan de Harry van der Venstraat (ong.) stamt mogelijk uit 1552. Zowel in 1898 als in 1974 werd de molen verplaatst en ingrijpend gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0124.php> .

