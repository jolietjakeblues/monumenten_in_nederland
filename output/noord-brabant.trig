        min:hoofdstuk "Steden, dorpen, monumenten › Ravenstein" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ravenstein" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1268 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0141> ;
        schema:name "Ravenstein"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "De R.K. St.-Josefkapel (St.-Luciastraat 5) werd omstreeks 1875 gebouwd als onderdeel van een klooster ter plaatse. Bij de sloop van dat klooster bleef de kapel gespaard. Omstreeks 1905 kreeg het gebouw een nieuwe gevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01269> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ravenstein"@nl ;
        min:adres "St.-Luciastraat 2-4" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oss" ;
        min:gemeenteInBoek "Ravenstein" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oss_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ravenstein" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Ravenstein" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59511> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32340" ;
        min:soort "inleiding" ;
        min:volgnummer 1269 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0141> ;
        schema:name "Ravenstein"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "280" ;
        schema:pagination "280" ;
        schema:text "Het raadhuis (St.-Luciastraat 2-4) is een omstreeks 1980 uitgevoerde herbouw van de uit 1739 stammende Latijnse school, gesticht door Johan van Willigen. De Latijnse school maakte omstreeks 1900 plaats voor een stadhuis met tekenschool. Achter de huidige voorgevel zouden zich nog resten bevinden van drie 17de-eeuwse huizen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01270> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ravenstein – Pompen"@nl ;
