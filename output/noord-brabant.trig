        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27167>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36896>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60977> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "30818",
            "512456",
            "518010" ;
        min:soort "lemma" ;
        min:volgnummer 1149 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0125> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "260" ;
        schema:pageStart "260" ;
        schema:pagination "260" ;
        schema:text """Woonhuizen. Langs de Berg bevinden zich enkele karakteristieke eenlaagse dwarshuizen, waarvan de weverswoning Berg 40 uit 1763 lange tijd als kosterswoning van de Herv. kerk diende. Het dwarshuis Nuneville (Berg 24) verrees in 1874 in opdracht van dominee Begemann. De villa Papenvoort (Papenvoort 17) uit 1887 gebouwd in chaletstijl. Het Huis met de Bollen (Park 11) uit 1933, met rijke baksteendecoratie, is ontworpen door F. Wolters.

De dorpspomp (Berg ong.) is een eenvoudige gietijzeren pomp uit het einde van de 19de eeuw, gemaakt door ijzergieterij ‘De Prins van Oranje’ te Den Haag."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0125.php> .

