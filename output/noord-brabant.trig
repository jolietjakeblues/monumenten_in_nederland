        min:hoofdstuk "Steden, dorpen, monumenten › Liessel (gemeente Deurne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Liessel" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 1025 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0104> ;
        schema:name "Liessel (gemeente Deurne)"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Langgerekt dorp, ontstaan in de 14de eeuw op een zandrug van de Astense Aa. Naast een kapel verrees in 1516 een blokhuis dat de enige weg door de Peel, van Deurne naar Roermond, tegen de Geldersen verdedigde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01026> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Liessel (gemeente Deurne)"@nl ;
        min:adres "Hoofdstraat 66" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Deurne" ;
        min:gemeenteInBoek "Deurne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Deurne_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Liessel (gemeente Deurne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Liessel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/46906> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "517785" ;
        min:soort "inleiding" ;
        min:volgnummer 1026 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0104> ;
        schema:name "Liessel (gemeente Deurne)"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "De R.K. St.-Willibrorduskerk (Hoofdstraat 66) is een driebeukige neogotische kruisbasiliek uit 1899-1901, gebouwd naar plannen van C. Franssen. De toren van vier geledingen heeft een naaldspits met flankerende torentjes. De rijzige kerk is opgetrokken in baksteen met banden en vensteromlijstingen van gele baksteen. Na oorlogsschade in 1944 werd de kerk hersteld naar plannen van S.J.P. van der Sluijs. Het interieur bevat een neogotisch hoofdaltaar, een St.-Jozef- en een Mariaaltaar, alle door J. Thissen (1903) en twee biechtstoelen door J. Custers (1923). P. Wiegersma maakte de huidige gebrandschilderde ramen (1956-'64)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0104.php> .

