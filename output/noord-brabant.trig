        schema:pageStart "312" ;
        schema:pagination "312" ;
        schema:text "Windmolen Hooihofstraat 12, een gesloten-standerdmolen uit 1811, is in 1910 enkele honderden meters verplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0172.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01480> a min:Passage,
