        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De Herv. kerk (Dorpsstraat 13) is een eenvoudig neoclassicistisch zaalgebouw uit 1809. De monumentale pastorie (Dorpstraat 11) is een herenhuis uit 1867."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01241> a min:Passage,
