        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudenbosch (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oudenbosch" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45723> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "31933" ;
        min:soort "inleiding" ;
        min:volgnummer 1245 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0137> ;
        schema:name "Oudenbosch (gemeente Halderberge)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "De Herv. kerk (Fenkelstraat 24) is een eenvoudige zaalkerk uit 1819; de westgevel kreeg een neoclassicistische deuromlijsting en een dakruiter. De voorm. pastorie (Fenkelstraat 26) is een bakstenen gebouw uit de 17de eeuw, met sierankers in de voorgevel. Een gevelsteen boven de ingang draagt de tekst ‘Ao 1562 RENV 1632’. In de eerste helft van de 19de eeuw kreeg het huis zijn huidige vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01246> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oudenbosch (gemeente Halderberge)"@nl ;
        min:adres "Markt 57" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Halderberge" ;
        min:gemeenteInBoek "Halderberge" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Halderberge> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oudenbosch (gemeente Halderberge)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Oudenbosch" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11709> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "31938" ;
        min:soort "inleiding" ;
        min:volgnummer 1246 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill419> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0137> ;
        schema:name "Oudenbosch (gemeente Halderberge)"@nl ;
        schema:pageEnd "276" ;
        schema:pageStart "275" ;
        schema:pagination "275-276" ;
        schema:text "De R.K.H.H. Agatha en Barbarakerk (Markt 57) is een grote driebeukige kruisbasiliek die in 1865-'80 een parochiekerk ter plaatse van het huidige kerkhof verving. P.J.H. Cuypers maakte het ontwerp naar voorbeeld van de St.-Pieter te Rome. De verhouding tussen de maten van de kerk in Rome en die in Oudenbosch is niet voor alle onderdelen gelijk; zo bedragen de uitwendige lengtes respectievelijk 224 en 81 meter, de uitwendige hoogtes van de vieringkoepels 134 en 63 meter en de doorsnedes van de koepels 42 en 20 meter. De voorgevel heeft men in 1892 onder leiding van G.J. van Swaay opgetrokken naar model van de midden-18de-eeuwse gevel van de St.-Jan van Lateranen in Rome, met kolossale corinthische pilasters en zuilen. De heiligenbeelden op de bekronende balustrade - met als centrale figuur de kruisdragende Salvator Mundi - zijn recente kopieën dan wel vrije interpretaties van de oorspronkelijke beelden, die F. de Vriendt vervaardigde. De Romeinse voorbeelden voor de kerk zijn sterk vereenvoudigd vertaald in baksteen met toepassing van natuursteen en vooral stucwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0137.php> .

