        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Akkerdorp dat in de middeleeuwen met Heeze en Leende tot één heerlijkheid behoorde. Het dorp is van 1798 tot 1915 in bezit geweest van de familie Pompen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0166.php> .

