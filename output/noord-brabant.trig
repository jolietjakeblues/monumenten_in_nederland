        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "23677",
            "38952",
            "521720" ;
        min:soort "inleiding" ;
        min:volgnummer 652 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0058> ;
        schema:name "Fijnaart (gemeente Zevenbergen)"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "De Herv. kerk (Kerkring 1) is een eenbeukig gebouw op T-vormige plattegrond; de westtoren is opgetrokken in 1875 naar ontwerp van C. Blansjaar. Het interieur heeft gestucte plafonds en bevat een preekstoel uit 1674. De kerk ligt op een vierkant kerkhof, omringd door een kerksloot. Het kerkhof telt nog enkele 19de-eeuwse grafstenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0058.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00653> a min:Passage,
            schema:CreativeWork ;
