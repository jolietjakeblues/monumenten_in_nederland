        schema:pageEnd "254" ;
        schema:pageStart "254" ;
        schema:pagination "254" ;
        schema:text "De R.K. St.-Willibrorduskerk (Kerkeind 37) verrees in 1844-'45 op de fundamenten van de in 1425 gestichte St.-Anthoniskapel. Bij de toevoeging van twee zijbeuken in 1963-'64 werd het oude interieur uitgebroken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0116.php> .

