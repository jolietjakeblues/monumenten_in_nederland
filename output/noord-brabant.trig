        min:kern "Roosendaal" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54585> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "32704" ;
        min:soort "inleiding" ;
        min:volgnummer 1312 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0149> ;
        schema:name "Roosendaal"@nl ;
        schema:pageEnd "286" ;
        schema:pageStart "286" ;
        schema:pagination "286" ;
        schema:text "De Herv. kerk (Bloemenmarkt 14) is een neoclassicistische zaalkerk met dakruiter voorzien van lantaarn, gebouwd in 1810 naar ontwerp van H. Huysers. De voorgevel heeft geblokte toscaanse pilasters en een houten hoofdgestel met fronton. De kosterij (Bloemenmarkt 16) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01313> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roosendaal"@nl ;
        min:adres "Kade 21",
            "Kade 23" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
