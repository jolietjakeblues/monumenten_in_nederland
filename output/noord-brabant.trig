        schema:pageStart "263" ;
        schema:pagination "263" ;
        schema:text "Het klooster Nazareth (Koestraat 35-37) is een gebouwencomplex van de zusters franciscanessen met een rondom een carré gebouwd klooster (1924-'26) met kloosterkapel (1910), voorm. internaat (1907-'10), rectorhuis (circa 1925) en voorm. R.K. school voor jongens en meisjes (1907-'09). De verschillende gebouwen kwamen tot stand naar plannen van J.Th.J. Cuypers en J. Stuyt. Het koor van de kapel is markant geplaatst tussen twee flankerende torens in een stijl met neoromaanse invloeden en jugendstil-achtige tegeldecoraties."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0128.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01168> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oirschot"@nl ;
        min:adres "Molenstraat 15",
            "Molenstraat 17-25" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oirschot" ;
        min:gemeenteInBoek "Oirschot" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oirschot_(gemeente)> ;
