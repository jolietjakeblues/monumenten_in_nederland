        schema:name "Oeffelt (gemeente Boxmeer)"@nl ;
        schema:pageEnd "261" ;
        schema:pageStart "261" ;
        schema:pagination "261" ;
        schema:text "Het voorm. raadhuis (Dorpsstraat 18) dateert uit 1954-'56. J. Aarts maakte het ontwerp in traditionele vormgeving, met rijzige trapgevels en een Vlaamse gevel boven de ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01156> a min:Passage,
