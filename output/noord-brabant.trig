        schema:name "Velp (gemeente Grave)"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "319" ;
        schema:pagination "319-320" ;
        schema:text "De R.K. kerk H.H. Vincentius en Antonius van Padua (Tolschestraat 21-21a) is een basilicale kerk met terzijde staande toren, gebouwd in 1937-'38 naar plannen van C.M. van Moorsel en M. van Beek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0180.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01541> a min:Passage,
