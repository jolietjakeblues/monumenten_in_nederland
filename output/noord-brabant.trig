        schema:name "Ommel (gemeente Asten)"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Dorp ontstaan bij een in 1539 gesticht klooster dat uitgroeide tot een belangrijke bedevaartplaats."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0130.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01189> a min:Passage,
