        min:kern "Hedikhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18285> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "22121" ;
        min:soort "inleiding" ;
        min:volgnummer 784 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0077> ;
        schema:name "Hedikhuizen (gemeente Heusden)"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De voorm. Herv. kerk (Hoge Maasdijk 9) ligt ten zuiden van de dorpskom. Het 15de-eeuwse, eenbeukige kerkje met driezijdig gesloten koor dient nu als woonhuis. De 13de-eeuwse, romaanse tufsteentoren werd in 1944 verwoest. Enkele resten hiervan zijn nog in de vernieuwde westmuur verwerkt. Boven de ingang aan de zuidzijde staat het jaartal 1779."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0077.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00785> a min:Passage,
            schema:CreativeWork ;
