        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:lemma "Zijtaart" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1523 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill496> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Zijtaart"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "317" ;
        schema:pagination "317-318" ;
        schema:text "Zijtaart. Dit dorp ten zuiden van Veghel ontstond op een oeverwal van de Aa en wordt al genoemd in 1356. De R.K. St.-Lambertuskerk (Pastoor Clerckstraat 69) is een driebeukige neogotische kerk met toren van drie geledingen en moderne spits, gebouwd in 1871 naar plannen van H.J. van Tulder. De pastorie (Pastoor Clerckstraat 71) stamt uit de bouwtijd. Het St.-Ceciliahuis (Pastoor Clerckstraat 52) is een sober neogotisch klooster, gebouwd in 1901 vermoedelijk naar ontwerp van J. van Groenendael voor de zusters franciscanessen uit Veghel. De neogotische kapel stamt uit 1907."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01524> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel – Mariaheide"@nl ;
        min:adres "Pastoor Van Haarenstraat 38",
            "Pastoor Van Haarenstraat 40-42",
            "Pastoor Van Haarenstraat 44" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Veghel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Veghel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Veghel" ;
        min:lemma "Mariaheide" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1524 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0178> ;
        schema:name "Mariaheide"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "Mariaheide. Straatdorp ten noordoosten van Veghel dat aan het eind van de 18de eeuw tot ontwikkeling kwam. De R.K. kerk O.L. Vrouwe van Goeden Raad (Pastoor Van Haarenstraat 40-42) is een laat-neogotische kruisbasiliek uit 1907-'09, gebouwd naar plannen van J. van Groenendael. De toren en de voorgevel werden pas in 1932 voltooid. De ingangspartij, geflankeerd door een traptoren en een terzijde staande toren, heeft een tegeltableau voorstellende Maria met biddend boerengezin. Uit de bouwtijd dateren ook de kerkinventaris, afkomstig van atelier Van Bokhoven, en de pastorie (Pastoor Van Haarenstraat 38). Het St.-Nicolaashuis (Pastoor Van Haarenstraat 44) is een sober neogotisch klooster, gebouwd in 1912 naar ontwerp van J. van Groenendael voor de zusters franciscanessen uit Veghel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01525> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Veghel – Eerde"@nl ;
        min:adres "Esdonkstraat 2",
            "Esdonkstraat 4" ;
