        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Het raadhuis (Raadhuisplein 16), met bordes en overdekte loggia in Bossche School-trant, kwam in 1939-'40 gereed naar plannen van E. Nijsten en werd in 1976 uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0046.php> .

