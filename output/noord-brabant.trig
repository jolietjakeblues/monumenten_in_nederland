        min:volgnummer 1299 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0147> ;
        schema:name "Rijkevoort (gemeente Boxmeer)"@nl ;
        schema:pageEnd "284" ;
        schema:pageStart "284" ;
        schema:pagination "284" ;
        schema:text "De R.K. St.-Rochuskerk (Mr. Van den Bergplein 8) is een eenbeukige neogotische kerk met westtoren van drie geledingen en achtzijdige lantaarn met spits. Het gebouw verrees in 1887-'88 naar plannen van J. Kayser en verving een 16de-eeuwse kapel. Opvallend zijn de versieringen in verblendsteen en een gootlijst van machinale profielsteen. De kerk werd in 1927 vergroot naar plannen van J. Franssen en in 1955 door J. Strik uitgebreid met zijbeuken en een doopkapel. Omstreeks 1985 heeft men de torenspits vereenvoudigd. De pastorie (Mr. Van den Bergplein 6) stamt uit omstreeks 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0147.php> .

