        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "Dorp ontstaan omstreeks het jaar 1000 als beekdalnederzetting aan de Oude Leij. In de tweede helft van de 19de eeuw kwam er textielindustrie tot ontwikkeling. Vanaf 1960 groeide Goirle uit tot forenzendorp van Tilburg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0069.php> .

