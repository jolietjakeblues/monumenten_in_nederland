        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oosterhout_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Hout (gemeente Oosterhout)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Den Hout" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 502 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0038> ;
        schema:name "Den Hout (gemeente Oosterhout)"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "Dorp ontstaan in de middeleeuwen. De Houtse Heuvel, een grote driehoekige ‘plaatse’, vormt het middelpunt van het dorp. Rondom dit onbestrate en met bomen begroeide plein staat voornamelijk eenvoudige agrarische bebouwing; aan de noordoostzijde bevindt zich de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00503> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Hout (gemeente Oosterhout)"@nl ;
        min:adres "Houtse Heuvel 10",
            "Houtse Heuvel 8" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Oosterhout" ;
        min:gemeenteInBoek "Oosterhout" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oosterhout_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Hout (gemeente Oosterhout)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Den Hout" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 503 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0038> ;
        schema:name "Den Hout (gemeente Oosterhout)"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "De R.K. St.-Corneliuskerk (Houtse Heuvel 10) is een driebeukige neogotische kruisbasiliek met driezijdig gesloten koor; de westtoren heeft een hoge, achtkante spits, gebouwd in 1877-'78 naar ontwerp van P.J. van Genk. De kapellen in het verlengde van de zijbeuken zijn toevoegingen uit 1904. Tijdens een in 1987 voltooide restauratie is de interieurbeschildering met schijnvoegen gereconstrueerd. Tot de overwegend laat-19de- en vroeg-20ste-eeuwse inventaris behoren onder meer een natuurstenen preekstoel (1888) door P. Peeters uit Antwerpen en een op doek geschilderde kruisweg (1883-'89) van de Antwerpenaar F. van Beers. De pastorie (Houtse Heuvel 8) stamt uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0038.php> .

