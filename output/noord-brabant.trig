        min:gemeente "Altena" ;
        min:gemeenteInBoek "Aalburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Altena> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Babyloniënbroek (gemeente Aalburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Babyloniënbroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23044> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "6809" ;
        min:soort "inleiding" ;
        min:volgnummer 198 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0013> ;
        schema:name "Babyloniënbroek (gemeente Aalburg)"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "64" ;
        schema:pagination "64" ;
        schema:text "Het slotje Babyloniënbroek (Broeksestraat 13) is een rechthoekig, onderkelderd eenlaags gebouw met zadeldak tussen tuitgevels. De onderste helft van het gebouw, met de door een tongewelf overkluisde kelder met lampnissen, dateert waarschijnlijk uit de 15de eeuw. Het bovenste deel is later herbouwd en heeft de jaartalankers ‘..09’, waarmee 1609 zal zijn bedoeld. Het interieur herbergt nog een laat-gotische schouw. Het gebouw is in 1975 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0013.php> .

