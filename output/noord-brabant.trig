        min:kern "Sint-Oedenrode" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55848> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "520477" ;
        min:soort "inleiding" ;
        min:volgnummer 1381 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0158> ;
        schema:name "Sint-Oedenrode"@nl ;
        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "Het voorm. post- en telegraafkantoor (Borchmolendijk 5) uit 1910 is een goed voorbeeld van een eenvoudig dorpspostkantoor. De gevels zijn deels gepleisterd. Het materiaalgebruik toont de invloed van jugendstil en chaletstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01382> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Oedenrode – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Meierijstad" ;
        min:gemeenteInBoek "Sint-Oedenrode" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Meierijstad> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sint-Oedenrode" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Sint-Oedenrode" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 1382 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0158> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "296" ;
        schema:pageStart "296" ;
        schema:pagination "296" ;
        schema:text "Woonhuizen. Aan de Markt staan nog enkele huizen met karakteristieke 19de-eeuwse gevels en daarachter mogelijk een oudere kern. Zo heeft het waarschijnlijk 17de-eeuwse pand Markt 8 - de voormalige herberg ‘De Zwaan’ - een gebosseerd gepleisterde lijstgevel uit omstreeks 1830. Ook Markt 10 - het voormalige hotel ‘De Gouden Leeuw’ - heeft een 17de-eeuwse kern. Markt 6 stamt als geheel eveneens uit omstreeks 1830 en heeft een empire-deuromlijsting en empire-vensters met zwikken. Het neoclassicistische herenhuis Markt 2 werd in 1863 gebouwd en in 1881 gekocht als raadhuis, waarna men het oude raadhuis uit 1691 heeft gesloopt. Markt 12 is een diep pand met oude kern, die omstreeks 1875 een nieuwe gevel in eclectische vormen kreeg, afgesloten door een attieklijst om het hoog oprijzende achterliggende dak te verhullen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01383> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Oedenrode – Boerderijen"@nl ;
        min:adres "Nijnselseweg 19" ;
