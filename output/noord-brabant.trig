        schema:name "Beers (gemeente Cuijk)"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Het voorm. raadhuis (Grotestraat 4), een eenvoudig dorpsraadhuis met dakruiter en risaliet met trapgevel, werd gebouwd in 1915 in late-neorenaissance-stijl naar ontwerp van J. Ebben."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0017.php> .

