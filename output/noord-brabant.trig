        schema:pageEnd "321" ;
        schema:pageStart "321" ;
        schema:pagination "321" ;
        schema:text "Verdedigingswerken. Ten oosten van het dorp, bij de veerplaats naar Bergen (Limburg), bevinden zich twee kazematten (bij Staaiweg 25) van de in 1939-'40 aangelegde Maaslinie. Eén kazemat heeft nog een gietstalen koepel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0182.php> .

