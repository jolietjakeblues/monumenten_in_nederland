        schema:name "Sint-Michielsgestel"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "De Herv. kerk (Schijndelseweg 1) is een driezijdig gesloten, gepleisterde zaalkerk met dakruiter uit 1808. De grote pastorie (Petrus Dondersplein 13) stamt uit het begin van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01368> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sint-Michielsgestel"@nl ;
        min:adres "Nieuwstraat 34" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Sint-Michielsgestel" ;
        min:gemeenteInBoek "Sint-Michielsgestel" ;
