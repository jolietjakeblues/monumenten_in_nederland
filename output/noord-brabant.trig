        min:gemeente "Dongen" ;
        min:gemeenteInBoek "Dongen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dongen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dongen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 539 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0044> ;
        schema:name "Dongen"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "De R.K. St.-Laurentiuskerk (Hoge Ham 84), een centraalbouw met in het midden een hoge achtkante koepel met lantaarn. Na brand in 1917 werd in 1920-'21 een nieuwe kerk gebouwd naar ontwerp van J.Th.J. Cuypers. Joan Collette beschilderde in 1923 de koorabsis. Het orgel, afkomstig uit een klooster te Venlo, werd in 1882 gebouwd door W. Rütter. Voor de kerk staat een H. Hartbeeld uit 1922."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00540> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dongen"@nl ;
        min:adres "St.-Josephstraat 116" ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Dongen" ;
        min:gemeenteInBoek "Dongen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dongen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dongen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Dongen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 540 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0044> ;
        schema:name "Dongen"@nl ;
        schema:pageEnd "137" ;
        schema:pageStart "136" ;
        schema:pagination "136-137" ;
        schema:text "De R.K. St. Josephkerk (St.-Josephstraat 116) is een driebeukige neogotische kruiskerk met vijfzijdig gesloten koor, gebouwd in 1906-'07 naar plannen van J. van Groenendael. In 1955-'56 werd het schip verlengd en kreeg de kerk een nieuwe westgevel met achtkantige traptoren naar ontwerp van C. Schellekens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0044.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00541> a min:Passage,
