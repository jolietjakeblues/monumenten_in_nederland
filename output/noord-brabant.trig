        schema:name "Veldhoven"@nl ;
        schema:pageEnd "318" ;
        schema:pageStart "318" ;
        schema:pagination "318" ;
        schema:text "De R.K. St.-Willibrorduskerk (Blaarthemseweg 13, Zeelst) is een driebeukige, neogotische kruisbasiliek uit 1871-'73, gebouwd naar plannen van C. Weber. De westtoren heeft een naaldspits met flankerende torentjes uit 1906, gebouwd naar plannen van J. Stuyt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0179.php> .

