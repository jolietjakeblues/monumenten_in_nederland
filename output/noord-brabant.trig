        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0122> ;
        schema:name "Nieuw-vossemeer (gemeente Steenbergen)"@nl ;
        schema:pageEnd "258" ;
        schema:pageStart "258" ;
        schema:pagination "258" ;
        schema:text "De windmolen ‘Assumburg’ (Veerweg 1), gelegen ten zuiden van het dorp, is een stellingkorenmolen met ronde bakstenen onderbouw en achtkante houten bovenbouw. Hij werd in 1780 in Assendelft (Noord-Holland) als oliemolen gebouwd, in 1897 naar de huidige plek verplaatst en in 1957 hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/01130> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwkuijk (gemeente Heusden)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
