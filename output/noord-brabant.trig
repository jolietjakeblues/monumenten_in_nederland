        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57629> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "12898" ;
        min:soort "inleiding" ;
        min:volgnummer 526 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill175>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill176> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Diessen (gemeente Hilvarenbeek)"@nl ;
        schema:pageEnd "134" ;
        schema:pageStart "134" ;
        schema:pagination "134" ;
        schema:text "De R.K. St.-Willibrorduskerk (Kerksingel 1) is een laat-gotisch gebouw met vroeg-15de-eeuws koor en pseudo-basilicaal schip met transeptachtige dwarskapellen uit omstreeks 1450. De voormalige sacristie aan de zuidzijde van het koor kwam in de eerste helft van de 16de eeuw tot stand. De toren werd waarschijnlijk in 1527 voltooid; tegelijk met de bouw ervan is het schip aan de westzijde met een travee verlengd. De huidige sacristie aan de noordzijde dateert van de kerkrestauratie in 1970-'73."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00527> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diessen (gemeente Hilvarenbeek)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Hilvarenbeek" ;
        min:gemeenteInBoek "Hilvarenbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilvarenbeek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diessen (gemeente Hilvarenbeek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Diessen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 527 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Diessen (gemeente Hilvarenbeek)"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "134" ;
        schema:pagination "134-135" ;
        schema:text "In de eerste helft van de 19de eeuw kreeg de kerk een neoclassicistisch interieur dat men bij de restauratie voor een groot deel weer verwijderde; enkele ornamenten bleven behouden, zoals de draperie van stucwerk boven de triomfboog. De kerk bevat twee barokke, aan St. Sebastiaan en St. Joris gewijde altaren (1744), een rijk gesneden preekstoel (1748), verder een classicistisch hoofdaltaar, twee biechtstoelen en gesneden communie-bank (begin 19de eeuw) en ten slotte een orgel door B.P van Hirtum (1859)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00528> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Diessen (gemeente Hilvarenbeek)"@nl ;
        min:deel "Monumenten in Nederland. Noord-Brabant" ;
        min:gemeente "Hilvarenbeek" ;
        min:gemeenteInBoek "Hilvarenbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Hilvarenbeek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Diessen (gemeente Hilvarenbeek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Diessen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 528 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0042> ;
        schema:name "Diessen (gemeente Hilvarenbeek)"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "De ranke laat-gotische toren telt vijf, door natuurstenen lijsten van elkaar gescheiden geledingen en heeft meermalen versneden, haakse steunberen. De rijk gedetailleerde gevels zijn voorzien van spitsboognissen met flamboyant, zandstenen maaswerk en hebben een zandstenen fries onder de dakrand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0042.php> .

