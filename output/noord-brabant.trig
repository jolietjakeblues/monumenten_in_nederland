        min:kern "Engelen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "inleiding" ;
        min:volgnummer 621 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0053> ;
        schema:name "Engelen (gemeente 's-Hertogenbosch)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De R.K. St.-Lambertuskerk (Graaf van Solmsweg 73) is een eenvoudig zaalgebouw met twee devotiekapellen en een dakruiter, gebouwd in 1933 naar ontwerp van H. de Graaf in traditionele vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0053.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00622> a min:Passage,
