        schema:name "Bokt"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Bokt. Dit gehucht ten noorden van Eindhoven bestaat uit een aantal in een losse structuur gegroepeerde langgevelboerderijen uit de tweede helft van de 19de eeuw, waarvan Bokt 18 en Bokt 20 noemenswaardig zijn, evenals het tegenover Bokt 11 herbouwde bakhuisje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0051.php> .

