        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Budel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Budel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Noord-Brabant" ;
        min:soort "lemma" ;
        min:volgnummer 460 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/afbeelding/sten009monu02ill155> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0031> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "124" ;
        schema:pageStart "123" ;
        schema:pagination "123-124" ;
        schema:text "Woonhuizen. Het dwars geplaatste (Kempische) verdiepingshuis Markt 10-12 heeft een kern die mogelijk tot de 17de eeuw teruggaat. Het grote eenlaagshuis Marktstraat 18 heeft de jaartalankers ‘1660’. In Budel staan enkele (mogelijke) teutenhuizen met inen uitgezwenkte gevels, zoals Nieuwstraat 1, vermoedelijk uit de 18de eeuw, maar vooral Dr. A. Mathijsenstraat 1 met een fraaie gevel uit tweede helft 17de eeuw en opzij een aardige jugendstil-pui uit omstreeks 1914."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/passage/00461> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Budel – Windmolens"@nl ;
