        min:volgnummer 308 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0020> ;
        schema:name "Berghem (gemeente Oss)"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "Het voorm. Zusterklooster (St.-Willibrordusstraat 49) werd in 1883-'84 gebouwd als liefdesgesticht met school, naar plannen van H.C. Dobbe-Van Pelt. Het is nu in gebruik als bejaardentehuis Wilbertshof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0020.php> .

