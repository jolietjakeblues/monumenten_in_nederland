        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Boxtel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Noord-Brabant> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boxtel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01> ;
        min:kern "Boxtel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60169> ;
        min:provincie "Noord-Brabant" ;
        min:rijksmonumentnummer "10051" ;
        min:soort "inleiding" ;
        min:volgnummer 370 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu02_01/hoofdstuk/0029> ;
        schema:name "Boxtel"@nl ;
        schema:pageEnd "98" ;
        schema:pageStart "98" ;
        schema:pagination "98" ;
        schema:text "De Herv. kerk (Clarissenstraat 18) is een langwerpige neoclassicistische zaalkerk met driezijdig gesloten kopse gevels en spitsboogvensters tussen geblokte pilasters. De frontaal voor de toren van de St.-Petruskerk gelegen kerk werd in 1812 gebouwd naar ontwerp van de Boxtelse landmeter Hendrik Verhees. In het interieur staat een 17de-eeuwse preekstoel met een koperen lessenaar uit 1734 door Claude Demeny. Het kerkhof heeft interessante graven, waaronder die van de familie Van Hoogerwou."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu02_01/sten009monu02_01_0029.php> .

