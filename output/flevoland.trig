            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/69712> ;
        min:provincie "Flevoland" ;
        min:rijksmonumentnummer "530932",
            "530933",
            "530934" ;
        min:soort "lemma" ;
        min:volgnummer 204 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill102> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0019> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Scholen. Naar ontwerp van A.E. van Eyck en H.P.D. van Ginkel werden in 1956-'57 drie identieke vierklassige scholen met overblijfruimte gebouwd: de R.K. lagere Titus Brandsmaschool (Ring 1), de Chr. lagere school (Ring 11) en de openbare lagere school (Ring 17). Het wijk-sportgebouw (Ring 19) kwam in 1959 tot stand naar plannen van W. Wissing & H. Hartsuyker."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00205> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nagele (gemeente Noordoostpolder) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nagele (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Nagele" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 205 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0019> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Woonhuizen. De woonhuizen van Nagele zijn nagenoeg allemaal geschakelde eengezinswoningen met platte daken, gegroepeerd om hoven en gebouwd rond 1956. De daarvoor door C. van Eesteren opgestelde plannen werden uitgewerkt door M. Kamerling en A.E. van Eyck. Kenmerkende voorbeelden zijn Vlashof 19-30, Klaverhof 7-12 (beide G.Th. Rietveld en J.C. Rietveld), Koolzaadhof 19-32 (W. van Bodegraven), Karwijhof 1-32 (L. Stam-Beese en E.F. Groosman) en Ring 98-112 (M.A. Stam en E.F. Groosman). Een voorbeeld van een vrijstaande villa is Ploegstraat 15 (1955; G.W.W. Wieringa)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00206> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nagele (gemeente Noordoostpolder) – Winkels"@nl ;
        min:adres "Noorderwinkels 1-7",
            "Ring 86-88",
            "Voorhof 1-2",
            "Zuiderpoort 6-10" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nagele (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Nagele" ;
        min:lemma "Winkels" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 206 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill103>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill104> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0019> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "68" ;
        schema:pagination "68-69" ;
        schema:text """Winkels. De Zuiderwinkels (Ring 86-88) kwamen in 1956 tot stand naar ontwerp van J.H. van den Broek en J.B. Bakema. Deze vier kubusvormige winkels worden wel de ‘Kleine Lijnbaan’ genoemd. Bij de Noorderwinkels (Noorderwinkels 1-7, 2-6), gebouwd rond 1956 naar ontwerp van E.F. Groosman, gaat het telkens om twee eengezinswoningen met aangebouwde verkoopruimten.

De voorm. Coöperatieve boerenleenbank (Zuiderpoort 6-10), gebouwd in 1958 naar ontwerp van E.F. Groosman, bestaat uit een woonhuis en een aangebouwd kantoorgedeelte.

Het café-restaurant ‘Schokkererf’ (Voorhof 1-2) werd in 1961-'62 gebouwd naar ontwerp van J. Dunnebier voor de bierbrouwerij Oranjeboom. Het bestaat uit een laag gedeelte met in midden de iets hoger gemeenschapszaal met een flauw hellend dak, hetgeen afwijkend is voor Nagele.

De Alg. begraafplaats (Akkerstraat ong.) werd in 1956 aangelegd naar plannen van Mien Ruys en E. Hartsuyker en heeft blokvormige hagen van haagbeuk en taxus met daartussen bomen. Op het R.K.-deel staat een kruis afkomstig van de R.K. St.-Isidoruskerk.

Het monument Noordoostpolder (Ketelmeerweg ong.), geplaatst bij de Ketelbrug ten zuidwesten van Nagele, heeft de vorm van een massief bakstenen huis met stalen rookpluim. Het monument is in 1993 ontworpen door F. Bolink en G. Koopman."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00207> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rutten (gemeente Noordoostpolder)"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
