            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76839> ;
        min:provincie "Flevoland" ;
        min:rijksmonumentnummer "35880",
            "515898",
            "515899",
            "515900",
            "515901",
