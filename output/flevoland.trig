        schema:name "Garagebedrijven"@nl ;
        schema:pageEnd "56" ;
        schema:pageStart "56" ;
        schema:pagination "56" ;
        schema:text "Garagebedrijven. De garage met showroom en bovenwoningen Nagelerstraat 1-5 werd in 1952 gebouwd naar ontwerp van Chr. Stoel. Traditionalistischer van vorm is de garage met bovenwoningen Zuiderkade 2-3 (1952) naar plannen van K.G. Olsmeyer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0012.php> .

