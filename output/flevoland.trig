        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill114>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill115> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0023> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "73" ;
        schema:pageStart "72" ;
        schema:pagination "72-73" ;
        schema:text """Scholen. Naar ontwerp van A.C. Kammeijer werden in 1957 drie vrijwel identieke scholen gebouwd met telkens twee lokalen aan weerszijden van een portaal. De Chr. lagere school (Fazantendrift 2) heeft vier klassen en een overblijflokaal, de openbare lagere school (Fazantendrift 4) en de R.K. lagere school (Nimrodstraat 1) hebben vier klassen. Laatstgenoemde heeft ook een speel-werklokaal.

Het Groene Kruisgebouw (Fazantendrift 6) is een eenvoudig eenlaags wijkgebouwtje uit circa 1955."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0023.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00223> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tollebeek (gemeente Noordoostpolder) – Café-restaurant"@nl ;
        min:adres "Fazantendrift 10",
            "St.-Hubertusplaats 8" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tollebeek (gemeente Noordoostpolder)" ;
