        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Biddinghuizen" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 148 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0009> ;
        schema:name "Biddinghuizen (gemeente Dronten)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "Dorp in Oostelijk Flevoland, gesticht in 1961 als A-kern (kleine kern) aan de zuidzijde van de Hoge Vaart. De naam is afgeleid van een in 793 in een oorkonde genoemde villa in dit gebied. Het stedenbouwkundig plan van R. Hajema leidde in 1961 tot een structuurplan (bijgesteld 1963). Aan de noordoostzijde kwam een bescheiden bedrijventerrein tot stand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00149> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biddinghuizen (gemeente Dronten)"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Dronten" ;
        min:gemeenteInBoek "Dronten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dronten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biddinghuizen (gemeente Dronten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Biddinghuizen" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 149 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0009> ;
        schema:name "Biddinghuizen (gemeente Dronten)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "De kern van Biddinghuizen wordt bepaald door een vierkant groen plein (Plein) met op de noordhoek het kerkcentrum en daar tegenover een rij winkels (Baan). Aan de zuidzijde van dit plein verrezen orthogonale woningblokken met daartussen scholen en aan de zuidwestzijde sportvelden. Later is Biddinghuizen uitgebreid met een strook bungalows (Buitenkant) en aan de oostzijde met een ‘niervormige’ woonwijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00150> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biddinghuizen (gemeente Dronten)"@nl ;
        min:adres "Akkerhof 3" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Dronten" ;
        min:gemeenteInBoek "Dronten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dronten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biddinghuizen (gemeente Dronten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Biddinghuizen" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 150 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill62> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0009> ;
        schema:name "Biddinghuizen (gemeente Dronten)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "Het kerkcentrum ‘De Voorhof’ (Akkerhof 3) bestaat uit twee onder een hoek geplaatste moderne zaalkerken met lessenaarsdaken en daartussen lage nevenruimten, alles naar ontwerp van E.M. Fontein. Voor de in 1964 opgetrokken protestantse kerkzaal (Herv. en Geref.) staat een ranke bakstenen toren. Het glas appliquee is van A. van Werven. De katholieke zaalkerk verrees in 1969-'70. De orgels zijn respectievelijk van de Gebr. Van Vulpen (1967) en van de firma Elbertse & Zn. (1980). Voor de kerk staat het door D. van Pallandt vervaardigde standbeeld ‘Vruchtbaarheid van het Nieuwe Land’ (circa 1968)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00151> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biddinghuizen (gemeente Dronten)"@nl ;
        min:adres "Harderdijk 1" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Dronten" ;
        min:gemeenteInBoek "Dronten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dronten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biddinghuizen (gemeente Dronten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Biddinghuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34100> ;
        min:provincie "Flevoland" ;
        min:rijksmonumentnummer "530837" ;
        min:soort "inleiding" ;
        min:volgnummer 151 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0009> ;
        schema:name "Biddinghuizen (gemeente Dronten)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "Het gemaal H.J. Lovink (Harderdijk 1) ligt ten zuidwesten van Biddinghuizen nabij het in 2003 gereedgekomen naviduct ter plaats evan de Hardersluis in de weg naar Harderwijk. Dit in 1956-'57 opgetrokken gebouw met gewapend betonskelet en bakstenen vullingen is een functionalistisch ontwerp van D. Roosenburg, P. Verhave en J.G.E. Luyt. Het elektrische gemaal maalt het water van de Hoge Dwarsvaart in het Veluwemeer met drie door Storkmotoren aangedreven centrifugaalpompen. In de kopgevel zit een keramisch reliëf van J.M. Roosenburg (1956)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00152> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Biddinghuizen (gemeente Dronten)"@nl ;
        min:adres "Spijkweg 51" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Dronten" ;
        min:gemeenteInBoek "Dronten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Dronten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Biddinghuizen (gemeente Dronten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Biddinghuizen" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 152 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0009> ;
        schema:name "Biddinghuizen (gemeente Dronten)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "Het pompstation ‘Bremerberg’ (Spijkweg 51), gelegen ten zuiden van Biddinghuizen, werd rond 1965 gebouwd. Het waterpompstation bestaat onder meer uit twee grote hallen met lange gevels van glas-in-beton."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00153> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Creil (gemeente Noordoostpolder)"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Creil (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Creil" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 153 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0010> ;
        schema:name "Creil (gemeente Noordoostpolder)"@nl ;
        schema:pageEnd "50" ;
        schema:pageStart "50" ;
        schema:pagination "50" ;
        schema:text "Dorp in de Noordoostpolder, gesticht in 1953 ten noorden van de Creilervaart. De naam is afgeleid van een in 1119 vermeld Kreilerbos bij Stavoren. Het stedenbouwkundig plan uit 1952 van Th.G. Verlaan werd in aangepaste vorm in 1953 vastgesteld. Aan de oostrand werd aan de Creilervaart een bescheiden bedrijventerrein met loswal ingericht. De dorpskern van Creil wordt bepaald door een rechthoekig plein (Graaf Florislaan) met aan de oostzijde de R.K. kerk, aan de westzijde de Herv. kerk en aan weerszijden enkele winkels. De Geref. kerk verrees aan het noordeinde van de haaks erop geprojecteerde Galamalaan. Aan het oosteinde van de Graaf Florislaan ligt de begraafplaats; het westelijke uiteinde geeft toegang tot de sportvelden. Aan de zuidzijde van het dorp kwam een groene ‘feestruimte’, die in de winter als ijsbaan dient. De woonhuizen zijn overwegend parallel aan de Galamalaan (zuidwestnoordoost) georiënteerd. Aan de noordoostzijde is het dorp later enigszins uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00154> a min:Passage,
