        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmeloord (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Emmeloord" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 168 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill75> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0012> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "56" ;
        schema:pageStart "55" ;
        schema:pagination "55-56" ;
        schema:text "Woonhuizen. Tot de oudste huizen van Emmeloord behoren de eenlaagse eengezinswoningen Zeeasterstraat 2-36 (1943-'44). De houten woonhuizen Acacialaan 5-13 en Berkenlaan 2-12 zijn door de Nederlandse regering uit Oostenrijk geïmporteerd. Zij waren als tijdelijk bedoeld, maar staan er al sinds 1948. In opdracht van de IJsselcentrale ontwierp W.P.C. Knuttel in 1948 de huizen Plevierenstraat 13-17 en Nagelerstraat 23-27. Aan de Lange Dreef staan drielaagse flats uit 1957 van het type twee-op-één woningen. Voorbeelden van eengezinswoningen uit circa 1950 zijn Lijsterbeslaan 1-31, Meidoornstraat 13-19 en 21-27; grotere varianten hiervan zijn de middenstandswoningen Koningin Julianastraat 1-7 en 21-23. Van de schaarse vrijstaande villa's noemen we Boslaan 23 (1955), ontworpen door L.H.O. Buchta en H.G. Treep, en Boslaan 21 (1961) naar plannen van E. van der Linde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00169> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmeloord (gemeente Noordoostpolder) – Winkels"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
