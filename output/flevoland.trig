        min:kern "Creil" ;
        min:lemma "Kerken" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 154 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill63>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill64> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0010> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "51" ;
        schema:pageStart "50" ;
        schema:pagination "50-51" ;
        schema:text "Kerken. De in 1956 naar ontwerp van C. Schaling gebouwde (Herv.) Ontmoetingskerk (Galamalaan 35) is een zaalkerk voorzien van een terzijde geplaatste toren met klok (firma Concordia) en wijzerplaat. Via de toreningang bereikt men de kerkzaal, die een door W. van Leeuwen gebouwd orgel (1951) bevat. Naast de kerk staat een wijkzaal. De voorm. Geref. kerk (Vrijgemaakt) (Galamalaan 4), gebouwd in 1956 naar plannen van P. van Loo en S. van den Mei, dient nu als woonhuis. De R.K. St.-Nicolaaskerk (Graaf Florislaan 51) is een opvallende vierkante kerk in de vorm van een stolpboerderij. Deze kerk verrees in 1957-'58 naar plannen van J. Hendriks, W. van der Sluys en L. van der Bosch."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0010.php> .

