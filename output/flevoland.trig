        min:hoofdstuk "Steden, dorpen, monumenten › Ens (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Ens" ;
        min:lemma "Scholen" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 176 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill79>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill80> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0013> ;
        schema:name "Scholen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text "Scholen. De Directie van de Wieringermeer ontwierp de drie lagere scholen, waarvan er twee redelijk gaaf bewaard zijn gebleven. De Chr. lagere school (Sportweg 24), nu ‘Het Lichtschip’ genoemd, is een zesklassige gangschool uit 1950. De R.K. lagere school (A. van Bockholtstraat 3) met vijf klassen dateert uit 1953 en werd in 1958 uitgebouwd tot een H-vormige school."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00177> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ens (gemeente Noordoostpolder) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ens (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Ens" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 177 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill81> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0013> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "57" ;
        schema:pageStart "57" ;
        schema:pagination "57" ;
        schema:text "Woonhuizen. De houten woonhuizen Waterkant 73-83 zijn door de Nederlandse regering uit Oostenrijk geïmporteerd. Ze waren als tijdelijk bedoeld, maar staan er al sinds 1948. Voorbeelden van door de Directie van de Wieringermeer ontworpen huizen zijn Schoolstraat 2-32 (1951) en Sportweg 1-27 (1955). De Directie van de Wieringermeer was ook verantwoordelijk voor de drie woon- en winkelpanden Baan 30-36 (1949), elk bestaande uit een woonhuis en een aangebouwde verkoopruimte. J. Dunnebier ontwierp de sobere eengezinswoningen Baanhoek 1-18 (1950-'51)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00178> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ens (gemeente Noordoostpolder) – Café-restaurant"@nl ;
        min:adres "Baan 1" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ens (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Ens" ;
        min:lemma "Café-restaurant" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 178 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0013> ;
        schema:name "Café-restaurant"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "57" ;
        schema:pagination "57-58" ;
        schema:text """Café-restaurant ‘Het wapen van Ens’ (Baan 1) werd rond 1955 ontworpen door L.H.O. Buchta en H.G. Treep en is een traditionalistisch vormgegeven L-vormig pand met tweelaags woongedeelte en een langgerekte gemeenschapszaal. Beelden. Het beeld Welkom op de Zeebodem (Kamperweg ong.) werd rond 1960 geplaatst. De stalen golven geven ongeveer de oorspronkelijke zeespiegel aan. Het beeld De Baanbreker (Waterkant ong.) uit 1989 is gemaakt door S. Roothaan.

De Alg. begraafplaats (Zuidert ong.) werd in 1949 aangelegd naar ontwerp van de Directie van de Wieringermeer en bestaat uit enkele door heggen omheinde grafperken.

De brug over het Ramsdiep (Kamperweg ong.), gelegen ten zuiden van Ens, is een basculebrug uit 1949. De brug is gerenoveerd en verbreed in 1990 en zal op termijn door een naviduct worden vervangen. Bij de brug ligt de balgstuw van Ramspol (Ramsweg ong.), gebouwd in 1996-2002. Van deze waterkering kunnen de drie onder water gelegen delen opgeblazen worden om bij hoogwater en westenwind waterstuwing naar het Zwarte Meer te voorkomen.

De luchtwacht-uitkijktoren (Kamperweg ong.), geplaatst ten zuiden van Ens bij de brug over het Ramsdiep, verrees in 1953 in prefab-beton volgens het Raat-systeem naar een standaardontwerp van architectenbureau M. Zwaagstra. De vrijwel gesloten toren kreeg rond 1980 bij de inrichting tot uitzichttoren een open stalen overkapping."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00179> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Espel (gemeente Noordoostpolder)"@nl ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Espel (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Espel" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 179 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0014> ;
        schema:name "Espel (gemeente Noordoostpolder)"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text "Dorp in de Noordoostpolder, gesticht in 1956 aan een zijtak van de Espelervaart. De naam is afgeleid van de in een oorkonde samen met Urk en Emmeloord vermelde en ten westen van Urk gelegen nederzetting Espel. Het stedenbouwkundig plan uit 1951 van M. Duintjer werd in 1953 vastgesteld. Aan de zuidoostrand langs de zijtak van de Espelervaart (Vaartweg) werd een langgerekt bedrijventerrein met loswal ingericht. De dorpskern van het rechthoekig opgezette Espel wordt bepaald door een T-vormige groene binnenruimte, met aan de noordzijde de R.K. kerk, een protestantse kerk en een dorpswinkel; tot de bouw van de Geref. kerk aan de zuidpunt is het niet gekomen. Aan de zuidzijde van het dorp werden sportvelden en volkstuinen ingericht. Karakteristiek voor Duintjer zijn de enigszins gedraaide bouwblokken aan de westkant van de Bredehof. Aan de zuidwestzijde is Espel later bescheiden uitgebreid (Turbine)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00180> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Espel (gemeente Noordoostpolder) – Kerken"@nl ;
        min:adres "Het Laantje 2-4",
            "Westerrand 42-44" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Espel (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Espel" ;
        min:lemma "Kerken" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 180 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0014> ;
        schema:name "Kerken"@nl ;
        schema:pageEnd "58" ;
        schema:pageStart "58" ;
        schema:pagination "58" ;
        schema:text "Kerken. Het Prot. kerkcentrum ‘Una Sancta’ (Westerrand 42-44) is de eerste kerk in de Noordoostpolder waarin hervormden en gereformeerden vanaf het begin hebben samengewerkt. Deze zaalkerk met wit geschilderde vrijstaande en ronde toren met wijzerplaat kwam in 1961 tot stand naar ontwerp van J. Heese. De wandsculptuur is van H. Optelaak. De kerk bevat een door Ahrend & Brunzema uit Leer (D) gebouwd orgel (1961). Tegen de kerk aangebouwd staan enkele nevenlokalen en een gymnastieklokaal ten bate van de dorpsgemeenschap. De voorm. R.K. kerk Verrijzenis der Heren (Het Laantje 2-4) is een moderne zaalkerk met opvallend lessenaarsdak, gebouwd in 1960-'61 naar ontwerp van J. Strik."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0014.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00181> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Espel (gemeente Noordoostpolder) – Scholen"@nl ;
        min:adres "Het Laantje 6",
            "Westerrand 1-3",
            "Westerrand 38-40" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
