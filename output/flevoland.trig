        min:hoofdstuk "Steden, dorpen, monumenten › Emmeloord (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Emmeloord" ;
        min:lemma "Winkels" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 169 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0012> ;
        schema:name "Winkels"@nl ;
        schema:pageEnd "56" ;
        schema:pageStart "56" ;
        schema:pagination "56" ;
        schema:text "Winkels. Langs de geknikte winkelstraat de Lange Nering begon men in 1952 met de bouw van individueel vormgegeven winkels met bovenwoningen. Interessant is de door F. Klein ontworpen winkel Lange Nering 9 met zijn betonnen omraming. Het naar plannen van J. Jonkman en P. van Dorp gebouwde woon- en winkelpand Lange Nering 14 heeft Franse balkons bij de woningen. Deze in 1972 verkeersvrij gemaakte winkelstraat is later gedeeltelijk overkapt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00170> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmeloord (gemeente Noordoostpolder) – Kantoren"@nl ;
        min:adres "Kon. Julianastraat 37-39",
            "Onder de Toren 2-6" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Emmeloord (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Emmeloord" ;
        min:lemma "Kantoren" ;
        min:provincie "Flevoland" ;
        min:soort "lemma" ;
        min:volgnummer 170 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill76>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill77> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0012> ;
        schema:name "Kantoren"@nl ;
        schema:pageEnd "56" ;
        schema:pageStart "56" ;
        schema:pagination "56" ;
        schema:text "Kantoren. In 1951 gebouwd naar plannen van J. Boelens is het voorm. bijkantoor kantoor van de Centrale Suiker Maatschappij (Onder de Toren 2-6). Het voorm. bijkantoor van de Rotterdamse Bank (Kon. Julianastraat 37-39), uitgevoerd met speklagen en tuitgevels, kwam in 1952-'53 tot stand naar ontwerp van P.H. Dingemans, S. Wouda en B.O. van de Berg. In de twee vrijwel identieke kantoorgebouwen De Deel 21 en 22 [16], opgetrokken in 1956-'57 in betonskeletbouw naar plannen van C. Nap en C.J.P. van Ede, waren de Nederlandse Algemene Keuringsdienst en het Coöperatieve Landbouwhuis gevestigd. In het Landbouwhuis is nu ook de V.V.V. ondergebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0012.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00171> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Emmeloord (gemeente Noordoostpolder) – Bedrijfsgebouwen"@nl ;
        min:adres "De Deel 25",
            "Industrieweg 3-5",
            "Industrieweg 49-51" ;
        min:deel "Monumenten in Nederland. Flevoland" ;
        min:gemeente "Noordoostpolder" ;
        min:gemeenteInBoek "Noordoostpolder" ;
