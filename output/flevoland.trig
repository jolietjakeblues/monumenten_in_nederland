        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Noordoostpolder_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Flevoland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rutten (gemeente Noordoostpolder)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01> ;
        min:kern "Rutten" ;
        min:provincie "Flevoland" ;
        min:soort "inleiding" ;
        min:volgnummer 207 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill105>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/afbeelding/sten009monu12ill106> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/hoofdstuk/0020> ;
        schema:name "Rutten (gemeente Noordoostpolder)"@nl ;
        schema:pageEnd "69" ;
        schema:pageStart "69" ;
        schema:pagination "69" ;
        schema:text "Dorp in de Noordoostpolder, gesticht in 1952 ten noordwesten van de Ruttense Vaart. De naam is afgeleid van het in 1132 vermelde Ruthne, een kerkdorp ten noorden van Urk. Het stedenbouwkundig plan voor het moderne kruiswegdorp is van W. Bruin en werd in 1952 vastgesteld. Op korte afstand ten westen van het dorp werd aan de Meerweg een bescheiden bedrijventerrein met loswal ingericht. De dorpskern van Rutten wordt bepaald door een klein plein op de kruising van de twee doorgaande wegen (Venelaan-Lemsterpoort, Meerweg-Plantsoenweg). Aan het plein bouwde men - met de wijzers van klok mee - de Herv. kerk, een café-restaurant, een dorpswinkel, de Geref. kerk en een school. De katholieke kerk is aan de oostrand gesitueerd en de sportvelden liggen aan de westrand. Dit dorp met T-vormige plattegrond wordt omzoomd door een groene strook en heeft later aan de noordzijde een bescheiden uitbreiding gekregen (De Ruiten)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu12_01/sten009monu12_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu12_01/passage/00208> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rutten (gemeente Noordoostpolder) – Kerken"@nl ;
