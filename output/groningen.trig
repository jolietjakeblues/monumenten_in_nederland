        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham (gemeente Zuidhorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Ham" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 333 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill96> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0021> ;
        schema:name "Den Ham (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Wegdorp, waarschijnlijk ontstaan in de late middeleeuwen en bestaande uit een lintbebouwing langs de weg van Aduard naar Saaksum en de Ds. Koppiusweg. De abdij Aduard bezat hier een kapel, die vanaf de 17de eeuw als Herv. kerk diende. Het dorp heeft zich in de 20ste eeuw iets verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00334> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham (gemeente Zuidhorn)"@nl ;
        min:adres "Ds. Koppiusweg 42" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham (gemeente Zuidhorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Ham" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56042> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "7081" ;
        min:soort "inleiding" ;
        min:volgnummer 334 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0021> ;
        schema:name "Den Ham (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "De Herv. kerk (Ds. Koppiusweg 42) is een gepleisterde, driezijdig gesloten zaalkerk met dakruiter. De huidige kerk kwam in 1729 tot stand met gebruikmaking van muurwerk van een 16de-eeuwse voorganger. De dakruiter en de westgevel werden in 1912 vernieuwd. De kerk heeft rondboogvensters met houten traceringen, waarschijnlijk uit 1912. Tot de inventaris behoren vier oude banken met verhoogde rugleuningen, waarvan één met fraai snijwerk uit omstreeks 1750. De kerkvloer bevat diverse grafzerken, waarvan de oudste waarschijnlijk uit 1576 dateert."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00335> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Ham (gemeente Zuidhorn)"@nl ;
        min:adres "S. Veldstraweg 25" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Ham (gemeente Zuidhorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Ham" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 335 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0021> ;
        schema:name "Den Ham (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "83" ;
        schema:pageStart "82" ;
        schema:pagination "82-83" ;
        schema:text "De borg Piloersema of ‘Hamsterborg’ (S. Veldstraweg 25) ligt op een omgracht rechthoekig terrein, omgeven door een boomsingel. Het deels onderkelderde gebouw heeft een steil zadeldak tussen tuitgevels met nokschoorstenen. Getuige de gedenksteen in de oostgevel werd de borg in 1633 gebouwd voor Johan de Mepsche en Aylke tho Nansum. De noordelijke zijgevel vertoont bouwsporen van 17de-eeuwse vensters. Tegen de zuidgevel staan twee uit het huis afkomstige 17de-eeuwse zandstenen schouwsteunen, versierd met hermen die Geloof en Liefde voorstellen. Pieter Jacobs Bos kocht de borg in 1699 om deze te verbouwen tot boerderij. Hij liet in 1702 tegen de oostgevel een eenlaags vleugel aanbouwen. Die vleugel vormt de verbinding met een grote schuur en een dwarse uitbouw aan de oostzijde uit de 19de eeuw. De hoofdingang heeft bij de drempel de initialen J.W. en D.W. en het jaartal 1870. Het interieur bevat enkele 19de-eeuwse onderdelen, waaronder een gestuct balkenplafond met decoraties."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00336> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Doezum (gemeente Grootegast)"@nl ;
