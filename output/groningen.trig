        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De Apostolische kerk (Stationsstraat 77) is een uit 1918 daterende eenvoudige zaalkerk met iets naar binnen liggende ingang. De kerk heeft soberexpressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0107.php> .

