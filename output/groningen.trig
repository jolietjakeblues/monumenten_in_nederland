        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0011> ;
        schema:name "Bedum"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "De pastorie (Grotestraat 47) verrees in 1857 als eenlaags pand in neoclassicistische trant naar ontwerp van J.F. Scheepers. In 1886 kreeg ze een mezzanino en een hoger opgetrokken middenrisaliet. De kosterswoning (Grotestraat 49) is een diep eenlaags pand met wolfdak uit 1884."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00268> a min:Passage,
            schema:CreativeWork ;
