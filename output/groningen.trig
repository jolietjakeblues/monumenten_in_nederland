        min:volgnummer 1217 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0144> ;
        schema:name "Winsum en Obergum"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De Geref. kerk (Hoofdstraat West 38, Winsum) [3] is een van de straat terugliggende, deels ingebouwde kruiskerk met een voorgevel voorzien van een middenrisaliet. De kerk werd gebouwd omstreeks 1870 in eclectische stijl, naar plannen van A. Schotanus."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0144.php> .

