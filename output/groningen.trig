        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Groningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Groningen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60855> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "485413" ;
        min:soort "inleiding" ;
        min:volgnummer 471 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0038> ;
        schema:name "Groningen"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Het voorm. klooster De Tuin (Akerkhof 22) [10] van de Zusters van Onze Lieve Vrouwe van Amersfoort werd in 1908 gebouwd naar een ontwerp met neogotische elementen van A.Th. van Elmpt. Het interieur is gewijzigd, met uitzondering van de voorm. kapel op de eerste verdieping in de driezijdig gesloten erker."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00472> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Groningen"@nl ;
        min:adres "Folkingestraat 60" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Groningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Groningen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11029> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "18452" ;
        min:soort "inleiding" ;
        min:volgnummer 472 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0038> ;
        schema:name "Groningen"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "De synagoge (Folkingestraat 60) [11] verrees in 1905-'06 ter plaatse van een 18de-eeuwse voorganger. Het kruisvormige, basilicale gebouw werd ontworpen door Tj. Kuipers en Y. van der Veen in een oriëntaliserende stijl met Berlageinvloeden. Boven de voorbouw met drie portalen rijzen twee vierkante torens op, voorzien van een achtkante bovenbouw en een koepel met open lantaarn. Deze koepels en de hoefijzerbogen van de vensters en de arcadebogen in het interieur tonen Spaans-Moorse inspiratie. Boven de ingang is de Hebreeuwse tekst van Deuteronomium 28:6 met het bouwjaar (5)666 (=1906) aangebracht; de tracering van het grote roosvenster heeft de vorm van een Davidster. In 1942 werd de synagoge gesloten, maar sinds de restauratie in 1980-'81 is ze weer als zodanig en als expositieruimte in gebruik. Het interieur heeft houten tongewelven. Aan de zijkanten zijn gaanderijen met balkons bestemd voor de vrouwen. Uit de bouwtijd dateren nog de gebrandschilderde glazen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00473> a min:Passage,
