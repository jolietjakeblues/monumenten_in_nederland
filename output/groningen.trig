        schema:name "Pieterburen (gemeente De Marne)"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "De Geref. kerk (Hoofdstraat 159) is een recht gesloten zaalkerk met bij de voorgevel een kleine dakruiter. De kerk is gebouwd in 1873 in eclectische stijl. De pastorie (Hoofdstraat 161) met omgaand schilddak stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0102.php> .

