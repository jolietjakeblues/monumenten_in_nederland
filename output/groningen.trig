        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0109> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "Poldermolen ‘De Eendracht’ (bij Provincialeweg 7) is een met riet gedekte achtkante, bovenkruier op veldmuren, voorzien van twee vijzels. De molen werd gebouwd in 1887 naar plannen van J. Klippius ter vervanging van een afgebrande molen uit 1801."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00939> a min:Passage,
