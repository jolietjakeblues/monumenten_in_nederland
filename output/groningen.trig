        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "Woonhuizen. Langs de Torenstraat staan verschillende 18de-eeuwse eenlaags woonhuizen, zoals de nummers 2, 4, 5, 6, 36 en 38. Allersmaweg 2 en Allersmaweg 6 zijn eenlaags rentenierswoningen uit het derde kwart van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0026.php> .

