        min:volgnummer 790 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0085> ;
        schema:name "Noordbroek (gemeente Menterwolde)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De Doopsgez. kerk (Hoofdstraat 80) is een eenvoudige, door pilasters gelede en recht gesloten zaalkerk met schilddak. Boven de omlijste classicistische ingang staat het stichtingsjaar 1811. De pastorie (Hoofdstraat 82), eveneens met omlijste ingang, stamt uit het midden van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00791> a min:Passage,
