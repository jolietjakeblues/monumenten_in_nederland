        schema:name "Midwolde (gemeente Leek)"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text "Van de landarbeiderswoningen in het dorp is Pasop 13 uit omstreeks 1880 een nog vrij gaaf voorbeeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0072.php> .

