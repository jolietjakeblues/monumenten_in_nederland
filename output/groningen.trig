        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 808 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Noordlaren (gemeente Haren)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Tot de kerkinventaris behoren een preekstoel met getorste zuiltjes en klankbord (1675) en een door P. van Oeckelen gebouwd orgel (1876). De kerkvloer bevat een grafzerk voor Albert Levinghe (†1639). In het catechisatielokaal hangen veertien portretten van de familie De Sitter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00809> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordlaren (gemeente Haren)"@nl ;
        min:adres "Lageweg 10" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 809 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Noordlaren (gemeente Haren)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Op het ommuurde kerkhof liggen onder meer de 19de-eeuwse grafstenen van de familie De Sitter en de grafkelder van Van Swinderen. De pastorie (Lageweg 10) is een blokvormig neoclassicistisch pand uit 1861."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00810> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordlaren (gemeente Haren)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 810 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Noordlaren (gemeente Haren)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Het woonhuis Lageweg 45 is een goed voorbeeld van een uit omstreeks 1870 stammende woning in eclectische vormen met wenkbrauwen boven de ramen en op de verdieping een serlianavenster."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00811> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordlaren (gemeente Haren) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 811 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill256> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Boerderijen. In en nabij het dorp ligt een aantal interessante boerderijen. Zuinigstraatje 2 is een boerderij van het hallenhuistype met dwarsdeel en naar achteren liggende baander. De boerderij zou nog 17de-eeuwse delen bevatten. Eveneens van het hallenhuistype zijn de mogelijk laat-18de-eeuwse keuterij Zuidlaarderweg 59, waarvan de deeldeur later door een huisdeur is vervangen, en Lageweg 39 uit de 19de eeuw met een middenlangsdeel. Waarschijnlijk midden-19de-eeuws is Lageweg 51. Gorechts van karakter is de eenvoudige 19de-eeuwse boerderij Zuidlaarderweg 46, met schuurgedeelte en baander aan de voorzijde en voorzien van een houten voorschot. Verwant aan het Oldambster type zijn Kerkstraat 5, met twee zaadzoldervensters en een wolfeind, maar met de ingang opzij, en Lageweg 14 met drie zaadzoldervensters, wolfeind en middenvoor een omlijste ingang. Uit omstreeks 1880 stammen de boerderijen Lageweg 37 en Zuidlaarderweg 61, beide met een eclectisch vormgegeven dwars voorhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00812> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordlaren (gemeente Haren) – Windmolen"@nl ;
        min:adres "Zuidlaarderweg 73" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:lemma "Windmolen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 812 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill257> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "176" ;
        schema:pageStart "175" ;
        schema:pagination "175-176" ;
        schema:text """Windmolen. De achtkante stellingkorenmolen ‘De Korenschoof’ (bij Zuidlaarderweg 73) heeft een met hout beklede romp op bakstenen voet. De molen werd in 1849 gebouwd voor R. Klinkhamer door molenmaker H. Seubring. De molen is oorspronkelijk als barkmolen gebouwd en werd vóór 1888 in een korenmolen veranderd. Hij is in 1972-'73 gerestaureerd.

Van het hunebed ten westen van Noordlaren (Zuidlaarderweg ong.) is het noordwestelijke deel bewaard gebleven, bestaande uit twee dekstenen, rustende op twee paar draagstenen en een sluitsteen. Het werd rond 2500 voor Christus gebouwd door mensen van de Trechterbekercultuur. Vóór 1769 is de rest van het hunebed gesloopt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00813> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordlaren (gemeente Haren) – Landgoed De Poll"@nl ;
        min:adres "Pollselaan 5",
            "Pollseweg 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Haren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordlaren (gemeente Haren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordlaren" ;
        min:lemma "Landgoed De Poll" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 813 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0088> ;
        schema:name "Landgoed De Poll"@nl ;
        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "Landgoed De Poll (Pollselaan 5), gelegen ten westen van Noordlaren nabij het dal van de Drentse A, werd in 1814 gesticht. In 1893 werd het bezit van de bankier J.H. Geertsema, die er in 1913 door G. Nijhuis een gepleisterde villa met chalet-elementen voor liet ontwerpen. Bij de villa hoort een tuinmanswoning (Pollseweg 3) uit dezelfde tijd. De villa is nu het clubhuis van een op het landgoed aangelegde golfbaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00814> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nuis (gemeente Marum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Marum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nuis (gemeente Marum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Nuis" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 814 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0089> ;
        schema:name "Nuis (gemeente Marum)"@nl ;
        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen. Het dorp heeft zich voornamelijk ontwikkeld langs de Oude en Nieuweweg. Aan de Nieuweweg staat de middeleeuwse dorpskerk. In de 20ste eeuw heeft de bebouwing ten zuiden van de kerk zich enigszins verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00815> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nuis (gemeente Marum)"@nl ;
        min:adres "Nieuweweg 29" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Marum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nuis (gemeente Marum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Nuis" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57228> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "28294" ;
        min:soort "inleiding" ;
        min:volgnummer 815 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0089> ;
        schema:name "Nuis (gemeente Marum)"@nl ;
        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "De Herv. kerk (Nieuweweg 29) is een kleine eenbeukige kerk met recht gesloten koor en dakruiter. De kerk dateert uit de eerste helft van de 13de eeuw en heeft een vrij gave romaanse topgevel met siermetselwerk. In 1902 werd de westgevel vernieuwd en voorzien van een portaal en een dakruiter. Tot de kerkinventaris behoren een preekstoel (laat-18de-eeuws) en een avondmaalstafel in Lodewijk XVI-vormen. De kerkvloer bevat diverse zerken, waaronder die met maniëristische omlijsting voor Himme Wincken-Auwema (†1623). Op het kerkhof bevinden zich 19de-eeuwse zerken en een baarhuisje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00816> a min:Passage,
            schema:CreativeWork ;
