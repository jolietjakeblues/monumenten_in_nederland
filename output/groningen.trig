        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "Woonhuizen. De neoclassicistische villa Stadsweg 36 dateert uit omstreeks 1890. Uit dezelfde tijd stammen Stadsweg 29-35, vier arbeiderswoningen met krimpen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01234> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wirdum (gemeente Loppersum) – Boerderijen"@nl ;
        min:adres "Rijksweg 41",
            "Rijksweg 43",
            "Stadsweg 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wirdum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wirdum" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1234 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill365> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0145> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "235" ;
        schema:pagination "235-236" ;
        schema:text """Boerderijen. De boerderij Wirdumerweg 1 is van het kop-romp-type. Het lange voorhuis heeft de jaartalankers ‘1807’. Rijksweg 31 is een grote boerderij van het Oldambtster type uit 1855. De uit omstreeks 1879 daterende Sybellema Heerd (Stadsweg 2) is een boerderij met dwars voorhuis.

De voorm. steenfabriek ‘Rusthoven’ (Rijksweg 43) werd in 1804 gesticht en in 1965 gesloten. In 1924 werd de fabriek gekocht door B. van der Veen, die het complex liet uitbreiden met onder meer nieuwe droogloodsen. In 1943 werd een nieuwe ringoven gebouwd. De dienstwoning (Rijksweg 41) stamt uit 1924."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01235> a min:Passage,
            schema:CreativeWork ;
