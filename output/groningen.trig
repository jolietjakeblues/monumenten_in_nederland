        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "De voorm. Geref. kerk (Hoofdweg 130) is een eenvoudige zaalkerk met geveltoren en uitgebouwd ingangsportaal, gebouwd in 1918."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00286> a min:Passage,
