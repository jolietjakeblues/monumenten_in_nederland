        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Huis Welgelegen (Bloemersmastraat 2), in neo-classicistische trant, dateert uit het derde kwart van de 19de eeuw en heeft mogelijk als Herv. pastorie gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0077.php> .

