        min:kern "Oosternieland" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 846 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0094> ;
        schema:name "Oosternieland (gemeente Eemsmond)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De pastorie (Oosternielandsterweg 8-10) met een erachter liggende schuur dateert uit omstreeks 1830. In de fundering van de schuur zijn kloostermoppen hergebruikt, die mogelijk afkomstig zijn van de in 1822 gesloopte kerktoren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0094.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00847> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterwijtwerd (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Oosterwijtwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 847 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0095> ;
        schema:name "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "Wierdedorp met een radiale structuur, ontstaan in de vroege middeleeuwen op een kwelderwal langs de Fivelboezem. In de late middeleeuwen kreeg het dorp via de Godlinzermaar een verbinding met het Damsterdiep. De middeleeuwse borg Ripperda werd rond 1750 afgebroken. In het begin van de 20ste eeuw heeft men de wierde gedeeltelijk afgegraven en kwam er enige nieuwbouw tot stand langs de Damsterweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00848> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        min:adres "Dorpstraat 29" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterwijtwerd (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Oosterwijtwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 848 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0095> ;
        schema:name "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        schema:pageEnd "180" ;
        schema:pageStart "180" ;
        schema:pagination "180" ;
        schema:text "De Herv. kerk (Dorpstraat 29), oorspronkelijk gewijd aan Maria, is een kleine eenbeukige kerk met smaller, halfrond gesloten koor en een dakruiter. De kerk is een van de eerste geheel bakstenen kerken in Groningen en stamt uit circa 1237 (d). De gevel aan de noordzijde wordt nog geleed door een spaarveld met twee romaanse vensters. In de vroege 16de eeuw heeft men de schipmuren wat verlaagd en zijn onder de sporenkap uit de bouwtijd jukken geplaatst. Toen is ook een nieuwe balkenzoldering aangebracht. De vensters zijn vergroot in de 17de eeuw; de dakruiter zal uit het midden van die eeuw stammen. In 1812 werden de balken hersteld en in 1855 de vloer aan de onderzijde van de balken aangebracht. De kerk is in 1925 en in 1985 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00849> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oosterwijtwerd (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Oosterwijtwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 849 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill267> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0095> ;
        schema:name "Oosterwijtwerd (gemeente Loppersum)"@nl ;
        schema:pageEnd "181" ;
        schema:pageStart "180" ;
        schema:pagination "180-181" ;
        schema:text "Tot de kerkinventaris behoren een preekstoel uit 1666 en uit dezelfde tijd een overhuifde herenbank met gesneden opzetstuk met de wapens van Ripperda-Ripperda en een eenvoudige avondmaalstafel. Naast het doophek staan twee ouderlingenbanken. Uit de 19de eeuw dateren het koperen doopbekken (1836), de koperen kroon (1837), geschonken door timmerman H.H. Dam, wiens grafzerk op het kerkhof ligt, en het als koorafscheiding dienende balusterhek (1855). Het mechanische torenuurwerk uit 1681 staat opgesteld in het koor. Het orgel werd in 1744 door Christiaan Müller gebouwd als huisorgel en in 1895 door J. Doornbos verbouwd en van een nieuwe kast voorzien. De kerkvloer bevat diverse zerken, waarvan de oudste uit 1628 dateert. In de koorsluiting hangt een rijk bewerkte zandstenen epitaaf voor Gijsbert Herman Ripperda (†1695), geflankeerd door rouwborden voor Carel Victor Ripperda (†1686), Elisabeth Sophia Ripperda (†1695) en Margaretha Elisabeth Ripperda (†1719)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0095.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00850> a min:Passage,
            schema:CreativeWork ;
