        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoogkerk (gemeente Groningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hoogkerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41168> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "18750" ;
        min:soort "inleiding" ;
        min:volgnummer 564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0046> ;
        schema:name "Hoogkerk (gemeente Groningen)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "Het voorm. raadhuis (Hoendiep 210), gebouwd rond 1880 in neorenaissance-vormen, heeft aan de rechterzijde een uitbreiding uit 1903 met jugendstilinvloeden. Boven de ingang is het opschrift ‘Gemeentehuis 1903’ aangebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00565> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogkerk (gemeente Groningen) – Woonhuizen"@nl ;
        min:adres "Halmstraat 1",
            "Halmstraat 14-20",
            "Halmstraat 22",
            "Halmstraat 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoogkerk (gemeente Groningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hoogkerk" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 565 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0046> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text """Woonhuizen. Zowel bij de coöperatieve strokartonfabriek ‘De Halm’ als bij de CSM-suikerfabriek zijn in het begin van de 20ste eeuw woonwijken voor het personeel gebouwd, opgezet volgens de tuindorp-gedachte. Het stedenbouwkundige plan voor de Halmbuurt werd in 1914-'15 geleverd door G. en W. Wierenga, in opdracht van de strokartonfabriek en in samenwerking met de ‘Vereniging tot Verbetering der Volkshuisvesting’. Voor het hoger personeel kwamen in 1915-'16 naar ontwerpen van de gebroeders Wierenga een directeursvilla (Halmstraat 1), een woning voor de bedrijfsleider (Halmstraat 22) en twee dubbele opzichterswoningen (Halmstraat 14-20) tot stand. De arbeiderswoningen aan de Schoenerstraat, de Zuidersingel en de Middenweg werden gebouwd naar ontwerpen van C.H. Eldering, J.S. Huizingh, K. Siekman en de gebroeders Wierenga. Het plan voor de Suikerbuurt dateert uit 1919-'20 en is van K. Siekman. Vanaf het Koningsplein is een stervormig stratenpatroon gevormd. De woningen hebben een landelijk karakter.

De voorm. coöperatieve stokartonfabriek ‘De Halm’ (Halmstraat 3) is in 1913-'14 gebouwd naar ontwerp van G. en W. Wierenga. De fabriekshal en het kantoorgebouw zijn nog aanwezig.

De boerderij Kerkstraat 78 dateert uit omstreeks 1870. Het voorhuis van deze boerderij met dwarsgeplaatst voorhuis heeft een schilddak en opvallende deuren vensteromlijstingen die van een grote kuif zijn voorzien."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0046.php> .

