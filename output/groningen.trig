        min:volgnummer 1241 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0147> ;
        schema:name "Woldendorp (gemeente Delfzijl)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "Het voorm. raadhuis van de gemeente Termunten (A.E. Gorterweg 1) is een fors pand met schilddak, gebouwd in 1946-'47. Op de gevel staat de spreuk: ‘Beschaduwd is de vreugd bij 't helen mijner wonden, om hen die na 't geweld niet wederopgaan konden’. Sinds 1990 is het pand in gebruik als hotel-restaurant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woltersum (gemeente Ten Boer)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woltersum (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Woltersum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1242 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0148> ;
        schema:name "Woltersum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "Wierdedorp met radiale structuur, ontstaan in de vroege middeleeuwen. In de 19de eeuw kwam de huidige lintbebouwing langs de Lustige Maar tot ontwikkeling. Direct ten zuiden van het dorp werd in 1870-'76 het Eemskanaal gegraven. Met verbreding daarvan in 1961-'65 verdwenen de brug en de verbinding naar het zuiden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woltersum (gemeente Ten Boer)"@nl ;
        min:adres "Kerkpad 4" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woltersum (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Woltersum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12681> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "9798" ;
        min:soort "inleiding" ;
        min:volgnummer 1243 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill367> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0148> ;
        schema:name "Woltersum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "236" ;
        schema:pagination "236-237" ;
        schema:text "De Herv. kerk (Kerkpad 4) is een door lisenen gelede zaalkerk met recht gesloten koor en een toren met achtkante bakstenen lantaarn en naaldspits. Het westelijke deel van de kerk stamt uit 1765, toen de middeleeuwse kerk werd vervangen. Het oostelijke deel inclusief de toren verrees in 1837-'38 naar plannen van de timmerman P. Kuipers. Tot de kerkinventaris behoren een met afbeeldingen van de Geseling van Christus en Ecco Homo beschilderde preekstoel (16de eeuw), vier herenbanken met gesneden bekroningen (18de eeuw) en een door de gebroeders Van Oeckelen gebouwd orgel (midden 19de eeuw). Verder bevat de kerk een memoriesteen voor Johan van Welveldt (†1634) en een zerk voor Ella Catharina van Bolhuis (†1769)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01244> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woltersum (gemeente Ten Boer)"@nl ;
        min:adres "Kollerijweg 5" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woltersum (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Woltersum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53244> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "9799" ;
        min:soort "inleiding" ;
        min:volgnummer 1244 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0148> ;
        schema:name "Woltersum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De windmolen ‘Fram’ (Kollerijweg 5) is een achtkante stellingmolen op houten tussenstuk en houten schuur. Deze houtzaagmolen werd in 1867 gebouwd voor W.E. Evenhuis en bevat zowel een koppel maalstenen als drie zaagramen; vroeger had hij ook nog twee pelstenen. De zaagschuur heeft aan de kant van de Woltersummer Ee een opsleep. De molen is in 1961 en in 1979 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01245> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1245 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Zandeweer (gemeente Eemsmond)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een zandwal. Tot 1850 was er voornamelijk bebouwing langs de Hoofdstraat en de Poelweg. Daarna werd het dorp vooral uitgebreid langs de Veilingweg en de Molenhorn en ontwikkelde Zandeweer zich tot tuinbouwdorp. De glastuinbouw is nog steeds in het dorp aanwezig."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01246> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond)"@nl ;
        min:adres "Hoofdstraat 7" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1246 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill368>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill369> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Zandeweer (gemeente Eemsmond)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De Herv. kerk (Hoofdstraat 7) is een eenbeukige kerk met halfronde sluiting en een vrijstaande toren. De grotendeels 13de-eeuwse kerk is vermoedelijk in de eerste helft van de 16de eeuw met een travee naar het westen uitgebreid. De schipmuren zijn met lisenen geleed en hebben spitsboogvensters. Onder de dakvoet zitten een lijst van siermetselwerk en een rondboogfries. In de koorsluiting bevinden zich enkele spaarvelden met rondbogen. De kerk is in 1931-'32 gerestaureerd naar plannen van A.R. Wittop Koning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01247> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1247 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Zandeweer (gemeente Eemsmond)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "Het interieur is deels met meloenvormige koepelgewelven met vier ronde ribben en deels met kruisribgewelven overdekt. Tot de inventaris behoren twee herenbanken met opzetstukken voorzien van de wapens van de families Clant, Lewe, Coenders en Ompteda (1679), een preekstoel (derde kwart 18de eeuw) en een doophek (1793). Het orgel is in 1731 door A.A. Hinsz gebouwd. Het snijwerk aan de kast en de balustrade met bekroning wordt toegeschreven aan Casper Struiwig. De kerkvloer bevat diverse 17de- en 18de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01248> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond)"@nl ;
        min:adres "Hoofdstraat 5" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37594> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23471" ;
        min:soort "inleiding" ;
        min:volgnummer 1248 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Zandeweer (gemeente Eemsmond)"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text "De vrijstaande toren (Hoofdstraat 5) ten zuidwesten van de kerk stamt uit de 15de eeuw. De sobere, ongelede toren heeft een zadeldak tussen topgevels met spaarvelden. Een topgevel en een kleine dakkapel zijn voorzien van wijzerplaten. Op de nok staat een deels opengewerkte, ranke dakruiter. In de toren hangen twee klokken, de ene uit 1354 en de andere uit 1463."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01249> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond) – Woonhuizen"@nl ;
        min:adres "Molenhorn 17" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60449> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23454" ;
        min:soort "lemma" ;
        min:volgnummer 1249 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "237" ;
        schema:pageStart "237" ;
        schema:pagination "237" ;
        schema:text """Woonhuizen. Aan de Hoofdstraat staan voornamelijk eenvoudige 18de- en 19de-eeuwse dwarse eenlaags panden, met al dan niet afgewolfde zadeldaken. Voorbeelden zijn Hoofdstraat 17 met de jaartalankers ‘1788’, Hoofdstraat 14 met een kleine jaartalsteen ‘1805’ in de zijgevel, en Hoofdstraat 24 met zadeldak tussen topgevels met vlechtingen, maar ook Hoofdstraat 3, 16, 18 en 19, het laatste met aangebouwde schuur.

De windmolen ‘Windlust’ (Molenhorn 17) is een met riet gedekte achtkante stellingkorenmolen met bakstenen onderbouw. Hij werd in 1818 gebouwd als grondmolen en in 1886 verhoogd en van een stelling voorzien. De molen is in 1975-'76 gerestaureerd.

Het hoogholtje over de Uithuizermeedstermaar (Meedstermaarpad ong.), gelegen ten noorden van Zandeweer, dateert uit 1936 en wordt ook wel het ‘Zandeweersterbalkje’ genoemd. Meestal werd dit type bruggen uitgevoerd in hout; deze is echter van gewapend beton met een ijzeren reling."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01250> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond) – Doodstil"@nl ;
        min:adres "Doodstilsterweg 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:lemma "Doodstil" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15906> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23469" ;
        min:soort "lemma" ;
        min:volgnummer 1250 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Doodstil"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "237" ;
        schema:pagination "237-238" ;
        schema:text "Doodstil. Dit gehucht ten noordwesten van Zandeweer is ontstaan bij een brug (til) over het Boterdiep: de til van Doede of Dode is verbasterd tot Doodstil. De lintbebouwing is in de loop van de 19de eeuw verder tot ontwikkeling gekomen. De kop-hals-romp-boerderij ‘Langenhuis’ (Doodstilsterweg 3) heeft een zeer lang, deels onderkelderd voorhuis met een zadeldak tussen topgevels. Het voorhuis is diverse keren verbouwd. De oostgevel heeft een gevelsteen met wapenschild van een verbouwing in 1624. Het tussenlid en de huidige zuidmuur zijn in 1855 tot stand gekomen. De grote schuur dateert uit 1814, de kleine uit omstreeks 1855. De losstaande schuur met opvallend hoog dak stamt uit 1925. De grote gepleisterde villa Barmerweg 1 is in 1916 gebouwd op een vrije plattegrond met een tot hoektoren verhoogde erker. Het pand vertoont jugendstil-invloeden, zoals het afwisselen van pleisterwerk met diverse kleuren baksteen. Rechts naast de villa is een dubbele garage gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01251> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zandeweer (gemeente Eemsmond) – Eppenhuizen"@nl ;
        min:adres "Eppenhuizerweg 15",
            "Eppenhuizerweg 6" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zandeweer (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zandeweer" ;
        min:lemma "Eppenhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28146> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23460" ;
        min:soort "lemma" ;
        min:volgnummer 1251 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0149> ;
        schema:name "Eppenhuizen"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text """Eppenhuizen. Dit wierdedorp ten zuidoosten van Zandeweer is ontstaan in de middeleeuwen en heeft een lintbebouwing langs de Eppenhuizerweg.

De Herv. kerk (Eppenhuizerweg 6) is een eenvoudige zaalkerk met driezijdige koorsluiting, zadeldak en dakruiter. De kerk is volgens een gedenksteen in 1882 gebouwd ter vervanging van een oudere kerk. De voorgevel heeft gepleisterde elementen en een omlijste ingang. De rondboogvensters van het front en de spitsboogvensters van het schip zijn voorzien van een gietijzeren roedenverdeling. De trap naar de kerk bestaat uit enkele grafzerken, waaronder één uit 1692. De kop-hals-romp-boerderij ‘Leliënhof’ (Eppenhuizerweg 15) dateert uit 1913-'15. Het eenlaags voorhuis heeft een afgeknot schilddak en links tegen de voorgevel een driezijdige erker met balkon en een verhoogd geveldeel met onder meer het wapen van de familie Elema. Achter het voorhuis liggen twee grote schuren."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01252> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "'t Zandt (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Eemsdelta" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eemsdelta> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › 't Zandt (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "'t Zandt" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1252 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0150> ;
        schema:name "'t Zandt (gemeente Loppersum)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Dijkdorp, ontstaan in de middeleeuwen langs twee dijken in de Fivelboezem. Een oost-west lopende dijk, die tussen 1192 en 1249 is aangelegd, werd later veranderd in de Molenweg; de haaks daarop gelegen dijk uit 1249 werd de Hoofdstraat. Het dorp ontwikkelde zich hoofdzakelijk langs deze wegen en langs de Oosterstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01253> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "'t Zandt (gemeente Loppersum)"@nl ;
        min:adres "Hoofdstraat 41" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Eemsdelta" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eemsdelta> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › 't Zandt (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "'t Zandt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36912> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "40295" ;
        min:soort "inleiding" ;
        min:volgnummer 1253 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0150> ;
        schema:name "'t Zandt (gemeente Loppersum)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "De Herv. kerk (Hoofdstraat 41), oorspronkelijk gewijd aan Maria, is een eenbeukige kerk met driezijdig gesloten koor en een vrijstaande toren. Het romano-gotische schip dateert uit het derde kwart van de 13de eeuw. Het muurwerk heeft in de benedenzone spaarvelden afgedekt met een rondboogfries en daarboven rondboogvensters en -nissen met kraalprofielen en siermetselwerk. Het hoger opgetrokken gotische koor met de hoge spitsboogvensters dateert uit de 15de eeuw. De kerk is in 1962-'67 gerestaureerd naar plannen van R. Offringa."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01254> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "'t Zandt (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Eemsdelta" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eemsdelta> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › 't Zandt (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "'t Zandt" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1254 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0150> ;
        schema:name "'t Zandt (gemeente Loppersum)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "Het schip wordt inwendig overdekt door meloenvormige koepelgewelven met elk acht ronde ribben; het koor heeft een vierdelig en een zesdelig kruisribgewelf. Zowel op de gewelven als op de muren zijn beschilderingen uit diverse periodes, waaronder de romano-gotische, bewaard gebleven. Er zijn afbeeldingen van heiligen en het Laatste Oordeel en 15de-eeuwse schilderingen op de koorgewelven van onder meer de symbolen van de evangelisten en Christus als Man van Smarten. Tot de inventaris behoren een neoclassicistische preekstoel met bijbehorend doophek uit 1823 en een orgel uit 1791, gebouwd door H.H. Freytag en F.C. Schnitger jr., waarbij pijpwerk uit 1662 is gebruikt. Van de grafzerken in de kerk dateert de oudste uit de 16e eeuw. De vrijstaande toren heeft twee geledingen en een zadeldak met dakruiter voorzien van een deels opengewerkte spits. De toren dateert uit de eerste helft van de 13de eeuw. Twee ingemetselde stenen herinneren aan herstellingen in 1714 en 1762, waarbij de topgevels vernieuwd werden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01255> a min:Passage,
            schema:CreativeWork ;
