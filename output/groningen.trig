        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill115> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0037> ;
        schema:name "Grijpskerk (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "De pastorie (Kerkplein 2) is een eenlaags pand met schilddak. De ongepleisterde achter- en zijgevel hebben kloostervensters. Een steen uit 1556 in de gepleisterde noordgevel herinnert aan de proost van Kusemer, die de pastorie mogelijk heeft laten bouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00428> a min:Passage,
