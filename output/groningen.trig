        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bellingwolde (gemeente Bellingwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bellingwolde" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 281 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0013> ;
        schema:name "Bellingwolde (gemeente Bellingwedde)"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Dorp, ontstaan in de 11de eeuw op een zandrug op de scheiding van klei en veen in het noorden van Westerwolde. Tot de inpolderingen in de 16de eeuw had het regelmatig te lijden van Dollard-overstromingen. Vanaf het eind van de 18de eeuw ontwikkelde het zich tot een rijk landbouwdorp. Met name in het derde kwart van de 19de eeuw leidde dit tot veel bouwactiviteiten, waarbij aan de hoofdweg grote boerderijen ontstonden en ten oosten daarvan stroken lintbebouwing van landarbeiderswoningen. Na de oorlog zorgden uitbreidingen voor een verdichting aan de noord- en zuidzijde van het lintdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00282> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bellingwolde (gemeente Bellingwedde)"@nl ;
        min:adres "Hoofdweg 227" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerwolde" ;
        min:gemeenteInBoek "Bellingwedde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bellingwolde (gemeente Bellingwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bellingwolde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60104> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8898" ;
        min:soort "inleiding" ;
        min:volgnummer 282 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0013> ;
        schema:name "Bellingwolde (gemeente Bellingwedde)"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De Herv. kerk (Hoofdweg 227), oorspronkelijk gewijd aan St.-Jacobus, is een eenbeukige laat-gotische kerk met versmald, driezijdig gesloten koor en een vrijstaande toren. De door de Dollardvloed van 1509 zwaar beschadigde oudere kerk werd in 1527 op de huidige plek herbouwd. Bij de bouw werd materiaal gebruikt van de afgebroken kerk van Ulsda. Schip en koor kregen forse steunberen; die aan de zuidzijde zijn mogelijk aan het eind van de 18de eeuw gesloopt toen aan de oostzijde ook een toegang met poortomlijsting is gemaakt. Tegen de westzijde bouwde men rond 1890 een consistoriekamer. Bij een restauratie in 1929 werd de kerk ontpleisterd. Aan de zuidzijde van het koor zit een laag venster."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00283> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bellingwolde (gemeente Bellingwedde)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerwolde" ;
        min:gemeenteInBoek "Bellingwedde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bellingwolde (gemeente Bellingwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bellingwolde" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 283 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0013> ;
        schema:name "Bellingwolde (gemeente Bellingwedde)"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "Het inwendige wordt overdekt door korte tijd na de bouw aangebrachte kruisribgewelven; het koor heeft ook een zesdelig kruisribgewelf. De ribben staan op schalken, bestaande uit een kraagsteen, een korte colonnet en een laatgotisch kapiteel. Tot de inventaris behoren een preekstoel met achterschot en klankbord uit 1660, gemaakt door meester Christopher. Het orgel is, blijkens een opschrift in een cartouche met Lodewijk XVI-vormen, in 1797 gebouwd door H.H. Freytag en F.C. Schnitger jr. In de kerk liggen diverse 17de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

