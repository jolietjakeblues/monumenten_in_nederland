        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "Huize Vaartwijk (Oudeweg 41) is een bescheiden veenborg, gebouwd in 1797 voor Willem Jacobsen Hesselink. Het vierkante, onderkelderde eenlaagspand met omlopend schilddak en omlijste ingang met trap is in 1962 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01164> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbroek (gemeente Hoogezand-Sappemeer)"@nl ;
        min:adres "Rijksweg West 63" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Hoogezand-Sappemeer" ;
