        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Andel (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Andel" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 330 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0020> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Woonhuizen. Uit het eind van de 19de eeuw dateert de eenlaags villa Streekweg 93 met eclectische details. Streekweg 16 is een eenlaags villa op L-vormige plattegrond, gebouwd in 1913 naar ontwerp van T. Reitsema in stijl van het rationalisme met enkele jugendstil-details. Naast het huis staat een koetshuis uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00331> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Andel (gemeente Winsum) – Windmolen"@nl ;
        min:adres "Oude Dijk 11" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Andel (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Andel" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34300> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8581" ;
        min:soort "lemma" ;
        min:volgnummer 331 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0020> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text """Windmolen ‘De Jonge Hendrik’ (Oude Dijk 11) is een met hout beklede achtkante stellingkoren- en pelmolen op bakstenen onderbouw. De molen werd in 1875 gebouwd door molenmaker J.H. van der Veen voor P. Mulder ter plaatse van een in 1874 door brand verwoeste voorganger. De molen is in 1971-'73 gerestaureerd.

De Alg. begraafplaats (Streekweg ong.), aangelegd in de eerste helft van de 19de eeuw, heeft een rijk uitgewerkt toegangshek uit omstreeks 1910. Op de rechthoekige begraafplaats liggen diverse rijk gedecoreerde 19de-eeuwse zerken."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00332> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Den Andel (gemeente Winsum) – Boerderijen"@nl ;
        min:adres "M.D. Teenstraweg 2",
            "Oosterweg 17" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Den Andel (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Den Andel" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21494> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8579" ;
        min:soort "lemma" ;
        min:volgnummer 332 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0020> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "82" ;
        schema:pageStart "82" ;
        schema:pagination "82" ;
        schema:text "Boerderijen. In de omgeving van Den Andel ligt een aantal interessante boerderijen. De grote kop-hals-rompboerderij Arion (M.D. Teenstraweg 2) werd gebouwd voor M.D. Teenstra. De schuur, waarin de zomerwoning is ondergebracht, en het middelhuis dateren uit 1820. Het deels onderkelderde voorhuis met wolfdak en zij-ingang dateert uit 1862. In de zijgevel zit een gevelsteen met een voorstelling van Neptunus met een arend. Op het erf staat een bijschuur uit 1810. De Wiersemaheert (Oosterweg 17) is een kophals-romp-boerderij met dwars, blokvormig voorhuis in eclectische trant, gebouwd rond 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00333> a min:Passage,
