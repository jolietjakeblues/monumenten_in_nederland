        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Groningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Groningen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18631> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "486384" ;
        min:soort "inleiding" ;
        min:volgnummer 470 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0038> ;
        schema:name "Groningen"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "De voorm. Zuiderkerk (Stationsstraat 12) [9] kwam in 1900-'01 tot stand in opdracht van de Gereformeerde Gemeente naar ontwerp van de Amsterdamse architect Tj. Kuipers in samenwerking met de Groningse bouwkundige Y. van der Veen. Het bouwwerk is uitgevoerd in rationalistische vormen in de trant van Berlage en heeft een karakteristieke toren met tentdak; die oprijst uit de met balustrades terugspringende voorbouw. Het gebouw is in 1984 verbouwd tot wooneenheden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00471> a min:Passage,
