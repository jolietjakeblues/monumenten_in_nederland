        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0122> ;
        schema:name "Tinallinge (gemeente Winsum)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De rentenierswoning Tjarda van Starkenborghweg 2, een eenlaags dwars huis met eclectische details, werd in 1880 gebouwd voor J.J. Frieling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0122.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01042> a min:Passage,
            schema:CreativeWork ;
