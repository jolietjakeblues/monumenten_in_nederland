        schema:name "Zoutkamp (gemeente De Marne)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "De Herv. kerk (Parallelweg ong.) is een eenvoudige recht gesloten zaalkerk, gebouwd in 1836 in neoclassicistische trant. Ze ligt op een verhoogd kerkhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

