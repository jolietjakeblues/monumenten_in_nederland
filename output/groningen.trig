        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0037> ;
        schema:name "Grijpskerk (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "De kerk van de Geref. Gemeenten in Nederland (bij N. Grijpstraat 24) is een grote zaalkerk, gebouwd in 1938 naar ontwerp van H. Rots. De pastorie (N. Grijpstraat 24) dateert uit 1948."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00430> a min:Passage,
