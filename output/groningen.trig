        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidhorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zuidhorn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40421> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "41074" ;
        min:soort "inleiding" ;
        min:volgnummer 1287 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0155> ;
        schema:name "Zuidhorn"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De R.K. St.-Josephkerk (De Gast 38) is een kleine rechthoekige zaalkerk met een aan de rechterzijde aangebouwde pastorie; ze is gebouwd in 1844 naar plannen van bouwmeester Crone onder toezicht van W. Dusseldorp. De kerk werd in 1929 uitwendig verbouwd door A.Th. Elmpt in expressionistische trant. Ook de pastorie, in dezelfde trant, is toen gebouwd. Tot de inventaris behoren een laat-gotisch eikenhouten beeld van Maria met kind, een barok hoofdaltaar afkomstig uit de jezuïetenstatie aan de Hoge der A te Groningen (circa 1670) en een neogotische preekstoel (circa 1900)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01288> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zuidhorn"@nl ;
        min:adres "De Gast 60" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidhorn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zuidhorn" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1288 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0155> ;
        schema:name "Zuidhorn"@nl ;
        schema:pageEnd "242" ;
        schema:pageStart "242" ;
        schema:pagination "242" ;
        schema:text "De Geref. kerk (De Gast 60) is een groot gebouw met pseudo-basilicale opzet, verlicht door een reeks dakkapellen, en aan de oostzijde een rechthoekige toren met zadeldak. De kerk werd in 1951 in traditionalistische stijl opgetrokken naar een ontwerp van J. Bosma."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01289> a min:Passage,
