        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Usquert (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Usquert" ;
        min:lemma "Horeca" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32675> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "515337" ;
        min:soort "lemma" ;
        min:volgnummer 1090 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0128> ;
        schema:name "Horeca"@nl ;
        schema:pageEnd "213" ;
        schema:pageStart "213" ;
        schema:pagination "213" ;
        schema:text "Horeca. Het voorm. stationskoffiehuis ‘Huize de Landbouw’ (Stationsstraat 2) is in 1894 gebouwd en bestaat uit twee langgerekte eenlaags beuken met zadeldaken en een haakse kap. De ingang bevond zich in een uitbouw aan de lange zijde. Het pand is gedecoreerd met enkele speklagen, sluit- en aanzetstenen, een fraai gesneden daklijst en decoratie in de boogvelden boven de vensters. Het gebouw is uitgevoerd met enkele neorenaissance-elementen. Het voorm. hotel Raadhuisstraat 27 dateert uit 1914. Het heeft een overstekend afgeknot schilddak en een risalerend rechter gedeelte. Het rechterdeel dateert uit 1929."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0128.php> .

