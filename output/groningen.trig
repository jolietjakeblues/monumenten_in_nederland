        min:volgnummer 401 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill111> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0033> ;
        schema:name "Garrelsweer (gemeente Loppersum)"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De Herv. kerk (Stadsweg 31) is een hoge zaalkerk met een geveltoren afgesloten door een dwars zadeldak, gebouwd in 1912 in een vormgeving met rationalistische invloeden. In de toren hangt een klok uit 1695, gegoten door Claudi Fremy. Op het kerkhof liggen enkele 17de- en 18de-eeuwse zerken voor het geslacht Tammens."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00402> a min:Passage,
