        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0138> ;
        schema:name "Westerbroek (gemeente Hoogezand-Sappemeer)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "De boerderij ‘Langwijk’ (Rijksweg West 63) ligt op een omgracht terrein. Het in opzet 18de-eeuwse dwarse woongedeelte is gedeeltelijk onderkelderd en heeft een omlopend schilddak met hoekschoorstenen en daartussen een balustrade. De toegang aan de voorzijde wordt door ionische pilasters omlijst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01165> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westeremden (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
