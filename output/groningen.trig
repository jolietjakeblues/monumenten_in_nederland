        schema:name "Garmerwolde (gemeente Ten Boer)"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "De openbare lagere school (Dorpsstraat 60) is rond 1890 gebouwd als drieklassige school in neoclassicistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0031.php> .

