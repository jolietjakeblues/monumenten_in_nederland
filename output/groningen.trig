        min:soort "inleiding" ;
        min:volgnummer 717 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0073> ;
        schema:name "Muntendam (gemeente Menterwolde)"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text "De Immanuelkerk (Nieuwe Weg 2) is een eenvoudige zaalkerk met spitsboogvensters. Ze werd gebouwd in 1923 als Geref. kerk en is nu in gebruik bij de Herv. gemeente."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00718> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Muntendam (gemeente Menterwolde)"@nl ;
        min:adres "Kerkstraat 25" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Menterwolde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Muntendam (gemeente Menterwolde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Muntendam" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 718 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0073> ;
        schema:name "Muntendam (gemeente Menterwolde)"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text "Het voorm. raadhuis (Kerkstraat 25) is ontstaan door de verbouwing in 1917 van een bestaande notariswoning. Naar plannen van gemeentearchitect J. Schenkel kreeg het pand een forse trapgevel in late neorenaissance-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0073.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00719> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Muntendam (gemeente Menterwolde) – Boerderijen"@nl ;
        min:adres "Tussenklappen Oostzijde 1",
            "Tussenklappen Westzijde 10",
            "Tussenklappen Westzijde 19" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Menterwolde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Muntendam (gemeente Menterwolde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Muntendam" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57297> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "520978" ;
        min:soort "lemma" ;
        min:volgnummer 719 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill239> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0073> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text """Boerderijen. Langs het kanaal naar Zuidbroek staan enkele boerderijen van het Oldambster type. De uit 1851 daterende boerderij Tussenklappen Westzijde 9 heeft een woongedeelte met wolfdak en twee rijen zaadzoldervensters. Uit omstreeks 1875 stamt De Munte (Tussenklappen Westzijde 10). De boerderij Janna-Jellina (Tussenklappen Westzijde 19) heeft een villaachtig voorhuis in expressionistische vormen uit 1930.

De voorm. steenfabriek (bij Tussenklappen Oostzijde 1) werd in 1887 gesticht door H. Dieters. Het huidige tweebeukige pand met classicistische details kwam tot stand na een brand in 1893. Nadat H.R. Holthuis in 1904 eigenaar werd, fabriceerde men ook draineerbuizen. De directeurswoning met jugendstil-details (Tussenklappen Oostzijde 1) is van omstreeks 1904. Kort na 1965 werd de productie gestopt en zijn de nabijgelegen kalkovens gesloopt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0073.php> .

