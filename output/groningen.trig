        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "De boerderij Provincialeweg 15 dateert uit omstreeks 1935 en is een moderne stelpboerderij met expressionistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0109.php> .

