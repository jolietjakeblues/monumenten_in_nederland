        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerwijtwerd (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Westerwijtwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1179 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0141> ;
        schema:name "Westerwijtwerd (gemeente Loppersum)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Het huiskamer-café Dorpsweg 4, bij de brug over de Westerwijdwerdermaar, is een eenvoudig eenlaags pand met wolfdak uit omstreeks 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01180> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerwijtwerd (gemeente Loppersum) – Molens"@nl ;
        min:adres "Dorpsweg 16" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerwijtwerd (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Westerwijtwerd" ;
        min:lemma "Molens" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1180 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill347> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0141> ;
        schema:name "Molens"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Molens. De stellingkoren- en pelmolen Zeldenrust (Dorpsweg 16) heeft een met dakleer beklede achtkant op een bakstenen onderbouw. De molen werd in 1845 gebouwd voor en door J.F. Ritsema ter vervanging van een afgebrande voorganger. Poldermolen De Palen (Palenweg ong.) is een met riet gedekte achtkante bovenkruier op veldmuren, in 1876 door J. Klippius gebouwd en in 1882 naar de huidige plek verplaatst. Het ijzeren hoogholtje over de Westerwijtwerdermaar leidt vanaf de Heemweg naar de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01181> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wildervank (gemeente Veendam)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Veendam" ;
        min:gemeenteInBoek "Veendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veendam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wildervank (gemeente Veendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wildervank" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1181 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0142> ;
        schema:name "Wildervank (gemeente Veendam)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Langgerekt kanaaldorp, ontstaan langs het in 1659 in zuidelijke richting doorgetrokken Westerdiep waar in 1687 een kerk werd gebouwd. In 1702 werd het als zelfstandige parochie van Oude Pekela afgescheiden. In 1764-'75 werd op 60 roeden (242 meter) parallel aan het Westerdiep het Oosterdiep doorgetrokken tot Bareveld aan de Semslinie. Dit dubbele kanalenstelsel, met in het midden een sloot ter scheiding van de percelen en bruggen tegenover de dwarssloten, waardoor telkens twee kavels bereikt konden worden, heeft zijn oorspronkelijke karakter goed behouden. Tussen de diepen bouwde men woningen, aan de buitenkanten van de diepen op regelmatige afstanden boerderijen. Aan de noordzijde zijn na de Tweede Wereldoorlog twee woonwijken ontstaan en in 1969 zijn Wildervank en Veendam weer tot één gemeente samengevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01182> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wildervank (gemeente Veendam)"@nl ;
        min:adres "Torenstraat 108" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Veendam" ;
        min:gemeenteInBoek "Veendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veendam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wildervank (gemeente Veendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wildervank" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24248> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "36883" ;
        min:soort "inleiding" ;
        min:volgnummer 1182 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0142> ;
        schema:name "Wildervank (gemeente Veendam)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De Herv. kerk (Torenstraat 108) is een grote kruiskerk, in 1687 gebouwd als zaalkerk met driezijdig gesloten koor en toren. In 1777 werden aan noord- en zuidzijde dwarspanden aangebracht. De toren kreeg in 1834 een achtkantig opzetstuk overgaand in een open houten lantaarn met uivormige spits. In de toren hangt een klok uit 1837, gegoten door A.H. van Bergen. Het kerkinterieur wordt gedekt door een gestuct tongewelf met trekbalken. Tot de inventaris behoren een preekstoel met klankbord (circa 1694), naar ontwerp van Allert Meijer en met snijwerk van Jan de Rijk, twee banken in overgangsvormen van Lodewijk XV-naar Lodewijk XVI-stijl (tweede helft 18de eeuw) en een door R. Meijer gebouwd orgel (1867). Op het kerkhof staat tegen de oostzijde van de kerk de in 1857 opgebeitelde gedenksteen voor Adriaen Geerts Wildervanck (†1661). Verder zijn er grafzerken van de predikanten O. Oomkes (†1753), Huisinga (†1894) en van T. Veltman (†1855)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01183> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wildervank (gemeente Veendam)"@nl ;
        min:adres "Sportterreinstraat 6" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Veendam" ;
        min:gemeenteInBoek "Veendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veendam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wildervank (gemeente Veendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wildervank" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1183 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0142> ;
        schema:name "Wildervank (gemeente Veendam)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De Evang. Luth kerk (Sportterreinstraat 6) is een eenvoudige zaalkerk uit 1760. In 1911 werd het gebouw gepleisterd en van een toren voorzien. Het interieur bevat een eenvoudige preekstoel in Lodewijk XV-vormen en banken uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01184> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wildervank (gemeente Veendam)"@nl ;
        min:adres "Torenstraat 80" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Veendam" ;
        min:gemeenteInBoek "Veendam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Veendam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wildervank (gemeente Veendam)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wildervank" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30775> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "515427" ;
        min:soort "inleiding" ;
        min:volgnummer 1184 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0142> ;
        schema:name "Wildervank (gemeente Veendam)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De (Geref.) Concordiakerk (Torenstraat 80) is een kruiskerk met in de zuidelijke binnenhoek een slanke toren met achtkantige naaldspits en opengewerkte top. De kerk werd in 1910-'11 gebouwd naar plannen van Tj. Kuipers op de plaats van een uit 1841 stammende voorganger. De helft van de bouwkosten kwamen voor rekening van de houthandelaar K. Bos en zijn zoon J. Bos. De laatste schonk het in 1913 ingewijde orgel, vervaardigd door E.F. Walcker & Co. uit Ludwigsburg (D.). Verder is er een preekstoel uitgevoerd in kostbare houtsoorten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01185> a min:Passage,
