        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "De Geref. kerk (Wilhelminastraat 20) is een zaalkerk uit 1929, gebouwd naar ontwerp van de architecten Van Wijk en Broos."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0090.php> .

