        min:gemeenteInBoek "Bedum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zuidwolde (gemeente Bedum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zuidwolde" ;
        min:lemma "Poldermolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13439> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "18226" ;
        min:soort "lemma" ;
        min:volgnummer 1299 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0156> ;
        schema:name "Poldermolens"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Poldermolens. De ten noorden van het dorp gelegen Krimstermolen (Boterdiep O.Z. 3) is een met riet gedekte achtkante bovenkruier op veldmuren, voorzien van twee vijzels. De molen werd oorspronkelijk in 1862 gebouwd om de Oostelijke Bedumerpolder te bemalen. Nadat hij in 1903 was afgebrand, volgde het jaar daarop de herbouw door molenmaker M. Noordewier naar ontwerp van J. Klippius. De molen werd in 1977 verplaatst naar de huidige plek bij de monding van het Harm Westerskanaal in het Boterdiep om als reserve-bemalingswerktuig te dienen. Ten westen van het dorp aan de Nieuwe Aa staat de poldermolen Koningslaagte (bij Wolddijk 91), een met riet gedekte achtkante bovenkruier op veldmuren, voorzien van een vijzel. De molen werd in 1878 gebouwd met gebruikmaking van oudere onderdelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0156.php> .

