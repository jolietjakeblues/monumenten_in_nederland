        schema:name "Zuurdijk (gemeente De Marne)"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Wegdorp, waarschijnlijk ontstaan in de 12de eeuw aan de landzijde van een van dijkjes langs de Hunze. Die dijkjes gingen in de 13de eeuw deel uitmaken van de Oude Dijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01303> a min:Passage,
            schema:CreativeWork ;
