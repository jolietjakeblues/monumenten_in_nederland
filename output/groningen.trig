        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warffum (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Warffum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59660> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "515330" ;
        min:soort "inleiding" ;
        min:volgnummer 1136 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0134> ;
        schema:name "Warffum (gemeente Eemsmond)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Geref. kerk (Hoofdstraat 27) is een zaalkerk uit 1886, gebouwd naar plannen van T. Huizinga. De voorgevel heeft gepleisterde en bakstenen siermotieven. De rondboogvensters zijn voorzien van een gietijzeren roedeverdeling met ronde vormen. De kerk bevat een door J. Spooreman gebouwd orgel uit 1783, dat in 1906 naar deze kerk is verplaatst. De pastorie (Oosterstraat 29) dateert uit dezelfde tijd als de kerk en heeft eveneens bakstenen en gepleisterde decoraties in eclectische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01137> a min:Passage,
