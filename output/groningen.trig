        min:hoofdstuk "Steden, dorpen, monumenten › Hoogezand-Sappemeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hoogezand-Sappemeer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 553 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill193> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0045> ;
        schema:name "Hoogezand-Sappemeer"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "De voorm. R.K. St.-Martinuskerk (Sluisweg 47, Martenshoek) is een brede eenbeukige neogotische kerk; de terzijde staande lage toren heeft twee geledingen en een tentdak. De kerk werd in 1891 gebouwd naar plannen van N. Molenaar. Sinds 1990 is er een glazeniersatelier in gevestigd, waartoe men de voorgevel in 1991 heeft gerestaureerd. Op het erachter gelegen kerkhof bevinden zich een kruisigingsgroep en enkele rijke graven, waaronder die van de familie Wilkens en van enkele scheepsbouwers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00554> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogezand-Sappemeer"@nl ;
        min:adres "Noorderstraat 27" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Hoogezand-Sappemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoogezand-Sappemeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hoogezand-Sappemeer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 554 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0045> ;
        schema:name "Hoogezand-Sappemeer"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "De kerk van de Geref. Gemeente in Nederland (Noorderstraat 27, Sappemeer) is een kruiskerk met geveltoren en naaldspits, gebouwd in 1904-'10 door aannemer C. Linzel naar voorbeeld van de kerk te Winschoten (1901)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00555> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogezand-Sappemeer – Raadhuizen"@nl ;
        min:adres "Hoofdstraat 31",
            "Kerkstraat 157",
            "M. Veningastraat 117-119",
            "Noorderstraat 123",
            "Noorderstraat 302" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Hoogezand-Sappemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoogezand-Sappemeer" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hoogezand-Sappemeer" ;
        min:lemma "Raadhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 555 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0045> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text """Raadhuizen. Het voorm. raadhuis van Sappemeer (Noorderstraat 123) kwam tot stand in 1885, nadat het huis van notaris H. Busmann was aangekocht en verbouwd. Het neoclassicistische pand bleef tot 1949 in gebruik, waarna het opgaand middenrisaliet is verwijderd. Het voorm. raadhuis van Hoogezand (Hoofdstraat 31) is een neoclassicistisch pand dat in 1887 ontstond door een verbouwing van het rond 1860 gebouwde woonhuis van de heer Hooites. Het raadhuis van Hoogezand-Sappemeer (Kerkstraat 157) is in 1979-'83 gebouwd naar plannen van J.

Brouwer en bestaat uit twee flexibel indeelbare kantoorzones en een middenzone met raadzaal, trouwzaal en vergaderruimtes. Een binnenstraat vormt de koppeling met het door E.J. Jelles ontworpen sociaal-culturele centrum. Postkantoren. Het voorm. postkantoor van Hoogezand (M. Veningastraat 117-119) werd in 1897-'98 gebouwd naar plannen van Rijksbouwmeester C.H. Peters in simpele, op de neogotiek geënte, vormen. Het voorm. postkantoor van Sappemeer (Noorderstraat 302) uit 1912 is eveneens van zijn hand en is vergelijkbaar, maar het heeft op de verdieping hardstenen kolommen tussen de vensters. Beide panden zijn nu verbouwd tot appartementen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00556> a min:Passage,
