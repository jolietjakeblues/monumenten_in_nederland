        min:kern "Grijpskerk" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 426 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0037> ;
        schema:name "Grijpskerk (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Tevens werd het gebouw gepleisterd. Tot de inventaris behoren een 17de-eeuwse preekstoel met het wapen van Grijpskerk en een orgel uit 1832, gebouwd door L. en J. van Dam. Op het kerkhof rond de kerk bevinden zich enkele opvallende grafmonumenten, waaronder die voor Aaltje Thomas Wiersema, die in 1832 het orgel schonk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00427> a min:Passage,
