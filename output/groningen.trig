        schema:name "Westerlee (gemeente Scheemda)"@nl ;
        schema:pageEnd "225" ;
        schema:pageStart "225" ;
        schema:pagination "225" ;
        schema:text "Op het kerkhof liggen diverse interessante graven, waaronder een met zandloper voor A.H. van Bergen (†1882) en een met vazen voor G. Kloosterboer (†1893) en M. Kloosterboer (†1902)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0140.php> .

