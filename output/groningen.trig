        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bourtange" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28546> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "37447" ;
        min:soort "inleiding" ;
        min:volgnummer 308 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0017> ;
        schema:name "Bourtange (gemeente Vlagtwedde)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De Herv. kerk (Marktplein 2a) is een zaalkerk met aan de voorzijde een dakruiter. Ze verving in 1869 de kerk uit 1607. In de noordgevel zit een wapensteen; op een gedenksteen daaronder verwijst een tekst naar de bouw van de vesting in 1593. Tot de kerkinventaris behoren een midden-17de-eeuwse preekstoel en een credobord van omstreeks 1600 met de Tien Geboden en het Onze Vader in een maniëristische omlijsting. De oudste grafzerk dateert uit 1613."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00309> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bourtange (gemeente Vlagtwedde)"@nl ;
        min:adres "Batterijenstraat 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
