        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Winsum en Obergum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Winsum en Obergum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1215 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill360> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0144> ;
        schema:name "Winsum en Obergum"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De Herv. kerk (Kerkpad 14, Obergum) [2], gelegen op het hoogste deel van de dorpswierde, is een eenbeukige kerk met driezijdig gesloten koor en een ongelede toren met zadeldak. Het schip zou nog uit de 13de eeuw kunnen dateren, maar het koor is iets jonger. De 14de-eeuwse toren werd enkele keren verbouwd, getuige jaartalankers uit 1706 en een sluitsteen met het jaartal 1790. In de toren zitten resten van een koepelgewelf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01216> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Winsum en Obergum"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum en Obergum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Winsum en Obergum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Winsum en Obergum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1216 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0144> ;
        schema:name "Winsum en Obergum"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Het kerkinterieur werd in 1844 verbouwd en in 1971 is de hele kerk gerestaureerd. Tot de inventaris behoren een preekstoel in Lodewijk XV-stijl met de wapens van Van Nyeveen, Sichterman en Vinkers (1780), een eenvoudige avondmaalstafel (1790) en een herenbank (eind 18de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0144.php> .

