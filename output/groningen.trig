        schema:name "Ten Post (gemeente Ten Boer)"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Komdorp, ontstaan langs het rond 1425 gegraven Damsterdiep op de kruising van de weg van Stedum naar Wittewierum. Tussen de dorpsbebouwing en de verkeersweg naar Delfzijl verrees na de Tweede Wereldoorlog een uitbreidingswijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0117.php> .

