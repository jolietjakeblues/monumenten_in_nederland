        schema:name "Hotel-café"@nl ;
        schema:pageEnd "244" ;
        schema:pageStart "244" ;
        schema:pagination "244" ;
        schema:text "Hotel-café ‘Vaatstra’ (Boterdiep WZ 45) ligt naast de Herv. kerk en werd omstreeks 1890 gebouwd. Het deels eenlaagse pand heeft een dwars voorhuis met schilddak, veranda en een hoger opgetrokken middenrisaliet. Het achterhuis bevat het voorm. koetshuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0156.php> .

