        min:volgnummer 524 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0041> ;
        schema:name "Harkstede (gemeente Slochteren)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De voorm. openbare lagere school (Hoofdweg 186) dateert uit 1884 en is een goed voorbeeld van een neoclassicistische school met omlijste ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00525> a min:Passage,
            schema:CreativeWork ;
