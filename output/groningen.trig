        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0137> ;
        schema:name "Wehe-Den Hoorn (gemeente De Marne)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "De pastorie (Warfhuisterweg 4) kwam in dezelfde stijl tot stand in 1925-'26. Bij de kerk ligt de in de tweede helft van de 19de eeuw aangelegde R.K. begraafplaats, afgesloten met een toegangshek in neogotische detaillering. Op de begraafplaats staat een neogotische kapel uit omstreeks 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01159> a min:Passage,
            schema:CreativeWork ;
