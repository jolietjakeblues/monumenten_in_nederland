        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0018> ;
        schema:name "Breede (gemeente Eemsmond)"@nl ;
        schema:pageEnd "79" ;
        schema:pageStart "79" ;
        schema:pagination "79" ;
        schema:text "Gehucht, ontstaan in de middeleeuwen op een kwelderwal. Breede wordt voor het eerst genoemd in 1300."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0018.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00315> a min:Passage,
            schema:CreativeWork ;
