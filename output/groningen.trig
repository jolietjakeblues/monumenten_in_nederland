        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ezinge (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Ezinge" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 359 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0026> ;
        schema:name "Ezinge (gemeente Winsum)"@nl ;
        schema:pageEnd "85" ;
        schema:pageStart "85" ;
        schema:pagination "85" ;
        schema:text "De Geref. kerk (Nieuwestreek 35) is een recht gesloten zaalkerk met dakruiter, gebouwd in 1875 in neoclassicistische trant. De kerk vormt een geheel met de ernaast gelegen eenlaags gebouwen: het catechisatielokaal (Nieuwestreek 37) en de pastorie (Nieuwestreek 39)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0026.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00360> a min:Passage,
