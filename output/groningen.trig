        rdfs:label "Thesinge (gemeente Ten Boer)"@nl ;
        min:adres "Molenweg 11" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Thesinge (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Thesinge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31640> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "9796" ;
        min:soort "inleiding" ;
        min:volgnummer 1036 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0121> ;
        schema:name "Thesinge (gemeente Ten Boer)"@nl ;
        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "De windmolen ‘Germania’ (Molenweg 11) is een achtkante stellingkorenmolen; de met riet gedekte romp rust op een bakstenen voet. De in 1973 gerestaureerde molen werd in 1852 verbouwd voor K.R. Mulder, die een bestaande molen uit 1825 liet verhogen tot korenen pelmolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01037> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Thesinge (gemeente Ten Boer) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Thesinge (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Thesinge" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1037 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0121> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "205" ;
        schema:pagination "205-206" ;
        schema:text "Boerderijen. Ten oosten van Thesinge, in het gehucht Bovenrijge, liggen drie interessante boerderijen van het kop-romp-type. De op het omgrachte terrein van de voorm. borg Takkenborg gelegen boerderij Bovenrijgerweg 12 zou in oorsprong nog 18de-eeuws kunnen zijn, evenals de omgrachte boer-derij Bovenrijgerweg 10. De kop-hals-romp-boerderij Bovenrijgerweg 19 stamt uit het begin van de 19de eeuw en heeft een dwars aangebouwde bijschuur en een vrijstaand stookhok."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01038> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Thesinge (gemeente Ten Boer) – Sint-Annen"@nl ;
        min:adres "Hoofdweg 5",
            "Molenpad 8" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Thesinge (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Thesinge" ;
        min:lemma "Sint-Annen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1038 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0121> ;
        schema:name "Sint-Annen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "Sint-Annen. Dit komdorp ten noorden van Thesinge heeft zijn naam te danken aan het nonnenklooster Parva Adwerth - een dochterklooster van het cisterciënzerklooster te Aduard - gesticht in 1345 en opgeheven in 1594. De tweeklassige openbare lagere school (Hoofdweg 5) stamt uit 1806 en werd in 1890 verbouwd, waarbij het een dakruiter kreeg. De voorm. windmolen (Molenpad 8) uit 1818 is werd in 1924 afgeknot en verbouwd tot dorpshuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01039> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tinallinge (gemeente Winsum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
