        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sauwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Sauwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 910 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0106> ;
        schema:name "Sauwerd (gemeente Winsum)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "Op het voorm. Herv. kerkhof (Hoogpad ong.) zijn de funderingen van de in 1840 gesloopte Herv. kerk gemarkeerd. Interessant is verder een grafsteen voor K.M. Oudman (†1870), omgeven door gietijzeren hek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0106.php> .

