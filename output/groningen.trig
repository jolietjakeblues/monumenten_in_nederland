        min:provincie "Groningen" ;
        min:rijksmonumentnummer "46905",
            "46906",
            "46907",
            "46914",
            "46915",
            "46916",
            "46917",
            "46918" ;
        min:soort "inleiding" ;
        min:volgnummer 958 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill292> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0112> ;
        schema:name "Slochteren"@nl ;
        schema:pageEnd "194" ;
        schema:pageStart "194" ;
        schema:pagination "194" ;
        schema:text "Op het voorhof en in de tuin is een aantal zandstenen vazen in eenvoudige Lodewijk XVI-vormen opgesteld. Op de ophaalbrug staan beelden van Herakles en Pallas Athene. Aan weerszijden van het voorplein staan bouwhuizen - in Groningen schathuizen genoemd. Het Noorder Schathuis (Hoofdweg 28) is een langgerekt gebouw met haaks aangebouwde schuur. Midden boven de inmiddels verdwenen inrijdeuren staat het jaartal 1783. Op het achterterrein bevindt zich een mogelijk nog 18de-eeuwse duivenslag, gerestaureerd in 1961. Het Zuider Schathuis (Hoofdweg 32) stamt oorspronkelijk eveneens uit de 18de eeuw, maar is in 1899 grotendeels herbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00959> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Slochteren"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Slochteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Slochteren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Slochteren" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 959 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0112> ;
        schema:name "Slochteren"@nl ;
        schema:pageEnd "194" ;
        schema:pageStart "194" ;
        schema:pagination "194" ;
        schema:text "Het langgerekte park werd oorspronkelijk kort na 1691 in formele Franse stijl aangelegd met zowel aan voor- als achterzijde van de borg een centrale zichtas. In 1781 bracht men enkele partijen in vroege landschapsstijl aan. Met behoud van de zichtas en veel van het bos werd het park rond 1820 geheel veranderd in Engelse landschapsstijl, naar plannen van L.P. Roodbaard. Aan de achterzijde kwamen toen een slingerende beek, vijvers in schijnbaar natuurlijke vormen, heuvels en slingerende paden tot stand. Recent is het gedeelte direct achter de slotgracht naar een meer formele aanleg teruggebracht. Het overbos aan de voorzijde bestaat uit een door bosstroken geflankeerde zichtlaan (de Boslaan) omgeven door weilanden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00960> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Slochteren"@nl ;
        min:adres "Hoofdweg 20" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Slochteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Slochteren" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Slochteren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36502> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "33802" ;
        min:soort "inleiding" ;
        min:volgnummer 960 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0112> ;
        schema:name "Slochteren"@nl ;
        schema:pageEnd "194" ;
        schema:pageStart "194" ;
        schema:pagination "194" ;
        schema:text "Het voorm. rechthuis annex dorpsherberg ‘Het Hoogehuis’ (Hoofdweg 20) is een gepleisterd, tweebeukig dwars pand met 17de-eeuwse kern. De voorste beuk bestaat uit een onderkelderd oostelijk deel waarboven de oorspronkelijke rechtszaal ligt, en een westelijk deel met boven de begane grond een volledige verdieping. Nadat het pand in 1818 als raadhuis in gebruik was genomen, bouwde men aan de achterzijde de tweede beuk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0112.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00961> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Slochteren – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
