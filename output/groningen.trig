        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Niebert (gemeente Marum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Niebert" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 733 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0075> ;
        schema:name "Niebert (gemeente Marum)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "166" ;
        schema:pagination "166-167" ;
        schema:text "De Iwenastins (Aan 't Pad 15) is een gepleisterde kop-romp-boerderij, gelegen op een nog deels omgracht terrein. De huidige vorm is in 1847 ontstaan door een ingrijpende verbouwing in opdracht van ds. R. Damsté. Het onderkelderde voorhuis met hoge zaal moet gezien het zware muurwerk en de bouwsporen in de westgevel een uit omstreeks 1400 daterend steenhuis zijn geweest. Het is de enige nog bestaande stins in Groningen die nooit tot een borg is uitgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00734> a min:Passage,
