        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Woonhuizen. Langs de ringvormige Kerkstraat staan diverse karakteristieke eenlaags huizen, waaronder Kerkstraat 1-3, 6 en 10."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0076.php> .

