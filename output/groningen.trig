        min:soort "inleiding" ;
        min:volgnummer 1072 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0126> ;
        schema:name "Uitwierde (gemeente Delfzijl)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Op het kerkhof liggen diverse grafzerken uit de 16e en 17de eeuw, waaronder de zerk voor Haro Winken to Rengeheim (†1563) en één gietijzeren ‘puntpoal’ voor hoofdonderwijzer E. Rasten (†1869)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0126.php> .

