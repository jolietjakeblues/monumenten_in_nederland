        schema:name "Wagenborgen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "De Geref. kerk (Kerkstraat 50) is een sobere zaalkerk, gebouwd in 1928 naar plannen van A. Akkerman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0133.php> .

