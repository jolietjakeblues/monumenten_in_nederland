        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33034> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8924" ;
        min:soort "lemma" ;
        min:volgnummer 1126 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0132> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Windmolen ‘De Korenbloem’ (Wedderweg 25a) is een achtkante stellingkoren- en pelmolen, gebouwd in 1895 voor R. Rautenberg door molenmaker Siefken. Er is gebruik gemaakt van onderdelen van een uit 1803 stammende oliemolen uit Scheemda. De in 1973 gerestaureerde molen heeft een met dakleer beklede romp en bakstenen voet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01127> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vriescheloo (gemeente Bellingwedde) – Veelerveen"@nl ;
        min:adres "Veelerveensterweg 104" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerwolde" ;
        min:gemeenteInBoek "Bellingwedde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vriescheloo (gemeente Bellingwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Vriescheloo" ;
        min:lemma "Veelerveen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1127 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0132> ;
        schema:name "Veelerveen"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "218" ;
        schema:pagination "218-219" ;
        schema:text "Veelerveen. Dit ontginningsdorp ten zuidoosten van Vriescheloo is ontstaan na aanleg van het Vereenigd of B.L. Tijdenskanaal in 1911-'17. De ontwikkeling is sterk bepaald door de in 1914 opgerichte aardappelmeelfabriek Westerwolde (1962 gesloten). De Geref. kerk (Veelerveensterweg 104) is een zaalkerk uit 1922; deze heeft aan de voorzijde een slanke toren met open klokkenstoel. De dubbele arbeiderswoningen Verbindingsweg 5-15 kwamen in 1920-'22 tot stand in opdracht van de woningbouwvereniging ‘Bellingwolde’ naar planne van M.J. Granpré Molière. Om zoveel mogelijk lucht en licht in de woningen te laten doordringen zijn de woningen opvallend ondiep en hebben de vertrekken aan beide zijden vensters. Nieman's Meuln (Loosterweg ong.) is een achtkante stellingkorenmolen, gebouwd in 1916 voor H. Vos door molenmaker P. Wiertsema. Er is gebruik gemaakt van onderdelen van een poldermolen aan het Koediep te Midwolda. De in 1964-'65 gerestaureerde molen heeft een met dakleer beklede romp op een bakstenen voet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01128> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wagenborgen (gemeente Delfzijl)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wagenborgen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wagenborgen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1128 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0133> ;
        schema:name "Wagenborgen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Wegdorp, ontstaan op een zandrug en bewoond sinds de 11de eeuw. Het dorp kwam vooral na 1873 verder tot ontwikkeling dankzij de stichting van de vereniging ‘Tot Christelijke Liefdadigheid’, door W., J. en T. Brons. De familie Brons bezat tevens een smederij waar stoomdorsmachines werden gebouwd. Uiteindelijk leidde dit tot de oprichting van de Bronsmotorenfabriek die al spoedig naar Appingedam verhuisde. Na de Tweede Wereldoorlog ging het psychiatrisch ziekenhuis een groot deel van de noordzijde van het dorp beslaan, terwijl het dorp zelf zich vooral ten oosten van de hoofdweg uitbreidde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01129> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wagenborgen (gemeente Delfzijl)"@nl ;
        min:adres "Hoofdweg 41" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wagenborgen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wagenborgen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1129 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0133> ;
        schema:name "Wagenborgen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "De Herv. kerk (Hoofdweg 41) is een zaalkerk waarvan de toren voorzien is van een balustrade, een korte lantaarn en een achtkante spits. De kerk werd 1883 in neoclassicistische vormen gebouwd ter vervanging van een al in 1828 sterk gewijzigde middeleeuwse kerk. Het ontwerp is van J. Brons - stichter van de Bronsmotorenfabriek. Tot de inventaris behoren een door Berent Berents gemaakte preekstoel (1661) en een door M. Vermeulen gebouwd orgel (1913). Voor de torendeur bevindt zich een grafzerk van ds. Berent ten Have (†1789)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01130> a min:Passage,
