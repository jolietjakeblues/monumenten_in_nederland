        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Midwolda (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Midwolda" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 707 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0071> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Woonhuizen. De gave dubbele landarbeiderswoning Homerilaan 8-10 dateert uit circa 1870. De villa Hoofdweg 99 is in 1904 opgetrokken in neorenaissance-vormen, maar heeft in de boogvullingen boven de vensters jugendstil-tegels."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00708> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Midwolda (gemeente Scheemda) – Boerderijen"@nl ;
        min:adres "Gereweg 8" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Midwolda (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Midwolda" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 708 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0071> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "164" ;
        schema:pageStart "164" ;
        schema:pagination "164" ;
        schema:text "Boerderijen. In het dorp staat een aantal belangrijke boerderijen die alle tot het Oldambster type behoren. Hoofdweg 33 is een fraaie boerderij met een schuur uit 1850 en een woongedeelte uit 1855, met tuitgevel en drie series zaadzoldervensters, gebouwd voor E.A. Edskes. Op een ruim erf in Engelse landschapsstijl ligt de boerderij R. Abdenaweg 1, met wagenschuur, stookhok en tuinhuisje. De boerderij is gebouwd in 1858 voor P.R. Buurma en E.J.A. Land. In 1877 kreeg ze een nieuwe schuur. Het interieur met bedsteden, meubilair en behangsels is sinds 1906 niet meer gewijzigd. Een afgewolfd voorhuis met symmetrische, omlijste ingangspartij en centrale dakkapel hebben de boerderijen Hoofdweg 251 (1865), gebouwd voor G.R. Toren, en Hoofdweg 25 (1870) voor M. Edskes. Bij de boerderij Buitenhof (Gereweg 8) is het dwars geplaatste woongedeelte, gebouwd in 1882 voor K.T. Hemminga, uitgebouwd tot een middenrisaliet met puntgevel. De beide keuterijtjes Hoofdweg 69 en 71, bestaande uit een woning en een korte schuur, zijn aan het eind van de 19de eeuw ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00709> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Midwolde (gemeente Leek)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Leek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
