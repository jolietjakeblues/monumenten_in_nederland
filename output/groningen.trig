        schema:pageEnd "225" ;
        schema:pageStart "225" ;
        schema:pagination "225" ;
        schema:text "De huidige Geref. kerk (Kosterijweg 16) is een zaalkerk met slanke dakruiter, gebouwd in 1934 met expressionistische elementen naar plannen van A. Wiersema. De pastorie (Huizingerweg 13), eveneens met expressionistische elementen, stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0139.php> .

