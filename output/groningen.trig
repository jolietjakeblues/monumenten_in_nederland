        schema:name "Hoogkerk (gemeente Groningen)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De R.K. kerk Heilige Theresia van Lisieux (Zuiderweg 38) is een kleine zaalkerk met voorportaal en dakruiter, gebouwd in 1927-'28 naar ontwerp van A.Th. van Elmpt in expressionistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0046.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00564> a min:Passage,
            schema:CreativeWork ;
