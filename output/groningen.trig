        min:kern "Bourtange" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 307 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0017> ;
        schema:name "Bourtange (gemeente Vlagtwedde)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "Nadat in 1966 nog slechts een rest van de voorgracht en één bastion zichtbaar was, begon in 1972 de algehele reconstructie van de schans naar de situatie van 1742."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0017.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00308> a min:Passage,
