        min:kern "Schildwolde" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 928 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill284> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0108> ;
        schema:name "Schildwolde (gemeente Slochteren)"@nl ;
        schema:pageEnd "190" ;
        schema:pageStart "190" ;
        schema:pagination "190" ;
        schema:text "Wegdorp, ontstaan op een zandrug temidden van veen- en kleigebieden. Er was al een parochie Schildwolde toen de premonstratenzers hier in 1204 het klooster Gratiae Sanctae Mariae stichtten. Dit klooster werd in 1594 afgebroken; de kloosterwierde heeft men in 1853 afgegraven. Langs de in 1457 aangelegde Hoofdweg verrezen in de 19de eeuw diverse grote boerderijen. Nabij de kerk bouwde men dwars op de Hoofdweg landarbeiderswoningen langs de Meenteweg. Ten westen van deze kruising ontstond na de Tweede Wereldoorlog enige nieuwbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0108.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00929> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Schildwolde (gemeente Slochteren)"@nl ;
