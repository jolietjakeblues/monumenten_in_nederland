        min:volgnummer 803 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0087> ;
        schema:name "Noordhorn (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De Doopsgez. kerk (Langestraat 62) dateert uit 1838 en is een eenvoudige, recht gesloten zaalkerk met lisenen, halfrond gesloten vensters en een omlijste ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0087.php> .

