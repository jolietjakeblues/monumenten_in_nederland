        schema:name "Hornhuizen (gemeente De Marne)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De pastorie (Tammingastraat 55) is een gepleisterd eenlaags pand met omgaand zadeldak en een hoger opgetrokken middenrisaliet, gebouwd in 1870 in eclectische trant. Tegen het huis staat een schuur uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0047.php> .

