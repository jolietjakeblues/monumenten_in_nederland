        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0082> ;
        schema:name "Nieuweschans (gemeente Reiderland)"@nl ;
        schema:pageEnd "171" ;
        schema:pageStart "171" ;
        schema:pagination "171" ;
        schema:text "De voorm. synagoge (Achterstraat 40) is een klein zaalgebouw uit 1811, met inwendig een gedrukt houten tongewelf. Het westelijke deel zou in 1856 toegevoegd zijn. Tot 1924 diende het gebouw als synagoge; momenteel is het in gebruik als galerie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0082.php> .

