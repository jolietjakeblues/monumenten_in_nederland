        schema:name "Poldermolen"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Poldermolen de ‘Zilvermeeuw’ (Winsumerweg 5), gelegen ten westen van Onderdendam, is een met riet gedekte achtkante bovenkruier op veldmuren, voorzien van een vijzel. De molen werd in 1870 gebouwd door molenmaker Hunse en is gerestaureerd in 1973-'74."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00837> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Onderdendam (gemeente Bedum) – Boerderij"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Bedum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Onderdendam (gemeente Bedum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Onderdendam" ;
        min:lemma "Boerderij" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 837 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0092> ;
        schema:name "Boerderij"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text """Boerderij Boterdiep O.Z. 13, gelegen ten zuiden van Onderdendam, is een monumentale boerderij van het Oldambster type uit 1894. Op het erf staan een bijschuur en stookhok uit de bouwtijd.

Het kerkhof van de Herv. kerk van Menkeweer (Warffummerweg ong.) ligt op een wierde ten noorden van Onderdendam. De kerk werd in 1843 gesloopt nadat in Onderdendam een nieuwe kerk was gebouwd. De oudste zerk dateert uit 1781 en bedekt het graf van mr. A.J. van Royen, de eerste voorzitter van het waterschap Hunsingo."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00838> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Onstwedde (gemeente Stadskanaal)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Stadskanaal" ;
        min:gemeenteInBoek "Stadskanaal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Stadskanaal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Onstwedde (gemeente Stadskanaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Onstwedde" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 838 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0093> ;
        schema:name "Onstwedde (gemeente Stadskanaal)"@nl ;
        schema:pageEnd "179" ;
        schema:pageStart "179" ;
        schema:pagination "179" ;
        schema:text "Dorp, ontstaan in de 12de eeuw in het beekdal van de Mussel-Aa. Het esdorp ontwikkelde zich rond twee brinken; 't Wold aan de noordzijde bij de weg naar Wedde en 't Loug aan de zuidzijde bij de splitsing van de wegen richting Stadskanaal en Vlagtwedde. Een omgrachte kerk verrees aan de zuidoostelijke rand van het dorp. Oorspronkelijk was Onstwedde de hoofdplaats van het gebied, maar na 1882 verplaatste het bestuurlijk centrum zich naar Stadskanaal. De woeste gronden rondom het dorp werden rond 1900 ontgonnen, waarna in het dorp zelf een verdichting van de bebouwing plaats had; na de Tweede Wereldoorlog heeft deze ontwikkeling zich voortgezet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0093.php> .

