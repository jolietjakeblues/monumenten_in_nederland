        min:volgnummer 567 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0047> ;
        schema:name "Hornhuizen (gemeente De Marne)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "Dorp, ontstaan in de 10de eeuw op een oeverwal. Aan het eind van de 12de eeuw werd ten noorden van het dorp op de noordelijke oeverwal de Oude Provinciale Dijk opgeworpen, waarachter langs de Ommelanderweg de boerderijen werden gebouwd. Het dorp zelf bestaat uit een klein bebouwingslint."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0047.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00568> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hornhuizen (gemeente De Marne)"@nl ;
        min:adres "Breweelsterweg 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hornhuizen (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Hornhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38170> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23670" ;
        min:soort "inleiding" ;
        min:volgnummer 568 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0047> ;
        schema:name "Hornhuizen (gemeente De Marne)"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De Herv. kerk (Breweelsterweg 1) is een driezijdig gesloten zaalkerk; de toren van twee geledingen heeft een traptoren en een tentdak met kleine spits. Deze toren is laat-gotisch en verloor in 1815 de bovenste geleding, die in 1818 werd vervangen door het huidige dak. In de toren bevinden zich een klok uit 1617, gegoten door Hans Falck van Neurenberch, en een smeedijzeren uurwerk uit 1679. De neoclassicistische zaalkerk dateert uit 1850 en kwam in de plaats van de middeleeuwse kerk. De kerk bevat een herenbank met de wapens van Meckema van Aylva-Camstra (omstreeks 1730) en verder een zandstenen grafzerk met bronzen wapenschild voor Allert Tamminghe (†1498) en een gebeeldhouwde hardstenen zerk voor Julius van Meckama (†1638) en zijn echtgenote Lucia van Deekema (†1652). De kerk ligt op een omheind kerkhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0047.php> .

