        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0144> ;
        schema:name "Winsum en Obergum"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "De voorm. synagoge (Schoolstraat 24, Obergum) [4] is een op een achtererf gelegen zaalgebouw uit 1879 met afgewolfd zadeldak en rondboogvensters. Sinds 1935 dient ze als verenigingsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01219> a min:Passage,
