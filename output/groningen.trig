        schema:name "Oostwold (gemeente Scheemda)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "De Geref. kerk (Goudhoorn 8) is een kruiskerk met portiek voorzien van een zeer slanke spits. De kerk verrees in 1930 in expressionistische vormen naar plannen van B. Jager ter vervanging van een kerk uit 1899."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0097.php> .

