        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Opende (gemeente Grootegast)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Opende" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 868 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0098> ;
        schema:name "Opende (gemeente Grootegast)"@nl ;
        schema:pageEnd "182" ;
        schema:pageStart "182" ;
        schema:pagination "182" ;
        schema:text "De Herv. kerk (Provincialeweg 158) is een sterk verbouwde zaalkerk uit 1748, die een oudere kerk uit 1648 verving. De voorgevel is in 1915 vernieuwd en in 1930 is de kerk aan de oostzijde vergroot. In de kerk staat een preekstoel met achterschot en klankbord in Lodewijk XIV-vormen uit de eerste helft van de 18de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0098.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00869> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Opende (gemeente Grootegast) – Boerderijen"@nl ;
        min:adres "Drachtsterweg 43",
            "Provincialeweg 106" ;
