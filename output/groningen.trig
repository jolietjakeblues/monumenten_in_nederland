        schema:pagination "218" ;
        schema:text "Het verenigingsgebouw voor Vrijzinnig Hervormden (Onstwedderweg 6), een pand met L-vormige plattegrond, is gebouwd in 1923 in lichtexpressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0131.php> .

