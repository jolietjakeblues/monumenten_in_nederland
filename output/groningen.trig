        schema:name "Stedum (gemeente Loppersum)"@nl ;
        schema:pageEnd "198" ;
        schema:pageStart "198" ;
        schema:pagination "198" ;
        schema:text "Op het kerkhof rondom de kerk liggen diverse interessante 19de-eeuwse zerken. De forse, in traditionalistische stijl gebouwde pastorie (Kampweg 2) uit 1939 staat op een omgracht terrein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0115.php> .

