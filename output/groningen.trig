        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Het voorm. raadhuis (Raadhuisstraat 16) is een neoclassicistisch pand uit 1891. Voor het gebouw staat een hardstenen monument voor Adriaen Geerts Wildervanck, opgericht in 1897."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0142.php> .

