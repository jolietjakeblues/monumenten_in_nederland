        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roodeschool (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Roodeschool" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 904 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0104> ;
        schema:name "Roodeschool (gemeente Eemsmond)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Geref. kerk (Hooilandseweg 75) is een traditionele zaalkerk met een forse toren; deze is voorzien van een zadeldak tussen topgevels. Op dat dak staat een kleine klokkenstoel met klok. De kerk verrees in 1950 naar ontwerp van D. Broos en C.H. van Wijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0104.php> .

