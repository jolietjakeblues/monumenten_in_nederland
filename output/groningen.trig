        schema:pageEnd "90" ;
        schema:pageStart "90" ;
        schema:pagination "90" ;
        schema:text "De Geref. kerk (Stadsweg 89) is een kruiskerk met slanke geveltoren, gebouwd in 1908 naar plannen van Y. van der Veen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00401> a min:Passage,
