        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Woonhuizen. Het eclectische woonhuis Eestumerweg 1, met opgaand middenrisaliet, werd rond 1870 gebouwd. Het voorm. woon- en winkelpand Oude Rijksweg 213, kwam rond 1905 tot stand in neorenaissancevormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0117.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01003> a min:Passage,
