        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordhorn (gemeente Zuidhorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordhorn" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56568> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "41089" ;
        min:soort "inleiding" ;
        min:volgnummer 802 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill255> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0087> ;
        schema:name "Noordhorn (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "174" ;
        schema:pagination "174-175" ;
        schema:text "De Herv. kerk (Torenstraat 1) is een eenbeukige kerk met recht gesloten koor en een hoge ongelede toren met achtzijdige spits. De twee rondboogvensters en gedeelten van spaarvelden bij de geveltop van de koorsluiting en de in de zijmuren aanwezige sporen van romaanse rondboogvensters, ingangen en een hagioscoop wijzen op een datering in de 13de eeuw. De toren zal, gezien de spitsbogige galmgaten, uit de 14de eeuw dateren, maar is waarschijnlijk in de 18de eeuw beklampt. In de toren hangt een klok uit 1774, gegoten door Claude Fremy. Tot de kerkinventaris behoren een preekstoel vervaardigd door Jan de Rijk (1718) en vijf herenbanken met rijk gesneden achterschotten (17de en 18de eeuw)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00803> a min:Passage,
