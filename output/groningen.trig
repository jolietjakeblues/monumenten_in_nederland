        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41023> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "515408" ;
        min:soort "inleiding" ;
        min:volgnummer 1098 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0129> ;
        schema:name "Veendam"@nl ;
        schema:pageEnd "216" ;
        schema:pageStart "216" ;
        schema:pagination "216" ;
        schema:text "Het raadhuis (Raadhuisplein 5) [4] verrees in 1878 in neoclassicistische vormen. Bij een verbouwing in 1913 naar plannen van J. Stuivinga kwamen een voorbouw in neorenaissance-vormen en een op de ridderzaal te Den Haag geïnspireerde raadzaal tot stand. In 1968 verrees een nieuwe vleugel aan de achterzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0129.php> .

