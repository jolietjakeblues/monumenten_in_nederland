        schema:name "Kolham (gemeente Slochteren)"@nl ;
        schema:pageEnd "148" ;
        schema:pageStart "148" ;
        schema:pagination "148" ;
        schema:text "De Isr. begraafplaats (bij Knijpslaan 45) is omstreeks 1870 aangelegd als begraafplaats voor joden uit de gemeente Slochteren en omgeving."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00599> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Krewerd (gemeente Delfzijl)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
