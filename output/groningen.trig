        schema:name "Onderdendam (gemeente Bedum)"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "De Herv. kerk (Bedumerweg 15) is een kleine zaalkerk met aan de kopse zijden een driezijdige sluiting en op het dak een eenvoudige dakruiter. De kerk werd in 1840 gebouwd naar ontwerp van W.K. Dusseldorp ter vervanging van de kerk te Onderwierum (waarvan het kerkhof aldaar nog bestaat). De kerk bevat een orgel uit 1841, gebouwd door R.A. Lohman."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00830> a min:Passage,
            schema:CreativeWork ;
