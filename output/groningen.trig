        schema:name "Niekerk (gemeente De Marne)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De tuinderswoning Hoofdstraat 23 is gebouwd in 1929 in expressionistische stijl naar plannen van W. Reitsema. Achter het eenlaags pand staat een stookhok met pijp, ten behoeve van de vroeger achter het huis gelegen kassen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00749> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Niekerk (gemeente De Marne)"@nl ;
        min:adres "Kanaalstraat 12" ;
        min:deel "Monumenten in Nederland. Groningen" ;
