        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "De Chr. lagere school (Hoofdweg 15) dateert uit 1921 en is een tweelaags school met enig decoratief metselwerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01132> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wagenborgen (gemeente Delfzijl)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wagenborgen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wagenborgen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1132 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0133> ;
        schema:name "Wagenborgen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Het psychiatrisch ziekenhuis ‘Groot Bronswijk’ (Familie Bronsweg) werd in 1873 opgericht als vereniging ‘Tot Christelijke Liefdadigheid’, waarna in 1874 het eerste gebouw verrees. Aan het eind van de 19de eeuw stonden er tien, van bijbelse namen voorziene, paviljoens, waarvan de meeste echter zijn gesloopt of ingrijpend verbouwd bij uitbreidingen in de jaren dertig en zeventig. De watertoren zal in 1891 zijn gebouwd en werd in de jaren twintig verhoogd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0133.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01133> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warffum (gemeente Eemsmond)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warffum (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Warffum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1133 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill336> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0134> ;
        schema:name "Warffum (gemeente Eemsmond)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Wierdedorp met een rechthoekige structuur, ontstaan in de vroege middeleeuwen op een kwelderwal. Het dorp wordt rond 800 voor het eerst vermeld als ‘Werfhem’. De hoofdstructuur bestaat uit evenwijdige rechte straten in noordzuidrichting. De bebouwing was vanouds geconcentreerd tussen de Oosterstraat en de Torenweg. In de tweede helft van de 19de eeuw trad verdichting van de bebouwing op en groeide het dorp uit langs de uitvalswegen, zoals de Westeren de Oostervalge, de Oosterstraat en de Noorderstraat. Die groei zette na 1900 door en er ontstonden kleine nieuwbouwwijken, zoals rond 1933 de wijk Helpman. Hier werd op basis van de landarbeiderswet (1918) een twintigtal landarbeiderswoningen van het krimpjestype gebouwd. In het dorpscentrum bevindt zich het Openluchtmuseum Het Hoogeland. Omdat een deel van het museum bestaat uit bestaande dorpsbebouwing, voegt het zich naadloos in het dorpsbeeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01134> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warffum (gemeente Eemsmond)"@nl ;
        min:adres "Torenweg 18" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Warffum (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Warffum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1134 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill337> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0134> ;
        schema:name "Warffum (gemeente Eemsmond)"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "219" ;
        schema:pagination "219-220" ;
        schema:text "De Herv. kerk (Torenweg 18) is een gepleisterde eenbeukige zaalkerk met driezijdige koorsluiting en een ongepleisterde, ongelede westtoren met ingesnoerde spits. Het lange schip is van oorsprong romaans, maar nu niet meer als zodanig herkenbaar, onder meer vanwege de hoge vensters. Het koor dateert waarschijnlijk uit de tweede helft van de 16de eeuw. De toren verrees in 1638 en heeft hoekblokken, spitsboogvormige galmgaten en een wijzerplaat uit 1872. In de toren hangt een klok uit 1686, gegoten door C. Spronneaux en H. Veri. De kerk werd bepleisterd in 1895, toen het gebouw naar ontwerp van N.W. Lit een neogotisch uiterlijk kreeg. Neogotisch zijn met name het zuidportaal en de toen aangebrachte toegang in de koorsluiting. De toren is in 1971 weer ontpleisterd. Tot de kerkinventaris behoort onder meer 18de-eeuws meubilair. Het orgel dateert uit 1812 en is gebouwd door J.W. Timpe met snijwerk van M. Walles & Zn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0134.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01135> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warffum (gemeente Eemsmond)"@nl ;
        min:adres "Kerkstraat 9",
            "Pastorieweg 24" ;
        min:deel "Monumenten in Nederland. Groningen" ;
