        min:kern "Wittewierum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1235 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0146> ;
        schema:name "Wittewierum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "Wierdedorp, ontstaan in 1213 toen hier het premonstratenzerklooster Bloemhof werd gesticht. Het klooster werd in 1561 opgeheven. De oorspronkelijke, in 1238 begonnen, kerk werd in 1863 vervangen door de huidige en daaromheen zijn in die tijd enkele boerderijen gebouwd. De wierde zelf is beschermd gezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01236> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wittewierum (gemeente Ten Boer)"@nl ;
        min:adres "Kerkhorn 4" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wittewierum (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wittewierum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57222> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "353775" ;
        min:soort "inleiding" ;
        min:volgnummer 1236 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill366> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0146> ;
        schema:name "Wittewierum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De Herv. kerk (Kerkhorn 4)is een brede, door pilasters gelede zaalkerk met recht gesloten koor, gebouwd in 1863 in overwegend neoclassicistische vormen, maar wel met spitsboogvensters voorzien van neogotische gietijzeren traceringen. In het gepleisterde muurwerk onder de vensters is mogelijk ouder materiaal hergebruikt. In de Tweede Wereldoorlog zijn de dakruiter en de opengewerkte gietijzeren pinakels op de voorgevel verloren gegaan. Het interieur wordt overdekt door een gedrukt, gepleisterd tongewelf. Onder het verhoogde koordeel ligt een mogelijk 13de-eeuwse, met een graatgewelf overdekte grafkelder voor het geslacht Rengers. In de vloer liggen diverse grafzerken, onder meer die van Swer Renghers (†1558), Judith Wermelo Rengers (†1618), Johan Rengers (†1626), Egbert Rengers (†1663) en Edzardt Lamouraal Rengers (†1737). Tot de inventaris behoren een dekstuk van een laat-17de-eeuwse herenbank met het wapen van Rengers-Polman en verder een preekstoel, twee herenbanken en kerkbanken uit omstreeks 1863."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01237> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wittewierum (gemeente Ten Boer)"@nl ;
        min:adres "Kerkhorn 2" ;
