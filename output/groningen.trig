        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01074> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulrum (gemeente De Marne)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulrum (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Ulrum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1074 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0127> ;
        schema:name "Ulrum (gemeente De Marne)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Wierdedorp, ontstaan op twee grote, door een watergang gescheiden, wierden met rechthoekige structuur. Van de oostelijke wierde is die structuur in het huidige stratenpatroon te herkennen (Marktstraat). Midden op de westelijke wierde staat de middeleeuwse kerk. Het in 1650 gegraven Ulrumer- of Trekdiep eindigde aan de westzijde van het dorp bij een havenkom aan de Nieuwstraat. De in 1663 gegraven provinciale trekvaart naar Winsum eindigde aan de zuidkant van het dorp. Aan de zuidoostkant van het dorp lag de in 1809 gesloopte 17de-eeuwse borg Asinga, waarvan de grachten recentelijk zijn opgenomen in het Asingapark. Het uittreden van de predikant H. de Cock uit de Herv. kerk te Ulrum in 1834 was het begin van de Gereformeerde kerk. In de jaren 1847-'48 vertrok hij met een kwart van de bevolking van Ulrum naar Noord-Amerika."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0127.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01075> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulrum (gemeente De Marne)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ulrum (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Ulrum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1075 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0127> ;
        schema:name "Ulrum (gemeente De Marne)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "In de tweede helft van de 19de eeuw ontwikkelde Ulrum zich tot een centrum voor het omringende landbouwgebied. Aan het Hunsingokanaal ten zuiden van het dorp vestigde zich enige agrarische industrie, waaronder een strokartonfabriek. Omstreeks 1900 verdichtte zich de bebouwing langs de Noorderstraat en de Leensterweg. In 1897 kreeg Ulrum een paardentramverbinding met Winsum. De aanleg van de lokaalspoorlijn Winsum-Zoutkamp (1922) leidde tot de opheffing van die tramlijn. De spoorlijn zelf werd in 1938 opgeheven. Bij het in 1922 gebouwde station ontstond enige villabebouwing. Na de Tweede Wereldoorlog is het dorp vooral naar het oosten uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0127.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01076> a min:Passage,
