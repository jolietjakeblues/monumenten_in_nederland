        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "Woonhuizen. De rentenierswoning Kruisweg 6 is omstreeks 1885 gebouwd in eclectische stijl. Noorderweg 10 is een eenlaags dubbel woonhuis in traditionalistische vormen uit de jaren dertig."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00668> a min:Passage,
