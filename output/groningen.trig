        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0009> ;
        schema:name "Appingedam"@nl ;
        schema:pageEnd "66" ;
        schema:pageStart "66" ;
        schema:pagination "66" ;
        schema:text "De Apostolische kerk (Snelgersmastraat 2) [5] is een eenvoudige zaalkerk uit omstreeks 1895, met oprijzend middenrisaliet en woonvertrekken aan de voorzijde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00242> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Appingedam"@nl ;
        min:adres "Wijkstraat 36" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Appingedam" ;
        min:gemeenteInBoek "Appingedam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Appingedam_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Appingedam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Appingedam" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 242 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0009> ;
        schema:name "Appingedam"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Het voorm. stadhuis (Wijkstraat 36) [6] is een diep pand met schilddak en hoekschoorstenen. Het werd in 1630 gebouwd met op de begane grond de waag. De rijk versierde maniëristische voorgevel heeft een halsvormige top voorzien van klauwstukken en een open segmentvormig fronton. De boogvelden boven de vensters zijn voorzien van zandstenen schelpvormen. In een zandstenen schelpnis staat een Justitiabeeld met daaronder een afbeelding van het stadswapen. Bij een verbouwing in 1825 werd de waag verkleind en het geheel aan de achterzijde uitgebreid tot aan de kerk. In 1911 werd het gebouw gerestaureerd naar plannen van A. Mulder. Bij een restauratie in 1983 heeft men de oude kaak aan de oostmuur teruggeplaatst. Sinds 1937 dient het gebouw alleen nog voor representatieve doeleinden. In de oude raadzaal hangt een geschilderd stadsgezicht op Appingedam uit 1655, gemaakt door Claes Hendericx. De oude secretarie heeft een laat-18de-eeuwse schoorsteenboezem."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0009.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00243> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Appingedam"@nl ;
        min:adres "Wijkstraat 38" ;
        min:deel "Monumenten in Nederland. Groningen" ;
