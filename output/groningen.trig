        min:adres "Hamweg 2",
            "Hoofdweg 41" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Slochteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harkstede (gemeente Slochteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Harkstede" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 525 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0041> ;
        schema:name "Harkstede (gemeente Slochteren)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De arbeiderswoning (Hoofdweg 41), een vrijstaande woning met krimpen, werd in 1919-'21 gebouwd voor de Stichting Woningbouw Slochteren. Windmolen. ‘Stel's Meulen’ (Hamweg 2) is een achtkante stellingkorenmolen met houten achtkant op bakstenen voet. De molen werd in 1851 gebouwd voor J.G. Tipkers en kreeg in 1856 ook een koppel pelstenen. In 1861 is hij ten behoeve van mulder R.J. Kortholt omhoog gebracht en in 1982 gerestaureerd. De ernaast gelegen molenaarswoning stamt uit omstreeks 1851."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00526> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harkstede (gemeente Slochteren)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
