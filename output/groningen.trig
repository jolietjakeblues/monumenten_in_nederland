        min:soort "inleiding" ;
        min:volgnummer 797 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0086> ;
        schema:name "Noorddijk (gemeente Groningen)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "De Herv. kerk (Noorddijkerweg 14) is een eenbeukige kerk met vierzijdige koorsluiting en een toren van drie geledingen met ingesnoerd tentdak. Het huidige schip is rond 1250 gebouwd in romano-gotische stijl met siernissen, lisenen en kraalprofielen. Rond 1550 werd de kerk met één travee naar het oosten verlengd en is ook de huidige koorsluiting gebouwd. De door zandstenen waterlijsten en speklagen gelede toren, is blijkens gedenkstenen in 1648 toegevoegd en in 1735 en 1843 ingrijpend hersteld. In de toren hangt onder meer een klok uit 1660, gegoten door W. Jacobus de Vrij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00798> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noorddijk (gemeente Groningen)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noorddijk (gemeente Groningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noorddijk" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 798 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0086> ;
        schema:name "Noorddijk (gemeente Groningen)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Het kerkinterieur wordt overdekt door een stucplafond met eenvoudige rozetten uit 1894, aangebracht onder een midden-16de-eeuws balkenplafond. Op één van de vier gebrandschilderde ramen die in 1765 door Petrus van der Veen zijn vervaardigd, is de kerk weergegeven. Bij de kerkrestauratie in 1995-'97 is het karakter van het complete, 19de-eeuwse interieur behouden gebleven. Tot de inventaris behoort een neoclassicistische preekstoel uit 1840, gemaakt door A.C. Cramwinkel. Het orgel uit 1864 is door P. van Oeckelen gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0086.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00799> a min:Passage,
