        min:volgnummer 549 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0045> ;
        schema:name "Hoogezand-Sappemeer"@nl ;
        schema:pageEnd "141" ;
        schema:pageStart "141" ;
        schema:pagination "141" ;
        schema:text "De pastorie ‘Croonhoven’ (Noorderstraat 51) is een blokvormig eenlaags woonhuis met opgaande middenrisaliet uit 1838. Het is het geboortehuis van dr. Aletta Jacobs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00550> a min:Passage,
