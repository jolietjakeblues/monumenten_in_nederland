        min:provincie "Groningen" ;
        min:rijksmonumentnummer "520947" ;
        min:soort "inleiding" ;
        min:volgnummer 1012 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0118> ;
        schema:name "Ter Apel (gemeente Vlagtwedde)"@nl ;
        schema:pageEnd "202" ;
        schema:pageStart "202" ;
        schema:pagination "202" ;
        schema:text "Het R.K. St.-Luciaklooster (Kapelweg 13) is een U-vormig pand uit 1924-'25, uitgevoerd met expressionistische details naar plannen van P. Walta uit Franeker. Het klooster werd in 1971 opgeheven en het gebouw dient sinds 1979 als kantoor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01013> a min:Passage,
