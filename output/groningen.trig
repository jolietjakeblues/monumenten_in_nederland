        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Niekerk (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Niekerk" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 749 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0078> ;
        schema:name "Niekerk (gemeente De Marne)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De Zuidemaklap over het Hunsingokanaal (bij Kanaalstraat 12), gelegen ten westen van het dorp, is een ijzeren ophaalbrug uit 1879, voorzien van fraaie decoraties in giet- en smeedijzer en portaalarmen in de vorm van kandelaberzuilen. De bruggenhoofden zijn onlangs vernieuwd en in beton uitgevoerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00750> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Niekerk (gemeente De Marne) – Houwerzijl"@nl ;
        min:adres "Hoofdstraat 15",
            "Hoofdstraat 17",
            "Hoofdstraat 58" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Niekerk (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Niekerk" ;
        min:lemma "Houwerzijl" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 750 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0078> ;
        schema:name "Houwerzijl"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Houwerzijl. Dit dorp ten zuidoosten van Niekerk is ontstaan in het begin van de 19de eeuw. De voorm. Geref. kerk (Hoofdstraat 17) is een zaalkerk met geveltoren, gebouwd in 1862 en in 1906 en 1915 gerenoveerd. Op het ogenblik dient het gebouw als theeschenkerij. De ernaast gelegen neoclassicistische pastorie (Hoofdstraat 15) stamt uit 1870. Het voorm. dorpscafé (Hoofdstraat 58) is een pand met eenlaags voorhuis en een dwars geplaatst achterhuis. Het voorhuis dateert uit omstreeks 1870 en is een uitbreiding van de oudere, waarschijnlijk 18de-eeuwse, achterliggende voorm. bakkerij annex kruidenierswinkel. Het hoekpand Hoofdstraat 29 is een middenstandswoning uit omstreeks 1930 met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00751> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw Beerta (gemeente Reiderland)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Reiderland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw Beerta (gemeente Reiderland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Nieuw Beerta" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 751 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0079-01> ;
        schema:name "Nieuw Beerta (gemeente Reiderland)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Wegdorp, ontstaan op de Schanskerdijk na inpoldering van het gebied ‘de Uiterdijken’ in 1657. In 1665 verrees hier een eerste kerkje die in 1689 werd herbouwd en in 1856 opnieuw. Het dorp heeft grote boerderijen en nabij de kerk een dwarse lintbebouwing met kleine landarbeiderswoningen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00752> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw Beerta (gemeente Reiderland)"@nl ;
        min:adres "Hoofdweg 18" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Reiderland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw Beerta (gemeente Reiderland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Nieuw Beerta" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40555> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8874" ;
        min:soort "inleiding" ;
        min:volgnummer 752 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0079-01> ;
        schema:name "Nieuw Beerta (gemeente Reiderland)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "168" ;
        schema:pagination "168-169" ;
        schema:text "De Herv. kerk (Hoofdweg 18) is een door lisenen gelede zaalkerk met driezijdige sluiting, gebouwd in 1856 naar plannen van E. van der Voort. De voorgevel bevat een stichtingssteen en heeft een halsvormige beëindiging met daarachter een geveltoren voorzien van een opengewerkte lantaarn met koepelbekro-ning. De toren kreeg bij de restauratie in 1985 een nieuwe wijzerplaat. In de kerk liggen diverse zerken, waarvan de oudste uit 1705 dateert. Het orgel uit 1856-'57 werd gemaakt door W. Hardorff."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0079.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00753> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuw Beerta (gemeente Reiderland) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Reiderland" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nieuw Beerta (gemeente Reiderland)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Nieuw Beerta" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 753 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0079-01> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Woonhuizen. In het dorp staat een aantal rijke woonhuizen met fraaie tuinen in Engelse landschapsstijl; eclectisch van vorm is Hoofdweg 93 (circa 1880), neoclassicistisch van vorm is Hoofdweg 22 (circa 1890), chalet-details heeft de villa Verlengde Hoofdweg 9 (circa 1915) en jugendstil-invloeden heeft Verlengde Hoofdweg 3 (1913). Het laatstgenoemde huis heeft een tuin naar plannen van J. Vroom."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0079.php> .

