        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 678 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0066> ;
        schema:name "Nijverheid"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Nijverheid. Het schildersbedrijf met woon- en winkelpand Hereweg 308 werd rond 1920 gebouwd. Het vijf bouwlagen hoge graanpakhuis (bij Hereweg 113) verrees in 1918 in opdracht van graanhandelaar H. Bos, die gelijktijdig aan de weg voor zichzelf een directeurswoning (Hereweg 113) liet bouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0066.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00679> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meedhuizen (gemeente Delfzijl)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meedhuizen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Meedhuizen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 679 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0067-01> ;
        schema:name "Meedhuizen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Dorp, ontstaan in de 13de eeuw. De bescheiden kern kwam enigszins tot ontwikkeling na het graven van het Afwateringskanaal van Duurswold in 1869-'71. Na de Tweede Wereldoorlog is het dorp naar het zuiden uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00680> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meedhuizen (gemeente Delfzijl)"@nl ;
        min:adres "Hoofdstraat 6" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meedhuizen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Meedhuizen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 680 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0067-01> ;
        schema:name "Meedhuizen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "De Herv. kerk (Hoofdstraat 6) is een zaalkerk voorzien van een ongelede toren met ingesnoerde spits. Delen van het muurwerk van de kerk zouden nog uit de 13de eeuw stammen. Aan de oostzijde zijn nog twee dichtgemaakte, oorspronkelijke vensters zichtbaar. Bij een ingrijpende verbouwing in 1703 zijn de topgevels en de gewelven verwijderd. In 1803 voegde men de westtoren toe, die bij de vernieuwing van de kap in 1833 wat is verhoogd en in 1928 is omklampt. Tot de inventaris behoort een eenvoudige laat-17de- of vroeg- 18de-eeuwse preekstoel. In de vloer ligt een gebeeldhouwde zerk voor ds. Jacobus Ringels (†1742)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00681> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meedhuizen (gemeente Delfzijl)"@nl ;
        min:adres "Ideweersterweg 12" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meedhuizen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Meedhuizen" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 681 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0067-01> ;
        schema:name "Meedhuizen (gemeente Delfzijl)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Het voorm. station Tjuchem-Meedhuizen (Ideweersterweg 12) aan de Woldjerspoorlijn werd in 1927 gebouwd, waarschijnlijk naar ontwerp van A. van der Steur in licht expressionistische vormen. Na de opheffing van de spoorlijn in 1941 is het pand tot woning verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00682> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Meedhuizen (gemeente Delfzijl) – Tjuchem"@nl ;
        min:adres "Hoofdweg 28",
            "Hoofdweg 37" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meedhuizen (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Meedhuizen" ;
        min:lemma "Tjuchem" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 682 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0067-01> ;
        schema:name "Tjuchem"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Tjuchem (gem. Slochteren). Dit dorp ten westen van Meedhuizen kwam aan het eind van de 19de eeuw tot verdere ontwikkeling bij de wegovergang van het in 1869-'71 gegraven Afwateringskanaal van Duurswold. De Herv. kerk (Hoofdweg 37) is een zaalkerk met slanke dakruiter, gebouwd in 1928 in expressionistische vormen. Het Leninbeeld (bij Hoofdweg 28), werd in 1997 voor en door de firma Koop Tjuchem geplaatst en komt uit Meerseburg (voormalige DDR) waar het vanaf de jaren zestig stond."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0067.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00683> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mensingeweer (gemeente De Marne)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mensingeweer (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Mensingeweer" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 683 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0068> ;
        schema:name "Mensingeweer (gemeente De Marne)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Wierdedorp, ontstaan in de middeleeuwen. Eerst concentreerde de bebouwing van het kleine dorp zich rond de kerk, maar na de aanleg van de provinciale trekvaart tussen Winsum en Ulrum in 1663 kwam er nieuwe bebouwing in oostelijke richting langs het water. Omdat de verhoogde Schouwerzijlsterweg-Mensingeweersterweg diende als scheiding tussen twee zijlvesten, werd ter plaatse van de trekvaart een dam aangelegd, die pas in 1860 door een brug werd vervangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00684> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mensingeweer (gemeente De Marne)"@nl ;
        min:adres "Hoofdstraat 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mensingeweer (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Mensingeweer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24571>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33206> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "24004",
            "509500" ;
        min:soort "inleiding" ;
        min:volgnummer 684 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill229> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0068> ;
        schema:name "Mensingeweer (gemeente De Marne)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "De Herv. kerk (Hoofdstraat 1) is een recht gesloten zaalkerk voorzien van een ongelede westtoren met achtzijdige spits. Het in de kern nog middeleeuwse kerkgebouw is rond 1840 ingrijpend in neoclassicistische trant verbouwd, met uitzondering van de achter de 18de-eeuwse toren verscholen westgevel. Tot de inventaris behoort een preekstoel uit 1743 naar ontwerp van Jan Bitter met snijwerk van Casper Struiwig. Het orgel werd in 1698 door Arp Schnitger gebouwd voor de Herv. kerk te Pieterburen, in 1772 door A.A. Hinsz aangepast en in 1901 te Mensingeweer geplaatst. Op het kerkhof liggen enkele 19de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00685> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mensingeweer (gemeente De Marne)"@nl ;
        min:adres "Molenweg 8",
            "Molenweg 9" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mensingeweer (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Mensingeweer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48592> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "46779" ;
        min:soort "inleiding" ;
        min:volgnummer 685 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0068> ;
        schema:name "Mensingeweer (gemeente De Marne)"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Op de Alg. begraafplaats (Molenweg ong.), aangelegd in het tweede kwart van de 1hment voor I.B. Keiser (†1867), gemaakt door de gieterij Ten Oever en Koning te Martenshoek. De windmolen ‘Hollands Welvaart’ (Molenweg 9) is een met hout beklede achtkante stellingkoren- en pelmolen op bakstenen onderbouw. De molen werd in 1855 gebouwd door en voor molenmaker H. ten Have. De molenaarswoning (Molenweg 8) is een eenlaags dwars huis met wolfdak en een erachter gelegen schuur. Het geheel werd omstreeks 1860 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00686> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Mensingeweer (gemeente De Marne) – Boerderijen"@nl ;
        min:adres "Matthenesserweg 1",
            "Schouwerzijlsterweg 13",
            "Schouwerzijlsterweg 6",
            "Wildeveldseweg 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Mensingeweer (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Mensingeweer" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28953>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42193>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58101> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "24006",
            "39043",
            "510815" ;
        min:soort "lemma" ;
        min:volgnummer 686 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0068> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Boerderijen. In de omgeving van Mensingeweer ligt een aantal interessante kop-hals-romp-boerderijen. De boerderij Rollingeweer (Schouwerzijlsterweg 13) heeft een diep eenlaags voorhuis uit omstreeks 1855. Uit omstreeks 1870 dateert de boerderij Hooge Laand (Schouwerzijlsterweg 6), met een bijschuur uit dezelfde tijd. Boerderij Schouwerzijlsterweg 1 heeft een eenlaags voorhuis in eclectische trant uit omstreeks 1885. De boerderij Matthenesse (Matthenesserweg 1) werd in opdracht van S. Wijk gebouwd ter vervanging van het schathuis van de in 1872 gesloopte borg Matthenesse. De in 1923 verbouwde boerderij heeft een onderkelderd dwars voorhuis met neoclassicistische elementen. Een 19de-eeuwse kopromp-boerderij is de Hylkemaheerdt (Wildeveldseweg 2), met dwars geplaatst voorhuis voorzien van een schilddak. Op het erf staat een grote bijschuur uit omstreeks 1895. Een 19de-eeuwse boerderij van het Oldambster type is Wildeveldseweg 1, waarvan het voorhuis een halfrond gesloten, omlijste ingang heeft."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0068.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00687> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middelbert (gemeente Groningen)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middelbert (gemeente Groningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Middelbert" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 687 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0069-01> ;
        schema:name "Middelbert (gemeente Groningen)"@nl ;
        schema:pageEnd "161" ;
        schema:pageStart "161" ;
        schema:pagination "161" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen ten oosten van de Hunze, toen dit moerassige en beboste veengebied vanaf de woonkernen aan de Hunze in ontginning werd gebracht. De naam Middelbert komt in de 10de of 11de eeuw als ‘Middisché’ (Middijk) voor. De achtervoeging ‘bert’ betekent ‘buurt’. De bebouwing van het wegdorp ligt hoofdzakelijk langs de Middelberterweg. Ten noorden van de kerk loopt nog een kerkenpad uit de richting Klein-Harkstede - voorheen ook verder richting Euvelgunne."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0069.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00688> a min:Passage,
