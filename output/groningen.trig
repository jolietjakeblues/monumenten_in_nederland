        schema:name "Westeremden (gemeente Loppersum)"@nl ;
        schema:pageEnd "225" ;
        schema:pageStart "225" ;
        schema:pagination "225" ;
        schema:text "De in 1912 afgebroken oude pastorie (Abt Emopad 2) is tussen 1974 en 1985 herbouwd door de schilder H. Helmantel in de vorm van het oorspronkelijke 14de-eeuwse Krüselwarck, met een hoogrijzend dwars voorhuis en een haaks daarop staande schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0139.php> .

