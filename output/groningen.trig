        schema:name "Bedum"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "Achter de kerk ligt de in 1876 aangelegde R.K. begraafplaats met 19de-eeuwse grafmonumenten en zerken, waaronder enkele pastoorsgraven. Verder is er een kruisvormige neogotische kapel uit 1878, gebouwd naar ontwerp van J. Balvert."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00269> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bedum"@nl ;
        min:adres "Grotestraat 33" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Bedum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bedum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bedum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 269 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0011> ;
        schema:name "Bedum"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "De (Geref.) Maranatha- of Oosterkerk (Grotestraat 33) is een grote zaalkerk met dwarspanden en een ongelede toren met achtkante, ingesnoerde spits. De kerk werd gebouwd in 1876 naar ontwerp van H. Wind in eclectische stijl. In 1921 werd de zaalkerk verbouwd en vergroot met dwarspanden naar ontwerp van A.W. Kuiler en L. Drewes te Groningen. In 1966 is de kerk opnieuw ingrijpend veranderd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00270> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bedum"@nl ;
        min:adres "Schultingastraat 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Bedum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bedum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bedum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54081> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "510684" ;
        min:soort "inleiding" ;
        min:volgnummer 270 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0011> ;
        schema:name "Bedum"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text "De (Geref.) Goede Herder- of Noorderkerk (Schultingastraat 1) is een recht gesloten kruiskerk met een forse ongelede toren voorzien van een zadeldak. De toren staat asymmetrisch tegen een van de gevels. De kerk werd in 1938 gebouwd naar ontwerp van E. Reitsma en A. Wiersema in een sobere vormgeving met expressieve elementen. Tot de inventaris behoren een preekstoel door K. Drijfhout (1938) en een door de firma Valckx & Van Kouteren gebouwd orgel (1942). De gebrandschilderde ramen zijn ontworpen door E. Reitsma (1938). Het gebouw staat op een punt waar vijf straten samenkomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00271> a min:Passage,
