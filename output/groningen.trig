        schema:name "'t Zandt (gemeente Loppersum)"@nl ;
        schema:pageEnd "238" ;
        schema:pageStart "238" ;
        schema:pagination "238" ;
        schema:text "De voorm. sarrieshut (Schatsborgerweg 4) is een eenvoudig 17de-eeuws pand met een topgevel die voorzien is van vlechtingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01256> a min:Passage,
