        min:gemeenteInBoek "Vlagtwedde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bourtange (gemeente Vlagtwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bourtange" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 309 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill89> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0017> ;
        schema:name "Bourtange (gemeente Vlagtwedde)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "78" ;
        schema:pagination "78" ;
        schema:text "De voorm. synagoge (Batterijenstraat 2) is een gepleisterd zaalgebouw met spitsboogvensters en gietijzeren traceringen, ontstaan in 1842 door verbouwing van een ouder pand. Bij een verbouwing in 1875, waarvan een gevelsteen met de tekst van Psalm 55:15 getuigt, voegde men ook een mikwa toe. Na sinds 1913 als woonhuis te hebben gediend, is het pand in 1974 gerestaureerd en als vestingmuseum in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0017.php> .

