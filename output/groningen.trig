        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0034-01> ;
        schema:name "Garsthuizen (gemeente Loppersum)"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "De boerderij ‘Groot Karshof’ (Karshofweg 2), gelegen op een omgracht erf, dateert uit omstreeks 1870. Ze heeft een dwars geplaatst, onderkelderd eenlaags voorhuis met wolfdak en gepleisterde vensteromlijstingen. In de jaren dertig zijn de bestaande schuren verbouwd tot een driekapsschuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00408> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Garsthuizen (gemeente Loppersum) – Windmolen"@nl ;
        min:adres "Smydingeweg 39",
            "Smydingeweg 44" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Garsthuizen (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Garsthuizen" ;
