        schema:pageEnd "158" ;
        schema:pageStart "158" ;
        schema:pagination "158" ;
        schema:text "De Geref. kerk (Kruisweg 30) werd omstreeks 1930 gebouwd op een T-vormige plattegrond; ze heeft een ongelede toren met spits."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0065.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00667> a min:Passage,
