        min:hoofdstuk "Steden, dorpen, monumenten › Zoutkamp (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zoutkamp" ;
        min:lemma "Hotel-café" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77658> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "35875" ;
        min:soort "lemma" ;
        min:volgnummer 1275 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0153> ;
        schema:name "Hotel-café"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text """Hotel-café ‘De Zeearend’ (Dorpsplein 1) dateert uit 1929 en is opgetrokken in een strakke zakelijke vormgeving. Voor de grote vensters van de gelagkamer is een terras aangelegd.

De voorm. loods van de Rijksbetonningsdienst (Reitdiepskade 11) dateert uit omstreeks 1875. Het houten gebouw met stenen voet en omlopend schilddak dient nu als visserijmuseum en VVV-kantoor."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01276> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zoutkamp (gemeente De Marne) – Sluizen"@nl ;
        min:adres "Hoofdstraat 36" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoutkamp (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zoutkamp" ;
        min:lemma "Sluizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14221> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "509508" ;
        min:soort "lemma" ;
        min:volgnummer 1276 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill374> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0153> ;
        schema:name "Sluizen"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text """Sluizen. De blijkens een stichtingssteen uit 1858 daterende sluis in het Hunsingokanaal (Hunsingoweg ong.) werd aangelegd aan de mond van het in 1856 gegraven Hunsingokanaal in de bestaande dijk langs het Reitdiep. Bij de sluis bevinden zich een houten eenlaags sluiswachtershuisje en een ijzeren draaibrug uit dezelfde tijd. De Provinciesluis (Sluisweg ong.) is een schutsluis uit 1876, gebouwd toen het Reitdiep werd afgesloten. De sluishoofden zijn voorzien van waaierdeuren.

De Alg. begraafplaats (tegenover Hoofdstraat 36), aangelegd omstreeks 1882, heeft een eenvoudig baarhuisje en toegangshek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

