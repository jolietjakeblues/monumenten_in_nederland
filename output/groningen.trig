        schema:name "Niekerk (gemeente De Marne)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op twee kleine wierden op een oeverwal. De middeleeuwse kerk heeft het kleine dorp zijn naam gegeven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00745> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Niekerk (gemeente De Marne)"@nl ;
        min:adres "Kerkstraat 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Niekerk (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Niekerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18479> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "31408" ;
        min:soort "inleiding" ;
        min:volgnummer 745 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill244> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0078> ;
        schema:name "Niekerk (gemeente De Marne)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "De Herv. kerk (Kerkstraat 3) is een kleine, recht gesloten zaalkerk; de ongelede toren is voorzien van een achtkante, ingesnoerde spits. Het muurwerk van de kerk is 13de-eeuws. Bij een ingrijpende verbouwing in 1629, in opdracht van Evert Lewe, is de toren nieuw opgetrokken. In de toren hangt een klok uit 1762, gegoten door A. Petit. Tot de kerkinventaris behoren een herenbank met het alliantiewapen van het echtpaar Van In- en Kniphuizen-Lewe (vroeg-18de-eeuws), een eenvoudige preekstoel (laat-18de-eeuws) en een door P. van Oeckelen gebouwd orgel (1883). De kerkvloer bevat een aantal zerken, waarvan de oudste uit 1564 dateert."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

