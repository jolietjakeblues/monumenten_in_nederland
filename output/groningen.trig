        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill344> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0138> ;
        schema:name "Westerbroek (gemeente Hoogezand-Sappemeer)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "Dijkdorp, ontstaan in de late middeleeuwen als veenontginning vanuit de Hunze, waarbij de Oudeweg als achterkade werd opgeworpen. Daar is later een langgerekte bebouwing ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0138.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01162> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbroek (gemeente Hoogezand-Sappemeer)"@nl ;
        min:adres "Oudeweg 75" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Hoogezand-Sappemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westerbroek (gemeente Hoogezand-Sappemeer)" ;
