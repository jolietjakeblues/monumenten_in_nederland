        min:volgnummer 566 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0046> ;
        schema:name "Poldermolen"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "Poldermolen. Ten westen van Hoogkerk ligt de ‘Zuidwendinger poldermolen’ (Hoendiep 6). Het is een met riet gedekte achtkante bovenkruier op veldmuren, gebouwd in 1819 door de molenmakers L.B. Woldring en B.E. Sonius."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0046.php> .

