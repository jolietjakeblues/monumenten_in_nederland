        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0045> ;
        schema:name "Hoogezand-Sappemeer"@nl ;
        schema:pageEnd "142" ;
        schema:pageStart "142" ;
        schema:pagination "142" ;
        schema:text "De pastorie (Noorderstraat 154) stamt uit de jaren twintig. Op het nabijgelegen kerkhof staat bij de toegang een H. Hartbeeld uit 1924 van de hand van A. Falise, en op het kerkhof een kruisbeeld met pastoorsgraven en een bidkapel met Piëta uit de jaren twintig."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0045.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00553> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoogezand-Sappemeer"@nl ;
        min:adres "Sluisweg 47" ;
        min:deel "Monumenten in Nederland. Groningen" ;
