        schema:name "Zoutkamp (gemeente De Marne)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Het herenhuis ‘De Batterij’ (Sluisweg 22) is een aan de dijk gelegen, gepleisterd, blokvormig eenlaags pand uit omstreeks 1880. Het heeft waarschijnlijk als dienstwoning bij de Provinciale Sluis gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01275> a min:Passage,
            schema:CreativeWork ;
