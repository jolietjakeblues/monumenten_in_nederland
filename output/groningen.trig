        schema:name "Niekerk (gemeente De Marne)"@nl ;
        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Op het kerkhof liggen verschillende 19de-eeuwse graven. De pastorie (Kerkstraat 7) is een deels eenlaags, deels tweelaags pand uit 1928, gebouwd naar ontwerp van W. Reitsema in de trant van het Nieuwe Bouwen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0078.php> .

