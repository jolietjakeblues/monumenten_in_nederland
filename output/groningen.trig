        min:gemeenteInBoek "Eemsmond" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Roodeschool (gemeente Eemsmond)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Roodeschool" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 903 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0104> ;
        schema:name "Roodeschool (gemeente Eemsmond)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Geref. kerk (Vrijgemaakt) (Hooilandseweg 82) is een uit 1871 daterend gebouw met T-vormige plattegrond. De voorgevel is voorzien van gepleisterde decoraties met neoclassicistische elementen en wordt bekroond door een dakruiter met spits. De pastorie (Hooilandseweg 84), een eenlaags pand met verhoogd middengedeelte en afgeknot schilddak, dateert uit omstreeks 1900. Boven de getoogde vensters zijn wenkbrauwen aangebracht. De ingang en de dakkapel zijn van omlijstingen voorzien."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00904> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Roodeschool (gemeente Eemsmond)"@nl ;
        min:adres "Hooilandseweg 75" ;
