        schema:pageStart "198" ;
        schema:pagination "198" ;
        schema:text "Scholen. De voorm. openbare lagere school (Klokkenpad 1), rond 1880 gebouwd als drieklassige school, is nu deels in gebruik als brandweerkazerne. De Chr. lagere school (Bedumerweg 33) is een middengangschool met voorportaal uit 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0115.php> .

