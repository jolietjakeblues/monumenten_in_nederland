        schema:name "Vlagtwedde"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "De Geref. kerk (Vledderkamp 60) is een zaalkerk met geveltoren, gebouwd omstreeks 1920. De kerk bevat een orgel uit de tweede helft van de 18de eeuw, dat in 1904 bij plaatsing in de Geref. kerk te Emmen door J. Proper werd aangepast en rond 1935 naar deze kerk kwam."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0131.php> .

