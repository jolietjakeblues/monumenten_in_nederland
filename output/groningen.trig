        schema:name "Oude Pekela (gemeente Pekela)"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De voorm. Luth. kerk (H. Hinderstraat 20) is een simpele zaalkerk uit 1916 en heeft een geveltoren voorzien van ingezwenkte spits. Het gebouw is nu in gebruik als Herv. kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0099.php> .

