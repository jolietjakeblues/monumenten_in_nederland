        min:rijksmonumentnummer "22271" ;
        min:soort "lemma" ;
        min:volgnummer 606 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0054> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "149" ;
        schema:pageStart "149" ;
        schema:pagination "149" ;
        schema:text "Windmolen ‘De Hoop’ (Woldweg 70), een bovenkruier zonder stelling, heeft een met riet gedekte achtkante romp op houten voet. Ter vervanging van een afgebrande grondmolen - die van vóór 1787 dateerde - werd in 1923 de huidige korenmolen gebouwd voor C. Schutte door molenmaker Hazenberg, met gebruikmaking van delen van de oliemolen ‘De Hoop’ uit Vierverlaten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0054.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00607> a min:Passage,
