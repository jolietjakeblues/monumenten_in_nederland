        min:soort "inleiding" ;
        min:volgnummer 406 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0034-01> ;
        schema:name "Garsthuizen (gemeente Loppersum)"@nl ;
        schema:pageEnd "91" ;
        schema:pageStart "91" ;
        schema:pagination "91" ;
        schema:text "Het woonhuis Smydingeweg 2, een eenvoudig dwars eenlaags pand met afgewolfd zadeldak, heeft in de zijgevel de jaartalankers ‘1758’. Het pand is later achter uitgebreid. Links staat een schuur met wolfdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0034.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00407> a min:Passage,
