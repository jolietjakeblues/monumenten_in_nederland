        schema:name "Oostum (gemeente Winsum)"@nl ;
        schema:pageEnd "181" ;
        schema:pageStart "181" ;
        schema:pagination "181" ;
        schema:text "De boerderij ‘Reighes-stede’ (Oostumerweg 16) is een kop-hals-rompboerderij uit 1805, uitgebreid in 1827. In de voorgevel zit een als gevelsteen toegepast zandstenen schouwfries uit 1561."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0096.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00860> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oostum (gemeente Winsum) – Huis Dageraad"@nl ;
        min:adres "Oostumerweg 35" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oostum (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Oostum" ;
        min:lemma "Huis Dageraad" ;
