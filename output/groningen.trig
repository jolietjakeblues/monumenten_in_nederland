        min:hoofdstuk "Steden, dorpen, monumenten › Zeerijp (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zeerijp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1260 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0151> ;
        schema:name "Zeerijp (gemeente Loppersum)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "De vrijstaande toren ten zuidwesten van de kerk heeft twee geledingen en een tentdak. De gotische toren stamt waarschijnlijk uit de eerste helft van de 15de eeuw. In 1608 is de toren gerepareerd en in 1664 kreeg hij een nieuwe spits. Het tentdak stamt uit 1834 toen de toren werd ingekort. In de toren hangen drie klokken, twee moderne en één uit 1502, gegoten door Geert van Wou."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01261> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeerijp (gemeente Loppersum)"@nl ;
        min:adres "Borgweg 10" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Eemsdelta" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eemsdelta> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeerijp (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zeerijp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17529> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "40307" ;
        min:soort "inleiding" ;
        min:volgnummer 1261 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0151> ;
        schema:name "Zeerijp (gemeente Loppersum)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "Het ruime kerkhof heeft een smeedijzeren hek tussen hardstenen palen, daar geplaatst in 1793-'95 en mogelijk afkomstig van de toen gesloopte borg Haykema. Op het kerkhof bevinden zich een baarhuisje uit 1893 en enkele interessante grafzerken. De pastorie (Borgweg 10) is een blokvormig pand met schilddak en hoekschoorstenen uit het midden van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01262> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeerijp (gemeente Loppersum)"@nl ;
        min:adres "Borgweg 30",
            "Borgweg 32" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Eemsdelta" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Eemsdelta> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeerijp (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zeerijp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1262 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0151> ;
        schema:name "Zeerijp (gemeente Loppersum)"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text "De Doopsgez. kerk (Borgweg 32) is een zaalkerk uit 1847. De nieuwe voorgevel met neogotische motieven is in 1904 opgetrokken naar plannen van O. de Leeuw Wieland. Ook door hem ontworpen is de uit 1885 daterende pastorie (Borgweg 30), een eenlaags pand in neoclassicistische vormen met verhoogd middenrisaliet."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01263> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeerijp (gemeente Loppersum) – Woonhuizen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
