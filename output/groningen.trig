        min:volgnummer 801 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0087> ;
        schema:name "Noordhorn (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Wegdorp, ontstaan in de middeleeuwen op een brede zandrug of gast. De bebouwing is geconcentreerd langs de Langestraat en de Nieuwstraat en waaiert uit langs de uitvalswegen. Sinds de jaren dertig van de 20ste eeuw wordt het dorp door het Van Starkenborghkanaal gescheiden van Zuidhorn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00802> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordhorn (gemeente Zuidhorn)"@nl ;
        min:adres "Torenstraat 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
