        schema:text "Café-restaurant ‘Neptunus’ (Noorderstraat 1) is een rond 1875 gebouwd blokvormig neoclassicistisch pand met twee evenwijdige zadeldaken en hoekschoorstenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0127.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01081> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ulrum (gemeente De Marne) – Woonhuizen"@nl ;
        min:adres "Marktstraat 2",
            "Spoorstraat 13",
            "Spoorstraat 28",
