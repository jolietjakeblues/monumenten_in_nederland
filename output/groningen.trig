        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 777 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0083> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Woonhuizen. Het in neorenaissance-vormen uitgevoerde huis Hoofdweg Oost 20 stamt uit circa 1900. De uit 1908 daterende rentenierswoning Hoofdweg Oost 28 vertoont jugendstil-elementen. Eenvoudige, maar goed gedetailleerde, expressionistische elementen heeft het pand Hoofdstraat 113 uit 1930, gebouwd naar plannen van E. Rozema."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00778> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nieuwolda (gemeente Scheemda) – Boerderijen"@nl ;
        min:adres "Hoofdweg Oost 1",
            "Hoofdweg West 21",
            "Kerkelaan 1" ;
