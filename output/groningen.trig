        min:hoofdstuk "Steden, dorpen, monumenten › Sauwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Sauwerd" ;
        min:lemma "Klein Wetsinge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33722>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56050> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "510816",
            "7066" ;
        min:soort "lemma" ;
        min:volgnummer 915 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill280> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0106> ;
        schema:name "Klein Wetsinge"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "187" ;
        schema:pagination "187-188" ;
        schema:text "Klein Wetsinge. Dit dorp ten noorden van Sauwerd is ontstaan in de 19de eeuw. De Herv. kerk (Valgeweg 12) is een zaalkerk met recht gesloten koor en dakruiter, gebouwd rond 1840 in neoclassicistische trant. De kerk verving de toen afgebroken oude kerken in Groot-Wetsinge en Sauwerd. De windmolen ‘Eureka’ (Molenstreek 3) is een met hout beklede achtkante stellingkoren- en pelmolen op bakstenen onderbouw. Getuige de sluitsteen van de inrijpoort werd de molen in 1872 gebouwd voor J. Oomkes en H. Oosterhof. De ernaast gelegen voorm. molenaarswoning (Molenstreek 5) stamt waarschijnlijk uit dezelfde tijd. De molen is in 1987-'88 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0106.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00916> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sauwerd (gemeente Winsum) – Groot Wetsinge"@nl ;
        min:adres "Karspelweg 2",
            "Karspelweg 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Sauwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Sauwerd" ;
        min:lemma "Groot Wetsinge" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14091>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/18056> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "7067",
            "7068" ;
        min:soort "lemma" ;
        min:volgnummer 916 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0106> ;
        schema:name "Groot Wetsinge"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "Groot Wetsinge. Dit dorp ten noorden van Sauwerd en Klein-Wetsinge is ontstaan in de middeleeuwen. Op het voorm. Herv. kerkhof bevindt zich een aantal gietijzeren graftekens uit 1870. De plattegrond van de in 1840 gesloopte middeleeuwse kerk is gemarkeerd. De voorm. pastorie (Karspelweg 2) bestaat uit een gepleisterd eenlaags voorhuis met schilddak met omlijste ingang, via een tussenlid verbonden met een driebeukige schuur. De gepleisterde muren van het voorhuis zijn opgemetseld met hergebruikte kloostermoppen. De sporen van smalle kloostervensters kunnen wijzen op een 17de-eeuwse kern. Het pand is in 1884 ingericht als boerderij annex smederij. De voorm. school en kosterij (Karspelweg 3), een langgerekt eenlaags dwars pand met zadeldak tussen trapgevels, is in 1990 geheel nieuw opgetrokken in de oorspronkelijke vroeg-17de-eeuwse vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0106.php> .

