        schema:name "Noordbroek (gemeente Menterwolde)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De pastorie (Noorderstraat 1) is een fors blokvormig pand met omlijste ingang uit 1823. Het catechisatiegebouw annex de kosterwoning (Noordersingel 1) stamt uit 1843."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

