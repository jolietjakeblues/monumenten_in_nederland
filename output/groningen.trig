        schema:name "Lutjegast (gemeente Grootegast)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "De pastorie (A. Tasmanweg 50) is een vrijstaand pand met hoog een opgaand middenrisaliet, gebouwd in eclectische vormen rond 1885."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00659> a min:Passage,
