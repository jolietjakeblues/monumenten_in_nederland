        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Geref. kerk (Kerkstraat 12) is een forse zaalkerk, gebouwd in 1898 naar ontwerp van A.W. Kuiler en L. Drewes met neogotische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0106.php> .

