        schema:name "Beerta (gemeente Reiderland)"@nl ;
        schema:pageEnd "74" ;
        schema:pageStart "74" ;
        schema:pagination "74" ;
        schema:text "De vrijstaande toren (Hoofdstraat 257) van drie geledingen en een afgeknot tentdak met open spitsje werd in 1806 gebouwd en staat op enige afstand ten noordwesten van de kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0012.php> .

