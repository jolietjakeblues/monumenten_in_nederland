        min:kern "Bellingwolde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38231> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8899" ;
        min:soort "inleiding" ;
        min:volgnummer 286 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0013> ;
        schema:name "Bellingwolde (gemeente Bellingwedde)"@nl ;
        schema:pageEnd "75" ;
        schema:pageStart "75" ;
        schema:pagination "75" ;
        schema:text "Het voorm. rechthuis van Westerwolde (Hoofdweg 235) is een rechthoekig gebouw met trapgevels geleed door zaagtandlijsten en - voor Groningen gebruikelijke - kloostervensters. Het in 1956-'57 ingrijpend gerestaureerde pand draagt de jaartalankers ‘1643’, maar de kern is vermoedelijk ouder. Oorspronkelijk bestond het uit een zaal en een gedeelte met kelder en opkamer. Het rechthuis werd gebruikt door de drost van Wedde. Sinds de verplaatsing van het gerecht naar Winschoten in 1811 dient het als woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

