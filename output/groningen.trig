        min:kern "Noordbroek" ;
        min:lemma "Windmolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34297>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62093> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "31617",
            "31623" ;
        min:soort "lemma" ;
        min:volgnummer 795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0085> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "173" ;
        schema:pagination "173-174" ;
        schema:text "Windmolens. De achtkante stellingkoren- en pelmolen De Noordstar (Molenlaan 3) heeft een met riet gedekte romp op bakstenen voet. De molen werd in 1849 gebouwd voor J.N. Mulder. De molenaarswoning (Molenlaan 4) stamt uit dezelfde tijd. De Noordermolen (Hamrik 2), gelegen ten noordoosten van Noordbroek in Noordbroeksterhamrik, is een met riet gedekte achtkante bovenkruier op veldmuren, voorzien van een vijzel. De molen werd in 1805 gebouwd ter ontwatering van de Noordermolenkoloniepolder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00796> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noorddijk (gemeente Groningen)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Groningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noorddijk (gemeente Groningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noorddijk" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 796 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0086> ;
        schema:name "Noorddijk (gemeente Groningen)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen, toen vanaf de Hunze het oostelijk gelegen moerassige en beboste veengebied in ontginning werd gebracht. Dit wegdorp ontwikkelde zich langs de voormalige (achter)dijk. De bebouwing bestaat voornamelijk uit enkele boerderijen en de kerk. Na de samenvoeging in 1969 met de gemeente Groningen is aan de zuidwestzijde de wijk Lewenborg ontstaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0086.php> .

