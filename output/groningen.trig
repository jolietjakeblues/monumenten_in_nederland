        rdfs:label "Bedum – Hotel 't Gemeentehuis"@nl ;
        min:adres "Grotestraat 2",
            "Schoolstraat 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Bedum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bedum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Bedum" ;
        min:lemma "Hotel 't Gemeentehuis" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12724>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21754> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "510678",
            "510681" ;
        min:soort "lemma" ;
        min:volgnummer 271 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill77> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0011> ;
        schema:name "Hotel 't Gemeentehuis"@nl ;
        schema:pageEnd "72" ;
        schema:pageStart "72" ;
        schema:pagination "72" ;
        schema:text """Hotel 't Gemeentehuis (Grotestraat 2) is een breed hoekpand met kroonlijst en afgeplat schilddak, gebouwd omstreeks 1870 met eclectische details. Het gebouw is diverse keren verbouwd. Een deel van de verdieping was tot 1928 in gebruik als raadhuis. De zuidgevel kraagt ter hoogte van de eerste verdieping uit op troggewelven, ondersteund door gietijzeren zuilen. De dubbele schuurdeuren behoren vermoedelijk bij een geknikte doorrit.

Het huidige raadhuis (Schoolstraat 1) is een fors blokvormig pand met omgaand mansardedak, gebouwd in 1927-'28 naar ontwerp van G. Koolhof in expressionistische trant. Het front heeft een middenrisaliet met gebroken geveltop, waarin het wapen van Bedum is aangebracht."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0011.php> .

