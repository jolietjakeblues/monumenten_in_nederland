        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0124> ;
        schema:name "Uithuizen (gemeente Eemsmond)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "De Doopsgez. kerk (Mennonietenkerkstraat 12) is een uit 1868 daterende, driezijdig gesloten zaalkerk met rondboogvensters voorzien van gietijzeren traceringen en aan de voorzijde een gepleisterde schoudergevel. Tot de inventaris behoren een neoclassicistische preekstoel (eerste helft 19de eeuw) en een orgel uit 1916."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01057> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Uithuizen (gemeente Eemsmond) – Raadhuizen"@nl ;
        min:adres "Hoofdstraat West 11" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Eemsmond" ;
