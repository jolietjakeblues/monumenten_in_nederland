        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "De Herv. kerk (B. Kuiperweg 14) is een eenvoudige zaalkerk met dakruiter uit 1870. De voorgevel is later vernieuwd. Tot de inventaris behoort een 17de-eeuwse preekstoelkuip."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0117.php> .

