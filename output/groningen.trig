        min:soort "inleiding" ;
        min:volgnummer 526 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0041> ;
        schema:name "Harkstede (gemeente Slochteren)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Het starthuisje (Kooilaan ong.) bij de roeibaan aan het Grunostrand dateert uit 1991. Het is door J. Körmeling op modern functionele wijze vorm gegeven en dient tevens als kunstobject ter verfraaiing van de roeibaan."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00527> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harkstede (gemeente Slochteren) – Scharmer"@nl ;
        min:adres "Hoofdweg 125" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Slochteren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Harkstede (gemeente Slochteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Harkstede" ;
        min:lemma "Scharmer" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 527 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill187> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0041> ;
        schema:name "Scharmer"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Scharmer. Dit wegdorp ten zuiden van Harkstede wordt in 1231 voor het eerst genoemd. Na kerkelijke samensmelting met Harkstede heeft men in 1824 de rijzige romano-gotische kerk uit 1296 afgebroken. Op het kerkhof (tegenover Hoofdweg 125) liggen nog enkele oude zerken, waaronder die van Atke Douma (†1605), Anna Jacomina Basse (†1731) en ds. Tammo Oomkes (†1759)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0041.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00528> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiligerlee (gemeente Scheemda)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiligerlee (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Heiligerlee" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 528 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0042> ;
        schema:name "Heiligerlee (gemeente Scheemda)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Wegdorp - oorspronkelijk Oosterlee geheten - ontstaan op een van de hoogste delen van het zogeheten schiereiland van Winschoten, nabij een in 1239 gesticht premonstraterinnenklooster. Bij dit klooster vond op 23 mei 1568 de Slag bij Heiligerlee plaats - de eerste slag van de Tachtigjarige Oorlog - waarbij Lodewijk van Nassau de Spaanse troepen versloeg. Het nonnenklooster werd in de 18de eeuw gesloopt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00529> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiligerlee (gemeente Scheemda)"@nl ;
        min:adres "Provincialeweg 7" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiligerlee (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Heiligerlee" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17195> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "522099" ;
        min:soort "inleiding" ;
        min:volgnummer 529 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0042> ;
        schema:name "Heiligerlee (gemeente Scheemda)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Het monument voor Graaf Adolf van Nassau (tegenover Provincialeweg 7) is opgericht voor de bij de slag gesneuvelde broer van Willem van Oranje. Het huidige monument werd in 1873 onthuld en verving een uit 1826 stammende obelisk. Het zandstenen monument op een hoge achtkante sokkel kwam tot stand na een in 1868 uitgeschreven prijsvraag. Het winnende ontwerp, ‘De onafhankelijkheid van Nederland’, was van J.H. Egenberger en P. Schenkenberg van Mierop. Het beeld werd uitgevoerd door de Antwerpse beeldhouwer Josef Geefs en stelt de stervende Adolf van Nassau voor, met daarachter de Nederlandse maagd met schild en zwaard en de Nederlandse leeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00530> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiligerlee (gemeente Scheemda)"@nl ;
        min:adres "Provincialeweg 72" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiligerlee (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Heiligerlee" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 530 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0042> ;
        schema:name "Heiligerlee (gemeente Scheemda)"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "De (Herv.) Graaf Adolfkerk (Provincialeweg 72) is een uit 1873 stammende, gepleisterde zaalkerk met aangebouwde consistoriekamer en een opengewerkte dakruiter achter de klokvormige voorgevel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00531> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heiligerlee (gemeente Scheemda)"@nl ;
        min:adres "Provincialeweg 44" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Oldambt" ;
        min:gemeenteInBoek "Scheemda" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldambt> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heiligerlee (gemeente Scheemda)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Heiligerlee" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 531 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0042> ;
        schema:name "Heiligerlee (gemeente Scheemda)"@nl ;
        schema:pageEnd "139" ;
        schema:pageStart "139" ;
        schema:pagination "139" ;
        schema:text "De voorm. klokkengieterij A.H. van Bergen (Provincialeweg 44) werd in 1795 opgericht. In 1862 kwam een nieuwe gieterij, tevens fabriek van brandspuiten en torenuurwerken, tot stand. In het langgerekte gebouw bevinden zich een gietkuil, een smederij, een oven en grondkelders. De klokkentoren dateert van 1942. De gieterij ging in 1980 failliet. Sinds 1995 is in het gebouw een klokkenmuseum gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00532> a min:Passage,
