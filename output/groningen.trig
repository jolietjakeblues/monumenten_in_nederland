        min:hoofdstuk "Steden, dorpen, monumenten › Wittewierum (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wittewierum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1237 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0146> ;
        schema:name "Wittewierum (gemeente Ten Boer)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De pastorie (Kerkhorn 2), een fors pand met schilddak, stamt mogelijk uit het begin van de 19de eeuw en werd rond 1865 verbouwd. Op de als kerkhof in gebruik zijnde wierde staan diverse moeilijk leesbare grafstenen, waarvan de oudste uit de 18de eeuw stamt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0146.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01238> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woldendorp (gemeente Delfzijl)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woldendorp (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Woldendorp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1238 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0147> ;
        schema:name "Woldendorp (gemeente Delfzijl)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "Wierdedorp met een radiale structuur, ontstaan in de vroege middeleeuwen, op een hoger gelegen kwelderwal. De kerk staat aan de westzijde op een afzonderlijke wierde. Bij de gevechten van eind april 1945 rond de ‘Delfzijl pocket’ werd het dorp grotendeels verwoest. Na de oorlog volgden herbouw en uitbreiding langs de uitvalswegen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01239> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Woldendorp (gemeente Delfzijl)"@nl ;
        min:adres "A.E. Gorterweg 11" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Woldendorp (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Woldendorp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1239 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0147> ;
        schema:name "Woldendorp (gemeente Delfzijl)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De Herv. kerk (A.E. Gorterweg 11), oorspronkelijk gewijd aan St. Petrus, is een eenbeukige kerk met recht gesloten koor en lage geveltoren. Het huidige gebouw is het schip van een romanogotische kruiskerk uit het derde kwart van de 13de eeuw. De muur wordt geleed door enkele hoge nissen met gedrukte spitsbogen, waarin smalle rondboogvensters zijn opgenomen. Het koor en het transept van de kerk zijn al vóór 1700 gesloopt. In 1855 kreeg de kerk aan de westzijde een aanbouw met dakruiter. Na zware oorlogsschade in 1945 werd de kerk in 1955-'49 gerestaureerd naar plannen van A.R. Wittop Koning en R. Offringa. Daarbij zijn de huidige geveltoren en de apsis-vormige uitbouw voor de preekstoel aan de oostzijde ontstaan. Het interieur wordt overdekt door twee meloenvormige koepelgewelven met acht ribben. Op deze gewelven zijn bij restauratie grondtekeningen van schilderingen te voorschijn gekomen, op het westelijke gewelf uit omstreeks 1350, op het oostelijke uit omstreeks 1450. Vóór de toren liggen diverse zerken, waarvan de oudste uit 1625."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01240> a min:Passage,
