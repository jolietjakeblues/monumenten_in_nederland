        min:soort "lemma" ;
        min:volgnummer 372 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill104> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0027> ;
        schema:name "Heveskes"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text "Heveskes. Van dit voorm. wierdedorp, gelegen ten zuidoosten van Farmsum op het industriegebied van Delfzijl, resteert alleen een boerderij en de Herv. kerk (bij Heveskes 204), een eenbeukige recht gesloten kerk met westtoren. Het onderste deel van de toren is het oostelijke restant van een forse, rond 1200 gebouwde toren, die later overlangs is gespleten. Van de tegen de toren tussen 1250 en 1270 gebouwde eenbeukige romano-gotische kerk is de noordelijke schipmuur deels bewaard gebleven. Na oorlogsschade in 1584 heeft men de kerk tussen 1595 en 1604 verkort en versmald herbouwd. Het westfront van de toren en de vierkante opbouw met ingesnoerde naaldspits kwamen in 1778-'80 tot stand in opdracht van (kort daarop overleden) Lambertus Schotto Rengers en zijn weduwe douairière A.L. Rengers-Bentinck en zijn moeder, douairière M.B. Rengers-Tjarda van Starkenborch. De 13de-eeuwse torenrest werd beklampt. De fraai gesneden Lodewijk XV-preekstoel uit 1781, gemaakt door Abraham Bekenkamp is momenteel opgeslagen, in afwachting van de restauratie van de kerk. Aan de voorzijde van de kerk liggen diverse zerken, waarvan de oudste uit 1681 stamt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00373> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Farmsum (gemeente Delfzijl) – Weiwerd"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Farmsum (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Farmsum" ;
        min:lemma "Weiwerd" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 373 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0027> ;
        schema:name "Weiwerd"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text "Weiwerd. Dit wierdedorp met radiale structuur, gelegen ten zuidoosten van Farmsum, is in de vroege middeleeuwen ontstaan. Een groot deel van de ring- of ossenweg is bewaard gebleven, alsmede een deel van de vooral 19de-eeuwse bebouwing. De Herv. kerk uit 1877 werd in 1984 gesloopt ter voorbereiding van de - niet verwezenlijkte - uitbreiding van de haven van Delfzijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00374> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Farmsum (gemeente Delfzijl) – Oterdum"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Delfzijl" ;
        min:gemeenteInBoek "Delfzijl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Delfzijl_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Farmsum (gemeente Delfzijl)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Farmsum" ;
        min:lemma "Oterdum" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 374 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0027> ;
        schema:name "Oterdum"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text "Oterdum. Voorm. wierdedorp gelegen ten zuidoosten van Farmsum, dat moest wijken voor de aanleg van het zeehavenkanaal naar Delfzijl. De Herv. kerk, gebouwd in 1830, werd in 1971 gesloopt. Op de flank van de toen in het kader van de Deltawet aangelegde nieuwe zeedijk zijn de meeste grafstenen en zerken van het oude kerkhof (Valgenweg ong.) herplaatst. Ze stammen overwegend uit de 19de eeuw. Het gelijktijdig geplaatste beeld ‘De hand van Oterdum’, werd vervaardigd door M. Meesters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00375> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Feerwerd (gemeente Winsum)"@nl ;
        min:adres "Valgeweg 2",
            "Valgeweg 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Feerwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Feerwerd" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17688>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34958> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "15553",
            "510819" ;
        min:soort "inleiding" ;
        min:volgnummer 375 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0028> ;
        schema:name "Feerwerd (gemeente Winsum)"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text "Wierdedorp met langgerekte structuur, ontstaan in de middeleeuwen. In 1825 werd het Oldehoofse Kanaal dwars door de wierde gegraven. De bebouwing dateert grotendeels uit de 19de eeuw. De Herv. kerk (Valgeweg 3) is een gepleisterde zaalkerk; de ongelede, gepleisterde toren is voorzien van een achtkante, ingesnoerde spits. De kerk dateert uit de eerste helft van de 14de eeuw. Bij een ingrijpende verbouwing in 1859 kreeg het gebouw een lagere kap, nieuwe gevels aan de west- en oostkant en verrees ook de huidige toren. Tot de inventaris behoren een preekstoel en herenbank, beide uit de 17de eeuw. De kerk ligt op een kerkhof. De nabijgelegen pastorie (Valgeweg 2) is een eenlaags villa uit 1883."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00376> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Feerwerd (gemeente Winsum) – Woonhuizen"@nl ;
        min:adres "Mentaweg 1",
            "Mentaweg 1a" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Feerwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Feerwerd" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23068>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75690>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75691> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "15558",
            "510778",
            "510779" ;
        min:soort "lemma" ;
        min:volgnummer 376 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0028> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "87" ;
        schema:pageStart "87" ;
        schema:pagination "87" ;
        schema:text """Woonhuizen. Langs de Valgeweg staan verschillende eenlaags rentenierswoningen met schilddaken, overwegend gebouwd in het derde kwart van de 19de eeuw in neoclassicistische trant. Een goed voorbeeld is Valgeweg 9 uit omstreeks 1860. Andere voorbeelden zijn Valgeweg 11, 12, 16 en Aduarderdiep 1.

De windmolen ‘Joeswert’ (Mentaweg 1a) is een met hout beklede achtkante stellingkoren- en pelmolen op wit geschilderde bakstenen onderbouw. De molen werd in 1855 gebouwd voor W.D. Faber. De molen is in 1976-'78 gerestaureerd. De bijbehorende molenaarswoning (Mentaweg 1) is een eenlaags gebouw met omgaand schilddak uit dezelfde tijd. Bij de windmolen staat langs het Oldehoofse Kanaal een rolpaal.

De boerderij Meedenerweg 23, gelegen ten zuiden van Feerwerd, dateert uit de eerste helft van de 19de eeuw. Deze kop-hals-romp-boerderij heeft een relatief lang voorhuis met een zadeldak tussen bakstenen topgevels."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00377> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Finsterwolde (gemeente Reiderland)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
