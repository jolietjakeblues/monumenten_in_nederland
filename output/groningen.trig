        min:kern "Scheemda" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11036> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "30458" ;
        min:soort "inleiding" ;
        min:volgnummer 919 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0107> ;
        schema:name "Scheemda"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De ongelede vrijstaande toren (Kerkstraat 1) wordt bekroond door een zadeldak tussen trapgevels en heeft aan de voorzijde een kleinere puntgevel met wijzerplaat. De op enige afstand ten noordwesten van de kerk staande toren stamt oorspronkelijk uit het begin van de 16de eeuw, maar werd in 1887 gedeeltelijk herbouwd en verlaagd met behoud van het laat-18de-eeuwse ionische poortje in Lodewijk XVI-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0107.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00920> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Scheemda"@nl ;
        min:adres "Kerklaan 30" ;
        min:deel "Monumenten in Nederland. Groningen" ;
