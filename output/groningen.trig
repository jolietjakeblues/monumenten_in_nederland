        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77450>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77452> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "515278",
            "515280" ;
        min:soort "inleiding" ;
        min:volgnummer 1054 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0124> ;
        schema:name "Uithuizen (gemeente Eemsmond)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Achter de kerk ligt het kerkhof met een rouwkapel (Hoofdstraat West 87) in neogotische vormen, gebouwd in 1890 naar plannen van P.K. Nienhuis. Naast de kerk staat de pastorie (Hoofdstraat West 83) uit 1864, met neogotische invloeden en een tot trapgevel verhoogd middendeel waarin zich onder een spitsboog de ingang bevindt. De voorm. kosterswoning (Hoofdstraat West 81) is een eenlaags pand met afgewolfd schilddak uit omstreeks 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01055> a min:Passage,
