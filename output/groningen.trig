        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42844>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54739> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8905",
            "8906" ;
        min:soort "lemma" ;
        min:volgnummer 290 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0013> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "76" ;
        schema:pageStart "76" ;
        schema:pagination "76" ;
        schema:text "Windmolen ‘Veldkamps Meul'n’ (Hoofdweg 314) is een hoge, ronde stellingmolen, geheel van baksteen en gebouwd in 1855 als koren- en oliemolen voor R.H. Mulder. In 1869 verloor de molen door storm zijn kap. In 1960-'62 is de molen gerestaureerd en na stormschade in 1974 en 1976 nog eens hersteld. De molenaarswoning (Hoofdweg 312) met krimpen en aangebouwde schuur stamt uit de bouwtijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00291> a min:Passage,
