        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill223> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0062> ;
        schema:name "Losdorp (gemeente Delfzijl)"@nl ;
        schema:pageEnd "157" ;
        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "Het transformatorhuisje (Westendorpweg ong.) uit omstreeks 1915 is een goed voorbeeld van het toen gangbare type met ver overstekend zadeldak. Het bakstenen gebouwtje staat midden op een splitsing van wegen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00656> a min:Passage,
