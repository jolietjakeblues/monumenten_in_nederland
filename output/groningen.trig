        schema:pageEnd "241" ;
        schema:pageStart "241" ;
        schema:pagination "241" ;
        schema:text "De voorm. openbare lagere school (Heiligelaan 71) werd rond 1880 in neoclassicistische stijl gebouwd en doet nu dienst als winkel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01281> a min:Passage,
