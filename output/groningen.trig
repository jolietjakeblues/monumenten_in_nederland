        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "Het dorpscafé (Kapelstraat 11) is een mogelijk rond 1850 gebouwd dwars pand met achter het woongedeelte een bescheiden gelagkamer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0121.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01036> a min:Passage,
