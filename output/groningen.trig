        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Garnwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Garnwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 393 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0032> ;
        schema:name "Garnwerd (gemeente Winsum)"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "89" ;
        schema:pagination "89" ;
        schema:text "Wierdedorp met langgerekte structuur, ontstaan in de middeleeuwen. Door het afsnijden van de zeer bochtige Oude Diepte, een deel van het Reitdiep, kwam het dorp in 1629 direct aan de rivier te liggen en kreeg het een belangrijke rol in de scheepvaart van Groningen naar de Lauwerszee. De dorpsbebouwing verplaatste zich in de 18de en 19de eeuw steeds meer naar het oosten, richting rivier. De betekenis van Garnwerd nam sterk af nadat Groningen in 1876 via het Eemskanaal een betere verbinding met zee had gekregen. De wierde is aan de noordkant sterk afgegraven. Garnwerd is een beschermd dorpsgezicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00394> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Garnwerd (gemeente Winsum)"@nl ;
        min:adres "Burg. Brouwersstraat 3" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Garnwerd (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Garnwerd" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 394 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill110> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0032> ;
        schema:name "Garnwerd (gemeente Winsum)"@nl ;
        schema:pageEnd "90" ;
        schema:pageStart "89" ;
        schema:pagination "89-90" ;
        schema:text "De Herv. kerk (Burg. Brouwersstraat 3) is een gepleisterde eenbeukige kerk met vijfzijdige koorsluiting - inwendig halfrond - en een forse, ongelede westtoren. Het romano-gotische kerkgebouw heeft een koor uit 1229 (d) en een schip met een kap uit 1393 (d). Het is later van lage steunberen voorzien. Van de in 1738 ingestorte toren resteert het gepleisterde onderstuk, waarop in 1751 de toren werd herbouwd. Uit die tijd dateert ook de aansluitende, met voluten versierde westgevel. De kerk is in 1974-'76 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00395> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Garnwerd (gemeente Winsum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
