        schema:name "Sluizen"@nl ;
        schema:pageEnd "203" ;
        schema:pageStart "203" ;
        schema:pagination "203" ;
        schema:text "Sluizen. De Ter Apelersluis in het Ruiten-Aa-kanaal (bij Poortweg 11) werd in 1911-'17 gebouwd als schutsluis met stuw, loskade, ophaalbrug en sluiswachterswoning. De Gekoppelde Sluis in het Ter Apelkanaal (bij Ter Apelkanaal Oost 133) kreeg omstreeks 1924 een voetgangersbrug naar ontwerp van constructeur J. Loning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01019> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ter Apel (gemeente Vlagtwedde) – Barnflair"@nl ;
        min:adres "Barnflair Oost 9",
            "Munnekemoer Oost 3",
            "Munnekemoer Oost 4",
            "Rütenbrocherweg 7" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerwolde" ;
        min:gemeenteInBoek "Vlagtwedde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ter Apel (gemeente Vlagtwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Ter Apel" ;
        min:lemma "Barnflair" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21330> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "520956" ;
        min:soort "lemma" ;
        min:volgnummer 1019 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill308> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0118> ;
        schema:name "Barnflair"@nl ;
        schema:pageEnd "203" ;
        schema:pageStart "203" ;
        schema:pagination "203" ;
        schema:text "Barnflair. Dit dorp ten zuiden van Ter Apel is ontstaan na de aanleg van het kanaal richting Munnekemoer in 1856-'58. Het voorm. douanekantoor (Rütenbrocherweg 7) werd rond 1920 gebouwd in licht-expressionistische vormen. Barnflair Oost 13 is een woonhuis met rechthoekige erker en omlijste vensters uit omstreeks 1870. In het Ter Apel-kanaal liggen twee schutsluizen met sluiswachterswoning: het Zevende Verlaat (Barnflair Oost 9) en het Achtste Verlaat (bij Munnekemoer Oost 4). De sluiswachterswoning Munnekemoer Oost 4 uit omstreeks 1880 draagt het wapen van de stad Groningen. De schutsluis in het Rütenbrocker Kanal (bij Munnekemoer Oost 3) stamt uit omstreeks 1900. In de nabijheid staan twee kazematten van het type stekelvarken uit 1939. De voorm. redoute Barnflair (Leidijk ong.) is een in 1796 aangelegd zeshoekig aardwerk behorend tot de Eerste Linie van de Eems."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01020> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terhaar (gemeente Vlagtwedde)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeenteInBoek "Vlagtwedde" ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terhaar (gemeente Vlagtwedde)" ;
