        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00907> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Saaxumhuizen (gemeente Winsum)"@nl ;
        min:adres "Nienhuisweg 1" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Saaxumhuizen (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Saaxumhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54441> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "8588" ;
        min:soort "inleiding" ;
        min:volgnummer 907 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0105> ;
        schema:name "Saaxumhuizen (gemeente Winsum)"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "De Herv. kerk (Nienhuisweg 1) is een gepleisterde, recht gesloten zaalkerk; ze heeft een slanke, ongelede westtoren met spits. De kerk kreeg haar huidige vorm in 1846, na verbouwing van een 13de-eeuwse eenbeukige kerk. De toren werd in 1858 toegevoegd. Tot het vroeg-19de-eeuwse kerkmeubilair in empirestijl, gemaakt door M. Walles in opdracht van Goosen Geurt Alberda van Dijksterhuis, behoren een preekstoel, een doophek en enkele herenbanken, waarvan één met een halfrond opzetstuk dat is voorzien van een gesneden voorstelling van het laatste Avondmaal en het wapen van Alberda. Het orgel werd in 1851 gebouwd door P. van Oeckelen. De kerk ligt op een omgracht rechthoekig kerkhof. Als toegang tot het kerkhof dient een vroeg-19de-eeuws houten hek met gesneden vazen op de pijlers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00908> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Saaxumhuizen (gemeente Winsum) – Boerderijen"@nl ;
        min:adres "Hiddingezijlsterweg 2",
            "Hornsterweg 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "Winsum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Saaxumhuizen (gemeente Winsum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Saaxumhuizen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 908 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0105> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "187" ;
        schema:pageStart "187" ;
        schema:pagination "187" ;
        schema:text "Boerderijen. Nabij het dorp liggen enkele interessante kop-hals-romp-boerderijen. De omstreeks 1860 gebouwde boerderij Hiddingezijl (Hiddingezijlsterweg 2) heeft een dwars, onderkelderd eenlaags voorhuis met wolfdak. Bij de boerderij Westerholm (Hornsterweg 2) kreeg het 19de-eeuwse voorhuis in 1930 een verdieping in opdracht van S.B. Luitjens. De schuur werd in 1936 vervangen door de huidige driekapsschuur. Een klassieke vorm heeft de kop-halsrompboerderij Dikemaweg 4, gebouwd in twee fasen in 1849 en 1873."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0105.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00909> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Sauwerd (gemeente Winsum)"@nl ;
