        schema:name "Scheemda"@nl ;
        schema:pageEnd "188" ;
        schema:pageStart "188" ;
        schema:pagination "188" ;
        schema:text "De Alg. begraafplaats (bij Kerklaan 112, Eexta) is aangelegd op de plek waar tot de afbraak in 1870 de oude middeleeuwse kerk stond. In de vloer van het baarhuisje uit circa 1875 zijn een aantal grafzerken uit die kerk verwerkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0107.php> .

