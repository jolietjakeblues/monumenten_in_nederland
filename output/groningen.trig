        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0137> ;
        schema:name "Wehe-Den Hoorn (gemeente De Marne)"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "De voorm. R.K. school ‘St.-Ludgerus’ (Mernaweg 55) is een uit 1875 daterend, eenlaags schoolgebouw in neogotische vormen. In 1921 kreeg het aan de achterzijde een uitbreiding in dezelfde vormgeving, naar plannen van H. Havinga."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01160> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wehe-Den Hoorn (gemeente De Marne) – Woonhuizen"@nl ;
        min:adres "Borgweersterweg 5" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wehe-Den Hoorn (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wehe-Den Hoorn" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14113> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "24024" ;
        min:soort "lemma" ;
        min:volgnummer 1160 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0137> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text """Woonhuizen. Het eenlaags pand Mernaweg 49 dateert uit de eerste helft van de 19de eeuw. Mernaweg 29 is een voorm. molenaarswoning annex boerderij uit het derde kwart van de 19de eeuw. Het neoclassicistische voorhuis met schilddak heeft zowel in de voor- als de rechter zijgevel een ingang met bovenlicht voorzien van levensboom; die in de voorgevel is gevat in een omlijsting met hoofdgestel. In het dorp staan diverse eenlaags rentenierswoningen, waaronder Mernaweg 27 uit 1908 en Mernaweg 7, met hoger opgetrokken middenrisaliet, uit 1920.

De boerderij ‘Borgweer’ (Borgweersterweg 5) is een boerderij van het Oldambster type uit omstreeks 1900."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01161> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westerbroek (gemeente Hoogezand-Sappemeer)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Hoogezand-Sappemeer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
