        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoutkamp (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zoutkamp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1271 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0153> ;
        schema:name "Zoutkamp (gemeente De Marne)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Dorp, ontstaan uit een rond 1575 door de Spanjaarden bij het Reitdiep aangelegde schans. Staatse troepen breidden de schans in 1589 uit. In de 17de en 18de eeuw vestigden zich hier vissers. Wegens een gevreesde landing van Engelse troepen in 1799 kreeg Zoutkamp een Frans garnizoen en werd de verwaarloosde schans hersteld en uitgebreid. Pas in 1882 werd Zoutkamp als vesting opgeheven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01272> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zoutkamp (gemeente De Marne)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Het Hogeland" ;
        min:gemeenteInBoek "De Marne" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zoutkamp (gemeente De Marne)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Zoutkamp" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1272 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill373> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0153> ;
        schema:name "Zoutkamp (gemeente De Marne)"@nl ;
        schema:pageEnd "240" ;
        schema:pageStart "240" ;
        schema:pagination "240" ;
        schema:text "Het dorp kreeg in 1836 voor het eerst een eigen kerk. Van belang hierbij was de toename van de bevolking, die het gevolg was van de aanleg van een vissershaven in 1825. Veel vissers waren actief in de schelpenvisserij. Door de afsluiting van het Reitdiep in 1873-'77 kwam de vissershaven deels binnen- en deels buitendijks te liggen. Langs het in 1856-'58 gegraven Hunsingokanaal bouwde men kalkovens en een portlandcementfabriek (1872), die alle weer verdwenen in de 20ste eeuw. De bouw van de dam in het Reitdiep en de aanleg van een spoorlijn naar Winsum (1922) maakten Zoutkamp beter bereikbaar. In 1930-'33 breidde men de binnenhaven uit met een fors haventerrein met visafslag. De afsluiting van de Lauwerszee in 1969 had voor Zoutkamp tot gevolg dat de visserij plaats maakte voor recreatie. In de jaren zeventig zijn diverse visserswoningen naar het Zuiderzeemuseum te Enkhuizen overgebracht, waar ze nu een buurtje vormen. Aan de noordoostzijde van het dorp verrees na de Tweede Wereldoorlog enige nieuwbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0153.php> .

