        schema:name "Ten Boer"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "199" ;
        schema:pagination "199-200" ;
        schema:text "Het voorm. raadhuis (Stadsweg 43-45), een L-vormig gebouw met opengewerkte toren in de binnenhoek, kwam in 1911 tot stand naar plannen van S. Blokzijl, met Berlage-invloeden en jugendstil-details. Het is nu een kantoor annex woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0116.php> .

