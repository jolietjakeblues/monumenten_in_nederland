        min:rijksmonumentnummer "522108" ;
        min:soort "inleiding" ;
        min:volgnummer 776 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0083> ;
        schema:name "Nieuwolda (gemeente Scheemda)"@nl ;
        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Het voorm. raadhuis (Hoofdstraat 113) is een sober gebouw met het oude gemeentewapen. Het is in 1929 gebouwd in kubistisch-expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00777> a min:Passage,
            schema:CreativeWork ;
