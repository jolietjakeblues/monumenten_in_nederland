        rdfs:label "Lettelbert (gemeente Leek)"@nl ;
        min:adres "Hoofdstraat 162" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Leek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lettelbert (gemeente Leek)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Lettelbert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39902> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "23979" ;
        min:soort "inleiding" ;
        min:volgnummer 638 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0060> ;
        schema:name "Lettelbert (gemeente Leek)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "De Herv. kerk (Hoofdstraat 162) is een eenbeukige kerk met vijfzijdig gesloten koor en dakruiter. Ze zou gezien de spitsboogvensters nog uit de 14de eeuw kunnen dateren. In de 19de eeuw is de westgevel vernieuwd en voorzien van een dakruiter. Tot de inventaris behoort een eenvoudige preekstoel uit omstreeks 1660. De kerk ligt op een verhoogd kerkhof."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0060.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00639> a min:Passage,
