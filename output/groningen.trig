        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lellens (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Lellens" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 635 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0059> ;
        schema:name "Lellens (gemeente Ten Boer)"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "Het voorm. armenhuis (Borgweg 22-24), volgens de gevelsteen gesticht in 1852, bestaat uit een rij van oorspronkelijk vier woningen die tot dubbele woning zijn verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00636> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lellens (gemeente Ten Boer) – Boerderijen"@nl ;
        min:adres "Borgweg 36",
            "Hemerterweg 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Groningen" ;
        min:gemeenteInBoek "Ten Boer" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Groningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lellens (gemeente Ten Boer)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Lellens" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58638> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "9785" ;
        min:soort "lemma" ;
        min:volgnummer 636 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0059> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "154" ;
        schema:pageStart "154" ;
        schema:pagination "154" ;
        schema:text "Boerderijen. Ten noorden van Lellens, in het gehucht Hemert, liggen enkele grote boerderijen. De omgrachte boerderij Dinghweer (Hemerterweg 2) heeft mogelijk een 17de-eeuwse kern. Het dwarse voorhuis dateert uit omstreeks 1860, de tweede schuur uit het begin van de 19de eeuw. Nabij de oprijlaan staat een duivenslag. De Edsendaheerd (Borgweg 36) heeft een voorhuis uit omstreeks 1935 en een imposant breed schuurdeel met hijswerk. Volgens de gevelstenen is de schuur in drie bouwfasen (1802, 1896 en 1908) tot stand gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0059.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00637> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lettelbert (gemeente Leek)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
