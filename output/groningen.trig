        schema:name "Noordbroek (gemeente Menterwolde)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Het voorm. raadhuis (Hoofdstraat 65) werd in 1880 gebouwd in neoclassicistische vormen. Het eenlaags pand heeft een naar achteren liggend middendeel en driezijdig uitgebouwde zijrisalieten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

