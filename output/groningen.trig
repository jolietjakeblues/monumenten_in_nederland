        schema:name "Windmolen"@nl ;
        schema:pageEnd "163" ;
        schema:pageStart "163" ;
        schema:pagination "163" ;
        schema:text "Windmolen ‘De Hoop’ (Molenweg 6) is een met hout beklede achtkante stellingkorenmolen op een bakstenen onderbouw. De molen werd in 1855 gebouwd door molenmaker H. Bremer voor D.H. Oosterbeek."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0070.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00701> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Middelstum (gemeente Loppersum) – Toornwerd"@nl ;
        min:adres "Toornwerderweg 2" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Middelstum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Middelstum" ;
