        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0089> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "Boerderijen. De kop-romp-boerderij Oudeweg 13 dateert uit omstreeks 1870. Boerderijen met dwars geplaatst voorhuis zijn 't Pad 4 (circa 1860) en Oudeweg 17 (circa 1880)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00818> a min:Passage,
