        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0030> ;
        schema:name "Fransum (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "89" ;
        schema:pageStart "88" ;
        schema:pagination "88-89" ;
        schema:text "De boerderij Fransumerweg 2 is van het kop-hals-romptype en heeft een 18de-eeuws voorhuis met zadeldak tussen topgevels. Het interieur bevat twee 18de-eeuwse bedsteewanden en een deur in rococo-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0030.php> .

