        schema:pageStart "198" ;
        schema:pagination "198" ;
        schema:text "Het voorm. raadhuis (Stationsweg 10), een fors pand met hoektoren boven de ingangspartij, werd in 1926 in expressionistische stijl gebouwd naar plannen van J. Benninga. Sinds 1990 is het in gebruik als kantoor."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0115.php> .

