        min:kern "Grijpskerk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24005> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "516316" ;
        min:soort "inleiding" ;
        min:volgnummer 430 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0037> ;
        schema:name "Grijpskerk (gemeente Zuidhorn)"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Het voorm. raadhuis (Herestraat 50) is een fors blokvormig gebouw met een breed natuurstenen balkon boven de ingang en een ronde hoektoren. Het gebouw verrees in 1913 en vertoont Berlage-invloed en jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00431> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grijpskerk (gemeente Zuidhorn) – Woonhuizen"@nl ;
        min:adres "Groninger Straatweg 23",
            "Groninger Straatweg 31" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grijpskerk (gemeente Zuidhorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Grijpskerk" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 431 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill116> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0037> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "93" ;
        schema:pageStart "93" ;
        schema:pagination "93" ;
        schema:text "Woonhuizen. Langs de Groningerstraatweg en de Herestraat staan verschillende rentenierswoningen. Herestraat 56 is een eclectische villa met een hoger opgetrokken middendeel, gebouwd omstreeks 1875. Uit 1890 dateert Groningerstraatweg 64, een gepleisterde eenlaags villa met eclectische topgevel en detaillering. Ernaast staat een koetshuis uit dezelfde tijd. Het Notarishuis (Groninger Straatweg 31) is een rijk gedecoreerd eenlaags pand met afgeschuinde hoeken, erkers en een torenvormige uitbouw met ingesnoerde vierzijdige spits. Het werd in 1911 gebouwd naar ontwerp van P. van der Wint. De gepleisterde villa Zonnehof (Groninger Straatweg 23) verrees in 1918 naar ontwerp van K. Siekman. De reeks middenstandswoningen aan de Kastanjelaan is in de jaren twintig gebouwd en uitgevoerd in de zogenaamde ‘Groningse stijl’, met verschillende metselverbanden en decoraties in sober expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00432> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Grijpskerk (gemeente Zuidhorn) – Windmolens"@nl ;
        min:adres "Kievitsweg 22",
            "Kievitsweg 26",
            "Molenstraat 33",
            "Poelweg 9" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerkwartier" ;
        min:gemeenteInBoek "Zuidhorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerkwartier> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Grijpskerk (gemeente Zuidhorn)" ;
