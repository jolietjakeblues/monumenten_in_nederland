        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0151> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "239" ;
        schema:pageStart "239" ;
        schema:pagination "239" ;
        schema:text """Woonhuizen. De drie huizen Borgweg 34-38, met afgewolfde zadeldaken en lage verdiepingsvensters, zullen in de eerste helft van de 19de eeuw zijn gebouwd. Molenweg 4 is een statig dorpswoonhuis met omlijste ingang en een schilddak met hoekschoorstenen, gebouwd in het derde kwart van de 19e eeuw.

Het café Molenweg 2 is een aan een kruising van wegen gelegen pand met kruisende daken en topgevels, gebouwd rond 1905."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0151.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01264> a min:Passage,
            schema:CreativeWork ;
