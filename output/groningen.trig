        min:volgnummer 1153 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0136> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "223" ;
        schema:pageStart "223" ;
        schema:pagination "223" ;
        schema:text "Boerderijen. De boerderij Driepoldersweg 11 is van het Westerwoldse type met smal voorhuis en aanbouw onder afdak en een schuur met houten voorschotten. Het pand heeft een mogelijk laat-18de-eeuwse kern. Hoofdweg 8 is een in het midden van de 19de eeuw door een omlijste ingang tot rentenierswoning verfraaid boerderijtje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01154> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wedde (gemeente Bellingwedde) – Windmolens"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Westerwolde" ;
        min:gemeenteInBoek "Bellingwedde" ;
