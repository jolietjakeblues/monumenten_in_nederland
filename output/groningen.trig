            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75171> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "510651",
            "510652",
            "510653",
            "510654" ;
        min:soort "inleiding" ;
