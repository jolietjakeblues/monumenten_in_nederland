        schema:text "Het voorm. Armenhuis (Tammingastraat 40) is een langgerekt eenlaags pand met rondboogvensters en wolfdak, gebouwd rond 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0047.php> .

