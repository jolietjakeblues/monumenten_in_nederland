        schema:text "De dorpsschool (Sappermeersterweg 1) is een langgerekt en met riet gedekt L-vormig pand in cottagestijl, gebouwd rond 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00793> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordbroek (gemeente Menterwolde) – Woonhuizen"@nl ;
        min:adres "Hoofdstraat 26" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Menterwolde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordbroek (gemeente Menterwolde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordbroek" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13384> ;
        min:provincie "Groningen" ;
        min:rijksmonumentnummer "31613" ;
        min:soort "lemma" ;
        min:volgnummer 793 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill253> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0085> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Woonhuizen. Hoofdstraat 1 is een langgerekt diep pand met zadeldak voorzien van wolfeinden, dat getuige de jaartalankers uit 1716 stamt. De winkelpui werd in het begin van de 20ste eeuw toegevoegd. De voorm. onderwijzerswoning (Hoofdstraat 26) is een 19de-eeuws diep pand met hoog tentdak en opengewerkte dakruiter. In de dakruiter hangt een klok uit 1700. Het pand is nu als bibliotheek in gebruik. De drie panden Hoofdstraat 107-111 zijn voorbeelden van eenvoudige neoclassicistische dorpshuizen met opgaand middenrisaliet, gebouwd rond 1875. Eclectisch van vorm is het gepleisterde pand Hoofdstraat 49 uit omstreeks 1885. Chalet- en neorenaissance-details heeft Zuiderstraat 34 uit omstreeks 1905. Naar het Nieuwe Bouwen verwijst de villa Zuiderstraat 36, gebouwd rond 1934 met strakke vormen en platte daken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00794> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordbroek (gemeente Menterwolde) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
        min:gemeenteInBoek "Menterwolde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Midden-Groningen> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Noordbroek (gemeente Menterwolde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Noordbroek" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 794 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0085> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Boerderijen. In het dorp staat een aantal belangrijke boerderijen die alle tot het Oldambster type behoren. Tot de oudere varianten behoort Noorderstraat 4, gebouwd in de eerste helft van de 19de eeuw. De boerderij heeft aan de zuidzijde een uitgebouwd vertrek. Het pand biedt nu plaats aan het strijkijzermuseum. Zuiderstraat 63 heeft een neoclassicistisch onderkelderd voorhuis met omlijste ingangspartij en werd gebouwd in 1868. Vergelijkbaar is Zuiderstraat 61. Boerderijen met dwars voorhuis zijn Zuiderstraat 14 (omstreeks 1890) en Hoofdstraat 77 (omstreeks 1908); de laatste vertoont jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Noordbroek (gemeente Menterwolde) – Windmolens"@nl ;
        min:adres "Hamrik 2",
            "Molenlaan 3",
            "Molenlaan 4" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Midden-Groningen" ;
