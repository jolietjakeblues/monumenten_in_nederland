        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westerwolde> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vriescheloo (gemeente Bellingwedde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Vriescheloo" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1125 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0132> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Boerderijen. De uit omstreeks 1875 daterende grote boerderij Dorpsstraat 102 behoort tot het Oldambster type en heeft een onderkelderd voorhuis, een afgewolfd dak en een omlijste ingang met corinthische pilasters. De baander aan de voorzijde is schuin tussen de eerste en de tweede krimp geplaatst. De Kremershoeve (Dorpsstraat 106) heeft een voorhuis in kubistisch-expressionistische vormen uit omstreeks 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01126> a min:Passage,
