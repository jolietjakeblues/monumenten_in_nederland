        schema:name "Scholen"@nl ;
        schema:pageEnd "218" ;
        schema:pageStart "218" ;
        schema:pagination "218" ;
        schema:text "Scholen. De voorm. openbare lagere school (Dorpsstraat 88) stamt uit omstreeks 1880 en werd volgens een gevelsteen verbouwd in 1892 naar plannen van H. Dik. Het gebouw is nu een restaurant. De Chr. lagere school met onderwijzerswoning (Dorpsstraat 137-139) werd in 1935 gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0132.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01125> a min:Passage,
            schema:CreativeWork ;
