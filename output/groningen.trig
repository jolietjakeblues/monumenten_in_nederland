        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Het_Hogeland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Winsum en Obergum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Winsum en Obergum" ;
        min:lemma "Ranum" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 1227 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0144> ;
        schema:name "Ranum"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "Ranum. Deze buurtschap ten noorden van Winsum bestaat uit een grotendeels afgegraven wierde met enkele boerderijen en het voorm. kerkhof van de in 1815 gesloopte kerk. Van de aanwezige zerken dateert de oudste uit 1667."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0144.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01228> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wirdum (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wirdum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wirdum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1228 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0145> ;
        schema:name "Wirdum (gemeente Loppersum)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "Wierdedorp met een radiale structuur, ontstaan in de vroege middeleeuwen. In de late middeleeuwen kreeg het dorp via de Wirdumermaar een verbinding met het Damsterdiep. Langs dit diep ontstonden twee gehuchten, Wirdumerdraai en Eekwerderdraai. De wierde van Wirdum werd in 1917 grotendeels afgegraven en vanaf die tijd verdichtte zich de bebouwing langs de Wirdumerweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01229> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wirdum (gemeente Loppersum)"@nl ;
        min:adres "Kerkeweg 24" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wirdum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wirdum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1229 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0145> ;
        schema:name "Wirdum (gemeente Loppersum)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "De Herv. kerk (Kerkeweg 24) is een brede eenbeukige kerk met recht gesloten koor en dakruiter. De kerk werd gebouwd in de eerste helft van de 13de eeuw. Het koor is verdeeld in twee zones, met beneden spaarnissen voorzien van rondbogen en boven één groot spaarveld afgesloten door een rondboogfries. Waarschijnlijk in de 15de eeuw zijn de meeste vensters vergroot. Aan de noordzijde bevinden zich een knielnis en een laag venster. De in 1878 afgebroken westtoren verving men door een dakruiter naar plannen van O. de Leeuw Nieland, die weer bij de restauratie van 1959-'61 is vervangen. In de dakruiter hangt een klok uit 1639, gegoten door Wilhelmus Jacobus de Vrij. Bij de naar plannen van R. Offringa uitgevoerde restauratie heeft men ook het middelste laat-gotische venster aan de oostzijde weer geopend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01230> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wirdum (gemeente Loppersum)"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wirdum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wirdum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1230 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0145> ;
        schema:name "Wirdum (gemeente Loppersum)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "In het interieur heeft het hiervoor genoemde venster in de dagkanten vroeg-15e-eeuwse schilderingen van heiligen. De noordmuur toont een fragment van geometrisch schilderwerk, eveneens uit de 15de eeuw. Tot de kerkinventaris behoren een herenbank met gesneden opzetstuk en de wapens van Wiltet Louwens en Remke Jelmers (1644), een preekstoel (omstreeks 1650) en een door P. van Oeckelen gebouwd orgel (1879). De kerkvloer bevat diverse zerken met wapens, waaronder die voor Oede Froma (†1551), Hille Froma (†1556) en Ballo Froma (†1576)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01231> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wirdum (gemeente Loppersum)"@nl ;
        min:adres "Fromaweg 2",
            "Kerkeweg 22",
            "Stadsweg 6" ;
        min:deel "Monumenten in Nederland. Groningen" ;
        min:gemeente "Loppersum" ;
        min:gemeenteInBoek "Loppersum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Loppersum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Groningen_(provincie)> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wirdum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Wirdum" ;
        min:provincie "Groningen" ;
        min:soort "inleiding" ;
        min:volgnummer 1231 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/afbeelding/sten009monu04ill364> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0145> ;
        schema:name "Wirdum (gemeente Loppersum)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "Op het omheinde kerkhof bevinden zich onder meer een zerk uit 1607 en een grafmonument uit 1859. De voorm. pastorie (Fromaweg 2) is een blokvormig eenlaags pand met hoger oprijzende middenpartij, gebouwd in 1887 naar plannen van O. de Leeuw Wieland. Scholen. De voorm. openbare lagere school (Eekwerderpad) uit 1878 is sterk verbouwd, de bijbehorende onderwijzerswoning (Kerkeweg 22) is een statig neoclassicistisch pand met schilddak en hoekschoorstenen uit 1878. De nieuwe openbare lagere school (Stadsweg 6) heeft expressionistische details en werd in 1937 te Wirdumerdraai gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0145.php> .

