        schema:name "Woldendorp (gemeente Delfzijl)"@nl ;
        schema:pageEnd "236" ;
        schema:pageStart "236" ;
        schema:pagination "236" ;
        schema:text "De Geref. kerk (A.E. Gorterweg 26) is een zaalkerk met schilddak en dakruiter, gebouwd in 1950."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0147.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/01241> a min:Passage,
