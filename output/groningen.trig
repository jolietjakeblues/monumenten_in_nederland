        min:hoofdstuk "Steden, dorpen, monumenten › Stedum (gemeente Loppersum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01> ;
        min:kern "Stedum" ;
        min:lemma "Boerderijen" ;
        min:provincie "Groningen" ;
        min:soort "lemma" ;
        min:volgnummer 989 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/hoofdstuk/0115> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "199" ;
        schema:pageStart "199" ;
        schema:pagination "199" ;
        schema:text "Boerderijen. Rond Stedum liggen enkele grote boerderijen van het Hooglandse type, dat wil zeggen kop-hals-romp-boerderijen met een dwars voorhuis voorzien van een zadeldak met wolfeinden. Voorbeelden zijn De Heemen (Bedumerweg 41, 1826), Vledderbosch (Lopsterweg 20, 1844) en Deltheem (Delleweg 2, midden 19de eeuw). Voorbeelden van tweekapsboerderijen zijn Lellensterweg 40 en De Wierde (Delleweg 9) uit het midden van de 19de eeuw. De Jensumaheerdt (Hoofdstraat 47) is een boerderij van het Oldambster type uit die tijd. De imposante boerderij Niehof (Lopsterweg 2) dateert uit 1875 en heeft een lage verdieping en een schilddak met hoekschoorstenen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu04_01/sten009monu04_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu04_01/passage/00990> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ten Boer"@nl ;
        min:deel "Monumenten in Nederland. Groningen" ;
