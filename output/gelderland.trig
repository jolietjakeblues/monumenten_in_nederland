        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0238> ;
        schema:name "Zuilichem (gemeente Lingewaal)"@nl ;
        schema:pageEnd "353" ;
        schema:pageStart "353" ;
        schema:pagination "353" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Het gestrekte esdorp werd bij de overstroming van 1861 zwaar getroffen. Na de Tweede Wereldoorlog is Zuilichem in zuidwestelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0238.php> .

