        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1695 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0215> ;
        schema:name "Wadenoijen (gemeente Tiel)"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug van de Waal en voor het eerst vermeld in 850. Langs de zuidoever van de Linge kwam een lintvormig dorp tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0215.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01696> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wadenoijen (gemeente Tiel)"@nl ;
        min:adres "Lingedijk 21",
            "Lingedijk 23" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Tiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wadenoijen (gemeente Tiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wadenoijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15521>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37642>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40442> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35620",
            "35621",
            "35622" ;
        min:soort "inleiding" ;
        min:volgnummer 1696 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0215> ;
        schema:name "Wadenoijen (gemeente Tiel)"@nl ;
        schema:pageEnd "320" ;
        schema:pageStart "320" ;
        schema:pagination "320" ;
        schema:text "De Herv. kerk (Lingedijk 23) is een eenbeukige kerk met smaller en hoger, driezijdig gesloten koor en een half ingebouwde ongelede toren met ingesnoerde spits. Het romaanse tufstenen schip dateert uit circa 1100. Rond 1200 werd het schip een halve travee ingekort en verrees de romaanse tufstenen toren, die rond 1250 in baksteen is verhoogd. Het gotische koor is 15de-eeuws en uitgevoerd in baksteen met tufstenen banden. Het interieur wordt gedekt door een ziende kap (schip) en een vlakke houten zoldering (koor). Tot de inventaris behoren een grafzerk voor Cornelia Hinckert (†1567), een wets- en gebedenbord met een afbeelding van Moses (1711), een preekstoel in Lodewijk XIV-trant en een herenbank, beide uit circa 1720. Een gebrandschilderd raam uit 1728 toont de wapens van de geslachten Van Haeften en Van Lijnden. Uit 1843 dateert de pastorie (Lingedijk 21) met een zadeldak tussen topgevels en neoclassicistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0215.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01697> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wadenoijen (gemeente Tiel) – Boerderijen"@nl ;
        min:adres "Lingedijk 32",
            "Lingedijk 63" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Tiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wadenoijen (gemeente Tiel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wadenoijen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25729>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29465> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35623",
            "35626" ;
        min:soort "lemma" ;
        min:volgnummer 1697 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill407> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0215> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "321" ;
        schema:pageStart "320" ;
        schema:pagination "320-321" ;
        schema:text """Boerderijen. De hallenhuisboerderij Vergardeweg 23 heeft een gepleisterd dwars voorhuis, dat vermoedelijk rond 1700 is gebouwd maar in de tweede helft van de 19de eeuw zijn huidige aanzien heeft gekregen. Het dak van de achterbouw heeft een fors overstek. De dubbele schuurberg en de vloedschuur dateren vermoedelijk uit circa 1770. Het complex is recent gerestaureerd. In Wadenoijen staat een aantal 19de-eeuwse hallenhuisboerderijen met dwars voorhuis. De meeste voorhuizen hebben een lage verdieping en een schilddak, de achterhuizen zijn veelal voorzien van een dakoverstek. Goede voorbeelden zijn De Lingehof (Lingedijk 63) uit circa 1840, Lingedijk 30, met breed voorhuis voorzien van een opkamer, De Prinkel (Lingedijk 32) uit 1840, Lingedijk 97, met jaartalankers ‘1843’, Bredestraat 8, Lingedijk 119 en Lingedijk 7 (circa 1850). De dwars op de dijk gelegen boerderij Lingedijk 27 heeft een zadeldak tussen topgevels; op het erf staat een schuurberg. De uit 1880 daterende boerderij Lingedijk 113 heeft een gepleisterd tweelaags herenhuis met middenrisaliet als voorhuis.

De poldermolen (Lingedijk ong.) is een grondzeiler met ijzeren scheprad. Na een brand in 1887 is de molen in 1888 herbouwd. De in 1971 gerestaureerde molen heeft een met riet gedekte houten kap en een achtkant op een stenen onderbouw."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0215.php> .

