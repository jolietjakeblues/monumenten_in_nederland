            "Herenstraat 6-14",
            "Lawickse Allee 71",
            "Markt 23",
            "Niemeyerstraat 57",
            "Niemeyerstraat 59",
            "Niemeyerstraat 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Wageningen" ;
        min:gemeenteInBoek "Wageningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wageningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wageningen" ;
