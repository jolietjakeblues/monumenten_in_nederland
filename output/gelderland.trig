        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill425> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0226> ;
        schema:name "Klein Noordijk"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text "Klein Noordijk (H.W. Iordensweg 91), gelegen ten westen van Wilp, is een blokvormig gepleisterd neoclassicistisch landhuis, gebouwd in 1856 voor Mw. Van Marle-Van der Wijck. Uit dezelfde tijd dateren het koetshuis annex paardenstal, de tuinmanswoning en de fazanterie. De gebouwen zijn in 1989-'92 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0226.php> .

