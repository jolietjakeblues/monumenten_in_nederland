        schema:pageEnd "205" ;
        schema:pageStart "205" ;
        schema:pagination "205" ;
        schema:text "Dorp, ook wel Oldenkeppel genoemd, gelegen op een rivierduin die al in de 10de eeuw bewoning kende. De bebouwing heeft zich rond een brink gegroepeerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0116.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01032> a min:Passage,
