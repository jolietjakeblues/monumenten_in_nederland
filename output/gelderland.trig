        schema:name "Kerkwijk (gemeente Zaltbommel)"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "Het raadhuis (Walderweg 2) is in 1961 gebouwd naar ontwerp van C. Kammeijer met een aangebouwde bodewoning. De uitbreidingen dateren uit 1977 en 1990."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0127.php> .

