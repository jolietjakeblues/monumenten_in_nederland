        schema:pageStart "157" ;
        schema:pagination "157" ;
        schema:text "Het voorm. raadhuis (Rustoordlaan 39) dateert uit 1862. Dit eenlaags pand kreeg zijn huidige aanzien met dakkapel en ingangspartij bij de ombouw tot woonhuis in 1912, waarschijnlijk naar plannen van A.J. Jansen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0069.php> .

