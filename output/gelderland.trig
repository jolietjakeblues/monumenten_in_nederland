        min:adres "Grotestraat 28" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Oude IJsselstreek" ;
        min:gemeenteInBoek "Gendringen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oude_IJsselstreek> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gendringen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gendringen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/31685> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16063" ;
        min:soort "inleiding" ;
        min:volgnummer 847 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0087> ;
        schema:name "Gendringen"@nl ;
        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "De Herv. kerk (Grotestraat 28) is een brede gepleisterde zaalkerk met een ingebouwde toren van twee geledingen met achtkantige naaldspits. De neoclassicistische kerk verrees in 1835 ter plaatse van een in 1830 door brand verwoeste middeleeuwse voorganger. De eveneens neoclassicistische toren, met gedeeltelijk 15de-eeuwse kern, kwam in 1879 tot stand en was een geschenk van J.B. Breukink en J.E. Hesselink. Het orgel is gebouwd door J.D. Nolting (1840)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0087.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00848> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gendringen"@nl ;
        min:adres "Pastoor Wijfkerstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
