        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1155 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill272> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0139> ;
        schema:name "Lobith (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "221" ;
        schema:pageStart "221" ;
        schema:pagination "221" ;
        schema:text "Dorp, gelegen op een boogvormige oeverwal van de Rijn, die tot 1711 direct langs het dorp liep. Tot 1816 maakte Lobith deel uit van de Kleefse enclaves in Gelderland. In de 19de eeuw verplaatsten de handelsactiviteiten zich naar het nabij gelegen Tolkamer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01156> a min:Passage,
