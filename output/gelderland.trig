        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "511825",
            "511827",
            "511828",
            "511829",
            "511832" ;
        min:soort "lemma" ;
        min:volgnummer 1537 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill371> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0194> ;
        schema:name "De Matanze"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "De Matanze (Deventerweg 10-12) is een landgoed, waarvan het landhuis in 1717 als spieker werd gebouwd. Bij een ingrijpende verbouwing rond 1880 in opdracht van dhr. Servatius kwam het huidige gepleisterde eclectische gebouw in rijke neobarokke stijl tot stand. Het interieur is ook in deze stijl uitgevoerd. Het huis - met koetshuis en theehuis uit dezelfde tijd - ligt in een landschappelijke tuinaanleg, waarbij voor de waterpartij van een binnendijkse kolk gebruik is gemaakt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0194.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01538> a min:Passage,
