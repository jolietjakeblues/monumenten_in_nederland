        schema:name "Zoelmond (gemeente Buren)"@nl ;
        schema:pageEnd "352" ;
        schema:pageStart "352" ;
        schema:pagination "352" ;
        schema:text "De grotendeels gepleisterde voorm. pastorie (Dorpsstraat 2) is een in oorsprong 18de-eeuws pand waaraan in de 19de eeuw een verdieping en twee traveeën zijn toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0237.php> .

