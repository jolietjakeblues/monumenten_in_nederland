        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0042> ;
        schema:name "Bredevoort (gemeente Aalten)"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "De R.K. kerk H. Hart en H. Georgius (Kerkstraat 16) is een eenbeukige neogotische kruiskerk met een slanke toren van vier geledingen met ingesnoerde naaldspits. De kerk verrees in 1875-'76 naar plannen van A. Tepe en is in 1992 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

