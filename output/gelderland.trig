        min:volgnummer 1564 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Kasteel Crayestein"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Kasteel Crayestein (Laan van Crayestein 77). Van dit kleine kasteel resteert het eenvoudige vroeg 17de-eeuwse poortgebouw met zadeldak en getoogde doorgang. Op het omgrachte, verhoogd gelegen terrein staat een gepleisterd blokvormig landhuis uit 1855."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01565> a min:Passage,
