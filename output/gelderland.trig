        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenderen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Steenderen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32186> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "521997" ;
        min:soort "inleiding" ;
        min:volgnummer 1518 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0191> ;
        schema:name "Steenderen"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "292" ;
        schema:pagination "292-293" ;
        schema:text "De R.K. St.-Willibrorduskerk (Bronkhorsterweg 2) is een eenbeukige kerk met smaller, halfrond gesloten koor en een slanke toren van vier geledingen met ingesnoerde naaldspits. De kerk verrees in 1862-'64 naar plannen van H.J. Wennekers in een combinatie van neogotische en neoromaanse vormen. De gebrandschilderde ramen zijn van F. Nicolas (1887). Van de inventaris stammen alleen de kruiswegstaties uit de bouwtijd. In 1978 zijn opnieuw neogotische altaren (F.W. Mengelberg) geplaatst, afkomstig uit het Van Nispenhuis te Amsterdam. Voor de kerk staat het in 1945 door H. van Remmen ontworpen monument ‘Steenderen blijft Steenderen’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01519> a min:Passage,
