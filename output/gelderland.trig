        min:volgnummer 1136 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0136> ;
        schema:name "Leur (gemeente Wijchen)"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op een zandrug van de Maas. In de nabijheid van de kerk en een oude vluchtheuvel ontwikkelde zich een kleine dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0136.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01137> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Leur (gemeente Wijchen)"@nl ;
        min:adres "Van Balverenlaan 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
