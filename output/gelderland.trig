        schema:name "Herberg"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Herberg ‘De Woeste Hoeve’ (Oude Arnhemseweg 292), gelegen ten oosten van Hoenderloo, is in 1771 gesticht als pleisterplaats op de weg van Apeldoorn naar Arnhem. In de nabijheid bevindt zich een gedenkteken voor de slachtoffers van een Duitse represaillemaatregel na de aanslag op H.A. Rauter (6-3-1945)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01027> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoevelaken"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Nijkerk" ;
        min:gemeenteInBoek "Hoevelaken" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nijkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoevelaken" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Hoevelaken" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1027 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0115> ;
        schema:name "Hoevelaken"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Langgerekt dorp, ontstaan op een ontginningsas (Oosterdorpsstraat) van een in 1132 begonnen ontginning, die in 1286 naar het westen werd uitgebreid (Westerdorpsstraat). Het in 1402 voor het eerst vermelde kasteel Hoevelaken dat in de 15de eeuw van strategische betekenis was, ging in 1672 in vlammen op; mogelijk werd ook het dorp toen door brand verwoest. De verharding van de weg Amersfoort-Deventer (1806-'09) zorgde voor een economische impuls. Na de Tweede Wereldoorlog is het dorp sterk naar het noorden en zuidwesten uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01028> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoevelaken"@nl ;
        min:adres "Westerdorpsstraat 65",
            "Westerdorpsstraat 67" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Nijkerk" ;
        min:gemeenteInBoek "Hoevelaken" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nijkerk_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hoevelaken" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Hoevelaken" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26630> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "22198" ;
        min:soort "inleiding" ;
        min:volgnummer 1028 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0115> ;
        schema:name "Hoevelaken"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De Herv. kerk (Westerdorpsstraat 67), oorspronkelijk gewijd aan St. Martinus, is een kruiskerk voorzien van een ongelede toren met achtzijdige spits. De toren dateert uit de 16de eeuw. In de klokkenstoel uit 1698 hangen een klok van Jan Tolhuis (1527) en een klok van Wouter Both en Eppe van der Arck (1628). Van de middeleeuwse kerk bleef vrijwel niets bewaard door verbouwingen en uitbreidingen tot een neogotische kruiskerk in 1866 en 1930 (zuidzijde). Boven de laat-gotische toreningang herinnert het jaartal 1873 aan de verbouwing van de toren in neogotische stijl. De pastorie (Westerdorpsstraat 65) is een blokvormige herenhuis in ‘Um 1800’-stijl uit circa 1916."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0115.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01029> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hoevelaken – Buitenplaatsen"@nl ;
        min:adres "Park Weldam 1-7",
            "Park Weldam 6",
            "Park Weldam 7",
