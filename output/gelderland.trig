        min:soort "lemma" ;
        min:volgnummer 1377 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0165> ;
        schema:name "Noordeinde"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Noordeinde. Dit dorp ten noorden van Oosterwolde is ontstaan in het midden van de 19de eeuw bij de in 1845 nieuw gestichte Herv. kerk (Groote Woldweg 132-134). Dit eenvoudige gepleisterde eenlaags gebouw in neoclassicistische stijl is met de pastorie onder een wolfdak gebouwd. De Geldersche sluis (Geldersesluis 4) is een midden-19de-eeuwse, bakstenen uitwateringssluis van de Polder Oosterwolde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01378> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ophemert (gemeente Neerijnen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
