        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ochten (gemeente Echteld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ochten" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1335 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0159> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Woonhuizen. Tot de bewaard gebleven oudere dorpsbebouwing behoren de laat-19de-eeuwse, maar recent uitgebreide, landarbeiderswoning 't Kuiltje (Waaldijk 17) en de arbeiderswoningen Ambachtstraat 30-34 (circa 1915) en Ambachtstraat 28 (1924). De woonhuizen Op Den Salck (Heuningstraat 4) uit 1927 en Sonnevanck (Heuningstraat 6) uit dezelfde periode, zijn sterk verwant en vertonen expressionistische elementen. Het voorhuis van de voorm. hallenhuisboerderij met dwars voorhuis 44 R.I. Straat 12 is in de jaren dertig verbouwd tot een gepleisterde eenlaags villa met steile rieten kap met expressionistische elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01336> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ochten (gemeente Echteld) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Neder-Betuwe" ;
        min:gemeenteInBoek "Echteld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Neder-Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ochten (gemeente Echteld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ochten" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1336 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0159> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Boerderijen. In het dorp staan verschillende hallenhuisboerderijen, al dan niet met dwars voorhuis, opkamer en een rieten dak. Uit de 18de eeuw dateren de gepleisterde boerderijen 44 R.I. Straat 10 met dwars voorhuis en Liniestraat 3, de laatste met een naastgelegen gepleisterd zomerhuis. Schoolstraat 18 uit 1834 heeft een dwars voorhuis. Uit de tweede helft van de 19de eeuw stammen Burg. Houtkoperlaan 13, Weilerstraat 8 (circa 1870), met dwars voorhuis en bakhuis, en Heuningstraat 11 (1879), voorzien van een tweelaags dwars voorhuis met neoclassicistische invloeden en een naastgelegen schuur uit 1889. De twee laatst genoemde boerderijen liggen op een verhoging. De hallenhuisboerderij Liniestraat 21 uit circa 1915 heeft een mansardedak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01337> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oene (gemeente Epe)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Epe" ;
        min:gemeenteInBoek "Epe" ;
