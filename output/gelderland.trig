        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaltbommel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zaltbommel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zaltbommel" ;
        min:lemma "Watertorens" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1825 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0230> ;
        schema:name "Watertorens"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Watertorens. De ronde bakstenen watertoren Stadsdijk 3-5 [18] verrees in 1905 naar ontwerp van J. Schotel in neorenaissance-stijl met jugendstildetails. In de uitkragende ronde bovenbouw met kantelen bevond zich een ijzeren Intze-reservoir. De toren is in 1983 tot woningen verbouwd en in 1995-'96 gerestaureerd. De ronde betonnen watertoren Steenweg 90 dateert uit 1964 en is ontworpen door H. Brouwer en T.T. Deurvorst. De cilindervormige schacht gaat naar boven over in een afgeknotte kegelvorm. Inwendig heeft de toren drie betonnen vlakbodemreservoirs."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0230.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01826> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zaltbommel – Bruggen en viaducten"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zaltbommel" ;
        min:gemeenteInBoek "Zaltbommel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaltbommel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zaltbommel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zaltbommel" ;
        min:lemma "Bruggen en viaducten" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1826 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0230> ;
        schema:name "Bruggen en viaducten"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Bruggen en viaducten. De in 1864-'68 over de Waal gelegde spoorbrug (Dr. ir. W. Hupkesbrug) is een brug met vakwerkliggers naar plannen van E.F. van Dissel en J.M. Telders. In 1932-'33 is de brug verdubbeld naar plannen van J. Redeker. De brug bestaat zowel uit parallelle vakwerkliggers als uit vakwerkliggers met gebogen bovenrand. Bij het herstel van de oorlogsschade tussen 1945 en 1951 zijn de vakwerkliggers grotendeels vernieuwd. Het nabijgelegen bakstenen spoorwegviaduct (Oenselsedijk) dateert uit 1868. De verkeersbrug over de Waal is een brug met parallelle vakwerkliggers, gebouwd in 1930-'33 en hersteld na schade in de Tweede Wereldoorlog. De naastgelegen Martinus Nijhoffbrug, een betonnen tuibrug met stalen tuien naar ontwerp van C.P.M. Kuilboer, is in 1996 in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0230.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01827> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zaltbommel – Begraafplaatsen"@nl ;
        min:adres "Marten van Rossemsingel 49" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zaltbommel" ;
        min:gemeenteInBoek "Zaltbommel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zaltbommel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zaltbommel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zaltbommel" ;
        min:lemma "Begraafplaatsen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1827 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0230> ;
        schema:name "Begraafplaatsen"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Begraafplaatsen. De in 1829 aangelegde Alg. begraafplaats ‘Bosschepoort’ (Ravelijnsbolwerk) [19] heeft gietijzeren hekpalen en een neoclassicistische baarhuisje, dat - hoewel gedateerd ‘1810’ - rond 1830 is gebouwd. De begraafplaats bevat onder meer een gietijzeren grafsteen voor mw. C.E. Thooft-Melssingh (†1859) en het graf van G.L.F. Philips (†1942), stichter van de Philips-fabrieken in Eindhoven. De Isr. begraafplaats (Marten van Rossemsingel 49), sinds 1901-'02 op deze plaats, is toegankelijk door een bakstenen poortje met in de sluitsteen het jaartal 1787."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0230.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01828> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeddam (gemeente Bergh)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
