        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0075> ;
        schema:name "Homoet"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Homoet. Dit gehucht ten noordwesten van Elst ontstond in de 19de eeuw op een smalle, opgehoogde stroomrug. Interessante boerderijen zijn Homoetsestraat 17 uit 1807, met middenhuis en bijschuur, en Homoetsestraat 21, een hallenhuisboerderij met dwars voorhuis uit circa 1850. Op een vluchtheuvel ligt de Herv. kerk (Homoetsestraat 19), een recht gesloten zaalkerk uit 1869 met een geveltoren voorzien van open lantaarn en tentdak. De kerk bevat een 17de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00781> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enspijk (gemeente Geldermalsen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
