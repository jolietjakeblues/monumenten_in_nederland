        min:gemeenteInBoek "Beuningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beuningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Winssen (gemeente Beuningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Winssen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1778 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0227> ;
        schema:name "Winssen (gemeente Beuningen)"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text "De kerktoren (Dijk 39) van de rond 1850 gesloopte middeleeuwse dorpskerk is een bouwwerk van vijf geledingen uit de eerste helft van de 15de-eeuw met een ingesnoerde spits uit 1863. In de toren hangt een klok uit 1679. De onderste geledingen van de toren hebben tufstenen banden. Een in 1860-'63 tegen de toren gebouwde kerk werd in 1941 gesloopt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0227.php> .

