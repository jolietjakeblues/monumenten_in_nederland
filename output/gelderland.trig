        schema:name "Brummen"@nl ;
        schema:pageEnd "122" ;
        schema:pageStart "122" ;
        schema:pagination "122" ;
        schema:text "Het voorm. tehuis voor oude mannen (Burg. De Wijslaan 8) is een fors pand in neorenaissance-vormen uit circa 1895. De directeurswoning ‘Uithof’ (Burg. De Wijslaan 6) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0045.php> .

