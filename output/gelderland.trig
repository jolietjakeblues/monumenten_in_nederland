        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rheden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Velp (gemeente Rheden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Velp" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32755> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "504520" ;
        min:soort "inleiding" ;
        min:volgnummer 1637 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0207> ;
        schema:name "Velp (gemeente Rheden)"@nl ;
        schema:pageEnd "310" ;
        schema:pageStart "310" ;
        schema:pagination "310" ;
        schema:text "De Herv. kerk (Kerkstraat 32) is een neoclassicistische kerk op T-vormige plattegrond, gebouwd in 1839-'41 naar plannen van E. Jeni. Voor de gezwenkte voorgevel staat een portico met fronton; de kerk wordt geleed door gepleisterde halfzuilen en pilasters. Het interieur wordt gedekt door een gestuct tongewelf. De kerk bevat een uit Utrecht afkomstig orgel, gebouwd in 1771 door H.H. Hess en geplaatst op een orgeltribune uit 1878. De vroeg-19de-eeuwse preekstoel komt uit de Herv. kerk te Winterswijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0207.php> .

