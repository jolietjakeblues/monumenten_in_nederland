        schema:pageEnd "275" ;
        schema:pageStart "275" ;
        schema:pagination "275" ;
        schema:text "De boerderij Kerkweg 14 is een fraai gelegen gepleisterde boerderij met dwars voorhuis, gebouwd rond 1800."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0170.php> .

