        schema:name "Harderwijk"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "De (Geref.) Plantagekerk (Stationslaan 136) is een kruiskerk met aangebouwde consistorie en kerkeraadskamer en een slanke toren van twee geledingen met vierzijdige spits. De in zakelijk-expressionistische vormen opgetrokken kerk verrees in 1932-'33 naar ontwerp van P.H. van Lonkhuyzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0094.php> .

