        min:soort "inleiding" ;
        min:volgnummer 958 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0102> ;
        schema:name "Heerewaarden (gemeente Maasdriel)"@nl ;
        schema:pageEnd "196" ;
        schema:pageStart "196" ;
        schema:pagination "196" ;
        schema:text "Het raad- en polderhuis (Hogestraat 26) is een L-vormig pand uit 1891, gebouwd in rijke neorenaissance-stijl naar ontwerp van J. Groenendael. Het souterrain herbergde het cachot en de brandspuit. Op de bel-etage bevonden zich de raadkamers voor zowel Burgemeester en Wethouders als het Polderbestuur. Het gebouw is in 1953 voorzien van een aanbouw en in 1990 verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00959> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerewaarden (gemeente Maasdriel)"@nl ;
        min:adres "Hogestraat 12",
            "Variksestraat 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Maasdriel" ;
        min:gemeenteInBoek "Maasdriel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasdriel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heerewaarden (gemeente Maasdriel)" ;
