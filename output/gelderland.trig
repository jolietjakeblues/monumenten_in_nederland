        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Buurmalsen (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Buurmalsen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13937>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56494> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16492",
            "16493" ;
        min:soort "inleiding" ;
        min:volgnummer 544 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill145> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0048> ;
        schema:name "Buurmalsen (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "127" ;
        schema:pagination "127-128" ;
        schema:text "De Herv. kerk (Rijksstraatweg 11) is een driebeukige pseudobasilicale kerk met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. Het romaanse schip uit circa 1100, waarvan nog enig muurwerk resteert, werd begin 14de eeuw met zijbeuken uitgebreid. De gedeeltelijk met tufsteen beklede toren verrees begin 15de eeuw. In de toren hangt een door Henricus de Borch gegoten klok (1523). Het laatgotische koor met voorm. sacristie kwam begin 16de eeuw tot stand. De kerk is gerestaureerd in 1987-'89, onder leiding van W.A. Mazzola."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00545> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Buurmalsen (gemeente Geldermalsen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Buurmalsen (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Buurmalsen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 545 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0048> ;
        schema:name "Buurmalsen (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "128" ;
        schema:pageStart "128" ;
        schema:pagination "128" ;
        schema:text "Inwendig wordt het koor gedekt door een kruisribgewelf op gebeeldhouwde kraagstenen, de sacristie door een stergewelf en het schip door een vlakke houten zoldering uit 1824. De kerk bevat diverse middeleeuwse muur- en gewelfschilderingen. Tot de inventaris behoren een sarcofaag en een sarcofaagdeksel (12de of 13de eeuw) en een door K.M. van Puffelen gebouwd orgel (1858)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0048.php> .

