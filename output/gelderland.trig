        schema:name "Harderwijk"@nl ;
        schema:pageEnd "186" ;
        schema:pageStart "186" ;
        schema:pagination "186" ;
        schema:text "De voorm. synagoge (Jodenkerksteeg 1) [6] is een in 1839-'40 opgetrokken zaalgebouw met eenvoudige in- en uitgezwenkte voorgevel en spitsboogvensters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0094.php> .

