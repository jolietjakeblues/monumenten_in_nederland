        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1746 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Westervoort"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De R.K. St.-Werenfriduskerk (Dorpsstraat 109) is een driebeukige neogotische kruisbasiliek, gebouwd in 1913-'14 naar plannen van Nic. Molenaar ter vervanging van een voorganger uit 1841. De toren uit 1884 is in 1945 opgeblazen. In 1951 is de huidige voorgevel opgetrokken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01747> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort"@nl ;
        min:adres "Bosweg 7",
            "Dorpsplein 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Westervoort" ;
        min:gemeenteInBoek "Westervoort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westervoort_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1747 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Westervoort"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De Geref. kerk (Bosweg 7) is een zaalkerk op L-vormige plattegrond, gebouwd in 1937 in traditionele vormen. Het expressionistische raadhuis (Dorpsplein 1) ontstond 1924-'25 naar ontwerp van J.H. Hogenkamp. Het is in 1974 en 1988 fors uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01748> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort – Hamerden"@nl ;
        min:adres "Hamersestraat 53" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Westervoort" ;
        min:gemeenteInBoek "Westervoort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westervoort_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:lemma "Hamerden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20910> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38847" ;
        min:soort "lemma" ;
        min:volgnummer 1748 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill419> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Hamerden"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "330" ;
        schema:pagination "330-331" ;
        schema:text """Hamerden (Hamersestraat 53) is een voorm. havezate, die voor het eerst wordt genoemd in 1434. Het bijna vierkante gedeelte met zadeldak tussen puntgevels aan de zuidzijde van het huidige gebouw dateert uit 1612. Door uitbreiding aan de noordzijde ontstond in 1684 een tweebeukig huis. Nadat de stad Arnhem Hamerden in 1736 had gekocht, werd het een boerderij en bouwde men aan de oostzijde een deel. Het geheel is in 1961-'62 gerestaureerd.

Van de voorm. schans Geldersoord (Schans ong.), aangelegd in 1741-'42 en verkocht in 1820, resteert een klein deel. De schans lag bij het verlande kanaal van het inundatiegebied Westervoort-Doesburg. Ten behoeve van de IJssellinie in 1951-'52 bouwde men nabij de schans een groot inlaatwerk, dat na opheffing van de linie in 1964 gedeeltelijk in de dijk is begraven."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01749> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weurt (gemeente Beuningen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
