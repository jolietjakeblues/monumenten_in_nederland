        min:kern "Vierakker" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40460> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38332" ;
        min:soort "lemma" ;
        min:volgnummer 1652 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0208> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Boerderijen. Het vroeg-16de-eeuwse, mogelijk adellijke huis 't Mengerink (Heerlerweg 10), ook Olde Spiker genoemd, is een hoog gebouw met kloostervensters en een zadeldak tussen puntgevels (met duivengaten). Het doet zeker sinds de 19de eeuw dienst als boerderij. De midden-19de-eeuwse hallenhuisboerderij 't Makkink (Boshuisweg 3) heeft neogotische spitsboogramen in de voorgevel. Andere hallenhuisboerderijen zijn De Vlieg (Vierakkersestraatweg 16) uit circa 1800, met endskamer en deel uit 1825, Baakseweg 12 (1816) en Baakseweg 3 (1881)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0208.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01653> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorst"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Voorst" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Voorst" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1653 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0209> ;
        schema:name "Voorst"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Dorp, ontstaan op een stroomrug van de IJssel en voor het eerst vermeld in 893. In de middeleeuwen lag het dorp aan de rivier en werd het hoofdplaats van het schoutambt Voorst, bestaande uit de parochies Voorst, Wilp, Twello en Terwolde. De rivier heeft zich later in oostelijke richting verplaatst. Vanaf de 19de eeuw kende Voorst een bescheiden groei."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01654> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorst"@nl ;
        min:adres "Schoolstraat 16" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Voorst" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Voorst" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/24793>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37825> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38044",
            "38045" ;
        min:soort "inleiding" ;
        min:volgnummer 1654 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0209> ;
        schema:name "Voorst"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "De Herv. kerk (Schoolstraat 16), oorspronkelijk gewijd aan de Heilige Drievuldigheid, is een driebeukige pseudobasilicale kerk met driezijdig gesloten koor en een toren van vijf geledingen met ingesnoerde naaldspits. De romaanse tufstenen toren met spaarbogen en boogfriezen stamt uit de tweede helft van de 12de eeuw. In de later verhoogde toren hangen twee door Gerhardt Schimmel gegoten klokken (1678 en 1680). In de 15de eeuw kwam eerst het met tufsteen beklede gotische koor tot stand en daarna het schip; vervolgens werd de toren opgehoogd. De kerk is hersteld in 1843."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01655> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorst"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Voorst" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Voorst" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1655 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0209> ;
        schema:name "Voorst"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "Het interieur wordt in de zijbeuken gedekt door kruisribgewelven en in het middenschip en koor door een houten koofplafond; de gebeeldhouwde kraagstenen van de verdwenen kruisgewelven zijn nog aanwezig. In de noordbeuk bevindt zich een muurschildering van een abt (1566). Tot de inventaris behoren een preekstoel met dooptuin (midden 17de eeuw), diverse oude grafzerken - waaronder die van Anna van Appelthorn (†1693) -, het rouwbord voor Andries baron Schimmelpenninck van der Oye (†1776) en het door C.F.A. Naber gebouwde orgel (1843; gerestaureerd in 1983)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01656> a min:Passage,
