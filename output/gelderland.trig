        schema:name "Valburg"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "307" ;
        schema:pagination "307-308" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op de overgang van een stroomrug en een rivierduin. De opgehoogde rivierduin wordt begrensd door de Broekstraat en de Mellardsestraat; aan de oostzijde kwam een esdorp tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0203.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01610> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Valburg"@nl ;
        min:adres "Kerkplein 6" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Overbetuwe" ;
        min:gemeenteInBoek "Valburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Overbetuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Valburg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Valburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/20857>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39914> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "36722",
            "36723" ;
        min:soort "inleiding" ;
        min:volgnummer 1610 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0203> ;
        schema:name "Valburg"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De Herv. kerk (Kerkplein 6), oorspronkelijk gewijd aan St. Christoffel, is een eenbeukige kerk met een door kapellen geflankeerd, driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De 13de-eeuwse toren en het 14de-eeuwse schip zijn in tufsteen en baksteen opgetrokken. Het koor en de zuidkapel (nu consistorie) dateren uit het derde kwart van de 15de eeuw. De noordkapel kwam tot stand in het tweede kwart van de 16de eeuw. Het koor werd toen verhoogd. De kerk is in 1968-'71 gerestaureerd onder leiding van H. Korswagen en later van D. Wijma. Het interieur wordt gedekt door netgewelven (koor en zuidkapel) en een gereconstrueerde balkenzoldering (schip). De kerk bevat fragmenten van muurschilderingen (14de-16de eeuw), waarop onder meer afbeeldingen van de Kruisiging, de apostelen en enkele heiligen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0203.php> .

