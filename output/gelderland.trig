        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. De bebouwing van dit gestrekte esdorp wordt langs de Middenstraat en de Achterweg bepaald door terpen en hoge huizen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0182.php> .

