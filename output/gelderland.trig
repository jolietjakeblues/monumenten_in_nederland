        schema:name "Brummen"@nl ;
        schema:pageEnd "122" ;
        schema:pageStart "122" ;
        schema:pagination "122" ;
        schema:text "De kerk van de Ned. protestantenbond (D.A. van Vuurenstraat 10) is een eenvoudige zaalkerk met dakruiter, gebouwd in 1933 met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0045.php> .

