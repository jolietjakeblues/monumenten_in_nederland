        min:soort "inleiding" ;
        min:volgnummer 1561 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Tricht (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Haaks op de dijk kwamen twee bebouwingskernen tot ontwikkeling, waartussen in 1868 de spoorlijn Utrecht - Den Bosch werd aangelegd. Na de Tweede Wereldoorlog is het dorp in westelijke en noordoostelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01562> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tricht (gemeente Geldermalsen)"@nl ;
        min:adres "Kerkstraat 6" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tricht (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tricht" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22739>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57076> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16521",
            "16522" ;
        min:soort "inleiding" ;
        min:volgnummer 1562 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Tricht (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "De Herv. kerk (Kerkstraat 6), oorspronkelijk gewijd aan St. Pieter, is een pseudobasilicale kerk met driezijdig gesloten koor, sacristie en een toren van drie geledingen met ingesnoerd tentdak. De toren verrees rond 1400. In de toren hangt een door Johannes en Wilhelmus Hoerken gegoten klok (1460). Het schip kwam tot stand in de tweede helft van de 15de eeuw; het koor en de voorm. sacristie in het tweede kwart van de 16de eeuw. De kerk is gerestaureerd in 1922-'27, onder leiding van J.G.A. Heineman, en in 1977-'78."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01563> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tricht (gemeente Geldermalsen)"@nl ;
        min:adres "Kerkstraat 11" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tricht (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tricht" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1563 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Tricht (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Het interieur wordt gedekt door een kruisribgewelf (koor) en een houten tongewelf (schip). De doopkapel bevat een 16de-eeuwse muurschildering, voorstellende de doop van Christus. Tot de inventaris behoren een preekstoel en doophek (1660), beide vervaardigd door Dirck Cool, twee overhuifde herenbanken (17de eeuw), diverse 18de-eeuwse grafzerken en een door P. Flaes gebouwd orgel (1887; gerestaureerd in 1979). De voorm. pastorie (Kerkstraat 11) dateert uit 1849."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01564> a min:Passage,
