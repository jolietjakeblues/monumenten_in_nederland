        min:gemeenteInBoek "Bemmel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bemmel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bemmel" ;
        min:lemma "Huis De Kinkelenburg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37792> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "8932" ;
        min:soort "lemma" ;
        min:volgnummer 421 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0031> ;
        schema:name "Huis De Kinkelenburg"@nl ;
        schema:pageEnd "111" ;
        schema:pageStart "111" ;
        schema:pagination "111" ;
        schema:text "Huis De Kinkelenburg (Kinkelenburglaan 1) is een omgracht gebouw met voorplein. Het oudste deel is een 15de-eeuwse toren met schilddak. De aangrenzende vleugel dateert uit circa 1600 en de daarop onder een stompe hoek aansluitende vleugel is een reconstructie in 18de-eeuwse vormen. Het complex is in 1954 onder leiding van Ch. Estourgie ingrijpend gerestaureerd en gereconstrueerd en dient thans als raadhuis. Het interieur bevat een 17de-eeuwse schouw met kariatiden en een laat-18de-eeuwse betimmering met wandschilderingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0031.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00422> a min:Passage,
