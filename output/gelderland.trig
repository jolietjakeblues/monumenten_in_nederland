        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill416> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0220> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Raadhuizen. Het voorm. raadhuis Beatrixplein 1 werd in 1938 gebouwd in traditionalistische vormen naar plannen van Jos. Franssen. Het huidige, neo-modernistische raadhuis, Raadhuisplein 1, uit 1992 is ontworpen door H.A.J. Henket."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0220.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01737> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wehl – Woonhuizen"@nl ;
        min:adres "Stationsweg 30" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Doetinchem" ;
        min:gemeenteInBoek "Wehl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Doetinchem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wehl" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wehl" ;
        min:lemma "Woonhuizen" ;
