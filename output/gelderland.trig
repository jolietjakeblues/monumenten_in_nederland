        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "9288" ;
        min:soort "lemma" ;
        min:volgnummer 1833 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Montferland"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text "Montferland (Montferland 1), gelegen ten zuidwesten van Zeddam, is een natuurlijke hoge heuvel omgeven door een droge gracht. Vanaf de 9de eeuw was hier een ringvormige walburcht, mogelijk de in 1016 verwoeste burcht ‘Uplade’. Ter plaatse van een gebouw uit 1527 verrees in 1699 een jachtpaviljoen voor Oswald III van den Bergh en Leopoldina van Oostfriesland-Rietberg. Dit kleine classicistische pand met pilastergeleding is nu onderdeel van een laat-19de-eeuws restaurant."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01834> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zelhem"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
