        min:volgnummer 996 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0109> ;
        schema:name "Heteren"@nl ;
        schema:pageEnd "200" ;
        schema:pageStart "200" ;
        schema:pagination "200" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Een lintvormige bebouwing ontwikkelde zich langs de dijk bij de Neder-Rijn en verder aan de tegenwoordige O.L. Vrouwestraat-Dorpsstraat, de Achterstraat en de Flessestraat. Na de Tweede Wereldoorlog is het dorp aan weerszijden van de Flessestraat verder uitgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00997> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heteren"@nl ;
        min:adres "Kastanjelaan 14" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
