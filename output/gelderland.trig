        schema:pagination "136" ;
        schema:text "De voorm. synagoge (Spoorstraat 34) is een eenvoudig zaalgebouw met rondboogvensters, gebouwd in 1884 en uitgebreid in 1896 met een schoollokaal en mikwe."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0053.php> .

