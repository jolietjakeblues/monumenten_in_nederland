        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 823 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill203> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0083> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "173" ;
        schema:pagination "173-174" ;
        schema:text "Windmolen ‘De Hoop’ (Oud Milligenseweg 7) is een ronde stellingkorenmolen met een bakstenen romp en een met riet gedekte kap. De molen werd in 1855 gebouwd voor C.A. van Zomeren - ter vervanging van een in 1853 afgebrande molen - en is in 1957 en in 1971 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0083.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00824> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Garderen (gemeente Barneveld) – Boerderijen"@nl ;
        min:adres "Hoge Boeschoterweg 76",
            "Hoge Boeschoterweg 78" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Barneveld" ;
        min:gemeenteInBoek "Barneveld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Barneveld_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Garderen (gemeente Barneveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
