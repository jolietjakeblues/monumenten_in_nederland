        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill379> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0198> ;
        schema:name "Twello (gemeente Voorst)"@nl ;
        schema:pageEnd "302" ;
        schema:pageStart "302" ;
        schema:pagination "302" ;
        schema:text "Het kerkhof bevat een als open kapel uitgevoerde neogotische kruisigingsgroep (1912) en de grafkelder van de familie Van Hövell tot Westervlier en Wezeveld. De pastorie (Kerklaan 18) is een fors pand uit circa 1920, uitgevoerd in ‘Um 1800’-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01572> a min:Passage,
