            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79697> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38083",
            "38090",
            "410036",
            "410037",
            "410038",
            "526931",
