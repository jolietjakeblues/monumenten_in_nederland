        schema:name "Boerderijen"@nl ;
        schema:pageEnd "270" ;
        schema:pageStart "270" ;
        schema:pagination "270" ;
        schema:text "Boerderijen. De Veluwse hallenhuisboerderij Van Borsselenweg 32-34 stamt uit 1840 en is in 1911 verbouwd. Andere voorbeelden van dit type boerderij zijn de gepleisterde boerderij Loopbergenseweg 1 (circa 1850) en De Meije (Pietersbergseweg 15; 1896)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0163.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01367> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterbeek (gemeente Renkum) – Winkels"@nl ;
        min:adres "Graaf van Rechterenweg 12",
            "Klingelbeekseweg 69",
            "Zonneheuvelweg 10" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Renkum" ;
        min:gemeenteInBoek "Renkum" ;
