        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loenen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Loenen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1178 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0141> ;
        schema:name "Loenen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "Esdorp, ontstaan in de late middeleeuwen op de oostflank van de Veluwestuwwal. Bij het dorp verrees de havezate Ter Horst. Aan de Loenense Molenbeek werden enkele watermolens gebouwd. Door de ligging aan de weg Apeldoorn-Dieren kreeg Loenen in de 19de eeuw enige lintbebouwing, die later is verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01179> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loenen (gemeente Apeldoorn)"@nl ;
        min:adres "Beekbergerweg 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
