        min:soort "inleiding" ;
        min:volgnummer 1583 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0199> ;
        schema:name "Ubbergen"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stuwwal. Rond het in 1712 gesloopte kasteel Ubbergen kwam een klein agrarisch dorp tot ontwikkeling. Na circa 1820 groeide Ubbergen - dankzij de bosrijke omgeving - uit tot een langgerekt villadorp langs de Rijksstraatweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0199.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01584> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ubbergen"@nl ;
        min:adres "Rijksstraatweg 38" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ubbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ubbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12169>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45677> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35798",
            "35803" ;
        min:soort "inleiding" ;
        min:volgnummer 1584 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0199> ;
        schema:name "Ubbergen"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "De voorm. Herv. kerk (Rijksstraatweg 38) is een eenbeukige kapel met driezijdige koorsluiting en een dakruiter met ingesnoerde spits. De kapel dateert uit de 15de eeuw en kreeg rond 1650 de huidige sluiting en waarschijnlijk in 1848 de huidige dakruiter. Daarin hangen klokken uit 1687 en 1734 (J.B. Levache). Bij de restauratie in 1960-'61, onder leiding van F.M. Oswald, heeft men de consistorie herbouwd. Het interieur wordt gedekt door een vlakke houten zoldering. De kerk bevat een 17de-eeuwse preekstoelkuip. Op het kerkhof met neogotisch toegangshek bevinden zich 19de-eeuwse grafzerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0199.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01585> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ubbergen"@nl ;
        min:adres "Rijksstraatweg 37-39" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ubbergen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ubbergen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13755>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58105> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35789",
            "35790" ;
        min:soort "inleiding" ;
        min:volgnummer 1585 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0199> ;
        schema:name "Ubbergen"@nl ;
        schema:pageEnd "304" ;
        schema:pageStart "304" ;
        schema:pagination "304" ;
        schema:text "Het voorm. klooster en pensionaat ‘Notre Dame des Anges’ (Rijksstraatweg 37-39), thans woongemeenschap ‘De Refter’, is een tegen de flank van de stuwwal gelegen gebouwencomplex. In de neorenaissance-villa ‘Ter Meer’ uit circa 1890 stichtten de Franse zusters in 1903 een meisjespensionaat. Aangrenzend kwamen tussen 1910 en 1916 een school, een pensionaat en een kapel tot stand in neogotische stijl, naar ontwerp van J. van Groenendaal. De kapel heeft een lager, driezijdig gesloten koor met aan weerszijde een traptoren. Op de nok van het schip staat een klokkentoren met naaldspits. Het pensionaat bestaat uit twee haakse, vijflaags vleugels met twee traptorens. Het klooster werd gevestigd in een voorm. villa uit 1896-'97 naar ontwerp van C. Outshoorn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0199.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01586> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ubbergen – St.-Maartenskliniek"@nl ;
        min:adres "Hengstdal 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
