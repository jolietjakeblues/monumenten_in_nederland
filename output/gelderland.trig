        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0168> ;
        schema:name "Opijnen (gemeente Neerijnen)"@nl ;
        schema:pageEnd "273" ;
        schema:pageStart "273" ;
        schema:pagination "273" ;
        schema:text "De Herv. kerk (Stoepstraat 2) is een gepleisterde zaalkerk met recht gesloten koor en een ongepleisterde toren van drie geledingen met ingesnoerde spits. De kerk verrees rond 1860, de neogotische toren rond 1925. De kerk bevat een preekstoel uit 1744 en een door H. Knipscheer gebouwd orgel (1852)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0168.php> .

