        min:hoofdstuk "Steden, dorpen, monumenten › 's-Heerenberg (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "'s-Heerenberg" ;
        min:lemma "Huis Bergh" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37259>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40310>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50637>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70064>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70065>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70066>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/70067> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "526787",
            "526789",
