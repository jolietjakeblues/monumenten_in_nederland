        min:soort "inleiding" ;
        min:volgnummer 1073 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0125> ;
        schema:name "Kerk Avezaath (gemeente Buren)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een stroomrug. Langs twee evenwijdige wegen, de Achterstraat en de Dorpsstraat, kwam een gestrekt esdorp tot ontwikkeling. Door uitbreidingen na 1945 aan de oost- en de westzijde is die dorpsstructuur nog moeilijk herkenbaar."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01074> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kerk Avezaath (gemeente Buren)"@nl ;
        min:adres "Daver 15" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Buren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kerk Avezaath (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Kerk Avezaath" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1074 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0125> ;
        schema:name "Kerk Avezaath (gemeente Buren)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "De Herv. kerk (Daver 15) is een eenbeukige kerk met smaller, driezijdig gesloten koor en een ingebouwde toren van twee geledingen met twee zware steunberen en een ingesnoerde spits. Het schip en de bovenbouw van de toren zijn gepleisterd. De toren heeft een 11de-eeuwse tufstenen onderbouw; de bovenbouw dateert vermoedelijk van rond 1640. In de 14de eeuw heeft men de onderbouw aan drie zijden met spitsboogdoorgangen naar de kerk geopend. Het laat-gotische koor met tufsteenbanden stamt uit circa 1500. Het romaanse schip is in 1861 naar plannen van J. van der Toorn vervangen door het huidige neogotische schip, met aan de noordzijde een portaal. De kerk is in 1980-'81 gerestaureerd onder leiding van C.L. Temminck Groll. Het koor wordt gedekt door een stenen netgewelf, dat in het schip in stuc is geïmiteerd; bij de restauratie is dit stucgewelf geheel vernieuwd. Op de torenpijlers bevinden zich 14de-eeuwse schilderingen (St. Agatha en Maria Magdalena) en op het koorgewelf 16de-eeuwse rankenschilderingen. De kerk bevat een door K.M. van Puffelen gebouwd orgel (1882)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01075> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kerk Avezaath (gemeente Buren)"@nl ;
        min:adres "Daver 24",
            "Dorpsstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Buren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kerk Avezaath (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Kerk Avezaath" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1075 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0125> ;
        schema:name "Kerk Avezaath (gemeente Buren)"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "De voorm. lagere school (Daver 24) en de bijbehorende onderwijzerswoning (Dorpsstraat 2) zijn twee evenwijdig gelegen, gepleisterde panden uit 1841. De school heeft rechts een lagere aanbouw met ingang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0125.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01076> a min:Passage,
