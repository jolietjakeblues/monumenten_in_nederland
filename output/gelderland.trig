            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68392>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68393> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "516725",
            "516726",
