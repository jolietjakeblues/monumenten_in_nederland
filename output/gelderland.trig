        min:volgnummer 1386 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0167> ;
        schema:name "Opheusden (gemeente Kesteren)"@nl ;
        schema:pageEnd "273" ;
        schema:pageStart "273" ;
        schema:pagination "273" ;
        schema:text "Het voorm. veerhuis (Veerweg 1) annex boerderij ligt op een verhoging en dateert voornamelijk uit de tweede helft van de 19de eeuw, maar heeft ook oudere delen. Achter het dwarse tweelaags voorhuis bevindt zich een tweebeukig achterhuis. Het veerhuis dient nog steeds als café. Het interieur van de gelagkamer is grotendeels in originele staat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0167.php> .

