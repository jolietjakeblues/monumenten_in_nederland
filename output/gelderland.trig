        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Woonhuizen. De voorm. Herv. pastorie, Molenstraat 48, is een L-vormig neoclassicistisch pand met aangebouwd koetshuis, opgetrokken in 1858 naar plannen van J.A. Gerritsen. Het forse neoclassicistische woonhuis Oude Kerkstraat 10 stamt uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0080.php> .

