        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een rivierduin van de Oude IJssel. Tot 1795 maakte het deel uit van het graafschap Bergh."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0147.php> .

