        schema:pageEnd "176" ;
        schema:pageStart "176" ;
        schema:pagination "176" ;
        schema:text "Woonhuizen. Uit circa 1865 dateren het dwarse huis Vlietskant 8, met lage verdieping, en Vlietskant 7, een eenlaags diep dubbel woonhuis met aangebouwde, deels gepotdekselde stal en op het erf twee schuren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0086.php> .

