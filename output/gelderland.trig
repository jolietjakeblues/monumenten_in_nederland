            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28954>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53842>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61994> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38042",
            "523352",
            "523353",
            "523354" ;
