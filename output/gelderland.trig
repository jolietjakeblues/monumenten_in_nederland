        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Woonhuizen. Van de oude dorpsbebouwing resteert weinig. In chaletstijl uitgevoerd zijn Rijksweg 32-34 (circa 1905) en de villa Rijksweg 52 (1908), gebouwd voor C.C.G. Otten naar plannen van Mulder en Van Wessem."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0065.php> .

