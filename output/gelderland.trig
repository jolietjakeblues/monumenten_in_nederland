        rdfs:label "Meteren (gemeente Geldermalsen) – Boerderijen"@nl ;
        min:adres "Achtersteweg 69",
            "Blankertseweg 5",
            "Bommelweg 2-2a" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Meteren (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Meteren" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1225 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0148> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Boerderijen. In Meteren staat een aantal hallenhuisboerderijen met dwars voorhuis en een dakoverstek aan de achterzijde. Ze zijn voornamelijk gebouwd in de tweede helft van de 19de eeuw, enkele hebben een oudere kern. Voorbeelden zijn: Struykenhof (Bommelweg 2-2a), met opkamer en vloedschuur, Geymenhof (Blankertseweg 5), met naast het achterhuis een schuur uit 1906, Dorpsstraat 46 (circa 1890), 't Hofke (Achtersteweg 69; circa 1890), Wilhelminastaat 1 (circa 1890), met vloedschuur, en Wilhelminastraat 5 (circa 1890), met vloedschuur en wagenschuur. De in 1929 gebouwde boerderij Wouwertweg 10 heeft een villa-achtig voorhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0148.php> .

