        schema:name "De Bockhorst"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "De Bockhorst (Bockhorstweg 14) is een voorm. havezate, die voor het eerst wordt vermeld in 1617. Het omgrachte gebouw kreeg rond 1800 zijn huidige (neo)classicistische aanzien en werd rond 1925 nog eens verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0188.php> .

