        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "De R.K. St.-Martinuskerk (Pastoor Molderstraat 2) is een driebeukige kruiskerk voorzien van een ongelede toren met naaldspits, gebouwd in 1934-'35 naar plannen van Joh.H. Sluijmer ter plaatse van een voorganger uit 1855."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0147.php> .

