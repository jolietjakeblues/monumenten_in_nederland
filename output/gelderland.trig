        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De (Geref.) Jeugdkerk (Jeugdkerkstraat 12) is een kruiskerk uit 1930 in sober expressionistische vormen naar plannen van J. van der Schaaf en A.J. Sneek. De kerk bevat een orgel van P. van Oeckelen (1889; in 1931 geplaatst)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0228.php> .

