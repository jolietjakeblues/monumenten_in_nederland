        min:hoofdstuk "Steden, dorpen, monumenten › Wehl" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wehl" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1735 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0220> ;
        schema:name "Wehl"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "De Herv. kerk (Grotestraat 25) is een recht gesloten zaalkerk uit 1858 met neogotische gietijzeren raamtraceringen. Voor de plaatsing van het door H. Haffmans in 1878 gebouwde orgel werd de kerk verbouwd. Toen kreeg het ook een geveltoren met ingesnoerde naaldspits. De pastorie (Grotestraat 23) stamt uit circa 1880 en vertoont neorenaissancedetails."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0220.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01736> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wehl – Raadhuizen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
