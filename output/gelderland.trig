            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79297>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79298> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523642",
            "523643",
            "523644",
            "523645",
