        min:kern "Hierden" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1019 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0113> ;
        schema:name "Hierden (gemeente Harderwijk)"@nl ;
        schema:pageEnd "203" ;
        schema:pageStart "203" ;
        schema:pagination "203" ;
        schema:text "De Herv. kerk (bij Zuiderzeestraatweg 151) is een kruiskerk met dakruiter. Aan de uit circa 1880 daterende neogotische zaalkerk is rond 1920 een transept toegevoegd. De neoclassicistische pastorie (Zuiderzeestraat 151) is eveneens uit circa 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0113.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01020> a min:Passage,
