        schema:name "Windmolens"@nl ;
        schema:pageEnd "99" ;
        schema:pageStart "99" ;
        schema:pagination "99" ;
        schema:text "Windmolens. Uit 1846 dateert de ronde stenen beltmolen De Hoop (Molenweg 1, Elden). De van een rieten kap voorziene korenmolen is in 1951 en in 1978 gerestaureerd. De ronde stenen stellingkorenmolen De Kroon (Klarendalseweg 82) [36] is in opdracht van A. Burgers in 1847 gebouwd aan de Amsterdamseweg en in 1870 naar de huidige plek verplaatst. Na verwijdering van het wiekenkruis in 1964 is de molen in 1976-'77 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0020.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00347> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Arnhem – Bedrijfsgebouwen"@nl ;
        min:adres "Broekstraat 22-28",
            "Utrechtseweg 310",
            "Van Oldenbarneveldtstraat 90-92",
            "Zwanenstraat 24" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Arnhem" ;
        min:gemeenteInBoek "Arnhem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Arnhem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Arnhem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Arnhem" ;
        min:lemma "Bedrijfsgebouwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66062>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66063>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66064>,
