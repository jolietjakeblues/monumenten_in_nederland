        schema:name "Windmolen"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Windmolen ‘De Duif’ (Molenweg 91), gelegen ten noorden van het dorp, is een beltkorenmolen met achtkantige houten romp en een met riet gedekte kap, gebouwd in 1866 en gerestaureerd in 1963. Het molenaarshuis (Molenweg 93) heeft de jaartalankers ‘1786’. Molenweg 49 is een voorm. maalderij annex woonhuis uit circa 1910."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01331> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nunspeet – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Nunspeet" ;
        min:gemeenteInBoek "Nunspeet" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nunspeet_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Nunspeet" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
