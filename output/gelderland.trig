        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wamel (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wamel" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1713 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0217> ;
        schema:name "Wamel (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een smalle oeverwal van de Waal en voor het eerst vermeld in 893. Het dorp heeft een langgerekte structuur met concentraties aan bewoning langs de Dorpsstraat en Lakenstraat. De Dorpsstraat ligt op de middeleeuwse dijk, tot circa 1860 de Waalbandijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0217.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01714> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wamel (gemeente West Maas & Waal)"@nl ;
        min:adres "Dorpsstraat 73" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wamel (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wamel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19524> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38240" ;
        min:soort "inleiding" ;
        min:volgnummer 1714 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0217> ;
        schema:name "Wamel (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "De Herv. kerk (Dorpsstraat 73), oorspronkelijk gewijd aan St. Victor, bestaat uit een driezijdig gesloten koor met traptoren, kleine zijkoren en een transept met dakruiter. Koor en transept zijn de restanten van een in 1572 grotendeels verwoeste vroeg-15de-eeuwse kruiskerk met westtoren. Tijdens een ingrijpende restauratie in 1953-'57, onder leiding van N.J. Kruizinga en later H. Korswagen, is het gebouw ontpleisterd. De consistorie, de lage zijkoren en de dakruiter werden toegevoegd en in het interieur werden de kruisribgewelven gereconstrueerd. Tot de inventaris behoren een preekstoel (1687; trap uit 1889), een marmeren doopvont met bronzen deksel (1857) en een door H. Knipscheer gebouwd orgel (1870). Op het ommuurde kerkhof bevinden zich graven vanaf circa 1850."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0217.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01715> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wamel (gemeente West Maas & Waal)"@nl ;
        min:adres "St.-Victorstraat 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wamel (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wamel" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1715 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0217> ;
        schema:name "Wamel (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "326" ;
        schema:pageStart "326" ;
        schema:pagination "326" ;
        schema:text "De R.K. kerk St. Victor en Gezellen (bij St.-Victorstraat 1) is een driebeukige kruisbasiliek met halfronde apsis en doopkapel, gebouwd in 1952-'54 naar ontwerp van J.J.M. van Halteren in traditionalistische vormen. De kerk vervangt een in 1944 verwoeste kerk uit 1878-'79. Op het kerkhof bevindt zich het grafmonument voor dijkgraaf A. Schouten (†1876), met een beeld van een knielend meisje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0217.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01716> a min:Passage,
