        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0016> ;
        schema:name "Andelst (gemeente Valburg)"@nl ;
        schema:pageEnd "67" ;
        schema:pageStart "67" ;
        schema:pagination "67" ;
        schema:text "Dorp, ontstaan op een opgehoogde stroomrug, die vanaf de Romeinse tijd continu bewoond is geweest. Het dorp kreeg een onregelmatig gevormde dorpskern rondom de kerk en lintbebouwing langs de uitvalswegen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0016.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00268> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Andelst (gemeente Valburg)"@nl ;
        min:adres "Kerkstraat 22" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
