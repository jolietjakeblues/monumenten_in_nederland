        min:kern "Beekbergen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 404 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "De R.K. St.-Willibrorduskerk (H. Vulinkweg 30), een sobere houten noodkerk uit 1959, is opgetrokken naar plannen van J.G.A. van Dongen. Het sanatorium ‘Immendaal’ (Loenenseweg 50) heeft een hoofdgebouw met centrale torenpartij, gebouwd in 1909-'10 in nieuw historiserende stijl naar plannen van J.J., M.A. en J. van Nieukerken. Het is nu in gebruik als verpleegtehuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00405> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beekbergen (gemeente Apeldoorn)"@nl ;
        min:adres "Dorpsstraat 86" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
