        min:hoofdstuk "Steden, dorpen, monumenten › Beuningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beuningen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 453 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0036> ;
        schema:name "Beuningen"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug van de Waal. De oorspronkelijke dorpskernen - nabij kasteel De Blankenburgh en nabij het zuidelijker gelegen Liende - zijn aan elkaar gegroeid. Na de Tweede Wereldoorlog is het dorp uitgebreid in westelijke en zuidwestelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00454> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beuningen"@nl ;
        min:adres "Molenstraat 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Beuningen" ;
        min:gemeenteInBoek "Beuningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beuningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beuningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beuningen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 454 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0036> ;
        schema:name "Beuningen"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De Herv. kerk (Molenstraat 3) is een uit 1821 daterende eenvoudige zaalkerk met dakruiter en aangebouwde pastorie. Tot de inventaris behoren een preekstoel uit de bouwtijd en een door de gebroeders Gradussen gebouwd orgel met neogotische kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0036.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00455> a min:Passage,
