        min:hoofdstuk "Steden, dorpen, monumenten › Gendt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gendt" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 853 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0088> ;
        schema:name "Gendt"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "177" ;
        schema:pagination "177-178" ;
        schema:text "Kleine stad, ontstaan in de vroege middeleeuwen op een stroomrug. De nederzetting kreeg in 1233 stadsrechten maar een stedelijke ontwikkeling heeft zich niet doorgezet. In de 19de-eeuw concentreerde de bebouwing zich rond de Herv. kerk. Een groot deel van de dorpskern is in de Tweede Wereldoorlog verwoest. Na de oorlog is Gendt in noordelijke en westelijk richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0088.php> .

