        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terborg (gemeente Wisch)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Terborg" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1525 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0192> ;
        schema:name "Terborg (gemeente Wisch)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "De R.K. St.-Gregoriuskerk (Hoofdstraat 73) is een driebeukige neogotische kruiskerk met een toren van vier geledingen met ingesnoerde naaldspits. De toren verrees in 1877 naar ontwerp van A. Tepe. De oude kerk uit 1842 werd in 1913-'14 vervangen door de huidige naar plannen van J. Stuyt. Het neogotische retabel van het Maria-altaar bevat twee laat-gotische beelden (Maria met het Kind en St. Cunera)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0192.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01526> a min:Passage,
