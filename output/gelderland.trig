        min:gemeenteInBoek "Beuningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beuningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ewijk (gemeente Beuningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ewijk" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10873>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50387> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "9544",
            "9545" ;
        min:soort "inleiding" ;
        min:volgnummer 813 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0081> ;
        schema:name "Ewijk (gemeente Beuningen)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "De R.K. St.-Johannes de Doperkerk (Julianastraat 9) is een driebeukige pseudobasilicale kruiskerk met een achtzijdige dakruiter en een door torentjes geflankeerde, vijfzijdig gesloten apsis. De kerk verrees in 1916-'17 naar een ontwerp met neoromaanse elementen van Jos. Margry. De geplande toren is niet uitgevoerd. Tot de inventaris behoren het orgel door N.F. Smits (1819), twee neobarokke biechtstoelen (1851) en een rijke, door J.F. Buijssen vervaardigde preekstoel (1859). De pastorie (Julianastraat 7) dateert uit 1839."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0081.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00814> a min:Passage,
