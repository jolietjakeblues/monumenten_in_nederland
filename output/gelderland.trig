        min:hoofdstuk "Steden, dorpen, monumenten › Well (gemeente Maasdriel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Well" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1739 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0221> ;
        schema:name "Well (gemeente Maasdriel)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een opgeworpen omhoging (woerd). Well wordt in 983 voor het eerst genoemd. Rond 1850 bestond de lineaire hoofdstructuur uit de ongeveer evenwijdige bebouwingsassen Wellsedijk en Dorpsstraat-Dreef. Daarna heeft de bebouwing zich verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0221.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01740> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Well (gemeente Maasdriel)"@nl ;
        min:adres "Dorpstraat 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Maasdriel" ;
        min:gemeenteInBoek "Maasdriel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasdriel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Well (gemeente Maasdriel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Well" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51316>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54450> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "8109",
            "8110" ;
        min:soort "inleiding" ;
        min:volgnummer 1740 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0221> ;
        schema:name "Well (gemeente Maasdriel)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De Herv. kerk (Dorpstraat 7) is een pseudobasiliek met driezijdig gesloten koor en een ingebouwde toren van drie geledingen met ingesnoerde spits. De tufstenen onderbouw van de toren verrees in de 12de eeuw. De bovenste twee geledingen en het driebeukige schip kwamen in de eerste helft van de 16de eeuw tot stand. In de toren hangt een door Jan Moer gegoten klok (1546). Het koor is een reconstructie uit 1949-'50 van het in 1842 gesloopte middeleeuwse koor. Bij die restauratie is inwendig een tongewelf aangebracht. De kerk bevat een preekstoel uit de eerste helft van de 17de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0221.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01741> a min:Passage,
