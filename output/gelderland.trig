        schema:name "Hattem"@nl ;
        schema:pageEnd "189" ;
        schema:pageStart "189" ;
        schema:pagination "189" ;
        schema:text "De voorm. synagoge (Achterstraat 33) is een uit 1873 daterend zaalgebouw in neogotische vormen. De van wenkbrauwen voorziene spitsboogvensters hebben gietijzeren traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0097.php> .

