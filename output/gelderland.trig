        schema:name "Wehl"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Het voorm. St.-Rosaklooster (Keppelseweg 29), gesticht in 1845, is een fors gepleisterd eclectisch pand uit circa 1860. De aangebouwde kapel dateert uit 1893."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0220.php> .

