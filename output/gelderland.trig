        min:kern "Voorthuizen" ;
        min:lemma "Stroe" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58287>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79055> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523203",
            "8625" ;
        min:soort "lemma" ;
        min:volgnummer 1667 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0210> ;
        schema:name "Stroe"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "315" ;
        schema:pagination "315-316" ;
        schema:text "Stroe. Nabij dit dorp ten oosten van Voorthuizen ligt de 18de-eeuwse hallenhuisboerderij ‘Hooimansgoed’ (Wolweg 6), waarvan de deel in 1854 is verbouwd. Op het erf bevinden zich een bakhuis en schaapskooi met houten wanden, beide uit de 19de eeuw. Ten noorden van het dorp ligt de Rijkszaadeest (Wolweg 79), een eenlaags gebouw met een brandvrije oven en een centraal verwarmingssysteem, gebouwd in 1912-'13 naar plannen van houtvester E. Hesselink. De zaadeest dient om uit geïmporteerde dennenzaadkegels zaad te winnen voor het bebossen van heidevelden en zandverstuivingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0210.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01668> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vorchten (gemeente Heerde)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
        min:gemeenteInBoek "Heerde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerde_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vorchten (gemeente Heerde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vorchten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1668 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0211> ;
        schema:name "Vorchten (gemeente Heerde)"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op een oeverwal van de IJssel. De kerk ligt op de westelijke rand van de Vorchter es. Ten noorden van de kerk bevinden zich de grachten van het in 1829 gesloopte adellijke huis Zwanenburg. Het dorp heeft een voornamelijk agrarisch karakter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0211.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01669> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vorchten (gemeente Heerde)"@nl ;
        min:adres "Kerkweg 17" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
        min:gemeenteInBoek "Heerde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerde_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vorchten (gemeente Heerde)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vorchten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28358>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37699> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "21157",
            "21158" ;
        min:soort "inleiding" ;
        min:volgnummer 1669 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0211> ;
        schema:name "Vorchten (gemeente Heerde)"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "De Herv. kerk (Kerkweg 17), oorspronkelijk gewijd aan St. Johannes de Doper, is een eenbeukige kerk met hoger, driezijdig gesloten koor en een brede ongelede toren met zadeldak. De romaanse toren is vermoedelijk kort na de verheffing tot parochiekerk in 1176 gebouwd en heeft smalle zijruimten die oorspronkelijk samen een gereduceerd westwerk vormden. Het zadeldak zal in de 17de eeuw zijn aangebracht. In de toren hangt een door Hendrick ter Horst gegoten klok (1641). Het vermoedelijk 13de-eeuwse, romaanse schip werd in de 14de eeuw verhoogd en in 1856 ingrijpend verbouwd. Uit de 14de eeuw stamt het gotische koor dat in de 15de eeuw werd verhoogd. Het koor wordt gedekt door kruisribgewelven en het schip door een gepleisterd plafond (1856). Tot de inventaris behoren een maniëristische preekstoel (1630) en een door J. Proper gebouwd orgel (1888)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0211.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01670> a min:Passage,
