        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0232> ;
        schema:name "Halle"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "347" ;
        schema:pagination "347-348" ;
        schema:text "Halle. Dorp ten oosten van Zelhem. De Herv. kerk (Dorpsstraat 19) is een zaalkerk uit 1858, aan beide korte zijden driezijdig gesloten. Na oorlogsschade is de kerk herbouwd in 1952. In 1976 heeft men het voorportaal verhoogd tot een toren. De Geref. kerk (Dorpsstraat 85) is een zaalkerk uit 1937 naar plannen van W.M. Heblij."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0232.php> .

