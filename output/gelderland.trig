        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "De voorm. pastorie (Kerkplein 8) is een tweebeukig pand uit 1840 naar ontwerp van K. Smits; momenteel dient het pand als verenigingsgebouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0146.php> .

