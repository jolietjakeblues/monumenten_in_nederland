        min:soort "inleiding" ;
        min:volgnummer 478 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0039> ;
        schema:name "Boven-Leeuwen (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "Dorp, ontstaan op een brede oeverwal van de Waal. Aan de voorm. Koningsstraat (nu Van Heemstraweg) kwam tussen de Molenstraat en de Waterstraat de eerste bebouwing tot stand. Oorspronkelijk vormde het een geheel met Boven-Leeuwen, maar na de bouw in 1898 van de katholieke kerk in Beneden-Leeuwen volgde een scheiding. Het dorp Boven-Leeuwen ontwikkelde zich verder in oostelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00479> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boven-Leeuwen (gemeente West Maas & Waal)"@nl ;
        min:adres "Waalbandijk 21" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
