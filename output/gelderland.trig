        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "Het raadhuis (Raadhuisstraat 14) werd in 1938 gebouwd in traditionalistische vormen naar plannen van Jos. Franssen. Het is in 1969-'70 en in 1993-'94 fors uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00588> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:adres "Wilhelminastraat 73" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
