        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0037> ;
        schema:name "Beusichem (gemeente Buren)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug van de Lek. Beusichem ontwikkelde zich tot een gestrekt esdorp met parallelle wegen. De dominerende, langgerekte Markt is ontstaan uit een verbreding van de hoofdweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00461> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beusichem (gemeente Buren)"@nl ;
        min:adres "Markt 14" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Buren" ;
        min:gemeenteInBoek "Buren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Buren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beusichem (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beusichem" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35120>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40610> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "11412",
            "11413" ;
        min:soort "inleiding" ;
        min:volgnummer 461 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill132> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0037> ;
        schema:name "Beusichem (gemeente Buren)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "De Herv. kerk (Markt 14), oorspronkelijk gewijd aan St. Johannes de Doper, is een driebeukige pseudobasilicale kerk met vijfzijdig gesloten koor en een toren van vijf geledingen met tentdak. De onderste vier geledingen van de toren zijn opgetrokken in tufsteen en dateren uit de 12de eeuw. De verhoging in baksteen dateert uit de eerste helft van de 15de eeuw, toen ook het koor tot stand kwam. Het schip is 14de-eeuws. De bepleistering is in de 19de eeuw aangebracht. De consistorie aan de noordzijde is in 1961 gebouwd ter vervanging van een voorganger uit 1891. De kerk is in 1995-'96 gerestaureerd. Het interieur wordt gedekt door een houten tongewelf boven schip en koor en halve, gestucte tongewelven boven de zijbeuken. Tot de inventaris behoren een bank (circa 1620), een rouwbord (1673), een preekstoel (circa 1850) en een door C.G.F. Witte gebouwd orgel (1858)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0037.php> .

