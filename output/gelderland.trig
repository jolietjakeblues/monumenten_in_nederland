        min:kern "Deil" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38431> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16495" ;
        min:soort "lemma" ;
        min:volgnummer 580 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0051> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "Windmolen ‘De Vlinder’ (bij Appeldijk 5) is een ronde gepleisterde stellingmolen, gebouwd in 1913 ter plaatse van een afgebrande voorganger. Deze korenmolen is in 1930, 1961 en 1975 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0051.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00581> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Didam" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 581 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0052> ;
        schema:name "Didam"@nl ;
        schema:pageEnd "135" ;
        schema:pageStart "135" ;
        schema:pagination "135" ;
        schema:text "Dorp, ontstaan op een laagterras tussen de Rijn en de Oude IJssel en voor het eerst vermeld in 828. In 1200 werd het een zelfstandige parochie, behorend tot de proosdij van Emmerik. Didam ontwikkelde zich tot een middelgroot dorp na de opheffing van de marke in 1833 en de vestiging van enkele klompenmakerijen. Na de Tweede Wereldoorlog is het sterk gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00582> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:adres "Lieve Vrouweplein 13" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Didam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21348> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "12870" ;
        min:soort "inleiding" ;
        min:volgnummer 582 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0052> ;
        schema:name "Didam"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "135" ;
        schema:pagination "135-136" ;
        schema:text "De R.K. kerk O.L. Vrouwe van Altijddurende Bijstand (Lieve Vrouweplein 13) is een laat-gotische driebeukige pseudobasiliek met driezijdig gesloten koor en een forse toren van drie geledingen met tentvormig dak. Het koor stamt van na een brand in 1367. De monumentale, met tufsteen beklede toren in Nederrijnse laat-gotiek verrees rond het midden van de 15de eeuw en werd kort voor 1458 voltooid. Mogelijk heeft Gisbert van Kranenburg bemoeienissen met het ontwerp gehad. Het huidige lage torendak is in 1846 aangebracht. Schip en zijbeuken kwamen rond 1493-'94 tot stand. Na de overgang van de kerk van hervormde in katholieke handen in 1953 is het gebouw in 1956-'62 gerestaureerd naar plannen van J.G. Deur en C. Pouderoyen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00583> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Didam" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 583 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0052> ;
        schema:name "Didam"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "Het interieur wordt gedekt door kruisribgewelven, die rusten op kolonetten met gebeeldhouwde kraagstenen. Alleen de gewelven van de noordbeuk zijn uit de bouwtijd, het koorgewelf dateert uit 1619 en de overige gewelven zijn bij de restauratie aangebracht. Tot de inventaris behoren vier laat-gotische apostelbeelden (eind 15de eeuw) en kruiswegstaties (circa 1840)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00584> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:adres "Kerkstraat 22-24" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Didam" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 584 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0052> ;
        schema:name "Didam"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "Het voorm. Pius-gesticht (Kerkstraat 22-24) is een in 1877 gesticht klooster van de zusters van de sociëteit van Jezus, Maria en Jozef. Het werd in 1899 uitgebreid met een neogotische kapel en een zijvleugel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00585> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:adres "Raadhuisstraat 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Didam" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 585 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0052> ;
        schema:name "Didam"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "De Albertusstichting (Raadhuisstraat 3) is in 1891 gesticht als klooster annex gasthuis. Van het oorspronkelijke complex resteren een deel van het gebouw voor patiënten met besmettelijke ziekten (1896) en het ziekenhuis (W.G. Welsing, 1908)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00586> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Didam"@nl ;
        min:adres "Torenstraat 10" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Didam" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Didam" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
