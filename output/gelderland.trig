        min:soort "lemma" ;
        min:volgnummer 882 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0092> ;
        schema:name "De Beerenclaauw"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "De Beerenclaauw (Beerenclaauwstraat 8) is een voorm. havezate, waarvan de kelders en mogelijk delen van het opgaande werk uit de late middeleeuwen dateren."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0092.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00883> a min:Passage,
            schema:CreativeWork ;
