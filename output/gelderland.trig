        schema:name "Kerkwijk (gemeente Zaltbommel)"@nl ;
        schema:pageEnd "212" ;
        schema:pageStart "212" ;
        schema:pagination "212" ;
        schema:text "Dorp, ontstaan op de stroomrug die dwars door de Bommelerwaard loopt. De nederzetting wordt voor het eerst vermeld in 1205. Het dorp heeft zich vanaf de vroege middeleeuwen ontwikkeld tot een gestrekt esdorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0127.php> .

