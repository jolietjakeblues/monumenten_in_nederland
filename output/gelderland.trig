        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aalten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Aalten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 222 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0008> ;
        schema:name "Aalten"@nl ;
        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "De synagoge (Stationsstraat 7) is een zaalgebouw uit 1857, voorzien van een ingangsomlijsting met ionische pilasters. Op de kroonlijst staat de Hebreeuwse tekst van Psalm 118:20. De topgevel stamt van een verbouwing uit 1926 naar plannen van J.B. Blikkink. De sjoel is in 1950 opnieuw ingericht en in 1986 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00223> a min:Passage,
