        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill328> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0158> ;
        schema:name "Nunspeet"@nl ;
        schema:pageEnd "264" ;
        schema:pageStart "264" ;
        schema:pagination "264" ;
        schema:text "Esdorp, ontstaan aan de noordwestrand van de Veluwse zandgronden. Een grote brand verwoestte in 1855 de omgeving van de Dorpsstraat. Het dorp kreeg een station aan de lijn Amersfoort-Zwolle. In de 20ste eeuw is Nunspeet sterk naar het zuidwesten en noordoosten uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0158.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01326> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nunspeet"@nl ;
        min:adres "Dorpsstraat 12" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
