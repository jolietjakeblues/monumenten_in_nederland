            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33702>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41615> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16709",
            "16711",
