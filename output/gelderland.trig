        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gendt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gendt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59481>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61592> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16080",
            "16081" ;
        min:soort "inleiding" ;
        min:volgnummer 854 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0088> ;
        schema:name "Gendt"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "De Herv./Geref. kerk (Torenlaan 14), oorspronkelijk gewijd aan St. Martinus, bestaat uit een 14de-eeuwse toren van twee geledingen met ingesnoerde spits en een 15de-eeuws, driezijdig gesloten koor. Het tussenliggende romaanse driebeukige schip met dwarsarm werd in 1844 gesloopt, maar de funderingen hiervan zijn tot boven het maaiveld opgemetseld bij de restauratie in 1958-'66. Bij die restauratie, naar plannen van Ch. Estourgie, zijn het portaal en de consistorie aan het koor toegevoegd. In de toren hangt een door Peter van Trier en Johan Philipsen gegoten klok (1638)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00855> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gendt"@nl ;
        min:adres "Nijmeegsestraat 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Gendt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gendt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gendt" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 855 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0088> ;
        schema:name "Gendt"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "De R.K. St.-Martinuskerk (Nijmeegsestraat 4) is een driebeukige basiliek met driezijdige apsis, lage dwarsbeuk, vieringtoren, aangebouwd baptisterium en een opzij geplaatste toren van twee geledingen. De kerk is in 1951-'52 gebouwd in traditionalistische vormen naar ontwerp van Joh.H. Sluijmer ter vervanging van een in 1944 verwoeste voorganger uit 1906. De toren is in 1959-'60 voltooid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00856> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gendt"@nl ;
        min:adres "Poelwijklaan 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Gendt" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gendt" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gendt" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 856 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0088> ;
        schema:name "Gendt"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "De poorttoren bij Huis Poelwijk (Poelwijklaan 1) is een 15de-eeuws vierkant bouwwerk met tentdak, dat later tot woontoren is verbouwd. Onder leiding van M.J.J. van Beveren is de toren in 1940 gerestaureerd; de zware oorlogsschade is in 1959-'60 hersteld. Het interieur bevat een gotische schouw en een 18de-eeuwse schouw met rondom onder meer geschilderde allegorische figuren. Van het Huis Poelwijk zijn verder slechts enkele 13de-eeuwse en jongere fundamenten bekend. In 1864 is naast de poorttoren een gepleisterde hallenhuisboerderij met dwars voorhuis gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0088.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00857> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gorssel"@nl ;
