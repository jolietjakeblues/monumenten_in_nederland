        min:rijksmonumentnummer "36756" ;
        min:soort "lemma" ;
        min:volgnummer 1373 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill338> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0164> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Boerderijen. De voorm. boerderij Ceciliahof (Dorpsstraat 19) is een wit geschilderde hallenhuisboerderij met fors tweebeukig voorhuis met omlijste ingang uit circa 1850; het achterhuis is gewijzigd. Groenestraat 5 is een hallenhuisboerderij met dwars voorhuis uit circa 1900. De boerderij heeft een lang achterhuis en een lange schuur. Hallenhuisboerderijen zijn: Alandshoeve (Peperstraat 54; circa 1875), met houtsierwerk als geveltopvulling, en Dorpsstraat 37 (circa 1920) met mansardedak en decoratief gebruik van diverse kleuren verblendsteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0164.php> .

