        schema:name "Doornspijk (gemeente Elburg)"@nl ;
        schema:pageEnd "148" ;
        schema:pageStart "148" ;
        schema:pagination "148" ;
        schema:text "De Geref. kerk (Zuiderzeestraatweg West 84) is een recht gesloten kruiskerk voorzien van een forse hoektoren met tentdak, gebouwd in 1923-'24 in expressionistische stijl naar plannen van P.H. van Lonkhuyzen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0059.php> .

