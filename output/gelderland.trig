        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0057> ;
        schema:name "Doetinchem"@nl ;
        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De kerk Predik het Evangelie (Burg. Van Nispenstraat 19) is in 1881 gebouwd in opdracht van ds. J. van Dijk en is uitgevoerd in rijke eclectische vormen. De kerk is momenteel in gebruik bij de Baptistengemeente. De pastorie (Burg. Van Nispenstraat 21) stamt uit dezelfde tijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00638> a min:Passage,
