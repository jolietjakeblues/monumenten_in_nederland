        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oene (gemeente Epe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oene" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1337 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0160> ;
        schema:name "Oene (gemeente Epe)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Dorp, ontstaan in de late middeleeuwen op een stroomrug. In 1176 is er sprake van een kapel, die vervolgens in 1238 als parochiekerk wordt genoemd. Ten zuidwesten van het dorp lag in de middeleeuwen het klooster Maria van Nazareth, dat na de Reformatie nog lang als brouwerij fungeerde."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01338> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oene (gemeente Epe)"@nl ;
        min:adres "Dorpsstraat 1",
            "Eperweg 29-31" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Epe" ;
        min:gemeenteInBoek "Epe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Epe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oene (gemeente Epe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oene" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50574> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "15349" ;
        min:soort "inleiding" ;
        min:volgnummer 1338 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill330> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0160> ;
        schema:name "Oene (gemeente Epe)"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "265" ;
        schema:pagination "265-266" ;
        schema:text "De Herv. kerk (Dorpsstraat 1), oorspronkelijk gewijd aan St. Dionysius, is een driebeukige kerk met noordelijke dwarsbeuk, driezijdig gesloten koor met zijkapellen en een ingebouwde toren van twee geledingen met ingesnoerde spits. De in tufsteen uitgevoerde onderbouw van de toren heeft lagere zijruimten en is het restant van een romaans gereduceerd westwerk uit het begin van de 12de eeuw. De toren werd midden 17de eeuw verhoogd en bevat een door Gerard Schimmel en Roelof Henrycks gegoten klok (1661). Tegen het romaanse schip, dat in de eerste helft van de 14de eeuw is verhoogd, zijn in de 15de eeuw zijbeuken geplaatst met opvallend lage zijmuren; van die laatste bouwfase dateert ook het koor. Niet lang daarna kreeg het koor zijkapellen en brak men de zijruimten van het gereduceerd westwerk door naar de zijbeuken. De noordelijke dwarsbeuk werd in 1951 toegevoegd. Het schip wordt gedekt door kruisribgewelven. De kerk bevat een door J.H.H. Bätz gebouwd orgel (1766) gemaakt voor de R.K. Martinuskerk te Utrecht en in 1852 hier geplaatst. De voorm. pastorie (Eperweg 29-31), een eenlaagspand met verhoogd middendeel, dateert uit het eind van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01339> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oene (gemeente Epe)"@nl ;
        min:adres "Houtweg 41" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
