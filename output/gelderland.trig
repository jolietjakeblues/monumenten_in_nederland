        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42695> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38101" ;
        min:soort "inleiding" ;
        min:volgnummer 1770 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0226> ;
        schema:name "Wilp (gemeente Voorst)"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text "De forse gepleisterde neoclassicistische pastorie (Kerkstraat 33) stamt uit circa 1860. Nabij de kerk staat een gietijzeren dorpspomp uit circa 1860 in de vorm van een gecanneleerde zuil."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0226.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01771> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wilp (gemeente Voorst) – De Lathmer"@nl ;
        min:adres "Lathmerweg 3",
            "Lathmerweg 5" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wilp (gemeente Voorst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wilp" ;
        min:lemma "De Lathmer" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79810>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79811> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523333",
            "523334" ;
        min:soort "lemma" ;
        min:volgnummer 1771 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0226> ;
        schema:name "De Lathmer"@nl ;
        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text """De Lathmer (Lathmerweg 5). De oorspronkelijke havezate ontstond vermoedelijk in de 16de eeuw en werd kort na 1866 vervangen door een nieuw huis. Nadat dit huis in 1911 was afgebrand, liet C. Crommelin een geheel nieuw, L-vormig huis in neorenaissance-stijl bouwen naar plannen van M.A. en J. van Nieukerken. Dezen lieten zich bij hun ontwerp inspireren door afbeeldingen van de oude havezate. Het huis dient nu als hoofdgebouw van een inrichting voor geestelijk gehandicapten.

De tuinaanleg uit 1911 is ontworpen door L.A. Springer. Het in neorenaissance-stijl uitgevoerde koetshuis met stal en dienstwoning (Lathmerweg 3) is uit dezelfde tijd. De gepleisterde portierswoning Lathmerweg 9 werd kort na 1866 gebouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0226.php> .

