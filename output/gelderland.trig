        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenderen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Steenderen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1515 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0191> ;
        schema:name "Steenderen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Dorp, ontstaan op een oeverwal van de IJssel en in 1046 voor het eerst genoemd als ‘Steenre’. In 1217 is er sprake van een parochiekerk. In 1762 teisterde een felle brand het dorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01516> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenderen"@nl ;
        min:adres "Dorpsstraat 20" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenderen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Steenderen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50946> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "34521" ;
        min:soort "inleiding" ;
        min:volgnummer 1516 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0191> ;
        schema:name "Steenderen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "De Herv. kerk (Dorpsstraat 20), oorspronkelijk gewijd aan St. Remigius, is een laat-gotische pseudobasiliek met driezijdig gesloten koor en een toren van vier geledingen met ingesnoerde spits. De twee onderste torengeledingen zijn 14de-eeuws. Rond 1440 kwam het koor met de recht gesloten zijkapellen tot stand; de kapel aan de noordzijde bevat de sacristie. Eind 15de of begin 16de eeuw verrees het driebeukige schip en werd de toren verhoogd. In de toren hangt een door Hendrick ter Horst gegoten klok (1635). Bij een brand in 1782 die ontstond als gevolg van blikseminslag, gingen onder meer de gewelven verloren. Bij de herbouw in 1783 naar plannen van Teunis Wittenberg bracht men houten plafonds aan en kreeg de toren een lage ingesnoerde spits. De houten kerkvensters dateren van een herstelling in 1836. De kerk is in 1966-'72 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01517> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenderen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Steenderen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Steenderen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1517 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0191> ;
        schema:name "Steenderen"@nl ;
        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Het interieur wordt gedekt door een houten gewelf, aangebracht bij de restauratie. Tot de inventaris behoren een preekstoel met doophek in Lodewijk XIV-vormen (1738) - afkomstig uit de afgebroken kerk te Bovenkarspel (NH) - en het vermoedelijk door Johannes Mitterreither gebouwde orgel (circa 1780; geplaatst in 1971)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01518> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Steenderen"@nl ;
        min:adres "Bronkhorsterweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
