        schema:name "Nederasselt (gemeente Heumen)"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Dorp, gelegen op een stroomrug en ontstaan in de 12de eeuw als afscheiding van Overasselt. Na de aanleg van de Rijksweg Den Bosch-Nijmegen in 1929 heeft het dorp zich ten oosten hiervan verder ontwikkeld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0150.php> .

