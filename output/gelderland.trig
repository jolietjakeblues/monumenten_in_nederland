        schema:name "Oosterhout (gemeente Valburg)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "De Herv./Geref. kerk (Dorpsstraat 54) is een recht gesloten zaalkerk uit 1900 met neogotische en neoromaanse vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01371> a min:Passage,
