        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Dorp, ontstaan in het midden van de 19de eeuw bij een in 1845 gestichte kerk. De bebouwing heeft zich in de loop van de 20ste eeuw enigszins verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0165.php> .

