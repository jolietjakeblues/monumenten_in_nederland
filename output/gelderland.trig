        schema:pageEnd "196" ;
        schema:pageStart "196" ;
        schema:pagination "196" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een opgehoogde stroomrug. De dorpskern bij de kerk werd in de Tweede Wereldoorlog zwaar beschadigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0103.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00964> a min:Passage,
