        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72265>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72266>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72267>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/72268> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "39057",
            "523458",
            "523459",
            "523460" ;
        min:soort "inleiding" ;
        min:volgnummer 1787 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0228> ;
        schema:name "Winterswijk"@nl ;
        schema:pageEnd "336" ;
        schema:pageStart "336" ;
        schema:pagination "336" ;
        schema:text "De synagoge (Spoorstraat 32) is een zaalgebouw met neorenaissance-elementen, gebouwd in 1888-'89 naar plannen van H. van der Schaaf. Boven de ingang staat de Hebreeuwse tekst van Psalm 116:4. De sjoel werd in 1951 opnieuw ingericht en in 1982-'84 gerestaureerd. De ark (1799) is afkomstig uit Arnhem, de biema uit Elburg. Uit de bouwtijd van de synagoge dateren ook het mikwegebouwtje aan de noordzijde en de in chaletstijl uitgevoerde woning van de Chazzan (Spoorstraat 34-36). De laatste kreeg in 1908 een uitbreiding met een godsdienstschool in jugendstil-vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0228.php> .

