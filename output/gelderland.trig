        min:soort "inleiding" ;
        min:volgnummer 1546 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0195> ;
        schema:name "Tiel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "De Herv. kerk (Burg. Meslaan 92, Drumpt) is een recht gesloten zaalkerk met een gedeeltelijk ingebouwde toren van drie geledingen met omloop en houten, opengewerkte klokkentoren met spits. De kerk verrees in 1860 en heeft neoclassicistische kenmerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01547> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tiel"@nl ;
        min:adres "Binnenmolenstraat 6-8",
            "St.-Walburgkerkpad 1",
            "St.-Walburgkerkpad 17-43",
            "St.-Walburgkerkpad 3",
            "St.-Walburgkerkpad 5" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Tiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tiel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tiel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68717>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/68718> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "520655",
            "520656" ;
        min:soort "inleiding" ;
        min:volgnummer 1547 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0195> ;
        schema:name "Tiel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "De R.K. St.-Dominicuskerk (St.-Walburgkerkpad 1) [3] is een driebeukige basiliek met driezijdig gesloten apsis en een hoger, transept-achtig bouwdeel voorzien van zijvleugels. De deels ingebouwde toren van vier geledingen met vlak tentdak wordt geflankeerd door de doopkapel en de gedachteniskapel. De kerk verrees in 1939-'40 in traditionalistische stijl, naar ontwerp van J.J. van Halteren, ter plaatse van een in 1938 door brand verwoeste voorganger uit 1859-'61. Het interieur wordt gedekt door een hoog spitsboogvormig gewelf (schip) en door koepelgewelven. Enkele figuratieve gebrandschilderde ramen zijn vervaardigd naar ontwerp van A. Asperslagh. De L-vormige pastorie (St.-Walburgkerkpad 3) is gelijktijdig en in dezelfde stijl gebouwd als de kerk. Tot het katholieke complex bij de kerk behoren een dominicanessenklooster (St.-Walburgkerkpad 5), het in 1900 naar een ontwerp met jugendstil-elementen van J. Buskens opgetrokken voorm. St.-Andreasgasthuis (St.-Walburgkerkpad 17-43) - in dit voorm. ziekenhuis zijn thans appartementen ondergebracht - en de in 1867 gestichte en in 1900 opnieuw opgetrokken voorm. RK. bewaarschool (Binnenmolenstraat 6-8)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01548> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tiel"@nl ;
        min:adres "Ambtmanstraat 24" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Tiel" ;
        min:gemeenteInBoek "Tiel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Tiel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tiel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tiel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33766> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35559" ;
        min:soort "inleiding" ;
        min:volgnummer 1548 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0195> ;
        schema:name "Tiel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "298" ;
        schema:pagination "298" ;
        schema:text "Het Oude Burger Mannen- en Vrouwenhuis (Ambtmanstraat 24) [4] uit 1804 is een langgerekt, onderkelderd tweebeukig neoclassicistisch gebouw met empire-details. De voorgevel heeft een middenrisaliet met fronton en geblokte bakstenen hoekpilasters. In het voorportaal bevindt zich stucwerk met een saterkop en festoenen van de hand van J.M. Rieff."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0195.php> .

