        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0114> ;
        schema:name "Hoenderloo (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "Dorp op de Veluwestuwwal, ontstaan nadat hier in 1841 in opdracht van ds. O.G. Heldring een waterput was gegraven en in 1848 een huis voor verwaarloosde minderjarigen was gesticht. Ook na de aanleg van een grindweg naar Apeldoorn in 1872 bleef de groei van het dorp beperkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0114.php> .

