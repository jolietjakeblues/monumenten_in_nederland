        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Erichem (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Erichem" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 794 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0078> ;
        schema:name "Erichem (gemeente Buren)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een stroomrug. Het dorp ontwikkelde zich tot een gestrekt esdorp dat de gebogen richting van de voormalige stroomgeul volgt. De lintbebouwing concentreert zich langs de Erichemseweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00795> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Erichem (gemeente Buren)"@nl ;
        min:adres "Binnenstraat 1",
            "Erichemseweg 39" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Buren" ;
        min:gemeenteInBoek "Buren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Buren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Erichem (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Erichem" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56272> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "11417" ;
        min:soort "inleiding" ;
        min:volgnummer 795 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0078> ;
        schema:name "Erichem (gemeente Buren)"@nl ;
        schema:pageEnd "170" ;
        schema:pageStart "170" ;
        schema:pagination "170" ;
        schema:text "De Herv. kerk (Binnenstraat 1), oorspronkelijk gewijd aan St. Joris, is een eenbeukige kerk met een toren van drie geledingen met ingesnoerde naaldspits. De tufstenen onderbouw van de toren dateert uit de tweede helft van de 13de eeuw. De bakstenen bovenbouw is 14de-eeuws. In de toren hangt een door Willem Butendiic gegoten klok (15de eeuw). Het schip kwam rond 1500 tot stand; de kap is in 1611 vernieuwd. Het 15de-eeuwse koor is later op één travee na gesloopt en vervangen door een consistoriekamer. Bij de restauratie van de kerk in 1979-'81, onder leiding van N.C.G.M. van de Rijt, kreeg de consistorie de huidige tweelaags opzet. Tot de kerkinventaris behoren een begin-17de-eeuwse preekstoel en een door A. Meere gebouwd orgel (vermoedelijk rond 1815). De pastorie (Erichemseweg 39) is een gepleisterd herenhuis uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0078.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00796> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Erichem (gemeente Buren)"@nl ;
        min:adres "Erichemseweg 30",
            "Erichemseweg 32" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Buren" ;
        min:gemeenteInBoek "Buren" ;
