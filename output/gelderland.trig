        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill404> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0214> ;
        schema:name "Waardenburg (gemeente Neerijnen)"@nl ;
        schema:pageEnd "319" ;
        schema:pageStart "318" ;
        schema:pagination "318-319" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Haaks op de Waaldijk kwam een gestrekt esdorp tot ontwikkeling, dat door de spoorlijn (1868) en de verkeersweg (1932) Den Bosch-Utrecht in tweeën is gedeeld. Na de Tweede Wereldoorlog is Waardenburg in noordelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0214.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01690> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Waardenburg (gemeente Neerijnen)"@nl ;
        min:adres "Dorpsstraat 23",
            "Kerkstraat 21" ;
