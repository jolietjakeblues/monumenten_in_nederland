        schema:name "Culemborg"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "130" ;
        schema:pagination "130" ;
        schema:text "De Chr. Geref. kerk (Ridderstraat 17) [5] is een eenvoudige zaalkerk uit 1868 met neoclassicistische ingangsomlijsting. Het jaartal 1834 op de voorgevel verwijst naar de Afscheiding."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0049.php> .

