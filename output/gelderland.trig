        schema:name "Almen (gemeente Gorssel)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "De openbare lagere Julianaschool (Dorpsstraat 34) is een vierklassige gangschool uit 1911-'12, naar plannen van M.A. van Nieukerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00253> a min:Passage,
            schema:CreativeWork ;
