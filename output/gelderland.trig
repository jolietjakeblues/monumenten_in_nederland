        schema:name "Terwolde (gemeente Voorst)"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Bij de kerk staat een gietijzeren dorpspomp (bij Kerkstraat 31) uit circa 1860 in de vorm van een gecanneleerde zuil. Het gebouw Pniël (Wijkseweg 25, De Wijk) is een uit 1903 daterende zaalkerk met ingangsportaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0194.php> .

