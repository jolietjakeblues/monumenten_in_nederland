        min:soort "inleiding" ;
        min:volgnummer 1557 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0196> ;
        schema:name "Tolkamer (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "300" ;
        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Dorp, gelegen op een oeverwal waarlangs de Boven-Rijn loopt sinds de dijkdoorbraak tussen Lobith en Schenkenschans (D) in 1711. Doordat de Rijn hier Nederland binnenstroomt, was Tolkamer tot 1989 een belangrijke douanepost. Na de vestiging van een scheepswerf in 1920 is in 1930 een haven gegraven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01558> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tolkamer (gemeente Rijnwaarden)"@nl ;
        min:adres "Europakade 10",
            "Hoofdstraat 2-4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Rijnwaarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tolkamer (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tolkamer" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1558 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0196> ;
        schema:name "Tolkamer (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "300" ;
        schema:pageStart "300" ;
        schema:pagination "300" ;
        schema:text "Het voorm. postkantoor (Hoofdstraat 2-4) is een gedeeltelijk gepleisterd pand uit 1872 in neoclassicistische stijl. Het voorm. douanekantoor (Europakade 10) kwam in 1906 tot stand in simpele, op de neogotiek geënte vormen. In 1915 werd het met een verdieping verhoogd. Het is verwant aan het werk van C.H. Peters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0196.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01559> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tolkamer (gemeente Rijnwaarden) – Woonhuizen"@nl ;
        min:adres "Boterdijk 58-60" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Rijnwaarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tolkamer (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tolkamer" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1559 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill377> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0196> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "300" ;
        schema:pagination "300-301" ;
        schema:text "Woonhuizen. Het herenhuis 's Gravenwaardsedijk 2 verrees rond 1852 voor steenbakker P.J. Kemmeling en diende van 1949 tot 1989 als marechausseekazerne. In eclectische vormen opgetrokken is Nooit gedacht (Boterdijk 58-60), een dubbel woonhuis met gemeenschappelijk middenrisaliet uit circa 1865. Eveneens eclectisch is het rond 1880 gebouwde expediteurshuis Hoofdstraat 42, nu een café-restaurant. Meer neoclassicistisch van vorm zijn de expediteurshuizen Hoofdstraat 28-30 uit 1886, gebouwd voor W.F. d'Harvant. De directeur van de Lobithse Stoombootmaatschappij T. Daams liet in 1900 de grote villa Europakade 6 bouwen; dit pand met hoektoren vertoont neorenaissance- en jugendstil-elementen. Eenzelfde vormgeving hebben de woningen Hoofdstraat 16 (1909) en Hoofdstraat 31 (1910). De arbeiderswoningen Hinkeman 1-23 werden rond 1905 gebouwd in sobere, gepleisterde vormen met jugendstil-details. Het tuindorp (Tengbergenstraat e.o.) verrees in 1919-'20 in traditionalistische vormgeving voor de naastgelegen scheepswerf Bodewes (nu scheepswerf De Hoop). Douanewoningen. Voor de huisvesting van douanebeambten liet de Rijksgebouwendienst rond 1906 het woningblok Tolstraat 39-49 bouwen. De dubbele woningen Hoofdstraat 1-11 uit 1912 zijn groter van opzet en meer plastisch van vorm."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0196.php> .

