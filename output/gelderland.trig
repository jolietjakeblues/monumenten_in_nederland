        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0179> ;
        schema:name "Rijswijk (gemeente Buren)"@nl ;
        schema:pageEnd "282" ;
        schema:pageStart "282" ;
        schema:pagination "282" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug van de Neder-Rijn en voor het eerst vermeld in 866. Langs de Rijnbandijk en de haaks daarop gelegen Kerkstraat ontwikkelde zich een gestrekt dorp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0179.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01449> a min:Passage,
