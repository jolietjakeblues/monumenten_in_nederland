        min:soort "lemma" ;
        min:volgnummer 1753 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill420> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0223> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text "Woonhuizen. De blokvormige herenhuizen Roozenburgh (Pastoor van der Marckstraat 56) en Zonnekamp (Pastoor van der Marckstraat 29-31) dateren uit circa 1870 en zijn uitgevoerd in eclectische vormen. Steenfabrikant Th.A. Burgers liet in 1893 het pand De Buitenhof (Jonkerstraat 1) bouwen. Deze directeursvilla vertoont neorenaissance-vormen en chaletstijl-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0223.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01754> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Weurt (gemeente Beuningen) – Boerderijen"@nl ;
        min:adres "Dijk 5",
            "Jonkerstraat 30" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Beuningen" ;
        min:gemeenteInBoek "Beuningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Beuningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Weurt (gemeente Beuningen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Weurt" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27671>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48141> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523173",
            "9550" ;
        min:soort "lemma" ;
        min:volgnummer 1754 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0223> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "331" ;
        schema:pageStart "331" ;
        schema:pagination "331" ;
        schema:text """Boerderijen. Van de wit geschilderde boerderij Pastoor van der Marckstraat 1 is het rechter deel van het tweebeukige dwarse voorhuis rond 1600 gebouwd met een opkamer boven een kelder met kruisribgewelf. Erachter staat een vierkant torenachtig bouwdeel met een hoog schilddak uit de eerste helft van de 17de eeuw. Het linker deel van het voorhuis stamt uit de tweede helft van die eeuw. Bij een restauratie in 1981 is het muurwerk van het bedrijfsgedeelte vernieuwd. Interessante hallenhuisboerderijen met een dwars voorhuis zijn verder Jonkerstraat 20 (18de eeuw), Kerkstraat 23 (circa 1800) en Klein Lindenhout (Jonkerstraat 30) uit 1838.

Het dijkmagazijn (Dijk 5) is rond 1900 gebouwd. De zijgevels hebben ventilatieopeningen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0223.php> .

