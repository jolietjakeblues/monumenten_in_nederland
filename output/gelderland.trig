        min:gemeenteInBoek "Lichtenvoorde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oost_Gelre> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lichtenvoorde" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lichtenvoorde" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1142 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill270> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0137> ;
        schema:name "Lichtenvoorde"@nl ;
        schema:pageEnd "220" ;
        schema:pageStart "219" ;
        schema:pagination "219-220" ;
        schema:text "De rijzige R.K. St.-Bonifaciuskerk (Rapenburgsestraat 23) is een driebeukige neogotische kruisbasiliek voorzien van een toren met achtkantige lantaarn en naaldspits. De kerk verrees in 1912-'13 naar plannen van W. te Riele ter plaatse van een voorganger uit 1819. De door atelier F.W. Mengelberg vervaardigde neogotische inventaris bleef grotendeels bewaard. De pastorie (Rapenburgsestraat 21) uit 1923 is ontworpen door J.H. Hogenkamp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0137.php> .

