        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "9889",
            "9890" ;
        min:soort "lemma" ;
        min:volgnummer 828 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0084> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Boerderijen. Van 18de-eeuwse oorsprong zijn de hallenhuisboerderijen Hengstegoor (Boerenesweg 1), met dwars voorhuis uit 1777, en Wanninkhof (Geesterse Broekweg 2), met houten voorschot en achtergevel uit 1797. In het dorp zelf staan enkele midden-19de-eeuwse hallenhuisboerderijen zoals: Kerkplein 4, Keistraat 1 en Keistraat 8 (1861, schuur 1877). De in 1866 vernieuwde boerderij Dorpsstraat 4 heeft een houten niendeur met opschrift in gotische letters uit 1598."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00829> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geesteren (gemeente Borculo) – Windmolen"@nl ;
        min:adres "Brinkweg 6a",
            "Molenweg 15" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berkelland" ;
        min:gemeenteInBoek "Borculo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geesteren (gemeente Borculo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Geesteren" ;
        min:lemma "Windmolen" ;
