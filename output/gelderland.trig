            "Schuttersteeg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rumpt (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Rumpt" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/75626> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523738" ;
        min:soort "inleiding" ;
        min:volgnummer 1466 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0182> ;
        schema:name "Rumpt (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "De R.K. kerk O.L. Vrouw Geboorte (Middenstraat 53) is een zaalkerk voorzien van een dakruiter met ingesnoerde spits, gebouwd in 1851-'52 naar ontwerp van W. Vogelpoel met een vroege-neogotische detaillering. De kerk bevat een door M. Maarschalkerweerd gebouwd orgel (1863). Onder één dak met de kerk bevindt zich de pastorie (Schuttersteeg 2)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0182.php> .

