        min:soort "inleiding" ;
        min:volgnummer 1349 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Ooij (gemeente Ubbergen)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een oeverwal. De huidige dorpskern heeft zich begin 20ste eeuw ontwikkeld bij de R.K. kerk en ligt oostelijk van de oude dorpskern aan de Hezelstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01350> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen)"@nl ;
        min:adres "Hezelstraat 9-11-13" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15309>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34705> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35819",
            "35820" ;
        min:soort "inleiding" ;
        min:volgnummer 1350 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Ooij (gemeente Ubbergen)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "De voorm. Herv. kerk (Hezelstraat 9-11-13), gelegen op een pol, is een kleine zaalkerk met een deels gepleisterde toren van drie geledingen met ingesnoerde spits. De toren stamt uit de tweede helft van de 15de eeuw. In 1856-'58 heeft men het 15de-eeuwse schip verbouwd tot een gepleisterde pastorie met kosterswoning en het rond 1500 gebouwde koor vervangen door een kleine zaalkerk. Het complex is na oorlogsschade in 1944 gerestaureerd in 1950 onder leiding van A. van der Kloot. In de pastorie bevinden zich delen van gotische muurschilderingen, voorstellende St. Christoffel en St. Joris met de draak. De kerk bevat een epitaaf voor gravin Albertina Carolina van Bylandt (1781)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01351> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen)"@nl ;
        min:adres "Kerkdijk 24",
            "Kerkdijk 26" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1351 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Ooij (gemeente Ubbergen)"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "De R.K. St.-Hubertuskerk (Kerkdijk 24) is een driebeukige pseudobasiliek met pseudotransepten, dakruiter, driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De neogotische kerk verrees in 1904-'05 naar ontwerp van C. Franssen. De toren werd gebouwd in 1953-'55 naar ontwerp van B. Goddijn. Het interieur wordt gedekt door een houten tongewelf (schip) en stenen kruisribgewelven (zijbeuken en koor). De in neorenaissance-stijl opgetrokken pastorie (Kerkdijk 26) dateert uit 1896-'97 en is in 1944 na oorlogsschade hersteld."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01352> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen) – Kasteel Ooij of Kasteelsche Hof"@nl ;
        min:adres "Hezelstraat 24" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:lemma "Kasteel Ooij of Kasteelsche Hof" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27042> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35823" ;
        min:soort "lemma" ;
        min:volgnummer 1352 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Kasteel Ooij of Kasteelsche Hof"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text "Kasteel Ooij of Kasteelsche Hof (Hezelstraat 24). Van dit in 1798 afgebroken, omvangrijke middeleeuwse kasteel resteert op de omgrachte voorburcht het noordelijke gedeelte van het 16de-eeuwse Knechtenhuis of Gouvernementshuis. Dit deels gepleisterde, onderkelderde gebouw draagt de jaartalankers ‘1514’. Het is in 1978 naar plannen van W.A. Heineman gerestaureerd. Verder bleven een duiventoren en een gedeelte van een stalgebouw bewaard, beide uit de tweede helft van de 17de eeuw. Bij de restauratie van deze gebouwen in 1950, onder leiding van J.A.J. van de Bogaard, is het verdwenen stalgedeelte herbouwd (als woning)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01353> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen) – Boerderijen"@nl ;
        min:adres "Erlecomsedam 4",
            "Hezelstraat 18" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41742> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35821" ;
        min:soort "lemma" ;
        min:volgnummer 1353 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "267" ;
        schema:pageStart "267" ;
        schema:pagination "267" ;
        schema:text """Boerderijen. De kleine gepleisterde dijkboerderij Ooijse Bandijk 88 stamt mogelijk uit de 18de eeuw. Dat geldt ook voor het dwarse voorhuis van de op een pol gelegen, gepleisterde hallenhuisboerderij De Pol (Hezelstraat 18). Rond 1907 is het achterhuis vernieuwd. Op dezelfde pol ligt de gepleisterde hallenhuisboerderij Hezelstraat 20 uit circa 1835.

Het café-logement ‘Oortjeshekken’ (Erlecomsedam 4), gelegen ten noordwesten van het dorp, dateert uit circa 1885. Samen met de hallenhuisboerderij met dwars voorhuis Erlecomsedam 2 (circa 1875) vormt het een fraai ensemble."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01354> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen) – Tiengeboden"@nl ;
        min:adres "Ooijse Bandijk 10-12",
            "Ooijse Bandijk 16" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:lemma "Tiengeboden" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1354 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill332> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Tiengeboden"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "267" ;
        schema:pagination "267-268" ;
        schema:text "Tiengeboden. In dit buurtschap ten westen van Ooij bevinden zich enkele interessante boerderijen. De gepleisterde hallenhuisboerderij ‘De Grote Kat’ (Ooijse Bandijk 10-12) heeft een onderkelderd dwars voorhuis, een dwarsdeel en de jaartalankers ‘1820’. Tot deze boerderij behoorde aanvankelijk ook de deels gepleisterde krukhuisboerderij Ooijse Bandijk 14, met in een sluitsteen het jaartal ‘1799’. Het gehucht ontleent zijn naam aan de tien gepleisterde arbeiderswoningen ‘De Tiengeboden’ (Ooijse Bandijk 16, Hezelstraat 2-8) uit 1878. Deze rug-aan-rug gebouwde woningen zijn nu tot drie woningen samengevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01355> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ooij (gemeente Ubbergen) – Leuth"@nl ;
        min:adres "Kerkplein 2",
            "Plezenburgsestraat 17",
            "Steenheuvelsestraat 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ooij (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ooij" ;
        min:lemma "Leuth" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76639>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76640> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "522004",
            "522005" ;
        min:soort "lemma" ;
        min:volgnummer 1355 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0162> ;
        schema:name "Leuth"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "Leuth. Dit dorp ten zuidoosten van Ooij is ontstaan in de vroege middeleeuwen op een oeverwal. Het dorp bevat enkele interessante boerderijen. De op een hoge pol gelegen hallenhuisboerderij ‘Plezenburg’ (Plezenburgsestraat 17) heeft een fors gepleisterd en onderkelderd dwars voorhuis met de jaartalankers ‘1810’. Het voorhuis is in 1910 met een verdieping verhoogd. De boerderij en de bijschuur zijn verbonden door een varkensstal. Botsestraat 9 is een kop-hals-rompboerderij met aangebouwde dwarsstal en vrijstaande schuur, gebouwd in 1935 naar een ontwerp met expressionistische kenmerken van H.A. Scholtz. Uit 1912 dateert de voorm. Coöperatieve Stoomzuivelfabriek De Duffelt (Steenheuvelsestraat 7) met woning, laadperron en hoge schoorsteen. De fabriek is ontworpen door A. van den Bogaard. De R.K. St.-Remigiuskerk (Kerkplein ong.) is een eenbeukige kruiskerk met recht gesloten koor en een terzijde geplaatste doopkapel en zadeldaktoren. De kerk verrees in 1934-'35 naar ontwerp van H.C. van de Leur, ter vervanging van een in 1869 verbouwde middeleeuwse voorganger. De pastorie (Kerkplein 2) is gelijk met de huidige kerk gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0162.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01356> a min:Passage,
