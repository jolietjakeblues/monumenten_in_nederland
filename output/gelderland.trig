        schema:name "Ravenswaay (gemeente Buren)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een stroomrug van de Lek. Langs de Lekbandijk en de haaks daarop gelegen Donkerstraat en Ravenswaaysesteeg kwam een gestrekt dorp tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01427> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ravenswaay (gemeente Buren)"@nl ;
        min:adres "Lekbandijk 37" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Buren" ;
        min:gemeenteInBoek "Buren" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Buren_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ravenswaay (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ravenswaay" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/42922>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49234> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "28314",
            "28315" ;
        min:soort "inleiding" ;
        min:volgnummer 1427 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0175> ;
        schema:name "Ravenswaay (gemeente Buren)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "De Herv. kerk (Lekbandijk 37), oorspronkelijk gewijd aan St. Nicolaas, is een eenbeukige kerk met driezijdig gesloten koortravee en een toren van drie geledingen met ingesnoerde naaldspits. De kerk is in 1644 in gotische vormen herbouwd - volgens een steen boven de ingang onder leiding van Pauwels Peelen - nadat de voorganger in 1573 door Spaanse troepen was verwoest. In de toren hangt een door F. Simon gegoten klok (1644). De consistorie aan de noordzijde van de toren voegde men kort na 1853 toe. De kerk is in 1973 (vensters) en 1979-'81 gerestaureerd onder leiding van D. Wijma. Inwendig heeft het schip een netgewelf, het koordeel heeft een stergewelf. De gewelfribben rusten op kapitelen versierd met koppen en kwabachtige maniëristische cartouches. Op de gewelven zijn geschilderde bloemmotieven (circa 1644) aangetroffen. Tot de inventaris behoren een 16de-eeuwse grafzerk, een preekstoel (1644) en twee herenbanken (1685 en 1702). Het rond 1723 gebouwde orgel - dat wordt toegeschreven aan Cornelis Hoornbeek of aan Jan Duyschot - is in 1890 overgeplaatst vanuit de Oud Kath. kerk te Den Helder en is in 1982 gerestaureerd. De kerk en het ommuurde kerkhof liggen onder aan de Lekdijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01428> a min:Passage,
