        min:kern "Zaltbommel" ;
        min:lemma "Pompen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1824 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0230> ;
        schema:name "Pompen"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Pompen. In de stad staan drie hardstenen pompen met siervazen in Lodewijk XVI-stijl als bekroning. De pomp bij Gamerschestraat 67 is gedateerd 1781. De pomp aan de Tolstraat stamt, met uitzondering van de vaas, uit de 19de eeuw. Beide pompen hebben bronzen uitlaten en zwengels. De laat-18de-eeuwse pomp op de Vismarkt heeft geen uitlaat en zwengel meer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0230.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01825> a min:Passage,
