        schema:pageEnd "77" ;
        schema:pageStart "77" ;
        schema:pagination "77" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een oeverwal van de Maas en voor het eerst vermeld in 1139. De bebouwing concentreerde zich tot 1940 voornamelijk langs de Kerkstraat, de Maasdijk en de Walstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0019.php> .

