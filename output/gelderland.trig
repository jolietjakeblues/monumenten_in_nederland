        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0032> ;
        schema:name "Beneden-Leeuwen (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Het voorm. raadhuis van de gemeente Wamel (Zandstraat 51) is een blokvormig pand met souterrain, bordes en een klokkentorentje, gebouwd in 1899 in neorenaissance-stijl naar ontwerp van D. Semmelink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00429> a min:Passage,
            schema:CreativeWork ;
