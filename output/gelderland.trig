        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Warnsveld" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1722 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill412> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0219> ;
        schema:name "Warnsveld"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een dekzandrug in het stroomgebied van de Berkel. In 1121 wordt Warnsveld voor het eerst als parochie vermeld. Nadat de weg van Zutphen naar Lochem in 1841 was verhard, ontstond langs deze weg een aantal nieuwe buitenplaatsen. Warnsveld werd een vestigingsplaats voor gegoede Zutphenaren. Na de Tweede Wereldoorlog zijn aan de oostzijde zijde in een halve cirkel nieuwe woonwijken tot stand gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0219.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01723> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Warnsveld"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
