        schema:pageEnd "68" ;
        schema:pageStart "68" ;
        schema:pagination "68" ;
        schema:text "Boerderijen. Nabij Bingerden staan buitendijks aan de IJssel de laat-18de-eeuwse dwarshuisboerderij Kroonestein (Bingerdenseweg 10) en de uit 1884 daterende dwarshuisboerderij Groot Bingerden (Bingerdenseweg 17)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0017.php> .

