        schema:name "Didam"@nl ;
        schema:pageEnd "136" ;
        schema:pageStart "136" ;
        schema:pagination "136" ;
        schema:text "De Herv./Geref. kerk (Torenstraat 10) is een zaalkerk in traditionalistische vormen uit 1953-'54. Het torenfront heeft forse pilonen, waartussen de twee klokken zijn opgehangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0052.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00587> a min:Passage,
