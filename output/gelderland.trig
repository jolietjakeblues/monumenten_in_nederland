        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35010>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62451> ;
        min:provincie "Gelderland" ;
