        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/59970> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "25925" ;
        min:soort "lemma" ;
        min:volgnummer 1170 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill276> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0140> ;
        schema:name "Sociëteiten"@nl ;
        schema:pageEnd "224" ;
        schema:pageStart "224" ;
        schema:pagination "224" ;
        schema:text "Sociëteiten. De in 1829 gestichte voorm. sociëteit De Eendracht (Oosterwal 22) kreeg in 1840 een eerste gebouw. Bij een uitbreiding in 1869, vermoedelijk naar plannen van J. Bosch, ontstond de huidige neoclassicistischevoorgevel met dorische pilasterstelling en fronton. De voorm. sociëteit De Harmonie (Tramstraat 4) is een langgerekt eenlaags neoclassicistisch pand uit 1879, naar ontwerp van J. Bosch."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01171> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lochem – Verdedigingswerken"@nl ;
        min:adres "Julianaweg 3",
            "Paasberg 6",
            "Stationsplein 1",
            "Westerbleek 5" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Lochem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
