        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17842>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48160> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "20256",
            "523680" ;
