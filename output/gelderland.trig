        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0035> ;
        schema:name "Bergharen (gemeente Wijchen)"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "Het voorm. raadhuis (Dorpssstraat 73-75) is een L-vormig pand in neorenaissance-vormen, gebouwd in 1911-'13 naar plannen van J.H.H. Groenendaal. Boven de ingang bevindt zich een tegeltableau met het gemeentewapen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00450> a min:Passage,
