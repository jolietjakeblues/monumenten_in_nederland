        schema:pageEnd "127" ;
        schema:pageStart "127" ;
        schema:pagination "127" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug en later uitgegroeid tot een rond kern-esdorp. Na de Tweede Wereldoorlog is het dorp aan de zuidwestzijde uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0048.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00544> a min:Passage,
