        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Renkum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Renkum" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Renkum" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54209> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "32428" ;
        min:soort "lemma" ;
        min:volgnummer 1440 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0177> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "280" ;
        schema:pagination "280-281" ;
        schema:text """Boerderijen. Uit 1805 stamt de hallenhuisboerderij Everwijnsgoed (Bennekomseweg 160) en uit circa 1820 de hallenhuisboerderij Nieuwe Keyenbergseweg 172-174 met dwars voorhuis. De Mariahoeve (Telefoonweg 16) is een ontginningsboerderij uit circa 1880.

Het gedenkteken bij Utrechtseweg 123 is in 1925 opgericht voor J. Beuker, directeur van de Verenigde Koninklijke Van Gelder Papierfabrieken.

De Alg. begraafplaats (Onder de Bomen ong.), aangelegd rond 1840, bevat enkele interessante graftekens, waaronder die voor Crommelin (†1842) en H.A. van Ingen (†1920), en de afgebroken obelisk op postament voor H.L. Ploem (†1882)."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0177.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01441> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rheden"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Rheden" ;
        min:gemeenteInBoek "Rheden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rheden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rheden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Rheden" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1441 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0178> ;
        schema:name "Rheden"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op de zuidoostflank van de Veluwestuwwal bij de overgang naar het rivierdal van de IJssel. Rheden kwam tot ontwikkeling aan de weg van Arnhem naar Zutphen en dankt zijn naam aan de bezittingen van Frederik van Rheede in deze omgeving rond 1300. In 1919 werd aan de oostzijde van het dorp een machinefabriek gevestigd. Na de Tweede Wereldoorlog is het gebied tussen de weg en de IJssel geheel bebouwd geraakt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01442> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rheden"@nl ;
        min:adres "Dorpsstraat 51" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Rheden" ;
        min:gemeenteInBoek "Rheden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rheden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rheden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Rheden" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/15291> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "42087" ;
        min:soort "inleiding" ;
        min:volgnummer 1442 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill351> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0178> ;
        schema:name "Rheden"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "De Herv. kerk (Dorpsstraat 51) is een forse driebeukige pseudobasiliek met driezijdig gesloten koor en een toren van vier geledingen met puntdak. De romaanse tufstenen toren verrees in de eerste helft van de 12de eeuw. In de toren hangen een klok van François en Pieter Hemony (1647) en een klok van Rutger Peckel (1671). Het huidige gotische koor kwam in de 15de eeuw tot stand ter vervanging van een bestaand koor. De onderbouw heeft een tufsteenbekleding. De sacristie (nu consistorie) is uit dezelfde tijd. In 1505 was de vernieuwing van het schip gereed; dit bouwdeel is eveneens bekleed met tufsteen. De kerk is in 1901-'04 gerestaureerd, naar plannen van J.Th.J. Cuypers, de toren in 1930."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01443> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rheden"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Rheden" ;
        min:gemeenteInBoek "Rheden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rheden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rheden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Rheden" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1443 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0178> ;
        schema:name "Rheden"@nl ;
        schema:pageEnd "281" ;
        schema:pageStart "281" ;
        schema:pagination "281" ;
        schema:text "Het interieur wordt gedekt door kruisribgewelven (koor) en netgewelven (schip). De kerk bevat drie platen van kalksinter waarvan één met een afbeelding van Maria en de aartsengel Gabriël (begin 13de eeuw); de twee andere zijn in 1620 en 1774 hergebruikt als zerken voor graven van kosters. Tot de inventaris behoren verder een preekstoel (17de eeuw), een koorhek (17de eeuw) - nu geplaatst tussen de zuilen van de orgelgalerij -, een herenbank (derde kwart 18de eeuw) met de wapens van de geslachten Van Renesse van den Brink en Van Spaen van Ringenberg en een door A. Meere gebouwd orgel (1816), uitgebreid door E. Leichel (1878). De gebrandschilderde koorvensters stammen uit circa 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0178.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01444> a min:Passage,
