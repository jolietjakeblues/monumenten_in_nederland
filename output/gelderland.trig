        schema:name "Sluizen"@nl ;
        schema:pageEnd "291" ;
        schema:pageStart "291" ;
        schema:pagination "291" ;
        schema:text "Sluizen. De dubbele duikersluis Zuiderlingedijk 233 dateert uit de tweede helft van de 19de eeuw en ligt bij het uit 1913 daterende voorm. stoomgemaal. De uitwaterings- en inwateringssluis heeft een gietijzeren hijsmechanisme voor de schuiven. Een soortgelijke, maar enkele duikersluis ligt bij Nieuwe Zuiderlingedijk 2a."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0189.php> .

