        schema:pageEnd "197" ;
        schema:pageStart "197" ;
        schema:pagination "197" ;
        schema:text "Het voorm. postkantoor (Raadhuisstraat 23-25) is een pand uit 1911-'13 met gepleisterde daklijst en een geveltop met chalet-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0104.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00974> a min:Passage,
