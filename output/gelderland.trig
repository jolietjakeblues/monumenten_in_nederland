        min:kern "Zetten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10470>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10887> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "36761",
            "36762" ;
        min:soort "inleiding" ;
        min:volgnummer 1840 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0233> ;
        schema:name "Zetten (gemeente Valburg)"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "348" ;
        schema:pagination "348" ;
        schema:text "De Herv. kerk (Kerkstraat 11) is een zaalkerk voorzien van een zijbeuk met haakse kap, een driezijdig gesloten koor en een ongelede toren met ingesnoerde spits. De toren dateert uit de 14de eeuw. In 1912 heeft men het 14de-eeuwse schip vervangen door het huidige en het 15de-eeuwse koor beklampt. Het interieur van het koor wordt gedekt door een kruisribgewelf."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0233.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01841> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zetten (gemeente Valburg)"@nl ;
        min:adres "K.O. Finkensieperlaan 8",
            "Stationsstraat 27" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Overbetuwe" ;
        min:gemeenteInBoek "Valburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Overbetuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zetten (gemeente Valburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zetten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1841 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0233> ;
        schema:name "Zetten (gemeente Valburg)"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "348" ;
        schema:pagination "348" ;
        schema:text "De (Herv.) Vluchtheuvelkerk (K.O. Finkensieperlaan 8) is een gepleisterde zaalkerk in neoclassicistische stijl, gebouwd in 1870 op een vluchtheuvel naar ontwerp van J.A. Smits. De kerk is later uitgebreid met een transept. Het kerkhof bevat enkele 19de-eeuwse grafzerken, waaronder die van Otto Gerard Heldring (†1876), stichter van de kerk. Het voorm. internaat ‘Het Witte Huis’ van het Tweede Chr. Gymnasium en de Hogere Burger School (Stationsstraat 27) is in 1916 gebouwd naar ontwerp van G. Pothoven. Het deels gepleisterde, U-vormige gebouw heeft een rondbooggalerij en chaletstijl-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0233.php> .

