        schema:name "Lobith (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Het voorm. raadhuis (Komstraat 5) is een neoclassicistisch gebouw met bordes, fronton en klokkentorentje, gebouwd in 1884 naar ontwerp van G.H. Publiekhuijsen. Als raadhuis heeft het dienst gedaan tot 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01160> a min:Passage,
