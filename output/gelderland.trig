        schema:pageEnd "328" ;
        schema:pageStart "328" ;
        schema:pagination "328" ;
        schema:text "Hotel-restaurant ‘Het Jachthuis’ (Vordenseweg 20) is een fors gepleisterd T-vormig pand uit circa 1840, dat rond 1890 een veranda kreeg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0219.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01730> a min:Passage,
