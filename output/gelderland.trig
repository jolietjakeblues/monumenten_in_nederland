        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12372>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21812>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21865>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/28558>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35281>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43801>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56667> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "40189",
            "40229",
            "40230",
