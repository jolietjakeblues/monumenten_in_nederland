        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0188> ;
        schema:name "Spankeren (gemeente Rheden)"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op de overgang van de Veluwestuwwal naar het rivierdal van de IJssel, waar in de 12de eeuw een kerk werd gesticht. Bij het in 1866-'68 ten zuidwesten van het dorp gegraven Apeldoorns Kanaal werd in 1916 de Emailleerfabriek De IJssel (EDY) gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0188.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01502> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Spankeren (gemeente Rheden)"@nl ;
        min:adres "Kerkweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Rheden" ;
        min:gemeenteInBoek "Rheden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Rheden_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Spankeren (gemeente Rheden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Spankeren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33203> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "42134" ;
        min:soort "inleiding" ;
        min:volgnummer 1502 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0188> ;
        schema:name "Spankeren (gemeente Rheden)"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "De Herv. kerk (Kerkweg 2), oorspronkelijk gewijd aan St. Petrus, is een zaalkerk met een toren van drie geledingen met ingesnoerde naaldspits. De onderste twee geledingen van de toren stammen uit de 12de eeuw. Vermoedelijk kreeg de toren de derde geleding met onregelmatige tufsteenbeklamping bij een herstel van de kerk rond 1550. Toen de middeleeuwse kerk in 1803 werd vervangen door de huidige zaalkerk, heeft men de toren in baksteen verhoogd en voorzien van de huidige spits. Tot de inventaris behoren een preekstoel uit 1886 en een orgel uit 1916. Op het kerkhof bevindt zich het graf van de kunstschilder H.A.C. Dekker (†1905), bestaande uit een gebroken zuil met pallet op postament. Nabij de kerk staat een muziektent (Kerkplantsoen ong.) uit 1950, geschonken door de Emailleerfabriek De IJssel (E.D.Y.)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0188.php> .

