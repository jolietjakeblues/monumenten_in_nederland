        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "De Geref. kerk (Oranjestraat 33) is een zaalkerk met terzijde staande toren, gebouwd in 1958 in traditionalistische vormen naar plannen van J. van der Top."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0143.php> .

