        schema:name "Afferden (gemeente Druten)"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "64" ;
        schema:pagination "64" ;
        schema:text "Dorp, ontstaan in de middeleeuwen rond de op een donk bij de Maas gelegen kerk. Op de aangrenzende oeverwal ontwikkelde zich een lintbebouwing langs de Koningstraat."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0011.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00241> a min:Passage,
