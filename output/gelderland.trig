        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/27833>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36621>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38775>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61375> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "39071",
            "408867",
            "451646",
            "526018" ;
        min:soort "lemma" ;
        min:volgnummer 1798 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0228> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "337" ;
        schema:pageStart "337" ;
        schema:pagination "337" ;
        schema:text "Windmolens. De voorm. beltkorenmolen Bataaf (Bataafseweg 18-20) heeft een achtkantige houten romp op stenen onderbouw. Hij werd in 1800-'01 gebouwd ten behoeve van het predikantenfonds van de hervormde gemeente. De tussen graansilo's ingebouwd geraakte molen verloor in 1964 zijn wiekenkruis. De Meenkmolen (Meenkmolenweg 5, Miste) is een beltkorenmolen met achtkantige houten romp op een met hout beklede onderbouw. De molen werd in 1851 gebouwd voor H.J. Tenkinkbewoner van de scholteboerderij Huize Meenk - en is in 1961-'62 gerestaureerd. De uit 1869 daterende ronde voorm. beltmolen De Zorg of Sevink Molen (Meddoseweg 38) verloor in 1927 door een storm zijn wiekenkruis. De Venemansmolen of Oude Molen (Venemansweg 7) is een achtkantige stellingkorenmolen met een houten romp op stenen voet, gebouwd in 1898 ter plaatse van een oudere voorganger. Bij de bouw gebruikte men onderdelen van de dat jaar gesloopte 17de-eeuwse houtzaagmolen ‘De Goede Hoop’ uit Zaandam. De molen is in 1997-'99 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0228.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01799> a min:Passage,
