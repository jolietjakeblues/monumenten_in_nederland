        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1455 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0180> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Woonhuizen. De onderkelderde dijkwoningen Maasdijk 54 en Waaldijk 3 dateren uit de tweede helft van de 19de eeuw. Waaldijk 3 is gepleisterd en heeft een mezzanino en een serre; Maasdijk 54 is gecementeerd en heeft een lage verdieping en aan de achterzijde een vijfzijdige uitbouw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0180.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01456> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rossum (gemeente Maasdriel) – Boerderijen"@nl ;
        min:adres "Burchtstraat 2",
            "Kerkstraat 27" ;
