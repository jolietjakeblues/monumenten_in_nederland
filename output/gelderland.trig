        schema:pagination "222" ;
        schema:text "Het schuttersgebouw ‘Eendracht maakt macht’ (Dorpsdijk 16) is in 1923 in sober expressionistische vormen gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01161> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lobith (gemeente Rijnwaarden) – Woonhuizen"@nl ;
        min:adres "Boterdijk 14",
            "Dorpsdijk 36" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Rijnwaarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lobith (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lobith" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43900> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "21964" ;
        min:soort "lemma" ;
        min:volgnummer 1161 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0139> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text """Woonhuizen. Van het huis Dorpsdijk 36 gaat de kern mogelijk terug tot de 17de eeuw en van Dorpsdijk 33 mogelijk tot de 18de eeuw. Dorpsdijk 17 werd in 1862 gebouwd als dokterswoning. Uit ongeveer dezelfde tijd stamt het neoclassicistische herenhuis Transeedijk 24-48, dat van 1925 tot 1981 dienst deed als raadhuis. Eclectisch van vorm is het uit circa 1890 stammende herenhuis Transeedijk 62. Het woonhuis Dorpsdijk 22 uit circa 1915 vertoont sobere jugendstil-elementen.

De schipperspoort (bij Dorpsdijk 36) is een eenvoudige gemetselde poortboog die toegang gaf tot de vroegere Rijnkade. De oorsprong van de poort ligt in de 16de eeuw.

De windmolen ‘Tolhuys Coornmolen’ (Boterdijk 14) is een ronde beltmolen voorzien van een met riet gedekte houten kap. De korenmolen werd in 1888 gebouwd, brandde in 1930 af en is in 1995-'96 herbouwd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01162> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lobith (gemeente Rijnwaarden) – Spijk"@nl ;
        min:adres "Kerkstraat 30",
            "Kerkstraat 32",
            "Spijksedijk 27",
            "Spijksedijk 31" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Rijnwaarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lobith (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lobith" ;
        min:lemma "Spijk" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1162 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0139> ;
        schema:name "Spijk"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Spijk. Dit dorp ten zuidoosten van Lobith kwam pas na 1900 tot ontwikkeling. De R.K. St.-Gerardus Majellakerk (Kerkstraat 32) is een neoromaanse kruisbasiliek met twee terzijde staande torens, gebouwd in 1913-'14 naar plannen van H. Kroes. De pastorie (Kerkstraat 30) stamt uit dezelfde tijd. De steenfabriek (Spijksedijk 27), gesticht in 1862 en sinds 1888 in bezit van de familie Terwindt, heeft een uit 1935 stammende vlamoven. De kern daarvan wordt gevormd door een ringoven uit 1921-'22. De hijskraan (bij Spijksedijk 31) met vaste arm en rijdend op een kraanbaan werd rond 1930 gebouwd en werd gebruikt voor het lossen van kolen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01163> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lochem"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Lochem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lochem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lochem" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1163 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0140> ;
        schema:name "Lochem"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Kleine stad, ontstaan op een stuwwalflank langs de Berkel, op het kruispunt van wegen naar Zutphen, Deventer en Hengelo (Ov.). In 1233 kreeg Lochem stadsrechten. Reinald II liet de eivormige stad rond 1330 ommuren en voorzien van drie stadspoorten. De Blauwe Toren aan de zuidoostzijde en de dubbele omgrachting vormden een extra versterking. In 1543 en in 1615 werd een groot deel van de stad door brand verwoest. In de Tachtigjarige Oorlog wisselde Lochem enkele keren van bezetting. De vestingwerken werden daarbij niet gemoderniseerd; Lochem was strategisch gezien van weinig belang. In 1666 en 1672 viel Lochem in Münsterse handen en in 1693 was er opnieuw een stadsbrand. In 1750 slechtte men de muren, in 1881 de poorten en de Blauwe Toren. Met de komst van de spoorlijn Zutphen-Hengelo (Ov.) in 1865 brak een periode van voorspoed aan en verrezen onder meer de leerlooierijen van Reerink en de Gebr. Naeff (gesloopt 1975). De aanleg van het Twentekanaal in 1936 leidde aan de noordzijde tot een langgerekte industriële zone. Met het villapark Berkeloord (1910) aan de oostzijde als uitgangspunt, ontstond vooral na de Tweede Wereldoorlog aan de zuidrand van Lochem een half-cirkelvormige gordel van nieuwbouwwijken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01164> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lochem"@nl ;
        min:adres "Markt 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Lochem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lochem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lochem" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1164 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0140> ;
        schema:name "Lochem"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "De Herv. kerk (Markt 4), oorspronkelijk gewijd aan St. Gudula, is een driebeukige laat-gotische hallenkerk met driezijdig gesloten koor, nevenkoor en een half ingebouwde toren van vijf geledingen met balustrade en ingesnoerde spits. Van de oudste kerk resteren de twee meest westelijke schippijlers (mogelijk eind 12de eeuw). Het dwarsschip en het huidige koor zijn rond 1400 gebouwd; de zijkapel aan de zuidzijde is in de 17de eeuw tot consistorie verbouwd. Met de bouw van de onderste drie geledingen van de toren begon men in 1478. Na een brand in 1543 volgden de ombouw tot hallenkerk, de bouw van het nevenkoor en de verhoging van de toren. De twee oudste klokken in de toren zijn gegoten door Henrick Wegewaert (1622) en Gerhart Schimmel (1687). Ten behoeve van een door G. Naeff geschonken carillon werd de toren in 1903 gerestaureerd en kreeg deze een nieuwe spits naar plannen van N. Molenaar. Een algehele kerkrestauratie volgde in 1973-'76."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01165> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lochem"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Lochem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lochem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lochem" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1165 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0140> ;
        schema:name "Lochem"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "Het interieur wordt gedekt door kruisribgewelven en netgewelven (nevenkoor). De kerk bevat 15de- en 16de-eeuwse muurschilderingen, waaronder een Boom van Jesse, een St. Christoffel en andere heiligen. Tot de inventaris behoren diverse oude grafzerken, waaronder die van Kunnegonde van Haeften van Verwolde (†1592), een preekstoel (1688) en een doopvont (18de eeuw). Het orgel werd in 1758 door J.T. Gilman gebouwd voor de R.K. Dominikanerkerk te Alkmaar en is in 1976 hier geplaatst. In 1981 plaatste men het koororgel, dat in 1807 door G.H. Quellhorst werd gebouwd voor de Herv. kerk te Heemse (Ov.)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0140.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01166> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lochem"@nl ;
        min:adres "Westerwal 6" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Lochem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lochem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lochem" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56327> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "341522" ;
        min:soort "inleiding" ;
        min:volgnummer 1166 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0140> ;
        schema:name "Lochem"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "222" ;
        schema:pagination "222" ;
        schema:text "De synagoge (Westerwal 6) is een zaalgebouw uit 1865 met neogotische details en een ingangomlijsting met accoladeboog. De sjoel werd in 1909 aan de rechterzijde vergroot met een travee. Het interieur bevat een plaatijzeren plafond (1909) en een vrouwengalerij met bewerkte balustrade."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0140.php> .

