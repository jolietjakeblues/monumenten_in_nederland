        min:hoofdstuk "Steden, dorpen, monumenten › Zetten (gemeente Valburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zetten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1839 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0233> ;
        schema:name "Zetten (gemeente Valburg)"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "348" ;
        schema:pagination "348" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Langs de tegenwoordige Bakkerstraat en de Hoofdstraat kwam de oudste bebouwing tot stand. In 1882 werd ten zuiden van Zetten de spoorlijn Tiel-Elst aangelegd. Vanaf 1900 werden de Veldstraat, de Stationsstraat en de Wageningsestraat bebouwd. Na de Tweede Wereldoorlog is het dorp in westelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0233.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01840> a min:Passage,
            schema:CreativeWork ;
