        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "Windmolen ‘De Fortuin’ (Molenbelt 5) is een achtkantige bovenkruier met stelling, gelegen op de noordelijke hoek van de stadsomwalling. De korenmolen is in 1852 gebouwd voor K. Blom en in 1971 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0097.php> .

