        schema:name "Beek (gemeente Bergh)"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "Het gildehuis St. Jan (St.-Jansgildestraat 31), een driebeukig pand met verhoogd middendeel, dateert uit 1897. Vlakbij staat een ijzeren hagelkruis op houten staak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00393> a min:Passage,
