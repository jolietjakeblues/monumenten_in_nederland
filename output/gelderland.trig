        min:hoofdstuk "Steden, dorpen, monumenten › Voorthuizen (gemeente Barneveld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Voorthuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19280> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "8628" ;
        min:soort "inleiding" ;
        min:volgnummer 1665 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0210> ;
        schema:name "Voorthuizen (gemeente Barneveld)"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "315" ;
        schema:pagination "315" ;
        schema:text "De voorm. pastorie (Kerkstraat 29) is een statig blokvormig herenhuis, waarvan de ingang is voorzien van een houten pilasteromlijsting. Boven de ingang bevinden zich twee gesneden wapens en het jaartal 1785."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0210.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01666> a min:Passage,
