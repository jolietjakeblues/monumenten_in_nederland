        min:soort "inleiding" ;
        min:volgnummer 937 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0099> ;
        schema:name "Heelsum (gemeente Renkum)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Flankesdorp, ontstaan in de middeleeuwen op de zuidflank van de Veluwestuwwal nabij de Heelsumse beek. In 1517 werd Heelsum een zelfstandige parochie. Het vroeger tot de heerlijkheid Doorwerth behorende dorp werd in 1923 aan de gemeente Renkum toegevoegd, waaraan het na de Tweede Wereldoorlog vastgroeide."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00938> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heelsum (gemeente Renkum)"@nl ;
        min:adres "Koninginnelaan 24" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Renkum" ;
        min:gemeenteInBoek "Renkum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Renkum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heelsum (gemeente Renkum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Heelsum" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/19148> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "32430" ;
        min:soort "inleiding" ;
        min:volgnummer 938 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill230> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0099> ;
        schema:name "Heelsum (gemeente Renkum)"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "De Herv. kerk (Koninginnelaan 24) is een fraai gelegen tweebeukige kerk met driezijdig gesloten koor en een slanke toren van drie geledingen met ingesnoerde spits. De kerk werd in 1517 gesticht door Margaretha van Homoet, kasteelvrouwe van Doorwerth. Kort na de bouw van het koor in 1517-'19 volgde de bouw van het middenschip en de toren. De zuidbeuk werd in 1859 toegevoegd in opdracht van J.H.G. baronesse van Schuylenburgh, douairière van Brakell. Buiten tegen het koor staat de grafsteen voor haar (†1878) en voor J.A.P. baron van Brakell (†1853). De kerk is in 1950-'51 gerestaureerd. Tot de inventaris behoort een orgel uit 1861."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0099.php> .

