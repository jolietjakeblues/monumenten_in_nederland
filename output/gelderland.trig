        schema:name "Zutphen"@nl ;
        schema:pageEnd "360" ;
        schema:pageStart "360" ;
        schema:pagination "360" ;
        schema:text "De synagoge (Dieserstraat 11) [5] is een zaalgebouw met zijbeuken, opgetrokken in 1879 (5638) naar ontwerp van D. Lijsen met neogotische elementen. De voorgevel toont de Tiengeboden-Tafelen. Inwendig is later ter hoogte van de galerijen van de zijbeuken een verdieping aangebracht. De synagoge is in 1985 opnieuw ingewijd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0239.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01900> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zutphen – Geref. kerken"@nl ;
