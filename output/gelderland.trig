        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Woonhuizen. De Villa Elisabeth (Rijksstraatweg 49) uit circa 1895 vertoont neorenaissance-vormen. Bij de villa staat een voorm. graanmalerij met opslag. Het rond 1905 gebouwde huis Dorpsstraat 8 heeft een aan de chaletstijl ontleende detaillering."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0148.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01225> a min:Passage,
