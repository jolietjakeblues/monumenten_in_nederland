        min:soort "lemma" ;
        min:volgnummer 458 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0036> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Boerderijen. Hallenhuisboerderijen met dwars voorhuis zijn onder meer Dorpssingel 5 (circa 1850) en Van Heemstraweg 55 (derde kwart 19de eeuw). De laatste heeft een gepleisterd eclectisch voorhuis met middenrisaliet voorzien van een topgeveltje."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0036.php> .

