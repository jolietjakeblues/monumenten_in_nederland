        min:volgnummer 1056 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0121> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Woonhuizen. De voorm. Herv. pastorie, Domineespaadje 1, is een statig vroeg-19de-eeuws huis. Karakteristieke dwarse eenlaagspanden uit het midden van die eeuw zijn Dorpsstraat 3, 14 en 16-18. Uit dezelfde tijd dateren de huizen Dorpsstraat 10 en 12, die een agrarisch karakter hebben. De grote villa Johanna (Sliekstraat 1) verrees in 1903 in neorenaissance-stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0121.php> .

