        min:volgnummer 1659 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill397> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0209> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "315" ;
        schema:pageStart "314" ;
        schema:pagination "314-315" ;
        schema:text "Woonhuizen. Vroeg-19de-eeuws is het eenlaagspand Rijksstraatweg 34, dat heeft gediend als tolhuis. Voorbeelden van eenlaagse dorpshuizen zijn verder 't Keizershof (Binnenweg 1; circa 1860) en Rijksstraatweg 100 (circa 1870) met wenkbrauwen. Rijker is het uit circa 1880 daterende, tweelaagse gepleisterde neoclassicistische herenhuis Enkstein (Rijksstraatweg 102), met portiek op dorische zuilen. Jugendstildetails en chaletstijl-elementen vertonen Rijksstraatweg 20 (circa 1910), Klein Wiardastate (Rijksstraatweg 72; 1910) en De Goede Rede (Schoolstraat 25; 1912); de laatste naar ontwerp van J.A. Heuvelink. Van zijn hand zijn ook de in ‘Um 1800’-stijl uitgevoerde villa Ruimzicht (Rijksstraatweg 69; 1917) en de villa Hoekskamp (Rijksstraatweg 106; 1926) met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0209.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01660> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Voorst – Boerderijen"@nl ;
        min:adres "Hoenweg 9",
            "Kerkstraat 29",
            "Rijksstraatweg 49" ;
