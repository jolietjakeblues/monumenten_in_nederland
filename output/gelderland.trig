        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Neerijnen (gemeente Neerijnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Neerijnen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1258 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0154> ;
        schema:name "Neerijnen (gemeente Neerijnen)"@nl ;
        schema:pageEnd "234" ;
        schema:pageStart "234" ;
        schema:pagination "234" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Aan de noordzijde werd in de 14de eeuw het kasteel Neerijnen gesticht. In de loop van de tijd kwam haaks op de Waaldijk een gestrekt esdorp tot ontwikkeling, waarvan de structuur aan de dijkzijde niet meer compleet is."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01259> a min:Passage,
            schema:CreativeWork ;
