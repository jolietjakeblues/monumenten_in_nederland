            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49180> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "8194",
            "8195" ;
        min:soort "inleiding" ;
        min:volgnummer 305 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill83> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0019> ;
        schema:name "Appeltern (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "78" ;
        schema:pageStart "77" ;
        schema:pagination "77-78" ;
        schema:text "De Herv. kerk (Maasdijk 16), oorspronkelijk gewijd aan St. Servatius, is een zaalkerk met driezijdig gesloten koor en een ongelede toren met tentdak. De romaanse, tufstenen toren is vroeg-12de-eeuws. In de toren hangt een door J.P. en H. van Trier gegoten klok (1685). Het koor dateert uit circa 1400 en is gepleisterd toen in 1859 ter plaatse van de oude kerk het huidige schip verrees, waarmee het onder één dak is gebracht. De kerk bevat een preekstoel uit 1664 met een trap uit 1842."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0019.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00306> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Appeltern (gemeente West Maas & Waal)"@nl ;
