        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0018> ;
        schema:name "Apeldoorn"@nl ;
        schema:pageEnd "70" ;
        schema:pageStart "70" ;
        schema:pagination "70" ;
        schema:text "De (Geref.) Noorderkerk (P. Joubertstraat 4) [3] is een forse kruiskerk met terzijde staande toren van vier geledingen met frontalen en een achtkantige spits. De kerk verrees in 1898 in neogotische stijl - uitzonderlijk voor een Gereformeerde kerk - naar ontwerp van J.A. Wijn en P. Oldenhof. De kerk bevat een door G. van Leeuwen gebouwd orgel (1908)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0018.php> .

