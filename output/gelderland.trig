        schema:pageEnd "160" ;
        schema:pageStart "160" ;
        schema:pagination "160" ;
        schema:text "Hotel-restaurant ‘Het Wapen van Eibergen’ (Grotestraat 1) is in 1914 gebouwd voor J. Wormmeester en vertoont rationalistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0071.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00731> a min:Passage,
