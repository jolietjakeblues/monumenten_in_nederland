        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Woonhuizen. De blokvormige villa Rooysestraat 44 is rond 1870 gebouwd in eclectische vormen. De kleine T-vormige dijkwoningen Waaldijk 5 en Waaldijk 8 dateren uit circa 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0062.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00674> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dreumel (gemeente West Maas & Waal) – Boerderijen"@nl ;
        min:adres "Rooysestraat 41",
            "Vluchtheuvelstraat 2",
            "Vluchtheuvelstraat 8",
            "Waaldijk 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Dreumel (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Dreumel" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/43836> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "14072" ;
        min:soort "lemma" ;
        min:volgnummer 674 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0062> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text """Boerderijen. De grote hallenhuisboerderij De Kroondert (Vluchtheuvelstraat 2) uit het tweede kwart van de 19de eeuw heeft een deels onderkelderd dwars voorhuis met rieten schilddak. Het bedrijfsgedeelte bezit aan de achterzijde een grote overstekende kap. De boerderij Rooysestraat 36 is een gewijzigd bijgebouw van het verdwenen Huis te Dreumel. Het pand met mezzanino heeft in de huidige vorm een midden-19de-eeuws karakter, maar de kern is ouder. De hallenhuisboerderij met dwarsgeplaatst voorhuis Huize De Laak (Rooysestraat 41), gebouwd rond 1870, heeft een voorhuis met souterrain en mezzanino. De gietijzeren palen van het toegangshek vermelden de huisnaam. De vroeg-20ste-eeuwse hallenhuisboerderij Rooysestraat 26 heeft een villa-achtig voorhuis.

Het watersnoodmonument (bij Waaldijk 8) is opgericht in 1864 bij het 15-jarig regeringsjubileum van Koning Willem III. Een hardstenen plaat op de sokkel herinnert aan de watersnoodramp van 1855. Op de sokkel staat een gedrongen obelisk met een metalen kroon.

Het voorm. dijkmagazijn (tegenover Vluchtheuvelstraat 8) dateert uit circa 1870. De kopgevels van het tweelaags gebouw hebben dubbele laaddeuren. De zijgevels zijn voorzien van verdiepte velden met ventilatiespleten."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0062.php> .

