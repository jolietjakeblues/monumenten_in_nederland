        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill273> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0139> ;
        schema:name "Lobith (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "222" ;
        schema:pageStart "221" ;
        schema:pagination "221-222" ;
        schema:text "Het voorm. klooster en R.K. meisjesschool (Dorpsdijk 33-35) is opgericht ter plaatse van de eerste katholieke pastorie uit 1795 en uitgebreid in 1865. Het kloostergedeelte is in 1913 verbouwd. De huidige school dateert uit 1891 - toen het klooster was overgegaan naar de Congregatie van de O.L. Vrouwe te Amersfoort - en is in 1921 uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0139.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01159> a min:Passage,
