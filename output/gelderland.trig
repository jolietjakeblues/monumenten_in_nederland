    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01592> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Uddel (gemeente Apeldoorn) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Apeldoorn" ;
        min:gemeenteInBoek "Apeldoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Uddel (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Uddel" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1592 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0200> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text """Boerderijen. De hallenhuisboerderij Garderenseweg 65 is volgens de jaartalankers in 1725 gebouwd. Uit het eind van de 18de eeuw stammen de kleine Veluwse hallenhuisboerderij Aardhuisweg 15 en de van een fors dwars woonhuis voorziene hallenhuisboerderij Jachthuisweg 1.

De Hunneschans ('t Hof ong.), gelegen ten zuidwesten van Uddel aan het Uddelermeer, is het restant van een walburcht uit de 8ste eeuw. Het hoefijzervormige verdedigingswerk was tot de 13de eeuw in gebruik. Na een opgraving in 1908 is het gereconstrueerd."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0200.php> .

