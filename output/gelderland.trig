        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0201> ;
        schema:name "Ulft (gemeente Gendringen)"@nl ;
        schema:pageEnd "305" ;
        schema:pageStart "305" ;
        schema:pagination "305" ;
        schema:text "Van het voorm. Huis Ulft (Stokhorsterweg 3-5) resteert slechts een heuvel met fundamentresten. Het in 1130 voor het eerst genoemde huis werd in 1568 verwoest en rond 1892 gesloopt. In het huidige 19de-eeuwse huis op de heuvel bevindt zich nog een laat-16de-eeuwse alliantiesteen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0201.php> .

