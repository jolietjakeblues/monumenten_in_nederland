        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0159> ;
        schema:name "Ochten (gemeente Echteld)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Dorp, ontstaan op een oeverwal van de Waal. De dorpsbebouwing volgt de richting van de oeverwal, met haaks daarop enkele straten. De bebouwde kom is in de Tweede Wereldoorlog grotendeels verwoest. Na de wederopbouw in 1946-'48 in de trant van de Delftse School breidde de dorpskern zich in noordelijke richting verder uit."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01333> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ochten (gemeente Echteld)"@nl ;
        min:adres "Kerkstraat 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Neder-Betuwe" ;
        min:gemeenteInBoek "Echteld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Neder-Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ochten (gemeente Echteld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ochten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26967>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44677> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "14273",
            "14274" ;
        min:soort "inleiding" ;
        min:volgnummer 1333 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0159> ;
        schema:name "Ochten (gemeente Echteld)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "De Herv. kerk (Kerkstraat 1) is een rond 1950 gebouwde forse zaalkerk voorzien van een toren van twee geledingen met betonnen klokkenstoel en tentdak. In de toren hangt een door Peter en Johan van Trier gegoten klok (1643). Tegen de zijgevel staat een grafzerk van Hendrik van Beynhem (†1605). Beide objecten zijn afkomstig van de in de oorlog verwoeste voorganger."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01334> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ochten (gemeente Echteld)"@nl ;
        min:adres "Molendam 30" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Neder-Betuwe" ;
        min:gemeenteInBoek "Echteld" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Neder-Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ochten (gemeente Echteld)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ochten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1334 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0159> ;
        schema:name "Ochten (gemeente Echteld)"@nl ;
        schema:pageEnd "265" ;
        schema:pageStart "265" ;
        schema:pagination "265" ;
        schema:text "Het raadhuis (Molendam 30), een onderkelderd hoofdgebouw met traptoren en flankerende lagere vleugels, is in 1951-'52 gebouwd naar ontwerp van J. Evers in de trant van de Delftse School. In de schuin geplaatste rechtervleugel is de brandweerkazerne ondergebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0159.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01335> a min:Passage,
