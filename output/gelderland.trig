        min:kern "Oosterwolde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/30803> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "31381" ;
        min:soort "inleiding" ;
        min:volgnummer 1375 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0165> ;
        schema:name "Oosterwolde (gemeente Oldebroek)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "De Herv. kerk (Groote Woldweg 26) is een eenvoudige kruiskerk voorzien van een geveltoren met ingesnoerde spits. De kerk werd in 1845 als zaalkerk gebouwd en vervolgens rond 1900 en rond 1920 in fasen uitgebreid tot een kruiskerk met recht gesloten koor. De kerk bevat een door R. Knol gebouwd orgel (1800). De pastorie (Groote Woldweg 31) is een blokvormig herenhuis uit 1922."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0165.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01376> a min:Passage,
