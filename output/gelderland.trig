        schema:pageEnd "169" ;
        schema:pageStart "168" ;
        schema:pagination "168-169" ;
        schema:text "Schoonderlogt (Logtsestraat 4-6). Van dit voorm. landgoed, gelegen ten westen van Elst, resteren de gepleisterde boerderij en het opmerkelijke poortge-bouw met portierswoning en dakruiter, gebouwd in 1905 in neorenaissance-stijl met vakwerk-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0075.php> .

