        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill442>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill443> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Padevoort"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "346" ;
        schema:pagination "346-347" ;
        schema:text "Padevoort (Vinkwijk 4) is een voorm. havezate, die voor het eerst wordt genoemd in 1272. Het huidige gebouw is een vergroting van het bestaande poortgebouw, ontstaan kort na de verkoop in 1633 aan Albert Schaep. Rond 1770 kreeg het een rococo-trap en -stucplafond. De ingangspartij is vroeg-19de-eeuws. Van 1876 tot 1965 bood het onderdak aan het St.-Jozefgesticht. Zusters augustinessen leidden de nabijgelegen meisjesschool (Vinkwijk 2) uit circa 1895. Rond 1980 is Padevoort gerestaureerd en ontdaan van de neorenaissance-toevoegingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01832> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeddam (gemeente Bergh) – Molens"@nl ;
        min:adres "Bovendorpsstraat 19",
            "Bovendorpsstraat 21",
            "Vinkwijkseweg 15" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Bergh" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeddam (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zeddam" ;
        min:lemma "Molens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/37905> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "9291" ;
        min:soort "lemma" ;
        min:volgnummer 1832 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Molens"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text "Molens. Op een belt staat de windmolen Bovendorpsstraat 14, een ronde torenmolen met een forse houten kap gedekt met dakleer. Deze korenmolen werd rond 1440 gebouwd voor de heer van Bergh. De huidige molenkap is mogelijk nog 17de-eeuws. Tot een verbouwing in 1839 bereikte men de maalzolder via een buitentrap. Bij die gelegenheid zijn twee lagere zolders toegevoegd en is een inrit in de belt gemaakt. De molen is in 1990-'91 gerestaureerd. De mulderswoning (Bovendorpsstraat 21) stamt uit circa 1800. Al in 1441 wordt bij de korenmolen een rosmolen genoemd. De huidige rosmolen (bij Bovendorpsstraat 19) zou al in 1546 op deze plaats hebben gestaan. Het huidige molenhuis is in 1974 opgebouwd, waarbij ook een drijfwerk is aangebracht. De Volharding (Vinkwijkseweg 15) is een ronde witte beltmolen voorzien van een met dakleer gedekte houten kap. De molen is in 1891 gebouwd voor T.H. van Ditshuizen en in 1979 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01833> a min:Passage,
            schema:CreativeWork ;
