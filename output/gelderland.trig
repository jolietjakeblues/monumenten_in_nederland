        min:hoofdstuk "Steden, dorpen, monumenten › Heerde" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Heerde" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 941 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0100> ;
        schema:name "Heerde"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "Esdorp, ontstaan in de hoge middeleeuwen. De bebouwing langs de Eperweg, de Dorpsstraat en de Bonenburgerlaan verdichtte zich geleidelijk en bleef tot 1850 voornamelijk agrarisch van karakter. Heerde kreeg in 1886 een station aan de spoorlijn Apeldoorn-Hattem. Vanaf 1875 kwam langs de Eperweg, de Hoofdstraat en later langs de Zwolseweg enige villabebouwing tot stand. Het dorp is na de Tweede Wereldoorlog in westelijke, zuidelijke en noordelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00942> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerde"@nl ;
        min:adres "Dorpsstraat 31" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
        min:gemeenteInBoek "Heerde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerde_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heerde" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Heerde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76702>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/76703> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "520198",
            "520199" ;
        min:soort "inleiding" ;
        min:volgnummer 942 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0100> ;
        schema:name "Heerde"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "De Herv. kerk (Dorpsstraat 31), oorspronkelijk gewijd aan St. Johannes de Evangelist, is een eenbeukige kruiskerk met driezijdig gesloten koor en een toren van vier geledingen met balustrade en ingesnoerde spits. Het met tufsteen beklede koor is waarschijnlijk in de eerste helft van de 15de eeuw gebouwd. Ook de onderbouw van de laat-middeleeuwse toren is met tufsteen bekleed. De detaillering met gestucte boognissen en friezen in neoromaanse stijl is in 1869 aangebracht; de neogotische balustrade en de naaldspits dateren uit 1907. Ter vervanging van het al in 1841 vernieuwde schip verrees in 1923 het huidige kruisvormige schip. H.A. Pothoven ontwierp dit in gele baksteen uitgevoerde gedeelte in expressionistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00943> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerde"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
        min:gemeenteInBoek "Heerde" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heerde_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heerde" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Heerde" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 943 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0100> ;
        schema:name "Heerde"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "Het interieur van het koor wordt gedekt door kruisribgewelven. Schip en transept hebben een open houten kapconstructie en worden verlicht door paraboolvormige glas-in-loodvensters. De kerk bevat een door J.H. Holtgräve gebouwd orgel met neobarokke kast (1843-'45, uitgebreid in 1964)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00944> a min:Passage,
