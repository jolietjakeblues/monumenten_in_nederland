        min:kern "Zevenaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/29978>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56341> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "40418",
            "40419" ;
        min:soort "inleiding" ;
        min:volgnummer 1844 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0234> ;
        schema:name "Zevenaar"@nl ;
        schema:pageEnd "349" ;
        schema:pageStart "348" ;
        schema:pagination "348-349" ;
        schema:text "De R.K. St.-Andreaskerk (Markt 2) is een driebeukige pseudobasiliek met driezijdig gesloten koor en een toren van vier geledingen met ingesnoerde naaldspits. In 1532 bouwde men ter plaatse van een 15de-eeuwse kapel het huidige laat-gotische schip. De kerk werd in 1605 hersteld na brandschade in 1601. Het neogotische koor verrees in 1870 naar ontwerp van H. Schneider, in 1884 gevolgd door de neogotische toren naar plannen van A. Tepe. In de toren hangt een klok gegoten door Johannes en Petrus van Trier (1648) en één door Christiaan Voigt (1781). Onder leiding van W. te Riele werd de kerk in 1905 gerestaureerd. Daarna volgden nog een modernisering van het interieur (1965-'66) en een algehele restauratie (1991-'92)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0234.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01845> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenaar"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Zevenaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zevenaar" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zevenaar" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1845 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0234> ;
        schema:name "Zevenaar"@nl ;
        schema:pageEnd "349" ;
        schema:pageStart "349" ;
        schema:pagination "349" ;
        schema:text "Het interieur wordt gedekt door kruisribgewelven, die via kolonetten rusten op zuilen met onversierde lijstkapitelen. In de kerk bevindt zich de ‘Elverickplaat’, een belangrijke midden-15de-eeuwse koperen memorieplaat met gegraveerde kruisigingsgroep en schenkersfiguren (Hendric van Elverick (†1456) en Yda Greven (†1446)). Tot de inventaris behoren verder een ‘Christus op de koude steen’ (circa 1500), een achtkantige kuip van een laat-gotisch doopvont (15de eeuw), de grafzerken van Adriaen Spierinck (†1604) en zijn vrouw Wendelina Schmullinck (†1594) en een barokke preekstoel (1657) van Henrick Wijtvelt, die ook twee herenbanken (circa 1660) en de orgelgalerij (circa 1660) vervaardigde. De gebrandschilderde ramen (1905-'07) worden toegeschreven aan atelier F.W. Mengelberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0234.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01846> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenaar"@nl ;
        min:adres "Marktstraat 24" ;
