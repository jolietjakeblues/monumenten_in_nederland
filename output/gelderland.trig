        min:hoofdstuk "Steden, dorpen, monumenten › Ophemert (gemeente Neerijnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ophemert" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1378 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0166> ;
        schema:name "Ophemert (gemeente Neerijnen)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Ten noorden van de dorpskern werd in de 14de eeuw Huis Ophemert gesticht. In de loop van de tijd kwam een gestrekt esdorp tot ontwikkeling langs de Waalbandijk en de min of meer daaraan evenwijdige wegen. Na de Tweede Wereldoorlog is Ophemert in noordwestelijk richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01379> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Ophemert (gemeente Neerijnen)"@nl ;
        min:adres "Molenstraat 17" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Neerijnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Ophemert (gemeente Neerijnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ophemert" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41571>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/44533> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "30352",
            "30353" ;
        min:soort "inleiding" ;
        min:volgnummer 1379 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0166> ;
        schema:name "Ophemert (gemeente Neerijnen)"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "De Herv. kerk (Molenstraat 17), oorspronkelijk gewijd aan St. Lambertus, is een eenbeukige kerk met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De laatgotische, met tufsteen beklede toren en het bakstenen koor dateren uit de eerste helft van de 16de eeuw. Het tijdens de Tweede Wereldoorlog beschadigde schip is rond 1955 herbouwd in gotiserende trant naar plannen van N.J. Kruizinga. Inwendig wordt het koor gedekt door een netgewelf. Tot de inventaris behoren een barokke preekstoel (1662), drie rouwborden (18de eeuw) en een door C.G.F. Witte gebouwd orgel (1859) met een door H.B. Scheuerman vervaardigde orgelkast (1988)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0166.php> .

