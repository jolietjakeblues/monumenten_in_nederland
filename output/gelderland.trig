        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "272" ;
        schema:pageStart "272" ;
        schema:pagination "272" ;
        schema:text "Woonhuizen. Het gepleisterde neoclassicistische landhuis De Kapelhof (Waalbandijk 27) is in 1850 gebouwd voor burgemeester G.A.A.C. Valkis. Uit dezelfde tijd dateert het gepleisterde eenlaags herenhuis De Beukenhof (Molenstraat 22) met achteraanbouw en vrijstaande laat-19de-eeuwse schuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0166.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01382> a min:Passage,
            schema:CreativeWork ;
