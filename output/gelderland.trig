        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Pannerden (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Pannerden" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1409 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0172> ;
        schema:name "Pannerden (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "276" ;
        schema:pageStart "276" ;
        schema:pagination "276" ;
        schema:text "De R.K. St.-Martinuskerk (Kerkstraat 2) is een driebeukige neogotische basiliek met een toren van zes korte geledingen met tentdak, gebouwd in 1877-'78 naar plannen van A. Tepe. De oorspronkelijk romaanse toren bleef behouden, maar werd onherkenbaar beklampt. De torenspits ging in 1944 verloren. Bij de modernisering van het kerkinterieur in 1966-'68 is de beklamping in het torenportaal gedeeltelijk verwijderd. De kerk bevat een door Pereboom & Leyster gebouwd orgel (1878)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0172.php> .

