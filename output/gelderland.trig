        min:soort "inleiding" ;
        min:volgnummer 1617 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0204> ;
        schema:name "Varik (gemeente Neerijnen)"@nl ;
        schema:pageEnd "308" ;
        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "De Herv. kerk (Kerkstraat 16), gebouwd in 1880, is een eenbeukige neogotische kruiskerk met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerd hoog tentdak. De kerk bevat een preekstoel uit 1660."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0204.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01618> a min:Passage,
