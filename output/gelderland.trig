        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/22291> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "508143" ;
        min:soort "lemma" ;
        min:volgnummer 506 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0043> ;
        schema:name "Ophemert"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "Ophemert (Bovenstraat 12), ook ‘Hoge Huis’ genoemd, is een in 1633 voor richter Bernhardus Buck opgetrokken, fors gebouw met speklagen en een zadeldak tussen maniëristische, gezwenkte zijgevels. De roedenvensters zijn eind 18de eeuw aangebracht; het gebouw zal toen als boerderij dienst zijn gaan doen. De drie gekoppelde schuren zijn in 1896 toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00507> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bronkhorst (gemeente Steenderen) – Woonhuizen"@nl ;
        min:adres "Bovenstraat 2",
            "Gysbertplein 1344 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bronkhorst (gemeente Steenderen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bronkhorst" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14065>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33396> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "34539",
            "506444" ;
        min:soort "lemma" ;
        min:volgnummer 507 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0043> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "Woonhuizen. Het enige tweelaags huis in Bronkhorst is Kasteelweg 2, dat in zijn huidige vorm mogelijk uit het begin van de 19de eeuw dateert. Vanwege de aangebouwde 19de-eeuwse schuur heeft het - net als veel andere huizen in Bronkhorst - een agrarisch karakter (akkerburgerhuis). Een herbergfunctie hebben De Gouden Leeuw (Bovenstraat 2), een vroeg-17de-eeuws langgerekt pand met trapgevel, en het Wapen van Bronckhorst (Gysbertplein 1344 1), dat dateert uit de tweede helft van de 19de eeuw. Voorbeelden van dwarse huizen zijn Bovenstraat 1, een laat-18de-eeuws huis met schuurgedeelte, en Onderstraat 1, uit het begin van de 19de eeuw; de moderne etalagekasten zijn naar vroeg-19de-eeuws voorbeeld gemaakt. Dwarse huizen met haaks schuurdeel zijn de in oorsprong 18de-eeuwse voorm. poortwachterswoning Onderstraat 4 en het uit circa 1850 stammende Onderstraat 5. Huizen met een agrarisch karakter uit de eerste helft van de 19de eeuw zijn: Bovenstraat 10, Kapelstraat 1, Uilenhoek 2 en Onderstraat 2; het laatste heeft een uitgebouwd afdak boven de ingang. Een overwegend agrarisch karakter - met baanderdeuren onder een wolfdak - hebben de mogelijk 17de-eeuwse hallenhuizen Boterstraat 1, 3-5 en 7. Het huis Onderstraat 10 heeft de jaartalankers ‘1770’. Vroeg-19de-eeuws is 't Hof 2. Tot de jongere bouwkunst behoren de neoclassicistische notabelenwoning Bovenstraat 4 (circa 1860) en het sober expressionistische huis Onderstraat 8a (circa 1920)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00508> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bronkhorst (gemeente Steenderen) – Boerderijen"@nl ;
        min:adres "Maneveld 1",
            "Veerweg 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
