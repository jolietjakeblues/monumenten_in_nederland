        min:hoofdstuk "Steden, dorpen, monumenten › Lichtenvoorde" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lichtenvoorde" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1140 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0137> ;
        schema:name "Lichtenvoorde"@nl ;
        schema:pageEnd "219" ;
        schema:pageStart "219" ;
        schema:pagination "219" ;
        schema:text "Dorp, ontstaan aan de voet van het Oost-Nederlands Plateau bij een voorde in de Baaksche Beek. Bij de al in 946 genoemde nederzetting stichtte Giselbert, heer van Bronkhorst, in 1277 een kasteel. Tot een eigen parochie kwam het in de middeleeuwen echter niet. De heerlijkheid kwam in 1776 aan stadhouder Willem V, waarna rond 1780 het kasteel werd gesloopt. Met de fabrieken van Sterenborg en Hulshof kreeg Lichtenvoorde in de 19de eeuw een aanzienlijke leer- en schoennijverheid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0137.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01141> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lichtenvoorde"@nl ;
        min:adres "Rentenierstraat 9" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
