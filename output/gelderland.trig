        min:hoofdstuk "Steden, dorpen, monumenten › Ravenswaay (gemeente Buren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ravenswaay" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1428 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0175> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "Boerderijen. Blijkens de jaartalankers dateert de kleine gepleisterde dijkboerderij Lekbandijk 79, met zadeldak tussen topgevels, uit 1746. Ernaast staat een gepleisterd zomerhuis. Eveneens 18de-eeuws is de gedeeltelijk gepleisterde boerderij Lekbandijk 19, voorzien van een gewelfde kelder en een opkamer. De gepleisterde krukhuisboerderij Prinses Margrietstraat 14 stamt uit circa 1800, de ondiepe hallenhuisboerderij Lekbandijk 31 uit de eerste helft van de 19de eeuw. Uit het midden van die eeuw is de dijkboerderij Lekbandijk 47. Voorbeelden van hallenhuisboerderijen met dwars voorhuis zijn: Lekbandijk 29 (circa 1850), Lekbandijk 87 (circa 1850), Het Blockhuis (Lekbandijk 57) en Donkerstraat 9."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0175.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01429> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Rekken (gemeente Eibergen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berkelland" ;
        min:gemeenteInBoek "Eibergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Rekken (gemeente Eibergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Rekken" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1429 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0176> ;
        schema:name "Rekken (gemeente Eibergen)"@nl ;
        schema:pageEnd "279" ;
        schema:pageStart "279" ;
        schema:pagination "279" ;
        schema:text "Dorp, ontstaan op een dekzandrug aan de noordzijde van de Berkel. In 1379 kreeg het een eigen kapel en in 1653 werd het een zelfstandige parochie. In de 19de eeuw ontstond ten zuiden van de Berkel een katholiek dorpsdeel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0176.php> .

