        min:hoofdstuk "Steden, dorpen, monumenten › Nederhemert-Zuid (gemeente Zaltbommel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Nederhemert-Zuid" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1245 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0152> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "233" ;
        schema:pageStart "233" ;
        schema:pagination "233" ;
        schema:text "Woonhuizen. Het mogelijk 18de-eeuwse dwarse huis Kasteellaan 5-7 heeft een rieten wolfdak en een ingang in de zijgevel. Vroeg-19de-eeuws is Kerklaan 3, een dwars huis met hoog schilddak en aan de achterzijde een uitbouw met lessenaarsdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0152.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01246> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Nederhemert-Zuid (gemeente Zaltbommel) – Boerderijen"@nl ;
        min:adres "Kasteellaan 10" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zaltbommel" ;
