        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0155> ;
        schema:name "Nijbroek (gemeente Voorst)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text "Dorp, gesticht kort na 1328 toen het gebied in opdracht van graaf Reinald II werd ontgonnen en ingepolderd. Rond de kerk ontstond in de 19de eeuw een bescheiden dorpskern."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0155.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01263> a min:Passage,
