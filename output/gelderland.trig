        min:hoofdstuk "Steden, dorpen, monumenten › Berg en Dal (gemeente Groesbeek/Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Berg en Dal" ;
