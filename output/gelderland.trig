        min:hoofdstuk "Steden, dorpen, monumenten › Bredevoort (gemeente Aalten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bredevoort" ;
        min:lemma "Bedrijfsgebouwen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 501 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0042> ;
        schema:name "Bedrijfsgebouwen"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text """Bedrijfsgebouwen. De voorm. zuivelfabriek (Boterstraat 5-7), met woonhuis en schoorsteen, stamt uit 1904. De voorm. textielweverij (Misterstraat 41) is in 1907 gesticht door Th. van Eijck en, na overname door H. Sevinck, in 1910 en 1918 uitgebreid.

De R.K. begraafplaats (bij Bolwerkweg 2), aangelegd rond 1905, heeft een neogotisch poortgebouw annex baarhuisje."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00502> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bredevoort (gemeente Aalten) – 'T Walfort"@nl ;
        min:adres "Walfortlaan 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Aalten" ;
        min:gemeenteInBoek "Aalten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aalten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bredevoort (gemeente Aalten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bredevoort" ;
        min:lemma "'T Walfort" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23933> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "6860" ;
        min:soort "lemma" ;
        min:volgnummer 502 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0042> ;
        schema:name "'T Walfort"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text """'T Walfort (Walfortlaan 1), gelegen ten zuidwesten van Bredevoort, is een voorm. havezate voor het eerst genoemd in 1402 toen Derk van Lintelo het goed in leen kreeg. Het L-vormige huis heeft nog een vroeg-15de-eeuwse kelder.

Inwendig bevat het gotische sleutelstukken en een renaissance-paneeldeur. Bij de oprijlaan staat een mogelijk nog 18de-eeuwse rode zandstenen jachtpaal. De nabijgelegen telefooncel (Oostermansweg hoek Walfortlaan) is één van de weinige overgebleven cellen in 1932 ontworpen door J.A. Brinkman en L.C. van der Vlugt."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00503> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bronkhorst (gemeente Steenderen)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bronkhorst (gemeente Steenderen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bronkhorst" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 503 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0043> ;
        schema:name "Bronkhorst (gemeente Steenderen)"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "Kleine stad, ontstaan op een oeverwal van de IJssel nabij de plaats waar de Grote Beek uitmondde. Hier verrees in de 12de eeuw het huis Bronkhorst. Op de voorburcht ontstond een planmatige nederzetting met een kapel (gesticht in 1360). Kort na het verkrijgen van stadsrechten in 1482 versterkte men de ommuring en voorzag men deze van twee stadspoorten. Een brand verwoestte de kleine stad in 1633. Nadat in 1795 de heerlijkheid was opgeheven, werd het kasteel in 1828 grotendeels gesloopt. Bronkhorst is een beschermd stadsgezicht en staat toeristisch bekend als de kleinste stad van Nederland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00504> a min:Passage,
