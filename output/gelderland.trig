        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "De Herv. kerk (Kerkweg 26), oorspronkelijk gewijd aan St. Helena, is een tweebeukige kerk met driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde naaldspits. De toren verrees tussen eind 12de en begin 14de eeuw, het gotische koor in de tweede helft van de 15de eeuw. Het deels pseudobasilicale schip met smalle zijbeuk stamt uit 1536. In 1875 heeft men de toren verbouwd en verhoogd. De kerk is in 1934 en in 1985-'89 gerestaureerd. Het interieur wordt gedekt door kruisribgewelven, die ten dele rusten op gebeeldhouwde kraagstenen en ronde zuilen. Het door H. Haffmans gebouwde orgel dateert uit 1846. De voorm. pastorie (Polderdijk 14) is gebouwd in 1853."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0010.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00239> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aerdt (gemeente Rijnwaarden) – Boerderijen"@nl ;
        min:adres "Aerdtsedijk 53" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Rijnwaarden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aerdt (gemeente Rijnwaarden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Aerdt" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 239 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill65> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0010> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "64" ;
        schema:pageStart "63" ;
        schema:pagination "63-64" ;
        schema:text """Boerderijen. Langs de Oude Rijndijk staan enkele interessante boerderijen. De wit geschilderde, L-vormige boerderij Aerdtsedijk 22 heeft aan de voorgevel de jaartalankers ‘1773’. De voorm. daglonersboerderij Aerdtsedijk 16 werd rond 1860 gebouwd. Aerdtsedijk 25 is een forse hallenhuisboerderij annex veerhuis, die zijn huidige vorm kreeg in 1907.

Het dijkmagazijn (Aerdtsedijk 53) is een tegen de binnenkant van de dijk geplaatst langwerpig pand uit 1879 in sober neoclassicistische vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0010.php> .

