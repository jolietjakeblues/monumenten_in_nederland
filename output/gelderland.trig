        min:kern "Zevenaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11626> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "40423" ;
        min:soort "inleiding" ;
        min:volgnummer 1846 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0234> ;
        schema:name "Zevenaar"@nl ;
        schema:pageEnd "349" ;
        schema:pageStart "349" ;
        schema:pagination "349" ;
        schema:text "De Herv. kerk (Marktstraat 24) is een zaalkerk uit 1658 met een driezijdige sluiting, een dakruiter en toscaans zandstenen toegangspoortje in classicistische vormen. In de dakruiter hangt een door Peter van Trier gegoten klok (1670). De neoclassicistische consistoriekamer aan de oostzijde is in 1873 toegevoegd. Tot de grotendeels uit de bouwtijd stammende inventaris behoren een barokke preekstoel (1659), gemaakt door Henrick Wijtvelt, enkele herenbanken en een door Conrad Ruprecht rijk gesneden orgelkast (1697)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0234.php> .

