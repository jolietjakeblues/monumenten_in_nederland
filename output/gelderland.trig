        schema:pageEnd "148" ;
        schema:pageStart "148" ;
        schema:pagination "148" ;
        schema:text "Woonhuizen. Het gepleisterde neoclassicistische herenhuis De Varenkamp (Zuiderzeestraatweg 63-65) is rond 1850 gebouwd. Het uit dezelfde tijd stammende pand Zuiderzeestraatweg West 75 heeft een vergelijkbare vormgeving."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0059.php> .

