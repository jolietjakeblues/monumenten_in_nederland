        schema:name "Opijnen (gemeente Neerijnen)"@nl ;
        schema:pageEnd "273" ;
        schema:pageStart "273" ;
        schema:pagination "273" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. In de loop van de tijd is evenwijdig aan de Waaldijk een gestrekt esdorp tot ontwikkeling gekomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0168.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01388> a min:Passage,
