        schema:name "Windmolen"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Windmolen ‘De Hoop’ (Rhabergseweg 16), gelegen in het gehucht Rha ten zuidwesten van Steenderen, is een ronde beltmolen voorzien van een met riet gedekte houten kap. De korenmolen is in 1879 gebouwd voor W. Kanters, ter plaatse van een uit 1856 stammende voorganger, en in 1999 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0191.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01523> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terborg (gemeente Wisch)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Oude IJsselstreek" ;
        min:gemeenteInBoek "Wisch" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oude_IJsselstreek> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terborg (gemeente Wisch)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Terborg" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1523 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0192> ;
        schema:name "Terborg (gemeente Wisch)"@nl ;
        schema:pageEnd "293" ;
        schema:pageStart "293" ;
        schema:pagination "293" ;
        schema:text "Kleine stad, ontstaan op een rivierduin van de Oude IJssel ‘bij de Borch’ van de Heren van Wisch. In 1419 kreeg Terborg stadsrechten. De groei bleef beperkt tot de bebouwing langs de Hoofdstraat. In 1531 nam Karel van Gelre de stad in. Door de vestiging van de ijzergieterij ‘Vulcaansoord’ (op de grens met Gaanderen) en het station (1883) kreeg Terborg een bescheiden centrumfunctie. Na de Tweede Wereldoorlog zijn aan de noordzijde aanzienlijke uitbreidingen gerealiseerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0192.php> .

