        min:soort "inleiding" ;
        min:volgnummer 965 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0103> ;
        schema:name "Hemmen (gemeente Valburg)"@nl ;
        schema:pageEnd "196" ;
        schema:pageStart "196" ;
        schema:pagination "196" ;
        schema:text "De voorm. pastorie (Dorpsstraat 1) is een gepleisterd herenhuis, blijkens de gevelsteen daterend uit 1853. Nabij de kerk staat een gepleisterde dorpspomp (hoek Kerkplein/Dorpsstraat) uit 1748 met een geknikt zinken tentdak."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0103.php> .

