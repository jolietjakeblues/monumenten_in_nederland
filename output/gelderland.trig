        min:hoofdstuk "Steden, dorpen, monumenten › Wehl" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wehl" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1732 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0220> ;
        schema:name "Wehl"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "Dorp, ontstaan op een laagterras tussen de Rijn en de Oude IJssel. In 1466 werd Wehl een zelfstandige parochie. De heerlijkheid werd in 1647 verpand aan graaf Albrecht van Bergh, waardoor het een Kleefse enclave werd (tot 1808). Vanaf 1816 hoort Wehl officieel tot Nederland."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0220.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01733> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wehl"@nl ;
        min:adres "Kerkplein 1",
            "Kerkplein 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Doetinchem" ;
        min:gemeenteInBoek "Wehl" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Doetinchem> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wehl" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wehl" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/25573>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54193> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38665",
            "38666" ;
        min:soort "inleiding" ;
        min:volgnummer 1733 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill415> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0220> ;
        schema:name "Wehl"@nl ;
        schema:pageEnd "329" ;
        schema:pageStart "329" ;
        schema:pagination "329" ;
        schema:text "De R.K. St.-Martinuskerk (Kerkplein 1) is een driebeukige pseudobasiliek met tweebeukig transept, driezijdig gesloten koor en een toren van vier geledingen met ingesnoerde naaldspits. De romaanse tufstenen toren stamt uit de 12de eeuw en werd in de 13de eeuw in baksteen verhoogd. Het tufstenen schip, waarvan de zijbeuken langs de toren zijn doorgetrokken, kwam rond 1500 tot stand. Toren en schip ondergingen in 1894-'95 een ingrijpende restauratie naar plannen van J.W. Boerbooms. Naar neogotisch ontwerp van H. Kroes verrezen in 1916 het transept en het koor met zijkapellen ter plaatse van een koorpartij die in 1854 het oude gotische koor had vervangen. Tot de inventaris behoren een gotisch zandstenen doopvont, een laatgotisch beeld van Maria met Kind en een 17de-eeuws kruisbeeld. De pastorie (Kerkplein 4) is een statig neoclassicistisch pand uit circa 1800, met aangebouwde laat-19de-eeuwse tuinkamer."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0220.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01734> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wehl"@nl ;
        min:adres "Keppelseweg 29" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
