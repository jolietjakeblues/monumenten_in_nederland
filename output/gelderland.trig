        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Neerijnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Haaften (gemeente Neerijnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Haaften" ;
        min:lemma "Hellouw" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 889 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill217> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0093> ;
        schema:name "Hellouw"@nl ;
        schema:pageEnd "183" ;
        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "Hellouw. Dit dorp ten noordwesten van Haaften is in de vroege middeleeuwen ontstaan op een smalle zandrug. Tegen de dijk staat de in 1822 gebouwde Herv. kerk (Waalbandijk 57), een eenvoudige zaalkerk voorzien van een houten dakruiter met ingesnoerde spits. De pastorie is in 1860 aangebouwd. Aardige boerderijen in het dorp zijn de gepleisterde dijkboerderij Waalbandijk 115 (circa 1800), met dichtgezet dakoverstek aan de achterzijde, en Korfgraaf 29 (1899), een hallenhuisboerderij met dwars voorhuis. Ten noordwesten van Hellouw staan twee poldermolens, te weten ‘De Voorste Hellouwse Molen’ (Zeek 5) en ‘De Achterste Hellouwse Molen’ (Zeek 6). Deze wipmolens uit respectievelijk 1803 en 1864 zijn beide gebouwd ter plaatse van een door brand verwoeste voorganger. De molens hebben een ijzeren scheprad en een taps toelopende vierkante houten onderbouw met woning met daarop de houten kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0093.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00890> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Harderwijk"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
