        schema:pageEnd "63" ;
        schema:pageStart "63" ;
        schema:pagination "63" ;
        schema:text "Het Polderhuis (Lingedijk 93) is een gepleisterd, onderkelderd pand met bordestrap en tentdak, bekroond met een open klokkenstoel. Het in oorsprong 15de-eeuwse gebouw is in 1830 herbouwd met behoud van de oudere oostmuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0009.php> .

