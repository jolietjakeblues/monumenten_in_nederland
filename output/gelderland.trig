        schema:pageEnd "214" ;
        schema:pageStart "214" ;
        schema:pagination "214" ;
        schema:text "Dorp, ontstaan in de 18de eeuw als katholieke enclave langs de weg van Vorden naar Ruurlo. In 1725 verrees hier een eerste schuurkerk, die in 1834 werd vervangen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0131.php> .

