        min:soort "inleiding" ;
        min:volgnummer 1408 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0172> ;
        schema:name "Pannerden (gemeente Rijnwaarden)"@nl ;
        schema:pageEnd "276" ;
        schema:pageStart "275" ;
        schema:pagination "275-276" ;
        schema:text "Dorp, gelegen op een oeverwal van de Rijn. Bij het dorp werd in 1705-'07 het Pannerdens kanaal gegraven ter verbete-ring van de waterverdeling tussen Neder-Rijn en Waal. Rond de kerk vormde zich in de 19de eeuw een bescheiden bebouwing."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0172.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01409> a min:Passage,
