        schema:text "Ten behoeve van de kerk verrees in 1883 het gebouw Den Angang (Markt 46), uitgevoerd in neoclassicistische vormen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0228.php> .

