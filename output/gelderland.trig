        schema:name "Voorst"@nl ;
        schema:pageEnd "314" ;
        schema:pageStart "314" ;
        schema:pagination "314" ;
        schema:text "De voorm. Geref. kerk (Enkweg 1) is een zaalkerk uit 1896. Het ingangsportaal en de vensteromlijstingen zijn echter nog uitgevoerd in de vormen van de Willem II-gotiek. De pastorie (Rijksstraatweg 108) stamt uit circa 1870."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0209.php> .

