        schema:pageStart "183" ;
        schema:pagination "183" ;
        schema:text "Het voorm. raadhuis (Koningsstraat 15-17) uit 1882 is een eenvoudig blokvormig pand met neoclassicistische kenmerken waarnaast de voorm. brandweerkazerne ligt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0093.php> .

