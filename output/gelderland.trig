        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0206> ;
        schema:name "Veessen (gemeente Heerde)"@nl ;
        schema:pageEnd "310" ;
        schema:pageStart "309" ;
        schema:pagination "309-310" ;
        schema:text "De windmolen ‘Mölle van Bats’ (IJsseldijk 24) is een achtkantige korenmolen met stelling, gemetselde voet en een met riet gedekte houten bovenbouw. De molen is gebouwd in 1825 voor J. Nyenhuis en gerestaureerd in 1961-'62 en 1974. De bijbehorende molenaarswoning (IJsseldijk 26) dateert uit circa 1875."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0206.php> .

