        min:volgnummer 940 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0099> ;
        schema:name "Hotel"@nl ;
        schema:pageEnd "192" ;
        schema:pageStart "192" ;
        schema:pagination "192" ;
        schema:text "Hotel ‘Klein Zwitserland’ (Klein Zwitserlandlaan 5) verrees in 1905 in chaletstijl als centrum van het toen gestichte Wilhelminapark."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0099.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00941> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerde"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
