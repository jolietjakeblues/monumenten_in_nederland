        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0193> ;
        schema:name "Terschuur (gemeente Barneveld)"@nl ;
        schema:pageEnd "294" ;
        schema:pageStart "294" ;
        schema:pagination "294" ;
        schema:text "Klein dorp, dat zich na de Tweede Wereldoorlog ontwikkelde uit een gehucht bij de plaats waar de weg Amersfoort-Deventer (in 1809 verhard) en de spoorlijn Amersfoort-Apeldoorn (1876) samenkomen. Het dorp is genoemd naar de buitenplaats Terschuur."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0193.php> .

