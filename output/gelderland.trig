        schema:pageEnd "292" ;
        schema:pageStart "292" ;
        schema:pagination "292" ;
        schema:text "Woonhuizen. Het houten chalet De witte Pauwen (Allee 10) is opgetrokken in 1915 naar plannen van J. van der Goot en C.J. Kruisweg. De kleine villa Blokkenhuis (Staverdenseweg 266) uit 1930 is gebouwd in de stijl van het functionalisme naar ontwerp van J.A. Brinkman en L.C. Van der Vlugt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0190.php> .

