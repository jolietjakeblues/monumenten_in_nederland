        schema:pageStart "308" ;
        schema:pagination "308" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Langs de Waalbandijk en de parallel daarmee lopende Achterstraat-Keizerstraat-Walgtsestraat-Donkerstraat kwam een gestrekt esdorp tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0204.php> .

