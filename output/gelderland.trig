        schema:pageEnd "177" ;
        schema:pageStart "177" ;
        schema:pagination "177" ;
        schema:text "De voorm. openbare lagere school (Grotestraat 60) is in 1868 gebouwd als vierklassige gangschool met neoclassicistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0087.php> .

