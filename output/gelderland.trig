        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0205> ;
        schema:name "Varsseveld (gemeente Wisch)"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "309" ;
        schema:pagination "309" ;
        schema:text "Dorp, voor het eerst genoemd in 828. In 1152 komt het voor als zelfstandige parochie. Een felle brand teisterde het dorp in 1723. Aan de oostzijde, nabij het station (1883), kwam enige industrie tot ontwikkeling, waaronder een houtverwerkende industrie (nu Lundia-fabriek)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0205.php> .

