        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Lunteren (gemeente Ede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Lunteren" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1190 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0143> ;
        schema:name "Lunteren (gemeente Ede)"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "Dorp, ontstaan op de westrand van de Veluwestuwwal en uitgegroeid tot een dorp met lintbebouwing. In 1566 werd Lunteren een zelfstandige parochie. Een brand in 1850 verwoestte een belangrijk deel van het dorp. In 1902 kreeg Lunteren een station aan de nieuwe spoorlijn Nijkerk-Ede. Na de Tweede Wereldoorlog is Lunteren in noordwestelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01191> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Lunteren (gemeente Ede)"@nl ;
        min:adres "Dorpsstraat 34" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
