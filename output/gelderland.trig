        schema:name "Borculo"@nl ;
        schema:pageEnd "117" ;
        schema:pageStart "117" ;
        schema:pagination "117" ;
        schema:text "De voorm. synagoge (Weverstraat 4) is een rijk uitgevoerd neoclassicistisch zaalgebouw met ionische pilasters en een attieklijst, gebouwd in 1877 op de plaats van een voorganger uit 1842. De sjoel waarin consoles uit het oude raadhuis zijn verwerkt, werd in 1993 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0038.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00468> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Borculo"@nl ;
        min:adres "Steenstraat 28" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berkelland" ;
        min:gemeenteInBoek "Borculo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Borculo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Borculo" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 468 ;
