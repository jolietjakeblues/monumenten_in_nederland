        min:volgnummer 604 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0054> ;
        schema:name "Dinxperlo"@nl ;
        schema:pageEnd "138" ;
        schema:pageStart "138" ;
        schema:pagination "138" ;
        schema:text "Dorp, mogelijk in de 8ste eeuw ontstaan op een dekzandrug aan de A-Strang. In 1281 werd de parochie van die van Bocholt (D) afgesplitst. Tot 1795 maakte het dorp deel uit van de heerlijkheid Bredevoort. Dinxperlo vormt één geheel met de kern Süderwick (D) - met de Heelweg als grensstraat - en was tot 1930 sterk op Duitsland georiënteerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0054.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00605> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Dinxperlo"@nl ;
        min:adres "Markt 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
