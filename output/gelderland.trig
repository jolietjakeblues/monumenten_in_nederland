        min:soort "inleiding" ;
        min:volgnummer 492 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0042> ;
        schema:name "Bredevoort (gemeente Aalten)"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "Kleine stad, gelegen op de zuidwestrand van het Oost-Nederlands Plateau bij de ‘Brede Voorde’ over de Boven Slinge. In 1188 is hier sprake van een kasteel. Herman van Lohn en Ludolf van Steinfurt lieten het kasteel in 1238 versterken. In 1326 kwam het in Gelderse handen. Op de voorburcht ontstond een nederzetting met borgmanshuizen. Rond 1545 kreeg Bredevoort een versterking met wallen en rondelen voor de beide poorten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00493> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bredevoort (gemeente Aalten)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Aalten" ;
        min:gemeenteInBoek "Aalten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aalten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bredevoort (gemeente Aalten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bredevoort" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 493 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0042> ;
        schema:name "Bredevoort (gemeente Aalten)"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "Nadat de stad in 1597 in Staatse handen was gevallen, verbeterde men de omwalling in 1605-'06. Een ontploffende kruittoren vernielde in 1646 het kasteel (gelegen op 't Zand). In 1697 kwam de heerlijkheid Bredevoort in bezit van koning-stadhouder Willem III. Na opheffing van de heerlijkheid in 1795 volgde verdere sloop van het kasteel. In 1930 dempte men nog een deel van de stadsgracht. Bredevoort is beschermd stadsgezicht en ontwikkelde zich de laatste jaren tot een boekenstad."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00494> a min:Passage,
