        schema:name "Bergharen (gemeente Wijchen)"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "Het voorm. St-Annaklooster (Dorpsstraat 24-28) van de congregatie van zusters van de Goddelijke Voorzienigheid bestaat uit een hoofdgebouw met lagere, haakse schoolvleugels. Het complex verrees in 1909 naar ontwerp van C. Franssen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0035.php> .

