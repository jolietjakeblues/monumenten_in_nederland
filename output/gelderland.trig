        min:volgnummer 768 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0074> ;
        schema:name "Elspeet (gemeente Nunspeet)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "De pastorie (Nunspeterweg 4) is een neoclassicistisch herenhuis uit 1851. In de grote pastorietuin staan een achtkantige bakstenen tuinkoepel en een koetshuis. Het nabijgelegen neoclassicistische eenlaagspand Nunspeterweg 12 uit circa 1850 is mogelijk gebouwd als zondagsschool."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0074.php> .

