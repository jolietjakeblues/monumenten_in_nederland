        min:soort "lemma" ;
        min:volgnummer 1678 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0212> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text "Woonhuizen. Eclectisch van vorm is het dubbele woonhuis Raadhuisstraat 13-15 uit circa 1880. Neorenaissance-details heeft de voor H. Thate gebouwde Villa Pax (Zutphenseweg 98) uit 1906; 't Elshof (Zutphenseweg 40) uit circa 1905 vertoont chalet-details. Het herenhuis Midwijck (Zutphenseweg 12) stamt vermoedelijk uit circa 1880, maar is rond 1915 in traditionalistische vormen verbouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0212.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01679> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vorden – Windmolens"@nl ;
        min:adres "Enkweg 31",
            "Het Hoge 66",
            "Kerkhoflaan 4",
            "Zutphenseweg 39" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Vorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vorden" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vorden" ;
        min:lemma "Windmolens" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/36385>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39769>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/53201> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38119",
            "38145",
            "480839" ;
        min:soort "lemma" ;
        min:volgnummer 1679 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill401>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill402> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0212> ;
        schema:name "Windmolens"@nl ;
        schema:pageEnd "317" ;
        schema:pageStart "317" ;
        schema:pagination "317" ;
        schema:text """Windmolens. De achtkantige stellingkorenmolen De Hoop (Zutphenseweg 39) heeft een met riet beklede romp op een bakstenen voet. De in 1850 voor G. Oldenampsen gebouwde molen is in 1967 gerestaureerd. De Hackforter molen (Het Hoge 66) is een hoge ronde stellingkorenmolen, gebouwd in 1851 voor B.F.L. en A. baron van Westerholt van Hackfort en gerestaureerd in 1974. Het station (Enkweg 31) is een rijzig gebouw met lagere zijvleugels, gebouwd in 1877-'78 in een combinatie van neoclassicistische en chalet-elementen voor de Nederlandsch-Westfaalsche Spoorweg-Maatschappij. De rechter vleugel is in 1919 verlengd.

De Alg. begraafplaats (bij Kerkhoflaan 4) is in 1837 aangelegd naar plannen van A.J. Reynvaan. Aan weerszijden van de centrale laan liggen drie adellijke grafkelders, waarvan enkele in neoclassicistische vormen. Aan de oostzijde bevinden zich die van kasteel Vorden (1902), De Wildenborch - met het graf van A.C.W. Staring (†1840) - en De Wiersse (familie Van Limburg Stirum). Aan de westzijde liggen de grafkelders van Hackfort (familie Van Westerholt), De Wiersse (familie Van Heeckeren) en Den Bramel (familie Storm van 's Gravesande). Terzijde ligt de grafkelder van Het Enzerinck. Het baarhuisje stamt uit circa 1890."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0212.php> .

