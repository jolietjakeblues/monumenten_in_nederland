        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/39111>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55094> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "11595",
            "11596" ;
        min:soort "inleiding" ;
        min:volgnummer 552 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0049> ;
        schema:name "Culemborg"@nl ;
        schema:pageEnd "129" ;
        schema:pageStart "129" ;
        schema:pagination "129" ;
        schema:text "De Oud-Kath. kerk van St. Barbara en St. Antonius (Varkensmarkt 18) [2] is een eenvoudige zaalkerk met halfronde apsis en een neoclassicistische deuromlijsting, gebouwd in 1836 naar ontwerp van stukadoor Beers. Tot de inventaris behoren een preekstoel (circa 1725) en een door J.F. Witte gebouwd orgel (1900). De pastorie (Varkensmarkt 20) is een herenhuis uit circa 1840."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0049.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00553> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Culemborg"@nl ;
        min:adres "Achterstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Culemborg" ;
        min:gemeenteInBoek "Culemborg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Culemborg_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Culemborg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Culemborg" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33298> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "11525" ;
        min:soort "inleiding" ;
        min:volgnummer 553 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0049> ;
        schema:name "Culemborg"@nl ;
        schema:pageEnd "130" ;
        schema:pageStart "129" ;
        schema:pagination "129-130" ;
        schema:text "De Evang. Luth. kerk (Achterstraat 2) [3] is een recht gesloten zaalkerk met zeshoekig houten klokkentorentje, gebouwd in 1839 ter plaatse van de in 1676 voor de Lutheranen herbouwde middeleeuwse kapel van het Pietersgasthuis. De kerk heeft spitsboogvensters en een neoclassicistische ingangsomlijsting. In het klokkentorentje hangt een door Gerhard Schimmel gegoten klok (1686). Het interieur wordt gedekt door een houten spitstongewelf. Tot de inventaris behoren twee gesneden herenbanken (1676-'77), een preekstoel met doophek (circa 1840) en een door G. van Druten gebouwd orgel (1897). De kerk is in 1986 gerestaureerd, gelijktijdig met het laatmiddeleeuwse dwarse huis Achterstraat 6-8, dat een onderdeel vormde van het in de 14de eeuw gestichte Pietersgasthuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0049.php> .

