        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Overbetuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zetten (gemeente Valburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zetten" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1842 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill447> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0233> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "348" ;
        schema:pageStart "348" ;
        schema:pagination "348" ;
        schema:text """Woonhuizen. Het statige herenhuis Wageningsestraat 43 kwam rond 1890 tot stand in eclectische vormen. Uit 1900-'01 dateert Hoofdstraat 50, met mansardedak en neorenaissance-decoraties. Landhuis De Til (Wageningsestraat 102) is in 1922-'23 gebouwd naar een ontwerp van J. en Th. Stuivinga met expressionistische invloeden.

Het station Zetten-Andelst (Wageningsestraat 39-41) bestaat uit een tweelaags risalerend middendeel en lagere, haakse zijvleugels. Het in 1898 gebouwde station, mogelijk naar ontwerp van D.A.N. Margadant, verving een halteplaats uit 1887.

Het trafohuisje (Hoofdstraat 59) dateert uit circa 1925 en is door J. Gratama en G. Versteeg ontworpen in zakelijk-expressionistische vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0233.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01843> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zevenaar"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
