        min:volgnummer 762 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill195> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0073> ;
        schema:name "Ellecom (gemeente Rheden)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "166" ;
        schema:pagination "166-167" ;
        schema:text "De oude schoolkapel (Zutphensestraatweg 1-3) is een driezijdig gesloten zaalkerk, gebouwd rond 1860 door Lady Athlone voor diegenen die het niet eens waren met de verbouwing van de kerk in 1859, waarbij onder het koor een grafkapel voor de families Van Reede en Bentinck werd ingericht. Aan de kapel werd in 1896 een schoolgedeelte toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0073.php> .

