        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De voorm. R.K. St-Bonifatiuskerk (Kerkpad 2) is een eenbeukige kerk met hoger, driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde spits. De toren dateert uit de 14de eeuw en heeft gekoppelde galmgaten met natuurstenen deelzuiltjes. In de toren hangt een door de gebroeders Van Trier gegoten klok (1658). Het van tufstenen speklagen voorziene, laat-gotische koor kwam rond 1450 tot stand. Het huidige schip is uit het tweede kwart van de 19de eeuw. Het interieur wordt gedekt door een balkenplafond, aangebracht bij de restauratie van 1931-'37."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01040> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horssen (gemeente Druten)"@nl ;
        min:adres "Kerkpad 11",
            "Kerkpad 13" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horssen (gemeente Druten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Horssen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/23034>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/48695> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "22633",
            "22634" ;
        min:soort "inleiding" ;
        min:volgnummer 1040 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0118> ;
        schema:name "Horssen (gemeente Druten)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De Herv. kerk (Kerkpad 11) is een uit 1821-'22 daterende kleine, driezijdig gesloten zaalkerk voorzien van een zeszijdige dakruiter met ingesnoerde spits. Tegen de koorsluiting staat een consistorie. Het interieur wordt gedekt door een tongewelf. Tot de inventaris behoren een eikenhouten preekstoel en twee overhuifde herenbanken in neorococo-vormen (1822) met het alliantiewapen van P. Bouwens en M.J. Gerbada, bewoners van het Huis te Horssen. De forse pastorie (Kerkpad 13) met koetshuis dateert uit 1829."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01041> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horssen (gemeente Druten)"@nl ;
        min:adres "Kerkpad 7",
            "Kerkpad 9-9a" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horssen (gemeente Druten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Horssen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17740> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "22636" ;
        min:soort "inleiding" ;
        min:volgnummer 1041 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0118> ;
        schema:name "Horssen (gemeente Druten)"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "De R.K. kerk St. Antonius Abt (Kerkpad 7) is een driebeukige basiliek met vijfzijdig gesloten koor, laag pseudotransept, doopkapel en een toren van vier geledingen met haakse steunberen en een ingesnoerde naaldspits. De neogotische kerk verrees in 1909-'10 naar ontwerp van C. Franssen. Het interieur wordt deels gedekt door kruisribgewelven. Tot de inventaris behoren een door M. van Bokhoven vervaardigd neogotisch hoogaltaar (1910) en een preekstoel uit 1911-'15. De gebrandschilderde ramen zijn van atelier F. Nicolas (1910). De pastorie (Kerkpad 9-9a) uit 1870 is een ontwerp van architect Van Schadewijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01042> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horssen (gemeente Druten) – Huis te Horssen"@nl ;
        min:adres "Zelksestraat 14" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horssen (gemeente Druten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Horssen" ;
        min:lemma "Huis te Horssen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/26641> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "22642" ;
        min:soort "lemma" ;
        min:volgnummer 1042 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0118> ;
        schema:name "Huis te Horssen"@nl ;
        schema:pageEnd "206" ;
        schema:pageStart "206" ;
        schema:pagination "206" ;
        schema:text "Huis te Horssen (Zelksestraat 14). Na de sloop rond 1850 van het waarschijnlijk 17de-eeuwse huis heeft men één van de bijgebouwen - mogelijk het rentmeestershuis - tot hoofdhuis verbouwd. De korte oostgevel werd een representatieve voorgevel bij het woongedeelte. Het westelijke deel van het pand werd bedrijfsruimte. Met name de lange zijgevels laten bouwsporen zien van oudere situaties. Het tweelaags landhuis met hoog schilddak ligt in de as van de voorm. oprijlaan. De vier hardstenen hekpijlers van het vroeg-19de-eeuwse smeedijzeren toegangshek worden bekroond door siervazen in empire-vormen. In de 19de-eeuwse landschappelijke parkaanleg is de oudere, formele parkaanleg nog herkenbaar aan het patroon van de paden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01043> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Horssen (gemeente Druten) – Boerderijen"@nl ;
        min:adres "Lindeboomstraat 4",
            "Zelkestraat 2",
            "Zelkestraat 8",
            "Zelksestraat 12",
            "Zelksestraat 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Horssen (gemeente Druten)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Horssen" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17030> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "22641" ;
        min:soort "lemma" ;
        min:volgnummer 1043 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0118> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "206" ;
        schema:pagination "206-207" ;
        schema:text "Boerderijen. Het dorp heeft diverse interessante oude boerderijen. Het bedrijfsgedeelte van Het Goch (Lindeboomstraat 4), een kleine 18de-eeuwse hallenhuisboerderij met dwars voorhuis, is naar de weg gekeerd. Vergelijkbaar is de opzet van de meeste boerderijen aan de Zelkestraat, met hun voorgevels gericht naar het Kerkpad. Een 18de-eeuwse oorsprong hebben verder de hallenhuisboerderijen De Laan (Zelksestraat 4) en De Vogelzanger (Zelkestraat 8); de laatste heeft wijzigingen ondergaan. Eind 18de- of vroeg-19de-eeuws is de boerderij Kweekhoven (Zelksestraat 12), een hallenhuisboerderij met een dwars voorhuis voorzien van een rieten zadeldak tussen topgevels. De deels gepleisterde hallenhuisboerderij Het Houten Wames (Zelkestraat 2) dateert in zijn huidige vorm uit de eerste helft van de 19de eeuw. Hallenhuisboerderijen met een dwars voorhuis zijn verder Pannekoeksestraat 1 (begin 19de eeuw) - de wagenschuur is uit circa 1900 -, Roedensestraat 10 (midden 19de eeuw) en Kerkpad 4-4a, dat in de 19de eeuw tevens als school heeft dienst gedaan. De krukhuisboerderij Zelkestraat 10 dateert uit de tweede helft van de 19de eeuw."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0118.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01044> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1044 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Huissen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Kleine stad, ontstaan in de vroege middeleeuwen op een stroomrug. In de late middeleeuwen was het een kleine handelsnederzetting met stadsrechten (1348) en omwalling - nog herkenbaar aan de benaming Stadswal. In de Tweede Wereldoorlog werd Huissen zwaar getroffen, waardoor de dorpskern nu wordt gekenmerkt door bebouwing uit de wederopbouw. Na de oorlog is Huissen aan de noord-, west- en zuidzijde flink uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01045> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen"@nl ;
        min:adres "Kloosterlaan 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1045 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Huissen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Het dominicanerklooster (Kloosterlaan 1) ontwikkelde zich bij een neoclassicistisch landhuis uit 1816. Het U-vormige kloostercomplex is in 1856-'58 gebouwd naar ontwerp van P.J.H. Cuypers en is later enkele keren uitgebreid en gewijzigd. De neogotische driezijdig gesloten kapel met zijkapellen en dakruiter heeft inwendig een houten spits tongewelf en bevat neogotische koorbanken naar ontwerp van Cuypers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01046> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen"@nl ;
        min:adres "Langekerkstraat 2-4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1046 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Huissen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Het voorm. St.-Elisabethklooster van de franciscanessen van Heythuizen (Langekerkstraat 2-4) bestaat uit een neogotische kapel (1890-'91) naar ontwerp van G. te Riele en kloostergebouwen met een kloostergang rond een binnenhof (1935) naar ontwerp van G.M. Leeuwenberg. Het complex dient sinds 1978 als raadhuis en is in 1988-'91 en in 1999 uitgebreid. De voorm. kapel heeft een tongewelf van stucwerk en gebrandschilderde ramen (circa 1891) naar ontwerp van K. Trautwein."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01047> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen"@nl ;
        min:adres "Langekerkstraat 10" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1047 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Huissen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "De R.K. kerk O.L. Vrouwe ten Hemelopneming (Langekerkstraat 10) is een driebeukige basiliek met halfronde apsis en een toren van twee geledingen met omloop en achtkantige lantaarn met uivormige spits. De in de stijl van de Delftse School gebouwde kerk verrees in 1949-'50 naar ontwerp van G.M. Leeuwenberg ter vervanging van een in 1943-'44 verwoeste laat-gotische voorganger. De toren en de apsis kwamen in 1961 gereed. De kerk bezit een door Albert Hachman gegoten klok (1559) en een door de gebroeders Van Trier gegoten klok (1652). Tot de inventaris behoort een preekstoel uit 1656. J. Colette vervaardigde de gebrandschilderde ramen (circa 1950)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01048> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen"@nl ;
        min:adres "Pastoor van Wijkstraat 33",
            "Pastoor van Wijkstraat 35" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1048 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Huissen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "De R.K. kerk van de Heilige Martelaren van Gorcum (Pastoor van Wijkstraat 33) is een driebeukige basiliek met vijfzijdig gesloten koor en een ingebouwde toren van drie geledingen met ingesnoerd tentdak. De in traditionalistische vormen uitgevoerde kerk kwam in 1952-'53 tot stand naar ontwerp van H.W. Valk (met medewerking van G.H.F. Valk) ter vervanging van een in 1944 verwoeste voorganger uit 1925-'26. De gebrandschilderde ramen zijn van D. Wildschut. De pastorie (Pastoor van Wijkstraat 35) dateert uit 1925."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01049> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Huissen – Woonhuizen"@nl ;
        min:adres "Korte Kerkstraat 2",
            "Vicariestraat 1",
            "Vierakkerstraat 39" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lingewaard" ;
        min:gemeenteInBoek "Huissen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lingewaard> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Huissen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Huissen" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1049 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0119> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text """Woonhuizen. Het dwarse huis De Kluut (Korte Kerkstraat 2) dateert mogelijk uit de 16de eeuw. Het diepe huis Langestraat 17 werd circa 1560 gebouwd en is in 1954 ingrijpend gerestaureerd naar plannen van Y. Kok. De voorgevel heeft gebeeldhouwde koppen en medaillons in de boogvelden. Een mogelijk uit 1647 daterende gezamenlijke kern hebben de huizen Vierakkerstraat 35-37 en Hof van Hessen (Vierakkerstraat 39). De laatste heeft een gepleisterde eclectische voorgevel uit circa 1860. Het dubbele woonhuis Maria-Vicariestraat 3-5 uit 1923 vertoont kenmerken van het rationalisme. De woningen Arnhemse Poort 67-75 en Walstraat 47 zijn gebouwd in 1937 naar een ontwerp van J.C. Berendsen in traditionalistische vormen. De Oude Vicarie (Vicariestraat 1) is een wit geschilderde voorm. notariswoning met koetshuis, gebouwd in 1949 naar een ontwerp van A.M. de Rouville de Meux in de vormen van de Delftse School.

De boerderij Gochsestraat 7, een gepleisterde krukhuisboerderij met kleine tabaksschuur, dateert uit de tweede helft van de 19de eeuw, maar heeft waarschijnlijk een oudere kern."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0119.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01050> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hulshorst (gemeente Nunspeet)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Nunspeet" ;
        min:gemeenteInBoek "Nunspeet" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nunspeet_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
