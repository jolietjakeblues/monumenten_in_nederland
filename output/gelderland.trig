        min:soort "inleiding" ;
        min:volgnummer 1083 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0126> ;
        schema:name "Kerkdriel (gemeente Maasdriel)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "De voorm. Chr. lagere school (Teisterbandstraat 40) is in 1893 gebouwd met chaletstijl-elementen en een torenvormige ingangspartij met klokkenstoel. Het linker bouwdeel was de onderwijzerswoning; in het haakse rechter bouwdeel bevonden zich de lokalen. De uitbreiding aan de achterzijde kwam in 1923 tot stand naar plannen van H.A. Pothoven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01084> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kerkdriel (gemeente Maasdriel)"@nl ;
        min:adres "Kerkstraat 18-20" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
