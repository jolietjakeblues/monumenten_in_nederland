        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "De voorm. (Herv.) Gemeentewoning Epe (Stationsstraat 23-25) is een U-vormig eenlaags gemeenschapshuis, gesticht in 1911 door dominee Prins en gebouwd in late neorenaissancestijl naar ontwerp van J.J., M.A. en J. van Nieukerken."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0077.php> .

