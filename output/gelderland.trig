        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0150> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "232" ;
        schema:pageStart "232" ;
        schema:pagination "232" ;
        schema:text "Windmolen ‘De Maasmolen’ (Molenweg 1) is een gesloten standerdmolen met achtkantige stenen onderbouw en een houten kast. De in 1741 gebouwde korenmolen is in 1972-'73 in westelijke richting verplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0150.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01239> a min:Passage,
