        schema:pageStart "228" ;
        schema:pagination "228" ;
        schema:text "Woonhuizen. Het neoclassicistische woonhuis Loostraat 17 dateert uit 1875. De forse villa Loostraat 6 uit circa 1915 vertoont in het materiaalgebruik late, sobere jugendstil-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0142.php> .

