        schema:pageEnd "113" ;
        schema:pageStart "113" ;
        schema:pagination "113" ;
        schema:text "Boekelo (Achterstraat 2). Dit voorm. edelmanshuis wordt in 1564 voor het eerst vermeld. Begin 17de eeuw kreeg het een eenlaags voorhuis en in de 19de eeuw heeft men het als boerderij ingericht. Het gebouw is gerestaureerd in 1949."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0033.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00438> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bennekom (gemeente Ede) – Woonhuizen"@nl ;
        min:adres "Bovenweg 29",
            "Edeseweg 110-112",
            "Edeseweg 117",
            "Edeseweg 26-26a",
            "Edeseweg 36",
            "Edeseweg 51",
            "Edeseweg 57",
            "Heelsumseweg 20",
            "Heelsumseweg 3",
            "Heelsumseweg 39" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Ede" ;
