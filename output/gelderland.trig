        schema:name "Elspeet (gemeente Nunspeet)"@nl ;
        schema:pageEnd "167" ;
        schema:pageStart "167" ;
        schema:pagination "167" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op de Veluwse zandgronden. Het gave kernesdorp is een beschermd dorpsgezicht. Elspeet is recent naar het oosten uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0074.php> .

