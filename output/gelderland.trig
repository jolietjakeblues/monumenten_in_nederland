        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill378> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Woonhuizen. Het gepleisterde blokvormige huis Het Hof (Lingedijk 80) kreeg zijn huidige vorm rond 1910, maar heeft mogelijk een oudere kern. De villa Flandria (Lingedijk 103) is rond 1930 gebouwd met overstekende dakschilden en een baksteendetaillering."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01566> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tricht (gemeente Geldermalsen) – Boerderijen"@nl ;
        min:adres "Meersteeg 51",
            "Meersteeg 53" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Tricht (gemeente Geldermalsen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Tricht" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1566 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0197> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "301" ;
        schema:pageStart "301" ;
        schema:pagination "301" ;
        schema:text "Boerderijen. De gepleisterde hallenhuisboerderij Bulkstraat 14 stamt uit de 17de eeuw. Hallenhuisboerderijen met dwars voorhuis zijn: Bulkstraat 12 (17de of 18de eeuw), Lingedijk 158-160 (1863) en Bulkstraat 20 (circa 1910). De krukhuisboerderij Bulkstraat 1 kreeg zijn huidige vorm in de tweede helft van de 19de eeuw, maar heeft een oudere kern. Ten noordoosten van Tricht liggen op een terp de boerderijen Reygersfoort (Meersteeg 53), bestaande uit een laat-18de-eeuws voorhuis met aangebouwd bakhuis, en Arkelshoef (Meersteeg 51) met een uit 1889 daterend tweelaags dwars voorhuis met smal achterhuis en grote aangebouwde bijschuur. Op het erf staan een vloedschuur en een schuurberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0197.php> .

