        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Groot Bylaer (Groot Bielderweg 3) is een landhuis op T-vormige plattegrond, gebouwd rond 1935 naar ontwerp van Van Marwijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0193.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01533> a min:Passage,
