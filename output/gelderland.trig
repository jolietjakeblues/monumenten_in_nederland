        schema:name "Geldermalsen"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De R.K. St.-Suitbertuskerk (Stationsweg 11) is een zaalkerk met houten klokkenstoel, gebouwd in 1949-'51 naar ontwerp van C.H.B. Dionisius. De gelijktijdig gebouwde pastorie (Stationsweg 9) is via een tussenlid met de kerk verbonden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0085.php> .

