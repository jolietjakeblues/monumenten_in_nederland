        min:adres "Grotestraat 13",
            "Grotestraat 15",
            "Kweldam 38",
            "Munnikhofsestraat 33",
            "Van Heemstraweg 2a" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Afferden (gemeente Druten)" ;
