        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boven-Leeuwen (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Boven-Leeuwen" ;
        min:lemma "Huis te Leeuwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/10158> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38244" ;
        min:soort "lemma" ;
        min:volgnummer 482 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0039> ;
        schema:name "Huis te Leeuwen"@nl ;
        schema:pageEnd "119" ;
        schema:pageStart "119" ;
        schema:pagination "119" ;
        schema:text "Huis te Leeuwen (Waalbandijk 7). Van dit in 1819 gesloopte, uit de middeleeuwen stammende huis resteert op een omgracht terrein het via een bakstenen boogbrug bereikbare poortgebouw. Het is gebouwd in 1654 als onderdeel van een in opdracht van Assuerus van Boetzelaer en Johanna Altea van Flodorf uitgevoerde uitbreiding van het middeleeuwse huis. De namen van de opdrachtgevers staan onder een afgekapt wapenschild in het tympaan van de classicistische ingang. In de eerste helft van de 19de eeuw is het gepleisterde poortgebouw gewijzigd in een boerderij met dwarsgeplaatst voorhuis, waarbij het bedrijfsgedeelte op het oude voorplein werd gesitueerd. Het klokkenkoepeltje op het voorhuis is waarschijnlijk ook 19de-eeuws."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0039.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00483> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Boven-Leeuwen (gemeente West Maas & Waal) – Boerderijen"@nl ;
        min:adres "Waalbandijk 5" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boven-Leeuwen (gemeente West Maas & Waal)" ;
