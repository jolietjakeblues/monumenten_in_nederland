        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill282> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0143> ;
        schema:name "De Bruinhorst"@nl ;
        schema:pageEnd "229" ;
        schema:pageStart "228" ;
        schema:pagination "228-229" ;
        schema:text "De Bruinhorst (Luntersekade 1). Dit landhuis, gelegen bij het dorp Ederveen ten zuidwesten van Lunteren, verrees in 1879 voor mw. Reiger op de plaats van een ouder huis. Het eclectische landhuis heeft een driezijdig uitgebouwde erker en een dakruiter, die dateert van de verbouwing in 1910 voor H.A.J. Hafmans."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0143.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01198> a min:Passage,
