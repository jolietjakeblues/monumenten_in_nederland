        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Het logement ‘Dorpszicht’ (Dorpsstraat 10) is een logement annex stalling uit circa 1905. Het gebouw vertoont jugendstil-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01341> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oene (gemeente Epe) – Boerderijen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Epe" ;
        min:gemeenteInBoek "Epe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Epe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oene (gemeente Epe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oene" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1341 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0160> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Boerderijen. In en rond het dorp liggen diverse 19de-eeuwse hallenhuisboerderijen, zoals Ooster Oenerweg 17 (circa 1800) en IJsseldijk 8 (1844). De laatste heeft in het dwarse voorhuis twee betegelde kamers uit de bouwtijd. De uit de eerste helft van de 19de eeuw daterende hallenhuisboerderij Eperweg 14 heeft een monumentaal dwars voorhuis met spitsboogvensters. Andere interessante hallenhuisboerderijen met dwars voorhuis zijn Middelbeekseallee 1 (circa 1840) en Houtweg 2 (1860)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0160.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01342> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldebroek"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Oldebroek" ;
        min:gemeenteInBoek "Oldebroek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldebroek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldebroek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oldebroek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1342 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0161> ;
        schema:name "Oldebroek"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "Dorp, oorspronkelijk ook Hollanderbroek genoemd, ontstaan in de hoge middeleeuwen met twee ten opzichte van elkaar verschoven ontginningsassen, die sinds 1825 deel uitmaken van de Zuiderzeestraatweg. De bebouwing van dit streekdorp verdichtte zich vanaf de 19de eeuw bij de Herv. kerk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01343> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldebroek"@nl ;
        min:adres "Zuiderzeestraatweg 106" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Oldebroek" ;
        min:gemeenteInBoek "Oldebroek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Oldebroek_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oldebroek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oldebroek" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/45898> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "31377" ;
        min:soort "inleiding" ;
        min:volgnummer 1343 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0161> ;
        schema:name "Oldebroek"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text "De Herv. kerk (Zuiderzeestraatweg 106), oorspronkelijk gewijd aan St. Lambertus, heeft een kruisvormig schip, een driezijdig gesloten koor met aangebouwde sacristie en een ingebouwde toren van drie geledingen met ingesnoerde spits en open achtkant. De toren stamt waarschijnlijk uit de 14de eeuw en wordt geflankeerd door schiptraveeën uit de eerste helft van de 16de eeuw. Het laatgotische koor kwam in de 15de eeuw tot stand. In 1866 verving men het 15de-eeuwse driebeukige schip door een noord-zuid-gerichte zaalvormige kerkruimte met rondboogvensters. De kerk is in 1965-'66 gerestaureerd. Het koor wordt gedekt door kruisribgewelven met een ornamentele beschildering uit 1497. Tot de inventaris behoren een midden-17de-eeuwse preekstoel en enkele 17de-eeuwse zerken, waaronder die voor Arnolda van Furstenberch (circa 1600) en haar broer Arnt (†1605)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01344> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldebroek"@nl ;
        min:adres "Zuiderzeestraat 276" ;
