        min:soort "inleiding" ;
        min:volgnummer 781 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0076> ;
        schema:name "Enspijk (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "169" ;
        schema:pageStart "169" ;
        schema:pagination "169" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Haaks op de dijk langs de Linge kwam een rond esdorp tot ontwikkeling."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0076.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00782> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Enspijk (gemeente Geldermalsen)"@nl ;
        min:adres "Molenkampstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
