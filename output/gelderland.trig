        min:adres "Gen. Foulkesweg 106",
            "Harnjesweg 54",
            "Molenstraat 6",
            "Pabstsendam 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Wageningen" ;
        min:gemeenteInBoek "Wageningen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Wageningen_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wageningen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
