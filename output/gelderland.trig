        schema:name "Horeca"@nl ;
        schema:pageEnd "303" ;
        schema:pageStart "303" ;
        schema:pagination "303" ;
        schema:text "Horeca. Het Hotel Van Enter (Dorpsstraat 12) is een neoclassicistisch pand met omlijste ingang uit circa 1840. De serre met opbouw is in 1929 toegevoegd. Het in 1904 opgetrokken stationskoffiehuis (Stationsstraat 31) is een eenlaagspand met jugendstil- en chaletstijl-details, gebouwd voor en door J. te Wechel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0198.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01579> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Twello (gemeente Voorst) – Boerderijen"@nl ;
        min:adres "Kerklaan 8",
            "Oude Wezeveldseweg 18" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Twello (gemeente Voorst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Twello" ;
