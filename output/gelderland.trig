        schema:name "Hoenderloo (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De Herv. kerk (Heldringsweg 10) is een gepleisterde zaalkerk uit 1857 met geveltoren en aangebouwde consistoriekamer. Het gebouw heeft spitsboogvensters met gietijzeren traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01024> a min:Passage,
            schema:CreativeWork ;
