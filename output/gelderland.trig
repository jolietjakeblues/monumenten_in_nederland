        schema:name "Slijk-Ewijk (gemeente Valburg)"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text "Het woonhuis Dorpsstraat 37 is in 1896 gebouwd als dokterswoning met aangebouwd koetshuis en uitgevoerd met gepleisterde speklagen en chaletstijlelementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0187.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01499> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Slijk-Ewijk (gemeente Valburg) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 66" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Overbetuwe" ;
        min:gemeenteInBoek "Valburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Overbetuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Slijk-Ewijk (gemeente Valburg)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Slijk-Ewijk" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1499 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0187> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "290" ;
        schema:pageStart "290" ;
        schema:pagination "290" ;
        schema:text """Boerderijen. De gepleisterde hallenhuisboerderij Waaldijk 13 stamt uit de 17de eeuw. Op een huisterp ligt de boerderij Oosterhoutsestraat 5. Het brede gepleisterde voorhuis met opkamer en lage verdieping is rond 1855 gebouwd. Het U-vormige achterhuis stamt uit 1929 en is ontworpen door J. van Stralen. De hallenhuisboerderij Dorpsstraat 45 uit 1910 is voorzien van speklagen.

De voorm. tabaksdrogerij (Dorpsstraat 66) dateert uit circa 1875. Het drielaags pand heeft een flauwhellend zadeldak, getoogde vensters en luiken en een jonger achterhuis."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0187.php> .

