        min:soort "inleiding" ;
        min:volgnummer 1082 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0126> ;
        schema:name "Kerkdriel (gemeente Maasdriel)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "Het voorm. raadhuis (Mgr. Zwijsenplein 2) is gebouwd in 1887-'88 naar ontwerp van D. Semmelink. Het rijk gedecoreerde neorenaissance-gebouw heeft een souterrain en een dubbele bordestrap en wordt bekroond door een klokkentoren met ui-vormige bekroning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01083> a min:Passage,
