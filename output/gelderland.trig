        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 394 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Beek (gemeente Ubbergen)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op de grens van een stuwwal en de Ooijpolder. Het agrarische dorp ontwikkelde zich vanaf circa 1820 tot een langgerekt villadorp. Na de Tweede Wereldoorlog is Beek in noordelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00395> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen)"@nl ;
        min:adres "Nieuwe Holleweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 395 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Beek (gemeente Ubbergen)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "De (Herv./Geref.) Bartholomeuskerk (Nieuwe Holleweg 2) is een eenbeukige kerk met driezijdig gesloten koor en een toren van twee geledingen met tentdak. De toren heeft een mogelijk 11de-eeuwse tufstenen onderbouw. De bovenbouw van de toren en het huidige schip en koor dateren uit circa 1650. Bij de restauratie in 1906-'09, naar plannen van F.A. Ludewig, is de huidige koorsluiting met consistorie toegevoegd. Na de Tweede Wereldoorlog is de oorlogsschade in 1948-'50 hersteld onder leiding van G. Feenstra."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00396> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen)"@nl ;
        min:adres "Kerkweg 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 396 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Beek (gemeente Ubbergen)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "De R.K. St.-Bartholomeuskerk (Kerkweg 1) is een driebeukige kerk met pseudotransept en een halfrond gesloten koor met omgang en koortoren. De oorspronkelijke, driebeukige neoclassicistische kerk uit 1825-'26 werd in 1891-'92 naar ontwerp van J. Kayser vergroot tot een vierbeukige kerk met pseudotransept in neorenaissance-stijl. In 1952 heeft men de twee middenbeuken naar plannen van B.W.A. Goddijn samengetrokken en voorzien van een vlak casettenplafond en een nieuw portaal. Tot de inventaris behoren een door H.D. Lindsen gebouwd orgel (1830) en van de gebroeders Goossens een neobarok hoofdaltaar (1852) en een rijke neobarokke preekstoel (1878-'80). Verder zijn er twee neorenaissance-altaren naar ontwerp van J. Kayser (1892 en 1893)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00397> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen)"@nl ;
        min:adres "De Geest 3",
            "Rijksstraatweg 139-141" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 397 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Beek (gemeente Ubbergen)"@nl ;
        schema:pageEnd "107" ;
        schema:pageStart "107" ;
        schema:pagination "107" ;
        schema:text "Het voorm. patronaatsgebouw ‘St. Antonius’ (De Geest 3), thans cultureel centrum ‘De Vluchtheuvel’, is in 1910 gebouwd met jugendstil-invloeden. Het raadhuis (Rijksstraatweg 139-141) werd in 1867-'68 in eclectische vormen gebouwd, waarschijnlijk naar ontwerp van J.P.W. Bieling. In 1904-'05 is het naar ontwerp van F.A. Ludewig vergroot en nog eens in 1994-'95 naar plannen van K. Brand."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00398> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen) – Woonhuizen"@nl ;
        min:adres "Elzenweg bij 22",
            "Nieuwe Holleweg 59",
            "Rijksstraatweg 107",
            "Rijksstraatweg 110",
            "Rijksstraatweg 115",
            "Rijksstraatweg 117",
            "Rijksstraatweg 123",
            "Rijksstraatweg 128b",
            "Rijksstraatweg 177",
            "Rijksstraatweg 178",
            "Rijksstraatweg 72",
            "Rijksstraatweg 85",
            "Rijksstraatweg 98",
            "Van Randwijckweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:lemma "Woonhuizen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 398 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill119>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill120> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "107" ;
        schema:pagination "107-108" ;
        schema:text """Woonhuizen. Aan weerszijden van de Rijksstraatweg staan 19de- en vroeg 20ste-eeuwse villa's in diverse stijlen. Zij vormen een aaneengesloten reeks met de villa's langs de Rijksstraatweg in Ubbergen. Uit de eerste helft van de 19de eeuw dateren de gepleisterde villa's Rijksstraatweg 81 en Huis Lindenhof (Rijksstraatweg 177; circa 1835); de laatste met souterrain, veranda met gietijzeren zuiltjes en bordestrap. Uit circa 1850 dateren de gepleisterde villa's Rijksstraatweg 95, met souterrain en serre, en Pietersberg (Rijksstraatweg 98), met verhoogd middengedeelte en gietijzeren veranda. Hoog tegen de heuvelflank - in de zichtas van de Rijksstraatweg - ligt de gepleisterde eclectische villa Westerbeek (Rijksstraatweg 110) uit 1868, voorzien van een balkon op gietijzeren zuiltjes. De villa werd gebouwd in opdracht van jhr. F.A.J. Dommer van Poldersveldt, burgemeester van Ubbergen. Andere eclectische villa's zijn de gepleisterde voorm. dokterswoning Mignon (Rijksstraatweg 123; circa 1875), de in opdracht van H.F.G. van Haaren gebouwde voorm. rentmeesterswoning Wilhelmina (Rijksstraatweg 115; 1881), de villa Rijksstraatweg 120 (circa 1890), het voor W. Braicks gebouwde eenlaagspand Stern Eck (Rijksstraatweg 85; 1899-1900), de villa Rijksstraatweg 122 (circa 1905) en de voor chocoladefabrikant J.A. van den Dungen gebouwde villa Klein Hondsbeek (Rijksstraatweg 117; 1911). Chaletstijl-elementen vertoont de rond 1895 opgetrokken Villa Maria (Rijksstraatweg 107) en in neorenaissance-stijl uitgevoerd is Rijksstraatweg 73, een woonhuis met bedrijfsruimte uit circa 1900. Jugendstilelementen zijn herkenbaar bij Bosweg 31, een villa uit 1898 naar ontwerp van D. Semmelink, en de villa Margot (Rijksstraatweg 72) uit 1901, met een door O. Leeuw ontworpen façade. Op een terrein dat tot 1945 Duits grondgebied was, liet mw. M. Schuster-Hibi in 1921-'24 de villa De Wylerberg (Rijksstraatweg 178) bouwen naar ontwerp van de Duitse architect O. Bartning in een Duits-expressionistische stijl. De gepleisterde villa heeft een centraal vierkant met rechthoekige, driezijdige en trapeziumvormige uitbouwen. In de polygonale muziekzaal werden concerten georganiseerd en kwamen kunstenaars bijeen.

De voorm. wasserij ‘De Elzen’ (Nieuwe Holleweg 59) uit circa 1885 is een restant van de vele blekerijen en wasserijen die bij Beek ontstonden vanwege de aanwezigheid van helder beekwater. Het zogeheten Salmhuisje (Elzenweg bij 22) is een voorm. privé-tramhuisje in Zwitserse chaletstijl, opgetrokken rond 1885 naar ontwerp van A. Salm voor C.J.J. Schmitz. Het kleine houten gebouw met veranda stond tot 1929 in Berg en Dal en behoorde daar bij de villa Stollenberg.

Het voorm. onderstation van de bergspoortram (Van Randwijckweg 2), die via de Van Randwijckweg de stuwwal naar Berg en Dal opging, is in 1912 met jugendstil-kenmerken gebouwd. Oorspronkelijk had het een wachtkamer en twee machinekamers.

Het ANWB douane-informatiebureau (Rijksstraatweg 128b) is een kiosk uit 1938, gebouwd naar ontwerp van B. Schultheiss in de stijl van het functionalisme. Het deels gepleisterde, tegen een keermuur gelegen, toeristische informatiekantoortje ligt vlak bij de toenmalige grens met Duitsland."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00399> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen) – Persingen"@nl ;
        min:adres "Leuthsestraat 8",
            "Persingensestraat 7",
            "Persingensestraat 9-11",
            "Thornsestraat 18" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Ubbergen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Ubbergen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:lemma "Persingen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 399 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0028> ;
        schema:name "Persingen"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Persingen. Dit gehucht ten noorden van Beek is ontstaan in de vroege middeleeuwen op een stroomrug. De 15de-eeuwse R.K. St.-Joriskapel (Persingensestraat 7), oorspronkelijk gewijd aan St. Dionysius, is een eenbeukige kapel met hoger, driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. Het interieur wordt gedekt door een vlakke houten zoldering (schip) en een kruisribgewelf (koor). Aan de zuidzijde heeft men de 17de-eeuwse sacristie in 1996 herbouwd. Het gebouw is in 1952-'54 onder leiding van J.G. Deur gerestaureerd, waarna het door de R.K. Verkennersvereniging in gebruik is genomen. De voorm. herberg ‘De Bonte Os’ (Persingensestraat 9-11) is een gepleisterde 18de-eeuwse hallenhuisboerderij met dwars voorhuis. De schuur is in 1809 na een dijkdoorbraak herbouwd. Boerderij ‘Brökske’ (Leuthsestraat 8), gelegen ten noordoosten van Persingen, is een gepleisterde, mogelijk 18de-eeuwse, krukhuisboerderij. Het ten oosten van Persingen gelegen trafohuisje (tegenover Thornsestraat 18) dateert uit 1930. Vanwege het grote gevaar voor overstromingen werd het gebouwd op een verhoogde onderbouw met poortvormige doorgang, waardoor het een torenachtige vorm heeft."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0028.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00400> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beekbergen (gemeente Apeldoorn)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Apeldoorn" ;
        min:gemeenteInBoek "Apeldoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beekbergen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beekbergen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 400 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Esdorp, ontstaan op de oostflank van de Veluwestuwwal. Eind 11de eeuw werd hier een kerk gesticht. In de 19de eeuw kende Beekbergen een bescheiden groei. Na de aanleg van de spoorlijn Apeldoorn-Dieren (1886) kwam bij het op enige afstand van het dorp gelegen station Beekbergen het dorp Lieren tot ontwikkeling. De bebouwing van beide dorpen is sindsdien geleidelijk verdicht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00401> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beekbergen (gemeente Apeldoorn)"@nl ;
        min:adres "Dorpstraat 35" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Apeldoorn" ;
        min:gemeenteInBoek "Apeldoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beekbergen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beekbergen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 401 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "De Herv. kerk (Dorpstraat 35), oorspronkelijk gewijd aan St. Fabianus en St. Sebastianus, is een driebeukige pseudobasilicale kerk met driezijdig gesloten koor en een toren van drie geledingen met balustrade en korte, ingesnoerde spits. De vroeg-gotische kerktoren verrees in de 13de eeuw, waarbij tufsteen van een laat-11de-eeuwse romaanse voorganger opnieuw werd gebruikt. Aan het eind van de 15de eeuw heeft men de toren verhoogd. De huidige spits met balustrade en hoektorentjes dateert uit 1867. In de toren hangt een door Henrick Wegewaert gegoten klok (1616). Het driebeukige schip kwam in de 15de eeuw in twee bouwfasen tot stand. Het middenschip bevat een restant van het gotische koor dat begin 14de eeuw werd gebouwd ter vervanging van een romaans koor. Het huidige laat-gotische koor verrees begin 16de eeuw. De kerk onderging rond 1676 en in 1843 enige wijzigingen en is in 1905-'07 en in 1968-'70 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00402> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beekbergen (gemeente Apeldoorn)"@nl ;
        min:adres "Dorpsstraat 33" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Apeldoorn" ;
        min:gemeenteInBoek "Apeldoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beekbergen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beekbergen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 402 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Het interieur wordt gedekt door een netgewelf (koor) en kruisribgewelven op gebeeldhouwde kraagstenen. Op het restant van het gotische koor bevinden zich enkele 15de-eeuwse muurschilderingen met het Laatste Oordeel; het koorgewelf heeft ornamentschilderingen uit circa 1540. De kerk bevat enkele oude grafzerken waaronder die van papiermaker Marten Orges (†1627). De preekstoel uit 1842 is door H. Bauer vervaardigd. Het orgel, in 1779-'80 door J. Schilling gebouwd en in 1828 door C.F.A. Naber uitgebreid, is afkomstig van de in 1843 gesloopte oude dorpskerk van Apeldoorn. De pastorie (Dorpsstraat 33) is een blokvormig neoclassicistisch pand uit circa 1880."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00403> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beekbergen (gemeente Apeldoorn)"@nl ;
        min:adres "Lierderstraat 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Apeldoorn" ;
        min:gemeenteInBoek "Apeldoorn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beekbergen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beekbergen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 403 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "De Geref. kerk (Lierderstraat 7, Lieren) is een zaalkerk voorzien van een ongelede toren met vierzijdige spits, gebouwd in 1933 met expressionistische details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00404> a min:Passage,
