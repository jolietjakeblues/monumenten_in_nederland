        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almen (gemeente Gorssel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Almen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 253 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0013> ;
        schema:name "Almen (gemeente Gorssel)"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "Het voorm. P.W. Janssenziekenhuis (Ehzerallee 14) is in 1914-'15 gebouwd als ziekeninrichting op homeopathische grondslag voor particuliere patiënten. Het forse, door K. van Nes ontworpen gebouw staat op de plaats van de 18de-eeuwse buitenplaats De Hoogenkamp, waarvan delen van de geometrische Franse tuin bewaard zijn gebleven. Na vanaf 1921 als sanatorium dienst te hebben gedaan, huisvest het sinds enige jaren een instelling met de naam ‘Landgoed Ezerwold’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00254> a min:Passage,
