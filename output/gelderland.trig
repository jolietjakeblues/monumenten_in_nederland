            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34610>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67777>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67778> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "32217",
            "523967",
