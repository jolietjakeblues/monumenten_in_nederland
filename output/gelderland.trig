        schema:pageStart "220" ;
        schema:pagination "220" ;
        schema:text "De Geref. kerk (Nieuwe Maat 9) is een zaalkerk uit 1933, gebouwd naar een expressionistisch ontwerp van H.J. Wikkerink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0137.php> .

