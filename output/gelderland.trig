        min:gemeenteInBoek "Maasdriel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasdriel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Kerkdriel (gemeente Maasdriel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Kerkdriel" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1081 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill257>,
            <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill258> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0126> ;
        schema:name "Kerkdriel (gemeente Maasdriel)"@nl ;
        schema:pageEnd "211" ;
        schema:pageStart "211" ;
        schema:pagination "211" ;
        schema:text "De R.K. St.-Martinuskerk (Kerkstraat ong.) is een pseudobasiliek met halfronde apsis, voorhal, terzijde geplaatste achthoekige doopkapel en een vrijstaande klokkentoren. De kerk kwam in 1953-'55 tot stand ter vervanging van een kerk uit 1829. Het ontwerp in traditionalistische stijl van J. Deur en C. Pouderoyen is geïnspireerd op Byzantijnse vormen. De voorm pastorie (Kerkstraat 41) is een dwars huis uit circa 1830 met jonger achterhuis. Op het zadeldak staat een dakruiter."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0126.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01082> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Kerkdriel (gemeente Maasdriel)"@nl ;
        min:adres "Mgr. Zwijsenplein 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Maasdriel" ;
        min:gemeenteInBoek "Maasdriel" ;
