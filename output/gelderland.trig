        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/14917> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523919" ;
        min:soort "lemma" ;
        min:volgnummer 1372 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0164> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "Woonhuizen. De in 1909 opgetrokken villa Dorpsstraat 52 is voorzien van imitatie-vakwerk. De voorm. hoofdonderwijzerswoning Dorpsstraat 2 uit circa 1918 heeft een tentdak met dwarskap en siermetselwerk. De gepleisterde arbeiderswoningen De Hoge Wik (Oosterhoutseweg 59-73) - vier blokjes van twee onder één kap - zijn rond 1920 gebouwd. Het ontwerp van J. Schaars vertoont elementen van expressionisme en cottagestijl. Heureka (Dorpsstraat 42) is een Noors houten prefab-huis met zwart geschilderde verspringende bouwdelen, voor het eerst opgebouwd in 1920 in Elst. In 1923 is het huis naar Oosterhout verplaatst, waar het in de jaren dertig in aangepaste stijl is vergroot."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01373> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterhout (gemeente Valburg) – Boerderijen"@nl ;
        min:adres "Dorpsstraat 19",
            "Peperstraat 54" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Overbetuwe" ;
        min:gemeenteInBoek "Valburg" ;
