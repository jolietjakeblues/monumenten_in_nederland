        min:adres "Hogenkampseweg 10",
            "Hogenkampsweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Gorssel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Almen (gemeente Gorssel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Almen" ;
        min:lemma "De Ehze" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 254 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill68> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0013> ;
        schema:name "De Ehze"@nl ;
        schema:pageEnd "65" ;
        schema:pageStart "65" ;
        schema:pagination "65" ;
        schema:text "De Ehze (Hogenkampsweg 2) is een rond 1300 ontstane havezate. Van het in 1647 herbouwde en in 1830 grotendeels gesloopte huis resteren sinds de verdere afbraak in 1917 enkel de kelders. Daarop liet D.J van den Honert in 1918 een forse nieuwe villa bouwen in Engelse landhuisstijl met ‘Um 1800’-elementen, naar plannen van A.J. Jansen. De parkaanleg kwam in 1835 tot stand naar plannen van J.D. Zocher in opdracht van A. baron van Zuylen van Nyevelt. Het houten zomerhuis Rust Roest (Hogenkampseweg 10) stamt uit circa 1900."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0013.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00255> a min:Passage,
