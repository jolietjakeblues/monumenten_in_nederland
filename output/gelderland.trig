        schema:pageEnd "334" ;
        schema:pageStart "334" ;
        schema:pagination "334" ;
        schema:text "Groot Noordijk (H.W. Iordensweg 108), gelegen ten westen van Wilp, is een landhuis met empire-details, gebouwd in 1807 voor H.W. van Marle. Het huis kreeg in 1890 een veranda en werd in 1923 verdubbeld door toevoeging van een tweede beuk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0226.php> .

