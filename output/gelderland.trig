        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heumen" ;
        min:gemeenteInBoek "Heumen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Heumen_(gemeente)> ;
