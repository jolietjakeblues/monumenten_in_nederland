        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Boven-Leeuwen (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Boven-Leeuwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51237> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38245" ;
        min:soort "inleiding" ;
        min:volgnummer 479 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0039> ;
        schema:name "Boven-Leeuwen (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "118" ;
        schema:pageStart "118" ;
        schema:pagination "118" ;
        schema:text "De Herv. kerk (Waalbandijk 21) is een kleine achthoekige centraalbouw met tentdak, voorzien van een open klokkentoren met klokvormige helm. Het classicistische gebouw verrees in 1753-'56. Tijdens een restauratie in 1964-'66, onder leiding van H. Korswagen, heeft men met oud materiaal een consistorie toegevoegd. Het interieur wordt gedekt door een gedrukte, achtzijdige houten koepel. Tot de inventaris uit de bouwtijd behoren onder meer een preekstoel met het wapen van W. van Balveren, een doophek en een stichtingssteen uit 1753 met de wapens van C. van Coeverden en G. van Riemsdyk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0039.php> .

