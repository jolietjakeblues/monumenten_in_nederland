        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Asperen (gemeente Lingewaal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Asperen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 357 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0021> ;
        schema:name "Asperen (gemeente Lingewaal)"@nl ;
        schema:pageEnd "101" ;
        schema:pageStart "101" ;
        schema:pagination "101" ;
        schema:text "Kleine stad, ontstaan in de vroege middeleeuwen op een stroomrug. Na de verlening van stadsrechten in de 13de eeuw is de nederzetting omwald en later ommuurd, maar een echte stedelijke ontwikkeling heeft zich niet doorgezet. Asperen bezit de structuur van een gestrekt esdorp. Het middeleeuwse kasteel Asperen werd in 1672 door Franse troepen verwoest. Een stadsbrand in 1896 richtte grote schade aan. Na de Tweede Wereldoorlog is Asperen in noordelijke en westelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0021.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00358> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Asperen (gemeente Lingewaal)"@nl ;
