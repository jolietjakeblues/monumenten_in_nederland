        min:gemeenteInBoek "Bergh" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:lemma "De Bijvank" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 393 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0027> ;
        schema:name "De Bijvank"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "De Bijvank (Bijvank 8), gelegen ten westen van Beek, is een voorm. havezate. Het huidige L-vormige huis met dakruiter stamt uit het eind van de 18de eeuw. Binnen bevindt zich een trap met Lodewijk XVI-balusters. Aan het begin van de oprijlaan staan twee 18de-eeuwse hekpijlers, waarvan één met marmeren medaillon."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00394> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Ubbergen)"@nl ;
