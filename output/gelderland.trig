        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vaassen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1600 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill383> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0202> ;
        schema:name "Vaassen (gemeente Epe)"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op een noord-zuid lopende zandrug. Vanaf 1850 vond verdichting van de bebouwing langs de Dorpsstraat plaats. Rond de buitenplaats Oosterhof ontwikkelde zich in de 19de eeuw een katholieke enclave. Na de Tweede Wereldoorlog is het dorp in oostelijke en westelijke richting uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0202.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01601> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vaassen (gemeente Epe)"@nl ;
        min:adres "Kerkplein 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Epe" ;
        min:gemeenteInBoek "Epe" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Epe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vaassen (gemeente Epe)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vaassen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1601 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0202> ;
        schema:name "Vaassen (gemeente Epe)"@nl ;
        schema:pageEnd "306" ;
        schema:pageStart "306" ;
        schema:pagination "306" ;
        schema:text "De Herv. kerk (Kerkplein 7), oorspronkelijk gewijd aan St. Ursula, is een forse zaalkerk voorzien van een toren van drie geledingen met ingesnoerde naaldspits. De laat-gotische toren dateert uit circa 1500 en is in 1862 hersteld. In de toren hangt een door Geert van Wou gegoten klok (1501). De middeleeuwse kerk is in 1852 vervangen door de huidige zaalkerk met rijke gepleisterde ingangspartij in Willem II-gotiek. Bij de toren staat een uit circa 1900 daterend cathechisatielokaal, voorzien van spitsboogvensters met gietijzeren traceringen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0202.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01602> a min:Passage,
