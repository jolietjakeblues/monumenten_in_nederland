            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67198>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/67200> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "31380",
            "529076",
            "529078",
            "529081" ;
        min:soort "lemma" ;
        min:volgnummer 1761 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0224> ;
        schema:name "Buitenplaatsen"@nl ;
        schema:pageEnd "332" ;
        schema:pageStart "332" ;
        schema:pagination "332" ;
        schema:text "Buitenplaatsen. De kern van de buitenplaats IJsselvliedt (IJsselvliedtlaan 1) wordt gevormd door een blokvormig 18de-eeuws landhuis, dat in het midden van de 19de eeuw ingrijpend is verbouwd. Het ligt in een landschappelijk aangelegd park met slingervijvers. De voorm. tuinmanswoning (IJsselvliedtlaan 2) is een met riet gedekt eenlaagspand uit 1845 met een rijk uitgevoerde neogotische veranda. Aan de overzijde van de Zuiderzeestraatweg - in de voorm. overplaats - staat een vierkante, wit geschilderde duiventoren op palen. Het landgoed heeft nog het 18de-eeuwse lanenstelsel. De kleine buitenplaats Vogelenzang (Zuiderzeestraatweg 668) bezit een landschappelijk tuinaanleg. Het gepleisterde buitenhuis uit circa 1840 heeft een middenrisaliet tussen lisenen en merkwaardige smeedijzeren consoles onder de kroonlijst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0224.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01762> a min:Passage,
            schema:CreativeWork ;
