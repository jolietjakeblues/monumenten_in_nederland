        schema:name "Vorden"@nl ;
        schema:pageEnd "316" ;
        schema:pageStart "316" ;
        schema:pagination "316" ;
        schema:text "De Geref. kerk (Zutphenseweg 13) is een zaalkerk in traditionalistische vormen uit 1952, gebouwd naar plannen van Rijken en H. Abbink."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0212.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01675> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vorden"@nl ;
