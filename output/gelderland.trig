        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1458 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0181> ;
        schema:name "Rozendaal"@nl ;
        schema:pageEnd "283" ;
        schema:pageStart "283" ;
        schema:pagination "283" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op de zuidflank van de Veluwestuwwal bij kasteel Rosendael. Tot 1757 vormde het één kerkelijke gemeente met Velp. Door de verdeling van de marke in 1860 werd Rosendael het grootste landgoed van Nederland. Na de Tweede Wereldoorlog is het dorp aan de zuidzijde aan Velp vastgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0181.php> .

