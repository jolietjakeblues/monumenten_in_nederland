        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0008> ;
        schema:name "Aalten"@nl ;
        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "De (Geref.) Westerkerk (Hogestraat 54) is een neoclassicistische zaalkerk met kleine geveltoren, gebouwd in 1891 naar plannen van H. van den Brand en rond 1930 voorzien van een ingangsportaal."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00224> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aalten"@nl ;
        min:adres "Oosterkerkstraat 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
