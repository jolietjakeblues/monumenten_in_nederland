        min:kern "Neerijnen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/62296> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "30371" ;
        min:soort "inleiding" ;
        min:volgnummer 1259 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill291> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0154> ;
        schema:name "Neerijnen (gemeente Neerijnen)"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "234" ;
        schema:pagination "234-235" ;
        schema:text "De Herv. kerk (Van Pallandtweg 12) is een gepleisterde eenbeukige kruiskerk met recht gesloten koor, aangebouwde consistorie en een ingebouwde toren van twee geledingen met omgang en een klokkenverdieping met spits met frontalen. De kerk verrees in 1865 in de vormen van de Willem II-gotiek. Het interieur wordt gedekt door gestucte houten kruisribgewelven en een gestuct waaiergewelf (viering). De inventaris dateert uit 1868, waaronder een preekstoel in neo-Lodewijk XV-vormen en een door K.M. van Puffelen gebouwd orgel (gerestaureerd in 1982)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01260> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Neerijnen (gemeente Neerijnen) – Kasteel Neerijnen"@nl ;
        min:adres "Van Pallandtweg 11",
            "Van Pallandtweg 13-14" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Neerijnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Neerijnen (gemeente Neerijnen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Neerijnen" ;
        min:lemma "Kasteel Neerijnen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80113>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80114>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80115>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80116>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80117>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/80118> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "520223",
            "520245",
            "520246",
            "520247",
            "520248",
            "520249" ;
        min:soort "lemma" ;
        min:volgnummer 1260 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0154> ;
        schema:name "Kasteel Neerijnen"@nl ;
        schema:pageEnd "235" ;
        schema:pageStart "235" ;
        schema:pagination "235" ;
        schema:text """Kasteel Neerijnen (Van Pallandtweg 11) is een omgracht rechthoekig gebouw met schilddaken. Het oorspronkelijke kasteel, ook wel Clingelenburg genoemd, werd rond 1350 gesticht door Gijsbert de Cock. Nadat het in 1574 door troepen van Lodewijk van Nassau zwaar was beschadigd kwam begin 18de eeuw een nieuw huis tot stand. Het smalle middenrisaliet heeft een ingangsomlijsting in Lodewijk XV-vormen, met daarboven de wapens van Tjaard van Aylva en Margaretha van Gendt en een opschrift uit 1769 in Lodewijk XV-omlijsting betreffende jhr. Hobbe baron van Aylva. Het huis kreeg in 1791 de huidige vorm. Sinds 1980 is het kasteel als gemeentehuis in gebruik.

Bij het voorplein staat een langgerekt koetshuis. Vóór het huis strekt zich de in opzet 17de-eeuwse formele parkaanleg uit, waarin De Dreef de zichtas en oprijlaan naar de dijk vormt. In 1922-'23 is een deel van dit park gewijzigd in late Engelse landschapsstijl, naar ontwerp van L.A. Springer.

De voorm. openbare lagere school met onderwijzerswoning (Van Pallandtweg 13-14) bestaat uit een woongedeelte uit circa 1710 en haaks daarop de school uit 1848, die in 1905 is uitgebreid."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0154.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01261> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Neerijnen (gemeente Neerijnen) – Boerderijen"@nl ;
        min:adres "Van Pallandtweg 16" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Neerijnen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
