        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Zevenaar (gemeente Zevenaar)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oud-Zevenaar" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1398 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0170> ;
        schema:name "Oud-Zevenaar (gemeente Zevenaar)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Dorp, fraai gelegen in de bocht van de bandijk waarlangs tot het eind van de 16de eeuw de Oude Rijn stroomde. Nadat het economisch centrum zich in de 15de eeuw naar Zevenaar verlegde, bleef de ontwikkeling van Oud-Zevenaar beperkt."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01399> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Zevenaar (gemeente Zevenaar)"@nl ;
        min:adres "Kerkweg 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Zevenaar" ;
        min:gemeenteInBoek "Zevenaar" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Zevenaar_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Oud-Zevenaar (gemeente Zevenaar)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Oud-Zevenaar" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61237> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "40435" ;
        min:soort "inleiding" ;
        min:volgnummer 1399 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0170> ;
        schema:name "Oud-Zevenaar (gemeente Zevenaar)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De R.K. St.-Martinuskerk (Kerkweg 8) is een basilicale kerk met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De al in 1276 vermelde kerk is de moederkerk van die in Zevenaar. Toren, middenschip, noordbeuk en koor zijn alle in 1454-'64 gebouwd in laat-gotische vormen. De zuidbeuk werd begin 16de eeuw vernieuwd en verbreed om te dienen als ‘Mariakerk’ voor het aldaar vereerde midden-15de-eeuwse albasten Piëtabeeld (gestolen in 1975). Na een torenbrand in 1572 volgde in 1616 een algeheel herstel; de toren is ook in 1922-'23 hersteld. In 1865-'66 verbouwde men de oorspronkelijk pseudobasilicale kerk tot een basiliek. De 16de-eeuwse zuidbeuk maakte in 1906 plaats voor de huidige neogotische zuidbeuk naar plannen van J.Th.J. Cuypers en J. Stuyt. De noordbeuk kreeg in 1966 haar pseudobasilicale vorm terug."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0170.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01400> a min:Passage,
