        schema:pageEnd "172" ;
        schema:pageStart "172" ;
        schema:pagination "172" ;
        schema:text "Windmolen ‘De Witten’ (Oldenhove 5) is een ronde stenen beltmolen voorzien van een met dakleer gedekte houten kap. De korenmolen is in 1861 gebouwd voor J. Vos en in 1978 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0080.php> .

