        schema:name "Asperen (gemeente Lingewaal)"@nl ;
        schema:pageEnd "102" ;
        schema:pageStart "102" ;
        schema:pagination "102" ;
        schema:text "De Geref. kerk (Middelweg 5) is een recht gesloten zaalkerk met rondboogvensters, gebouwd in 1892. De pastorie (Middelweg 7) dateert uit 1912."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0021.php> .

