        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De villa Dorpsstraat 14 is in 1915 gebouwd als burgemeesterswoning naar ontwerp van J.H. Eichelsheim in een combinatie van ‘Um 1800’-vormen en jugendstil-details."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00451> a min:Passage,
            schema:CreativeWork ;
