        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/35668> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38333" ;
        min:soort "inleiding" ;
        min:volgnummer 1649 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0208> ;
        schema:name "Vierakker (gemeente Vorden)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "De R.K. St.-Willibrorduskerk (Vierakkersestraatweg 31) is een driebeukige neogotische hallenkerk met driezijdig gesloten koor en een toren van drie geledingen met slanke traptoren en ingesnoerde spits. De kerk verrees in 1868-'69 naar plannen van H.J. Wennekers in opdracht van A.A.J.C. baron van der Heyden. Tegen de zuidzijde staat een kapel met inwendig een zangkoor. Het interieur wordt gedekt door kruisribgewelven en heeft nog zijn originele polychromie (1881, C. Lindsen). De inventaris is gemaakt door het Bernulphusgilde; voornamelijk naar ontwerp van F.W. Mengelberg. Het orgel is in 1873 gebouwd door G. Elberink met een kast van atelier Mengelberg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0208.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01650> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Vierakker (gemeente Vorden)"@nl ;
        min:adres "Vierakkersestraatweg 29",
            "Vierakkersestraatweg 33",
            "Vierakkersestraatweg 37" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Vorden" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Vierakker (gemeente Vorden)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Vierakker" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1650 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0208> ;
        schema:name "Vierakker (gemeente Vorden)"@nl ;
        schema:pageEnd "313" ;
        schema:pageStart "313" ;
        schema:pagination "313" ;
        schema:text "De forse neogotische pastorie (Vierakkersestraatweg 33) en het neoclassicistische kostershuis (Vierakkersestraatweg 29) zijn beide in 1870 gebouwd naar plannen van H.J. Wennekers; het patronaatsgebouw St. Ludgerus (Vierakkersestraatweg 37) stamt uit circa 1900. Het kerkhof bevat een neogotisch baarhuisje (1870), een kruisbeeld (1870, atelier F.W. Mengelberg) en de grafkelder van A.A.J.C. van der Heyden (†1879) en J.M. van Voorst tot Voorst (†1933)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0208.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01651> a min:Passage,
