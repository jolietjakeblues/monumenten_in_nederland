        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "39075",
            "39076",
            "39081" ;
        min:soort "lemma" ;
        min:volgnummer 1799 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill430> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0228> ;
        schema:name "Watermolens"@nl ;
        schema:pageEnd "337" ;
        schema:pageStart "337" ;
        schema:pagination "337" ;
        schema:text "Watermolens. Ten zuiden van Winterswijk liggen aan de Boven Slinge twee watermolens. De Nieuwe Molen of Berenschot (Wooldseweg 74) is een onderslag watermolen. Al in 1652 wordt hier een molen vermeld. De huidige molen dateert uit 1749 en is tot de wateras as opgetrokken uit Bentheimer zandsteen. Tegen het molenhuis is in de jaren twintig van de 20ste eeuw een meelfabriek gebouwd. Van de Plekenpolse Molen of Den Helder (Mr. A.Th. ten Houtenlaan 6-8) resteert een molenhuis in vakwerkbouw met gesausde bakstenen vulling op een geteerde plint. De neogotische vensters van het naastgelegen molenaarshuis (nu restaurant) duiden op een datering rond 1860."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0228.php> .

