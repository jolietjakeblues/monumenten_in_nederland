        schema:name "Pakhuizen"@nl ;
        schema:pageEnd "191" ;
        schema:pageStart "191" ;
        schema:pagination "191" ;
        schema:text "Pakhuizen. De pakhuizen in Hattem zijn veelal ontstaan door verbouw van oudere panden. Een goed voorbeeld is Knorrenburgerstraat 2, dat dateert uit de 16de eeuw en in de 17de eeuw is verhoogd en voorzien van hijsluiken en een hijsbalk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0097.php> .

