        min:rijksmonumentnummer "31378" ;
        min:soort "lemma" ;
        min:volgnummer 1347 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0161> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "266" ;
        schema:pageStart "266" ;
        schema:pagination "266" ;
        schema:text """Windmolen ‘De Hoop’ (Zuiderzeestraatweg 252) is een achtkantige stellingkorenmolen uit 1853 met gemetselde voet en houten romp die oorspronkelijk ook als oliemolen dienst deed.

De voorm. zuivelfabriek (Zuiderzeestraatweg 396) bestaat uit een eenlaags deel met zadeldak uit 1913 en verschillende blokvormige bouwvolumes met platte daken uit 1949."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0161.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01348> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oldebroek – Boerderijen"@nl ;
        min:adres "Bovenheigraaf 102",
            "Bovenstraatweg 56",
