        min:hoofdstuk "Steden, dorpen, monumenten › Driel (gemeente Heteren)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Driel" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 680 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0063> ;
        schema:name "Driel (gemeente Heteren)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "De vizierstuw in de Neder-Rijn ten noorden van Driel is in 1959-'67 gebouwd bij de kanalisatie van de rivier. De stuw bestaat uit twee halfcilindrische stalen schuiven die als een vizier opendraaien. De vormgeving is van W. Hamdorf. Naast de stuw ligt een schutsluis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00681> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Druten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Druten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 681 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0064> ;
        schema:name "Druten"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een stroomrug van de Waal en voor het eerst vermeld in 1167. Ter plaatse van de huidige Hogestraat en de Kattenburg ontstonden lintbebouwingen en vanaf de 14de eeuw ook langs de toen aangelegde dijk. De vestiging van steenfabrieken in de 19de eeuw vormde een belangrijke economische impuls. Druten heeft zich ontwikkeld van agrarisch dorp naar regionaal centrum, maar de agrarische bebouwing is hier en daar nog herkenbaar, bijvoorbeeld aan de Kattenburg en de Heersweg."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00682> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten"@nl ;
        min:adres "Kattenburg 59" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Druten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Druten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 682 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0064> ;
        schema:name "Druten"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "De (Herv.) Immanuëlkerk (Kattenburg 59) is een eenvoudige, zaalkerk met driezijdige koorsluiting en een achthoekig klokkentorentje met spits. De in 1859-'60 naar plannen van D.A. Verburgh gebouwde kerk vertoont elementen van de Willem II-gotiek. De kerk bevat een door de gebroeders Gradussen gebouwd orgel (1876). De gepleisterde pastorie dateert uit 1864."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00683> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten"@nl ;
        min:adres "Hogestraat 2",
            "Hogestraat 4" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Druten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Druten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/13506>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51476> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "409259",
            "523811" ;
        min:soort "inleiding" ;
        min:volgnummer 683 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0064> ;
        schema:name "Druten"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "De R.K. kerk van de H.H. Ewalden (Hogestraat 2) is een driebeukige kruisbasiliek met vijfzijdig gesloten koor met zijkoren, een dakruiter met naaldspits en een forse westtoren van twee geledingen met balustraden, hoektorentjes en een naaldspits. De neogotische kerk verrees in 1874-'77 naar ontwerp van P.J.H. Cuypers. De zijbeuktraveeën en zijkoren hebben topgevels. De toren wordt geflankeerd door een polygonale doopkapel en een Piëtakapel en ook tegen de kopgevels van het transept zijn kapellen gebouwd. Het kerkinterieur wordt gedekt door kruisribgewelven en houten spitstongewelven (schip en transept). De oorspronkelijke polychromie is rond 1965 grotendeels overgeschilderd. Tot de inventaris behoren een houten Piëta (tweede helft 15de eeuw), vier neogotische altaren (1877-'93) van atelier Cuypers en Stolzenberg, en een door F.C. Smits gebouwd orgel (1840-'42) met later gewijzigd front (J. Stut, 1843). De gebrandschilderde ramen (1877) zijn vervaardigd door atelier F. Nicolas. De in 1878-'79 gebouwde neogotische pastorie (Hogestraat 4) is ook ontworpen door P.J.H. Cuypers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00684> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten – Kloosters"@nl ;
        min:adres "Ambthuisplein 1-87",
            "Ambtshuisstraat 3",
            "Hogestraat 15",
            "Kattenburg 17",
            "Kattenburg 27" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Druten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Druten" ;
        min:lemma "Kloosters" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/11662>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/49611> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "14143",
            "523815" ;
        min:soort "lemma" ;
        min:volgnummer 684 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill174> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0064> ;
        schema:name "Kloosters"@nl ;
        schema:pageEnd "152" ;
        schema:pageStart "151" ;
        schema:pagination "151-152" ;
        schema:text """Kloosters. Van het voorm. klooster met meisjesschool van de congregatie Jesus Maria Josef (Hogestraat 15), ook wel Liefdehuis of St.-Jacobusgesticht genoemd, resteert alleen het kloostergedeelte in neogotische vormen. Het is gebouwd in 1898-'99 naar ontwerp van H. van den Abeelen. In de geveltop staat een beeld van Jacobus de Meerdere. Het voorm. klooster van Zusters der Wijsheid (Ambthuisplein 1-87), ook wel Huize Boldershof genoemd, verrees tussen 1907 en 1918 naar ontwerp van Ed. Cuypers. Het complex ligt aan een parkachtig plein. Aan de linkerzijde van het plein bevindt zich het rechthoekige kloostergebouw, evenwijdig aan het Kattenburg, en het zogeheten huis Bernadette. In het Montfort- en het Marie-Louise-paviljoen werden vrouwelijke zwakzinnigen verpleegd. Deze paviljoens met souterrain en veranda staan aan weerszijden van de kapel. Het complex is verbouwd tot wooneenheden.

Het voorm. gebouw van de R.K. Volksbond (Kattenburg 27) dateert uit 1898. Het is voorzien van decoraties in geglazuurde baksteen en verblendsteen; een tegeltableau in de topgevel toont de beide heilige Ewalden.

Het Ambtshuis (Ambtshuisstraat 3) is een in 1758 voor de vestiging van de Vierschaar en de Dijkstoel verbouwde hofstede. De huidige vorm is ontstaan bij een ingrijpende verbouwing in 1841 in neoclassicistische vormen. De ver overstekende kap is in 1921 aangebracht naar plannen van J.C. Hermans. Het interieur bevat een eikenhouten Vierschaargestoelte uit circa 1760, gemaakt door B. Cloeck, en stucdecoraties uit 1841 van J.M. Rieff, waaronder een allegorische voorstelling van Maas en Waal en symbolen van de rechtspraak.

Het voorm. postkantoor (Kattenburg 17) is een hoekpand uit 1902-'03, gebouwd naar ontwerp van C.H. Peters in een combinatie van chaletstijl- en neorenaissance-elementen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00685> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten – Woonhuizen"@nl ;
        min:adres "Heersweg 13",
            "Hogestraat 11",
            "Waalbandijk 184" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Druten" ;
        min:gemeenteInBoek "Druten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Druten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Druten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Druten" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/33326>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55400> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "14144",
            "523810" ;
        min:soort "lemma" ;
        min:volgnummer 685 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill175> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0064> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "152" ;
        schema:pageStart "152" ;
        schema:pagination "152" ;
        schema:text """Woonhuizen. Uit de late 18de eeuw, maar mogelijk met een oudere kern, is Het Witte Huis (Hogestraat 11), voorzien van een gepleisterde gevel met pilasters, (kopie) guirlandes en een deuromlijsting in empire-vormen. Het exterieur en het interieur zijn voorzien van stucwerkdecoraties van J.M. Rieff, zoals allegorische voorstellingen van de seizoenen. Uit circa 1870 stamt de gepleisterde eclectische villa Kattenburg 33. De lagere achterbouw bevat een koetshuis. Een soortgelijke, maar ongepleisterde villa is Kattenburg 24-26. De gepleisterde eclectische Villa Weltevreden (Heersweg 13) is in 1881 als notarishuis gebouwd voor Ch.A.A. van de Garde. Uit 1915 dateert de villa Hogestraat 24 met sobere jugendstilvormen. Deze zijn ook terug te vinden bij de in 1904 gebouwde villa Kattenburg 15. Een vergelijkbaar gebruik van - door de plaatselijke steenfabrieken vervaardigde - geglazuurde baksteen, maar ook van jugendstil-tegeltableaus, is te zien bij de middenstandswoningen Kattenburg 7 en Kattenburg 11-13.

De theekoepel (Waalbandijk 184) is in de 18de eeuw gebouwd voor de jonkers Van Delen, heren van Druten en Lakenburg. De zeszijdige en tweelaags bakstenen theekoepel staat tegen de dijk en wordt gedekt door een koepeldak met spitsje. Het bouwwerk is in 1971 gerestaureerd onder leiding van W.A. Heineman."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0064.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00686> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Druten – Boerderijen"@nl ;
        min:adres "Hogestraat 18",
            "Hooistraat 2",
            "Hooistraat 42" ;
