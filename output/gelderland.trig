        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12924>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/32090> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "34549",
            "34567" ;
        min:soort "inleiding" ;
        min:volgnummer 504 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0043> ;
        schema:name "Bronkhorst (gemeente Steenderen)"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "De kasteelheuvel (bij Kasteelweg 1) is een verhoogd terrein met funderingsresten van het in 1828 grotendeels gesloopte kasteel. Het toen resterende vierkante huis kwam in 1879 in bezit van A.J.P. Metelerkamp en werd in 1902 afgebroken. Het neoclassicistische bouwhuis (Kasteelweg 5) uit circa 1879 is bewaard gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00505> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bronkhorst (gemeente Steenderen)"@nl ;
        min:adres "Kapelstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Steenderen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Bronkhorst (gemeente Steenderen)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Bronkhorst" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/21575> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "34548" ;
        min:soort "inleiding" ;
        min:volgnummer 505 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0043> ;
        schema:name "Bronkhorst (gemeente Steenderen)"@nl ;
        schema:pageEnd "121" ;
        schema:pageStart "121" ;
        schema:pagination "121" ;
        schema:text "De voorm. kapel (Kapelstraat 2), thans Herv. kerk, is een eenbeukig godshuis met driezijdige sluiting en toegangsportaal. Het bevat mogelijk nog enig 15de-eeuws muurwerk. Na de stadsbrand in 1633 kreeg het zijn huidige kap met dakruiter. Daarin hangt een klok uit 1638. In 1842 werd de kapel tot school verbouwd. Bij de ingrijpende restauratie in 1960-'61, naar plannen van W.A. Heineman, verwijderde men de 19de-eeuwse pleisterlaag en kreeg het gebouw weer steunberen. Het interieur bevat een kabinetorgel uit 1750, vermoedelijk vervaardigd door A.A. Hinsz."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0043.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00506> a min:Passage,
