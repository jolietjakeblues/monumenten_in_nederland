        schema:name "Driel (gemeente Heteren)"@nl ;
        schema:pageEnd "151" ;
        schema:pageStart "151" ;
        schema:pagination "151" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Na de Tweede Wereldoorlog is het dorp in zuidelijke richting verder uitgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0063.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00676> a min:Passage,
