        schema:pageStart "213" ;
        schema:pagination "213" ;
        schema:text "Dorp, ontstaan in de 18de eeuw bij de kopermolen op de Klarenbeek. In de 19de eeuw kwam er enige lintbebouwing tot ontwikkeling aan de weg van Loenen naar Wilp."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0129.php> .

