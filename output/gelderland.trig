        min:volgnummer 945 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill231> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0100> ;
        schema:name "Raadhuizen"@nl ;
        schema:pageEnd "193" ;
        schema:pageStart "193" ;
        schema:pagination "193" ;
        schema:text "Raadhuizen. Het voorm. raadhuis Dorpsstraat 44 is een gepleisterd dwars eenlaagspand met portico en dakruiter, gebouwd in 1884 naar plannen van C.W.A. de Groot in neoclassicistische vormen. Het huidige raadhuis Marktstraat 1 ontstond door een ingrijpende verbouwing van de ‘Villa Nova’ in 1928. Naar plannen van W.A. Lensvelt voorzag men het blokvormige pand van een beklamping met rode baksteen, een zandstenen ingangspartij in neo-Lodewijk XIV-stijl en een achtkantige dakruiter. In 1977-'84 werd het fors uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0100.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00946> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerde – Villa's"@nl ;
