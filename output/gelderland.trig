        min:volgnummer 1071 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill255> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0124> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "210" ;
        schema:pageStart "210" ;
        schema:pagination "210" ;
        schema:text "Woonhuizen. Het pand Joppelaan 102 is rond 1854 als boerderij annex tolhuis gebouwd aan de toen aangelegde Joppelaan. Uit 1874 stamt de T-vormige dorpswoning Joppelaan 104-106. De in 1921 gebouwde villa Overdok (Lochemseweg 66) is door A.J. Jansen ontworpen in Engelse landhuisstijl met ‘Um 1800’-elementen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01072> a min:Passage,
