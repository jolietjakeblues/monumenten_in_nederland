        min:kern "Tiel" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/56486> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "35577" ;
        min:soort "inleiding" ;
        min:volgnummer 1545 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill374> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0195> ;
        schema:name "Tiel"@nl ;
        schema:pageEnd "298" ;
        schema:pageStart "297" ;
        schema:pagination "297-298" ;
        schema:text "De voorm. St.-Caeciliakapel en Luth. kerk (Kerkstraat 34) [2], nu Herv. kerk, is een eenbeukige kapel met hoger, driezijdig gesloten koor voorzien van een achtkantige traptoren. Het schip van deze laat-gotische kapel kwam rond 1450 tot stand, het koor rond 1500. De kapel hoorde bij het St.-Caeciliaklooster, een augustinessenklooster dat vóór 1621 is gesloopt. De kapel is in 1949 gerestaureerd. Het koor heeft netgewelven met afhangende gebeeldhouwde sluitstenen. De gewelven rusten op gebeeldhouwde kopjes en kapitelen met gebeeldhouwde musicerende engelen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0195.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01546> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Tiel"@nl ;
