        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0194> ;
        schema:name "Terwolde (gemeente Voorst)"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "Dorp, ontstaan op een stroomrug van de IJssel en in 1295 als parochie genoemd. De bebouwing rond de kerk kreeg vanaf de 19de eeuw een bescheiden kransvormige uitbreiding en ten zuiden van het Toevoerkanaal kwam een tweede kern tot ontwikkeling, De Wijk genoemd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0194.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01535> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Terwolde (gemeente Voorst)"@nl ;
        min:adres "Molenweg 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Voorst" ;
        min:gemeenteInBoek "Voorst" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Voorst_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Terwolde (gemeente Voorst)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Terwolde" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/12728>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41773> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38072",
            "38073" ;
        min:soort "inleiding" ;
        min:volgnummer 1535 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0194> ;
        schema:name "Terwolde (gemeente Voorst)"@nl ;
        schema:pageEnd "295" ;
        schema:pageStart "295" ;
        schema:pagination "295" ;
        schema:text "De Herv. kerk (Molenweg 2), oorspronkelijk gewijd aan St. Cosmas en St. Damianus, is een tweebeukige kerk met driezijdig gesloten koor en een brede toren van twee geledingen met traptoren en zadeldak. De gotische toren verrees rond 1350. Het koor en de sacristie kwamen rond 1400 tot stand. Het huidige tweebeukige schip werd rond 1540 gebouwd ter plaatse van een ouder schip. De consistorie heeft men rond 1860 toegevoegd. De toren is in 1967 gerestaureerd, de kerk in 1992-'94. Het interieur wordt gedekt door kruisribgewelven. Het koor bevat een laat-15de-eeuwse muurschildering, voorstellende St. Christoffel. In het schip bevinden zich schilderingen uit circa 1540 met voorstellingen van heiligen, vervaardigd door Ewolt van Delft. Tot de inventaris behoren een gotisch doopvont (14de eeuw), een restant van een herenbank (17de eeuw) en een door C.F.A. Naber gebouwd orgel (1827)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0194.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01536> a min:Passage,
