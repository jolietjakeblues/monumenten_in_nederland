        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill343> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0170> ;
        schema:name "Oud-Zevenaar (gemeente Zevenaar)"@nl ;
        schema:pageEnd "275" ;
        schema:pageStart "274" ;
        schema:pagination "274-275" ;
        schema:text "Tot de inventaris behoren de grafzerk van Gertruud van Camphusen (begin 16de eeuw), een doopvont (1650), een barok altaar met getorste kolommen (1664) en een door I. Schwarze gebouwd orgel (1890) met kast uit 1910. De gebrandschilderde ramen zijn van F. en J. Nicolas (circa 1900 en 1931)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0170.php> .

