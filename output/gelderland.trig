        rdfs:label "Heerde – Vosbergen"@nl ;
        min:adres "Vosbergerweg 38" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Heerde" ;
        min:gemeenteInBoek "Heerde" ;
