        schema:name "Warnsveld"@nl ;
        schema:pageEnd "327" ;
        schema:pageStart "327" ;
        schema:pagination "327" ;
        schema:text "Het raadhuis (Rijksstraatweg 65) is een neoclassicistisch herenhuis uit 1863, dat in 1925 als raadhuis in gebruik is genomen. Het is in 1938 verbouwd en in 1993 aanzienlijk uitgebreid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0219.php> .

