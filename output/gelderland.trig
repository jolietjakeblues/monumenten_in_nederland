        min:kern "Gameren" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 816 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0082> ;
        schema:name "Gameren (gemeente Zaltbommel)"@nl ;
        schema:pageEnd "173" ;
        schema:pageStart "173" ;
        schema:pagination "173" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug van de Waal. Gameren wordt voor het eerst vermeld in 1031. Op de stroomrug kwam een gestrekt esdorp (Ouwelsestraat-Ridderstraat-Nieuwstraat) tot ontwikkeling. Na de aanleg van de Waalbandijk in de 14de eeuw is de kern langs de Ridderstraat via de Delkant richting de dijk uitgegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0082.php> .

