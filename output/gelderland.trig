        schema:name "Hummelo (gemeente Hummelo en Keppel)"@nl ;
        schema:pageEnd "208" ;
        schema:pageStart "208" ;
        schema:pagination "208" ;
        schema:text "Dorp, ontstaan op een rivierduin en voor het eerst genoemd in 828. In de 19de eeuw ontwikkelde zich langs de Dorpsstraat een harmonisch dorp, dat inmiddels is beschermd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0121.php> .

