        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0163> ;
        schema:name "Oosterbeek (gemeente Renkum)"@nl ;
        schema:pageEnd "268" ;
        schema:pageStart "268" ;
        schema:pagination "268" ;
        schema:text "De Remonstr. kerk (Wilhelminastraat 10) is een zaalkerk met portaal en slanke geveltoren, gebouwd in 1906 naar plannen van J. van Burk. De witte verblendsteen en de jugendstil-details verlenen het een bijzonder karakter. De aanbouw aan de oostzijde is uit 1935. De kerk bevat een orgel uit 1909."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0163.php> .

