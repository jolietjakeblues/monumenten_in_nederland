        schema:pageEnd "144" ;
        schema:pageStart "144" ;
        schema:pagination "144" ;
        schema:text "De R.K. H. Geestkerk (Bilderdijkstraat 3) is een moderne ruime kerk met opengewerkte toren, gebouwd in 1963-'65 naar plannen van J. Dresme."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0057.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00640> a min:Passage,
