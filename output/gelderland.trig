        schema:text "Dorp, ontstaan in de 19de eeuw als katholieke enclave in de nabijheid van Huis 't Joppe."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01069> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Joppe (gemeente Gorssel)"@nl ;
        min:adres "Joppelaan 71",
            "Joppelaan 73" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Gorssel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Joppe (gemeente Gorssel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Joppe" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/51801> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16707" ;
        min:soort "inleiding" ;
        min:volgnummer 1069 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0124> ;
        schema:name "Joppe (gemeente Gorssel)"@nl ;
        schema:pageEnd "209" ;
        schema:pageStart "209" ;
        schema:pagination "209" ;
        schema:text "De R.K. kerk O.L. Vrouw ten Hemelopneming (Joppelaan 73) is een eenbeukige kerk met driezijdig gesloten koor en een toren van drie geledingen met balustrade, achtkantige lantaarn met frontalen en een slanke achtkantige spits. Deze neogotische kerk verrees in 1866-'67 naar plannen van H.J. Wennekers. Het interieur wordt gedekt door in stucwerk op latten uitgevoerde kruisribgewelven. Uit de bouwtijd stammen de preekstoel (circa 1870), het doopvont (1873) en de in 1962 tot hoofdaltaar omgebouwde communiebank (circa 1875), alle gemaakt door atelier Lenaerts en Houtermans uit Roermond; het orgel is gebouwd door M. Maarschalkerweerd (1889). De kerk is in 1992-'93 gerestaureerd. De pastorie (Joppelaan 71), in neogotische vormen en met wenkbrauwen boven de vensters, dateert uit circa 1867 en is ook ontworpen door Wennekers. Het kerkhof heeft een baarhuisje uit 1870, een door paden omgeven eiland met priestergraven en een kruisiging, en de grafkelder met granieten obelisk van de stichter van de kerk, F.E.A. van Hövell tot Westerflier (†1926)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0124.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01070> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Joppe (gemeente Gorssel) – Huis 't Joppe"@nl ;
        min:adres "Joppelaan 110" ;
