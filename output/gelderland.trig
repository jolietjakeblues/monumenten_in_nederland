        min:volgnummer 1000 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0109> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "201" ;
        schema:pageStart "201" ;
        schema:pagination "201" ;
        schema:text "Woonhuizen. Het gepleisterde huis De Haantjes (Dorpsstraat 29) is een tweebeukig dwars pand met omlijste ingang en een middenrisaliet met topgevel. Op een gevelsteen staat ‘IVH 1778’. Uit circa 1860 dateert het blokvormige eclectische herenhuis O.L. Vrouwestraat 39. De rond 1910 gebouwde villa Dorpsstraat 51 heeft een serre en een gepleisterde verdieping. Het L-vormige huis Dorpsstraat 3 uit circa 1930 is voorzien van een ronde hoektoren en is uitgevoerd in traditionalistische stijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0109.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01001> a min:Passage,
