        min:gemeenteInBoek "Putten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Putten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Putten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Putten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1419 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill346> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0174> ;
        schema:name "Putten"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een dekzandgordel en voor het eerst genoemd in 855. De vroeg-middeleeuwse kerk van Putten was bezit van het klooster Paderborn (D). De oudste bebouwing ontwikkelde zich langs de Kerkstraat, de Dorpsstraat en de Brinkstraat. Door de aanleg van de Zuiderzeestraatweg (1830) en de spoorlijn Amersfoort-Zwolle (1863) werd het dorp ontsloten. Het raakte in trek bij oud-Indiëgangers en toeristen. Na 1920 breidde Putten zich naar het oosten uit langs de Schoolstraat en na 1950 vooral in zuidelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01420> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Putten"@nl ;
        min:adres "Kerkplein 11" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Putten" ;
        min:gemeenteInBoek "Putten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Putten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Putten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Putten" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55912>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55929> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "32222",
            "32223" ;
        min:soort "inleiding" ;
        min:volgnummer 1420 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0174> ;
        schema:name "Putten"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "De Herv. kerk (Kerkplein 11), oorspronkelijk gewijd aan St. Pancratius, is een driebeukige kerk met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde naaldspits. De gesloten onderbouw van de toren maakt een 14de-eeuwse indruk, maar het metselwerk wijst op een datering in het begin van de 16de eeuw. In de toren hangt een door Steven Butendiic gegoten klok (tweede helft 15de eeuw). Het laat-gotische koor en het sterk aangetaste middenschip dateren uit de 15de eeuw. De noordbeuk van het schip is vermoedelijk 16de-eeuws en had oorspronkelijk een eigen koor. De zuidbeuk is in 1923 opgetrokken, waarbij een gotische kapel en sacristie zijn gesloopt. Het interieur van het koor wordt gedekt door kruisribgewelven. Een ingrijpende verbouwing van het interieur vond plaats in 1965-'66. Tot de inventaris behoren een aantal 17de- en 18de-eeuwse grafzerken, een preekstoel (1624), een doophek (tweede kwart 17de eeuw), een Tien Gebodenbord (1691) en een door C.G.F. Witte gebouwd orgel (1860)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01421> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Putten – Overige kerken"@nl ;
        min:adres "Achterstraat 39",
            "Brinkstraat 8",
            "Spoorstraat 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Putten" ;
        min:gemeenteInBoek "Putten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Putten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Putten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Putten" ;
        min:lemma "Overige kerken" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1421 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0174> ;
        schema:name "Overige kerken"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text "Overige kerken. De Geref. kerk (Achterstraat 39) is een neogotische zaalkerk uit circa 1900. De huidige R.K. O.L. Vrouwekerk (Brinkstraat 8) kwam in 1938-'39 tot stand ter vervanging van een kerk uit 1858, een zaalkerk met ongelede toren naar ontwerp van C. Hardeman. De kerk bevat neogotische kruiswegstaties (1870). Naast de kerk staat een pastorie uit 1938-'39. De villa ‘De Beukenheg’, voorheen ‘Annastein’ (Spoorstraat 2) is een blokvormig neoclassicistische villa uit 1862, gebouwd in opdracht van burgemeester C.A.S. Hiebendal. Het pand deed van 1884 tot 1917 dienst als hotel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0174.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01422> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Putten – Windmolen"@nl ;
        min:adres "Dorpsstraat 13",
            "Halvinkhuizerweg 3",
            "Stationsstraat 127" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Putten" ;
        min:gemeenteInBoek "Putten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Putten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Putten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Putten" ;
        min:lemma "Windmolen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41593> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523966" ;
        min:soort "lemma" ;
        min:volgnummer 1422 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0174> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "277" ;
        schema:pageStart "277" ;
        schema:pagination "277" ;
        schema:text """Windmolen ‘Het Hert’ (Halvinkhuizerweg 3) is een stellingkorenmolen, met een hoge achtkantige bakstenen onderbouw en een met riet gedekte houten achtkant. De molen is gebouwd in 1899 door T. ten Zijthoff & Zn. voor H. van de Poll, ter vervanging van een in 1898 afgebrande voorganger.

De voorm. slagerij (Dorpsstraat 13) is een eenlaagspand in neorenaissance-stijl, gebouwd in 1916-'17 naar ontwerp van J. Kortlang.

Het station (Stationsstraat 127) is een langgerekt gebouw met smallere vleugel, gebouwd in 1930 naar ontwerp van H.G.J. Schelling in een traditionalistische stijl."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0174.php> .

