        min:hoofdstuk "Steden, dorpen, monumenten › Groesbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Groesbeek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 875 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0091> ;
        schema:name "Groesbeek"@nl ;
        schema:pageEnd "181" ;
        schema:pageStart "181" ;
        schema:pagination "181" ;
        schema:text "Het voorm. Liefdesgesticht van de zusters van Liefde (Hollands Klooster 1-6) is een gepleisterd eclectisch pand met drie vleugels voorzien van topgevels. Het middendeel werd in 1853-'54 gebouwd naar ontwerp van H.J. van den Brink en bevatte het klooster en de St.-Josephschool. De twee zijvleugels, waarin Huize St. Joseph voor bejaarde vrouwen werd gevestigd, kwamen in 1866 tot stand en de neogotische kapel in 1897. Thans zijn in het complex wooneenheden ondergebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00876> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Groesbeek"@nl ;
        min:adres "Nijmeegsebaan 31" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Groesbeek" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Groesbeek" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Groesbeek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 876 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0091> ;
        schema:name "Groesbeek"@nl ;
        schema:pageEnd "181" ;
        schema:pageStart "181" ;
        schema:pagination "181" ;
        schema:text "Het voorm. R.K. sanatorium ‘Dekkerswald’ (Nijmeegsebaan 31), thans Medisch Centrum Dekkerswald, is in 1911-'13 gebouwd naar ontwerp van Ed. Cuypers. Het deels gepleisterde hoofdgebouw wordt geflankeerd door zijvleugels met hoger opgetrokken middenrisalieten en is in 1929 met een verdieping verhoogd naar ontwerp van A. van Geyn. Tot het complex behoort de in 1918 gebouwde St.-Antonius van Paduakapel, een zaalkerk met lager, smaller koor, dakruiter en portaal. De kapel bevat een mozaïek van het Laatste Avondmaal (1921) naar ontwerp van P. Gerrits. Op het terrein staan verder een draaibare, houten lighal (circa 1913) en een nachtportiershuisje (circa 1920). De twee wit geschilderde dienstwoningen Nijmeegsebaan 19 en 41 uit circa 1930 zijn mogelijk door A. van Geyn ontworpen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0091.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00877> a min:Passage,
