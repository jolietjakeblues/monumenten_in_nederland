        min:volgnummer 1024 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0114> ;
        schema:name "Hoenderloo (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "204" ;
        schema:pageStart "204" ;
        schema:pagination "204" ;
        schema:text "De Heldringstichting (Kampheuvellaan 34) is gesticht in 1848 als doorgangshuis voor verwaarloosde minderjarigen. Bij de vernieuwing in 1985 zijn het hoofdgebouw (1851) en het verplegingsgebouw (1912) gesloopt. Bewaard gebleven is het ‘Kampheuvel Huis’ uit 1929, ontworpen door J.A. Wijn."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0114.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01025> a min:Passage,
