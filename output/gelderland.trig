        min:volgnummer 531 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0046> ;
        schema:name "Buren"@nl ;
        schema:pageEnd "125" ;
        schema:pageStart "125" ;
        schema:pagination "125" ;
        schema:text "De voorm. synagoge (Kniphoek 14) [2] werd in 1804 ingericht in een tegen de stadsmuur gebouwd huis. Bij een verbouwing in 1864 zijn spitsboogvensters aangebracht. Tot 1890 heeft het pand als synagoge gediend."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0046.php> .

