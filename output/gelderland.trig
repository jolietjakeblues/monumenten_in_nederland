        min:kern "Beekbergen" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 409 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "109" ;
        schema:pageStart "109" ;
        schema:pagination "109" ;
        schema:text "Boerderijen. Ten oosten van Lieren bevinden zich twee ontginningsboerderijen in neoclassicistische vormen, gebouwd naar plannen van L.H. Eberson. Het Woud (Woudweg 53), met twee schuren en los voorhuis, stamt uit 1871, De Woudhof (Woudweg 63) uit 1875 heeft een los voorhuis en drie schuren. De openbare lagere school van het gehucht Oosterhuizen (Het Oude Veen 21), gelegen ten oosten van Lieren, is rond 1900 gebouwd als een drieklassige school met aangebouwde onderwijzerswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

