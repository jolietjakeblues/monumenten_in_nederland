        min:gemeenteInBoek "Aalten" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Aalten_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Aalten" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Aalten" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 224 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0008> ;
        schema:name "Aalten"@nl ;
        schema:pageEnd "61" ;
        schema:pageStart "61" ;
        schema:pagination "61" ;
        schema:text "De (Geref.) Oosterkerk (Oosterkerkstraat 3) is een uit 1912 daterende, forse T-vormige kerk met in de binnenhoek een slanke toren met ingesnoerde spits. Het ontwerp met rationalistische invloeden is van A. Nauta. Het orgel, in 1823 door J.C. Friederichs voor de Zuiderkerk te Amsterdam gebouwd en in 1941 overgeplaatst, kreeg in 1977 een nieuwe kast."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0008.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00225> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Aalten"@nl ;
        min:adres "Dijkstraat 11",
            "Markt 7" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
