        rdfs:label "Lochem – Overige kerken"@nl ;
        min:adres "Emmastraat 10",
            "Graaf Ottoweg 4",
            "Markt 2",
            "Nieuwe Weg 18",
            "Zuiderwal 9" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
