        min:volgnummer 1066 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0123> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "209" ;
        schema:pageStart "209" ;
        schema:pagination "209" ;
        schema:text "Woonhuizen. Karakteristiek is het vrij hoog gelegen Dr. A.R. Holplein waarlangs de bebouwing bestaat uit herenhuizen en burgerwoningen voornamelijk uit de tweede helft van de 19de en het begin van de 20ste eeuw, zoals bijvoorbeeld Dr. A.R. Holplein 1 uit circa 1915."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0123.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01067> a min:Passage,
            schema:CreativeWork ;
