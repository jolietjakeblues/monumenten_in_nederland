        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0146> ;
        schema:name "Maurik (gemeente Buren)"@nl ;
        schema:pageEnd "230" ;
        schema:pageStart "230" ;
        schema:pagination "230" ;
        schema:text "Het raadhuis (Raadhuisstraat 34) is sinds 1942 gevestigd in een villa uit 1890, opgetrokken naar ontwerp van M. van de Pol voor N. de Meijer-van de Thoorn. De villa met voorhuis en haaks achterhuis vertoont chaletstijl-elementen. Kort na 1942 is een veldwachterswoning aangebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0146.php> .

