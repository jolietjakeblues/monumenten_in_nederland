        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeddam (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zeddam" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1828 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Zeddam (gemeente Bergh)"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "Dorp, gelegen op de flank van de Paasberg aan de weg van 's-Heerenberg naar Doetinchem. Het dorp hoorde tot de bezittingen van de heer van Bergh. Het wordt voor het eerst genoemd in 1211 als ‘Sydehem’."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01829> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeddam (gemeente Bergh)"@nl ;
        min:adres "Bovendorpsstraat 5",
            "Bovendorpsstraat 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Bergh" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeddam (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zeddam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50302> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "9289" ;
        min:soort "inleiding" ;
        min:volgnummer 1829 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Zeddam (gemeente Bergh)"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "De R.K. St.-Oswalduskerk (Bovendorpsstraat 8) is een driebeukige hallenkerk met een forse toren van vier geledingen met ingesnoerde spits. De toren, waarvan de onderste drie geledingen uit de 14de eeuw stammen, kreeg rond 1500 een gotische klokkenverdieping met deels in Baumberger steen uitgevoerde traceringen. Het neogotische schip en koor werden in 1890-'91 toegevoegd naar plannen van G. te Riele. Tot de inventaris behoren een in Antwerpen gemaakt laat-gotisch altaarretabel (circa 1520) en een neogotisch triomfkruis met beelden uit circa 1500: Christus tussen Maria en Johannes. Het orgel van J.D. Nolting stamt uit 1843. De pastorie (Bovendorpsstraat 5) is een fors neogotisch pand uit 1869 naar plannen van H.J. Wennekers. Naast de kerk staat een gietijzeren dorpspomp uit circa 1875."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01830> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zeddam (gemeente Bergh)"@nl ;
        min:adres "Ettemastraat 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Bergh" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zeddam (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zeddam" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/38985> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "476730" ;
        min:soort "inleiding" ;
        min:volgnummer 1830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0231> ;
        schema:name "Zeddam (gemeente Bergh)"@nl ;
        schema:pageEnd "346" ;
        schema:pageStart "346" ;
        schema:pagination "346" ;
        schema:text "De Herv. kerk (Ettemastraat 3) is een uit 1810 daterende, eenvoudige zaalkerk met achtkantige dakruiter. Het orgel werd in 1785, vermoedelijk door J.D. Nolting, gebouwd voor de R.K. kerk te Doesburg. Het is in 1813 in Zeddam geplaatst."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0231.php> .

