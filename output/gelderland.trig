        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0102> ;
        schema:name "Heerewaarden (gemeente Maasdriel)"@nl ;
        schema:pageEnd "196" ;
        schema:pageStart "196" ;
        schema:pagination "196" ;
        schema:text "De Herv. kerk (Hogestraat 20) is een zaalkerk met driezijdige koorsluiting en een ingezwenkte topgevel voorzien van een geveltoren met ingesnoerde naaldspits. De kerk verrees in 1849-'50 ter vervanging van een voorganger uit 1608, die weer een verwoeste middeleeuwse kerk verving. Het gebouw vertoont neogotische invloeden, zoals de ezelsrugbogen van vensters, deur en galmgaten. Tot de inventaris behoren een preekstoel in Lodewijk XIV-stijl (1738) en een door de firma E. Leichel & Zn. gebouwd orgel (1897)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0102.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00958> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Heerewaarden (gemeente Maasdriel)"@nl ;
        min:adres "Hogestraat 26" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Maasdriel" ;
        min:gemeenteInBoek "Maasdriel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasdriel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Heerewaarden (gemeente Maasdriel)" ;
