        rdfs:label "Wijchen – Windmolens"@nl ;
        min:adres "Baron d'Osystraat 8",
            "Valendrieseweg 295" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Wijchen" ;
