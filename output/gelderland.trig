        min:volgnummer 1630 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0206> ;
        schema:name "Veessen (gemeente Heerde)"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "309" ;
        schema:pagination "309" ;
        schema:text "De Herv. kerk (Kerkstraat 19) is een achtzijdige neoclassicistische zaalkerk, gebouwd in 1843 ter vervanging van de middeleeuwse dorpskerk. Het portaal met fronton is toegevoegd in 1870; het tentdak en de dakruiter stammen in hun huidige vorm uit 1881. Tot de inventaris behoren een preekstoel uit 1802 en een door de gebroeders Van Oeckelen gebouwd orgel met neobarokke kast (1884)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0206.php> .

