        schema:pagination "177" ;
        schema:text "Het voorm. douanekantoor (Anholtseweg 78) is een eenlaags T-vormig pand met neorenaissance-elementen, gebouwd in 1911 naar plannen van het bureau van rijksbouwmeester C.H. Peters."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0087.php> .

