        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beneden-Leeuwen (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beneden-Leeuwen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 426 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0032> ;
        schema:name "Beneden-Leeuwen (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "Dorp, ontstaan op een brede oeverwal van de Waal. De vroegste bebouwing ontstond langs de parallel lopende wegen: Koningsstraat (nu Van Heemstraweg), Zandstraat en Waalbandijk en enkele haaks daarop staande straten. Oorspronkelijk vormde het dorp een geheel met Boven-Leeuwen, maar na de bouw in 1898 van de eigen katholieke kerk scheidde het zich daarvan af. Beneden-Leeuwen maakte een sterke industriële ontwikkeling door."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00427> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beneden-Leeuwen (gemeente West Maas & Waal)"@nl ;
        min:adres "Zandstraat 75",
            "Zandstraat 77" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beneden-Leeuwen (gemeente West Maas & Waal)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beneden-Leeuwen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78458>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/78459> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523077",
            "523078" ;
        min:soort "inleiding" ;
        min:volgnummer 427 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0032> ;
        schema:name "Beneden-Leeuwen (gemeente West Maas & Waal)"@nl ;
        schema:pageEnd "112" ;
        schema:pageStart "112" ;
        schema:pagination "112" ;
        schema:text "De R.K. St.-Alphonsus de Liguorikerk (Zandstraat 77) is een driebeukige kruisbasiliek met achtkantige houten vieringtoren, bekroond door een koepel met open spits, en een vijfzijdig gesloten koor voorzien van kooromgang en zijkapellen. De kerk verrees in 1898-1900 naar ontwerp van C. Franssen in neoromaanse en neogotische vormen. In plaats van de niet uitgevoerde toren bouwde men in 1934 een ingangsportaal met zijkapellen. In de vieringtoren hangt een klokje uit 1724. Het interieur wordt gedekt door kruisribgewelven en een op pendentieven rustend koepelgewelf (viering). De oorspronkelijk inventaris is grotendeels nog aanwezig, waaronder een door J. Custers vervaardigde preekstoel (1910). De pastorie (Zandstraat 75) is in 1900 gebouwd in neogotische vormen, vermoedelijk naar ontwerp van C. Franssen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0032.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00428> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beneden-Leeuwen (gemeente West Maas & Waal)"@nl ;
        min:adres "Zandstraat 51" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Maas en Waal" ;
        min:gemeenteInBoek "West Maas & Waal" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Maas_en_Waal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
