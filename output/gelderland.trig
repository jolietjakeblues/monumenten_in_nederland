            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/79572> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16515",
            "16516",
            "523735" ;
        min:soort "inleiding" ;
        min:volgnummer 1465 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0182> ;
        schema:name "Rumpt (gemeente Geldermalsen)"@nl ;
        schema:pageEnd "285" ;
        schema:pageStart "285" ;
        schema:pagination "285" ;
        schema:text "De Herv. kerk (Middenstraat 43) is een driebeukige pseudobasilicale kerk met hoger, driezijdig gesloten koor, een kapel en een ingebouwde toren van vier geledingen met lage ingesnoerde spits. De toren verrees rond 1300. Het huidige koor en schip kwamen respectievelijk in de eerste en de tweede helft van de 15de eeuw tot stand. De kerk is in 1890 ommetseld. Inwendig heeft het schip kruisribgewelven op bladkapitelen en gebeeldhouwde kopjes. De kerk bevat een door C.F.A. Naber gebouwd orgel (1842). De blokvormige pastorie (Middenstraat 45) dateert uit 1890."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0182.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01466> a min:Passage,
            schema:CreativeWork ;
