    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01051> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Hulshorst (gemeente Nunspeet) – Buitenplaatsen"@nl ;
        min:adres "Harderwijkerweg 390",
            "Harderwijkerweg 543-547" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Nunspeet" ;
        min:gemeenteInBoek "Nunspeet" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Nunspeet_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Hulshorst (gemeente Nunspeet)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Hulshorst" ;
        min:lemma "Buitenplaatsen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 1051 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0120> ;
        schema:name "Buitenplaatsen"@nl ;
        schema:pageEnd "207" ;
        schema:pageStart "207" ;
        schema:pagination "207" ;
        schema:text "Buitenplaatsen. De kern van het gepleisterde eclectische landhuis Groeneveld (Harderwijkerweg 390), gelegen in een landschapspark met serpentinevijver, dateert uit circa 1830. Op het terrein staan een bedrijfswoning en een portierswoning uit de tweede helft van de 19de eeuw. Het vroeg-19de-eeuwse landhuis van de ten zuidwesten van het dorp gelegen buitenplaats Hulshorst (Harderwijkerweg 543-547) - ontstaan uit een 16de-eeuws edelmanshuis - is in 1941 afgebroken. Wat resteert zijn de vroeg-19de-eeuwse landschappelijke parkaanleg met vijverpartij, het 19de-eeuwse gepleisterde koetshuis en de eenlaags vroeg-20ste-eeuwse boswachterswoning."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0120.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01052> a min:Passage,
