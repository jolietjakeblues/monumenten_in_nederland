        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zelhem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zelhem" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1834 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0232> ;
        schema:name "Zelhem"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text "Dorp, gelegen op een dekzandrug, vermoedelijk ontstaan bij een rond 800 door Ludger gestichte kapel. Het brinkdorp wordt voor het eerst in 1152 genoemd. In 1884 kreeg het een spoorwegverbinding met Doetinchem en Ruurlo. Rond het station vestigde zich enige industrie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0232.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01835> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zelhem"@nl ;
        min:adres "Markt 2" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Zelhem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zelhem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zelhem" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/34161> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "40412" ;
        min:soort "inleiding" ;
        min:volgnummer 1835 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill444> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0232> ;
        schema:name "Zelhem"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text "De Herv./Geref. kerk (Markt 2) werd gewijd aan St. Lambertus. Het is een driebeukige pseudobasiliek met driezijdig gesloten koor en een toren van twee geledingen met ingesnoerde spits. Van de op ijzeroer gefundeerde romaanse toren stamt het tufstenen deel uit de tweede helft van de 12de eeuw. Na instorting vond herbouw plaats in 1662. In 1845 werd de toren verhoogd en voorzien van een nieuwe spits. Op de plaats van een 9de-eeuwse kapel verrees midden 15de eeuw het huidige laat-gotische koor met zijkapellen, waarna later in die eeuw de vervanging van het oude schip en de bouw van de sacristie volgden. In 1572 werd de kerk in brand gestoken. Bij de restauratie in 1949-'50 zijn in het schip de kruisribgewelven opnieuw aangebracht. Tot de inventaris behoren een laat-gotisch sacramentshuisje (15de eeuw) en een midden-17de-eeuwse preekstoel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0232.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01836> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Zelhem – Woonhuizen"@nl ;
        min:adres "Dr. Grashuisstraat 3",
            "Heisterboomsdijk 1",
            "Stationsplein 10",
            "Stationsstraat 9" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Bronckhorst" ;
        min:gemeenteInBoek "Zelhem" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Bronckhorst> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Zelhem" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Zelhem" ;
        min:lemma "Woonhuizen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/16138> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "513650" ;
        min:soort "lemma" ;
        min:volgnummer 1836 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0232> ;
        schema:name "Woonhuizen"@nl ;
        schema:pageEnd "347" ;
        schema:pageStart "347" ;
        schema:pagination "347" ;
        schema:text """Woonhuizen. Jugendstil-kenmerken hebben het woon- en winkelpand Burg. Rijpstrastraat 18 uit circa 1905 en de dokterswoning Ter Linde (Stationsstraat 9) uit 1914, de laatste naar plannen van G. Bel.

Het voorm. station (Stationsplein 10) is gebouwd in 1884 voor de Geldersch-Overijsselsche Lokaalspoorweg-Maatschappij en deed tot 1937 dienst als station. In 1916 kreeg het een verdieping met bovenwoning. Het voorm. stationskoffiehuis (Dr. Grashuisstraat 3) uit 1902 vertoont jugendstil-kenmerken. Bij het Stationsplein staat een achtkantige muziektent uit 1932.

Het voorm. zwembadhuisje (bij Heisterboomsdijk 1), gelegen ten noordoosten van Zelhem bij de bosvijver op het landgoed De Baaksche Kamp, is rond 1935 gebouwd in de stijl van het functionalisme. Het heeft een gebogen open portiek."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0232.php> .

