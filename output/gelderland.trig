        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Apeldoorn_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loenen (gemeente Apeldoorn)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Loenen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1181 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill279> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0141> ;
        schema:name "Loenen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "226" ;
        schema:pageStart "226" ;
        schema:pagination "226" ;
        schema:text "De R.K. kerk St. Antonius Abt (Hoofdweg 51) is een neoclassicistische zaalkerk voorzien van een toren van twee geledingen met tweeledige, opengewerkte, achtkantige houten opbouw en een naaldspits. De kerk verrees in 1847-'48 naar ontwerp van E. Kroon in opdracht van C.F.I.F. Hackfort. De zijbeuken zijn in 1927 toegevoegd naar plannen van J.G.A. van Dongen. Tot de inventaris behoren 17de-eeuwse herenbanken van de familie Hackfort, een door atelier Lenaerts & Houtermans vervaardigd hoofdaltaar (1867) en een door de Gebr. Gradussen gebouwd orgel (1892)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0141.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01182> a min:Passage,
