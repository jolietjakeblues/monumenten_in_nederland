        schema:name "Rekken (gemeente Eibergen)"@nl ;
        schema:pageEnd "280" ;
        schema:pageStart "279" ;
        schema:pagination "279-280" ;
        schema:text "De R.K. kerk van de Heilige Martelaren van Gorkum (Rek-kenseweg 42) is een eenbeukige neogotische kruiskerk met driezijdig gesloten koor en slanke toren van drie geledingen met naaldspits. De kerk kwam tot stand in 1871-'72 naar plannen van G. te Riele."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0176.php> .

