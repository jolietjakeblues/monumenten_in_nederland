        min:hoofdstuk "Steden, dorpen, monumenten › Culemborg" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Culemborg" ;
        min:lemma "Boerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 568 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0049> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "133" ;
        schema:pageStart "132" ;
        schema:pagination "132-133" ;
        schema:text "Boerderijen. Aan de Goilberdingerdijk, ten westen van Culemborg, liggen enkele aardige, vroeg-20ste-eeuwse boerderijen. De uit circa 1915 daterende boerderij Goilberdingerdijk 29 is uitgevoerd in late-neorenaissance-stijl. De boerderijen Goilberdingerdijk 37 en 39 zijn grotendeels in hout uitgevoerd vanwege de ligging binnen het schootsveld van fort Everdingen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0049.php> .

