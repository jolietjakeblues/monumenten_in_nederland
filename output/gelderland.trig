        rdfs:label "Geldermalsen – Boerderijen"@nl ;
        min:adres "D.J. van Wijkstraat 6",
            "Genteldijk 5",
            "Herman Kuykstraat 72",
            "Rijksstraatweg 33",
            "Trichtse Voetpad 1-3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
