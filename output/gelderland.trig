        min:hoofdstuk "Steden, dorpen, monumenten › Wolfheze (gemeente Renkum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wolfheze" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1804 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0229> ;
        schema:name "Wolfheze (gemeente Renkum)"@nl ;
        schema:pageEnd "339" ;
        schema:pageStart "339" ;
        schema:pagination "339" ;
        schema:text "Dorp, opnieuw ontstaan in de 18de eeuw, nadat het middeleeuwse dorp met klooster in 1584 was verwoest. In het midden van de 19de eeuw werd het als schilderskolonie bekend. Van 1739 tot 1923 behoorde het dorp tot de voormalige heerlijkheid Doorwerth."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0229.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01805> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Wolfheze (gemeente Renkum)"@nl ;
        min:adres "Wolfheze 1",
            "Wolfheze 1-30",
            "Wolfheze 13",
            "Wolfheze 19",
            "Wolfheze 2",
            "Wolfheze 5",
            "Wolfheze 6" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Renkum" ;
        min:gemeenteInBoek "Renkum" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Renkum_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Wolfheze (gemeente Renkum)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Wolfheze" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1805 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0229> ;
        schema:name "Wolfheze (gemeente Renkum)"@nl ;
        schema:pageEnd "339" ;
        schema:pageStart "339" ;
        schema:pagination "339" ;
        schema:text "Het psychiatrisch ziekenhuis (Wolfheze 1-30), nu onderdeel van de ‘Gelderse Roos’, werd gesticht door de ‘Vereeniging tot Christelijke verzorging van krankzinnigen in Nederland’ en is in 1907 geopend. Centraal geplaatst is de Opstandingskerk (Wolfheze 1), een kruiskerk voorzien van een ongelede toren met ingesnoerde spits. Op het terrein bevinden zich enkele interessante gestichtsgebouwen uit 1906-'07, met chaletstijl- en jugendstil-elementen, zoals het hoofdgebouw (Wolfheze 2), de paviljoens ‘Avondrust’ (Wolfheze 6) en ‘Zonnelust’ (Wolfheze 13) en de werkplaats (Wolfheze 5); het paviljoen ‘Sonneheerdt’ (Wolfheze 19) uit circa 1925 heeft expressionistische details. Tot het complex behoren verder een gestichtsbegraafplaats - nu Alg. Begraafplaats -, met nummersteentjes voor de graven van bewoners van het gesticht, en een voorm. watertoren (bij Wolfheze 6) uit circa 1907 naar ontwerp van E. Knevel. Deze ronde toren heeft een verbrede bovenbouw met ijzeren hangbodemreservoir."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0229.php> .

