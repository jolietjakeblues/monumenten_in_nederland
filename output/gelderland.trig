        schema:name "Balgoy (gemeente Wijchen)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een oeverwal van de Maas. De oude dorpskern kreeg begin 20ste eeuw een uitbreiding naar het zuiden."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0024.php> .

