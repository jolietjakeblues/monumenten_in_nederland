        schema:name "Beusichem (gemeente Buren)"@nl ;
        schema:pageEnd "116" ;
        schema:pageStart "116" ;
        schema:pagination "116" ;
        schema:text "Het raadhuis (Markt 1) is in 1939 gebouwd in de trant van de Delftse School naar ontwerp van architectenbureau M. Lockhorst en W.F. Overeynder."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0037.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00463> a min:Passage,
