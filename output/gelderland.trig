            "529099" ;
        min:soort "inleiding" ;
        min:volgnummer 1741 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill418> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0221> ;
        schema:name "Well (gemeente Maasdriel)"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Het Huis van Malsen of Slot te Well (Dreef 5-7), gelegen op een omgracht terrein, heeft als kern een vermoedelijk 14de-eeuwse vierkante woontoren met twee uitkragende hoektorentjes. De toren is verbouwd in de eerste helft van de 16de eeuw en heeft een hoog schilddak uit 1884. Ook de aangrenzende westelijke bouwdelen, met de toegang en een ronde hoektoren in neogotische vormen dateren uit 1884. Het poortgebouw kreeg in 1934 zijn huidige vorm. Inwendig bevat de toren 16de-eeuwse consoles met peerkralen; het woongedeelte heeft 19de-eeuwse interieuronderdelen, waaronder imitatie-goudleerbehang."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0221.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01742> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Well (gemeente Maasdriel) – Boerderijen"@nl ;
        min:adres "Dreef 1",
            "Dreef 12",
            "Heust 12",
            "Heust 3" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Maasdriel" ;
        min:gemeenteInBoek "Maasdriel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Maasdriel_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Well (gemeente Maasdriel)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Well" ;
        min:lemma "Boerderijen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/58706> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "8112" ;
        min:soort "lemma" ;
        min:volgnummer 1742 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0221> ;
        schema:name "Boerderijen"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text """Boerderijen. De 18de-eeuwse hallenhuisboerderij Heust 19 heeft een afgewolfd rieten zadeldak. De Jacobs Hoeve (Heust 3) is een statige vroeg-19de-eeuwse hallenhuisboederij met dwars voorhuis voorzien van een rieten zadeldak tussen topgevels. Het wolfdak van het achterhuis heeft een groot overstek dat deels is dicht gezet.

De Amerikaanse windmolen aan de Singel (achter Heust 12) dateert uit circa 1920. Deze metalen molen zorgde voor het op peil houden van de waterstand en bestaat uit een vakwerkmast en een rad met vier vanen en twee windrichters.

De dorpspomp (bij Dreef 12) is een in 1921 opgerichte vierkante bakstenen pomp met zinken afdekking.

Het trafohuisje (bij Dreef 1) is gebouwd in 1925 naar plannen van G. Versteeg sr. in zakelijk-expressionistische vormen."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0221.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01743> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Westervoort" ;
        min:gemeenteInBoek "Westervoort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westervoort_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1743 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Westervoort"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Dorp, ontstaan in de middeleeuwen op een oeverwal van de IJssel. In 1735 werd de heerlijkheid gekocht door de stad Arnhem. De IJssel kreeg in 1774 bij Westervoort zijn huidige aftakking van de Rijn als gevolg van doorgraving van de polder Pley. De uit 1763 stammende schipbrug over de IJssel werd in 1901 vervangen, toen men de spoorbrug uit 1856 verbreedde. Na de Tweede Wereldoorlog is die brug hersteld en opnieuw verbreed. Het dorp heeft zich ontwikkeld tot een forensengemeente voor Arnhem."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01744> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort"@nl ;
        min:adres "Dorpstraat 61" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Westervoort" ;
        min:gemeenteInBoek "Westervoort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westervoort_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/55136> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38844" ;
        min:soort "inleiding" ;
        min:volgnummer 1744 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Westervoort"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "De Herv. kerk (Dorpstraat 61), oorspronkelijk gewijd aan St. Werenfridus, is een driebeukige pseudobasiliek met driezijdig gesloten koor en een toren van drie geledingen met ingesnoerde spits. De sobere tufstenen toren dateert uit de eerste helft van de 14de eeuw en werd eind 15de eeuw in baksteen verhoogd. Het gotische koor verrees in de eerste helft van de 15de eeuw. Aan het eind van die eeuw verving men het oude schip door het huidige, waarvan de zijbeuken langs de toren doorlopen. De kerk is na eerder herstel van oorlogsschade in 1955-'57 gerestaureerd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01745> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort"@nl ;
        min:adres "Dorpstraat 63" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Westervoort" ;
        min:gemeenteInBoek "Westervoort" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Westervoort_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Westervoort" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Westervoort" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/61173> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38845" ;
        min:soort "inleiding" ;
        min:volgnummer 1745 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0222> ;
        schema:name "Westervoort"@nl ;
        schema:pageEnd "330" ;
        schema:pageStart "330" ;
        schema:pagination "330" ;
        schema:text "Het interieur van het schip wordt gedekt door kruisribgewelven op korte kolonetten. Tot de inventaris behoren een midden-16de-eeuwse grafzerk en een laat-17de-eeuwse preekstoel. Het in 1708 door Derk Joost Jalinck voor de Herv. kerk van Eibergen gebouwde orgel (verbouwd in 1832) is in 1966 naar Westervoort overgebracht. De kosterswoning (Dorpstraat 63) is een neoclassicistisch pand uit 1841."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0222.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01746> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Westervoort"@nl ;
        min:adres "Dorpsstraat 109" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
