        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0219> ;
        schema:name "De Baank"@nl ;
        schema:pageEnd "328" ;
        schema:pageStart "328" ;
        schema:pagination "328" ;
        schema:text "De Baank (Rijksstraatweg 119) is een gepleisterd neoclassicistisch landhuis uit 1826, gebouwd voor P.J.Th. van Hamel Baank. In 1864 liet A.J.A. baron van Westerholt van Hackfort de risalerende middenpartij voorzien van een driehoekige bekroning met pinakels in neogotische vormen. Het koetshuis (Rijksstraatweg 121) stamt uit 1826, evenals de parkaanleg in Engelse landschapsstijl."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0219.php> .

