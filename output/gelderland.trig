        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0035> ;
        schema:name "Bergharen (gemeente Wijchen)"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "De kapel op de Kapelberg (Molenweg 55) kwam in 1947 tot stand naar ontwerp van Van Oerle en Schrama. De zeszijdige kapel bevat een Piëta uit circa 1500 (polychromie 1927). Op het terrein staan verder een poort en kruiswegstaties naar ontwerp van Jac. Maris."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00449> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Bergharen (gemeente Wijchen)"@nl ;
        min:adres "Dorpssstraat 73-75" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
