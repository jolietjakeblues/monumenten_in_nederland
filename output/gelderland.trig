        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Millingen aan de Rijn" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1226 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0149> ;
        schema:name "Millingen aan de Rijn"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een oeverwal. De Heerbaan is de oudste bebouwingsas. Na de Tweede Wereldoorlog is Millingen sterk gegroeid."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01227> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Millingen aan de Rijn"@nl ;
        min:adres "Zalmstraat 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Millingen aan de Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Millingen aan de Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Millingen aan de Rijn" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1227 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0149> ;
        schema:name "Millingen aan de Rijn"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "De voorm. Herv. kerk (Zalmstraat 8), gebouwd in 1880, is een recht gesloten zaalkerk voorzien van een geveltoren met ingesnoerde spits. In 1942 is naar ontwerp van A. van der Kloot een portaal toegevoegd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0149.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01228> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Millingen aan de Rijn"@nl ;
        min:adres "Heerbaan 101",
            "St.-Antoniusplein 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berg en Dal" ;
        min:gemeenteInBoek "Millingen aan de Rijn" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berg_en_Dal> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Millingen aan de Rijn" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Millingen aan de Rijn" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1228 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0149> ;
        schema:name "Millingen aan de Rijn"@nl ;
        schema:pageEnd "231" ;
        schema:pageStart "231" ;
        schema:pagination "231" ;
        schema:text "De R.K. St.-Antonius van Paduakerk (St.-Antoniusplein 1) is een driebeukige kruisbasiliek met driezijdig gesloten koor met omgang en flankerende kapellen en een terzijde geplaatste toren van drie geledingen met ingesnoerde spits. Deze neogotische kerk verrees in 1913-'14 naar ontwerp van W. te Riele. De toren is na gedeeltelijke verwoesting in 1945 herbouwd in 1954-'55 naar een vereenvoudigd ontwerp van B.W.A. Goddijn. Het interieur wordt gedekt door stergewelven. Tot de inventaris behoren een marmeren doopvont (circa 1850) en een preekstoel naar ontwerp van de Gebr. Smits (1860). De gebrandschilderde ramen zijn van W. Derix (1914). Het uit 1891 daterende pand ‘Skaraborg’ (Heerbaan 101) is de voorm. pastorie."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0149.php> .

