        min:soort "inleiding" ;
        min:volgnummer 373 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0024> ;
        schema:name "Balgoy (gemeente Wijchen)"@nl ;
        schema:pageEnd "104" ;
        schema:pageStart "104" ;
        schema:pagination "104" ;
        schema:text "De kerktoren (Torenstraat 22) van de in 1914 gesloopte R.K. St.-Johannes de Doperkerk, is een deels gepleisterd bouwwerk van drie geledingen met tentdak. De onderbouw dateert uit de 15de eeuw; de bovenste geleding is jonger."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0024.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00374> a min:Passage,
