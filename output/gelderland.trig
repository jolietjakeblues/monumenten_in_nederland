        schema:pageEnd "217" ;
        schema:pageStart "217" ;
        schema:pagination "217" ;
        schema:text "Esdorp, ontstaan in de 19de eeuw aan een beekdal op de Veluwse stuwwal. Vanwege de sprengen werd hier in 1850 een kuuroord gevestigd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0133.php> .

