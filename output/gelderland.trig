        min:kern "Geesteren" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 825 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill204> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0084> ;
        schema:name "Geesteren (gemeente Borculo)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "Dorp, ontstaan in de middeleeuwen in het stroomgebied tussen Berkel en Bolksbeek. In 1246 werd het een zelfstandige parochie. Er kwam een esdorp tot ontwikkeling dat gaaf bewaard is gebleven."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00826> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geesteren (gemeente Borculo)"@nl ;
        min:adres "Kerkplein 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berkelland" ;
        min:gemeenteInBoek "Borculo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geesteren (gemeente Borculo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Geesteren" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/17800>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/40576>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/57542> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "30322",
            "32991",
            "9883" ;
        min:soort "inleiding" ;
        min:volgnummer 826 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0084> ;
        schema:name "Geesteren (gemeente Borculo)"@nl ;
        schema:pageEnd "174" ;
        schema:pageStart "174" ;
        schema:pagination "174" ;
        schema:text "De Herv. kerk (Kerkplein 1), oorspronkelijk gewijd aan St. Christoforus, is een rijzige eenbeukige kerk met smaller driezijdig gesloten koor en een zadeldaktoren van vier geledingen. De toren met zijn laat-romaanse details, zoals deelzuiltjes in de galmgaten, stamt uit de 14de eeuw. Eind 15de eeuw verrees het met tufsteen beklede laat-gotische koor, kort daarop gevolgd door het schip in dezelfde vormen. In 1586 stortte de torenspits neer en nam in zijn val de schipgewelven mee. De toren kreeg in 1627-'28 een zadeldak tussen trapgevels. In de toren hangt een klok uit 1591 (Gherardus Lansinck). Bij de ingrijpende kerkrestauratie van 1929-'30 zijn onder meer de kruisribgewelven opnieuw aangebracht. Het interieur bevat een door R. Knol gebouwd orgel uit 1800, dat in 1974 uit Oosterwolde (Fr.) is overgebracht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0084.php> .

