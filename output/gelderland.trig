    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00391> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beek (gemeente Bergh)"@nl ;
        min:adres "St.-Jansgildestraat 54",
            "St.-Jansgildestraat 56",
            "St.-Martinusstraat 22" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Montferland" ;
        min:gemeenteInBoek "Bergh" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Montferland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Beek (gemeente Bergh)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Beek" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 391 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0027> ;
        schema:name "Beek (gemeente Bergh)"@nl ;
        schema:pageEnd "106" ;
        schema:pageStart "106" ;
        schema:pagination "106" ;
        schema:text "De R.K. St.-Martinuskerk (St.-Jansgildestraat 54) is een driebeukige hallenkerk met transept en koor, en een toren van drie geledingen met ingesnoerde naaldspits. De in 1884 verhoogde gotische toren dateert uit de tweede helft van de 15de eeuw. Het gelijktijdig gebouwde eenbeukige schip kreeg in 1868 neogotische zijbeuken van gelijke hoogte naar plannen van H.J. Wennekers. In 1914-'15 kwamen het neogotisch transept en koor met zijkoren tot stand naar plannen van W. te Riele. Tot de inventaris behoren een neogotisch hoofdaltaar (1915) en een orgel van de gebroeders Gradussen (1898). Op het kerkhof staat een neogotisch grafteken voor J. van Raaij (†1888) en een door de firma J. Thissen & Zn. vervaardigd H. Hartbeeld (1928). De ‘Oude Weem’ (St.-Martinusstraat 22) is een eclectisch pand uit circa 1870. De pastorie (St.-Jansgildestraat 56) is in 1928 in traditionalistische vormen gebouwd naar plannen van H.C.M. van Beers."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0027.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00392> a min:Passage,
