        schema:name "Gorssel"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "Dorp, ontstaan op een dekzandrug aan de weg van Deventer naar Zutphen en voor het eerst vermeld in 1253. Mede door de komst van de stoomtram Deventer-Emmerik in 1926 werd Gorssel een forensendorp, een ontwikkeling die zich na de Tweede Wereldoorlog doorzette."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00858> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Gorssel"@nl ;
        min:adres "Hoofdstraat 25" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Lochem" ;
        min:gemeenteInBoek "Gorssel" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Lochem_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Gorssel" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Gorssel" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 858 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill209> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0089> ;
        schema:name "Gorssel"@nl ;
        schema:pageEnd "178" ;
        schema:pageStart "178" ;
        schema:pagination "178" ;
        schema:text "De Herv. kerk (bij Hoofdstraat 25) is een zaalkerk voorzien van een toren van drie geledingen met ingesnoerde naaldspits. De gotische toren verrees in de 15de eeuw en kreeg in 1632 een verhoging. Daarin hangen twee klokken, de ene van Geert van Wou (1498), de andere van Hendrick ter Horst (1638). De kerk is in 1926 herbouwd en na verwoesting in 1945 opnieuw naar plannen van A.J. van der Steur. Inwendig bevindt zich een door C.F.A. Naber gebouwd orgel (1862)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0089.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00859> a min:Passage,
