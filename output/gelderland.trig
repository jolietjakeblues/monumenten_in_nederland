        schema:pageEnd "168" ;
        schema:pageStart "168" ;
        schema:pagination "168" ;
        schema:text "Het raadhuis (Dorpsstraat 67) is een uit 1869 daterend, statig blokvormig pand met neoclassicistische elementen. Het is uitgebreid in 1935, 1982 en 1989."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0075.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00776> a min:Passage,
