        schema:name "Duiven"@nl ;
        schema:pageEnd "153" ;
        schema:pageStart "153" ;
        schema:pagination "153" ;
        schema:text "Het voorm. raadhuis (Rijksweg 56) is een neoclassicistisch pand uit 1864, ontworpen door S.A. Fijnebuik. De dakerker stamt uit 1923."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0065.php> .

