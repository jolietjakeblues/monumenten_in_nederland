        schema:pageEnd "203" ;
        schema:pageStart "203" ;
        schema:pagination "203" ;
        schema:text "De zogeheten Hunnenschans ‘Duno’ (Rijnlaan ong.) is een restant van een vroeg-middeleeuwse ringwalburcht."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0112.php> .

