        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/41463>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77209>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/77210> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "38241",
            "525969",
