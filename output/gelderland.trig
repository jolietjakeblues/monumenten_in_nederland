        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loo (gemeente Duiven)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Loo" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1186 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0142> ;
        schema:name "Loo (gemeente Duiven)"@nl ;
        schema:pageEnd "227" ;
        schema:pageStart "227" ;
        schema:pagination "227" ;
        schema:text "De R.K. St.-Antonius Abtkerk (Loostraat 35) is een driebeukige neogotische hallenkerk met driezijdig gesloten koor, gebouwd in 1873-'75 naar plannen van A. Tepe ter plaatse van een 15de-eeuwse kapel. Het interieur is in 1976-'77 gemoderniseerd en recent opnieuw ingericht met onder meer stukken uit de Utrechtse Biltstraatkerk en St.-Martinuskerk. Het door M. Maarschalkerweerd gebouwde orgel (1895) is afkomstig uit het voorm. ziekenhuis Johannes de Deo in Utrecht. De gebrandschilderde ramen zijn van W. Enckhof (1947)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0142.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01187> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Loo (gemeente Duiven) – Lowaard"@nl ;
        min:adres "Loowaard 1" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Duiven" ;
        min:gemeenteInBoek "Duiven" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Duiven_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Loo (gemeente Duiven)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Loo" ;
        min:lemma "Lowaard" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/54195> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "14184" ;
        min:soort "lemma" ;
        min:volgnummer 1187 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0142> ;
        schema:name "Lowaard"@nl ;
        schema:pageEnd "228" ;
        schema:pageStart "227" ;
        schema:pagination "227-228" ;
        schema:text "Lowaard (Loowaard 1) is een voorm. havezate, die voor het eerst wordt genoemd in 1467. Mogelijk met gebruik van oudere delen kwam tussen 1558 en 1569 het huidige tweebeukige huis met achtkantige traptoren tot stand. De traptoren is voorzien van een verweerde gedenksteen in vroege renaissancevormen (1565 of 1569) met de wapens van de opdrachtgevers: Herman van den Loo en zijn vrouw Digna van Isendoorn. De zuidgevel kreeg een in- en uitge-zwenkte gevel met ronde pinakels, de oostgevel een fries van spitse boogjes. In 1742 werd het huis omgebouwd tot boerderij, waarvan het bedrijfsgedeelte in 1930 is vernieuwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0142.php> .

