        min:soort "lemma" ;
        min:volgnummer 452 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0035> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "115" ;
        schema:pageStart "115" ;
        schema:pagination "115" ;
        schema:text "Windmolen ‘De Verrekijker’ (Molenweg 53) is een beltmolen uit 1904, gebouwd door molenmaker C. Coppes ter vervanging van een afgebrande voorganger. De korenmolen heeft een ronde bakstenen romp en een met dakleer beklede kap."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0035.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00453> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Beuningen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Beuningen" ;
