        min:volgnummer 405 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0029> ;
        schema:name "Beekbergen (gemeente Apeldoorn)"@nl ;
        schema:pageEnd "108" ;
        schema:pageStart "108" ;
        schema:pagination "108" ;
        schema:text "Het postkantoor (Dorpsstraat 86), een eenlaagspand met verhoogd middendeel, is in 1919-'20 gebouwd in sobere expressionistische vormen naar plannen van J. Crouwel."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0029.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00406> a min:Passage,
