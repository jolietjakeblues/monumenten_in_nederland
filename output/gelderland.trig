        schema:name "Veessen (gemeente Heerde)"@nl ;
        schema:pageEnd "309" ;
        schema:pageStart "309" ;
        schema:pagination "309" ;
        schema:text "Esdorp, ontstaan in de middeleeuwen op een oeverwal. De bebouwing concentreerde zich op de Veesser es bij de kerk. Later ontstond ook een lintbebouwing langs de IJsseldijk."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0206.php> .

