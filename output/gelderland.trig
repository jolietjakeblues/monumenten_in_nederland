        min:soort "lemma" ;
        min:volgnummer 829 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0084> ;
        schema:name "Windmolen"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "174" ;
        schema:pagination "174-175" ;
        schema:text """Windmolen ‘De Ster’ (Molenweg 15) is een achtkante stellingkorenmolen op bakstenen onderbouw, gebouwd in 1859 voor B. Hagens. De molen brandde af in 1866, 1901 en 1903 en is in 1980 gerestaureerd.

Het brandspuithuisje (Brinkweg 6a) is een eenvoudig witgepleisterd gebouwtje uit circa 1890."""@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00830> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geesteren (gemeente Borculo) – Gelselaar"@nl ;
        min:adres "Driessenweg 10" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Berkelland" ;
        min:gemeenteInBoek "Borculo" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Berkelland> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geesteren (gemeente Borculo)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Geesteren" ;
        min:lemma "Gelselaar" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 830 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0084> ;
        schema:name "Gelselaar"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Gelselaar. Dit dorp ten noorden van Geesteren is ontstaan in de middeleeuwen en ontwikkelde zich in de 19de eeuw tot een - gaaf bewaard - esdorp met brink. De Herv. kerk (Driessenweg 10) is een sobere zaalkerk met geveltoren en ingangsportaal met neoclassicistische details, gebouwd in 1841, mogelijk naar ontwerp van G.J. Dibbets. De boerderijen staan voornamelijk met hun deel naar de weg gekeerd. Voorbeelden hiervan zijn: Driessenweg 1 (1853), Driessenweg 12, Dorpsstraat 16 (1882) en Dorpsstraat 27. Mogelijk een oudere kern heeft de grotendeels 19de-eeuwse hallenhuisboerderij Oude Rengersweg 2 met een gaaf bewaarde grote keuken, een woongedeelte (1841) met endskamer, deel (1864), bakhuis (1869) en vrijstaande schuur (1876)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0084.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00831> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geldermalsen"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geldermalsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Geldermalsen" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 831 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0085> ;
        schema:name "Geldermalsen"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "Dorp, ontstaan in de vroege middeleeuwen op een stroomrug. Langs de Linge kwam een gestrekt dorp tot ontwikkeling met een brink nabij de (Herv.) kerk. De rond 1840 haaks op de Linge aangelegde Rijksstraatweg Buren-Zaltbommel doorsneed het dorp. Geldermalsen kreeg in 1868 een station aan de spoorlijn Utrecht-Den Bosch. Ten oosten en westen van de dorpskern ontwikkelden zich tussen 1860 en 1930 nieuwe bebouwingskernen, die via een lintbebouwing met de hoofdkern waren verbonden. Zo kwam in de jaren twintig van de twintigste eeuw aan de westzijde, ten zuiden van de Tunnelweg, het Tuindorp tot stand met sociale woningbouw. Iets later, begin jaren dertig, ontstond in de omgeving van de Stationsweg een ruime woonwijk. Na de Tweede Wereldoorlog is Geldermalsen flink gegroeid in zuidoostelijke, westelijke en noordoostelijke richting."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0085.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00832> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Geldermalsen"@nl ;
        min:adres "Kerkstraat 38" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "West Betuwe" ;
        min:gemeenteInBoek "Geldermalsen" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/West_Betuwe> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Geldermalsen" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Geldermalsen" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/50225>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/60967> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "16455",
            "16456" ;
        min:soort "inleiding" ;
        min:volgnummer 832 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0085> ;
        schema:name "Geldermalsen"@nl ;
        schema:pageEnd "175" ;
        schema:pageStart "175" ;
        schema:pagination "175" ;
        schema:text "De Herv. kerk (Kerkstraat 38), oorspronkelijk gewijd aan St. Suitbertus, is een tweebeukige kerk met driezijdig gesloten koor en een toren van drie geledingen met tentdak. De toren verrees in de tweede helft van de 13de eeuw en werd in de 15de eeuw verhoogd. In de toren hangt een door Johannes en Wilhelmus Hoerken gegoten klok (1460). Het huidige middenschip werd in de 15de eeuw gebouwd ter plaatse van een tufstenen, mogelijk 12de-eeuwse, voorganger, waarvan in de westmuur delen zijn opgenomen. Later in de 15de eeuw kwamen nog het koor en de langs de toren doorlopende noordbeuk tot stand. De consistorie bij het koor dateert uit 1926. De kerk is gerestaureerd in 1931, onder leiding van D. Jansen, en in 1969. Het interieur wordt gedekt door kruisribgewelven, die in 1931 opnieuw zijn aangebracht. Tot de inventaris behoren een achtkantige hardstenen doopvont (15de eeuw), een beschilderd houten tekst- en wetsbord (1619), een preekstoel in Lodewijk XIV-stijl (circa 1700), een herenbank (1720) en een door P.J. Adema gebouwd kabinetorgel (circa 1860). De kerk bevat verder een aantal 17de- en 18e eeuwse zerken, waaronder een witmarmeren grafzerk uit 1684, met de beeltenissen van Jacobus van Borsselen en zijn echtgenote Maria van Varick; het beeldhouwwerk wordt toegeschreven aan Johannes Blommendael."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0085.php> .

