        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0157> ;
        schema:name "Nijmegen"@nl ;
        schema:pageEnd "245" ;
        schema:pageStart "245" ;
        schema:pagination "245" ;
        schema:text "Vlakbij ligt de voorm. pastorie ‘De Olde Wehme’ (Kerkpad 30) uit circa 1870 met een herenhuisachtig voorhuis en een smaller achterhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0157.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01298> a min:Passage,
