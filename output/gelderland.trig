        schema:name "Bredevoort (gemeente Aalten)"@nl ;
        schema:pageEnd "120" ;
        schema:pageStart "120" ;
        schema:pagination "120" ;
        schema:text "De voorm. synagoge (Vismarkt 9) heeft het uiterlijk van een woonhuis. De gevel met neorenaissance-elementen dateert uit circa 1895. De sjoel werd in 1863 gesticht en werd rond 1906 gesloten."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0042.php> .

