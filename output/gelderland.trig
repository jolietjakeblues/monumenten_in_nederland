        min:hoofdstuk "Steden, dorpen, monumenten › Ruurlo" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Ruurlo" ;
        min:lemma "Huis Ruurlo" ;
        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73951>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73952>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/73953>,
