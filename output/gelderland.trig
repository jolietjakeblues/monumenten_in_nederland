        schema:name "Hemmen (gemeente Valburg)"@nl ;
        schema:pageEnd "197" ;
        schema:pageStart "196" ;
        schema:pagination "196-197" ;
        schema:text "De ruïne van Huis te Hemmen, gelegen ten westen van de kerk, is in 1997 geconsolideerd. Het in opdracht van Frans Godard van Lynden in 1757 gebouwde, omgrachte huis werd in 1944-'45 verwoest."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0103.php> .

