        min:noemtRijksmonument <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66775>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66776>,
            <https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/rijksmonument/66777> ;
        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523906",
            "523907",
            "523908" ;
        min:soort "inleiding" ;
        min:volgnummer 1371 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0164> ;
        schema:name "Oosterhout (gemeente Valburg)"@nl ;
        schema:pageEnd "271" ;
        schema:pageStart "271" ;
        schema:pagination "271" ;
        schema:text "De R.K. St.-Leonarduskerk (Dorpsstraat 14) is een driebeukige basilicale kerk met hoge zadeldaken, vijfzijdig gesloten koor met omgang, dubbele pseudotransepten en een opzij geplaatste zadeldaktoren. De kerk verrees in 1932 in expressionistische stijl naar ontwerp van C. Hardeman ter vervanging van een kerk uit 1855. Het interieur is uitgevoerd met netgewelven en hoge paraboolvormige scheibogen. De inventaris dateert grotendeels uit de bouwtijd en bevat een crucifix naar ontwerp van J. Toorop. De aangrenzende pastorie (Dorpsstraat 16) is tegelijk met de kerk gebouwd."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0164.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01372> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oosterhout (gemeente Valburg) – Woonhuizen"@nl ;
        min:adres "Dorpsstraat 42",
            "Oosterhoutseweg 59-73" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Overbetuwe" ;
        min:gemeenteInBoek "Valburg" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Overbetuwe> ;
