        min:provincie "Gelderland" ;
        min:rijksmonumentnummer "523553",
            "523554" ;
        min:soort "inleiding" ;
        min:volgnummer 1394 ;
        schema:image <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/afbeelding/sten009monu05ill342> ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0169> ;
        schema:name "Otterlo (gemeente Ede)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Aan de straatzijde staat een door Berlage ontworpen dienstgebouw met woningen, garages en stallen (Apeldoornseweg 228-230), gebouwd in 1917-'20 in vormen die verwijzen naar het werk van F. Lloyd Wright. Ten westen van het jachtslot staat het door J. Mendes da Costa vervaardigde gedenkteken voor Christiaan de Wet (De Wetweg ong.) uit 1920."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01395> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Otterlo (gemeente Ede)"@nl ;
        min:adres "Wildbaanweg 8" ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Ede" ;
        min:gemeenteInBoek "Ede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Otterlo (gemeente Ede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Otterlo" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1395 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0169> ;
        schema:name "Otterlo (gemeente Ede)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Het Kröller-Müller museum (Wildbaanweg 8), gelegen ten oosten van Otterlo, is een langgerekt eenlaags museumgebouw met interne patio, gebouwd in 1938 als tijdelijk bedoelde huisvesting van de kunstcollectie van mw. H.E.L.J. Kröller-Müller. H. van der Velde ontwierp in 1921 dit in baksteenfunctionalisme uitgevoerde ‘provisorium’ met platte daken en veel bovenlicht voor de schilderijen, nadat bleek dat zijn ambitieuzer museumplan uit 1919 vanwege de slechte economische situatie niet kon worden uitgevoerd. Van der Velde maakte ook de plannen voor de in 1953-'54 uitgevoerde oostelijke uitbreiding met aula en beeldenzaal. Na een restauratie in 1971 volgde in 1975-'77 een uitbreiding naar plannen van W.G. Quist, waarbij de ingang aan de oostzijde kwam te liggen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01396> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Otterlo (gemeente Ede)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Ede" ;
        min:gemeenteInBoek "Ede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Otterlo (gemeente Ede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Otterlo" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1396 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0169> ;
        schema:name "Otterlo (gemeente Ede)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "De fraai gelegen museale beeldentuin naar ontwerp van J.T.P. Bijhouwer werd in 1961 geopend en in 1988 uitgebreid met een beeldenbos. In 1965 herbouwde men in de beeldentuin het door G.Th. Rietveld voor Park Sonsbeek ontworpen expositiepaviljoen uit 1954. Aan de zuidzijde van het huidige museum liggen de fundamenten van het oorspronkelijk in 1919 ontworpen ambitieuzere museum. Op de Franse Berg bevindt zich de familiebegraafplaats Kröller-Mröller (1946), bestaande uit een grafkelder met twee zandstenen grafzerken voor A.G. Kröller (†1941) en mw. H.E.L.J. Kröller-Müller (†1939)."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01397> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Otterlo (gemeente Ede)"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
        min:gemeente "Ede" ;
        min:gemeenteInBoek "Ede" ;
        min:heeftGemeente <http://standaarden.overheid.nl/owms/terms/Ede_(gemeente)> ;
        min:heeftProvincie <http://standaarden.overheid.nl/owms/terms/Gelderland> ;
        min:hoofdstuk "Steden, dorpen, monumenten › Otterlo (gemeente Ede)" ;
        min:inDeel <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01> ;
        min:kern "Otterlo" ;
        min:provincie "Gelderland" ;
        min:soort "inleiding" ;
        min:volgnummer 1397 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0169> ;
        schema:name "Otterlo (gemeente Ede)"@nl ;
        schema:pageEnd "274" ;
        schema:pageStart "274" ;
        schema:pagination "274" ;
        schema:text "Het vliegveld Deelen (Delenseweg), gelegen ten zuidoosten van Otterlo, werd in 1940 door de Duitsers aangelegd en ingericht voor de Luftwaffe. Daartoe ontstonden enkele gebouwen in traditionalistische vormen. Na de Tweede Wereldoorlog is het als militair vliegveld door de Nederlandse luchtmacht in gebruik genomen."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0169.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/01398> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Oud-Zevenaar (gemeente Zevenaar)"@nl ;
