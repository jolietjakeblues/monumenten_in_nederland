        min:kern "Elburg" ;
        min:lemma "Stadsboerderijen" ;
        min:provincie "Gelderland" ;
        min:soort "lemma" ;
        min:volgnummer 749 ;
        schema:isPartOf <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/hoofdstuk/0072> ;
        schema:name "Stadsboerderijen"@nl ;
        schema:pageEnd "165" ;
        schema:pageStart "165" ;
        schema:pagination "165" ;
        schema:text "Stadsboerderijen. Verspreid in de stad staan verschillende verbouwde voorm. stadsboerderijen. Westerwalstraat 18 heeft een topgevel met vlechtingen uit de tweede helft van de 16de eeuw. Zuiderwalstraat 4 gaat ook terug tot de 16de eeuw, maar is in de 18de eeuw verbouwd. Een waarschijnlijk 17de-eeuwse oorsprong hebben Westerwalstraat 20 en Ellestraat 54, dat in de 19de eeuw is verbouwd tot gepleisterd dubbel woonhuis."@nl ;
        schema:url <https://www.dbnl.org/tekst/sten009monu05_01/sten009monu05_01_0072.php> .

    <https://linkeddata.cultureelerfgoed.nl/rce/monumenten-in-nederland/id/sten009monu05_01/passage/00750> a min:Passage,
            schema:CreativeWork ;
        rdfs:label "Elburg – Theekoepels"@nl ;
        min:deel "Monumenten in Nederland. Gelderland" ;
